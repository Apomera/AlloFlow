el_summary_other","v":{"s":"{count} likely-dropped tokens (both Tesseract & Vision OCR saw these)"}},{"k":"ocr_panel_help","v":{"s":"Click any token to jump to it in the diff. Both OCR engines saw these words in the source — they're high-confidence accidental drops, not intentional remediation removals."}},{"k":"token_scroll_title","v":{"s":"Click to scroll to this token in the diff"}},{"k":"ocr_panel_more","v":{"s":"…and {count} more in the diff below"}},{"k":"revert_button","v":{"s":"Revert last Apply"}},{"k":"applying","v":{"s":"Applying…"}},{"k":"apply_export_button","v":{"s":"Apply & Export ({count})"}}],"id":722}},{"k":"volume_builder","v":{"o":[{"k":"zoom_out_aria","v":{"s":"Zoom out"}},{"k":"zoom_in_aria","v":{"s":"Zoom in"}},{"k":"reset_view_aria","v":{"s":"Reset view"}},{"k":"help_caption","v":{"s":"Drag to rotate • Scroll to zoom • Build rectangular prisms or L-blocks with unit cubes (5.MD.3-5)"}},{"k":"shape_radiogroup_aria","v":{"s":"Volume Builder shape"}},{"k":"answer_placeholder","v":{"s":"Enter volume..."}},{"k":"answer_aria","v":{"s":"Volume answer"}},{"k":"title","v":{"s":"3D Volume Explorer"}},{"k":"rotate_group_aria","v":{"s":"Rotate 3D volume"}},{"k":"rotate_label","v":{"s":"Rotate:"}},{"k":"rotate_left_aria","v":{"s":"Rotate volume left"}},{"k":"rotate_left","v":{"s":"Left"}},{"k":"rotate_right_aria","v":{"s":"Rotate volume right"}},{"k":"rotate_right","v":{"s":"Right"}},{"k":"tilt_up_aria","v":{"s":"Tilt volume up"}},{"k":"tilt_up","v":{"s":"Up"}},{"k":"tilt_down_aria","v":{"s":"Tilt volume down"}},{"k":"tilt_down","v":{"s":"Down"}},{"k":"orientation_status","v":{"s":"Tilt {tilt} degrees, turn {turn} degrees, zoom {zoom} percent"}},{"k":"shape_rect","v":{"s":"Rectangular"}},{"k":"shape_lblock","v":{"s":"L-Block"}},{"k":"dim_length","v":{"s":"Length"}},{"k":"dim_width","v":{"s":"Width"}},{"k":"dim_height","v":{"s":"Height"}},{"k":"layers_label","v":{"s":"Layers:"}},{"k":"layers_all","v":{"s":"All"}},{"k":"unit_cubes_one","v":{"s":"{count} unit cube"}},{"k":"unit_cubes_other","v":{"s":"{count} unit cubes"}},{"k":"surface_area_approx","v":{"s":"(approx — full prism)"}},{"k":"difficulty_label","v":{"s":"Difficulty:"}},{"k":"difficulty_easy","v":{"s":"easy"}},{"k":"difficulty_medium","v":{"s":"medium"}},{"k":"difficulty_hard","v":{"s":"hard"}},{"k":"random_challenge","v":{"s":"Random Challenge"}},{"k":"challenge_prompt_rect","v":{"s":"What is the volume of this rectangular prism?"}},{"k":"challenge_prompt_lblock","v":{"s":"What is the volume of this L-block?"}},{"k":"check","v":{"s":"Check"}},{"k":"feedback_correct_rect","v":{"s":"Correct! {l} × {w} × {h} = {answer} cubic units"}},{"k":"feedback_correct_lblock","v":{"s":"Correct! ({l}×{w}×{h}) − ({nl}×{nw}×{nh}) = {answer} cubic units"}},{"k":"feedback_wrong_rect","v":{"s":"Not quite. Try V = L × W × H"}},{"k":"feedback_wrong_lblock","v":{"s":"Not quite. Try V = (L × W × H) − notch"}},{"k":"notch_label_length","v":{"s":"Length Notch"}},{"k":"notch_label_width","v":{"s":"Width Notch"}},{"k":"notch_label_height","v":{"s":"Height Notch"}},{"k":"notch_aria_length","v":{"s":"Notch length"}},{"k":"notch_aria_width","v":{"s":"Notch width"}},{"k":"notch_aria_height","v":{"s":"Notch height"}}],"id":723}},{"k":"notes_feedback","v":{"o":[{"k":"title","v":{"s":"Feedback on your notes"}},{"k":"dismiss_aria","v":{"s":"Dismiss feedback"}},{"k":"strength_label","v":{"s":"What you did well"}},{"k":"growth_label","v":{"s":"One thing to try next time"}},{"k":"source_label","v":{"s":"About the source text"}},{"k":"no_xp_hint","v":{"s":"You've already earned XP from this entry before. Keep going — new improvements earn more XP."}},{"k":"no_ai","v":{"s":"AI feedback is not available right now."}},{"k":"cornell_needs_notes","v":{"s":"Add at least 2 rows of notes before asking for feedback."}},{"k":"lab_needs_substance","v":{"s":"Fill in the hypothesis, analysis, or conclusion before asking for feedback."}},{"k":"reading_needs_thinking","v":{"s":"Write at least your thinking or connection before asking for feedback."}},{"k":"empty","v":{"s":"Fill in some of the template before asking for feedback."}},{"k":"thinking","v":{"s":"Reading your notes..."}},{"k":"error","v":{"s":"Could not generate feedback right now. Try again in a moment."}},{"k":"loading","v":{"s":"Reading your notes..."}},{"k":"button","v":{"s":"Get AI Feedback"}},{"k":"xp_earned","v":{"s":"+{xp} XP"}},{"k":"double_entry_needs_response","v":{"s":"Respond to at least one quote before asking for feedback."}},{"k":"guided_needs_blanks","v":{"s":"Fill in at least half the blanks (or add your own notes) before asking for feedback."}},{"k":"qanda_needs_pairs","v":{"s":"Write at least 2 complete question-and-answer pairs before asking for feedback."}}],"id":724}},{"k":"note_insights","v":{"o":[{"k":"title","v":{"s":"Your note-taking patterns"}},{"k":"subtitle","v":{"s":"Growth-focused observations across your saved entries. Not a grade — a mirror."}},{"k":"close_aria","v":{"s":"Close insights"}},{"k":"loading","v":{"s":"Looking across your notebook..."}},{"k":"loading_hint","v":{"s":"This takes a few seconds — patterns need a careful read."}},{"k":"no_data","v":{"s":"No insights yet."}},{"k":"overview_label","v":{"s":"Overview"}},{"k":"try_next_label","v":{"s":"Try next:"}},{"k":"celebration_label","v":{"s":"Keep doing this"}},{"k":"footer","v":{"s":"These observations are a mirror, not a grade. Use what's useful, set aside what isn't."}},{"k":"no_ai","v":{"s":"AI is not available right now."}},{"k":"need_more_entries","v":{"s":"Save at least 2 note-taking entries before generating insights."}},{"k":"error","v":{"s":"Could not generate insights right now. Try again in a moment."}},{"k":"button_aria","v":{"s":"Generate note-taking insights across your saved entries"}},{"k":"need_more_entries_short","v":{"s":"Save 2+ entries to unlock"}},{"k":"button_tooltip","v":{"s":"AI looks for patterns across your notes and offers growth suggestions"}},{"k":"button","v":{"s":"Insights"}}],"id":725}},{"k":"a11y_lab","v":{"o":[{"k":"tabs","v":{"o":[{"k":"preview","v":{"s":"Preview as student"}},{"k":"keyboard","v":{"s":"Keyboard tour"}},{"k":"audit","v":{"s":"Audit"}},{"k":"screenreader","v":{"s":"Screen reader"}},{"k":"simulators","v":{"s":"Simulators"}}],"id":727}},{"k":"dialog","v":{"o":[{"k":"title","v":{"s":"Accessibility Lab"}},{"k":"subtitle","v":{"s":"Verify the student experience: preview, audit, listen, simulate."}},{"k":"close","v":{"s":"Close"}},{"k":"close_aria","v":{"s":"Close Accessibility Lab"}},{"k":"coming_soon","v":{"s":"Coming in a future phase"}},{"k":"tablist_aria","v":{"s":"Lab sections"}}],"id":728}},{"k":"preview","v":{"o":[{"k":"heading","v":{"s":"Preview a lesson as your student"}},{"k":"select_intro","v":{"s":"Choose a saved lesson to preview with student accessibility settings applied (font, size, contrast, line spacing). This shows you what the content looks like for students using accommodations."}},{"k":"no_lessons","v":{"s":"No saved lessons yet. Generate a lesson in Teacher Mode first, then come back to preview it."}},{"k":"untitled","v":{"s":"(untitled)"}},{"k":"back","v":{"s":"← Back to lesson list"}},{"k":"previewing_prefix","v":{"s":"Previewing: "}},{"k":"font_label","v":{"s":"Font"}},{"k":"size_label","v":{"s":"Size"}},{"k":"theme_label","v":{"s":"Theme"}},{"k":"spacing_label","v":{"s":"Line spacing"}},{"k":"letter_spacing_label","v":{"s":"Letter spacing"}},{"k":"read_aloud","v":{"s":"🔊 Read aloud"}},{"k":"read_aloud_unavailable","v":{"s":"Read aloud is not available in this build."}},{"k":"read_aloud_empty","v":{"s":"Nothing to read in the current preview."}},{"k":"read_aloud_error","v":{"s":"Could not start read-aloud: "}},{"k":"unmapped_theme_note","v":{"s":"Note: the app is currently using a reading theme (warm, blue, green, rose, or dyslexia overlay) that is not represented in this preview yet. Switch it in the main accessibility settings to preview it accurately."}},{"k":"pane_aria","v":{"s":"Student preview pane"}},{"k":"apply_button","v":{"s":"Apply these settings to the app"}},{"k":"reset_button","v":{"s":"Reset to app defaults"}},{"k":"apply_explanation","v":{"s":"Applies the font, size, theme, line spacing, and letter spacing above to the live app for all students using this device."}},{"k":"apply_success","v":{"s":"Applied to the live app for all students using this device."}},{"k":"apply_error","v":{"s":"Could not apply settings: "}},{"k":"reset_success","v":{"s":"Reset to the live app's current settings."}},{"k":"tip","v":{"s":"Tip: switch the theme to High contrast and try Extra Large font to simulate low-vision usage. Switch the font to OpenDyslexic to simulate a dyslexia-friendly view."}}],"id":729}},{"k":"keyboard","v":{"o":[{"k":"heading","v":{"s":"Keyboard accessibility audit"}},{"k":"description","v":{"s":"Scan the underlying lesson view for keyboard-accessible elements. Identifies tab order, \"fake buttons\" (divs with cursor:pointer that aren't keyboard-reachable), positive tabindex anti-patterns, and elements missing accessible names."}},{"k":"run_scan","v":{"s":"🔍 Run keyboard scan"}},{"k":"rescan","v":{"s":"Re-scan"}},{"k":"show_overlay","v":{"s":"🔢 Show tab-order overlay"}},{"k":"hide_overlay","v":{"s":"🔢 Hide tab-order overlay"}},{"k":"overlay_active","v":{"s":"Tab-order overlay is active. Numbered red badges show the tab sequence on the page behind this lab. Close the lab or click the toggle above to hide."}},{"k":"idle","v":{"s":"Click \"Run keyboard scan\" to audit the current view. The lab modal itself is excluded from the scan; what gets audited is the underlying app surface (the lesson, sidebar, controls, etc. behind the lab)."}},{"k":"scan_result_prefix","v":{"s":"Keyboard scan: "}},{"k":"scan_result_middle","v":{"s":" focusable elements, "}},{"k":"scan_result_suffix","v":{"s":" issues"}},{"k":"scan_failed","v":{"s":"Keyboard scan failed: "}},{"k":"summary_focusable","v":{"s":"Focusable elements"}},{"k":"summary_fakes","v":{"s":"Fake buttons"}},{"k":"summary_pos_tabindex","v":{"s":"Positive tabindex"}},{"k":"summary_no_label","v":{"s":"Missing names"}},{"k":"tab_order_heading","v":{"s":"Tab order"}},{"k":"fakes_heading","v":{"s":"⚠ Fake buttons"}},{"k":"fakes_help","v":{"s":"Elements with cursor:pointer that look clickable but cannot be reached by keyboard. Common cause: a div with onClick instead of a real <button>. Fix: convert to <button>, OR add tabindex=\"0\" + role=\"button\" + keyboard event handlers."}},{"k":"pos_heading","v":{"s":"⚠ Positive tabindex"}},{"k":"pos_help","v":{"s":"Elements with tabindex > 0 break natural document tab order and confuse keyboard users. Fix: use tabindex=\"0\" (default order) or rely on default focusability for buttons/links."}},{"k":"no_label_heading","v":{"s":"🔴 Missing accessible names"}},{"k":"no_label_help","v":{"s":"Focusable elements without text, aria-label, aria-labelledby, or title. Screen reader users would hear only the tag name, e.g., \"button\" with no context. Fix: add aria-label or visible text."}},{"k":"tip","v":{"s":"Tip: navigate the page behind the lab using only Tab, Shift+Tab, Enter, and Esc. Click on any element name in the lists above to focus it (the page will scroll if needed)."}}],"id":730}},{"k":"audit","v":{"o":[{"k":"heading","v":{"s":"Live in-app accessibility audit"}},{"k":"description","v":{"s":"Runs axe-core (industry-standard accessibility engine, used by browsers, the Deque team, and many enterprise audits) against the current view. Reports WCAG 2.1 A and AA violations in plain language framed by student impact. The lab modal itself is excluded."}},{"k":"run","v":{"s":"🔍 Run audit"}},{"k":"rerun","v":{"s":"Re-run audit"}},{"k":"loading","v":{"s":"Loading axe-core..."}},{"k":"running","v":{"s":"Running audit..."}},{"k":"last_run_prefix","v":{"s":"Last run: "}},{"k":"error_prefix","v":{"s":"Audit failed: "}},{"k":"error_suffix","v":{"s":". Check your network connection (axe-core loads from cdn.jsdelivr.net) and try again."}},{"k":"error_toast_prefix","v":{"s":"Audit failed: "}},{"k":"unknown_error","v":{"s":"unknown error"}},{"k":"idle","v":{"s":"Click \"Run audit\" to scan the current view for WCAG 2.1 A and AA violations. The first run takes ~2 seconds to load axe-core (~350 KB minified) from a CDN; subsequent runs are instant."}},{"k":"complete_prefix","v":{"s":"Audit complete: "}},{"k":"complete_violations_middle","v":{"s":" violations across "}},{"k":"complete_elements_middle","v":{"s":" elements; "}},{"k":"complete_passes_suffix","v":{"s":" rules passed."}},{"k":"summary_violations","v":{"s":"Violations"}},{"k":"summary_passes","v":{"s":"Rules passed"}},{"k":"summary_review","v":{"s":"Need review"}},{"k":"summary_affected","v":{"s":"Affected elements"}},{"k":"no_violations","v":{"s":"✅ No WCAG 2.1 A/AA violations found in the current view by axe-core. (Note: automated audits catch ~30-50% of real accessibility issues. Combine with the keyboard tour, screen-reader preview, and manual review.)"}},{"k":"rule_singular","v":{"s":"rule"}},{"k":"rule_plural","v":{"s":"rules"}},{"k":"element_singular","v":{"s":"element"}},{"k":"element_plural","v":{"s":"elements"}},{"k":"show_me","v":{"s":"Show me"}},{"k":"learn_more","v":{"s":"Learn more ↗"}},{"k":"affected_heading","v":{"s":"Affected elements"}},{"k":"tip","v":{"s":"Tip: critical and serious issues are open by default. Click \"Show me\" on any rule to focus and highlight the first affected element. axe-core covers ~30-50% of real accessibility issues; combine with the keyboard tour, screen-reader preview, and manual review."}},{"k":"impact","v":{"o":[{"k":"critical_label","v":{"s":"Critical"}},{"k":"serious_label","v":{"s":"Serious"}},{"k":"moderate_label","v":{"s":"Moderate"}},{"k":"minor_label","v":{"s":"Minor"}},{"k":"critical_desc","v":{"s":"Blocks access for some users"}},{"k":"serious_desc","v":{"s":"Significantly degrades the experience"}},{"k":"moderate_desc","v":{"s":"Causes friction or confusion"}},{"k":"minor_desc","v":{"s":"Minor improvement"}}],"id":732}},{"k":"incomplete_heading","v":{"s":"Needs manual review"}},{"k":"incomplete_help","v":{"s":"These rules could not be automatically verified by axe-core. They commonly involve things like color contrast on gradient backgrounds, scrolling regions, or color meaning. A human needs to look and decide."}},{"k":"rules","v":{"o":[{"k":"color_contrast","v":{"s":"Some text on this page does not have enough contrast against its background. Students with low vision (about 1 in 12 people) would have trouble reading it."}},{"k":"color_contrast_enhanced","v":{"s":"Some text does not meet the higher AAA contrast standard. AA-level students may still read it; AAA is the stricter target."}},{"k":"image_alt","v":{"s":"Some images do not have alt text. Students who use screen readers (blind or low-vision students) will hear nothing or just a filename when this image appears."}},{"k":"input_image_alt","v":{"s":"An image button is missing alt text. Screen reader users will not know what the button does."}},{"k":"button_name","v":{"s":"A button has no name a screen reader can announce. The student would hear only \"button\" with no context."}},{"k":"link_name","v":{"s":"A link has no text or aria-label. Screen reader users will not know where it leads."}},{"k":"label","v":{"s":"A form input has no label. Students using screen readers or speech recognition will not know what to enter."}},{"k":"aria_required_attr","v":{"s":"An element has an ARIA role but is missing required attributes. Screen reader users may get confusing or no information."}},{"k":"aria_roles","v":{"s":"An element uses an ARIA role that is not valid. Screen readers may ignore it or behave unexpectedly."}},{"k":"aria_valid_attr","v":{"s":"An element has an invalid ARIA attribute. The accessibility hint is being ignored."}},{"k":"aria_valid_attr_value","v":{"s":"An ARIA attribute has an invalid value. The accessibility hint is being ignored."}},{"k":"duplicate_id","v":{"s":"Two elements share the same id. Screen readers and labels can attach to the wrong one."}},{"k":"duplicate_id_aria","v":{"s":"Duplicate IDs are interfering with ARIA labeling."}},{"k":"document_title","v":{"s":"The page has no <title>. Screen readers and tab listings will not identify it."}},{"k":"html_has_lang","v":{"s":"The page is missing a lang attribute. Screen readers will not know which pronunciation to use."}},{"k":"html_lang_valid","v":{"s":"The page lang attribute is not a valid language code."}},{"k":"landmark_one_main","v":{"s":"The page is missing a <main> landmark. Screen reader users have a harder time skipping past navigation to the main content."}},{"k":"region","v":{"s":"Some content is not contained in a landmark (header, main, nav, footer). Screen reader users may struggle to navigate."}},{"k":"heading_order","v":{"s":"Headings on this page skip levels (e.g., h1 jumping to h3). Screen reader navigation by heading levels gets confusing."}},{"k":"page_has_heading_one","v":{"s":"The page has no <h1> heading. Screen reader users lose orientation about the page topic."}},{"k":"list","v":{"s":"A list element (ul/ol) contains items that are not <li>. Screen readers misreport the structure."}},{"k":"listitem","v":{"s":"A list item is not inside a list. Screen readers will not announce list semantics."}},{"k":"frame_title","v":{"s":"An iframe is missing a title attribute. Screen reader users will not know what is inside it."}},{"k":"meta_viewport","v":{"s":"The viewport meta tag prevents zooming. Students who need to zoom in will be blocked from doing so."}},{"k":"tabindex","v":{"s":"An element has tabindex greater than 0. This breaks natural keyboard tab order."}},{"k":"scrollable_region_focusable","v":{"s":"A scrollable region cannot be focused with the keyboard. Keyboard-only users cannot scroll it."}},{"k":"autocomplete_valid","v":{"s":"A form field has an invalid autocomplete value. Some assistive tech relies on these to fill in fields automatically."}},{"k":"role_img_alt","v":{"s":"An element with role=\"img\" has no accessible name. Screen reader users will hear nothing."}},{"k":"svg_img_alt","v":{"s":"An SVG used as an image has no accessible name."}}],"id":733}}],"id":731}},{"k":"screenreader","v":{"o":[{"k":"heading","v":{"s":"Screen-reader announcement preview"}},{"k":"description","v":{"s":"Build the list of what a screen reader would announce while moving through the page in reading order, then listen. Headings, landmarks, links, form controls, and images with alt text are included. The lab modal itself is excluded. Uses your browser's built-in speech synthesis (the same kind of TTS engine real screen readers use, so the audio quality is representative of what students actually hear)."}},{"k":"no_speech_warning","v":{"s":"Your browser does not expose the Web Speech API. Try Chrome, Edge, or Firefox. The list will still build; you just will not hear the audio."}},{"k":"build","v":{"s":"🔊 Build announcement queue"}},{"k":"rescan","v":{"s":"Re-scan page"}},{"k":"play_all","v":{"s":"▶ Play all"}},{"k":"stop","v":{"s":"⏹ Stop"}},{"k":"speed_label","v":{"s":"Speed: "}},{"k":"speed_aria","v":{"s":"Playback speed"}},{"k":"idle","v":{"s":"Click \"Build announcement queue\" to scan the page (excluding this lab) for everything a screen reader would announce: headings, landmarks, links, buttons, form controls, and images with alt text. You can then play the whole queue or any single item."}},{"k":"empty","v":{"s":"No announceable elements found. The page might be empty, or the visible content is all behind aria-hidden, or all the elements lack both a role and an accessible name. This is itself a problem worth investigating."}},{"k":"queue_count_hint","v":{"s":"announcements queued. Click any item to hear it. The element is highlighted on the page while it speaks."}},{"k":"queue_built_prefix","v":{"s":"Built "}},{"k":"queue_built_suffix","v":{"s":" announcements (headings, landmarks, links, controls, and images with alt text)."}},{"k":"queue_failed","v":{"s":"Failed to build queue: "}},{"k":"tts_unavailable","v":{"s":"Browser speech synthesis not available."}},{"k":"play_one_title","v":{"s":"Play this announcement"}},{"k":"play_one_aria","v":{"s":"Play announcement"}},{"k":"tip","v":{"s":"Tip: try playing the whole queue with your eyes closed. That is a meaningful approximation of how a student using a screen reader navigates the page. If the announcements feel disorienting or skip critical content, that is a problem to fix."}}],"id":734}},{"k":"simulators","v":{"o":[{"k":"heading","v":{"s":"Disability simulators"}},{"k":"description","v":{"s":"Toggle a simulator to apply a CSS filter to the page behind this lab. The lab itself stays unfiltered so you can keep using these controls. Click a tile to enable; click again to disable. Only one simulator runs at a time."}},{"k":"framing_strong","v":{"s":"Important framing: "}},{"k":"framing_body","v":{"s":"simulators are imperfect approximations. They are useful for empathy-building and quick checks, NOT for verifying compliance. A protanopia filter is NOT the same as protanopia. Real users have lived with their condition; you are seeing it for 60 seconds. Use simulators to surface obvious problems (color-only information, low contrast, illegible text), then test with real users when stakes matter."}},{"k":"active_suffix","v":{"s":"· active"}},{"k":"info_suffix","v":{"s":"· info"}},{"k":"blur_amount_label","v":{"s":"Blur amount: "}},{"k":"blur_amount_hint","v":{"s":"(2px ≈ mild low vision; 5-8px ≈ severe)"}},{"k":"blur_amount_aria","v":{"s":"Blur amount in pixels"}},{"k":"stop","v":{"s":"Stop simulator"}},{"k":"motor_toast","v":{"s":"Motor impairment simulation: see the info card."}},{"k":"tip","v":{"s":"Tip: try the color-blindness simulators on a lesson that uses red/green to convey meaning (correct/incorrect, warning/safe). If the meaning is lost in the simulation, the original design is failing students with that condition. Add icons, labels, or patterns alongside color."}},{"k":"items","v":{"o":[{"k":"blur_label","v":{"s":"Low-vision blur"}},{"k":"blur_desc","v":{"s":"Approximates uncorrected low vision (visual acuity worse than 20/40). Roughly 4% of the population has uncorrected refractive error or other low-vision conditions; this share is much higher among older adults and students with visual impairments."}},{"k":"protanopia_label","v":{"s":"Protanopia (red-blind)"}},{"k":"protanopia_desc","v":{"s":"Severe red-green color vision deficiency, missing the L-cone. About 1% of males and very rare in females. Reds appear darker; reds and greens are confused."}},{"k":"deuteranopia_label","v":{"s":"Deuteranopia (green-blind)"}},{"k":"deuteranopia_desc","v":{"s":"The most common form of color blindness, missing the M-cone. About 6% of males. Reds and greens appear similar; the most common form of red-green color vision deficiency."}},{"k":"tritanopia_label","v":{"s":"Tritanopia (blue-blind)"}},{"k":"tritanopia_desc","v":{"s":"Rare form, missing the S-cone. About 0.01% of the population. Blues appear greenish; yellow-blue distinctions are lost."}},{"k":"achromatopsia_label","v":{"s":"Achromatopsia (no color)"}},{"k":"achromatopsia_desc","v":{"s":"Complete absence of color vision. Affects roughly 0.003% of the population (about 1 in 30,000). The world appears in shades of grey."}},{"k":"dyslexia_label","v":{"s":"Dyslexia visual stress"}},{"k":"dyslexia_desc","v":{"s":"A LIMITED simulation of one common visual-stress experience some dyslexic readers report (slight blur, lower contrast, shifting spacing). Dyslexia is highly individual; this is one slice, not a definitive rendering. About 5-10% of students have dyslexia."}},{"k":"motor_label","v":{"s":"Motor impairments"}},{"k":"motor_desc","v":{"s":"Motor impairments resist visual simulation. The most authentic test is to use the OS-level tools real students use: Windows Sticky Keys, macOS Slow Keys, dwell-click software, switch access (e.g., the iOS Switch Control or Android Switch Access). Try completing a lesson using only one hand, only the keyboard, or only one finger."}}],"id":736}}],"id":735}},{"k":"review","v":{"o":[{"k":"return_aria","v":{"s":"Return to Accessibility Lab review"}},{"k":"return_label","v":{"s":"Return to Accessibility Lab"}}],"id":737}}],"id":726}},{"k":"alts","v":{"o":[{"k":"scene_visualization","v":{"s":"Scene Visualization"}},{"k":"document_image","v":{"s":"Document image"}},{"k":"boss","v":{"s":"Boss"}},{"k":"cover","v":{"s":"Cover"}},{"k":"book_cover","v":{"s":"Book cover"}},{"k":"visual","v":{"s":"Visual"}},{"k":"alloflow","v":{"s":"AlloFlow"}}],"id":738}},{"k":"tooltips","v":{"o":[{"k":"save_close","v":{"s":"Save & close"}},{"k":"delete","v":{"s":"Delete"}},{"k":"close","v":{"s":"Close"}},{"k":"delete_highlight","v":{"s":"Delete highlight"}},{"k":"delete_drawing","v":{"s":"Delete drawing"}},{"k":"sticky_note","v":{"s":"Sticky note: click anywhere to leave a note"}},{"k":"highlighter","v":{"s":"Highlighter: select text to highlight"}},{"k":"voice_note","v":{"s":"Voice note: click to start recording (max 60s, stays local)"}},{"k":"drawing_pen","v":{"s":"Drawing: freehand pen overlay"}},{"k":"clear_annotations","v":{"s":"Clear all annotations"}},{"k":"pick_color","v":{"s":"Pick any color"}},{"k":"import_annotations","v":{"s":"Import annotations from a file (e.g., a student's downloaded annotations)"}},{"k":"edit_rubric_disarm","v":{"s":"Edit rubric / disarm"}},{"k":"make_chart_interactive","v":{"s":"Make this chart interactive — students fill in blanks + get AI feedback"}},{"k":"open_pictionary","v":{"s":"Open Concept Pictionary pre-loaded with this chart's terms"}},{"k":"download_png","v":{"s":"Download as PNG (poster-quality)"}},{"k":"read_aloud","v":{"s":"Read aloud"}},{"k":"move_up","v":{"s":"Move up"}},{"k":"move_down","v":{"s":"Move down"}},{"k":"theme_light","v":{"s":"Light (teacher default)"}},{"k":"theme_dark","v":{"s":"Dark mode"}},{"k":"theme_sepia","v":{"s":"Sepia (warm, low-glare)"}},{"k":"theme_hi