tColor","stroke-width":"3"}],["circle",{"cx":"105","cy":"25","r":"7","fill":"currentColor"}],["path",{"d":"M 105 76 l 9 9 l -9 9 l -9 -9 Z","fill":"currentColor"}],["text",{"x":"125","y":"30","text-anchor":"start"},"ANTERIOR"],["text",{"x":"125","y":"90","text-anchor":"start"},"POSTERIOR"]],["FIGCAPTION",{},"Circle = first landmark; diamond = opposite landmark."]],["DIV",{},["STRONG",{},"Read the illustration"],["P",{"data-spatial-axis-text":"true"},"ANTERIOR at top; POSTERIOR at bottom."],["P",{},"Use the specimen’s anatomical directions rather than assuming that screen-left is the animal’s left."],["P",{},"Before changing view, predict which landmark will stay in place and which structures may become obscured."]]],["DIV",{"class":"diss-spatial-guide__layer"},["STRONG",{},"Viewpoint and preparation are separate"],["P",{},"Changing view keeps the current layer and your evidence. The Internal preset does not cut tissue, complete preparation, or unlock deeper layers."],["P",{},"The layer map shows the activity sequence, not tissue thickness or a true anatomical cross-section."],["BUTTON",{"type":"button"},"Use preparation view: ventral"]]]],["DIV",{"class":"diss-stage__handoff","data-tone":"assessment","role":"group","aria-label":"Current action: Choose a study activity. Study tools. Workflow step 6 of 6"},["SPAN",{"class":"diss-stage__handoff-glyph","aria-hidden":"true"},"→"],["STRONG",{},"Next · Choose a study activity"],["SPAN",{"class":"diss-stage__handoff-tool"},"Study tools"],["SPAN",{"class":"diss-stage__handoff-progress"},"Workflow 6/6"]],["DETAILS",{"class":"diss-field-monitor"},["SUMMARY",{"class":"diss-field-monitor__summary"},["STRONG",{},"Field monitor"],["SPAN",{},"Limited observation field"],["SMALL",{},"Exposure and tissue-response details"]],["DIV",{"class":"diss-field-monitor__body"},["SECTION",{"class":"diss-stage__telemetry","data-tone":"stable","role":"group","aria-label":"Live specimen response monitor"},["DIV",{"class":"diss-stage__telemetry-hea