il","v":{"s":"unverified, check before relying on it:"}},{"k":"prefilled_toast","v":{"s":"Code {code} prefilled in Universal Settings. Verify it before use."}},{"k":"no_graph_for_these","v":{"s":"No graph is available for these, so no grounded directions can be proposed from them."}},{"k":"no_code_returned","v":{"s":"No standard code came back for that seed either."}},{"k":"resolve_error","v":{"s":"The local snapshot could not resolve this entry."}},{"k":"graph_context","v":{"s":"Graph context: {prereq} prerequisite(s), {next} next, {related} related{provider}. Directions are AI proposals grounded in these source edges, for educator judgment — not certification."}},{"k":"evidence_disclaimer","v":{"s":"Matches are alignment evidence to support educator judgment, not official certification, and not for grading, placement, or evaluation."}},{"k":"exact_match","v":{"s":"Exact local match: {code}"}},{"k":"use_resolved","v":{"s":"Use resolved standard"}},{"k":"remove_target_first","v":{"s":"Remove the current target standard before using a resolved local record."}},{"k":"surprise_heading","v":{"s":"Surprise me: lessons in this learning space"}},{"k":"propose_again","v":{"s":"Propose again"}},{"k":"propose_3_sparkle","v":{"s":"✨ Propose 3 directions"}},{"k":"ambiguous_framework","v":{"s":"Multiple exact matches. Choose the intended framework."}},{"k":"no_exact_match","v":{"s":"No exact local match."}},{"k":"possible_codes","v":{"s":"Possible codes to review:"}},{"k":"provider_suffix","v":{"s":" — {provider}"}},{"k":"dir1_title","v":{"s":"Connect prior knowledge"}},{"k":"dir1_phenomenon_prior","v":{"s":"A bridge from {prior} to {target}."}},{"k":"dir1_phenomenon_plain","v":{"s":"Examples and non-examples of {target}."}},{"k":"dir1_question_prior","v":{"s":"How does {prior} help us understand {target}?"}},{"k":"dir1_question_plain","v":{"s":"What makes an example demonstrate {target}?"}},{"k":"dir1_activity","v":{"s":"Sort examples and non-examples, then annotate the evidence for each choice."}},{"k":"dir1_evidence","v":{"s":"An annotated example and a brief evidence-based explanation."}},{"k":"dir1_udl_1","v":{"s":"Offer visual, spoken, and written examples"}},{"k":"dir1_udl_2","v":{"s":"Allow drawing, speaking, or writing"}},{"k":"dir2_title","v":{"s":"Compare and justify"}},{"k":"dir2_phenomenon_related","v":{"s":"A choice involving {target} and the source-listed related idea {related}."}},{"k":"dir2_phenomenon_plain","v":{"s":"Two plausible approaches to {target}."}},{"k":"dir2_question","v":{"s":"Which approach best demonstrates {target}, and why?"}},{"k":"dir2_activity","v":{"s":"Compare two approaches, choose or revise one, and justify the decision with evidence."}},{"k":"dir2_evidence","v":{"s":"A comparison that names specific features and supports a choice."}},{"k":"dir2_udl_1","v":{"s":"Use a side-by-side organizer"}},{"k":"dir2_udl_2","v":{"s":"Provide sentence starters for justification"}},{"k":"dir3_title","v":{"s":"Create and teach"}},{"k":"dir3_phenomenon","v":{"s":"A design challenge that makes {target} clear to someone else."}},{"k":"dir3_question","v":{"s":"How can we create and teach a clear example of {target}?"}},{"k":"dir3_activity","v":{"s":"Create a model, explanation, or demonstration, then improve it with peer feedback."}},{"k":"dir3_evidence","v":{"s":"A student-created example plus a reflection on how it meets the target."}},{"k":"dir3_udl_1","v":{"s":"Offer model, audio, video, or text options"}},{"k":"dir3_udl_2","v":{"s":"Use a short feedback checklist"}},{"k":"brief_phenomenon","v":{"s":"Phenomenon: "}},{"k":"brief_question","v":{"s":"Essential question: "}},{"k":"brief_activity","v":{"s":"Activity: "}},{"k":"brief_evidence","v":{"s":"Evidence of learning: "}},{"k":"brief_udl","v":{"s":"UDL supports: "}},{"k":"pin_button","v":{"s":"Pin to edit & use"}},{"k":"pinned_button","v":{"s":"Pinned"}},{"k":"prereq_line","v":{"s":"Prerequisites (from source data): {codes} — shared by all three directions."}},{"k"