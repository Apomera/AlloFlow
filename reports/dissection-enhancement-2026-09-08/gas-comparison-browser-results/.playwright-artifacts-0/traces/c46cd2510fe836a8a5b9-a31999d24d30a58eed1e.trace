stat__label { display: block; color: rgb(165, 243, 252); font-size: 0.62rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; }\n.diss-stat__value { display: block; margin-top: 0.15rem; overflow: hidden; color: rgb(255, 255, 255); font-size: 0.78rem; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }\n.diss-workspace-mode__choices { display: inline-flex; gap: 0.25rem; margin-left: auto; padding: 0.25rem; border: 1px solid rgb(169, 201, 238); border-radius: 0.75rem; background: rgb(255, 255, 255); }\n.diss-mode-rail .diss-route-button { flex: 1 1 auto; }\n.diss-workspace-mode__choices button { min-height: 2.5rem; padding: 0.48rem 0.72rem; border: 1px solid transparent; border-radius: 0.55rem; background: transparent; color: rgb(54, 80, 111); font-size: 0.72rem; font-weight: 900; cursor: pointer; }\n.diss-workspace-mode__choices button[aria-pressed=\"true\"] { border-color: rgb(23, 102, 210); background: rgb(23, 102, 210); color: rgb(255, 255, 255); }\n.diss-mode-rail { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; padding: 0.45rem; border: 1px solid var(--diss-line); border-radius: 1rem; background: linear-gradient(rgb(248, 251, 255), rgb(238, 246, 255)); }\n.diss-route-button { border: 1px solid transparent; border-radius: 0.75rem; background: transparent; color: rgb(54, 80, 111); font-size: 0.76rem; font-weight: 900; cursor: pointer; min-height: 2.75rem !important; }\n.diss-route-button[data-active=\"true\"] { border-color: rgb(138, 183, 237); background: rgb(255, 255, 255); box-shadow: rgba(23, 102, 210, 0.12) 0px 5px 16px; color: rgb(11, 87, 179); }\n[data-dissection-root][data-workspace-mode=\"essentials\"] .diss-advanced-only, [data-dissection-root][data-workspace-mode=\"essentials\"] .diss-shortcuts, [data-dissection-root][data-workspace-mode=\"essentials\"] .diss-procedure__mode, [data-dissection-root][data-workspace-mode=\"essentials\"] .diss-procedure__metrics, [data-dissection-root][data-workspace-mode