    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/1242.png",
      "text": "Cirka muxu buluug u yahay?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=1",
      "sourceDigest": "sha256:edb1c0d485288ca83967492ba2c9f1220bd9d43b693e5e24540ea89168d5b53c"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/1243.png",
      "text": "Mar walba buluug ma aha. Miyuu yahay?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=2",
      "sourceDigest": "sha256:7b5d91f9339143a96b092cac86c74b606da084952dbd49a3db6e0b3f4753e8a3"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/1917.png",
      "text": "Caleemaha maxay cagaar u yihiin?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=3",
      "sourceDigest": "sha256:29c706c62ec85fe58cbaba4d1ff8f120dead4f31bf818964483a817b13c264d4"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/1054.png",
      "text": "Ma aha marwalba cagaar. Miyey yihiin?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=4",
      "sourceDigest": "sha256:70b66e76d612e6fca83059bba69a116c24f76f3b00f09b7bfb767fbdaa4304a6"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/1918.png",
      "text": "Moosku muxu u yahay jaale?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=5",
      "sourceDigest": "sha256:1c1c6353348a1fe97b7460f0fd35f6663a22d826f6b37c778f5842ca123241a3"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/1919.png",
      "text": "Mooska bisil waa jaalle. Midka cayriinka ahna waa cagaar.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=6",
      "sourceDigest": "sha256:990ad7b652e7603ba81642df56b560a46d5d2be30ca732aecd36ea110c3784ca"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/1920.png",
      "text": "Daladuhu maxay u yihin madow?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=7",
      "sourceDigest": "sha256:790f709d58c5993ed7fdcc6a1e340b0da740bcbdf52270fc8280376847943fe2"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/1922.png",
      "text": "Daladuha oo dhan ma aha madow.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=8",
      "sourceDigest": "sha256:f35010889f50db994eee543abdf705ddc9f650d7dee6e371d23bb07d9c384501"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/1923.png",
      "text": "Muxu dhiigu u yahay gaduud?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=9",
      "sourceDigest": "sha256:67561a89111e0b68966247e793e55d1cefde3b56151d15da769ce0daeb338a8d"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/1924.png",
      "text": "Waxa kujira bir dhiiga. Taasi waxay ka dhigaysaa gaduud.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52481#page=10",
      "sourceDigest": "sha256:9864729e1c423f507b7e17d50934fa6c3628c9770b158aaf0f223ec341fa0175"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/1925.png",
