:"Applied challenge selection mode"}},{"k":"match_auto","v":{"s":"Auto Match - choose the strongest application"}},{"k":"match_manual","v":{"s":"Choose a challenge family"}},{"k":"family","v":{"s":"Challenge family"}},{"k":"family_aria","v":{"s":"Applied challenge family"}},{"k":"ai_role","v":{"s":"Who frames the problem?"}},{"k":"ai_role_aria","v":{"s":"Applied challenge AI role"}},{"k":"ownership_note","v":{"s":"The student always owns the response. Coaching never fills student fields."}},{"k":"depth","v":{"s":"Challenge depth"}},{"k":"depth_aria","v":{"s":"Applied challenge depth"}},{"k":"instructions","v":{"s":"Teacher instructions"}},{"k":"instructions_aria","v":{"s":"Custom instructions for applied challenge"}},{"k":"instructions_placeholder","v":{"s":"Use a local issue, require two alternatives..."}},{"k":"building","v":{"s":"Building applied challenge..."}},{"k":"build","v":{"s":"Build Applied Challenge Studio"}},{"k":"preview_note","v":{"s":"Build a teacher-editable challenge draft, review its facts and product, then try Student preview before sharing."}},{"k":"customize","v":{"s":"Customize the challenge and support"}},{"k":"summary","v":{"s":"Your task settings"}},{"k":"check_plan","v":{"s":"In your instructions, say whether learners will plan a check or carry it out. Review the generated product against the available time."}}],"id":785}},{"k":"common","v":{"o":[{"k":"optional","v":{"s":"optional"}},{"k":"hide","v":{"s":"Hide"}},{"k":"show","v":{"s":"Show"}}],"id":786}},{"k":"toast","v":{"o":[{"k":"check_needs_draft","v":{"s":"Frame a working question and add a draft response before starting a check."}},{"k":"six_checks","v":{"s":"This challenge already has six saved checks. Remove one before adding another."}},{"k":"no_ai_coaching","v":{"s":"AI coaching is not available yet."}},{"k":"hint_stale","v":{"s":"Your work changed while the hint was being prepared. Ask again for an up-to-date hint."}},{"k":"hint_empty","v":{"s":"The coach returned no usable hint. Try again when you are ready."}},{"k":"hint_failed","v":{"s":"The coach could not create a hint. Your work is still saved."}},{"k":"no_ai_stress","v":{"s":"AI stress testing is not available yet."}},{"k":"stress_stale","v":{"s":"Your draft changed while the stress test was being prepared. Ask again for a current challenge."}},{"k":"stress_empty","v":{"s":"The coach returned no usable stress test. Try again when your draft is ready."}},{"k":"stress_added","v":{"s":"One pressure test was added without changing your draft."}},{"k":"stress_failed","v":{"s":"The stress test could not be generated. Your work is still saved."}},{"k":"no_ai_feedback","v":{"s":"AI feedback is not available yet."}},{"k":"feedback_stale","v":{"s":"Your work changed while feedback was being prepared. Request feedback again for the current draft."}},{"k":"feedback_added","v":{"s":"Feedback added without changing your work."}},{"k":"feedback_failed","v":{"s":"Feedback could not be generated. Your work is still saved."}}],"id":787}},{"k":"workspace","v":{"o":[{"k":"teacher_prompt_aria","v":{"s":"Teacher prompt for {label}"}},{"k":"placeholder","v":{"s":"Write your thinking here..."}},{"k":"heading","v":{"s":"Your problem-solving workspace"}},{"k":"note","v":{"s":"Your writing stays separate from AI examples, hints, and feedback."}},{"k":"progress","v":{"s":"{started} of {total} sections started"}},{"k":"progress_aria","v":{"s":"Applied challenge workspace sections started"}},{"k":"hint_phase","v":{"s":"Hint for phase"}},{"k":"hint_busy","v":{"s":"Thinking of one hint..."}},{"k":"hint","v":{"s":"Ask for one hint"}},{"k":"coach_hint","v":{"s":"Coach hint:"}},{"k":"near_limit","v":{"s":"{remaining} characters left in this section."}},{"k":"navigation","v":{"s":"Workspace sections"}},{"k":"stage_progress","v":{"s":"{stage} · Step {number} of 5"}}],"id":788}},{"k":"cycle","v":{"o":[{"k":"heading","v":{"s":"Check {n}"}},{"k":"stage_complete","v":{"s":"Complete"}},{"k":"stage_review","v":{"s":"Review t