ria"}},{"k":"time_minutes","v":{"s":"Minutes"}},{"k":"xp_amount","v":{"s":"XP amount"}},{"k":"your_goals","v":{"s":"Check assignment progress"}},{"k":"soft_gate_nudge","v":{"s":"💡 Tip from your teacher: finish your goals first ({done}/{total} done). You can keep going!"}},{"k":"map_choose_station","v":{"s":"Choose a station from the map or the list below to continue."}},{"k":"choice","v":{"s":"choice"}},{"k":"single_choice_selected","v":{"s":"You can return to this activity at any time."}},{"k":"single_choice_hint","v":{"s":"Open the remaining activity, or ask your teacher for an updated board."}}],"id":15}},{"k":"saved_work","v":{"o":[{"k":"recovery_key_aria","v":{"s":"Shown-once AlloFlow recovery key"}},{"k":"close_aria","v":{"s":"Close saved work manager"}}],"id":16}},{"k":"share_collect","v":{"o":[{"k":"close_aria","v":{"s":"Close Share & Collect"}},{"k":"window_placeholder","v":{"s":"45 minutes next week, weekday afternoons"}},{"k":"options_placeholder","v":{"s":"Tue Mar 4, 3:15pm\nWed Mar 5, 3:15pm\nThu Mar 6, 3:15pm"}},{"k":"signup_slots_placeholder","v":{"s":"Read-aloud\nGlossary\nPictures"}},{"k":"scale_low_aria","v":{"s":"Label for the low end"}},{"k":"scale_high_aria","v":{"s":"Label for the high end"}},{"k":"intro_placeholder","v":{"s":"Who is asking, what the answers are for, and that taking part is voluntary."}},{"k":"status_summary_aria","v":{"s":"Assignment status summary"}},{"k":"filter_aria","v":{"s":"Filter assignments"}},{"k":"qr_aria","v":{"s":"Homework assignment QR code"}},{"k":"link_aria","v":{"s":"Selectable homework link"}},{"k":"auto_updates_aria","v":{"s":"Updates automatically"}},{"k":"title","v":{"s":"Share & Collect"}},{"k":"subtitle","v":{"s":"Set up a poll, sign-up sheet or class activity, share it by link or QR, and watch the responses arrive. Everything here is saved on this teacher device."}},{"k":"setup_title","v":{"s":"Add a shared activity"}},{"k":"setup_sub","v":{"s":"Attached to the next assignment link or QR code you create.