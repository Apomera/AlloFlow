    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/10081.png",
      "text": "Waxaa jiray nin la oran jiray Zoba. Zoba wuxuu ahaa aabe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=1",
      "sourceDigest": "sha256:c304688952abc4e0dd005b479223804e3eeba01a9a59aacf573563c1a6af2b17"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/10082.png",
      "text": "Azibo wuxuu ahaa wiilka Zoba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=2",
      "sourceDigest": "sha256:42efb14f101757addb3dcac1006ee74258b29f438ef63f4819ee0180565d5d8e"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/10083.png",
      "text": "Maalin maalmaha ka mid ah Zoba iyo Azibo ayaa socod u baxay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=3",
      "sourceDigest": "sha256:74b4a012cb02f3bb0e4cd44ba059af28da54339bed95100d7ad7e41fbb30c8ce"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/10084.png",
      "text": "Waxay arkeen shandad aad u qurux badan oo jidka dhiniciisa taal. Way buuxday.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=4",
      "sourceDigest": "sha256:280590ac9e42a31a574bb0d4a0b6c8693ceedc6bc28c56d25031edf1fbb0c960"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/10085.png",
      "text": "\"Qaad shandada, waxaan u qaadaneynaa guriga,\" waxaa yiri Zoba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=5",
      "sourceDigest": "sha256:cf6decad0724d073b666c631b02998b69230a811084a02cab44c0c24e414fcb7"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/10087.png",
      "text": "Wiilkii wuu soo qaaday shandaddii, wuxuuna saaray madaxiisa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=6",
      "sourceDigest": "sha256:582a93fff15048283501a0af072e73d535458a56cd9944bd60fc88b7b491d176"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/10086.png",
      "text": "Inta ay guriga u sii socdeen, shandadii waxaa kasoo baxay mas. Wuxuu ku dhacay cagaha Azibo!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=7",
      "sourceDigest": "sha256:e9a5576a5ad0d7f67c94a2138187ad227b92c93e3ad42179fda99fc85d234793"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/10088.png",
      "text": "Aabbaha iyo wiilkiisii labaduba aad bay u baqeen. Shandaddii bay tuureen, si degdeg ahna u carareen.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52320#page=8",
      "sourceDigest": "sha256:20b3fd2663ffeb6dbb71c65d2380da80d47932cf27867480fd8e25f7f70281bf"
    }
  ],
