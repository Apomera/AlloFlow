{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alloflow.org/schemas/source-patch-plan-v0.json",
  "title": "AlloFlow source remediation patch plan",
  "$comment": "Runtime validation additionally enforces: every patched file listed in target.files with a matching SHA-256; every find occurring EXACTLY once in its file; no patches to vendored/minified paths; path containment under the root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "patches", "review_notes"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "files"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "find", "replace", "rationale"],
        "properties": {
          "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "find": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "replace": { "type": "string", "maxLength": 20000 },
          "rationale": { "type": "string", "minLength": 20, "maxLength": 2000 },
          "wcag": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "maxLength": 20 }
          },
          "changes_rendered_text": { "type": "boolean", "default": false }
        }
      }
    },
    "review_notes": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "minLength": 1, "maxLength": 5000 }
    }
  }
}
