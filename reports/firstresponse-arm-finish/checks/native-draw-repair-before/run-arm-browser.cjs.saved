const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{spawn,spawnSync}=require('node:child_process');
const root='C:/Users/cabba/OneDrive/Desktop/UDL-Tool-Updated',work=__dirname;
const run=process.argv[2]||'native';if(!/^[a-z0-9-]+$/.test(run))throw Error('Unsafe run name');
const availableViews=['adult-heel-side','child-heel-side-contrast'],selection=process.argv[3]||'all',baselineOnly=process.argv[4]==='baseline';
if(process.argv[4]&&!baselineOnly)throw Error('Fourth argument must be baseline or omitted');
const selectedViews=selection==='all'?availableViews:selection.split(',');
if(!selectedViews.length||new Set(selectedViews).size!==selectedViews.length||selectedViews.some(id=>!availableViews.includes(id)))throw Error('Invalid view selection');
const expectedWorkflows=selectedViews.length,variants=baselineOnly?['baseline']:['baseline','candidate'],expectedEvidence=expectedWorkflows*variants.length*2;
const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),baselinePath=path.join(work,'before.js'),candidatePath=baselineOnly?baselinePath:path.join(work,'candidate.js'),source=fs.readFileSync(candidatePath),baseline=fs.readFileSync(baselinePath);
const baselineSHA='179ddeefd0c930ca4a084d98fc683c321fb4f36f720e62cddf8b30d56b576466',finalSHA=sha(source);if(sha(baseline)!==baselineSHA)throw Error('Baseline drift');if(!baselineOnly&&finalSHA===baselineSHA)throw Error('Candidate is unchanged');if(!baselineOnly){const delta=JSON.parse(fs.readFileSync(path.join(work,'delta.json'),'utf8'));if(delta.afterSHA256!==finalSHA)throw Error('Candidate/delta pin mismatch');}
const shared=['stem_lab/stem_tool_firstresponse.js','desktop/web-app/public/stem_lab/stem_tool_firstresponse.js','desktop/app-build/stem_lab/stem_tool_firstresponse.js','desktop/web-app/build/stem_lab/stem_tool_firstresponse.js'].map(p=>path.join(root,p));
for(const p of shared)if(sha(fs.readFileSync(p))!==baselineSHA)throw Error('Shared source drift '+p);
const report=path.join(work,run);fs.mkdirSync(report,{recursive:true});const result=path.join(report,'browser-run.json'),log=path.join(report,'browser-run.log');if(fs.existsSync(result)||fs.existsSync(log))throw Error('Evidence exists; choose a fresh run name');
const guard=[__filename,baselinePath,candidatePath,path.join(work,'firstresponse-arm-preview.spec.ts'),path.join(work,'arm-mount-window.cjs'),path.join(work,'playwright-arm.config.cjs'),path.join(work,'arm-capture-png.cjs'),path.join(root,'node_modules/playwright-core/lib/utilsBundle.js'),...shared,path.join(root,'tests/e2e/helpers/stem_gl_harness.ts'),path.join(root,'vendor/three-r128/three.min.js'),path.join(root,'stem_lab/stem_lab_module.js')];
if(!baselineOnly)guard.push(path.join(work,'delta.json'));
const inputs=Object.fromEntries(guard.map(p=>[p,sha(fs.readFileSync(p))])),startedAt=new Date().toISOString();fs.writeFileSync(path.join(report,'inputs.json'),JSON.stringify({baselineSHA,finalSHA,inputs,selectedViews,baselineOnly,expectedWorkflows,expectedEvidence,workers:1,retries:0,startedAt},null,2));
const args=[path.join(root,'node_modules/@playwright/test/cli.js'),'test','firstresponse-arm-preview.spec.ts','--config='+path.join(work,'playwright-arm.config.cjs'),'--workers=1','--retries=0','--reporter=list,json'];
const stream=fs.createWriteStream(log),child=spawn(process.execPath,args,{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe'],env:{...process.env,PLAYWRIGHT_BROWSERS_PATH:'C:/Users/cabba/AppData/Local/ms-playwright',PLAYWRIGHT_JSON_OUTPUT_NAME:result,FIRST_RESPONSE_ARMS_WORK:work,FIRST_RESPONSE_ARMS_REPORT:report,FIRST_RESPONSE_ARMS_VIEWS:selectedViews.join(','),FIRST_RESPONSE_ARMS_SOURCE_SHA:finalSHA,FIRST_RESPONSE_ARMS_CANDIDATE:candidatePath,FIRST_RESPONSE_ARMS_BASELINE_ONLY:baselineOnly?'1':'0'}});
let timedOut=false;const limit=setTimeout(()=>{timedOut=true;spawnSync('taskkill',['/PID',String(child.pid),'/T','/F'],{windowsHide:true,stdio:'ignore'});},900000);
fs.writeFileSync(path.join(report,'runner.json'),JSON.stringify({pid:child.pid,args,startedAt},null,2));console.log('START arm browser pid='+child.pid+' source='+finalSHA+' baselineOnly='+baselineOnly);child.stdout.pipe(stream,{end:false});child.stderr.pipe(stream,{end:false});child.on('error',error=>{console.error(error);process.exitCode=1;});
child.on('close',code=>{clearTimeout(limit);stream.end();try{if(timedOut)throw Error('Native runner exceeded 900000ms bound');for(const[p,h]of Object.entries(inputs))if(sha(fs.readFileSync(p))!==h)throw Error('Input drift '+p);if(!fs.existsSync(result))throw Error('Missing browser result, exit='+code);const r=JSON.parse(fs.readFileSync(result,'utf8'));if(code!==0||r.stats.expected!==expectedWorkflows||r.stats.unexpected||r.stats.skipped||r.stats.flaky)throw Error('Browser failed '+JSON.stringify(r.stats));const metrics=JSON.parse(fs.readFileSync(path.join(report,'arm-preview-metrics.json'),'utf8')),images=fs.readdirSync(report).filter(p=>p.endsWith('.png')).sort();if(metrics.evidence.length!==expectedEvidence||images.filter(p=>p.endsWith('-stage.png')).length!==expectedEvidence||images.filter(p=>p.endsWith('-wrists.png')).length!==expectedEvidence)throw Error('Incomplete captures');if(images.filter(p=>p.endsWith('-elbows.png')).length!==metrics.evidence.filter(e=>e.elbowDetail).length)throw Error('Elbow capture count mismatch');for(const e of metrics.evidence){if(!e.detail.proof.sameCapturedFrame||e.elbowDetail&&(!e.elbowDetail.proof.sameCapturedFrame||e.elbowDetail.proof.sourceSHA256!==e.detail.proof.sourceSHA256))throw Error('Detail crops do not use same stage frame');}for(const id of selectedViews)for(const variant of variants)for(const phase of ['release','compression'])if(metrics.evidence.filter(e=>e.id===id&&e.variant===variant&&e.phase===phase).length!==1)throw Error('Missing matched evidence '+id+' '+variant+' '+phase);if(metrics.evidence.some(e=>!selectedViews.includes(e.id)))throw Error('Unexpected view');const summary={baselineSHA,finalSHA,baselineOnly,workflows:expectedWorkflows,selectedViews,evidenceCount:metrics.evidence.length,workers:1,retries:0,perWorkflowTimeoutMs:450000,runnerTimeoutMs:900000,elbowCaptureCount:metrics.evidence.filter(e=>e.elbowDetail).length,images,stats:r.stats,inputsUnchanged:true,privateCandidate:true};fs.writeFileSync(path.joi