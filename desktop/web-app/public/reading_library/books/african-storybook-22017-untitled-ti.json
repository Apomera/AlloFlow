  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/25729.png",
      "text": "ቅድሚ ብዙሕ ዓመታት ኣብ ሓደ መዕቆቢ እንስሳት ቡዙሓት እንስሳ ዘገዳም ይነብሩ ነበሩ፡፡ ካብዚኦም ኳኽን ቡዃርያን ኣዕርኽቲ ነይሮም፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=1",
      "sourceDigest": "sha256:648eb75df118012f27c3bd12deb2166058abb21465f361588bc14b1461e7f458"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/25730.png",
      "text": "ኣብ ዚ እዋን ኣብቲ ከባቢ ሕፅረት ምግቢ ኣጋጠመ፡፡ ካብዞም እንስሳት ቡዃርያን ኳኽን ብጣዕሚ ስለዝጠመዩ ኣዐርዮም ተጨነቁ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=2",
      "sourceDigest": "sha256:bc55939b0484ac8946713ba85523c0e0775c35face2d7b06f66f2cc032e1556e"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25731.png",
      "text": "ኳኽን ቡዃርያን ምግቢ ንምድላይ ብሓደ ናብ ካሊእ ቦታ እንትጉዓዙ ዝወደቐ ስጋ ረኸቡ፡፡ ኳኽ ተቐዳዲሙ ነቲ ስጋ ብምልዓል በይኑ ክበልዕ ጀመረ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=3",
      "sourceDigest": "sha256:dc9a79226bbbb35a4661165503a20a2186171e136dc876594841e3574c53b257"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25732.png",
      "text": "ቡዃርያ ኳኽ በይኑ ስጋ እናበልዐ ስለዝረኣየቶ ተናደደት፡፡ ሰላሕ እናበለት ብምኻድ ትሕዞ እሞ፣ «ሐዚ እንታይ ይሕሸካ? ክቐትለካ ዶ ወይስ ክገድፈካ» በለቶ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=4",
      "sourceDigest": "sha256:34bcfc23c680c5a19d532ade9f5cbe90bf50a6b78e5a6717001473f27734d239"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25733.png",
      "text": "ዃኽ ድማ ፣ «በይዛኺ፥ ቡዃርያ ሓፍተይ ብገደል ከይተፅድፍኒ እምበር፣ ካኪእ ዝደለኽዮ ቅፅዓት ቅፅዕኒ» በለ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=5",
      "sourceDigest": "sha256:c8f7725512e5276e26e8afc351787a5cb22b68739a2211ff5f1ba601ab0bad7d"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25734.png",
      "text": "ቡዃርያ ንኳኽ ብጣዕሚ ስለዝፀልአቶ፣ «እሺ ዝሓወይ» ብምባል ሒዛቶ ናብ ገደል ዘለዎ ቦታ ጉዕዞ ጀመረት፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=6",
      "sourceDigest": "sha256:1fd1d1fd40db0e946f8bf8e9386134281c00378248e511304d6d6b08a7cd57c5"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25735.png",
      "text": "ቡዃርያ ንኳኽ ሒዛ ኣብቲ ገደል ዘለዎ ቦታ በፅሐት በቲ ገደል ክተፅድፎ ከዓ ተዳለወት፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=7",
      "sourceDigest": "sha256:e2762b89f63f35bc5db0ee6b3f81802e7efd23a303df69a98d922c70cb1afbd2"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25736.png",
      "text": "ቡዃርያ ንኳኽ ኣብ አፍ ገደል ኰይና ሸው ኣበለቶ፡፡ ድሕሪ እዚ ኳኽ ሙማቱን ዘይምሟቱን ንምፍላጥ ኣማዕድያ ረኣየት፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=8",
      "sourceDigest": "sha256:57bc7c9c0ca71a19a8409a465c635d05c34d314513b7d2b7e4eb3aa6e6eb646e"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/25737.png",
      "text": "ኳኽ ከዓ ቡዃርያ ምስ ሰንደወቶ ፍር ኢሉ ኣብ ጥቕኡ ናብ ዝነበረ ዓብዪ ኦም ዓለበ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=9",
      "sourceDigest": "sha256:ac872efd39e1883beeedd5a108f16719f4cd391269bcb5d4bbf3c9b587d19a7a"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/25738.png",
      "text": "ኳኽ ድሕሪ ቁሩብ ዕረፍቲ ቆላሕ ኢሉ ናብቲ ቡዃርያ ዝነበረቶ ቦታ ረኣየ፡፡ ቡዃርያ ኣብ ዝነበረቶ ቦታ ደው ኢላ ረኣያ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=10",
      "sourceDigest": "sha256:1a79338331713fef99a34cb2c95b50d0fa83c152df3394137e0f819bdb019e20"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/25739.png",
      "text": "ኳኽ ድማ ብፍርሒ ኣዐርዩ ተጨኒቁ ስለዝነበረ ንቡዃርያ ፣ «ወፃእኹዋ እባ ብብልሓተይ» ኢሉ ተዛረበ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=11",
      "sourceDigest": "sha256:04b7f50fe509c41353dc0f689749c128a9fcba2aa215e2c315162e784ab9b784"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/25740.png",
      "text": "ቡዃርያ እቲ ዝሓሰበቶ ስለዘይኰነላ ብሕርቃን ንኳኽ «ሰደድኩዃ እባ ብሕውነተይ» ኢላ መለሰትሉ ፡፡",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=22017#page=12",
      "sourceDigest": "sha256:c36e578f907dc67e1258b235196c1c1cba507c53b4c78220c9c525517f7353dc"
    }
