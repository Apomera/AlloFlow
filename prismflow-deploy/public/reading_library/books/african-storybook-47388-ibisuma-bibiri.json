    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/18363.png",
      "text": "Ijoro rimwe, ibisuma bibiri vyagiye kwiba ibigori mu murima. Ntivyari bizinanye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=1",
      "sourceDigest": "sha256:6c156fc7bc8035870f18f315157c0b170788e35122f96ede58b6a7cc01949059"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/18364.png",
      "text": "Igisuma cambere caraje kirasoroma umufuko w'ibigori.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=2",
      "sourceDigest": "sha256:2d06a32476447540c5d2d9210783e3308e63a722ae359c7723e1701ae1bfbfdc"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/18365.png",
      "text": "Umusuma wa kabiri yinjiye mu murima asize ikinga ryiwe inyuma y'umurima.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=3",
      "sourceDigest": "sha256:1a87e0262fc5d29defebc5bdccb8ca720103dae8ea81eb9e449d49e34a32c726"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/18366.png",
      "text": "Ivyo bisuma bibiri vyasitanira mumurima. Umwe wese akankamira uwundi babazanya bati, \"Wewe uri inde?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=4",
      "sourceDigest": "sha256:262cce930b9546283a806e4cee3242806c14684505f72464e6f25898a4d4cbd8"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/18367.png",
      "text": "Bose bagira ubwoba, baca batungwa nayo bameze, bariruka ntawafashe inzira imwe n'uyundi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=5",
      "sourceDigest": "sha256:aa746fbd9bbcb839040285867ccd4ab169b2edf84f6595b9eb5df675dbd4a543"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/18368.png",
      "text": "Umusuma wa mbere yatayeho umufuko w' ibigori.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=6",
      "sourceDigest": "sha256:18045c7c2aeb3161904380312699aff74b7801983c4ce07a9522281d1e828f81"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/18369.png",
      "text": "Uwakabiri ataho ikinga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=7",
      "sourceDigest": "sha256:a7d8c086df9942e3c998ab8e7574e517569b10995a66036bb6c82f6dc62a9e6e"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/18370.png",
      "text": "Nyene umurima ashitse, atora rya kinga ariremeka wa mufuko w'ibigori.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47388#page=8",
      "sourceDigest": "sha256:63f6d5c81b3cc8a6d4a7ffab1c1a72c076434c8e588cd1034dab08f4b72a987c"
