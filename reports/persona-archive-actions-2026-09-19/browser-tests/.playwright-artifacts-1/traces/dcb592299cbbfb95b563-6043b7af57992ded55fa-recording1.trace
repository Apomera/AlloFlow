ding_on_capital_goods_new","v":{"s":"Business spending on capital goods, new construction, and inventory changes."}},{"k":"government","v":{"s":"Government"}},{"k":"government_spending_on_goods_and_servi","v":{"s":"Government spending on goods and services (excludes transfer payments like Social Security)."}},{"k":"net_exports_x_m","v":{"s":"Net Exports (X-M)"}},{"k":"exports_minus_imports_currently_negati","v":{"s":"Exports minus imports. Currently negative for the US (trade deficit)."}},{"k":"gdp_growth_rate","v":{"s":"GDP Growth Rate"}},{"k":"percentage_change_in_real_gdp_2_3_is_h","v":{"s":"Percentage change in real GDP. 2-3% is healthy."}},{"k":"cpi_consumer_price_index","v":{"s":"CPI (Consumer Price Index)"}},{"k":"measures_average_price_changes_the_mai","v":{"s":"Measures average price changes. The main inflation gauge."}},{"k":"unemployment_rate","v":{"s":"Unemployment Rate"}},{"k":"percent_of_labor_force_without_jobs_na","v":{"s":"Percent of labor force without jobs. Natural rate is ~4%."}},{"k":"federal_funds_rate","v":{"s":"Federal Funds Rate"}},{"k":"interest_rate_banks_charge_each_other_","v":{"s":"Interest rate banks charge each other. The Fed's main tool."}},{"k":"s_p_500","v":{"s":"S&P 500"}},{"k":"index_of_500_large_us_companies_proxy_","v":{"s":"Index of 500 large US companies. Proxy for the stock market."}},{"k":"consumer_confidence","v":{"s":"Consumer Confidence"}},{"k":"survey_of_how_optimistic_consumers_fee","v":{"s":"Survey of how optimistic consumers feel about the economy."}},{"k":"housing_starts","v":{"s":"Housing Starts"}},{"k":"number_of_new_residential_construction","v":{"s":"Number of new residential construction projects begun."}},{"k":"trade_balance","v":{"s":"Trade Balance"}},{"k":"exports_minus_imports_surplus_positive","v":{"s":"Exports minus imports. Surplus = positive, deficit = negative."}},{"k":"national_debt","v":{"s":"National Debt"}},{"k":"total_government_borrowing_us_debt_is_","v":{"s":"Total government borrowing. US debt is ~$34 trillion (2024)."}},{"k":"yield_curve","v":{"s":"Yield Curve"}},{"k":"plots_interest_rates_vs_bond_maturity_","v":{"s":"Plots interest rates vs bond maturity. Inverted = recession signal."}},{"k":"pmi_purchasing_managers","v":{"s":"PMI (Purchasing Managers)"}},{"k":"survey_of_manufacturing_activity_50_ex","v":{"s":"Survey of manufacturing activity. >50 = expanding, <50 = contracting."}},{"k":"gini_coefficient","v":{"s":"Gini Coefficient"}},{"k":"measures_income_inequality_0_perfect_e","v":{"s":"Measures income inequality. 0 = perfect equality, 1 = maximum inequality."}},{"k":"expansion","v":{"s":"Expansion"}},{"k":"peak","v":{"s":"Peak"}},{"k":"trough","v":{"s":"Trough"}},{"k":"classical","v":{"s":"Classical"}},{"k":"keynesian","v":{"s":"Keynesian"}},{"k":"monetarist","v":{"s":"Monetarist"}},{"k":"austrian","v":{"s":"Austrian"}},{"k":"behavioral","v":{"s":"Behavioral"}},{"k":"mmt_modern_monetary","v":{"s":"MMT (Modern Monetary)"}},{"k":"50_30_20_rule","v":{"s":"50/30/20 Rule"}},{"k":"the_most_popular_simple_budgeting_fram","v":{"s":"The most popular simple budgeting framework."}},{"k":"needs","v":{"s":"Needs"}},{"k":"wants","v":{"s":"Wants"}},{"k":"savings","v":{"s":"Savings"}},{"k":"pay_yourself_first","v":{"s":"Pay Yourself First"}},{"k":"save_a_fixed_percentage_before_spendin","v":{"s":"Save a fixed percentage BEFORE spending on anything else."}},{"k":"savings_first","v":{"s":"Savings First"}},{"k":"bills","v":{"s":"Bills"}},{"k":"flexible","v":{"s":"Flexible"}},{"k":"zero_based_budget","v":{"s":"Zero-Based Budget"}},{"k":"every_dollar_gets_assigned_a_job_incom","v":{"s":"Every dollar gets assigned a job. Income minus expenses = exactly zero."}},{"k":"essential","v":{"s":"Essential"}},{"k":"goals","v":{"s":"Goals"}},{"k":"lifestyle","v":{"s":"Lifestyle"}},{"k":"what_should_you_do_first","v":{"s":"What should you do FIRST?"}},{"k":"why_doesn_t_gas_demand_drop_as_much_as","v":{"s":"Why doesn't gas demand drop as much as you'd expect?"}},{"k":"why_does_raising_rates_hurt_stocks","v":{"s":"Why does raising rates hurt stocks?"}},{"k":"which_country_has_comparative_advantag","v":{"s":"Which country has comparative advantage in computers?"}},{"k":"what_is_the_most_likely_long_term_effe","v":{"s":"What is the most likely long-term effect?"}},{"k":"what_is_the_true_cost_of_grad_school","v":{"s":"What is the TRUE cost of grad school?"}},{"k":"what_economic_consequence_followed_in_","v":{"s":"What economic consequence followed in 2021-2022?"}},{"k":"what_will_the_other_station_likely_do","v":{"s":"What will the other station likely do?"}},{"k":"what_type_of_market_failure_is_this","v":{"s":"What type of market failure is this?"}},{"k":"how_much_should_you_contribute_at_mini","v":{"s":"How much should you contribute at minimum?"}},{"k":"supply_demand_2","v":{"s":"Supply & Demand"}},{"k":"price_rises_less_demanded_more_supplie","v":{"s":"Price rises → less demanded, more supplied. Price falls → more demanded, less supplied. Equilibrium: where S meets D."}},{"k":"gdp_formula","v":{"s":"GDP Formula"}},{"k":"gdp_c_i_g_x_m_consumption_investment_g","v":{"s":"GDP = C + I + G + (X-M). Consumption + Investment + Government + Net Exports. Measures total economic output."}},{"k":"inflation_types","v":{"s":"Inflation Types"}},{"k":"demand_pull_too_much_money_chasing_goo","v":{"s":"Demand-pull: too much money chasing goods. Cost-push: rising production costs. Built-in: wage-price spiral expectations."}},{"k":"fed_tools","v":{"s":"Fed Tools"}},{"k":"interest_rates_ffr_open_market_operati","v":{"s":"Interest rates (FFR) • Open market operations (buy/sell bonds) • Reserve requirements • Discount window • Forward guidance"}},{"k":"fiscal_vs_monetary","v":{"s":"Fiscal vs Monetary"}},{"k":"fiscal_congress_tax_spend_monetary_fed","v":{"s":"Fiscal = Congress (tax/spend). Monetary = Fed (interest rates/money supply). Both affect the economy differently."}},{"k":"rule_of_72","v":{"s":"Rule of 72"}},{"k":"divide_72_by_the_interest_rate_to_find","v":{"s":"Divide 72 by the interest rate to find how many years it takes to double your money. 72 ÷ 8% = 9 years to double."}},{"k":"elasticity_rules","v":{"s":"Elasticity Rules"}},{"k":"elastic_1_luxury_has_substitutes_inela","v":{"s":"Elastic (>1): luxury, has substitutes. Inelastic (<1): necessity, no substitutes. Unit elastic (=1): % change in P = % change in Q."}},{"k":"4_market_structures","v":{"s":"4 Market Structures"}},{"k":"perfect_competition_monopolistic_compe","v":{"s":"Perfect Competition → Monopolistic Competition → Oligopoly → Monopoly. More market power = higher prices, less efficiency."}},{"k":"food","v":{"s":"Food"}},{"k":"transport","v":{"s":"Transport"}},{"k":"entertainment","v":{"s":"Entertainment"}},{"k":"savings_2","v":{"s":"Savings"}},{"k":"remaining","v":{"s":"Remaining"}},{"k":"gdp_growth","v":{"s":"GDP Growth"}},{"k":"inflation_2","v":{"s":"Inflation"}},{"k":"interest_rate","v":{"s":"Interest Rate"}},{"k":"unemployment_3","v":{"s":"Unemployment"}},{"k":"trade_balance_2","v":{"s":"Trade Balance"}},{"k":"economics_lab","v":{"s":"💰 Economics Lab"}},{"k":"5_simulators","v":{"s":"5 simulators"}},{"k":"ai_powered_learning","v":{"s":"📚 AI-Powered Learning"}},{"k":"quiz_me","v":{"s":"✍️ Quiz Me"}},{"k":"ask_tutor","v":{"s":"🧑‍🏫 Ask Tutor"}},{"k":"easy","v":{"s":"🌱 Easy"}},{"k":"medium","v":{"s":"⚙️ Medium"}},{"k":"hard","v":{"s":"🔥 Hard"}},{"k":"supply_demand_3","v":{"s":"📉 Supply & Demand"}},{"k":"personal_finance","v":{"s":"🏦 Personal Finance"}},{"k":"stock_market","v":{"s":"📈 Stock Market"}},{"k":"business_sim","v":{"s":"🏪 Business Sim"}},{"k":"national_economy","v":{"s":"🏛️ National Economy"}},{"k":"policy_inquiry","v":{"s":"🔬 Policy Inquiry"}},{"k":"supply_demand_the_price_discovery_engi","v":{"s":"Supply & Demand — the price-discovery engine"}},{"k":"demand_slopes_down_cheap_buy_more_supp","v":{"s":"Demand slopes down (cheap = buy more); supply slopes up (expensive = produce more). Equilibrium price + quantity is where they cross. Adam Smith’s 1776 Wealth of Nations is still the foundation."}},{"k":"personal_finance_budgeting_saving_cred","v":{"s":"Personal Finance — budgeting, saving, credit"}},{"k":"50_30_20_needs_wants_save_compound_int","v":{"s":"50/30/20: needs / wants / save. Compound interest is the eighth wonder; a 30-year head start at 7% turns $1 into $7.61. Pay credit cards in full — 19% APR is mafia rates."}},{"k":"stock_market_ownership_at_fractional_s","v":{"s":"Stock Market — ownership at fractional scale"}},{"k":"buy_a_share_own_a_slice_of_the_company","v":{"s":"Buy a share = own a slice of the company. S&P 500 has averaged ~10% annual returns over 100 years. Diversify (don’t bet on one ticker), hold long (time in market beats timing it)."}},{"k":"business_sim_you_re_the_founder","v":{"s":"Business Sim — you’re the founder"}},{"k":"revenue_costs_profit_break_even_point_","v":{"s":"Revenue − costs = profit. Break-even point is when fixed costs are covered. Most small businesses fail in year 5; the survivors found product-market fit. Customer acquisition cost (CAC) vs lifetime value (LTV) is the founder’s daily math."}},{"k":"national_economy_gdp_inflation_unemplo","v":{"s":"National Economy — GDP, inflation, unemployment"}},{"k":"gdp_measures_total_output_cpi_measures","v":{"s":"GDP measures total output; CPI measures inflation; unemployment U-3 is the headline rate. The Fed sets interest rates to balance growth vs inflation — the dual mandate Congress gave it in 1977."}},{"k":"play_the_simulations_to_discover_econo","v":{"s":"Play the simulations to discover economics concepts! Each event teaches a new concept that gets added here."}},{"k":"economics_quiz","v":{"s":"✍️ Economics Quiz"}},{"k":"explanation","v":{"s":"📚 Explanation: "}},{"k":"next_question","v":{"s":"➡️ Next Question"}},{"k":"ai_economics_tutor","v":{"s":"🧑‍🏫 AI Economics Tutor"}},{"k":"ask_any_economics_question","v":{"s":"Ask any economics question..."}},{"k":"next_scenario","v":{"s":"Next Scenario →"}},{"k":"economic_history_timeline","v":{"s":"📅 Economic History Timeline"}},{"k":"impact","v":{"s":"💥 Impact: "}},{"k":"lesson","v":{"s":"📚 Lesson: "}},{"k":"quick_reference_cards","v":{"s":"📋 Quick Reference Cards"}},{"k":"inflation_calculator","v":{"s":"💲 Inflation Calculator"}},{"k":"see_how_inflation_erodes_purchasing_po","v":{"s":"See how inflation erodes purchasing power over time. A dollar today is worth more than a dollar tomorrow!"}},{"k":"amount","v":{"s":"Amount ($)"}},{"k":"inflation_rate","v":{"s":"Inflation Rate (%)"}},{"k":"inflation_rate_percent","v":{"s":"Inflation rate, percent"}},{"k":"years","v":{"s":"Years"}},{"k":"years_2","v":{"s":"Years"}},{"k":"business_cycle","v":{"s":"🔄 Business Cycle"}},{"k":"the_economy_moves_through_repeating_cy","v":{"s":"The economy moves through repeating cycles of expansion and contraction. Understanding where we are in the cycle helps predict what comes next."}},{"k":"policy_response","v":{"s":"🏛️ Policy Response: "}},{"k":"compound_interest_calculator","v":{"s":"📊 Compound Interest Calculator"}},{"k":"starting_amount_in_dollars","v":{"s":"Starting amount in dollars"}},{"k":"annual_return_percent","v":{"s":"Annual return, percent"}},{"k":"years_3","v":{"s":"Years"}},{"k":"compound_interest_is_the_eighth_wonder","v":{"s":"\"Compound interest is the eighth wonder of the world.\" — Albert Einstein (attributed)"}},{"k":"budget_rules","v":{"s":"💰 Budget Rules"}},{"k":"schools_of_economic_thought","v":{"s":"🏛️ Schools of Economic Thought"}},{"k":"economists_disagree_different_schools_","v":{"s":"Economists disagree! Different schools of thought offer different answers to the same questions. Understanding these perspectives helps you think critically about economic policy."}},{"k":"school","v":{"s":"School"}},{"k":"gov_t_role","v":{"s":"Gov't Role"}},{"k":"on_recession","v":{"s":"On Recession"}},{"k":"on_inflation","v":{"s":"On Inflation"}},{"k":"key_idea","v":{"s":"💡 Key Idea: "}},{"k":"famous","v":{"s":"🎓 Famous: "}},{"k":"example","v":{"s":"💡 Example: "}},{"k":"market_structures","v":{"s":"🏪 Market Structures"}},{"k":"markets_range_from_perfect_competition","v":{"s":"Markets range from perfect competition (many sellers, identical products) to monopoly (one seller, unique product). Click each to learn more:"}},{"k":"more_competition","v":{"s":"← More Competition"}},{"k":"more_market_power","v":{"s":"More Market Power →"}},{"k":"long_run_profit","v":{"s":"Long-run Profit:"}},{"k":"gdp_c_i_g_x_m","v":{"s":"🏛️ GDP = C + I + G + (X−M)"}},{"k":"gross_domestic_product_measures_the_to","v":{"s":"Gross Domestic Product measures the total value of all final goods and services produced within a country's borders in a given year. Here's how it breaks down for the United States:"}},{"k":"famous_economists","v":{"s":"🎓 Famous Economists"}},{"k":"key_work","v":{"s":"📚 Key Work: "}},{"k":"big_idea","v":{"s":"💡 Big Idea: "}},{"k":"macro","v":{"s":"🏛️ MACRO |"}},{"k":"interactive_economics_lab_supply_and_d","v":{"s":"Interactive economics lab supply and demand visualization"}},{"k":"key_concepts","v":{"s":"📚 Key Concepts"}},{"k":"law_of_demand","v":{"s":"Law of Demand: "}},{"k":"as_price_quantity_demanded_consumers_b","v":{"s":"As price ↑, quantity demanded ↓. Consumers buy less when prices rise. The demand curve slopes downward."}},{"k":"law_of_supply","v":{"s":"Law of Supply: "}},{"k":"as_price_quantity_supplied_producers_m","v":{"s":"As price ↑, quantity supplied ↑. Producers make more when prices are high. The supply curve slopes upward."}},{"k":"where_supply_meets_demand_this_e_point","v":{"s":"Where supply meets demand. This \"E\" point sets the market price (P*) and quantity (Q*) automatically."}},{"k":"shifts_vs_movements","v":{"s":"Shifts vs. Movements: "}},{"k":"changing_the_price_moves_along_a_curve","v":{"s":"Changing the price moves ALONG a curve. External factors (technology, income, preferences) SHIFT the entire curve."}},{"k":"what_s_happening_right_now","v":{"s":"💡 What's Happening Right Now:"}},{"k":"demand_shifted_right_more_people_want_","v":{"s":"▶ Demand shifted RIGHT — More people want this product (maybe income rose, or a trend made it popular). This raises both equilibrium price AND quantity."}},{"k":"demand_shifted_left_fewer_people_want_","v":{"s":"▶ Demand shifted LEFT — Fewer people want this product (substitute became cheaper, or preferences changed). Both price AND quantity fall."}},{"k":"supply_shifted_right_producers_can_mak","v":{"s":"▶ Supply shifted RIGHT — Producers can make more cheaply (new technology, lower input costs). Price falls, but quantity rises."}},{"k":"supply_shifted_left_production_became_","v":{"s":"▶ Supply shifted LEFT — Production became harder (natural disaster, regulations). Price rises, but quantity falls."}},{"k":"curve_shifts","v":{"s":"📉 Curve Shifts"}},{"k":"sd_demand_shift","v":{"s":"sd demand shift"}},{"k":"sd_supply_shift","v":{"s":"sd supply shift"}},{"k":"government_controls","v":{"s":"⚖️ Government Controls"}},{"k":"sd_price_floor","v":{"s":"sd price floor"}},{"k":"sd_price_ceiling","v":{"s":"sd price ceiling"}},{"k":"sd_tax","v":{"s":"sd tax"}},{"k":"price_elasticity_of_demand","v":{"s":"📏 Price Elasticity of Demand"}},{"k":"elasticity_2","v":{"s":"Elasticity"}},{"k":"measures_how_much_quantity_demanded_ch","v":{"s":" measures how much quantity demanded changes when price changes. "}},{"k":"elastic","v":{"s":"Elastic"}},{"k":"goods_luxury_items_products_with_subst","v":{"s":" goods (luxury items, products with substitutes) see big demand drops from small price increases. "}},{"k":"inelastic","v":{"s":"Inelastic"}},{"k":"goods_necessities_like_medicine_gasoli","v":{"s":" goods (necessities like medicine, gasoline) have stable demand regardless of price."}},{"k":"elastic_1","v":{"s":"Elastic (>1)"}},{"k":"luxury_goods_restaurants_vacations","v":{"s":"Luxury goods, restaurants, vacations"}},{"k":"unit_elastic_1","v":{"s":"Unit Elastic (=1)"}},{"k":"revenue_unchanged_by_price","v":{"s":"Revenue unchanged by price"}},