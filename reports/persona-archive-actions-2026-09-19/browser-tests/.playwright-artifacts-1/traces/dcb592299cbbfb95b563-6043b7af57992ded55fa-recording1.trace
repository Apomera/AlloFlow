","v":{"s":"5. Name assumptions and uncertainties"}},{"k":"tradeoffs","v":{"s":"6. Weigh tradeoffs and alternatives"}},{"k":"response","v":{"s":"7. Build the deliverable"}},{"k":"testReflection","v":{"s":"8. Test or challenge the draft"}},{"k":"revision","v":{"s":"9. Keep or revise after checking"}},{"k":"transferReflection","v":{"s":"10. Explain the transfer"}}],"id":824}},{"k":"self_check","v":{"o":[{"k":"kind_criterion","v":{"s":"Criterion"}},{"k":"kind_constraint","v":{"s":"Constraint"}},{"k":"heading","v":{"s":"Check your deliverable against the brief"}},{"k":"note","v":{"s":"Rate your own draft against each success criterion and constraint. Point to where it is met, or name what is still missing. Honest \"not yet\" ratings make feedback more useful."}},{"k":"progress","v":{"s":"{rated} of {total} rated"}},{"k":"rating","v":{"s":"My rating"}},{"k":"where","v":{"s":"Where it shows, or what is missing"}},{"k":"where_placeholder","v":{"s":"Quote or point to the part of your draft that shows this."}},{"k":"changed","v":{"s":"This requirement changed. Review your earlier note before rating it again."}}],"id":825}},{"k":"aria","v":{"o":[{"k":"self_check_rating","v":{"s":"{row} rating"}},{"k":"self_check_note","v":{"s":"{row} evidence note"}},{"k":"cycle_source","v":{"s":"Check {n} source"}},{"k":"cycle_choice","v":{"s":"Check {n} AI challenge choice"}},{"k":"cycle_choice_reason","v":{"s":"Check {n} reason for AI challenge choice"}},{"k":"cycle_method","v":{"s":"Check {n} method"}},{"k":"cycle_evidence_form","v":{"s":"Check {n} evidence form"}},{"k":"cycle_test_question","v":{"s":"Check {n} test question"}},{"k":"cycle_criterion","v":{"s":"Check {n} criterion or constraint"}},{"k":"cycle_expected","v":{"s":"Check {n} expected finding"}},{"k":"cycle_threshold","v":{"s":"Check {n} change threshold"}},{"k":"cycle_outcome","v":{"s":"Check {n} outcome"}},{"k":"cycle_observed","v":{"s":"Check {n} observed evidence"}},{"k":"cycle_decision","v":{"s":"Check {n} decision"}},{"k