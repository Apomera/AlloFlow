#
# The accessibility engines are vendored here so Gemini Canvas, whose CSP refuses the
# third-party CDNs, can still load them from the origin it already trusts for every
# module. The doc pipeline also FETCHES axe-core's source text once to inject it inline
# into each audit frame; that fetch is cross-origin from Canvas and needs CORS. Scoped to
# the engine directories only.
/axe-core/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/accessibility-checker-engine/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/pdfjs-dist/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/pdf-lib/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/mammoth/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/jszip/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/dompurify/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
# Lets the device speed check test threads. Applies to this one page only.
/speech_device_test
  Document-Isolation-Policy: isolate-and-credentialless
/speech_device_test.html
  Document-Isolation-Policy: isolate-and-credentialless
# Practice-song library (built by scripts/build-song-packs.cjs in its source project): Gemini Canvas fetches it
# cross-origin. Packs and data files carry their content hash in the name; songs.json must stay revalidated.
/song_library/*
  Access-Control-Allow-Origin: *
/song_library/songs.json
  Cache-Control: no-cache
/song_library/pack-*
  Cache-Control: public, max-age=31536000, immutable
/song_library/lyrics-*
  Cache-Control: public, max-age=31536000, immutable
/song_library/melodies-*
  Cache-Control: public, max-age=31536000, immutable
# Dedicated student/app shell routes cannot be framed cross-origin while root / & /storage_bridge.html keep Canvas compatibility.
/app/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://cdn.sheetjs.com https://apis.google.com https://accounts.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' data: blob: https:; connect-src 'self' data: blob: https://alloflow-cdn.pages.dev https://alloflow.org https://alloflow.dev https://*.workers.dev https://generativelanguage.googleapis.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://*.run.app https://www.google.com https://www.gstatic.com https://accounts.google.com https://apis.google.com https://script.google.com https://script.googleusercontent.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://cdn.sheetjs.com https://huggingface.co https://*.hf.co https://api.openai.com https://api.anthropic.com https://api.duckduckgo.com https://duckduckgo.com https://google.serper.dev https://raw.githubusercontent.com https://*.wikipedia.org https://*.wikimedia.org https://api.crossref.org https://*.ncbi.nlm.nih.gov http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*
/app/
  Cache-Control: no-store
/app/index.html
  Cache-Control: no-store
/app/sw.js
