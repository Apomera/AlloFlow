  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/27812.png",
      "text": "Whakhtigu waa xirmo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=1",
      "sourceDigest": "sha256:5057688f2ff5367bc7ae2900bfcb62074015b5015ce58675193d20d980d33086"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/27813.png",
      "text": "Whakhtigan xaadirka ah, waxaad ka helaysaa baakado badan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=2",
      "sourceDigest": "sha256:42f4660f746be38574b0a5de0f57ceccbcbf189b407edaaefc45d540ff287635"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/27814.png",
      "text": "Xirmo waa maalin. Maalintii waa 86,400 ilbiriqsi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=3",
      "sourceDigest": "sha256:8f4824d66fecb678bc5b4ad6fad7b1c0cf27cf934cfc4a6cd3a59bb645dc0d0d"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/27815.png",
      "text": "Waa inaad Wakhtiga furtaa oo si fiican u isticmaashaa. Baro wax yaalo cusub.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=4",
      "sourceDigest": "sha256:064f1f7d0be9eb3d6e97951e7e6e2d27ad4cf83b33d6c738692864285a16ea45"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/27816.png",
      "text": "Cun. Ciyaar. Naso. Riyo. Fakar",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=5",
      "sourceDigest": "sha256:815bbe3afb2b3b9a652dd0062d9c9ef2a3949c4307333e7e9ea1ccf2b882749d"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/27817.png",
      "text": "Abuur geed, kayn baa soo baxaysa. Xalli dhib.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=6",
      "sourceDigest": "sha256:ffff598ad1fb64242c80565d9b0759d699847fe2f367c8dfc88e1d286dd39605"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/27818.png",
      "text": "Marka lacagtaadu korodho, qaar kaydso, qaar kharash bixi, qaarna la wadaag.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=7",
      "sourceDigest": "sha256:ad783528587f98fba6cd9aee74fd585a79c136965779ff932b927e16eb5fa912"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/27819.png",
      "text": "Haddii aad fashilanto, mar kale dib u bilow. Wakhtigu maalmaha buu hadiyad ka dhiga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=8",
      "sourceDigest": "sha256:00d493c4d03270843944a71f74a6b7b435d7490b86dcb55b31dd469987f1c736"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/27820.png",
      "text": "Isniin iyo Talaado. Arbaco iyo Khamiis. Jimco iyo Sabti, xitaa Axad.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=9",
      "sourceDigest": "sha256:bc433dede9c7b30c9b4303ade0cffbe0269cb89ea88451c0688a56f549e3151f"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/27821.png",
      "text": "Kuwani waa saaxiibo gaar ah. Ku raaxayso saaxiibtinimadooda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=10",
      "sourceDigest": "sha256:13733cd9212791f130a0f0791ce3afcee161ae77bb5aed6d55ed8dcd238e9eb4"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/27822.png",
      "text": "Marka ay saacaddu tiraahdo tick tock xasuuso erayadayda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=11",
      "sourceDigest": "sha256:b5fb2f17a93e7e07e8b5f6d8196f92764b5fe58d128dd6efa3dc70e35e75b266"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/27823.png",
      "text": "Wakhtigu waa xirmo yaab leh, hadiyad gaar ah. Si fiican u isticmaal.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52482#page=12",
      "sourceDigest": "sha256:cbcbb19474c5f50508b55bec9a1daa7259e6dc28015d046d44d6f652a050ec48"
    }
  ],
