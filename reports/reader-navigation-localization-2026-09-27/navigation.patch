+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { translator } from './helpers/reader_locale_harness.js';
+const require = createRequire(import.meta.url);
+const { validatePayload, lookup, placeholders, run, parseArgs } = require('../dev-tools/i18n/apply_reader_contract_locales.cjs');
+const payload = JSON.parse(readFileSync('translations/reader-navigation-locales.json', 'utf8'));
+const english = JSON.parse(readFileSync('ui_strings.js', 'utf8'));
+describe('frozen navigation and prepared-help locale contract', () => {
+  it('guards 29 keys and checks its own batch without assuming a combined batch size', () => {
+    expect(validatePayload(payload, english, 29)).toHaveLength(29);
+    expect(run(false, 'navigation')).toMatchObject({ keys: 29, locales: 5, changedFiles: 0 });
+    expect(parseArgs(['--check', '--batch=navigation'])).toEqual({ apply: false, batch: 'navigation' });
+  });
+  it('registers the exact existing unmarked-help source fallback in English and its public mirror', () => {
+    const key = 'simplified.define_hint_prepared_no_marks', text = payload.english[key];
+    expect(readFileSync('view_simplified_source.jsx', 'utf8')).toContain("viewText('" + key + "', '" + text + "')");
+    expect(lookup(JSON.parse(readFileSync('desktop/web-app/public/ui_strings.js', 'utf8')), key)).toBe(text);
+  });
+  it('rejects source-copy drift, leaked keys and renamed placeholders', () => {
+    const changed = structuredClone(english); changed.simplified.word_arrows_hint = 'Only Left goes forward.';
+    expect(() => validatePayload(payload, changed, 29)).toThrow(/English copy changed/);
+    const invalid = structuredClone(payload); invalid.locales.thai['simplified.skip_passage'] = 'simplified.skip_passage';
+    expect(() => validatePayload(invalid, english, 29)).toThrow(/Missing translation/);
+    invalid.locales.thai['simplified.skip_passage'] = payload.locales.thai['simplified.skip_passage']; invalid.locales.thai['simplified.word_help_summary_count'] = '{total} รายการ';
+    expect(() => validatePayload(invalid, english, 29)).toThrow(/Placeholder mismatch/);
+  });
+  for (const [locale, values] of Object.entries(payload.locales)) it(locale + ': preserves placeholders, literal learner words and both mirrors', () => {
+    for (const prefix of ['lang', 'desktop/web-app/public/lang']) {
+      const pack = JSON.parse(readFileSync(prefix + '/' + locale + '.js', 'utf8'));
+      for (const [key, value] of Object.entries(values)) { expect(lookup(pack, key)).toBe(value); expect(placeholders(value)).toEqual(placeholders(payload.english[key])); }
