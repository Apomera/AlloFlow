  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/7966.png",
      "text": "Hamisi akeneye umwambaro mushasha w'ishure. Se wiwe amujana mw'isoko.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=1",
      "sourceDigest": "sha256:caca78991160b54778860c6e362c30f657e9d89217939272ec5a9859723b807e"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/7967.png",
      "text": "Hamisi abona umuhungu yambaye ishati ryiza. Aca yibwira ati, \"Rirya shati ni nziza cane.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=2",
      "sourceDigest": "sha256:6be5eeb347ebca828f4e92ade4c84dc283c55fbe2fde0285e8b290e903d320b2"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/7968.png",
      "text": "Hamisi avuga ati, \"Papa, naripfuje kuronka ishati nkirya urya muhungu yambaye.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=3",
      "sourceDigest": "sha256:2256fe370e0021b8ad9b2417aad64d51c08c1da2d101e17762cb0e37c3b15ed9"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/7969.png",
      "text": "Hamisi abwira se wiwe ati, \"Raba, hariya hari amashati meza. Papa, ndagusavye ungurire imwe.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=4",
      "sourceDigest": "sha256:47ebdc0db77b27e6c46c4c7203bbf9f543047256d37234f508e4c372bc693952"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/7972.png",
      "text": "Se aramwishura ati, \"Hamisi, ntegerezwa kugura umwambaro w' ishure wawe.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=5",
      "sourceDigest": "sha256:03985f1c62c3af153fb70cd571f1a4bbbe5e4678ce8f3e7d681b8918431634de"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/7973.png",
      "text": "Se arongera ati, \"Simfise amahera akwiye kuri irya shati.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=6",
      "sourceDigest": "sha256:c1f1ae340fafa1dd37fe89931d319af182917804c0fab938443ac7db03c6ca4c"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/7975.png",
      "text": "Se wiwe agura wa mwambaro w' ishure. Ariko yatangajwe n' amahera bamusubije. Yasanze harimwo amahera akwiye yo kugura ishati ya Hamisi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=7",
      "sourceDigest": "sha256:371d3456dbef3494104f8a3d024d3d520461cc668ba4432abbeca0ff59473f43"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/7976.png",
      "text": "Wabaye umunsi mwiza kuri Hamisi! None aza gucagura ishati iyihe?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47391#page=8",
      "sourceDigest": "sha256:85e3572521d3b5c8b53b529ad592954f2da6070c5b1f3b93c0e8e675d7452d51"
    }
  ],
