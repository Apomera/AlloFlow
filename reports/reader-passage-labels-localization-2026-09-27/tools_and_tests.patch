+    await click(pinBox(h)); expect(h.onUpdate).toHaveBeenCalledTimes(1);
+    await act(async () => { confirm(); await pending; }); expect(pinBox(h).disabled).toBe(false); expect(pinBox(h).checked).toBe(true);
+    expect(h.host.querySelector('[data-gloss-notice]').textContent).toBe(copy(f, 'gloss_pinned_notice'));
