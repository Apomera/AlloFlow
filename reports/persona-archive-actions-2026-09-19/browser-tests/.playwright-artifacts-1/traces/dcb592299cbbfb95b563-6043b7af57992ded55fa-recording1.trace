scription_an","v":{"s":"Debug a FORTRAN-style transcription and order its card deck."}},{"k":"audit_the_line_printer_format_card_and","v":{"s":"Audit the line-printer format card and inspect its fixed-width preview before releasing the deck."}},{"k":"run_the_batch_job_transcribe_its_print","v":{"s":"Run the batch job, transcribe its printed range and status, then verify it without relying on the printout."}},{"k":"choose_the_verification_workflow","v":{"s":"Choose the verification workflow"}},{"k":"paired_cross_check_separate_calculator","v":{"s":" Paired cross-check — separate calculator and verifier desk codes"}},{"k":"solo_dual_pass_audit_recompute_after_a","v":{"s":" Solo dual-pass audit — recompute after a deliberate reset"}},{"k":"desk_codes_represent_roles_not_student","v":{"s":"Desk codes represent roles, not student names. The lab stores no personal identifiers."}},{"k":"station_02_desktop_calculation","v":{"s":"Station 02 / desktop calculation"}},{"k":"build_a_result_the_electronic_computer","v":{"s":"Build a result the electronic computer can be checked against."}},{"k":"keep_units_beside_every_value_use_at_l","v":{"s":"Keep units beside every value. Use at least two decimal places until the final step."}},{"k":"formula_reference","v":{"s":"Formula reference"}},{"k":"theta_radians_theta_degrees_x_pi_180","v":{"s":"theta radians = theta degrees x pi / 180\n"}},{"k":"vx_v_x_cos_theta_vy_v_x_sin_theta","v":{"s":"Vx = V x cos(theta)        Vy = V x sin(theta)\n"}},{"k":"t_vy_sqrt_vy_2_2gy0_g","v":{"s":"t = [Vy + sqrt(Vy^2 + 2gY0)] / g\n"}},{"k":"r_vx_x_t","v":{"s":"R = Vx x t"}},{"k":"check_worksheet","v":{"s":"Check worksheet"}},{"k":"station_03_transcription_desk","v":{"s":"Station 03 / transcription desk"}},{"k":"debug_the_fortran_style_program","v":{"s":"Debug the FORTRAN-style program."}},{"k":"open_checked_calculation_ledger","v":{"s":"Open checked calculation ledger"}},{"k":"program_listing","v":{"s":"Program listing"}},{"k":"this_safe_learning_compile