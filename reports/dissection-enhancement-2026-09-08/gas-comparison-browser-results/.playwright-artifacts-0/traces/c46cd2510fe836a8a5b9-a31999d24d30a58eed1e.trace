e__timeline > span { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.28rem 0.45rem; border: 1px solid rgb(185, 216, 210); border-radius: 999px; background: rgb(255, 255, 255); color: rgb(60, 98, 95); font-size: 0.62rem; font-weight: 800; }\n.diss-procedure__timeline > span[data-tone=\"success\"] { border-color: rgb(110, 231, 183); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-procedure__timeline > span[data-tone=\"caution\"] { border-color: rgb(251, 191, 36); background: rgb(255, 251, 235); color: rgb(146, 64, 14); }\n.diss-procedure__timeline > button { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.28rem 0.45rem; border: 1px solid rgb(185, 216, 210); border-radius: 999px; background: rgb(255, 255, 255); color: rgb(60, 98, 95); font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 0.62rem; font-weight: 800; text-align: left; cursor: pointer; transition: border-color 0.16s, background 0.16s, box-shadow 0.16s, transform 0.16s; }\n.diss-procedure__timeline > button:hover { transform: translateY(-1px); border-color: rgb(15, 118, 110); }\n.diss-procedure__timeline > button[data-tone=\"success\"] { border-color: rgb(110, 231, 183); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-procedure__timeline > button[data-tone=\"caution\"] { border-color: rgb(251, 191, 36); background: rgb(255, 251, 235); color: rgb(146, 64, 14); }\n.diss-procedure__timeline > button[data-selected=\"true\"] { border-color: rgb(15, 118, 110); background: rgb(204, 251, 241); color: rgb(19, 78, 74); box-shadow: rgba(15, 118, 110, 0.16) 0px 0px 0px 2px; }\n.diss-procedure__timeline > button:focus-visible { outline: rgba(14, 116, 144, 0.48) solid 3px; outline-offset: 2px; }\n.diss-procedure__timeline-index { color: currentcolor; font-variant-numeric: tabular-nums; }\n.diss-procedure__timeline-label { font-weight: 900; letter-spacing: 0.02em; text-transform: uppercase; }\n.diss-procedure__timeline-outcome { color: currentcolor; font-size: 0.56rem; font-weight: 850; opacity: 0.86; }\n.diss-advanced-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.4rem; margin-top: 0.6rem; }\n.diss-advanced-card { min-width: 0px; padding: 0.55rem 0.6rem; border: 1px solid rgb(185, 216, 210); border-radius: 0.65rem; background: rgba(255, 255, 255, 0.88); color: rgb(49, 91, 88); }\n.diss-advanced-card strong { display: block; color: rgb(19, 78, 74); font-size: 0.7rem; }\n.diss-tissue-monitor[data-tone=\"stable\"] { border-color: rgb(94, 234, 212); background: linear-gradient(145deg, rgb(240, 253, 250), rgb(255, 255, 255)); }\n.diss-tissue-monitor[data-tone=\"caution\"] { border-color: rgb(251, 191, 36); background: linear-gradient(145deg, rgb(255, 251, 235), rgb(255, 255, 255)); }\n.diss-tissue-monitor[data-tone=\"danger\"] { border-color: rgb(251, 113, 133); background: linear-gradient(145deg, rgb(255, 241, 242), rgb(255, 255, 255)); }\n.diss-tissue-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 0.35rem; margin-top: 0.45rem; }\n.diss-tissue-meter { min-width: 0px; }\n.diss-tissue-meter span { display: flex; justify-content: space-between; gap: 0.25rem; color: rgb(82, 100, 125); font-size: 0.56rem; font-weight: 800; }\n.diss-tissue-meter progress { display: block; width: 100%; height: 0.42rem; margin-top: 0.18rem; accent-color: rgb(15, 143, 134); }\n.diss-tissue-meter[data-risk=\"true\"] progress { accent-color: rgb(225, 29, 72); }\n.diss-tissue-consequence { margin: 0.45rem 0px 0px; padding: 0.4rem 0.48rem; border-left: 3px solid rgb(15, 143, 134); border-radius: 0.35rem; background: rgba(255, 255, 255, 0.76); color: rgb(54, 80, 111); font-size: 0.61rem; line-height: 1.4; }\n.diss-advanced-card p