}},{"k":"sums_of_1","v":{"s":"Sums of 1"}},{"k":"halves","v":{"s":"Halves"}},{"k":"doubling","v":{"s":"Doubling"}},{"k":"multiplying_by_1_2","v":{"s":"Multiplying by 1/2"}},{"k":"comparing_to_1_2","v":{"s":"Comparing to 1/2"}},{"k":"math_talks_for_fractions","v":{"s":"🗣 Math Talks for fractions"}},{"k":"number_talk_strings_parrish_2010_numbe","v":{"s":"Number-talk strings (Parrish, 2010 — \"Number Talks\") for fraction reasoning. 5 prompts in a sequence with a common pattern. "}},{"k":"15_minute_teacher_led_discussion_focus","v":{"s":"15-minute teacher-led discussion focused on mental math and student explanation."}},{"k":"prompt_string_do_in_order","v":{"s":"📋 Prompt string (do in order):"}},{"k":"focus","v":{"s":"🎯 Focus:"}},{"k":"teaching_notes","v":{"s":"👩‍🏫 Teaching notes"}},{"k":"vocabulary_quiz","v":{"s":"Vocabulary Quiz"}},{"k":"see_a_definition_pick_the_term_master_","v":{"s":"See a definition; pick the term. Master fraction vocabulary."}},{"k":"start_quiz","v":{"s":"📖 Start quiz"}},{"k":"restart_8","v":{"s":"↺ Restart"}},{"k":"which_term_matches_this_definition","v":{"s":"Which term matches this definition?"}},{"k":"reference_card_maker","v":{"s":"🖨 Reference card maker"}},{"k":"generate_a_printable_reference_card_wi","v":{"s":"Generate a printable reference card with fractions, decimals, and percents. Tape it to a binder or desk for quick lookup."}},{"k":"fraction_reference_card","v":{"s":"Fraction Reference Card"}},{"k":"fraction_5","v":{"s":"Fraction"}},{"k":"decimal_4","v":{"s":"Decimal"}},{"k":"percent_5","v":{"s":"Percent"}},{"k":"print_this_card","v":{"s":"🖨 Print this card"}},{"k":"paper_folding_fractions","v":{"s":"Paper folding fractions"}},{"k":"pattern_block_fractions","v":{"s":"Pattern block fractions"}},{"k":"fraction_strip_kit","v":{"s":"Fraction strip kit"}},{"k":"cooking_lab_playdough_recipe","v":{"s":"Cooking lab — playdough recipe"}},{"k":"pizza_day_cardboard","v":{"s":"Pizza Day (cardboard)"}},{"k":"number_line_walk_kinesthetic","v":{"s":"Number line walk (kinesthetic)"}},{"k":"fraction_war_card_game","v":{"s":"Fraction war card game"}},{"k":"real_cookie_sharing","v":{"s":"Real cookie sharing"}},{"k":"hands_on_activities_library","v":{"s":"✂️ Hands-on activities library"}},{"k":"physical_off_screen_activities_to_teac","v":{"s":"Physical, off-screen activities to teach fractions concretely. Print-friendly. Each activity has materials, steps, an extension, and CCSS alignment."}},{"k":"materials","v":{"s":"📦 Materials"}},{"k":"steps","v":{"s":"📋 Steps"}},{"k":"extension","v":{"s":"🚀 Extension"}},{"k":"scope_sequence_k_8_fraction_trajectory","v":{"s":"📅 Scope & sequence — K-8 fraction trajectory"}},{"k":"suggested_month_by_month_pacing_for_fr","v":{"s":"Suggested month-by-month pacing for fraction instruction at each grade level. Use this to map AlloFlow tools to your curriculum calendar."}},{"k":"mastery_2","v":{"s":"Mastery"}},{"k":"proficient","v":{"s":"Proficient"}},{"k":"developing","v":{"s":"Developing"}},{"k":"beginning","v":{"s":"Beginning"}},{"k":"assessment_rubric_4_levels","v":{"s":"📊 Assessment rubric — 4 levels"}},{"k":"a_4_point_holistic_rubric_for_evaluati","v":{"s":"A 4-point holistic rubric for evaluating student work on fraction problems. Each level has criteria and an example response. Useful for portfolio assessment and conferencing."}},{"k":"morning_setup","v":{"s":"Morning Setup"}},{"k":"how_much_flour_do_you_need_in_total","v":{"s":"How much flour do you need in total?"}},{"k":"5_1_2_3_11_2_3","v":{"s":"5 1/2 × 3 = 11/2 × 3."}},{"k":"the_first_customer","v":{"s":"The First Customer"}},{"k":"how_much_should_the_customer_pay","v":{"s":"How much should the customer pay?"}},{"k":"3_4_8","v":{"s":"3/4 × $8."}},{"k":"sharing_profits","v":{"s":"Sharing Profits"}},{"k":"how_much_of_a_cup_do_you_each_get","v":{"s":"How much of a cup do you each get?"}},{"k":"1_1_2_4_3_2_4_3_2_1_4","v":{"s":"1 1/2 ÷ 4 = 3/2 ÷ 4 = 3/2 × 1/4."}},{"k":"the_big_order","v":{"s":"The Big Order"}},{"k":"how_many_sticks_of_butter_do_you_need","v":{"s":"How many sticks of butter do you need?"}},{"k":"4_1_2_3_4_9_2_3_4","v":{"s":"4 1/2 × 3/4 = 9/2 × 3/4."}},{"k":"end_of_day_inventory","v":{"s":"End-of-Day Inventory"}},{"k":"do_you_have_enough_sugar_for_tomorrow_","v":{"s":"Do you have enough sugar for tomorrow? If so, how much will be left after baking?"}},{"k":"7_8_1_2_7_8_4_8","v":{"s":"7/8 − 1/2 = 7/8 − 4/8."}},{"k":"story_mode_the_bakery","v":{"s":"📖 Story Mode: The Bakery"}},{"k":"a_5_chapter_story_where_each_chapter_i","v":{"s":"A 5-chapter story where each chapter is a fraction problem in context. Work through the bakery day to apply your skills."}},{"k":"your_answer_e_g_3_4_or_1_1_2_or_8","v":{"s":"Your answer (e.g., 3/4 or 1 1/2 or 8)"}},{"k":"story_answer","v":{"s":"Story answer"}},{"k":"submit_2","v":{"s":"Submit"}},{"k":"exam_prep_practice_tests","v":{"s":"📝 Exam prep — practice tests"}},{"k":"multiple_choice_quizzes_that_mirror_st","v":{"s":"Multiple-choice quizzes that mirror standardized test format. Pick a grade level, take a 10-question test, see your score."}},{"k":"10_question_practice_test","v":{"s":"10-question practice test"}},{"k":"submit_test","v":{"s":"✓ Submit test"}},{"k":"daily_practice","v":{"s":"📅 Daily practice"}},{"k":"a_short_daily_ritual_5_problems_per_da","v":{"s":"A short daily ritual: 5 problems per day. Build a streak. Practice schedules beat practice intensity for retention."}},{"k":"practice_streak","v":{"s":"Practice streak"}},{"k":"mark_today_complete","v":{"s":"✓ Mark today complete"}},{"k":"today_done_come_back_tomorrow","v":{"s":"✓ Today done! Come back tomorrow."}},{"k":"last_14_days","v":{"s":"Last 14 days:"}},{"k":"the_1_2_trick","v":{"s":"The 1/2 trick"}},{"k":"let_your_number_be_n_the_sequence_n_1_","v":{"s":"Let your number be n. The sequence: (n+1) × 2 + 4 − 6 = 2n + 2 + 4 − 6 = 2n. Divide by 2 → n. Subtract original → 0. Wait — that gives 0, not 1. Try: n → (n+1)×2 = 2n+2 → +4 = 2n+6 → −6 = 2n → ÷2 = n → −original = 0. The \"trick\" relies on hidden constants in the sequence."}},{"k":"sum_of_unit_fractions","v":{"s":"Sum of unit fractions"}},{"k":"each_term_is_half_the_previous_the_tot","v":{"s":"Each term is half the previous. The total approaches 1 but never quite reaches it. This is an infinite geometric series with first term 1/2 and ratio 1/2: S = (1/2) / (1 − 1/2) = 1. This is why Zeno's paradox of motion is solvable mathematically."}},{"k":"the_harmonic_series","v":{"s":"The harmonic series"}},{"k":"even_though_each_term_is_small_the_ser","v":{"s":"Even though each term is small, the series diverges. To pass 100, you need about 1.5 × 10^43 terms. This was proven by Nicole Oresme in the 1300s using grouping: 1/3 + 1/4 > 1/4 + 1/4 = 1/2; 1/5+...+1/8 > 4 × 1/8 = 1/2; you can always find another 1/2 to add."}},{"k":"farey_sequences","v":{"s":"Farey sequences"}},{"k":"check_1_4_and_1_3_4_1_1_3_1_check_2_5_","v":{"s":"Check 1/4 and 1/3: (4)(1) − (1)(3) = 1. Check 2/5 and 1/2: (5)(1) − (2)(2) = 1. This property generates the Stern-Brocot tree of all rational numbers."}},{"k":"multiplying_telescopes","v":{"s":"Multiplying telescopes"}},{"k":"rewrite_1_2_2_3_3_4_n_1_n_the_2_in_2_3","v":{"s":"Rewrite: 1/2 × 2/3 × 3/4 × ... × (n−1)/n. The 2 in 2/3 cancels the 2 in 1/2's denominator. The 3 in 3/4 cancels the 3 in 2/3's denominator. Everything cancels except 1/n."}},{"k":"fraction_magic_tricks","v":{"s":"🎩 Fraction magic tricks"}},{"k":"mathematical_tricks_that_are_really_el","v":{"s":"Mathematical \"tricks\" that are really elegant fraction identities. Pick one to see the setup, the reveal, and the mathematical explanation."}},{"k":"setup","v":{"s":"🎬 Setup"}},{"k":"reveal","v":{"s":"✨ Reveal"}},{"k":"why_does_this_work","v":{"s":"🧠 Why does this work?"}},{"k":"ruler_inches","v":{"s":"Ruler (inches)"}},{"k":"a_standard_inch_ruler_is_divided_into_","v":{"s":"A standard inch ruler is divided into 16ths. Major lines: inch. Half mark: 1/2 inch. Quarter mark: 1/4 inch. Each smallest segment: 1/16 inch."}},{"k":"1_1_16_or_1_0625","v":{"s":"1 1/16 (or 1.0625)"}},{"k":"inch_rulers_use_binary_fractions_halve","v":{"s":"Inch rulers use binary fractions: halves, quarters, eighths, sixteenths."}},{"k":"tape_measure_carpentry","v":{"s":"Tape measure (carpentry)"}},{"k":"a_12_foot_tape_measure_has_marks_every","v":{"s":"A 12-foot tape measure has marks every 1/16 inch. Common usage: read to the nearest 1/8 or 1/16. The black diamonds every 19 3/16 inches mark engineered joist spacing."}},{"k":"5_19_3_16_95_15_16_inches_8_feet","v":{"s":"5 × 19 3/16 = 95 15/16 inches ≈ 8 feet"}},{"k":"each_16_inches_has_a_black_diamond_for","v":{"s":"Each 16 inches has a black diamond for typical stud spacing."}},{"k":"measuring_cups","v":{"s":"Measuring cups"}},{"k":"a_standard_set_includes_1_cup_1_2_1_3_","v":{"s":"A standard set includes 1 cup, 1/2, 1/3, 1/4. Some sets add 2/3 and 3/4. Glass measuring cups have markings for 1/4, 1/3, 1/2, 2/3, 3/4 cup and 1 cup."}},{"k":"1_4_1_2_3_4_use_both_or_three_1_4_cup_","v":{"s":"1/4 + 1/2 = 3/4 (use both, OR three 1/4 cup scoops)"}},{"k":"you_can_combine_smaller_measures_to_ma","v":{"s":"You can combine smaller measures to make any common fraction."}},{"k":"thermometer","v":{"s":"Thermometer"}},{"k":"a_medical_thermometer_shows_tenths_of_","v":{"s":"A medical thermometer shows tenths of a degree. 98.6°F = 98 + 6/10 = 98.6. A glass thermometer often shows half-degrees."}},{"k":"98_5_f_or_98_1_2","v":{"s":"98.5°F (or 98 1/2)"}},{"k":"each_minor_tick_is_usually_1_10_of_a_d","v":{"s":"Each minor tick is usually 1/10 of a degree."}},{"k":"gas_gauge","v":{"s":"Gas gauge"}},{"k":"most_fuel_gauges_show_divisions_at_e_e","v":{"s":"Most fuel gauges show divisions at E (empty), 1/4, 1/2, 3/4, F (full). Modern digital gauges may show 1/8 increments or exact percentages."}},{"k":"average_of_1_4_and_1_2_is_1_4_1_2_2_1_","v":{"s":"Average of 1/4 and 1/2 is (1/4 + 1/2) / 2 = (1 + 2)/8 = 3/8."}},{"k":"pizza_slicing","v":{"s":"Pizza slicing"}},{"k":"a_standard_large_pizza_is_sliced_into_","v":{"s":"A standard large pizza is sliced into 8 (sometimes 6 or 10). Each slice is 1/8 (or 1/6, 1/10) of the whole."}},{"k":"6_8_3_4","v":{"s":"6/8 = 3/4"}},{"k":"total_eaten_3_2_6_slices_6_8_simplifie","v":{"s":"Total eaten: 3 × 2 = 6 slices. 6/8 simplifies to 3/4."}},{"k":"clock_face","v":{"s":"Clock face"}},{"k":"a_clock_is_a_12_hour_cycle_each_hour_i","v":{"s":"A clock is a 12-hour cycle. Each hour is 1/12 of the cycle. 30 minutes = 1/2 hour. 15 minutes = 1/4 hour."}},{"k":"20_60_1_3","v":{"s":"20/60 = 1/3"}},{"k":"there_are_60_minutes_in_an_hour_so_the","v":{"s":"There are 60 minutes in an hour, so the denominator is 60."}},{"k":"sports_statistics","v":{"s":"Sports statistics"}},{"k":"a_baseball_batting_average_like_333_me","v":{"s":"A baseball batting average like .333 means the batter gets a hit 1/3 of the time. Free-throw percentage of .800 means 4 out of every 5 attempts go in."}},{"k":"7_20_0_35_350","v":{"s":"7/20 = 0.35 (.350)"}},{"k":"hits_over_at_bats_then_write_as_a_3_de","v":{"s":"Hits over at-bats, then write as a 3-decimal-place average."}},{"k":"real_world_fraction_tools","v":{"s":"🛠 Real-world fraction tools"}},{"k":"where_you_actually_encounter_fractions","v":{"s":"Where you actually encounter fractions in daily life. Browse tools, read them, and practice with realistic prompts."}},{"k":"try_this","v":{"s":"🤔 Try this"}},{"k":"reveal_answer","v":{"s":"Reveal answer"}},{"k":"fluency_identify_fractions","v":{"s":"Fluency: identify fractions"}},{"k":"fluency_simplify_fractions","v":{"s":"Fluency: simplify fractions"}},{"k":"fluency_find_equivalent","v":{"s":"Fluency: find equivalent"}},{"k":"fluency_add_like_denominators","v":{"s":"Fluency: add like denominators"}},{"k":"fluency_add_unlike_denominators","v":{"s":"Fluency: add unlike denominators"}},{"k":"rti_cbm_probe_generator","v":{"s":"📊 RTI/CBM probe generator"}},{"k":"generate_curriculum_based_measurement_","v":{"s":"Generate curriculum-based measurement probes for tracking student progress over time. Print, time, score, and graph the results to monitor RTI Tier 2 or Tier 3 students."}},{"k":"probe_type","v":{"s":"Probe type"}},{"k":"probe_type_2","v":{"s":"Probe type"}},{"k":"number_of_items","v":{"s":"Number of items"}},{"k":"probe_count","v":{"s":"Probe count"}},{"k":"print_probe","v":{"s":"🖨 Print probe"}},{"k":"show_answer_key","v":{"s":"Show answer key"}},{"k":"apprentice","v":{"s":"Apprentice"}},{"k":"just_starting_out_welcome","v":{"s":"Just starting out. Welcome!"}},{"k":"slicer","v":{"s":"Slicer"}},{"k":"solved_5_problems_building_confidence","v":{"s":"Solved 5+ problems. Building confidence."}},{"k":"mathematician","v":{"s":"Mathematician"}},{"k":"comfortable_with_multiple_operations","v":{"s":"Comfortable with multiple operations."}},{"k":"strategist","v":{"s":"Strategist"}},{"k":"uses_multiple_comparison_methods","v":{"s":"Uses multiple comparison methods."}},{"k":"expert","v":{"s":"Expert"}},{"k":"fluent_across_all_fraction_operations","v":{"s":"Fluent across all fraction operations."}},{"k":"master","v":{"s":"Master"}},{"k":"tackles_multi_step_problems_with_ease","v":{"s":"Tackles multi-step problems with ease."}},{"k":"grandmaster","v":{"s":"Grandmaster"}},{"k":"number_sense_speed_accuracy","v":{"s":"Number sense + speed + accuracy."}},{"k":"fraction_sage","v":{"s":"Fraction Sage"}},{"k":"top_tier_fluency_teaches_others","v":{"s":"Top-tier fluency. Teaches others."}},{"k":"achievement_levels","v":{"s":"🏆 Achievement levels"}},{"k":"earn_xp_from_correct_answers_and_badge","v":{"s":"Earn XP from correct answers and badges to level up. Each level unlocks a new title."}},{"k":"all_levels","v":{"s":"All levels:"}},{"k":"adding_fractions_with_unlike_denominat","v":{"s":"Adding fractions with unlike denominators"}},{"k":"find_the_lcm_of_the_denominators","v":{"s":"Find the LCM of the denominators."}},{"k":"lcm_3_4_12_both_3_and_4_divide_12","v":{"s":"LCM(3, 4) = 12. Both 3 and 4 divide 12."}},{"k":"convert_each_fraction_to_twelfths","v":{"s":"Convert each fraction to twelfths."}},{"k":"2_3_2_4_3_4_8_12_1_4_1_3_4_3_3_12","v":{"s":"2/3 = (2×4)/(3×4) = 8/12. 1/4 = (1×3)/(4×3) = 3/12."}},{"k":"add_the_numerators_keep_the_denominato","v":{"s":"Add the numerators. Keep the denominator."}},{"k":"8_12_3_12_11_12","v":{"s":"8/12 + 3/12 = 11/12."}},{"k":"simplify_if_possible","v":{"s":"Simplify if possible."}},{"k":"gcd_11_12_1_already_in_simplest_form","v":{"s":"GCD(11, 12) = 1. Already in simplest form."}},{"k":"check_by_estimating","v":{"s":"Check by estimating."}},{"k":"2_3_0_67_1_4_0_25_sum_0_92_11_12_0_917","v":{"s":"2/3 ≈ 0.67, 1/4 = 0.25, sum ≈ 0.92. 11/12 ≈ 0.917. ✓"}},{"k":"subtracting_mixed_numbers_with_regroup","v":{"s":"Subtracting mixed numbers with regrouping"}},{"k":"convert_both_to_improper_fractions","v":{"s":"Convert both to improper fractions."}},{"k":"5_1_4_5_4_1_4_21_4_2_3_4_2_4_3_4_11_4","v":{"s":"5 1/4 = (5×4+1)/4 = 21/4. 2 3/4 = (2×4+3)/4 = 11/4."}},{"k":"same_denominator_subtract_numerators","v":{"s":"Same denominator — subtract numerators."}},{"k":"21_4_11_4_10_4","v":{"s":"21/4 − 11/4 = 10/4."}},{"k":"10_4_5_2","v":{"s":"10/4 = 5/2."}},{"k":"convert_back_to_mixed","v":{"s":"Convert back to mixed."}},{"k":"5_2_2_1_2","v":{"s":"5/2 = 2 1/2."}},{"k":"2_1_2","v":{"s":"2 1/2"}},{"k":"multiplying_two_fractions","v":{"s":"Multiplying two fractions"}},{"k":"multiply_numerators","v":{"s":"Multiply numerators."}},{"k":"2_3_6","v":{"s":"2 × 3 = 6."}},{"k":"multiply_denominators","v":{"s":"Multiply denominators."}},{"k":"3_4_12","v":{"s":"3 × 4 = 12."}},{"k":"write_the_product","v":{"s":"Write the product."}},{"k":"simplify_by_dividing_both_by_gcd","v":{"s":"Simplify by dividing both by GCD."}},{"k":"gcd_6_12_6_6_12_1_2","v":{"s":"GCD(6, 12) = 6. 6/12 = 1/2."}},{"k":"verify_with_area_model","v":{"s":"Verify with area model."}},{"k":"a_3_4_grid_with_2_rows_shaded_and_3_co","v":{"s":"A 3×4 grid with 2 rows shaded and 3 columns shaded = 6 cells out of 12 = 1/2."}},{"k":"dividing_a_fraction_by_a_fraction","v":{"s":"Dividing a fraction by a fraction"}},{"k":"use_keep_change_flip","v":{"s":"Use Keep-Change-Flip."}},{"k":"keep_3_4_change_to_flip_1_2_to_2_1","v":{"s":"Keep 3/4. Change ÷ to ×. Flip 1/2 to 2/1."}},{"k":"3_4_2_1_6_4","v":{"s":"3/4 × 2/1 = 6/4."}},{"k":"6_4_3_2","v":{"s":"6/4 = 3/2."}},{"k":"convert_to_mixed","v":{"s":"Convert to mixed."}},{"k":"3_2_1_1_2","v":{"s":"3/2 = 1 1/2."}},{"k":"sanity_check_with_measurement_meaning","v":{"s":"Sanity-check with measurement meaning."}},{"k":"how_many_1_2_fit_in_3_4_3_4_is_one_and","v":{"s":"\"How many 1/2 fit in 3/4?\" 3/4 is one-and-a-half halves. ✓"}},{"k":"1_1_2","v":{"s":"1 1/2"}},{"k":"simplifying_a_fraction","v":{"s":"Simplifying a fraction"}},{"k":"find_the_gcd_of_the_numerator_and_deno","v":{"s":"Find the GCD of the numerator and denominator."}},{"k":"factors_of_18_1_2_3_6_9_18_factors_of_","v":{"s":"Factors of 18: 1, 2, 3, 6, 9, 18. Factors of 24: 1, 2, 3, 4, 6, 8, 12, 24. Common factors: 1, 2, 3, 6. GCD = 6."}},{"k":"divide_top_and_bottom_by_the_gcd_2","v":{"s":"Divide top and bottom by the GCD."}},{"k":"18_6_3_24_6_4","v":{"s":"18 ÷ 6 = 3. 24 ÷ 6 = 4."}},{"k":"write_the_simplified_fraction","v":{"s":"Write the simplified fraction."}},{"k":"verify_gcd_3_4_1","v":{"s":"Verify GCD(3, 4) = 1."}},{"k":"yes_no_common_factors_1","v":{"s":"Yes — no common factors > 1. ✓"}},{"k":"generating_equivalent_fractions","v":{"s":"Generating equivalent fractions"}},{"k":"what_number_times_5_gives_15","v":{"s":"What number times 5 gives 15?"}},{"k":"15_5_3","v":{"s":"15 ÷ 5 = 3."}},{"k":"multiply_numerator_by_the_same_number","v":{"s":"Multiply numerator by the same number."}},{"k":"2_3_6_2","v":{"s":"2 × 3 = 6."}},{"k":"write_the_equivalent","v":{"s":"Write the equivalent."}},{"k":"2_5_6_15","v":{"s":"2/5 = 6/15."}},{"k":"verify_with_cross_multiplication","v":{"s":"Verify with cross-multiplication."}},{"k":"2_15_30_5_6_30_cross_products_equal","v":{"s":"2 × 15 = 30. 5 × 6 = 30. ✓ Cross products equal."}},{"k":"comparing_using_a_benchmark","v":{"s":"Comparing using a benchmark"}},{"k":"compare_7_12_to_1_2","v":{"s":"Compare 7/12 to 1/2."}},{"k":"7_12_is_14_12_yes_so_7_12_1_2","v":{"s":"7/12: is 14 > 12? Yes. So 7/12 > 1/2."}},{"k":"compare_5_8_to_1_2","v":{"s":"Compare 5/8 to 1/2."}},{"k":"5_8_is_10_8_yes_so_5_8_1_2_both_are_bi","v":{"s":"5/8: is 10 > 8? Yes. So 5/8 > 1/2. Both are bigger than 1/2 — need another check."}},{"k":"use_common_denominator","v":{"s":"Use common denominator."}},{"k":"lcm_12_8_24_7_12_14_24_5_8_15_24","v":{"s":"LCM(12, 8) = 24. 7/12 = 14/24. 5/8 = 15/24."}},{"k":"compare_numerators","v":{"s":"Compare numerators."}},{"k":"14_15_so_7_12_5_8","v":{"s":"14 < 15, so 7/12 < 5/8."}},{"k":"5_8_7_12","v":{"s":"5/8 > 7/12"}},{"k":"multi_step_word_problem","v":{"s":"Multi-step word problem"}},{"k":"identify_the_operation","v":{"s":"Identify the operation."}},{"k":"splitting_equally_division_5_6_3","v":{"s":"Splitting equally = division. 5/6 ÷ 3."}},{"k":"apply_division_rule","v":{"s":"Apply division rule."}},{"k":"5_6_3_5_6_1_3_5_18","v":{"s":"5/6 ÷ 3 = 5/6 × 1/3 = 5/18."}},{"k":"gcd_5_18_1_already_simplest_form","v":{"s":"GCD(5, 18) = 1. Already simplest form."}},{"k":"interpret_the_answer","v":{"s":"Interpret the answer."}},{"k":"each_friend_gets_5_18_of_the_original_","v":{"s":"Each friend gets 5/18 of the original pizza."}},{"k":"5_18_of_the_pizza_each","v":{"s":"5/18 of the pizza each"}},{"k":"worked_examples_library","v":{"s":"🎓 Worked examples library"}},{"k":"walk_through_each_procedure_one_step_a","v":{"s":"Walk through each procedure one step at a time. Click through to see the reasoning behind each move. Research (Sweller) shows worked examples are more effective than practice problems alone for novice learners."}},{"k":"worked_example_selector","v":{"s":"Worked example selector"}},{"k":"answer","v":{"s":"✅ Answer: "}},{"k":"previous_step","v":{"s":"← Previous step"}},{"k":"next_step","v":{"s":"Next step →"}},{"k":"frequently_asked_questions","v":{"s":"❓ Frequently asked questions"}},{"k":"common_questions_about_fractions_answe","v":{"s":"Common questions about fractions, answered. Use this to settle confusion or as a starting point for student discussions."}},{"k":"search_faq","v":{"s":"Search FAQ..."}},{"k":"search_faq_2","v":{"s":"Search FAQ"}},{"k":"no_matches_3","v":{"s":"No matches."}},{"k":"same_denominator_just_compare_numerato","v":{"s":"Same denominator? Just compare numerators."}},{"k":"same_numerator_more_pieces_smaller_pie","v":{"s":"Same numerator? More pieces = smaller pieces."}},{"k":"compare_to_1_2_or_0_or_1","v":{"s":"Compare to 1/2 (or 0, or 1)."}},{"k":"find_a_common_denominator","v":{"s":"Find a common denominator."}},{"k":"five_ways_to_compare_fractions","v":{"s":"⚖ Five ways to compare fractions"}},{"k":"there_is_more_than_one_way_to_compare_","v":{"s":"There is more than one way to compare fractions. Knowing all five lets you pick the fastest method for each problem."}},{"k":"example","v":{"s":"✏ Example"}},{"k":"steps_2","v":{"s":"📋 Steps"}},{"k":"fraction_cheat_sheet","v":{"s":"📋 Fraction cheat sheet"}},{"k":"quick_reference_card_for_fraction_oper","v":{"s":"Quick-reference card for fraction operations and procedures. Save or print this for students."}},{"k":"addition_subtraction","v":{"s":"➕ ADDITION / SUBTRACTION"}},{"k":"same_denominator","v":{"s":"Same denominator: "}},{"k":"add_subtract_the_numerators_keep_the_d","v":{"s":"Add/subtract the numerators. Keep the denominator. "}},{"k":"a_b_c_b_a_c_b","v":{"s":"a/b + c/b = (a+c)/b"}},{"k":"different_denominators","v":{"s":"Different denominators: "}},{"k":"1_find_lcm_2_convert_both_fractions_3_","v":{"s":"1) Find LCM. 2) Convert both fractions. 3) Add/subtract. 4) Simplify."}},{"k":"you_can_always_use_the_product_of_deno","v":{"s":"You can always use the product of denominators as a common denominator (not always smallest, but it works)."}},{"k":"multiplication","v":{"s":"✕ MULTIPLICATION"}},{"k":"multiply_numerators_multiply_denominat","v":{"s":"Multiply numerators. Multiply denominators. Simplify."}},{"k":"a_b_c_d_a_c_b_d","v":{"s":"a/b × c/d = (a×c) / (b×d)"}},{"k":"of_usually_means_1_2_of_8_1_2_8_4","v":{"s":"\"of\" usually means \"×\": \"1/2 of 8\" = 1/2 × 8 = 4."}},{"k":"multiplying_by_1_makes_things_smaller_","v":{"s":"Multiplying by < 1 makes things smaller. Multiplying by > 1 makes things bigger."}},{"k":"division","v":{"s":"➗ DIVISION"}},{"k":"keep_first_fraction_change_to_flip_sec","v":{"s":"Keep first fraction. Change ÷ to ×. Flip second fraction (reciprocal)."}},{"k":"a_b_c_d_a_b_d_c_a_d_b_c","v":{"s":"a/b ÷ c/d = a/b × d/c = (a×d) / (b×c)"}},{"k":"measurement_meaning","v":{"s":"Measurement meaning: "}},{"k":"how_many_of_these_fit_in_that_4_1_2_ho","v":{"s":"\"How many of these fit in that?\" 4 ÷ 1/2 = \"how many halves in 4?\" = 8."}},{"k":"dividing_by_1_makes_things_bigger","v":{"s":"Dividing by < 1 makes things bigger."}},{"k":"equivalence","v":{"s":"🔗 EQUIVALENCE"}},{"k":"multiply_or_divide_top_and_bottom_by_t","v":{"s":"Multiply (or divide) top AND bottom by the same nonzero number. Value stays the same."}},{"k":"1_2_2_4_3_6_4_8_50_100","v":{"s":"1/2 = 2/4 = 3/6 = 4/8 = 50/100"}},{"k":"simplest_form","v":{"s":"Simplest form: "}},{"k":"divide_top_and_bottom_by_their_gcd_gre","v":{"s":"Divide top and bottom by their GCD (greatest common factor)."}},{"k":"test_for_equivalence","v":{"s":"Test for equivalence: "}},{"k":"cross_multiply_a_b_c_d_iff_a_d_b_c","v":{"s":"Cross-multiply. a/b = c/d iff a×d = b×c."}},{"k":"conversions_2","v":{"s":"🔄 CONVERSIONS"}},{"k":"improper_mixed","v":{"s":"Improper → mixed: "}},{"k":"divide_whole_quotient_fraction_remaind","v":{"s":"Divide. Whole = quotient. Fraction = remainder/denominator."}},{"k":"mixed_improper","v":{"s":"Mixed → improper: "}},{"k":"whole_denominator_numerator_all_over_d","v":{"s":"(whole × denominator) + numerator, all over denominator."}},{"k":"fraction_decimal","v":{"s":"Fraction → decimal: "}},{"k":"numerator_denominator_long_division","v":{"s":"Numerator ÷ denominator (long division)."}},{"k":"decimal_fraction","v":{"s":"Decimal → fraction: "}},{"k":"0_25_25_100_1_4_use_place_value_then_s","v":{"s":"0.25 = 25/100 = 1/4 (use place value, then simplify)."}},{"k":"fraction_percent","v":{"s":"Fraction → percent: "}},{"k":"multiply_by_100_or_convert_to_decimal_","v":{"s":"Multiply by 100 (or convert to decimal first)."}},{"k":"comparison","v":{"s":"⚖ COMPARISON"}},{"k":"same_bottom","v":{"s":"Same bottom: "}},{"k":"compare_tops_directly","v":{"s":"Compare tops directly."}},{"k":"same_top","v":{"s":"Same top: "}},{"k":"smaller_bottom_bigger_fraction_bigger_","v":{"s":"Smaller bottom = bigger fraction (bigger pieces)."}},{"k":"a_b_vs_c_d_a_d_vs_b_c","v":{"s":"a/b vs c/d → a×d vs b×c."}},{"k":"compare_each_to_0_1_2_or_1","v":{"s":"Compare each to 0, 1/2, or 1."}},{"k":"print_this_cheat_sheet","v":{"s":"🖨 Print this cheat sheet"}},{"k":"fraction_fact_families","v":{"s":"👨‍👩‍👧 Fraction fact families"}},{"k":"just_like_whole_number_fact_families_3","v":{"s":"Just like whole-number fact families (3 + 4 = 7, 7 - 3 = 4, 7 - 4 = 3), fractions have fact families too. "}},{"k":"a_single_triple_generates_four_related","v":{"s":"A single triple generates four related equations."}},{"k":"fraction_a_3","v":{"s":"Fraction A"}},{"k":"fraction_b_3","v":{"s":"Fraction B"}},{"k":"addition_fact_family","v":{"s":"➕ Addition fact family"}},{"k":"multiplication_fact_family","v":{"s":"✕ Multiplication fact family"}},{"k":"estimation_trainer_2","v":{"s":"Estimation Trainer"}},{"k":"quickly_estimate_which_benchmark_a_fra","v":{"s":"Quickly estimate which benchmark a fraction is closest to. This is the fastest way to develop fraction number sense."}},{"k":"start_training","v":{"s":"🎯 Start training"}},{"k":"restart_9","v":{"s":"↺ Restart"}},{"k":"which_is_closest_to","v":{"s":"Which is closest to "}},{"k":"probability_as_a_fraction","v":{"s":"🎲 Probability as a fraction"}},{"k":"probability_is_favorable_outcomes_tota","v":{"s":"Probability is favorable outcomes / total outcomes. Move the sliders to see how probability and fractions are the same thing."}},{"k":"favorable_outcomes","v":{"s":"Favorable outcomes"}},{"k":"total_outcomes","v":{"s":"Total outcomes"}},{"k":"probability_2","v":{"s":"Probability"}},{"k":"fraction_vocabulary_in_12_languages","v":{"s":"🌍 Fraction vocabulary in 12 languages"}},{"k":"for_english_language_learners_see_frac","v":{"s":"For English Language Learners: see fraction vocabulary in your home language alongside English. "}},{"k":"bilingual_instruction_speeds_math_acqu","v":{"s":"Bilingual instruction speeds math acquisition because the mathematical concept is universal — only the words change."}},{"k":"english","v":{"s":"English"}},{"k":"curated_practice_bank","v":{"s":"📚 Curated practice bank"}},{"k":"a_hand_curated_set_of_practice_items_o","v":{"s":"A hand-curated set of practice items organized by skill. Browse by category, or use them as a quick warmup before challenges."}},{"k":"what_fraction_is_shown","v":{"s":"What fraction is shown?"}},{"k":"find_the_equivalent","v":{"s":"Find the equivalent:"}},{"k":"which_is_larger","v":{"s":"Which is larger?"}},{"k":"previous","v":{"s":"← Previous"}},{"k":"next_2","v":{"s":"Next →"}},{"k":"fraction_calculator_show_your_work","v":{"s":"🧮 Fraction calculator (show your work)"}},{"k":"enter_two_fractions_and_an_operation_t","v":{"s":"Enter two fractions and an operation. This calculator shows every step, not just the answer."}},{"k":"first_numerator","v":{"s":"First numerator"}},{"k":"first_denominator","v":{"s":"First denominator"}},{"k":"operation","v":{"s":"Operation"}},{"k":"second_numerator","v":{"s":"Second numerator"}},{"k":"second_denominator","v":{"s":"Second denominator"}},{"k":"step_by_step_solution","v":{"s":"📋 Step-by-step solution:"}},{"k":"fraction_art_gallery","v":{"s":"🎨 Fraction art gallery"}},{"k":"fractions_make_patterns_build_a_color_","v":{"s":"Fractions make patterns. Build a color wheel, a fraction grid, or a kaleidoscope."}},{"k":"grid_size","v":{"s":"Grid size:"}},{"k":"lit_slices","v":{"s":"Lit slices"}},{"k":"total_slices","v":{"s":"Total slices"}},{"k":"density_of_fractions","v":{"s":"∞ Density of fractions"}},{"k":"between_any_two_fractions_there_is_alw","v":{"s":"Between any two fractions, there is always another fraction. Then another. And another, forever. This is called \"density.\" Pick two fractions and find ones between them."}},{"k":"first_fraction","v":{"s":"First fraction"}},{"k":"first_numerator_2","v":{"s":"First numerator"}},{"k":"first_denominator_2","v":{"s":"First denominator"}},{"k":"second_fraction","v":{"s":"Second fraction"}},{"k":"second_numerator_2","v":{"s":"Second numerator"}},{"k":"second_denominator_2","v":{"s":"Second denominator"}},{"k":"average_arithmetic_mean","v":{"s":"⚖ Average (arithmetic mean):"}},{"k":"add_the_fractions_and_divide_by_2","v":{"s":"Add the fractions and divide by 2."}},{"k":"mediant_stern_brocot_tree","v":{"s":"🌳 Mediant (Stern-Brocot tree):"}},{"k":"add_the_tops_add_the_bottoms_this_is_n","v":{"s":"Add the tops, add the bottoms. (This is NOT addition — it's the mediant.) Always between the two fractions."}},{"k":"you_could_repeat_this_process_forever_","v":{"s":"You could repeat this process forever, finding new fractions between every pair. There are infinitely many fractions between any two fractions."}},{"k":"1_4_quarter","v":{"s":"1/4 (quarter)"}},{"k":"1_2_half","v":{"s":"1/2 (half)"}},{"k":"1_full","v":{"s":"1 (full)"}},{"k":"1_1_2_2","v":{"s":"1 1/2"}},{"k":"2_double","v":{"s":"2 (double)"}},{"k":"3_triple","v":{"s":"3 (triple)"}},{"k":"4_quadruple","v":{"s":"4 (quadruple)"}},{"k":"recipe_scaler_2","v":{"s":"🍳 Recipe scaler"}},{"k":"pick_a_recipe_and_scale_it_up_or_down_","v":{"s":"Pick a recipe and scale it up or down using fraction multiplication. Every cooking decision becomes a fraction multiplication problem."}},{"k":"recipe","v":{"s":"Recipe"}},{"k":"recipe_selector","v":{"s":"Recipe selector"}},{"k":"scale_by","v":{"s":"Scale by"}},{"k":"scaler","v":{"s":"Scaler"}},{"k":"yields","v":{"s":"Yields "}},{"k":"ingredient","v":{"s":"Ingredient"}},{"k":"original","v":{"s":"Original"}},{"k":"scaled","v":{"s":"Scaled"}},{"k":"unit","v":{"s":"Unit"}},{"k":"multi_step_problems","v":{"s":"🧩 Multi-step problems"}},{"k":"real_problems_usually_take_multiple_st","v":{"s":"Real problems usually take multiple steps. These chains walk you through 2-4 sub-questions building toward a final answer."}},{"k":"your_answer_e_g_3_4_or_1_1_2_or_8_2","v":{"s":"Your answer (e.g., 3/4 or 1 1/2 or 8)"}},{"k":"multi_step_answer","v":{"s":"Multi-step answer"}},{"k":"check_2","v":{"s":"Check"}},{"k":"your_answers","v":{"s":"Your answers:"}},{"k":"previous_2","v":{"s":"← Previous"}},{"k":"next_problem_2","v":{"s":"Next problem →"}},{"k":"fraction_trivia_history","v":{"s":"💡 Fraction trivia & history"}},{"k":"where_fractions_come_from_surprising_c","v":{"s":"Where fractions come from, surprising connections, and why mathematics is full of stories. Click any title to expand."}},{"k":"vocabulary_2","v":{"s":"Vocabulary"}},{"k":"glossary_2","v":{"s":"Glossary"}},{"k":"compare_strategies_2","v":{"s":"Compare strategies"}},{"k":"cheat_sheet_2","v":{"s":"Cheat sheet"}},{"k":"worked_examples_2","v":{"s":"Worked examples"}},{"k":"conv_tables","v":{"s":"Conv. tables"}},{"k":"tab_guide","v":{"s":"Tab guide"}},{"k":"look_up_materials_definitions_and_refe","v":{"s":"Look-up materials, definitions, and reference guides."}},{"k":"trivia","v":{"s":"Trivia"}},{"k":"magic_tricks_2","v":{"s":"Magic tricks"}},{"k":"history","v":{"s":"History"}},{"k":"sayings","v":{"s":"Sayings"}},{"k":"animal_facts","v":{"s":"Animal facts"}},{"k":"quotes_2","v":{"s":"Quotes"}},{"k":"density_2","v":{"s":"Density"}},{"k":"fun_extras_trivia_history_and_surprisi","v":{"s":"Fun extras: trivia, history, and surprising math."}},{"k":"help_3","v":{"s":"Help"}},{"k":"about_2","v":{"s":"About"}}