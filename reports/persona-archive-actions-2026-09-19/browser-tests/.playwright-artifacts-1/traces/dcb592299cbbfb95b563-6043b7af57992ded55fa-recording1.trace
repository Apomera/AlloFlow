ose_field_note","v":{"s":"Choose field note"}},{"k":"a11y_next_field_note","v":{"s":"Next field note"}},{"k":"initializing","v":{"s":"🧲 Charging the coils…"}}],"id":602}},{"k":"simShelf","v":{"o":[{"k":"popup_blocked","v":{"s":"The Sim Shelf window was blocked. Allow pop-ups for this page, then try again."}},{"k":"opened_sr","v":{"s":"Opened the Sim Shelf in a new window."}},{"k":"returned_catalog_sr","v":{"s":"Returned to the STEAM Lab tools."}},{"k":"back_to_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"title","v":{"s":"🧪 Sim Shelf — predict first, then play"}},{"k":"blurb","v":{"s":"Sixteen hand-picked PhET simulations — forces, energy, circuits, light, matter, orbits, evolution, fractions, probability and more — each wrapped in a Predict → Explore → Explain coach. You lock in a guess BEFORE touching the sim; afterwards the coach compares your prediction with what you actually saw and asks one good question."}},{"k":"note1","v":{"s":"Predictions and explanations stay in the lab window — nothing is saved or graded."}},{"k":"ai_on","v":{"s":"AI coach is ON — it will compare your prediction with your observations while this window stays open."}},{"k":"ai_off","v":{"s":"AI hints are off — the shelf still works, with built-in reflection prompts instead of the AI coach."}},{"k":"open_title","v":{"s":"Open the Sim Shelf in a new window (PhET simulations with the Predict-Explore-Explain coach)"}},{"k":"open","v":{"s":"🧪 Open Sim Shelf"}},{"k":"opening_note","v":{"s":"Opening Sim Shelf. If it does not appear, check your pop-up settings."}},{"k":"blocked_note","v":{"s":"Pop-up blocked — allow pop-ups for this page and try again."}},{"k":"open_note","v":{"s":"Sim Shelf is open. Keep this AlloFlow window open too — it powers the AI coach."}},{"k":"closed_note","v":{"s":"Sim Shelf was closed. You can reopen it whenever you are ready."}},{"k":"credit","v":{"s":"Simulations by PhET Interactive Simulations, University of Colorado Boulder (phet.colorado.edu) — free and open, used billions of times worldwide. Sims load from PhET, so the shelf needs internet; several include PhET’s own keyboard navigation, spoken descriptions, and sonification."}}],"id":603}},{"k":"zoomGallery","v":{"o":[{"k":"win_title","v":{"s":"🔍 Zoom Gallery"}},{"k":"win_sub","v":{"s":"OpenSeadragon deep zoom (BSD-3) · Smithsonian Open Access (CC0) + NASA (public domain) + AlloFlow Notice-Wonder coach"}},{"k":"select_label","v":{"s":"Choose an image"}},{"k":"select_placeholder","v":{"s":"Choose an image…"}},{"k":"coach_aria","v":{"s":"Notice and Wonder coach"}},{"k":"coach_heading","v":{"s":"Observation coach"}},{"k":"steps_aria","v":{"s":"Observation steps"}},{"k":"step_notice","v":{"s":"1 · Notice"}},{"k":"step_wonder","v":{"s":"2 · Wonder"}},{"k":"step_coach","v":{"s":"3 · Coach"}},{"k":"privacy","v":{"s":"Your notes stay on this device — they are sent back to your AlloFlow window so they survive closing this one, and nothing is graded. AI feedback flows only when your teacher has AI hints on, and only when you ask for it."}},{"k":"stage_aria","v":{"s":"Deep-zoom image viewer"}},{"k":"back_gallery","v":{"s":"← Gallery"}},{"k":"pin_drop","v":{"s":"📍 Drop a pin"}},{"k":"pin_drop_active","v":{"s":"📍 Click the image to place pin {n}"}},{"k":"pin_clear","v":{"s":"Clear pins"}},{"k":"pin_placed_sr","v":{"s":"Pin {n} placed at {x}% across, {y}% down, zoom {z}×."}},{"k":"pin_summary","v":{"s":"Pin {n}: {x}% across, {y}% down at {z}× zoom"}},{"k":"pins_heading","v":{"s":"Your pins"}},{"k":"zoom_readout","v":{"s":"Zoom {z}×"}},{"k":"picker_heading","v":{"s":"Pick an image — each one is a real, openly licensed photograph or artifact. Zoom in close and look for details you'd miss from far away."}},{"k":"badge_deep","v":{"s":"true deep zoom"}},{"k":"badge_photo","v":{"s":"high-res photo"}},{"k":"custom_heading","v":{"s":"Bring your own image"}},{"k":"custom_help","v":{"s":"Paste a link to a picture (.jpg or .png) or a IIIF info.json link from a museum or library. It opens in this window only and is not saved. Some sites block browser access; if a link will not load, try another."}},{"k":"custom_input_aria","v":{"s":"Image or IIIF link"}},{"k":"custom_placeholder","v":{"s":"https://…"}},{"k":"custom_open","v":{"s":"Open link"}},{"k":"custom_err_url","v":{"s":"That does not look like a web link. It should start with https://"}},{"k":"custom_err_iiif","v":{"s":"Could not read that IIIF link from the browser. The site may block cross-origin access."}},{"k":"custom_name","v":{"s":"Your image"}},{"k":"custom_credit","v":{"s":"Link provided by you — check its licence before sharing."}},{"k":"custom_notice","v":{"s":"Zoom right in. What is ONE detail you can only see up close?"}},{"k":"custom_wonder","v":{"s":"What question does this image make you want to ask?"}},{"k":"intro_card","v":{"s":"Pick an image, then zoom right in. Scroll or pinch to magnify, drag to move around. Write down what you notice up close."}},{"k":"notice_label","v":{"s":"What you notice"}},{"k":"notice_placeholder","v":{"s":"I notice…"}},{"k":"to_wonder","v":{"s":"On to Wonder →"}},{"k":"wonder_label","v":{"s":"What you wonder"}},{"k":"wonder_placeholder","v":{"s":"I wonder…"}},{"k":"you_noticed","v":{"s":"You noticed:"}},{"k":"you_wondered","v":{"s":"You wondered:"}},{"k":"to_coach","v":{"s":"Take it to the coach →"}},{"k":"ask_ai","v":{"s":"✨ What does the coach think?"}},{"k":"ask_prompt","v":{"s":"🤔 Give me an observation prompt"}},{"k":"thinking","v":{"s":"thinking…"}},{"k":"ai_no_answer","v":{"s":"The AI coach didn’t answer{err}. Meanwhile: {prompt}"}},{"k":"copy_notes","v":{"s":"📋 Copy notes"}},{"k":"copied","v":{"s":"Copied!"}},{"k":"copy_failed","v":{"s":"Copy failed — select the text and copy it by hand."}},{"k":"notes_header","v":{"s":"Zoom Gallery notes"}},{"k":"ai_connected_on","v":{"s":"AlloFlow connected · AI coach <span class=\"on\">on</span>"}},{"k":"ai_connected_off","v":{"s":"AlloFlow connected · AI hints <span class=\"off\">off</span> — using built-in observation prompts"}},{"k":"ai_standalone","v":{"s":"Standalone — built-in observation prompts (open from AlloFlow for the AI coach)"}},{"k":"loading","v":{"s":"Loading {name}…"}},{"k":"viewer_failed","v":{"s":"The deep-zoom viewer could not load. Check your internet connection and try again."}},{"k":"image_failed","v":{"s":"Could not load \"{name}\". Check your internet connection and try again."}},{"k":"source_record","v":{"s":"source record"}},{"k":"reflect_1","v":{"s":"Zoom in one more level than feels necessary. What is ONE detail you can only see up close that you would have missed from far away?"}},{"k":"reflect_2","v":{"s":"Compare the middle of the image with an edge. How are they different — sharper, blurrier, brighter, emptier?"}},{"k":"reflect_3","v":{"s":"If you had to give this image a title of your own, what would it be, and which detail made you choose it?"}},{"k":"reflect_4","v":{"s":"Pick one small area and describe it as if to someone who cannot see it. What exactly is there?"}},{"k":"reflect_5","v":{"s":"What is one question about this image that zooming in even more might actually help you answer?"}},{"k":"describe_heading","v":{"s":"What is in this image"}},{"k":"describe_show","v":{"s":"Describe this image"}},{"k":"describe_hide","v":{"s":"Hide the description"}},{"k":"describe_intro","v":{"s":"A written description of what the picture shows, for anyone who wants it. It does not say what to notice — that part is yours."}},{"k":"zoom_in","v":{"s":"Zoom in"}},{"k":"zoom_out","v":{"s":"Zoom out"}},{"k":"zoom_fit","v":{"s":"Fit the whole image"}},{"k":"pin_center","v":{"s":"Pin the centre of the view"}},{"k":"pin_hint","v":{"s":"Pin mode is on. Click the image, or press Enter with the viewer focused, to pin the middle of what you can see."}},{"k":"viewer_aria","v":{"s":"{name}. Deep-zoom viewer. Use the arrow keys to move and plus and minus to zoom."}},{"k":"zoom_announced","v":{"s":"Zoom {z} times."}},{"k":"fit_announced","v":{"s":"Showing the whole image."}},{"k":"pin_removed_sr","v":{"s":"Pin {n} removed."}},{"k":"pin_remove","v":{"s":"Remove pin {n}"}},{"k":"read_aloud","v":{"s":"Read this aloud"}},{"k":"read_aloud_busy","v":{"s":"Speaking…"}},{"k":"read_aloud_stop","v":{"s":"Stop reading"}},{"k":"read_aloud_failed","v":{"s":"Read-aloud is not available right now."}},{"k":"read_prompt","v":{"s":"Read the question aloud"}},{"k":"title","v":{"s":"🔍 Zoom Gallery — real images, up close"}},{"k":"blurb","v":{"s":"Zoom deep into real, openly-licensed images in OpenSeadragon — the deep-zoom viewer museums and archives use. Magnify to the pixel: the Pillars of Creation, Saturn's rings, an Apollo bootprint on the Moon, the real Apollo 11 capsule, a branching coral fan. A Notice → Wonder coach sits beside the viewer: you record what you see up close and what it makes you curious about, and the coach asks a question back."}},{"k":"inline_hint","v":{"s":"Scroll or pinch to zoom, drag to pan. Keyboard: click the image, then use + and − to zoom and the arrow keys to move."}},{"k":"pop_out","v":{"s":"↗ Pop out"}},{"k":"pop_out_title","v":{"s":"Open the gallery in its own window (for a second screen or a bigger view)"}},{"k":"fullscreen","v":{"s":"⛶ Fullscreen"}},{"k":"viewer_blocked","v":{"s":"The deep-zoom library could not load here. Use \"Pop out\" to open the gallery in its own window."}},{"k":"ai_inline_on","v":{"s":"AI coach is ON — it builds on what you notice."}},{"k":"ai_inline_off","v":{"s":"AI hints are off — built-in observation prompts stand in for the coach."}},{"k":"image_opened_sr","v":{"s":"Opened {name}. Zoom in with plus or scroll."}},{"k":"pins_cleared_sr","v":{"s":"Pins cleared."}},{"k":"coach_answered_sr","v":{"s":"The coach replied."}},{"k":"notes_saved","v":{"s":"Notes are saved on this device only."}},{"k":"note1","v":{"s":"Your notes stay in the gallery window — nothing is saved or graded."}},{"k":"ai_on","v":{"s":"AI coach is ON — it will build on what you notice while this window stays open."}},{"k":"ai_off","v":{"s":"AI hints are off — the gallery still works, with built-in observation prompts instead of the AI coach."}},{"k":"popup_blocked","v":{"s":"The Zoom Gallery window was blocked. Allow pop-ups for this page, then try again."}},{"k":"opened_sr","v":{"s":"Opened the Zoom Gallery in a new window."}},{"k":"returned_catalog_sr","v":{"s":"Returned to the STEAM Lab tools."}},{"k":"back_to_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"open_title","v":{"s":"Open the Zoom Gallery in a new window (OpenSeadragon deep-zoom viewer with the Notice-Wonder coach)"}},{"k":"open","v":{"s":"🔍 Open Zoom Gallery"}},{"k":"opening_note","v":{"s":"Opening Zoom Gallery. If it does not appear, check your pop-up settings."}},{"k":"blocked_note","v":{"s":"Pop-up blocked — allow pop-ups for this page and try again."}},{"k":"open_note","v":{"s":"Zoom Gallery is open. Keep this AlloFlow window open too — it powers the AI coach."}},{"k":"closed_note","v":{"s":"Zoom Gallery was closed. You can reopen it whenever you are ready."}},{"k":"copy_link","v":{"s":"🔗 Copy link"}},{"k":"copy_link_title","v":{"s":"Copy a link that opens Zoom Gallery on this image"}},{"k":"link_copied","v":{"s":"Link copied"}},{"k":"link_copied_sr","v":{"s":"Link to {name} copied."}},{"k":"link_failed","v":{"s":"Copying was blocked here. Select the link and copy it by hand:"}},{"k":"link_field_aria","v":{"s":"Link to this image"}},{"k":"scale_group","v":{"s":"Scale of this view"}},{"k":"scale_about","v":{"s":"about"}},{"k":"scale_view","v":{"s":"This view is {w} across"}},{"k":"scale_open_sx","v":{"s":"⚖️ See this size in Scale Explorer"}},{"k":"scale_open_sx_title","v":{"s":"Open Scale Explorer at the width of this view"}},{"k":"scale_basis_title","v":{"s":"How this scale was set"}},{"k":"measure_btn","v":{"s":"📏 Measure"}},{"k":"measure_active","v":{"s":"📏 Measuring: click two points"}},{"k":"measure_center","v":{"s":"Mark a point at the centre"}},{"k":"measure_clear","v":{"s":"Clear measurement"}},{"k":"measure_hint","v":{"s":"Click two points on the image to measure between them. From the keyboard: pan to a spot and press Enter, twice."}},{"k":"measure_first_sr","v":{"s":"First point marked. Mark the second."}},{"k":"measure_sr","v":{"s":"Distance between the points: {d}."}},{"k":"measure_result","v":{"s":"Distance: {d}"}},{"k":"chal_heading","v":{"s":"Scale challenge"}},{"k":"chal_estimate_label","v":{"s":"Your estimate first"}},{"k":"chal_unit_km","v":{"s":"km"}},{"k":"chal_unit_ly","v":{"s":"light years"}},{"k":"chal_lock","v":{"s":"Lock in my estimate"}},{"k":"chal_locked","v":{"s":"You estimated {est}. Now measure it: Measure is on, so click the two ends."}},{"k":"chal_hint_label","v":{"s":"How to measure it"}},{"k":"chal_show_answer","v":{"s":"Show the accepted value"}},{"k":"chal_answer","v":{"s":"Accepted value: {ans}."}},{"k":"chal_answer_approx","v":{"s":"Accepted value: {ans}, itself approximate."}},{"k":"chal_measured","v":{"s":"You measured {m}, which is within {pct}% of the accepted value."}},{"k":"chal_measured_far","v":{"s":"You measured {m}, which is {factor} times the accepted value. Check that you measured the right two ends."}},{"k":"chal_est_spot","v":{"s":"Your estimate was spot on."}},{"k":"chal_est_close","v":{"s":"Your estimate was close: within a factor of {factor}."}},{"k":"chal_est_off","v":{"s":"Your estimate was {factor} times out, which is {dec} powers of ten."}},{"k":"chal_reset","v":{"s":"Try another estimate"}},{"k":"chal_invalid","v":{"s":"Enter a number for your estimate."}},{"k":"chal_locked_sr","v":{"s":"Estimate locked in at {est}. Measure mode is on: mark the two ends."}},{"k":"credit","v":{"s":"Viewer: OpenSeadragon (openseadragon.github.io), free and open source under the BSD-3-Clause license. Images: Smithsonian Open Access (released CC0) served as IIIF deep-zoom tiles, and NASA photographs (public domain). Each image lists its source and a link to the original record. The viewer and images load from the web, so the gallery needs internet."}},{"k":"img_earthrise_name","v":{"s":"Earthrise (Apollo 8, 1968)"}},{"k":"img_earthrise_meta","v":{"s":"Earth photographed rising over the Moon’s horizon on 24 December 1968"}},{"k":"img_earthrise_notice","v":{"s":"Zoom right into the edge where the bright Earth meets the black space. Is that edge a hard line or a soft fade? Now find where the blue turns brown, and describe what the white swirls are doing there."}},{"k":"img_earthrise_wonder","v":{"s":"The Moon fills the bottom of this photo and the Earth is a small ball above it, even though Earth is much bigger. What does that tell you about where the camera was?"}},{"k":"img_earthrise_describe","v":{"s":"A colour photograph, mostly empty black space. Across the bottom third lies the Moon: a pale grey, softly rolling surface with shallow craters and no sharp shadows, ending in a slightly curved horizon. Above the horizon and to the right of centre floats the Earth, small in the frame and lit from the left, so only part of it is bright. The lit part is deep blue ocean marbled with swirls and streaks of white cloud, with a brownish landmass showing through near the lower middle. The unlit part fades into the black. There are no stars visible."}},{"k":"img_farside_name","v":{"s":"The far side of the Moon (LRO mosaic)"}},{"k":"img_farside_meta","v":{"s":"The side of the Moon that never faces Earth, assembled from more than 15,000 Lunar Reconnaissance Orbiter Camera images taken between 2009 and 2011"}},{"k":"img_farside_notice","v":{"s":"Zoom into the middle and count how many craters sit inside one bigger crater. Then find the dark oval patch toward the upper left and describe how its surface differs from the rough ground around it."}},{"k":"img_farside_wonder","v":{"s":"The side of the Moon we see from Earth has big dark plains across it; this side has almost none. What might have made the two sides so different?"}},{"k":"img_farside_describe","v":{"s":"A black-and-white image of the whole Moon as a grey disc filling the frame against black. The surface is crowded edge to edge with overlapping craters of every size, from bowls with bright rims down to specks, with brighter rough highlands between them. Unlike the familiar side of the Moon there are almost no large dark plains: one dark oval patch sits toward the upper left, and a small dark-floored crater with a bright central peak sits near the lower left. Toward the very top and bottom the craters stretch and the picture looks streaky, because the map was stitched from strips."}},{"k":"img_bootprint_name","v":{"s":"Bootprint on the Moon (Apollo 11)"}},{"k":"img_bootprint_meta","v":{"s":"a boot print pressed into lunar soil in 1969, photographed to study how the soil behaves"}},{"k":"img_bootprint_notice","v":{"s":"Zoom into the rim of the print, where the soil was pushed up. How sharp are those edges? Then look at the small black crosses spread evenly over the whole picture, and decide whether they are on the Moon or not."}},{"k":"img_bootprint_wonder","v":{"s":"This print was made in a place with no wind, no rain and almost no air. What would have to happen for it to be rubbed out?"}},{"k":"img_bootprint_describe","v":{"s":"A black-and-white close-up of grey lunar soil filling the whole frame. The soil is fine and powdery with scattered small stones and pebbles casting hard black shadows. Near the middle-right sits a single boot print, pressed sharply into the dust: an oval sole with about a dozen straight raised ridges running across it, and a crisp raised rim of soil pushed up around the edge. Small black cross marks, each like a plus sign, are spaced in a regular grid across the entire photograph, including over the soil and the print."}},{"k":"img_pillars_name","v":{"s":"Pillars of Creation in near-infrared (Hubble)"}},{"k":"img_pillars_meta","v":{"s":"towers of gas and dust in the Eagle Nebula, photographed in near-infrared light so stars behind and inside them show through"}},{"k":"img_pillars_notice","v":{"s":"Zoom into the knobbly tip of the tallest column. Count how many separate bright points you can find that sit inside or right at the edge of the dark material, rather than in the open sky."}},{"k":"img_pillars_wonder","v":{"s":"This was taken in near-infrared light, which passes through dust that blocks visible light. Looking at how see-through these columns are, what would you expect the same view to look like in ordinary light?"}},{"k":"img_pillars_describe","v":{"s":"A dense field of thousands of stars on a deep blue-black background. Most stars are small orange and white points; a few of the brightest have four-pointed cross-shaped spikes. Rising through the middle of the frame are several dark, ghostly columns of gas and dust, brown and grey and semi-transparent, like tall wisps of smoke with knobbly, uneven tips. The tallest column runs up the left of centre; two shorter ones stand to its right, one with a thin finger reaching sideways. A faint bluish haze outlines the denser edges of the columns. Stars are visible through and apparently behind the columns."}},{"k":"img_carina_name","v":{"s":"Cosmic Cliffs, Carina Nebula (Webb)"}},{"k":"img_carina_meta","v":{"s":"a \"mountain range\" of gas and dust in a star-forming region, imaged in infrared by the Webb telescope"}},{"k":"img_carina_notice","v":{"s":"Follow the top edge of the orange cliffs from left to right. Zoom in and find a place where something seems to be coming out of the ridge and into the dark sky. Describe its shape."}},{"k":"img_carina_wonder","v":{"s":"The bright stars here have six spikes, but the stars in the Hubble picture have four. Neither is really shaped like that. What might make a telescope add spikes to a point of light?"}},{"k":"img_carina_describe","v":{"s":"The lower half of the picture is a rolling, cliff-like landscape of orange and rust-brown cloud, billowing like storm clouds lit from above, with dark hollows and caves in its face and a curled wisp reaching up at the far left. The upper half is deep blue and black sky filled with stars, many of them showing Webb’s distinctive six-pointed spikes with two fainter extra points. Small orange and white specks are scattered along the top edge of the cloud, and a few thin streaks appear to shoot upward out of the ridge."}},{"k":"img_saturn_name","v":{"s":"Saturn’s Atmosphere: the Cassini \"Noodle\" Mosaic"}},{"k":"img_saturn_meta","v":{"s":"137 photographs joined into one long strip, taken as the Cassini spacecraft dived past Saturn on 26 April 2017"}},{"k":"img_saturn_notice","v":{"s":"Start at the dark eye at the wide end and follow the strip down. Zoom in where the texture suddenly changes, and describe what is different on each side of that line."}},{"k":"img_saturn_wonder","v":{"s":"This is 137 separate photographs stitched into one strip, taken while the spacecraft was falling past the planet. Why could a single photograph not have shown this?"}},{"k":"img_saturn_describe","v":{"s":"A single long, narrow, curved strip of grey cloud detail running diagonally across a completely black background, from the wide upper-left corner down to a thin tapering tail at the lower right. At the wide top end is a dark circular eye surrounded by concentric rings of bright cloud: Saturn’s north polar vortex. Below it the strip narrows through a band of bright clumped storms, then crosses a straight edge where the texture changes, then continues through smoother bands, swirls and faint oval spots. Toward the bottom the strip becomes pale and almost featureless, and short straight steps are visible along its edge where the separate frames were joined."}},{"k":"img_curiosity_name","v":{"s":"Curiosity Rover Selfie (Mars)"}},{"k":"img_curiosity_meta","v":{"s":"the Curiosity rover photographs itself on Mars, using a camera on the end of its robotic arm"}},{"k":"img_curiosity_notice","v":{"s":"Zoom into the rock right beside the rover’s wheels. Is it loose sand or solid layered stone, and how can you tell? Look for any place the rover has disturbed it."}},{"k":"img_curiosity_wonder","v":{"s":"This picture was taken by a camera on the end of the rover’s own arm, yet no arm appears anywhere in it. How could that be?"}},{"k":"img_curiosity_describe","v":{"s":"A colour photograph of a rusty orange-brown Martian landscape under a dusty pinkish-tan sky, with low hills on the horizon. The ground is flat, pale, layered bedrock broken into slabs and shallow steps, with loose sand and small stones in the cracks. Standing on it in the middle of the frame is the Curiosity rover: a boxy body on six wheels, with a tall mast carrying a camera head at the top, various instrument boxes, and a bright patch of disturbed ground beside it. No robotic arm is visible anywhere in the picture, and the rover casts a shadow toward the viewer."}},{"k":"img_solarflare_name","v":{"s":"X-class Solar Flare (SDO, 2014)"}},{"k":"img_solarflare_meta","v":{"s":"the whole Sun in extreme-ultraviolet light with a powerful flare erupting on the left edge (large file — give it a moment)"}},{"k":"img_solarflare_notice","v":{"s":"Zoom into the bright flash on the left edge. Find the straight vertical bar running through it. Compare its edges with the edges of everything else on the Sun, and say how they differ."}},{"k":"img_solarflare_wonder","v":{"s":"Nothing on the Sun is straight-edged, yet that bar is perfectly straight. If it is not part of the Sun, where could it have come from?"}},{"k":"img_solarflare_describe","v":{"s":"The whole disc of the Sun fills the frame against black space, coloured gold and brown in false colour. The surface is a mottled, swirling texture of darker loops and lighter patches, with several bright golden active regions where loops of material arch up. Bright golden haze extends off the edge of the disc all the way round. On the left edge is an intensely bright white flare. Running through that flare is a hard-edged straight vertical white bar, far straighter than anything else in the picture, with a fainter blue horizontal streak crossing it."}},{"k":"img_iss_cupola_name","v":{"s":"Astronaut in the Space Station Cupola"}},{"k":"img_iss_cupola_meta","v":{"s":"a crew member photographs themselves in the Cupola, the Station’s window module for looking down at Earth"}},{"k":"img_iss_cupola_notice","v":{"s":"Zoom into the water through the round window. Trace the boundary where the bright turquoise meets the dark blue. Is it a sharp line or a gradual change, and does it follow a shape?"}},{"k":"img_iss_cupola_wonder","v":{"s":"The turquoise areas are shallow and the dark blue is deep. What could make the sea floor rise and fall in such distinct shapes?"}},{"k":"img_iss_cupola_describe","v":{"s":"Inside a cramped spacecraft module packed with equipment, cables, switch panels and labelled fittings. Filling the left half is a large round window with a thick metal frame, looking straight down at Earth: bands of vivid turquoise shallow water threaded between darker blue deep water, with sandy pale shapes and puffy white clouds scattered over it. On the right, an astronaut floats facing the camera in a black t-shirt, bald, with a pair of glasses pushed up on top of his head, one arm stretched toward the camera because he is holding it himself. A second, darker window and more equipment fill the right edge."}},{"k":"img_apollo_cm_name","v":{"s":"Apollo 11 Command Module \"Columbia\""}},{"k":"img_apollo_cm_meta","v":{"s":"the spacecraft that carried the Apollo 11 crew to the Moon and back, on display in a museum"}},{"k":"img_apollo_cm_notice","v":{"s":"Zoom close onto the outer skin. Some areas are burnt dark and some are pale. Pick one spot where the two meet and describe the pattern there."}},{"k":"img_apollo_cm_wonder","v":{"s":"Only one end of this capsule came back through the air, and it was travelling extremely fast. Looking at where the burning is worst, which way round was it facing?"}},{"k":"img_apollo_cm_describe","v":{"s":"A cone-shaped spacecraft about the size of a small car, displayed on a stand in a darkened museum gallery. Its outer skin is scorched and mottled in coppery browns, greys and streaks of soot, uneven and patchy rather than smooth, with visible seams, rivets, small round ports and metal handles. A hatch opening on the right side reveals a glimpse of the crowded interior. Around and behind it the gallery is dark, with a large lit photograph of Earth on the wall at the upper left, a floor-level backlit panel of blue and white cloud swirls below, and a row of small illuminated exhibit captions along the bottom edge."}},{"k":"img_wright_flyer_name","v":{"s":"1903 Wright Flyer"}},{"k":"img_wright_flyer_meta","v":{"s":"the first aeroplane to make a powered, controlled flight, photographed against a black background"}},{"k":"img_wright_flyer_notice","v":{"s":"Zoom into the gap between the two wings and follow one bracing wire from end to end. Count how many wires meet at a single post, then find a post where the count is different."}},{"k":"img_wright_flyer_wonder","v":{"s":"There is no seat and no steering wheel; the pilot lay flat on the lower wing. Looking at how thin and open this machine is, why might lying down have been the sensible choice?"}},{"k":"img_wright_flyer_describe","v":{"s":"A very wide photograph of an early aeroplane on a plain black background, seen from the front left. It has two long fabric-covered wings, one above the other, held apart by many slim upright wooden posts and criss-crossed by thin bracing wires that form repeated X shapes between the posts. The fabric is pale cream and slightly translucent, with the ribs showing through. In the middle of the lower wing is a small engine and a chain drive; behind it stand two tall narrow wooden propellers. A framework of struts reaches forward to a small horizontal surface at the front, and a wooden launching rail lies under the machine. There is no cockpit, seat or wheels: just an open frame and a flat space on the lower wing."}},{"k":"img_snowflake_342_name","v":{"s":"Snowflake No. 342 (Wilson Bentley, c. 1900)"}},{"k":"img_snowflake_342_meta","v":{"s":"a single snow crystal photographed through a microscope by the farmer who pioneered the technique"}},{"k":"img_snowflake_342_notice","v":{"s":"Pick one arm and zoom into its serrated edge. Count the notches along one side. Now do the same on the arm directly opposite and compare the two counts."}},{"k":"img_snowflake_342_wonder","v":{"s":"All six arms grew at the same moment in the same tiny patch of cloud. What would have to be true about that patch for them to come out so alike?"}},{"k":"img_snowflake_342_describe","v":{"s":"A black-and-white photograph of a single snow crystal, pale grey against a black background, on a slightly ragged square of dark material. The crystal has six arms spreading from a central hexagon. Each arm is a broad blade with a serrated, feathery edge and a pointed tip, and the arms are joined near the middle by a ring of hexagonal plates so that the centre looks like a flower with a small dark dot at its heart. The whole crystal is faintly translucent, with the internal ridges visible as fine lines. Around the edges of the picture the film is scratched and marked, and handwritten numbers appear reversed in the lower left corner."}},{"k":"img_snowflake_1205_name","v":{"s":"Stellar Snowflake No. 1205 (Wilson Bentley)"}},{"k":"img_snowflake_1205_meta","v":{"s":"a plate-shaped snow crystal with hexagons nested inside hexagons"}},{"k":"img_snowflake_1205_notice","v":{"s":"Zoom right into the centre and count how many complete six-sided outlines you can find nested inside one another before the detail runs out."}},{"k":"img_snowflake_1205_wonder","v":{"s":"Every corner here turns by the same amount, and the shape repeats at bigger and smaller sizes. What single rule about how the water joined up could produce all of that?"}},{"k":"img_snowflake_1205_describe","v":{"s":"A black-and-white photograph of a single snow crystal, pale grey on a black circular background mounted on a white card. The crystal is a broad six-sided plate. At its centre is a small hexagon, surrounded by a larger hexagon, surrounded by a larger one again, each outlined by a fine ridge. From each of the six corners a short arm extends, ending in a smaller six-sided plate of its own, and each of those carries fainter internal markings. The outline is made of straight segments meeting at blunt corners rather than curves."}},{"k":"img_fan_coral_name","v":{"s":"Fan Coral Specimen (glass-plate photograph)"}},{"k":"img_fan_coral_meta","v":{"s":"a museum sea-fan coral photographed on a glass plate about a century ago"}},{"k":"img_fan_coral_notice","v":{"s":"Zoom into one place where a branch splits in two, then follow one of those halves until it splits again. Describe how the two splits compare in size and angle."}},{"k":"img_fan_coral_wonder","v":{"s":"Trees, rivers and the airways in your lungs all branch in a similar way. What job might branching do well that a single thick stem could not?"}},{"k":"img_fan_coral_describe","v":{"s":"A tall black-and-white photograph of a dried sea-fan coral standing upright on a small wooden block against a plain grey studio background. The coral is pale, almost white, and shaped like a broad rounded fan. From a single thick stem at the bottom it divides into branches, and each branch divides again and again into finer and finer twigs, which cross and fuse with their neighbours to make a dense net of small irregular holes. The mesh is fine and even near the centre and becomes more open and feathery around the outer edge. The number 3917 is scratched into the plate at the upper left, and there are dark marks and blemishes down the right edge."}},{"k":"img_chicago_1892_name","v":{"s":"Bird’s-Eye View of Chicago, 1892"}},{"k":"img_chicago_1892_meta","v":{"s":"a hand-drawn aerial view of a whole city, printed in 1892, with every building drawn individually"}},{"k":"img_chicago_1892_notice","v":{"s":"Zoom deep into any one block away from the lake. Every building on it was drawn by hand. Pick one block and describe the buildings on it: how tall, how tightly packed, what shapes their roofs are."}},{"k":"img_chicago_1892_wonder","v":{"s":"Near the right edge there is a small inset picture of the same city thirty-five years earlier, and it is almost empty. Why might the mapmaker have chosen to put the old view on the new map?"}},{"k":"img_chicago_1892_describe","v":{"s":"A very large hand-drawn aerial view of a city, printed in brown and black ink on tan paper, looking across the city from high above. Lake Michigan fills the lower right corner, pale and open, dotted with sailing ships and steamers trailing smoke. The rest of the sheet is packed with a street grid running away to a hazy horizon at the top, and within the grid many thousands of individual buildings are drawn in tiny detail, becoming smaller and denser toward the top. A river and rail lines cut diagonally through the blocks, and a pier reaches into the lake near the middle of the shoreline. A small oval inset at the right shows a much emptier \"View of Chicago in 1857\". A numbered key runs along the bottom edge above the title \"Bird’s Eye View of Chicago, 1892\"."}}],"id":604}},{"k":"circuitShelf","v":{"o":[{"k":"popup_blocked","v":{"s":"The Circuit Shelf window was blocked. Allow pop-ups for this page, then try again."}},{"k":"opened_sr","v":{"s":"Opened the Circuit Shelf in a new window."}},{"k":"returned_sr","v":{"s":"Returned to Circuit Builder."}},{"k":"returned_catalog_sr","v":{"s":"Returned to the STEAM Lab tools."}},{"k":"back_to_builder","v":{"s":"Back to Circuit Builder"}},{"k":"back_to_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"title","v":{"s":"🔌 Circuit Shelf — predict first, then wire it up"}},{"k":"blurb","v":{"s":"Build working electronic circuits in CircuitJS — Paul Falstad’s open-source simulator, used in classrooms worldwide — with a set of Predict → Explore → Explain challenges: series vs. parallel bulbs, Ohm’s law, RC charging, voltage dividers, logic gates and more. You lock in a guess BEFORE you wire anything; afterwards the coach compares your prediction with what the meters actually read and asks one good question."}},{"k":"note1","v":{"s":"Predictions and explanations stay in the lab window — nothing is saved or graded."}},{"k":"ai_on","v":{"s":"AI coach is ON — it will compare your prediction with your observations while this window stays open."}},{"k":"ai_off","v":{"s":"AI hints are off — the shelf still works, with built-in reflection prompts instead of the AI coach."}},{"k":"open_title","v":{"s":"Open the Circuit Shelf in a new window (CircuitJS simulator with the Predict-Explore-Explain coach)"}},{"k":"open","v":{"s":"🔌 Open Circuit Shelf"}},{"k":"opening_note","v":{"s":"Opening Circuit Shelf. If it does not appear, check your pop-up settings."}},{"k":"blocked_note","v":{"s":"Pop-up blocked — allow pop-ups for this page and try again."}},{"k":"open_note","v":{"s":"Circuit Shelf is open. Keep this AlloFlow window open too — it powers the AI coach."}},{"k":"closed_note","v":{"s":"Circuit Shelf was closed. You can reopen it whenever you are ready."}},{"k":"credit","v":{"s":"Circuit simulator: CircuitJS1 by Paul Falstad and Iain Sharp (github.com/pfalstad/circuitjs1), free and open source under the GPL. The simulator loads from its host, so the shelf needs internet; offline use for School Box is on the roadmap (the GPL permits it)."}}],"id":605}},{"k":"moleculeShelf","v":{"o":[{"k":"popup_blocked","v":{"s":"The Molecule Shelf window was blocked. Allow pop-ups for this page, then try again."}},{"k":"opened_sr","v":{"s":"Opened the Molecule Shelf in a new window."}},{"k":"returned_sr","v":{"s":"Returned to Molecule Lab."}},{"k":"returned_catalog_sr","v":{"s":"Returned to the STEAM Lab tools."}},{"k":"back_to_lab","v":{"s":"Back to Molecule Lab"}},{"k":"back_to_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"title","v":{"s":"🧬 Molecule Shelf — real 3D structures, up close"}},{"k":"blurb","v":{"s":"Open real molecular structures in Mol* — the same viewer scientists use at the Protein Data Bank — and rotate, zoom, and re-color them in 3D: crambin, the DNA double helix, hemoglobin, an enzyme, an antibody, and the coronavirus spike. A Notice → Wonder coach sits beside the viewer: you record what you see and what it makes you curious about, and the coach asks a question back."}},{"k":"note1","v":{"s":"Your notes stay in the lab window — nothing is saved or graded."}},{"k":"ai_on","v":{"s":"AI coach is ON — it will build on what you notice while this window stays open."}},{"k":"ai_off","v":{"s":"AI hints are off — the shelf still works, with built-in observation prompts instead of the AI coach."}},{"k":"open_title","v":{"s":"Open the Molecule Shelf in a new window (Mol* viewer with the Notice-Wonder coach)"}},{"k":"open","v":{"s":"🧬 Open Molecule Shelf"}},{"k":"opening_note","v":{"s":"Opening Molecule Shelf. If it does not appear, check your pop-up settings."}},{"k":"blocked_note","v":{"s":"Pop-up blocked — allow pop-ups for this page and try again."}},{"k":"open_note","v":{"s":"Molecule Shelf is open. Keep this AlloFlow window open too — it powers the AI coach."}},{"k":"closed_note","v":{"s":"Molecule Shelf was closed. You can reopen it whenever you are ready."}},{"k":"credit","v":{"s":"Molecular viewer: Mol* (molstar.org), free and open source under the MIT license — the viewer used by the RCSB Protein Data Bank and PDBe. Structures are fetched from the PDB by ID. The viewer and structures load from the web, so the shelf needs internet."}}],"id":606}},{"k":"timeline","v":{"o":[{"k":"popup_blocked","v":{"s":"The Timeline window was blocked. Allow pop-ups for this page, then try again."}},{"k":"opened_sr","v":{"s":"Opened Timeline Studio in a new window."}},{"k":"thinking","v":{"s":"✨ Reading the text and finding dated events…"}},{"k":"needtext","v":{"s":"Paste at least a short paragraph of text with some dates in it."}},{"k":"noevents","v":{"s":"No clear dated events were found in that text. Try a passage with years or dates."}},{"k":"needsai","v":{"s":"AI hints are off, so opening the manual timeline builder instead — add events by hand."}},{"k":"blocked","v":{"s":"Pop-up blocked — allow pop-ups for this page and try again."}},{"k":"ready","v":{"s":"Timeline is open in a new window. Keep this window open to send it new timelines."}},{"k":"error","v":{"s":"Something went wrong generating the timeline: "}},{"k":"title","v":{"s":"🕰️ Timeline Studio — turn a reading into a timeline"}},{"k":"blurb","v":{"s":"Paste a reading — a history handout, a biography, the story of a scientific discovery — and the AI finds the dated events and lays them out as an interactive timeline you can scroll and step through. Great for turning dense text into a clear sequence."}},{"k":"source_label","v":{"s":"Paste the text to turn into a timeline"}},{"k":"placeholder","v":{"s":"Paste a passage with dates — e.g. a chapter on the Space Race, a scientist’s biography, the events of a novel…"}},{"k":"reading_level","v":{"s":"Reading level"}},{"k":"lvl_early","v":{"s":"Early elementary"}},{"k":"lvl_upper","v":{"s":"Upper elementary"}},{"k":"lvl_middle","v":{"s":"Middle school"}},{"k":"lvl_high","v":{"s":"High school"}},{"k":"generate_title","v":{"s":"Generate an interactive timeline from the pasted text"}},{"k":"generating","v":{"s":"✨ Building…"}},{"k":"generate","v":{"s":"✨ Build the timeline"}},{"k":"build_title","v":{"s":"Open the timeline window to build one by hand"}},{"k":"build","v":{"s":"✍️ Build by hand"}},{"k":"ai_on","v":{"s":"AI is ON — it reads your text and pulls out the dated events."}},{"k":"ai_off","v":{"s":"AI hints are off — use “Build by hand” to add events yourself in the timeline window."}},{"k":"privacy","v":{"s":"Your text and the timeline stay in memory — nothing is saved or graded."}},{"k":"credit","v":{"s":"Timeline rendering: TimelineJS by Northwestern University Knight Lab (timeline.knightlab.com), free and open source under the Mozilla Public License. The timeline library loads from Knight Lab’s CDN, so this tool needs internet."}}],"id":607}},{"k":"freeforms","v":{"o":[{"k":"sr_undone","v":{"s":"Undone"}},{"k":"sr_imported","v":{"s":"Organizer imported — now make it yours"}},{"k":"sr_form_chosen","v":{"s":"Form chosen"}},{"k":"new_group","v":{"s":"New group"}},{"k":"sr_idea_added","v":{"s":"Idea added"}},{"k":"sr_reset","v":{"s":"Arrangement reset to the form’s shape"}},{"k":"sculpt_engine_failed","v":{"s":"The sculpting engine could not load."}},{"k":"sculpt_failed","v":{"s":"Sculpting failed — try a simpler description."}},{"k":"sr_sculpted","v":{"s":"Sculpture placed"}},{"k":"sr_art_cleared","v":{"s":"Sculpture removed"}},{"k":"assess_failed","v":{"s":"The coach could not respond — try again."}},{"k":"sr_assessed","v":{"s":"Coaching feedback is ready below the builder panel"}},{"k":"recall_needs_more","v":{"s":"Add at least 4 ideas across 2 groups first"}},{"k":"sr_recall_started","v":{"s":"Recall mode: every idea fell into the tray. Put each one back where it belongs."}},{"k":"sr_recall_score","v":{"s":"Checked:"}},{"k":"sr_recall_complete","v":{"s":"You rebuilt your whole world from memory!"}},{"k":"sr_recall_exited","v":{"s":"Back to building."}},{"k":"sr_hint","v":{"s":"Hint:"}},{"k":"snapshot_failed","v":{"s":"Could not capture the 3D view here."}},{"k":"snapshot_saved","v":{"s":"Snapshot saved"}},{"k":"print_saved","v":{"s":"One-pager downloaded — open it and print"}},{"k":"print_failed","v":{"s":"Could not build the one-pager."}},{"k":"import_prompt","v":{"s":"Import the organizer"}},{"k":"import_replaces","v":{"s":"This replaces your current composition."}},{"k":"import_yes","v":{"s":"Import"}},{"k":"import_no","v":{"s":"Keep mine"}},{"k":"title","v":{"s":"Free Forms"}},{"k":"tagline","v":{"s":"Build your own World of Forms: pick an archetypal structure, fill it with YOUR ideas, arrange it in 3D, and sculpt what matters."}},{"k":"tagline2","v":{"s":"You are the author here — the AI only coaches, and only when you ask."}},{"k":"keep_content_hint","v":{"s":"Your groups and ideas stay — choosing a form just changes the shape of the space."}},{"k":"change_form","v":{"s":"Change form"}},{"k":"forms","v":{"s":"Forms"}},{"k":"recall_title","v":{"s":"Recall: rebuild your world"}},{"k":"groups","v":{"s":"groups"}},{"k":"ideas","v":{"s":"ideas"}},{"k":"sculpted","v":{"s":"sculpted"}},{"k":"undo_tip","v":{"s":"Undo the last change (Ctrl+Z)"}},{"k":"undo","v":{"s":"Undo"}},{"k":"snapshot_tip","v":{"s":"Save a picture of your 3D world"}},{"k":"snapshot","v":{"s":"Snapshot"}},{"k":"print_tip","v":{"s":"Download a printable one-pager (snapshot + your ideas + coach feedback)"}},{"k":"print","v":{"s":"One-pager"}},{"k":"reset_arrangement","v":{"s":"Reset arrangement"}},{"k":"recall_tip","v":{"s":"Your ideas fall into a tray — put them back from memory"}},{"k":"recall","v":{"s":"Test yourself"}},{"k":"assess_needs_items","v":{"s":"Add at least 3 ideas first"}},{"k":"assess_tip","v":{"s":"Ask the AI coach to look at your whole composition"}},{"k":"assess","v":{"s":"Assess my composition"}},{"k":"recall_heading","v":{"s":"Rebuild it from memory"}},{"k":"recall_instructions","v":{"s":"Every idea fell out of its place into the tray at the bottom. Select an idea in the space, then use the group chips (or the [ and ] keys) to send it home. Nothing is saved during the game."}},{"k":"recall_placed","v":{"s":"placed"}},{"k":"recall_correct","v":{"s":"correct"}},{"k":"recall_complete","v":{"s":"you rebuilt your whole world!"}},{"k":"recall_check","v":{"s":"Check"}},{"k":"recall_retry","v":{"s":"Retry"}},{"k":"recall_exit","v":{"s":"Exit"}},{"k":"recall_hint","v":{"s":"Hint for the selected idea"}},{"k":"recall_history","v":{"s":"Recall history"}},{"k":"recall_still_learning","v":{"s":"still learning:"}},{"k":"composition_title","v":{"s":"Composition title"}},{"k":"title_placeholder","v":{"s":"What is this world about?"}},{"k":"group_name","v":{"s":"Group name"}},{"k":"delete_group","v":{"s":"Delete group"}},{"k":"selected","v":{"s":"Selected"}},{"k":"select_idea","v":{"s":"Select idea"}},{"k":"idea_text","v":{"s":"Idea text"}},{"k":"delete_idea","v":{"s":"Delete idea"}},{"k":"add_idea_placeholder","v":{"s":"Add an idea…"}},{"k":"add_idea_to","v":{"s":"Add an idea to"}},{"k":"add_group","v":{"s":"Add a group"}},{"k":"note_label","v":{"s":"Note to self (shows in 3D)"}},{"k":"note_placeholder","v":{"s":"Why does this idea live here?"}},{"k":"studio_loading","v":{"s":"Loading the shape studio…"}},{"k":"studio_label","v":{"s":"Shape studio"}},{"k":"studio_presets","v":{"s":"Preset shapes"}},{"k":"studio_place_preset","v":{"s":"Place preset"}},{"k":"studio_add_part","v":{"s":"Add a part"}},{"k":"studio_add","v":{"s":"Add"}},{"k":"studio_parts","v":{"s":"Parts"}},{"k":"studio_part","v":{"s":"Part"}},{"k":"studio_move","v":{"s":"Move the selected part"}},{"k":"studio_left","v":{"s":"Left"}},{"k":"studio_right","v":{"s":"Right"}},{"k":"studio_up","v":{"s":"Up"}},{"k":"studio_down","v":{"s":"Down"}},{"k":"studio_closer","v":{"s":"Closer"}},{"k":"studio_farther","v":{"s":"Farther"}},{"k":"studio_shape_tools","v":{"s":"Shape tools"}},{"k":"studio_bigger","v":{"s":"Bigger"}},{"k":"studio_smaller","v":{"s":"Smaller"}},{"k":"studio_spin","v":{"s":"Spin"}},{"k":"studio_recolor","v":{"s":"Change color"}},{"k":"studio_duplicate","v":{"s":"Duplicate"}},{"k":"studio_remove_part","v":{"s":"Remove part"}},{"k":"sculpt_label","v":{"s":"Or describe it…"}},{"k":"sculpt","v":{"s":"Sculpt"}},{"k":"clear_art","v":{"s":"Remove sculpture"}},{"k":"loading_3d","v":{"s":"Loading the 3D space…"}},{"k":"no_3d","v":{"s":"The 3D space could not load here — your builder panel still works, and everything you write is saved."}},{"k":"stage_hint","v":{"s":"In the space: drag an idea to place it · drag the background to orbit · scroll to zoom · [ and ] move a selected idea between groups."}},{"k":"coach_heading","v":{"s":"Coaching feedback"}},{"k":"strengths","v":{"s":"What is working"}},{"k":"questions","v":{"s":"Questions to consider"}},{"k":"suggestions","v":{"s":"Next build steps"}}],"id":608}},{"k":"spacestation","v":{"o":[{"k":"a11y_spacewalk_route_astronaut_at_tether_a_at_tether","v":{"s":"Spacewalk route. Astronaut at {value1}. Tether A at {value2}. Tether B at {value3}. Suit consumables {value4} percent. Projected at worksite {value5} percent. {value6}. {value7}."}},{"k":"a11y_eva_mission_phase_step_of_4","v":{"s":"EVA mission phase {value1}. Step {value2} of 4."}},{"k":"a11y_thrust_press_and_hold_with_space_or_enter","v":{"s":"Thrust {value1}. Press and hold with Space or Enter."}},{"k":"a11y_microgravity_crew_challenges_of_complete","v":{"s":"Microgravity crew challenges. {value1} of {value2} complete."}},{"k":"a11y_inspect_details_in","v":{"s":"Inspect details in {value1}"}},{"k":"a11y_interior_view_of","v":{"s":"Interior view of {value1}. {value2}"}},{"k":"a11y_microgravity_translation_preview_push_impulse_n","v":{"s":"Microgravity translation preview. Push impulse {value1} newton seconds gives a constant coast speed of {value2} meters per second, travel time {value3} seconds, predicted arrival {value4}."}},{"k":"a11y_crew_notebook_observation_for","v":{"s":"Crew notebook observation for {value1}"}},{"k":"a11y_current_station_location_connected_route_harmon","v":{"s":"Current station location: {value1}. Connected route: Harmony to Destiny to Unity, port turn into Tranquility, then nadir descent into Cupola."}},{"k":"a11y_control_moment_gyroscope_cluster_projected_satu","v":{"s":"Control Moment Gyroscope cluster, projected saturation {value1} percent."}},{"k":"a11y_station_health_percent","v":{"s":"Station health {value1} percent"}},{"k":"a11y_twenty_four_hour_gmt_crew_timeline_selected_eve","v":{"s":"Twenty-four hour GMT crew timeline. Selected event {value1} at {value2}. Daily allocation: 8.5 hours sleep, 1.5 