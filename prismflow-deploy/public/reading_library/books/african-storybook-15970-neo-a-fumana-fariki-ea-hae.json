    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/15916.png",
      "text": "Neo a palamisa fariki ea hae baesekele.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=1",
      "sourceDigest": "sha256:c38690cea25cb5a3c331f930bb9ae44eef986676becfdb03ba0c53b1d4033baf"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/15917.png",
      "text": "A chaise lejoe tseleng ka baesekele. Fariki ea oela fatše. Ea lla, eare, \"Hooeeeee! Hooeeeee!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=2",
      "sourceDigest": "sha256:d6bf69e52af0037f6a01a49c2a94bad9d205b1c5297367cc09bd4f2a1e1ad10e"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/15918.png",
      "text": "Tsotang a e thola. A re, \"Haai, fariki ee ebe kea mang?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=3",
      "sourceDigest": "sha256:1151dcad33ca9d10c3cd6b133c7fad8dd1d8b41ee30b1803df303aa8be481875"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/15920.png",
      "text": "Tsotang a e lelekisa a ba a e tšoara.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=4",
      "sourceDigest": "sha256:3889f37bcbac1a864fc790096cd853a1fbf56de4762f60963d358e9249815439"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/15919.png",
      "text": "A isa fariki Moreneng. Morena a re a e hlokomele.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=5",
      "sourceDigest": "sha256:bf205d2324965f86aaf6fc3bf7accf2cd942aa745325068fd71d5a019a36e0b3"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/15921.png",
      "text": "Ha Neo a feta tseleng. Autloa lehonotho la fariki, \"Hmmm, hmmm, hmmm!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=6",
      "sourceDigest": "sha256:81750f70ed605f870dd1a667a0326b8b091fa226139158906614d3661276c75d"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/15923.png",
      "text": "A be a pota. A thaba ha a bona fariki ea hae.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=7",
      "sourceDigest": "sha256:41aa65c7023b2f575c80f9373af0b4f0b2178f452e6cd74041b79f4d8ed5c857"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/15924.png",
      "text": "Neo a re ho fariki ea hae, \"Ha re ee hae. Ha re sa tla palama baesekele hape.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=15970#page=8",
      "sourceDigest": "sha256:97a0600a56cf7d8d0134c8ae4a60d576e1dfcd916792611e3349cc9591ac6e65"
    }
