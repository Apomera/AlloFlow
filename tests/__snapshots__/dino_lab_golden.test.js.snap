<button id="dinotab-records" role="tab" data-tab-group="Explain" title="Explain: Records" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🏆 Records</button>
