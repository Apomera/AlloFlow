<dd style="margin:0;overflow-wrap:anywhere">Cretaceous · Late Cretaceous</dd>
</div>
<div style="margin-bottom:5px">
<dt style="font-weight:800;color:var(--allo-stem-text-soft, #94a3b8)">Diet</dt>
<dd style="margin:0;overflow-wrap:anywhere">Herbivore</dd>
</div>
<div style="margin-bottom:5px">
<dt style="font-weight:800;color:var(--allo-stem-text-soft, #94a3b8)">Group</dt>
<dd style="margin:0;overflow-wrap:anywhere">Ornithischian</dd>
</div>
</dl>
</article>
<article data-dig-candidate="nasutoceratops" style="min-width:0;border-radius:12px;padding:12px;border:2px solid var(--allo-stem-border, #334155);background:var(--allo-stem-panel, #1e293b)">
<button type="button" aria-label="Choose candidate: Nasutoceratops" aria-pressed="false" aria-disabled="false" style="padding:9px 12px;min-height:44px;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:14px;font-weight:700;cursor:pointer;width:100%;text-align:left;margin-bottom:8px">○ Nasutoceratops</button>
<dl style="margin:0;font-size:12px;line-height:1.6">
