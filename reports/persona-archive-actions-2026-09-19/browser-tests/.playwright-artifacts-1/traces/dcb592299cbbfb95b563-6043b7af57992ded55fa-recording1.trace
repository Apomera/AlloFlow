","v":{"s":"Change h, k, or a one at a time. Use the linked graph below to compare position, opening direction, and width."}},{"k":"quadratic_linked_graph","v":{"s":"Graph linked to the inquiry sliders. "}},{"k":"quadratic_graph_window","v":{"s":"Fixed window: −14 to 14 on both axes. Portions outside the window are clipped."}},{"k":"quadratic_constant_reason","v":{"s":"When a = 0, y = k is constant and h has no effect. The horizontal line has no unique vertex."}}],"id":538}},{"k":"inequality","v":{"o":[{"k":"a11y_inequality_reasoning_pathway","v":{"s":"Inequality reasoning pathway"}},{"k":"a11y_2d_inequality_graph","v":{"s":"2D inequality graph"}},{"k":"type_your_answer","v":{"s":"Type your answer..."}},{"k":"badge_first_solve_label","v":{"s":"First Solve"}},{"k":"badge_first_solve_desc","v":{"s":"Answer your first quiz correctly"}},{"k":"badge_on_fire_label","v":{"s":"On Fire"}},{"k":"badge_on_fire_desc","v":{"s":"5 quiz answers in a row"}},{"k":"badge_lightning_label","v":{"s":"Lightning"}},{"k":"badge_lightning_desc","v":{"s":"10 quiz answers in a row"}},{"k":"badge_all_levels_label","v":{"s":"All Levels"}},{"k":"badge_all_levels_desc","v":{"s":"Solve quizzes in Easy, Medium & Hard"}},{"k":"badge_solver_pro_label","v":{"s":"Solver Pro"}},{"k":"badge_solver_pro_desc","v":{"s":"Use the step-by-step solver 5 times"}},{"k":"badge_test_master_label","v":{"s":"Test Master"}},{"k":"badge_test_master_desc","v":{"s":"Test 10 different values"}},{"k":"badge_abs_value_label","v":{"s":"Abs Value"}},{"k":"badge_abs_value_desc","v":{"s":"Graph an absolute value inequality"}},{"k":"badge_compound_label","v":{"s":"Compound"}},{"k":"badge_compound_desc","v":{"s":"Graph a compound inequality"}},{"k":"badge_dual_grapher_label","v":{"s":"Dual Grapher"}},{"k":"badge_dual_grapher_desc","v":{"s":"Use both 1D and 2D graph modes"}},{"k":"badge_quiz_champ_label","v":{"s":"Quiz Champ"}},{"k":"badge_quiz_champ_desc","v":{"s":"Get 20 total quiz answers correct"}},{"k":"coach_tip_open_dot","v