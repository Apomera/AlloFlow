next_step","v":{"s":"Next check or action"}},{"k":"remove","v":{"s":"Remove check {n}"}}],"id":789}},{"k":"preparing","v":{"s":"Preparing Applied Challenge Studio..."}},{"k":"studio_title","v":{"s":"Applied Challenge Studio"}},{"k":"header","v":{"o":[{"k":"title_aria","v":{"s":"Applied challenge title"}},{"k":"instructions_aria","v":{"s":"Applied challenge student instructions"}},{"k":"done_editing","v":{"s":"Done editing"}},{"k":"edit","v":{"s":"Edit challenge"}},{"k":"print","v":{"s":"Print"}},{"k":"auto_match","v":{"s":"Auto Match"}},{"k":"teacher_selected","v":{"s":"Teacher selected"}},{"k":"why_match","v":{"s":"Why this match:"}},{"k":"preview_worksheet","v":{"s":"Preview student worksheet"}},{"k":"teacher_reference","v":{"s":"Teacher reference"}},{"k":"portfolio","v":{"s":"Completed portfolio"}}],"id":790}},{"k":"supports","v":{"o":[{"k":"heading","v":{"s":"Support that fades"}},{"k":"example","v":{"s":"See a parallel reasoning move"}},{"k":"example_note","v":{"s":"Different context - not an answer to this challenge."}},{"k":"notice","v":{"s":"Notice:"}},{"k":"frame","v":{"s":"Build the frame"}},{"k":"coach","v":{"s":"Own the next move"}},{"k":"starter","v":{"s":"Optional question starter"}},{"k":"frameChoices","v":{"s":"Possible directions (one per line)"}},{"k":"coachPrompts","v":{"s":"Thinking prompts (one per line)"}}],"id":791}},{"k":"ledger","v":{"o":[{"k":"heading","v":{"s":"Evidence & decision ledger"}},{"k":"note","v":{"s":"Optional organizer: connect each important claim or option to support, label its certainty honestly, and keep a tradeoff or uncertainty visible."}},{"k":"progress","v":{"s":"{complete} of {total} rows have a claim and written evidence notes · {verified} verified · {needsCheck} need checking · {assumptions} assumptions"}},{"k":"facts_pending","v":{"s":"Lesson facts are awaiting teacher review, so ledger evidence cannot yet make the overall response \"grounded.\""}},{"k":"add_row","v":{"s":"Add evidence row"}},{"k":"empty","v":{"s":"No ledger rows yet. Add one when a claim, option, or assumption becomes important to your decision."}},{"k":"row","v":{"s":"Evidence row {n}"}},{"k":"claim","v":{"s":"Claim, option, or position"}},{"k":"claim_placeholder","v":{"s":"What are you considering or claiming?"}},{"k":"evidence","v":{"s":"Evidence or lesson connection"}},{"k":"evidence_placeholder","v":{"s":"What supports it, or what would you need to verify?"}},{"k":"status","v":{"s":"Evidence status"}},{"k":"tradeoff","v":{"s":"Tradeoff, constraint, or uncertainty"}},{"k":"tradeoff_placeholder","v":{"s":"What might this miss, cost, risk, or leave unresolved?"}},{"k":"remove_row","v":{"s":"Remove evidence row {n}"}},{"k":"link_fact","v":{"s":"Link a lesson fact"}},{"k":"link_fact_aria","v":{"s":"Evidence row {n} source fact"}},{"k":"no_link","v":{"s":"No source fact linked"}},{"k":"removed_fact","v":{"s":"This source fact changed or was removed. Choose a current fact."}},{"k":"limit","v":{"s":"You have 12 evidence rows. Edit an existing row or remove one before adding another."}},{"k":"connect_aria","v":{"s":"Connect lesson fact {n} to my evidence"}},{"k":"connect","v":{"s":"Connect to my evidence"}},{"k":"pick","v":{"s":"Connect a lesson idea"}},{"k":"pick_note","v":{"s":"Choose an idea to link, then explain how it supports or challenges an option. Choosing a fact does not write your reasoning for you."}}],"id":792}},{"k":"stress","v":{"o":[{"k":"heading","v":{"s":"Pressure-test the draft"}},{"k":"note","v":{"s":"Ask for one targeted challenge focused on {focus}. The AI identifies a pressure point but does not write the revision."}},{"k":"busy","v":{"s":"Testing one pressure point..."}},{"k":"refresh","v":{"s":"Refresh stress test"}},{"k":"request","v":{"s":"Stress-test my draft"}},{"k":"one_challenge","v":{"s":"One challenge to investigate"}},{"k":"saved","v":{"s":"Saved pressure test"}},{"k":"outdated","v":{"s":"Created for an earlier draft"}},{"k":"current","v":{"s":"Current draft"}},{"k":"outdated_note","v":{"s":"Your draft changed after this test was created. Save it in a check if you want to preserve how you responded before refreshing it."}},{"k":"point","v":{"s":"Pressure point"}},{"k":"why","v":{"s":"Why it matters"}},{"k":"question","v":{"s":"Question for your revision"}},{"k":"use_in_check","v":{"s":"Use this pressure point in a check"}},{"k":"use_note","v":{"s":"You can use, adapt, or decline it, and explain why."}},{"k":"empty","v":{"s":"Add a working question and draft response, then request one challenge when you are ready to test your reasoning."}}],"id":793}},{"k":"validation","v":{"o":[{"k":"heading","v":{"s":"Test, observe, decide"}},{"k":"note","v":{"s":"Keep an optional trail of checks. Plan what could change your mind, report only what actually happened, then make a student-owned decision."}},{"k":"progress","v":{"s":"{complete} of {total} checks complete"}},{"k":"start","v":{"s":"Start my own check"}},{"k":"empty","v":{"s":"No checks saved yet. You can test the draft without AI, or bring the current pressure point into a check."}},{"k":"footer","v":{"s":"Plans, predictions, observations, and decisions stay visibly separate. Refreshing AI support never removes a saved check."}}],"id":794}},{"k":"synthesis","v":{"o":[{"k":"heading","v":{"s":"Synthesize what you learned"}},{"k":"note","v":{"s":"Use the checks above to explain testing, revision, and transfer in your own words."}}],"id":795}},{"k":"feedback","v":{"o":[{"k":"busy","v":{"s":"Reviewing your reasoning..."}},{"k":"request","v":{"s":"Get strengths-first AI feedback"}},{"k":"note","v":{"s":"Feedback is saved separately and never rewrites the workspace."}},{"k":"aria","v":{"s":"AI feedback"}},{"k":"heading","v":{"s":"Feedback for your next revision"}},{"k":"strength","v":{"s":"A strength"}},{"k":"lesson","v":{"s":"Lesson connection"}},{"k":"evidence","v":{"s":"Evidence, assumptions, or constraints"}},{"k":"next_step","v":{"s":"One next step"}},{"k":"question","v":{"s":"Think about"}},{"k":