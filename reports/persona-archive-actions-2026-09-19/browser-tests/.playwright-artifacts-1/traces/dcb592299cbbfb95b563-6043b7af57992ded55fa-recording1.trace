lues"}},{"k":"a11y_csv_paste_for_two_columns","v":{"s":"CSV paste for two columns"}},{"k":"a11y_single_column_values","v":{"s":"Single column values"}},{"k":"a11y_hypothesized_population_mean","v":{"s":"Hypothesized population mean"}},{"k":"a11y_contingency_table_editor","v":{"s":"Contingency table editor"}},{"k":"a11y_add_column","v":{"s":"Add column"}},{"k":"a11y_add_row","v":{"s":"Add row"}},{"k":"a11y_of_predictors","v":{"s":"# of predictors"}},{"k":"a11y_outcome_variable_label","v":{"s":"Outcome variable label"}},{"k":"a11y_multiple_regression_data_editor","v":{"s":"Multiple regression data editor"}},{"k":"a11y_assumption_check_warnings","v":{"s":"Assumption check warnings"}},{"k":"a11y_ap_statistics_concept_mastery","v":{"s":"AP statistics concept mastery"}},{"k":"a11y_multiple_regression_coefficients","v":{"s":"Multiple regression coefficients"}},{"k":"a11y_glossary_of_statistical_terms","v":{"s":"Glossary of statistical terms"}},{"k":"a11y_subsample_stability_table","v":{"s":"Subsample stability table"}},{"k":"a11y_cohen_s_d_slider","v":{"s":"Cohen's d slider"}},{"k":"a11y_sample_size_slider","v":{"s":"Sample size slider"}},{"k":"a11y_alpha_slider","v":{"s":"Alpha slider"}},{"k":"a11y_interaction_plot_of_cell_means_across_factor_le","v":{"s":"Interaction plot of cell means across factor levels"}},{"k":"group_1","v":{"s":"Group 1"}},{"k":"group_2","v":{"s":"Group 2"}},{"k":"statistics_lab","v":{"s":"Statistics Lab"}},{"k":"inferential_stats_with_ap_psych_ap_bio","v":{"s":"Inferential stats with AP Psych / AP Bio focus. Transparent. Scaffolded. Better than SPSS for learning."}},{"k":"statistics_lab_navigation","v":{"s":"Statistics Lab navigation"}},{"k":"home","v":{"s":"🏠 Home"}},{"k":"sample_datasets_about","v":{"s":"Sample datasets + about"}},{"k":"wizard","v":{"s":"🧙 Wizard"}},{"k":"pick_the_right_test","v":{"s":"Pick the right test"}},{"k":"data","v":{"s":"📋 Data"}},{"k":"enter_paste_data","v":{"s":"Enter / paste data"}},{"k":"test","v":{"s":"⚖️ Test"}},{"k":"choose_run_a_test","v":{"s":"Choose + run a test"}},{"k":"results","v":{"s":"📈 Results"}},{"k":"view_results_ai_grade","v":{"s":"View results + AI grade"}},{"k":"power","v":{"s":"🔋 Power"}},{"k":"sample_size_calc","v":{"s":"Sample size calc"}},{"k":"mastery","v":{"s":"🏅 Mastery"}},{"k":"ap_quiz_concept_progress","v":{"s":"AP-quiz concept progress"}},{"k":"inquiry","v":{"s":"🔬 Inquiry"}},{"k":"power_effect_alpha_sandbox","v":{"s":"Power × effect × alpha sandbox"}},{"k":"sample_datasets_tool_overview","v":{"s":"Sample datasets + tool overview"}},{"k":"eight_pre_loaded_datasets_cover_ap_psy","v":{"s":"Eight pre-loaded datasets cover AP Psych and AP Bio canonical examples — load one to skip data entry."}},{"k":"pick_the_right_test_for_your_data","v":{"s":"Pick the right test for your data"}},{"k":"answer_4_questions_about_your_variable","v":{"s":"Answer 4 questions about your variables. The wizard maps to t-test, ANOVA, chi-square, regression, or non-parametric."}},{"k":"enter_or_paste_your_data","v":{"s":"Enter or paste your data"}},{"k":"paste_from_sheets_excel_or_type_by_han","v":{"s":"Paste from Sheets/Excel, or type by hand. The lab auto-detects two-group vs. paired vs. categorical layouts."}},{"k":"run_the_test_with_full_transparency","v":{"s":"Run the test with full transparency"}},{"k":"every_formula_and_intermediate_step_is","v":{"s":"Every formula and intermediate step is shown — no SPSS black box. You see what the test actually computes."}},{"k":"interpret_ai_graded_write_up","v":{"s":"Interpret + AI-graded write-up"}},{"k":"effect_size_context_cohen_band_labels_","v":{"s":"Effect-size context + Cohen-band labels. AI grades your interpretation against AP-rubric criteria."}},{"k":"sample_size_power_calculator","v":{"s":"Sample-size + power calculator"}},{"k":"how_many_subjects_do_you_need_to_detec","v":{"s":"How many subjects do you need to detect a real effect? Underpowered studies are why most psych findings fail to replicate."}},{"k":"concept_mastery_tracker","v":{"s":"Concept mastery tracker"}},{"k":"track_your_progress_through_ap_style_q","v":{"s":"Track your progress through AP-style quiz concepts."}},{"k":"inquiry_sandbox_power_effect_alpha","v":{"s":"Inquiry sandbox — power × effect × alpha"}},{"k":"move_three_sliders_predict_where_a_stu","v":{"s":"Move three sliders. Predict where a study moves from underpowered to well-powered to wasteful. No score, no reveal — you mark your own understanding."}},{"k":"futile","v":{"s":"Futile"}},{"k":"power_30_most_replications_will_miss_t","v":{"s":"Power < 30% — most replications will miss the effect even if it is real."}},{"k":"underpowered","v":{"s":"Underpowered"}},{"k":"power_30_60_coin_flip_like_ability_to_","v":{"s":"Power 30–60% — coin-flip-like ability to detect a true effect. Common in psych replications."}},{"k":"borderline","v":{"s":"Borderline"}},{"k":"power_60_80_typical_funded_study_but_c","v":{"s":"Power 60–80% — typical funded study, but Cohen recommended ≥80%."}},{"k":"power_80_95_sound_design_effect_if_rea","v":{"s":"Power 80–95% — sound design. Effect, if real, will likely be detected."}},{"k":"overkill","v":{"s":"Overkill"}},{"k":"power_95_diminishing_returns_consider_","v":{"s":"Power > 95% — diminishing returns; consider tightening alpha or splitting cohort."}},{"k":"inquiry_sandbox_power_effect_alpha_2","v":{"s":"🔬 Inquiry Sandbox — Power, Effect, Alpha"}},{"k":"set_true_effect_size_alpha_and_per_gro","v":{"s":"Set true effect size, alpha, and per-group sample size. Predict where the design moves between futile, underpowered, well-powered, and overkill. No score, no reveal."}},{"k":"power_80","v":{"s":"power = 80%"}},{"k":"true_effect_cohen_d","v":{"s":"True effect (Cohen d)"}},{"k":"alpha","v":{"s":"Alpha"}},{"k":"n_per_group","v":{"s":"n per group"}},{"k":"log_this_design","v":{"s":"📋 Log this design"}},{"k":"reset","v":{"s":"Reset"}},{"k":"your_hypothesis_which_slider_has_the_b","v":{"s":"Your hypothesis (which slider has the biggest leverage in your range?)"}},{"k":"e_g_halving_alpha_needs_almost_double_","v":{"s":"e.g., halving alpha needs almost double n to recover the same power..."}},{"k":"i_m_stuck_show_open_questions","v":{"s":"🤔 I'm stuck — show open questions"}},{"k":"open_questions_no_answer_key","v":{"s":"Open questions (no answer key)"}},{"k":"if_your_effect_is_d_0_2_small_what_n_p","v":{"s":"If your effect is d=0.2 (small), what n per group do you need for 80% power at α=.05?"}},{"k":"a_study_with_n_20_per_group_and_d_0_5_","v":{"s":"A study with n=20 per group and d=0.5 — what is its replication probability?"}},{"k":"when_does_it_make_sense_to_lower_power","v":{"s":"When does it make sense to *lower* power on purpose (e.g., pilot, screening)?"}},{"k":"how_does_tightening_e_g_for_multiple_c","v":{"s":"How does tightening α (e.g., for multiple comparisons) trade off against n?"}},{"k":"i_can_explain_why_this_d_n_combination","v":{"s":"I can explain why this d × α × n combination yields this power state."}},{"k":"explain_in_your_own_words","v":{"s":"Explain in your own words..."}},{"k":"inquiry_widget_no_score_no_reveal_no_a","v":{"s":"Inquiry widget — no score, no reveal, no answer dump. Power approximated via normal-z; for small n, true power from non-central t will differ slightly (use the Power tab for the formal calc)."}},{"k":"concept_locked_in","v":{"s":"Concept locked in"}},{"k":"hypothesis_input","v":{"s":"Power-design hypothesis"}},{"k":"explanation_input","v":{"s":"Power-state explanation"}},{"k":"dist_img","v":{"s":"Sampling distribution chart"}},{"k":"alpha_hint","v":{"s":"At fixed effect and n, a smaller alpha lowers Type I error but also lowers power."}},{"k":"assumed_effect_size","v":{"s":"Assumed effect size"}},{"k":"clear_evidence","v":{"s":"Clear evidence"}},{"k":"clear_evidence_a11y","v":{"s":"Clear power evidence log and explanation"}},{"k":"common_planning_reference","v":{"s":"80% planning reference"}},{"k":"design_already_logged","v":{"s":"Design already logged"}},{"k":"design_logged_a11y","v":{"s":"Current power design already logged"}},{"k":"distinct_designs","v":{"s":"distinct designs"}},{"k":"effect_hint","v":{"s":"Larger assumed effects are easier to detect at fixed alpha and n."}},{"k":"evidence_explanation_input","v":{"s":"Power-model evidence explanation"}},{"k":"evidence_explanation_label","v":{"s":"Evidence-based explanation from your logged designs"}},{"k":"evidence_explanation_placeholder","v":{"s":"What changed, what stayed fixed, and how did approximate power respond? Cite both logged designs."}},{"k":"evidence_log","v":{"s":"Evidence log"}},{"k":"explanation_locked","v":{"s":"Log two distinct designs before writing the explanation."}},{"k":"explanation_ready","v":{"s":"Use the log to identify the one control you changed and the direction of the modeled response."}},{"k":"fair_test_duplicate","v":{"s":"Fair-test check: the last two logs use the same design; change one control for the next log."}},{"k":"fair_test_multiple","v":{"s":"Fair-test check: several controls changed. That comparison cannot isolate one control; change only one next."}},{"k":"fair_test_needs_two","v":{"s":"Fair-test check: log two different designs to compare them."}},{"k":"fair_test_one_variable","v":{"s":"Fair-test check: one control changed"}},{"k":"hide_investigation_prompts","v":{"s":"Hide investigation prompts"}},{"k":"inquiry_collect_next","v":{"s":"Collect two distinct designs. Completion depends on logging and explaining, not matching a hidden answer."}},{"k":"inquiry_complete","v":{"s":"Evidence explanation recorded. Investigation complete; no answer is scored for agreement."}},{"k":"inquiry_explain_next","v":{"s":"Evidence collected. Explain the comparison to complete the investigation."}},{"k":"inquiry_power_curve_a11y","v":{"s":"Approximate two-sided power curve across per-group sample sizes"}},{"k":"inquiry_widget_live_evidence","v":{"s":"Inquiry widget · live evidence"}},{"k":"investigation_prompts_no_key","v":{"s":"Investigation prompts — no answer key"}},{"k":"live_evidence_instructions","v":{"s":"Approximate power is visible and updates live, so this is an observe–log–explain investigation, not a prediction quiz. Change one control at a time, log two different designs, then explain the evidence."}},{"k":"log_design_a11y","v":{"s":"Log current power design as evidence"}},{"k":"log_hint","v":{"s":"For a fair comparison, keep two controls fixed and change one."}},{"k":"logged_power_designs","v":{"s":"Logged power-design evidence"}},{"k":"model_boundary_copy","v":{"s":"This is a two-sided, large-sample normal approximation for two independent, equal-size groups. Power is conditional on the assumed effect and alpha; it is not the probability that a hypothesis is true or a guaranteed replication rate. Small samples need a noncentral-t calculation."}},{"k":"model_boundary_label","v":{"s":"Model boundary: "}},{"k":"n_hint","v":{"s":"More participants per group increase modeled power, while cost and feasibility also matter."}},{"k":"observe_power_effect_alpha_live_evidence","v":{"s":"Move three sliders and observe how assumed effect size, two-sided alpha, and sample size change approximate power. This is live evidence: log designs and explain a pattern."}},{"k":"participants_per_group","v":{"s":"Participants per group"}},{"k":"power_band_high","v":{"s":"High modeled power"}},{"k":"power_band_high_desc","v":{"s":"Approximate power is 80% to 95%. Eighty percent is a common planning target, not a universal guarantee of study quality."}},{"k":"power_band_low","v":{"s":"Low modeled power"}},{"k":"power_band_low_desc","v":{"s":"Approximate power is 30% to 60%. A real effect of the assumed size would often go undetected in repeated studies under this model."}},{"k":"power_band_moderate","v":{"s":"Moderate modeled power"}},{"k":"power_band_moderate_desc","v":{"s":"Approximate power is 60% to 80%. Compare the design with your planning target, costs, and desired precision."}},{"k":"power_band_very_high","v":{"s":"Very high modeled power"}},{"k":"power_band_very_high_desc","v":{"s":"Approximate power is above 95%. Whether additional sample size is justified depends on precision, ethics, feasibility, and cost."}},{"k":"power_band_very_low","v":{"s":"Very low modeled power"}},{"k":"power_band_very_low_desc","v":{"s":"Approximate power is below 30%. Under the stated effect and model assumptions, the test has a low chance of rejecting the null."}},{"k":"prompt_alpha_tradeoff","v":{"s":"At fixed effect and n, what happens when you tighten alpha?"}},{"k":"prompt_limits","v":{"s":"Which real design assumptions are missing from this simplified model?"}},{"k":"prompt_same_power","v":{"s":"Can two different designs reach a similar power band? Which tradeoff produced it?"}},{"k":"prompt_small_effect","v":{"s":"For an assumed small effect, how does n per group change the approximate power?"}},{"k":"show_investigation_prompts","v":{"s":"I'm stuck — show investigation prompts"}},{"k":"two_sided_alpha","v":{"s":"Two-sided alpha"}}],"id":582}},{"k":"stewardship","v":{"o":[{"k":"sr_opening_scenario","v":{"s":"Opening scenario"}},{"k":"sr_scenario_started","v":{"s":"Scenario started"}},{"k":"stewardship_as_multi_generational_prac","v":{"s":"Stewardship as multi-generational practice"}},{"k":"cultural_mosaic_and_conservation_manag","v":{"s":"Cultural Mosaic and Conservation Manager are both multi-year stewardship campaigns where the moves you make in year 2 only pay off in year 7. Mosaic's coppice plantings, Conservation Manager's wolf-support building. The discipline is the same: invest in slow infrastructure before you need it. What other domains in your life reward this kind of patience?"}},{"k":"time_scales_of_stewardship","v":{"s":"Time scales of stewardship"}},{"k":"cultural_mosaic_operates_on_8_years_ou","v":{"s":"Cultural Mosaic operates on 8 years; Outbreak Response on 26 weeks. The shorter time scale of pandemic response means your trust capital regenerates more slowly than your fire-return cycles do. Notice how the same kind of decision (a controversial intervention) carries different weight depending on how long the system has to recover. Real Maine planners juggle both time horizons in parallel."}},{"k":"actively_tending_land_and_water","v":{"s":"Actively tending land and water"}},{"k":"both_campaigns_are_about_active_stewar","v":{"s":"Both campaigns are about active stewardship of physical Maine landscape: fire on the barrens, water in the streams. Both involve Wabanaki-led work as the historical and ongoing foundation. Both reward you for matching technique to season and to specific zones. Mosaic's riparian zone (sweetgrass, beaver) is literally the same physical place as Watershed Steward's floodplain wetlands."}},{"k":"indigenous_led_work_as_primary_not_bol","v":{"s":"Indigenous-led work as primary, not bolt-on"}},{"k":"both_cultural_mosaic_and_climate_pathw","v":{"s":"Both Cultural Mosaic and Climate Pathways center Indigenous-led work as foundational. Mosaic IS Wabanaki practice; Pathway's Climate Justice sector has the largest feedback-rule reach (low support there drags every other sector down). What pattern do you notice about how systems perform when Indigenous leadership is centered versus appended?"}},{"k":"trust_and_support_as_gating_mechanisms","v":{"s":"Trust and support as gating mechanisms"}},{"k":"conservation_manager_s_wolf_reintroduc","v":{"s":"Conservation Manager's wolf reintroduction requires habitat 60+ AND public support 50+. Outbreak Response's vaccine uptake collapses when working-age trust drops below 40. In both cases, technical feasibility is downstream of social acceptance. The technical move you most want to make is often the one you most have to earn."}},{"k":"keystone_entities_reshape_entire_syste","v":{"s":"Keystone entities reshape entire systems"}},{"k":"wolves_in_conservation_manager_and_bea","v":{"s":"Wolves in Conservation Manager and beavers in Watershed Steward are both keystone species. A small change in their population produces large changes everywhere downstream. The lesson: in any complex system, identify your keystone first. Most of your effort should go into the entity whose effect ripples furthest."}},{"k":"cascades_at_the_species_and_sector_sca","v":{"s":"Cascades at the species and sector scale"}},{"k":"conservation_manager_s_trophic_cascade","v":{"s":"Conservation Manager's trophic cascades (wolf-deer-forest) and Climate Pathway's sector cascades (clean-grid-transport-buildings) are structurally identical: high state in one entity unlocks accelerated change in another. The math is the same; only the units differ. This is what makes systems thinking transferable across domains."}},{"k":"constrained_hours_public_resource_mana","v":{"s":"Constrained-hours public-resource management"}},{"k":"both_outbreak_response_and_watershed_s","v":{"s":"Both Outbreak Response and Watershed Steward run a constrained hours budget per period. Both involve weighing politically expensive moves (mandates, dam removal) against trust-building moves (communication, citizen science). Both expose the same painful truth: the right intervention at the wrong time costs more than it gains."}},{"k":"equity_as_foundation_not_topping","v":{"s":"Equity as foundation, not topping"}},{"k":"outbreak_response_s_equity_pho_badge_r","v":{"s":"Outbreak Response's equity-PHO badge requires elderly vaccination above 80 WITH maintained trust. Climate Pathway's Justice sector has the biggest feedback-rule reach across all five campaigns. In both, equity is a structural input to system performance, not a moral overlay. Watch what happens to ANY policy in either campaign when equity drops below 40."}},{"k":"land_use_decisions_compound_over_decad","v":{"s":"Land-use decisions compound over decades"}},{"k":"watershed_restoration_on_a_10_year_sca","v":{"s":"Watershed restoration on a 10-year scale and climate policy on a 40-year scale share the same fundamental pattern: land-use decisions compound. Riparian buffer plantings show up as cold-water trout populations 8 years later. Forest carbon protection shows up as adaptation co-benefits two decades later. The decisions feel small at the moment of action and only become visible at scale years later."}},{"k":"cancel_comparison","v":{"s":"Cancel comparison"}},{"k":"back_to_hub","v":{"s":"← Back to hub"}},{"k":"compare_two_campaigns","v":{"s":"🔀 Compare two campaigns"}},{"k":"no_feedback_rules_fired_or_no_log_capt","v":{"s":"No feedback rules fired (or no log captured)."}},{"k":"no_outcome","v":{"s":"No outcome"}},{"k":"back_to_hub_2","v":{"s":"Back to hub"}},{"k":"back","v":{"s":"← Back"}},{"k":"campaign_comparison","v":{"s":"🔀 Campaign Comparison"}},{"k":"pick_different_pair","v":{"s":"Pick different pair"}},{"k":"pair_reflection","v":{"s":"Pair reflection"}},{"k":"feedback_rules_fired","v":{"s":"Feedback rules fired"}},{"k":"fifteen_campaigns_two_formats_five_mec","v":{"s":"Fifteen campaigns, two formats, five mechanic families"}},{"k":"you_have_fifteen_campaigns_to_choose_f","v":{"s":"You have fifteen campaigns to choose from. Five are deep Maine anchor campaigns (multi-period simulations grounded in documented Maine practice — Wabanaki fire stewardship, wildlife conservation, public health, watershed restoration, climate policy). Ten are self-contained cross-region scenarios (4-decision, 5–10 minute experiences from Yarralin Australia, Karuk Northern California, Yellowstone, Akagera Rwanda, Mumbai monsoon dengue, Liberia 2014 Ebola, Klamath River, Murray–Darling Basin, Marshall Islands, and Bangladesh delta) that teach the same universal mechanic on different country. Same five mechanic families, two case studies per family minimum. Family Pairing Insights unlock as you complete a Maine anchor + a cross-region scenario in the same family."}},{"k":"the_campaign_loop","v":{"s":"The campaign loop"}},{"k":"every_campaign_cycles_through_four_pha","v":{"s":"Every campaign cycles through four phases. Setup: pick a difficulty and read about the entities. Period (year, week, or 5-year period depending on the campaign): allocate stewardship hours to interventions on specific entities. Review: see how the system drifted and which events fired. Debrief at the end: see your outcome tier, a do-nothing comparison, and a trend chart. The pattern is the same in every campaign; the moves differ."}},{"k":"feedback_rules_are_the_campaign_s_spin","v":{"s":"Feedback rules are the campaign's spine"}},{"k":"each_campaign_has_3_to_4_feedback_rule","v":{"s":"Each campaign has 3 to 4 feedback rules that fire AFTER your actions resolve. They tie entities together. Wolves suppress deer (Conservation Manager). Beavers help salmon and brook trout (Watershed Steward). Clean grid unlocks transport electrification (Climate Pathways). Low working-age trust triggers vaccine refusal (Outbreak Response). Read the year-end review for which feedback rules fired this period; that is where the real strategy lives."}},{"k":"ai_reading_what_it_is_and_what_it_is_n","v":{"s":"AI Reading: what it is and what it is NOT"}},{"k":"every_campaign_has_a_read_the_land_cou","v":{"s":"Every campaign has a \"Read the [land/county/watershed/etc] (AI)\" button. This is an AI educator that reads your current state and offers coaching grounded in research and Maine case studies. It is NOT a Wabanaki person, NOT a real Public Health Officer, NOT a wildlife biologist, NOT an agency staff member. Real voices belong to real organizations: Wabanaki Public Health and Wellness, Maine Indian Basketmakers Alliance, Penobscot Nation CHPD, Maine CDC, Atlantic Salmon Federation, and others, named in every AI response disclaimer. The AI is a teaching helper, not an authority."}},{"k":"choose_your_first_campaign_or_scenario","v":{"s":"Choose your first campaign or scenario"}},{"k":"no_required_order_conservation_manager","v":{"s":"No required order. Conservation Manager (Maine anchor) has the cleanest feedback rules for first-timers. Yellowstone Wolf Restoration is the textbook trophic cascade case study — a great first cross-region scenario after the Maine one. For shorter sessions try a cross-region scenario (5–10 min) first; for longer sessions try a Maine anchor (multi-period campaign). The strongest learning move: pair a Maine anchor with a cross-region scenario in the same mechanic family, then compare. After two completions the hub surfaces cross-campaign patterns you would not see from any single run."}},{"k":"stewardship_hub_onboarding_tutorial","v":{"s":"Stewardship Hub onboarding tutorial"}},{"k":"welcome_to_environmental_stewardship_c","v":{"s":"🌍 Welcome to Environmental Stewardship Campaigns"}},{"k":"a_5_step_tour_before_your_first_campai","v":{"s":"A 5-step tour before your first campaign or scenario."}},{"k":"skip_tutorial","v":{"s":"Skip tutorial"}},{"k":"skip_tour","v":{"s":"Skip tour"}},{"k":"previous_step","v":{"s":"Previous step"}},{"k":"back_2","v":{"s":"← Back"}},{"k":"zone","v":{"s":"Zone"}},{"k":"species","v":{"s":"Species"}},{"k":"demographic","v":{"s":"Demographic"}},{"k":"component","v":{"s":"Component"}},{"k":"sector","v":{"s":"Sector"}},{"k":"entity","v":{"s":"Entity"}},{"k":"maine_stewardship_campaign_report","v":{"s":"Maine Stewardship Campaign Report"}},{"k":"print_this_report","v":{"s":"Print this report"}},{"k":"print","v":{"s":"🖨 Print"}},{"k":"close_report","v":{"s":"Close report"}},{"k":"back_3","v":{"s":"← Back"}},{"k":"final_outcome","v":{"s":"Final outcome"}},{"k":"difficulty","v":{"s":"Difficulty"}},{"k":"periods_played","v":{"s":"Periods played"}},{"k":"campaign_seed","v":{"s":"Campaign seed"}},{"k":"campaign_log","v":{"s":"Campaign Log"}},{"k":"student_name","v":{"s":"Student name"}},{"k":"date","v":{"s":"Date"}},{"k":"reflection_one_thing_you_learned","v":{"s":"Reflection (one thing you learned)"}},{"k":"teacher_signature","v":{"s":"Teacher signature"}},{"k":"generated_by_environmental_stewardship","v":{"s":"Generated by Environmental Stewardship Campaigns · AlloFlow · Campaign data is a teaching simplification grounded in documented practice."}},{"k":"back_to_hub_3","v":{"s":"Back to hub"}},{"k":"back_to_hub_4","v":{"s":"← Back to hub"}},{"k":"briefing","v":{"s":"Briefing"}},{"k":"entities_you_steward","v":{"s":"Entities you steward"}},{"k":"ai_scenario_notice","v":{"s":"⚠️ AI scenario notice: "}},{"k":"begin_scenario","v":{"s":"Begin scenario"}},{"k":"begin_scenario_2","v":{"s":"Begin scenario →"}},{"k":"cancel","v":{"s":"Cancel"}},{"k":"cancel_2","v":{"s":"Cancel"}},{"k":"pause_and_return_to_hub","v":{"s":"Pause and return to hub"}},{"k":"pause","v":{"s":"← Pause"}},{"k":"each_ring_is_one_part_of_the_system_he","v":{"s":"each ring is one part of the system (🟢 healthy · 🟡 stressed · 🔴 critical). After a choice, lit spokes + ±deltas show how it rippled through."}},{"k":"decisions_so_far","v":{"s":"📓 Decisions so far"}},{"k":"back_to_hub_5","v":{"s":"Back to hub"}},{"k":"back_to_hub_6","v":{"s":"← Back to hub"}},{"k":"final_outcome_2","v":{"s":"Final outcome"}},{"k":"final_entity_state","v":{"s":"Final entity state"}},{"k":"your_decision_path","v":{"s":"Your decision path"}},{"k":"cross_region_synthesis","v":{"s":"🧠 Cross-region synthesis"}},{"k":"cited_organizations_and_sources","v":{"s":"📚 Cited organizations and sources"}},{"k":"replay_scenario","v":{"s":"Replay scenario"}},{"k":"replay","v":{"s":"↻ Replay"}},{"k":"back_to_hub_7","v":{"s":"Back to hub"}},{"k":"back_to_hub_8","v":{"s":"← Back to hub"}},{"k":"environmental_stewardship_campaigns_hu","v":{"s":"Environmental Stewardship Campaigns hub"}},{"k":"back_to_stem_lab","v":{"s":"Back to STEAM Lab"}},{"k":"back_4","v":{"s":"← Back"}},{"k":"environmental_stewardship_campaigns","v":{"s":"🌍 Environmental Stewardship Campaigns"}},{"k":"fifteen_environmental_stewardship_camp","v":{"s":"Fifteen environmental stewardship campaigns across eleven regions. Five deep multi-period Maine anchor campaigns (your case studies for fire-return intervals, trophic cascades, public-health trust, hydrological cascades, climate-policy interdependence) plus ten self-contained cross-region scenarios (Yarralin Australia, Karuk Northern California, Yellowstone wolves, Akagera Rwanda lions, Mumbai monsoon dengue, Liberia 2014 Ebola, Klamath River, Murray–Darling Basin, Marshall Islands atolls, Bangladesh delta) that teach the same universal mechanics on different country. Every mechanic family now has at least two cross-region case studies for direct comparison."}},{"k":"take_the_5_step_tour","v":{"s":"Take the 5-step tour"}},{"k":"re_launch_the_onboarding_tutorial","v":{"s":"Re-launch the onboarding tutorial"}},{"k":"take_the_tour","v":{"s":"🧭 Take the tour"}},{"k":"flourishing","v":{"s":"Flourishing"}},{"k":"high_investment_long_horizon_strong_co","v":{"s":"High investment, long horizon, strong community — landscape recovers and self-sustains."}},{"k":"positive_trajectory","v":{"s":"Positive trajectory"}},{"k":"real_progress_visible_continued_effort","v":{"s":"Real progress visible. Continued effort builds on early wins."}},{"k":"tenuous","v":{"s":"Tenuous"}},{"k":"mixed_results_one_bad_season_or_fundin","v":{"s":"Mixed results. One bad season or funding cut could reverse gains."}},{"k":"struggling","v":{"s":"Struggling"}},{"k":"low_investment_or_weak_community_engag","v":{"s":"Low investment or weak community engagement. Effort visible but ecosystem still declining."}},{"k":"failing","v":{"s":"Failing"}},{"k":"too_little_too_late_or_wrong_approach_","v":{"s":"Too little, too late, or wrong approach. Tipping point passed or imminent."}},{"k":"stewardship_inquiry_predict_the_trajec","v":{"s":"🔬 Stewardship Inquiry — Predict the Trajectory"}},{"k":"pick_a_hypothetical_project_setting_pr","v":{"s":"Pick a hypothetical project setting. Predict how investment, time, community, and intervention complexity combine. No score, no reveal. (Note: this slider is intervention complexity, NOT biodiversity — higher biodiversity generally INCREASES resilience.)"}},{"k":"investment_k","v":{"s":"Investment ($K)"}},{"k":"time_horizon_yr","v":{"s":"Time horizon (yr)"}},{"k":"community_buy_in","v":{"s":"Community buy-in"}},{"k":"intervention_complexity_uncertainty","v":{"s":"Intervention complexity / uncertainty"}},{"k":"log_this_project","v":{"s":"📋 Log this project"}},{"k":"reset","v":{"s":"Reset"}},{"k":"your_hypothesis_which_campaign_would_b","v":{"s":"Your hypothesis (which campaign would benefit most from MORE community buy-in vs MORE investment?)"}},{"k":"e_g_yellowstone_wolves_needed_50_years","v":{"s":"e.g., Yellowstone wolves needed 50 years of community shift before reintroduction was politically possible — money alone wouldn't have worked..."}},{"k":"i_m_stuck_show_open_questions","v":{"s":"🤔 I'm stuck — show open questions"}},{"k":"open_questions_no_answer_key","v":{"s":"Open questions (no answer key)"}},{"k":"watch_the_vocabulary_the_intervention_","v":{"s":"Watch the vocabulary: the \"intervention complexity\" slider tracks how many uncertain, intervention-dependent variables you must manage — NOT biodiversity. Biodiversity-ecosystem-function research (Tilman, Cardinale, Loreau, IPBES) consistently links higher diversity to higher resilience. What real-world projects have high intervention complexity but ALSO high biodiversity outcomes?"}},{"k":"time_horizon_community_buy_in_dominate","v":{"s":"Time horizon × community buy-in dominates the ROI proxy. Is that realistic? When is it wrong?"}},{"k":"a_500k_1_year_intervention_with_zero_c","v":{"s":"A $500K, 1-year intervention with zero community buy-in — what trajectory? Why?"}},{"k":"when_does_this_model_fail_badly_hint_d","v":{"s":"When does this model fail badly? (Hint: discrete tipping points, irreversibility.)"}},{"k":"i_can_explain_why_this_project_profile","v":{"s":"I can explain why this project profile yields this stewardship trajectory."}},{"k":"explain_in_your_own_words","v":{"s":"Explain in your own words..."}},{"k":"inquiry_widget_no_score_no_reveal_no_a","v":{"s":"Inquiry widget — no score, no reveal, no answer dump. Linear scoring is pedagogical only; real stewardship has tipping points, lag effects, and qualitative shifts that don't fit a single index."}},{"k":"campaigns_scenarios_complete","v":{"s":"Campaigns + scenarios complete"}},{"k":"in_progress","v":{"s":"In progress"}},{"k":"top_tier_outcomes","v":{"s":"Top-tier outcomes"}},{"k":"stewardship_tier","v":{"s":"Stewardship tier"}},{"k":"cross_campaign_mastery","v":{"s":"Cross-campaign mastery"}},{"k":"earned","v":{"s":"✓ Earned"}},{"k":"cross_campaign_synthesis","v":{"s":"Cross-Campaign Synthesis"}},{"k":"compare_two_of_your_completed_campaign","v":{"s":"Compare two of your completed campaigns side by side"}},{"k":"compare_two_campaigns_2","v":{"s":"🔀 Compare two campaigns"}},{"k":"cross_region_pairing_insights","v":{"s":"Cross-Region Pairing Insights"}},{"k":"maine_anchor_campaigns","v":{"s":"🇺🇸 Maine anchor campaigns"}},{"k":"five_deep_multi_period_simulations_gro","v":{"s":"Five deep multi-period simulations grounded in documented Maine practice. Each is a 10–40 period campaign with periodic decisions, random events, and feedback rules. Use these as your deep case study for each mechanic, then try the same mechanic in another region below."}},{"k":"recommended_starter","v":{"s":"🌱 Recommended starter"}},{"k":"top_tier_outcome","v":{"s":"🌟 Top-tier outcome"}},{"k":"view_printable_campaign_report","v":{"s":"View printable campaign report"}},{"k":"report","v":{"s":"🖨 Report"}},{"k":"cross_region_scenarios","v":{"s":"🌐 Cross-region scenarios"}},{"k":"ten_self_contained_4_decision_scenario","v":{"s":"Ten self-contained 4-decision scenarios from other parts of the world. Each takes 5–10 minutes and uses the same universal mechanic as the Maine anchor — different country, different cultures, different stakes. Every mechanic family has at least two cross-region scenarios so you can compare within the same mechanic across two regions, and compare those against the Maine anchor in a three-way analysis."}},{"k":"top_tier_outcome_2","v":{"s":"🌟 Top-tier outcome"}},{"k":"reset_and_replay_this_scenario","v":{"s":"Reset and replay this scenario"}},{"k":"notes_for_educators","v":{"s":"📝 Notes for educators"}},{"k":"all_fifteen_campaigns_and_scenarios_sh","v":{"s":"All fifteen campaigns and scenarios share the same structural pattern: setup or briefing, periodic decisions, feedback rules / consequences that tie entities together, debrief. A student who learns one knows how to play all fifteen."}},{"k":"what_differs_across_mechanic_families","v":{"s":"What differs across mechanic families:"}},{"k":"fire_return_intervals_across_habitats_","v":{"s":" fire-return intervals across habitats (Mosaic + Yarralin + Karuk); trophic cascades between species (Conservation Manager + Yellowstone + Akagera); trust feedback in public health (Outbreak + Mumbai + Liberia); hydrological cascades through a watershed (Watershed Steward + Klamath + Murray–Darling); inter-sector policy dependence in climate planning (Pathways + Marshall Islands + Bangladesh)."}},{"k":"why_pair_regions","v":{"s":"Why pair regions:"}},{"k":"the_maine_anchor_campaign_in_each_fami","v":{"s":" the Maine anchor campaign in each family is the deep multi-period simulation grounded in documented Maine practice (Wabanaki seasonal cycles, Edwards/Veazie dam removals, central Maine watersheds, NECEC + heat-pump policy fights). The cross-region scenario in the same family teaches the SAME universal mechanic on radically different country, with cited Indigenous-led organisations and regionally-appropriate AI disclaimers. The pairing surfaces both what is universal and what is local."}},{"k":"discussion_prompts_after_a_maine_regio","v":{"s":"Discussion prompts after a Maine+region pairing in the same family:"}},{"k":"what_stewardship_principle_showed_up_i","v":{"s":"What stewardship principle showed up in both regions? What was specific to local culture, climate, or history?"}},{"k":"whose_voice_was_load_bearing_in_each_w","v":{"s":"Whose voice was load-bearing in each? (Wabanaki / Karangpurru / Yurok / Marshallese / etc.) How does the AI disclaimer reflect that?"}},{"k":"in_which_mechanic_family_is_the_underl","v":{"s":"In which mechanic family is the underlying physics most identical across regions? Most different?"}},{"k":"what_would_you_build_to_take_what_you_","v":{"s":"What would you build to take what you learned in one region and apply it to the other?"}},{"k":"maine_campaigns_are_10_40_period_simul","v":{"s":"Maine campaigns are 10–40 period simulations with do-nothing baselines, trend charts, and AI Reading. Cross-region scenarios are 4-decision self-contained learning experiences (5–10 min each) with cited regional organisations and region-specific AI disclaimers. Both count toward the mastery tiers."}},{"k":"apprentice_desc","v":{"s":"Complete one campaign or scenario."}},{"k":"practitioner_desc","v":{"s":"Complete three campaigns or scenarios."}},{"k":"regional_desc","v":{"s":"Complete five — for example all Maine anchors, or one from each of the five mechanic families."}},{"k":"global_desc","v":{"s":"Complete eight — including cross-region scenarios from at least three mechanic families."}},{"k":"multiregion_desc","v":{"s":"Complete twelve — both Maine and at least one cross-region scenario from each of the five mechanic families."}},{"k":"grandmaster_desc","v":{"s":"Complete all fifteen with top-tier outcomes."}},{"k":"not_yet_earned","v":{"s":"Not yet earned"}},{"k":"mission_label","v":{"s":"Systems stewardship mission"}},{"k":"mission_blurb","v":{"s":"Compare how ecological feedback, community trust, time horizons, and local authority shape fifteen campaigns across eleven regions."}},{"k":"portfolio_progress","v":{"s":"Stewardship portfolio progress"}},{"k":"complete","v":{"s":"Complete"}},{"k":"continue_recommended","v":{"s":"Continue recommended campaign"}},{"k":"start_recommended","v":{"s":"Start recommended campaign"}},{"k":"advanced_inquiry","v":{"s":"Advanced inquiry: model a stewardship investment"}},{"k":"trajectory_chart","v":{"s":"Stewardship trajectory chart showing projected success odds and ROI proxy."}},{"k":"hypothesis_input","v":{"s":"Stewardship campaign hypothesis"}},{"k":"explanation_input","v":{"s":"Stewardship campaign explanation"}}],"id":583}},{"k":"surface_area","v":{"s":"Surface Area"}},{"k":"swimlab","v":{"o":[{"k":"sr_consent_accepted_welcome_to_swimlab","v":{"s":"Consent accepted. Welcome to SwimLab."}},{"k":"sr_back_to_menu","v":{"s":"Back to menu"}},{"k":"sr_question_reset_try_again","v":{"s":"Question reset. Try again."}},{"k":"sr_opening_cross_referenced_module","v":{"s":"Opening cross-referenced module"}},{"k":"sr_opening_how_swimming_works","v":{"s":"Opening How Swimming Works"}},{"k":"emergency_reminder","v":{"s":"Emergency reminder"}},{"k":"in_a_real_emergency_call_911","v":{"s":"In a real emergency: call 911"}},{"k":"in_maine_you_can_text_911_this_tool_is","v":{"s":" — in Maine you can text 911. This tool is educational only and does not teach swimming."}},{"k":"educational_disclaimer","v":{"s":"Educational disclaimer"}},{"k":"educational_only_to_learn_to_swim_find","v":{"s":"Educational only. To learn to swim, find a certified Water Safety Instructor at "}},{"k":"red_cross","v":{"s":"Red Cross"}},{"k":"or_your_local_ymca_real_emergencies","v":{"s":" or your local YMCA. Real emergencies → "}},{"k":"swimlab_consent_and_educational_scope","v":{"s":"SwimLab consent and educational scope"}},{"k":"swimlab_is_an_educational_tool","v":{"s":"🛟 SwimLab is an EDUCATIONAL tool."}},{"k":"it_teaches_you_to","v":{"s":"It teaches you to "}},{"k":"water_hazards","v":{"s":" water hazards, "}},{"k":"to_aquatic_emergencies_and_reduce_drow","v":{"s":" to aquatic emergencies, and reduce drowning risk. It is "}},{"k":"a_way_to_learn_how_to_swim_watching_a_","v":{"s":" a way to learn how to swim. Watching a screen cannot teach you to float, breathe, or move through water. Those skills only come from time in the water with a qualified instructor."}},{"k":"to_learn_to_swim_or_get_certified_find","v":{"s":"To learn to swim or get certified, find a Water Safety Instructor (WSI) at the "}},{"k":"american_red_cross","v":{"s":"American Red Cross"}},{"k":"your_local","v":{"s":", your local "}},{"k":"or_community_pool_the","v":{"s":", or community pool. The "}},{"k":"usa_swimming_foundation","v":{"s":"USA Swimming Foundation"}},{"k":"offers_scholarships_for_families_who_c","v":{"s":" offers scholarships for families who cannot afford lessons."}},{"k":"content_note","v":{"s":"⚠️ Content note: "}},{"k":"this_tool_talks_about_drowning_near_dr","v":{"s":"This tool talks about drowning, near-drowning, and cold water emergencies. The content is matter-of-fact, not graphic, but the topic is serious. If you have lost someone to a water emergency, this material may bring difficult feelings up. You can step away at any point."}},{"k":"in_a_real_emergency_call_911_2","v":{"s":"In a real emergency, call 911."}},{"k":"in_maine_you_can","v":{"s":" In Maine, you can "}},{"k":"text_911","v":{"s":"text 911"}},{"k":"if_you_cannot_speak","v":{"s":" if you cannot speak."}},{"k":"whoever_saves_a_single_soul_scripture_","v":{"s":"\"Whoever saves a single soul, scripture considers it as if they saved an entire world.\""}},{"k":"mishnah_sanhedrin_4_5_pirkei_avot","v":{"s":"— Mishnah Sanhedrin 4:5 (Pirkei Avot)"}},{"k":"i_understand_show_me_the_lab","v":{"s":"I understand. Show me the lab."}},{"k":"i_understand_show_me_the_lab_2","v":{"s":"I understand — show me the lab"}},{"k":"acknowledging_this_screen_is_a_one_tim","v":{"s":"Acknowledging this screen is a one-time gate. Your acknowledgment is saved with your profile so you do not see it again."}},{"k":"back_to_swimlab_menu","v":{"s":"Back to SwimLab menu"}},{"k":"menu","v":{"s":"← Menu"}},{"k":"print_this_module_as_a_classroom_hando","v":{"s":"Print this module as a classroom handout"}},{"k":"print","v":{"s":"🖨️ Print"}},{"k":"cold_water_survival","v":{"s":"Cold Water Survival"}},{"k":"the_gasp_reflex_the_mammalian_dive_res","v":{"s":"The gasp reflex, the mammalian dive response, and the 1-1-10 timeline that beats panic."}},{"k":"why_life_jackets_work","v":{"s":"Why Life Jackets Work"}},{"k":"the_physics_of_buoyancy_five_pfd_types","v":{"s":"The physics of buoyancy. Five PFD types. Fit check that actually works. The 86% statistic."}},{"k":"help_without_drowning_yourself","v":{"s":"Help Without Drowning Yourself"}},{"k":"reach_throw_row_don_t_go_why_untrained","v":{"s":"Reach / Throw / Row / Don't Go. Why untrained rescuers die. Bystander effect cuts."}},{"k":"how_swimming_works","v":{"s":"How Swimming Works"}},{"k":"the_physics_of_every_major_stroke_plus","v":{"s":"The physics of every major stroke, plus the survival skills (back float, eggbeater, HELP, huddle) that actually save lives."}},{"k":"rip_currents","v":{"s":"Rip Currents"}},{"k":"spot_them_from_shore_the_parallel_to_s","v":{"s":"Spot them from shore. The parallel-to-shore escape. Why fighting the current kills."}},{"k":"falling_through_ice","v":{"s":"Falling Through Ice"}},{"k":"the_swim_and_roll_self_rescue_picks_of","v":{"s":"The swim-and-roll self-rescue. Picks of Life. Maine ice color cues. Snowmobile through-ice."}},{"k":"cold_body_cold_brain","v":{"s":"Cold Body, Cold Brain"}},{"k":"how_the_body_fails_in_cold_the_umbles_","v":{"s":"How the body fails in cold. The UMBLES rule. What NOT to do. Why \"not dead until warm and dead.\""}},{"k":"pool_drain_risks","v":{"s":"Pool Drain Risks"}},{"k":"the_virginia_graeme_baker_act_five_ent","v":{"s":"The Virginia Graeme Baker Act. Five entrapment types. The emergency shut-off."}},{"k":"autism_water","v":{"s":"Autism + Water"}},{"k":"the_160x_drowning_risk_defense_in_dept","v":{"s":"The 160x drowning risk. Defense-in-depth prevention. Adapted swim instruction. Swimsuit color visibility."}},{"k":"cumulative_quiz","v":{"s":"Cumulative Quiz"}},{"k":"15_questions_across_all_nine_modules_m","v":{"s":"15 questions across all nine modules. Missed answers link you straight back to the module you need to review."}},{"k":"ask_the_lifeguard_ai","v":{"s":"Ask the Lifeguard (AI)"}},{"k":"type_a_swimming_or_water_question_ai_r","v":{"s":"Type a swimming or water question; AI returns a sourced answer. Educational only."}},{"k":"resources","v":{"s":"Resources"}},{"k":"every_org_cited_in_this_tool_plus_adap","v":{"s":"Every org cited in this tool, plus adaptive swim programs and Maine-specific links."}},{"k":"start_here","v":{"s":"Start here"}},{"k":"modules","v":{"s":"Modules"}},{"k":"practice_and_ask","v":{"s":"Practice and ask"}},{"k":"resources_2","v":{"s":"Resources"}},{"k":"swimlab","v":{"s":"🏊 SwimLab"}},{"k":"the_science_of_swimming_and_the_surviv","v":{"s":"The science of swimming and the survival skills that go with it. The "}},{"k":"start_here_2","v":{"s":"Start here"}},{"k":"lane_is_the_three_modules_most_likely_","v":{"s":" lane is the three modules most likely to actually save a life if you only do three. Every module is sourced inline."}},{"k":"badges_earned","v":{"s":"🏅 Badges earned"}},{"k":"whoever_saves_a_single_soul_scripture__2","v":{"s":"\"Whoever saves a single soul, scripture considers it as if they saved an entire world.\""}},{"k":"mishnah_sanhedrin_4_5_pirkei_avot_2","v":{"s":"— Mishnah Sanhedrin 4:5 (Pirkei Avot)"}},{"k":"right_answer","v":{"s":"Right answer: "}},{"k":"try_again","v":{"s":"Try again"}},{"k":"retry","v":{"s":"Retry"}},{"k":"try_again_2","v":{"s":"↺ Try again"}},{"k":"sources","v":{"s":"📖 Sources"}},{"k":"teacher_notes_for_this_module","v":{"s":"Teacher Notes for this module"}},{"k":"teacher_notes_click_to_expand","v":{"s":"🍎 Teacher Notes — click to expand"}},{"k":"print_this_module_page","v":{"s":"Print this module page"}},{"k":"print_2","v":{"s":"🖨️ Print"}},{"k":"aligned_standards","v":{"s":"Aligned standards"}},{"k":"discussion_questions","v":{"s":"Discussion questions"}},{"k":"common_misconceptions","v":{"s":"Common misconceptions"}},{"k":"extension_activity","v":{"s":"Extension activity"}},{"k":"survival_skill","v":{"s":"SURVIVAL SKILL"}},{"k":"physics","v":{"s":"⚙ Physics: "}},{"k":"key_takeaway","v":{"s":"🎯 Key takeaway: "}},{"k":"back_float","v":{"s":"Back Float"}},{"k":"the_single_most_life_saving_skill_in_c","v":{"s":"The single most life-saving skill in cold water. Lungs full of air make you naturally buoyant. Tilting the head back keeps the airway out of the water without effort. Costs no energy, can be held for hours, and beats panicking every single time."}},{"k":"buoyant_force","v":{"s":"Buoyant force"}},{"k":"lungs_full_head_back_arms_relaxed","v":{"s":"Lungs full · head back · arms relaxed"}},{"k":"see_why_this_is_the_1_cold_water_survi","v":{"s":"See why this is the #1 cold-water survival skill →"}},{"k":"eggbeater_kick_treading_water","v":{"s":"Eggbeater Kick (Treading Water)"}},{"k":"used_by_water_polo_players_lifeguards_","v":{"s":"Used by water polo players, lifeguards, and anyone needing to stay vertical in deep water for a long time. Each leg traces a circle in the opposite direction, generating continuous upward thrust without the up-and-down bobbing of a flutter kick."}},{"k":"lift","v":{"s":"Lift"}},{"k":"counter_rotating_legs_constant_lift","v":{"s":"Counter-rotating legs · constant lift"}},{"k":"help_position_heat_escape_lessening_po","v":{"s":"HELP Position (Heat Escape Lessening Posture)"}},{"k":"for_solo_cold_water_survival_while_wea","v":{"s":"For solo cold-water survival while wearing a life jacket. Knees pulled to chest, arms crossed over chest, body curled. Reduces heat loss through the body's biggest blood-flow zones (groin, armpits, sides of chest)."}},{"k":"heat_loss","v":{"s":"−Heat loss"}},{"k":"knees_up_arms_crossed_groin_armpit_clo","v":{"s":"Knees up · arms crossed · groin/armpit closed off"}},{"k":"group_huddle","v":{"s":"Group Huddle"}},{"k":"multiple_people_in_cold_water_with_lif","v":{"s":"Multiple people in cold water with life jackets cluster chest-to-chest, arms around each other. Children go in the middle. The group functions as a single warmer body and is much more visible to rescuers than scattered individuals."}},{"k":"adults_around_children_in_middle_facin","v":{"s":"Adults around · children in middle · facing in"}},{"k":"freestyle_front_crawl","v":{"s":"Freestyle (Front Crawl)"}},{"k":"the_fastest_stroke_long_axis_rotation_","v":{"s":"The fastest stroke. Long-axis rotation: the body rolls 30-45° per arm cycle to reduce frontal cross-section and let the recovering arm clear the water. Bilateral breathing alternates breath sides every 3 strokes."}},{"k":"hand_enters_water_forearm_sets_vertica","v":{"s":"Hand enters water · forearm sets vertical"}},{"k":"thrust","v":{"s":"Thrust →"}},{"k":"arm_pulls_water_back_body_moves_forwar","v":{"s":"Arm pulls water back · body moves forward"}},{"k":"hand_pushes_past_hip_maximum_thrust","v":{"s":"Hand pushes past hip · maximum thrust"}},{"k":"arm_over_water_body_rolls_to_opposite_","v":{"s":"Arm over water · body rolls to opposite side"}},{"k":"backstroke","v":{"s":"Backstroke"}},{"k":"freestyle_inverted_same_long_axis_rota","v":{"s":"Freestyle inverted — same long-axis rotation, alternating arms, flutter kick. The single most important detail: head position. A neutral head with ears in the water and eyes up keeps the hips up and the body streamlined. Looking down sinks the hips and doubles drag."}},{"k":"thrust_2","v":{"s":"← thrust"}},{"k":"pinky_enters_first_s_shaped_pull","v":{"s":"Pinky enters first · S-shaped pull"}},{"k":"breaststroke","v":{"s":"Breaststroke"}},{"k":"the_oldest_competitive_stroke_and_the_","v":{"s":"The oldest competitive stroke and the slowest of the four. Symmetric arm pull and frog-kick legs separated by a long glide phase. Visible head out of water makes it good for staying oriented."}},{"k":"pull","v":{"s":"Pull"}},{"k":"arms_sweep_heart_shape_head_lifts_to_b","v":{"s":"Arms sweep heart-shape · head lifts to breathe"}},{"k":"frog_kick","v":{"s":"↺ frog kick"}},{"k":"frog_kick_long_glide_streamlined","v":{"s":"Frog kick · long glide · streamlined"}},{"k":"butterfly","v":{"s":"Butterfly"}},{"k":"the_most_physically_demanding_competit","v":{"s":"The most physically demanding competitive stroke. Symmetric over-water arm recovery, dolphin kick (legs together undulating), and a body undulation that drives propulsion through the chest and hips."}},{"k":"dolphin","v":{"s":"↕ dolphin"}},{"k":"body_undulates_arms_recover_symmetric_","v":{"s":"Body undulates · arms recover symmetric · feet whip"}},{"k":"sidestroke","v":{"s":"Sidestroke"}},{"k":"historically_the_rescue_stroke_one_arm","v":{"s":"Historically THE rescue stroke. One arm free for towing a victim, head above water, scissor kick, slow but sustainable. Not raced today but taught in lifeguard certification."}},{"k":"scissor_close","v":{"s":"Scissor close"}},{"k":"side_position_scissor_kick_head_out_on","v":{"s":"Side position · scissor kick · head out · one arm free"}},{"k":"swimming_is_applied_physics_buoyancy_p","v":{"s":"Swimming is applied physics: buoyancy + propulsion + drag, modulated by body position. This module breaks each stroke into phases with the physics labeled, then explains the underlying forces. "}},{"k":"reading_this_is_not_a_substitute_for_s","v":{"s":"Reading this is not a substitute for swim instruction. "}},{"k":"you_cannot_learn_to_swim_from_a_screen","v":{"s":"You cannot learn to swim from a screen. Find a Water Safety Instructor at Red Cross or YMCA."}},{"k":"these_four_are_the_highest_leverage_sk","v":{"s":"These four are the highest-leverage skills in the whole module. They cost no athletic talent. They have saved more lives than fancy strokes ever will."}},{"k":"these_are_taught_in_swim_lessons_and_u","v":{"s":"These are taught in swim lessons and used in racing. Reading the physics will help you understand what your instructor is asking you to do, but it does NOT replace time in the water."}},{"k":"usa_swimming_foundation_2","v":{"s":"USA Swimming Foundation"}},{"k":"american_red_cross_swim_water_safety","v":{"s":"American Red Cross — Swim & Water Safety"}},{"k":"ymca_aquatics_programs","v":{"s":"YMCA — Aquatics Programs"}},{"k":"cold_water_boot_camp_help_and_huddle","v":{"s":"Cold Water Boot Camp — HELP and Huddle"}},{"k":"counsilman_counsilman_the_science_of_s","v":{"s":"Counsilman & Counsilman, \"The Science of Swimming\" (classic reference for stroke biomechanics)"}},{"k":"maglischo_swimming_fastest_modern_stro","v":{"s":"Maglischo, \"Swimming Fastest\" (modern stroke physics)"}},{"k":"heads_up","v":{"s":"Heads up: "}},{"k":"this_module_talks_about_drowning_and_n","v":{"s":"this module talks about drowning and near-drowning matter-of-factly. If you have lost someone to a water emergency, the content may bring difficult feelings up. You can step away or skip ahead at any time."}},{"k":"most_cold_water_deaths_happen_in_the_f","v":{"s":"Most cold water deaths happen in the first 60 seconds — not from drowning by inability to swim, but from involuntary breathing and panic. This module teaches the physiology and the response that saves lives."}},{"k":"if_you_fall_into_cold_water_you_have","v":{"s":"If you fall into cold water, you have:"}},{"k":"to_control_your_breathing","v":{"s":"to control your breathing"}},{"k":"do_nothing_else_float_on_your_back_let","v":{"s":"Do nothing else. Float on your back. Let the gasp reflex pass. Do not try to swim yet."}},{"k":"of_meaningful_movement","v":{"s":"of meaningful movement"}},{"k":"after_the_gasp_passes_you_have_10_minu","v":{"s":"After the gasp passes, you have ~10 minutes of useful arm/hand strength to swim to safety, climb out, or signal for help."}},{"k":"before_unconsciousness","v":{"s":"before unconsciousness"}},{"k":"hypothermia_takes_about_an_hour_to_mak","v":{"s":"Hypothermia takes about an hour to make you unconscious in 50°F water. This means rescuers have time. People who appear \"drowned\" from cold water can sometimes be revived."}},{"k":"when_you_fall_in_cold_water_the_worst_","v":{"s":"When you fall in cold water, the worst thing is to try to swim immediately. Tilt your head back, fill your lungs, and float. Your gasp reflex will pass in 60 seconds or so. Then you can swim or signal. This single instruction has saved thousands of lives. "}},{"k":"see_the_back_float_physics_in_how_swim","v":{"s":"See the Back Float physics in How Swimming Works →"}},{"k":"a_friend_falls_off_a_kayak_into_a_main","v":{"s":"A friend falls off a kayak into a Maine lake in October (water ~55°F). They are wearing a life jacket. They start swimming hard for shore about 200 feet away. What is the biggest risk?"}},{"k":"cold_water_boot_camp_mario_vittone","v":{"s":"Cold Water Boot Camp (Mario Vittone)"}},{"k":"the_1_1_10_rule_mammalian_dive_respons","v":{"s":"The 1-1-10 rule, mammalian dive response, cold incapacitation timelines"}},{"k":"cdc_drowning_prevention","v":{"s":"CDC: Drowning prevention"}},{"k":"national_drowning_prevention_alliance_","v":{"s":"National Drowning Prevention Alliance (NDPA)"}},{"k":"mario_vittone_if_a_child_is_drowning","v":{"s":"Mario Vittone — \"If a child is drowning\""}},{"k":"aap_policy_statement_prevention_of_dro","v":{"s":"AAP Policy Statement: Prevention of Drowning (2019, reaffirmed)"}},{"k":"rip_currents_pull_thousands_of_beachgo","v":{"s":"Rip currents pull thousands of beachgoers out to sea every year on US coasts, including Maine. The escape technique is counterintuitive — most people get it wrong because they panic."}},{"k":"you_will_exhaust_yourself_and_drown_th","v":{"s":" You will exhaust yourself and drown. The current is faster than you can swim."}},{"k":"stay_calm_float_if_you_need_to","v":{"s":"Stay calm. Float if you need to."}},{"k":"the_current_will_not_pull_you_under_on","v":{"s":" The current will not pull you under, only out. You can float through the whole thing if you have to."}},{"k":"swim_parallel_to_the_shore","v":{"s":"Swim PARALLEL to the shore."}},{"k":"rip_currents_are_narrow_after_30_100_f","v":{"s":" Rip currents are narrow. After 30-100 feet of parallel swimming you will be in normal water and can swim back to shore at an angle."}},{"k":"if_you_cannot_escape_signal_and_float","v":{"s":"If you cannot escape, signal and float."}},{"k":"wave_one_arm_and_yell_a_lifeguard_or_b","v":{"s":" Wave one arm and yell. A lifeguard or bystander can throw a flotation device. The current will eventually weaken (rip currents end past the breakers)."}},{"k":"if_you_see_someone_else_in_a_rip","v":{"s":"If you see someone else in a rip:"}},{"k":"do_not_swim_out_to_them_throw_flotatio","v":{"s":" do NOT swim out to them. Throw flotation, alert lifeguards, call 911. Untrained rescuers drown in rip currents at high rates trying to save someone."}},{"k":"noaa_rip_current_safety","v":{"s":"NOAA Rip Current Safety"}},{"k":"us_lifesaving_association_usla_rip_cur","v":{"s":"US Lifesaving Association (USLA) — Rip Currents"}},{"k":"nws_gray_maine_forecast_office_beach_h","v":{"s":"NWS Gray (Maine forecast office) — Beach Hazards"}},{"k":"cdc_drowning_prevention_2","v":{"s":"CDC: Drowning prevention"}},{"k":"you_cannot_help_someone_you_do_not_rea","v":{"s":"You cannot help someone you do not realize is drowning. And once you realize it, the strongest urge is to jump in. Both of those instincts are wrong. This module covers "}},{"k":"drowning_it_does_not_look_like_the_mov","v":{"s":" drowning (it does not look like the movies) and "}},{"k":"without_becoming_the_second_victim","v":{"s":" without becoming the second victim."}},{"k":"real_drowning_looks_almost_nothing_lik","v":{"s":"Real drowning looks almost nothing like the movies. There is no yelling for help. There is no waving of arms. There is no thrashing. A drowning person's body is doing one thing: trying to keep the airway above water. Speech is secondary to breathing — they cannot call out. Arms are pressing instinctively down on the surface to lift the head — they cannot wave. The whole event lasts only "}},{"k":"20_to_60_seconds","v":{"s":"20 to 60 seconds"}},{"k":"before_submersion_if_you_do_not_know_w","v":{"s":" before submersion. If you do not know what to look for, you will miss it standing 10 feet away."}},{"k":"the_instinctive_drowning_response_five","v":{"s":"The Instinctive Drowning Response — five visible signs (Mario Vittone)"}},{"k":"head_low_in_the_water_mouth_at_water_l","v":{"s":"Head low in the water, mouth at water level. "}},{"k":"often_tilted_back_with_the_mouth_open_","v":{"s":"Often tilted back with the mouth open. The person looks like they are trying to drink the water."}},{"k":"eyes_are_glassy_and_empty_or_closed","v":{"s":"Eyes are glassy and empty, or closed. "}},{"k":"they_cannot_focus_a_person_with_eyes_c","v":{"s":"They cannot focus. A person with eyes closed in the water who is not playing a game is in trouble."}},{"k":"hair_may_be_over_the_forehead_or_eyes","v":{"s":"Hair may be over the forehead or eyes. "}},{"k":"they_will_not_push_it_away_their_hands","v":{"s":"They will not push it away — their hands are needed elsewhere."}},{"k":"body_is_vertical_in_the_water_no_kick","v":{"s":"Body is vertical in the water, no kick. "}},{"k":"swimmers_move_horizontally_drowning_pe","v":{"s":"Swimmers move horizontally. Drowning people are upright, treading silently and ineffectively."}},{"k":"ladder_climbing_pressing_down_on_the_s","v":{"s":"\"Ladder climbing\" — pressing down on the surface. "}},{"k":"arms_extend_laterally_and_press_down_i","v":{"s":"Arms extend laterally and press down, instinctively trying to leverage the body up out of the water. From shore this looks like \"playing in the water.\" It is not."}},{"k":"lie_or_kneel_on_a_stable_surface_dock_","v":{"s":"Lie or kneel on a stable surface (dock, shore, edge of pool). Extend a pole, branch, oar, towel, shirt, or even your leg. Stay anchored — do not let the victim pull you in. Pull them to safety hand-over-hand."}},{"k":"throw_a_flotation_device_life_ring_thr","v":{"s":"Throw a flotation device — life ring, throw bag, cooler, empty milk jug with cap, even a tied-off plastic trash bag with air. Aim slightly past the victim and drag it back to them. Yell instructions: \"GRAB THIS, KICK YOUR FEET, I AM PULLING YOU IN.\""}},{"k":"use_a_boat_kayak_canoe_paddleboard_row","v":{"s":"Use a boat — kayak, canoe, paddleboard, rowboat. Approach with the bow toward the victim. Have them grab the back, not the side. NEVER let them climb in over the side — they will flip you. Tow them to shore."}},{"k":"do_not_enter_the_water_unless_you_are_","v":{"s":"Do not enter the water unless you are a trained lifeguard or rescue swimmer. Panicked drowning victims grab anything that floats — including you — and push it under. The leading cause of death in would-be rescuers is being drowned by the person they tried to save."}},{"k":"a_teenager_is_struggling_about_30_feet","v":{"s":"A teenager is struggling about 30 feet from shore in a Maine lake. There is a kayak with a paddle nearby on the beach. You can swim, but you have never done a water rescue. What is the right play?"}},{"k":"mario_vittone_drowning_doesn_t_look_li","v":{"s":"Mario Vittone — \"Drowning Doesn't Look Like Drowning\""}},{"k":"the_canonical_public_facing_essay_on_t","v":{"s":"The canonical public-facing essay on the Instinctive Drowning Response. Originally published in On Scene magazine (2006) by Dr. Francesco A. Pia and refined by Vittone."}},{"k":"american_red_cross_water_safety","v":{"s":"American Red Cross — Water Safety"}},{"k":"ymca_aquatic_standards","v":{"s":"YMCA Aquatic Standards"}},{"k":"cdc_unintentional_drowning_statistics","v":{"s":"CDC: Unintentional Drowning Statistics"}},{"k":"dan_divers_alert_network_in_water_resc","v":{"s":"DAN (Divers Alert Network) — In-water Rescue Principles"}},{"k":"us_lifesaving_association_usla","v":{"s":"US Lifesaving Association (USLA)"}},{"k":"a_properly_fitted_us_coast_guard_appro","v":{"s":"A properly fitted, US Coast Guard-approved Personal Flotation Device (PFD) is the single highest-leverage piece of safety equipment in any boat or near any open water. The numbers are stark."}},{"k":"offshore","v":{"s":"Offshore"}},{"k":"near_shore_buoyant_vest","v":{"s":"Near-shore Buoyant Vest"}},{"k":"flotation_aid","v":{"s":"Flotation Aid"}},{"k":"throwable","v":{"s":"Throwable"}},{"k":"special_use","v":{"s":"Special Use"}},{"k":"per_maine_title_12_inland_fisheries_wi","v":{"s":"Per Maine Title 12 (Inland Fisheries & Wildlife) and applicable federal USCG rules. "}},{"k":"always_check_the_current_statute_at_th","v":{"s":"Always check the current statute at the Maine IFW link in the Sources block"}},{"k":"boating_law_gets_updated_and_a_tool_pu","v":{"s":" — boating law gets updated, and a tool published in one year is not a substitute for the current rule."}},{"k":"you_buy_a_child_s_life_jacket_you_do_t","v":{"s":"You buy a child's life jacket. You do the lift test on shore: when you lift at the shoulders, the jacket comes up to the child's ears. The salesperson says it will be fine in the water and the child will \"grow into it.\" What do you do?"}},{"k":"us_coast_guard_recreational_boating_st","v":{"s":"US Coast Guard — Recreational Boating Statistics"}},{"k":"us_coast_guard_life_jacket_wear_inform","v":{"s":"US Coast Guard — Life Jacket Wear Information"}},{"k":"maine_department_of_inland_fisheries_w","v":{"s":"Maine Department of Inland Fisheries & Wildlife — Boating Laws"}},{"k":"authoritative_source_for_current_maine","v":{"s":"Authoritative source for current Maine boating PFD law; check here before relying on summaries."}},{"k":"maine_revised_statutes_title_12_inland","v":{"s":"Maine Revised Statutes Title 12 (Inland Fisheries & Wildlife)"}},{"k":"13056_a_children_under_10_13056_pfds_a","v":{"s":"§13056-A (children under 10), §13056 (PFDs aboard), §13068-A (personal watercraft)."}},{"k":"uscg_33_cfr_part_175_equipment_require","v":{"s":"USCG 33 CFR Part 175 — Equipment requirements"}},{"k":"safe_kids_worldwide_life_jacket_safety","v":{"s":"Safe Kids Worldwide — Life Jacket Safety"}},{"k":"heads_up_2","v":{"s":"Heads up: "}},{"k":"this_module_covers_ice_break_through_s","v":{"s":"this module covers ice break-through scenarios including snowmobile incidents. Content is practical, not graphic, but the topic is serious."}},{"k":"maine_has_more_frozen_surface_water_in","v":{"s":"Maine has more frozen surface water in winter than almost any state in the lower 48. Every year, people fall through ice on lakes, ponds, and rivers — ice fishers, snowmobilers, kids playing, dogs and the people who chase them. The good news: cold water self-rescue is teachable, and the survival timeline is longer than people think."}},{"k":"you_have_time_the_1_1_10_rule_applies_","v":{"s":"You have time. The 1-1-10 rule applies (1 minute to control breathing, 10 minutes of useful arm strength, 1 hour before unconsciousness). Use that first minute deliberately."}},{"k":"do_not_panic_float_face_up","v":{"s":"Do not panic. Float face-up. "}},{"k":"the_gasp_reflex_will_pass_in_60_second","v":{"s":"The gasp reflex will pass in 60 seconds. Do not try to scramble out yet. Get your breathing under control."}},{"k":"turn_back_the_way_you_came","v":{"s":"Turn back the way you came. "}},{"k":"the_ice_you_walked_on_held_you_the_ice","v":{"s":"The ice you walked on held you. The ice ahead just failed. Face the direction you came from."}},{"k":"get_your_forearms_flat_on_the_ice","v":{"s":"Get your forearms flat on the ice. "}},{"k":"spread_your_weight_if_you_have_ice_pic","v":{"s":"Spread your weight. If you have ice picks (Picks of Life), use them now to get traction."}},{"k":"kick_hard_horizontally","v":{"s":"Kick HARD horizontally. "}},{"k":"get_your_body_horizontal_in_the_water_","v":{"s":"Get your body horizontal in the water — like you are swimming. Kick hard with your legs while pulling yourself up onto the ice. Your goal is to slide out, not climb out."}},{"k":"roll_away_do_not_stand","v":{"s":"Roll away. Do not stand. "}},{"k":"once_on_the_ice_roll_away_from_the_hol","v":{"s":"Once on the ice, ROLL away from the hole, do not stand. Standing concentrates your weight at one point and you may break through again. Roll until you are on ice you know is solid."}},{"k":"get_warm_immediately","v":{"s":"Get warm immediately. "}},{"k":"cold_incapacitation_continues_out_of_t","v":{"s":"Cold incapacitation continues out of the water. Get to shelter. Change into dry clothes. Warm core (chest, neck, groin) before extremities. See the Hypothermia module."}},{"k":"you_see_a_person_fall_through_ice_on_a","v":{"s":"You see a person fall through ice on a pond about 100 feet from shore. There is a long rope in your truck. You can ice skate. Two strangers are nearby. What is your best move?"}},{"k":"maine_department_of_inland_fisheries_w_2","v":{"s":"Maine Department of Inland Fisheries & Wildlife — Ice Safety"}},{"k":"cold_water_safety_coldwatersafety_org","v":{"s":"Cold Water Safety (coldwatersafety.org)"}},{"k":"vermont_fish_wildlife_ice_safety_guide","v":{"s":"Vermont Fish & Wildlife — Ice Safety Guidelines"}},{"k":"cold_water_boot_camp_mario_vittone_2","v":{"s":"Cold Water Boot Camp (Mario Vittone)"}},{"k":"hypothermia_is_core_body_temperature_d","v":{"s":"Hypothermia is core body temperature dropping below 95°F (35°C). It does not require ice or even cold weather — it can happen in 60°F water in summer or 50°F air in spring rain. Recognizing it early and treating it correctly is the difference between a story and a tragedy."}},{"k":"rubbing_pushes_cold_blood_from_the_arm","v":{"s":"Rubbing pushes cold blood from the arms and legs back to the warming core. This \"afterdrop\" can cause cardiac arrest."}},{"k":"alcohol_dilates_skin_blood_vessels_and","v":{"s":"Alcohol dilates skin blood vessels and accelerates heat loss. Folk wisdom is wrong here."}},{"k":"sudden_warming_of_cold_extremities_ret","v":{"s":"Sudden warming of cold extremities returns cold blood to the core too fast. Slow rewarming with warm packs to chest, neck, and groin is correct."}},{"k":"a_cold_heart_is_electrically_unstable_","v":{"s":"A cold heart is electrically unstable. Bumping, jostling, or rough handling can trigger ventricular fibrillation. Move them gently."}},{"k":"the_maxim_is_not_dead_until_warm_and_d","v":{"s":"The maxim is \"not dead until warm and dead.\" Continue CPR through transport. There are documented full recoveries from core temperatures below 60°F."}},{"k":"a_person_is_pulled_from_cold_water_unc","v":{"s":"A person is pulled from cold water unconscious, not breathing, no pulse. Their core temperature is estimated below 82°F. What is the right approach?"}},{"k":"wilderness_medical_society_practice_gu","v":{"s":"Wilderness Medical Society — Practice Guidelines for Hypothermia"}},{"k":"nols_wilderness_medicine_hypothermia","v":{"s":"NOLS Wilderness Medicine — Hypothermia"}},{"k":"aha_cold_emergencies","v":{"s":"AHA — Cold Emergencies"}},{"k":"cold_water_boot_camp","v":{"s":"Cold Water Boot Camp"}},{"k":"pool_drain_entrapment_is_rare_but_cata","v":{"s":"Pool drain entrapment is rare but catastrophic. A pool pump can generate suction strong enough to hold an adult underwater. Federal law has specific requirements for drain covers since 2008, but old pools, broken covers, and home pools may not be compliant. This module teaches what to look for and what to do."}},{"k":"long_hair_drawn_into_the_drain_by_suct","v":{"s":"Long hair drawn into the drain by suction and tangled. Common in girls and women."}},{"k":"arm_leg_or_finger_pulled_into_the_drai","v":{"s":"Arm, leg, or finger pulled into the drain opening. Suction can break bones during extraction."}},{"k":"torso_held_against_the_drain_by_suctio","v":{"s":"Torso held against the drain by suction. The most lethal type — adult-strength forces."}},{"k":"suction_pulls_intestines_through_the_a","v":{"s":"Suction pulls intestines through the anus. Catastrophic injury. Specific to flat drain covers and small bodies."}},{"k":"jewelry_swimsuit_strings_etc_caught_in","v":{"s":"Jewelry, swimsuit strings, etc. caught in drain hardware."}},{"k":"pool_safely_cpsc","v":{"s":"Pool Safely (CPSC)"}},{"k":"cpsc_virginia_graeme_baker_pool_and_sp","v":{"s":"CPSC — Virginia Graeme Baker Pool and Spa Safety Act"}},{"k":"cdc_drowning_prevention_3","v":{"s":"CDC — Drowning Prevention"}},{"k":"heads_up_3","v":{"s":"Heads up: "}},{"k":"this_module_discusses_elevated_drownin","v":{"s":"this module discusses elevated drowning risk in autistic children and prevention strategies. Content is matter-of-fact and oriented toward action; no blame language toward families."}},{"k":"this_module_is_shorter_than_the_others","v":{"s":"This module is shorter than the others but covers the highest-stakes content. Autistic children drown at dramatically higher rates than the general pediatric population. Most schools and many parents have never heard the numbers. The intervention is layered prevention, not blame."}},{"k":"no_single_layer_is_sufficient_stack_mu","v":{"s":"No single layer is sufficient. Stack multiple layers. If one fails, the others catch."}},{"k":"physical_barriers","v":{"s":"Physical barriers. "}},{"k":"pool_fences_with_self_closing_self_lat","v":{"s":"Pool fences with self-closing, self-latching gates (height per local code, typically 4 ft minimum). Door alarms on every door leading outside. Pool covers when not in use. For at-risk students, additional gate locks at heights beyond the child's reach."}},{"k":"electronic_alarms","v":{"s":"Electronic alarms. "}},{"k":"door_alarms_cheap_10_20_pool_surface_a","v":{"s":"Door alarms (cheap, $10-20). Pool surface alarms (motion sensors floating on the pool surface). GPS tracking devices for high-elopement-risk students (Project Lifesaver, AngelSense, similar)."}},{"k":"adapted_swim_instruction","v":{"s":"Adapted swim instruction. "}},{"k":"survival_swim_training_adapted_for_sen","v":{"s":"Survival swim training adapted for sensory needs. The goal is not \"competitive swimmer\" — the goal is \"can roll onto back, breathe, and stay afloat for several minutes.\" Programs like Infant Swimming Resource (ISR) and many YMCAs offer adaptive sessions."}},{"k":"bright_colored_swimsuits","v":{"s":"Bright-colored swimsuits. "}},{"k":"use_neon_yellow_orange_or_pink_never_b","v":{"s":"Use NEON YELLOW, ORANGE, or PINK. NEVER blue, green, white, or gray — those colors are nearly invisible against pool bottoms or lake water. This single change can mean the difference between a lifeguard spotting a submerged child in 5 seconds vs 50."}},{"k":"id_jewelry_clothing","v":{"s":"ID jewelry / clothing. "}},{"k":"wearable_id_with_name_diagnosis_family","v":{"s":"Wearable ID with name, diagnosis, family contact. Important if the child elopes and is found by strangers who may misinterpret behavior as defiance, intoxication, or hostility."}},{"k":"constant_supervision_near_water","v":{"s":"Constant supervision near water. "}},{"k":"touch_supervision_within_arm_s_reach_f","v":{"s":"Touch supervision (within arm's reach) for any child who cannot self-rescue. No phones, no looking away, no relying on other children to \"watch.\""}},{"k":"family_neighbor_school_awareness","v":{"s":"Family + neighbor + school awareness. "}},{"k":"tell_neighbors_so_they_know_to_call_yo","v":{"s":"Tell neighbors so they know to call you immediately if they see the child. Tell school staff. Tell first responders. The more people who know, the faster the response if the child elopes."}},{"k":"a_family_is_buying_their_autistic_chil","v":{"s":"A family is buying their autistic child their first swimsuit for summer. The child loves blue and wants a blue one. The store has yellow, orange, pink, white, and blue available. What do you suggest?"}},{"k":"national_autism_association_autism_saf","v":{"s":"National Autism Association — Autism Safety Toolkit"}},{"k":"aap_prevention_of_drowning_policy_stat","v":{"s":"AAP — Prevention of Drowning Policy Statement"}},{"k":"autistic_self_advocacy_network_asan","v":{"s":"Autistic Self-Advocacy Network (ASAN)"}},{"k":"project_lifesaver_international_gps_tr","v":{"s":"Project Lifesaver International (GPS tracking for elopement risk)"}},{"k":"infant_swimming_resource_isr_self_resc","v":{"s":"Infant Swimming Resource (ISR) — Self-Rescue"}},{"k":"special_olympics_aquatics","v":{"s":"Special Olympics — Aquatics"}},{"k":"alive_solutions_swimsuit_color_visibil","v":{"s":"Alive Solutions — Swimsuit Color Visibility Tests"}},{"k":"usa_swimming_foundation_make_a_splash_","v":{"s":"USA Swimming Foundation — Make a Splash (scholarships)"}},{"k":"retake_quiz","v":{"s":"Retake quiz"}},{"k":"back_to_menu","v":{"s":"← Back to menu"}},{"k":"review_these_specific_gaps","v":{"s":"📍 Review these specific gaps"}},{"k":"you_missed","v":{"s":"You missed "}},{"k":"each_card_below_names_the_module_that_","v":{"s":". Each card below names the module that covers that gap."}},{"k":"module","v":{"s":"Module"}},{"k":"review","v":{"s":"Review →"}},{"k":"your_answer","v":{"s":"Your answer: "}},{"k":"right_answer_2","v":{"s":"Right answer: "}},{"k":"question","v":{"s":"Question "}},{"k":"score","v":{"s":" · score "}},{"k":"try_again_3","v":{"s":"↺ Try again"}},{"k":"ai_tutor_is_not_available_in_this_buil","v":{"s":"AI tutor is not available in this build. Try the modules or Resources tab."}},{"k":"type_a_water_safety_question_the_ai_gr","v":{"s":"Type a water safety question. The AI grounds its answer in CDC, USCG, AAP, NOAA, NAA, ASAN, and other primary sources cited throughout this lab. "}},{"k":"educational_only","v":{"s":"Educational only."}},{"k":"real_emergencies_need_911_not_a_chatbo","v":{"s":" Real emergencies need 911, not a chatbot."}},{"k":"your_question","v":{"s":"Your question:"}},{"k":"e_g_how_long_can_a_person_survive_in_5","v":{"s":"e.g. \"How long can a person survive in 50°F water?\" or \"What's the safest swim suit color for my non-verbal son?\""}},{"k":"clear","v":{"s":"Clear"}},{"k":"clear_all_saved_ai_answers","v":{"s":"Clear all saved AI answers"}},{"k":"clear_history","v":{"s":"Clear history"}},{"k":"get_certified_learn_to_swim","v":{"s":"Get certified / learn to swim"}},{"k":"american_red_cross_swimming_water_safe","v":{"s":"American Red Cross — Swimming & Water Safety classes"}},{"k":"ymca_aquatics_programs_2","v":{"s":"YMCA — Aquatics programs"}},{"k":"usa_swimming_foundation_make_a_splash__2","v":{"s":"USA Swimming Foundation — Make a Splash (scholarships, find lessons)"}},{"k":"infant_swimming_resource_isr_self_resc_2","v":{"s":"Infant Swimming Resource (ISR) — Self-Rescue"}},{"k":"drowning_prevention_authorities","v":{"s":"Drowning prevention authorities"}},{"k":"cdc_drowning_prevention_4","v":{"s":"CDC — Drowning Prevention"}},{"k":"national_drowning_prevention_alliance__2","v":{"s":"National Drowning Prevention Alliance (NDPA)"}},{"k":"stop_drowning_now","v":{"s":"Stop Drowning Now"}},{"k":"aap_policy_statement_prevention_of_dro_2","v":{"s":"AAP Policy Statement — Prevention of Drowning"}},{"k":"mario_vittone_drowning_doesn_t_look_li_2","v":{"s":"Mario Vittone — \"Drowning Doesn't Look Like Drowning\""}},{"k":"cold_water_ice_safety","v":{"s":"Cold water + ice safety"}},{"k":"cold_water_boot_camp_mario_vittone_3","v":{"s":"Cold Water Boot Camp (Mario Vittone)"}},{"k":"cold_water_safety","v":{"s":"Cold Water Safety"}},{"k":"maine_department_of_inland_fisheries_w_3","v":{"s":"Maine Department of Inland Fisheries & Wildlife — Ice Safety"}},{"k":"beach_open_water","v":{"s":"Beach + open water"}},{"k":"noaa_rip_current_safety_2","v":{"s":"NOAA Rip Current Safety"}},{"k":"us_lifesaving_association_usla_2","v":{"s":"US Lifesaving Association (USLA)"}},{"k":"nws_gray_maine_beach_hazards","v":{"s":"NWS Gray (Maine) — Beach Hazards"}},{"k":"boating_pfds","v":{"s":"Boating + PFDs"}},{"k":"us_coast_guard_recreational_boating_sa","v":{"s":"US Coast Guard — Recreational Boating Safety"}},{"k":"maine_ifw_boating_laws","v":{"s":"Maine IFW — Boating Laws"}},{"k":"safe_kids_worldwide_water_safety","v":{"s":"Safe Kids Worldwide — Water Safety"}},{"k":"pool_spa_safety","v":{"s":"Pool + spa safety"}},{"k":"pool_safely_cpsc_2","v":{"s":"Pool Safely (CPSC)"}},{"k":"virginia_graeme_baker_pool_spa_safety_","v":{"s":"Virginia Graeme Baker Pool & Spa Safety Act"}},{"k":"hypothermia_wilderness_medicine","v":{"s":"Hypothermia / wilderness medicine"}},{"k":"wilderness_medical_society","v":{"s":"Wilderness Medical Society"}},{"k":"nols_wilderness_medicine","v":{"s":"NOLS Wilderness Medicine"}},{"k":"aha_cold_emergencies_2","v":{"s":"AHA — Cold Emergencies"}},{"k":"autism_water_safety","v":{"s":"Autism + water safety"}},{"k":"national_autism_association_autism_saf_2","v":{"s":"National Autism Association — Autism Safety Toolkit"}},{"k":"autistic_self_advocacy_network_asan_2","v":{"s":"Autistic Self-Advocacy Network (ASAN)"}},{"k":"project_lifesaver_international_gps_fo","v":{"s":"Project Lifesaver International (GPS for elopement)"}},{"k":"angelsense_gps_tracking","v":{"s":"AngelSense (GPS tracking)"}},{"k":"special_olympics_aquatics_2","v":{"s":"Special Olympics — Aquatics"}},{"k":"alive_solutions_swimsuit_color_visibil_2","v":{"s":"Alive Solutions — Swimsuit Color Visibility Tests"}},{"k":"maine_ymca_chapters_find_a_pool","v":{"s":"Maine YMCA chapters (find a pool)"}},{"k":"maine_warden_service_911_for_water_eme","v":{"s":"Maine Warden Service (911 for water emergencies)"}},{"k":"maine_marine_patrol","v":{"s":"Maine Marine Patrol"}},{"k":"every_organization_cited_in_this_lab_p","v":{"s":"Every organization cited in this lab, plus adaptive swim resources and Maine-specific links. Bookmark the Make a Splash scholarship link if cost is a barrier to lessons."}},{"k":"elite_efficiency","v":{"s":"🏊 Elite efficiency"}},{"k":"high_distance_per_stroke_balanced_kick","v":{"s":"High distance per stroke, balanced kick, optimal rate."}},{"k":"efficient_stroke","v":{"s":"🟢 Efficient stroke"}},{"k":"good_fundamentals_sustainable_for_dist","v":{"s":"Good fundamentals. Sustainable for distance."}},{"k":"recreational","v":{"s":"🟡 Recreational"}},{"k":"casual_swimming_tires_sooner","v":{"s":"Casual swimming. Tires sooner."}},{"k":"inefficient_stroke","v":{"s":"🔴 Inefficient stroke"}},{"k":"wasted_energy_suboptimal_length_or_kic","v":{"s":"Wasted energy. Suboptimal length or kick."}},{"k":"stroke_efficiency_discovery","v":{"s":"🏊 Stroke efficiency discovery"}},{"k":"sliders_for_stroke_rate_length_per_str","v":{"s":"Sliders for stroke rate, length per stroke, kick intensity. Discrete 4-state efficiency. No score, no reveal."}},{"k":"efficiency_versus_stroke_rate_with_you","v":{"s":"Efficiency versus stroke rate. With your current length and kick, efficiency peaks at a moderate stroke rate near 50, not at the fastest rate."}},{"k":"optimal_rate","v":{"s":"optimal rate"}},{"k":"stroke_rate","v":{"s":"Stroke rate →"}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_rate_vs_length_which_matter","v":{"s":"Hypothesis: Rate vs length — which matters more?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"elite_swimmers_use_slower_stroke_rate_","v":{"s":"Elite swimmers use slower stroke rate, longer pulls. Why?"}},{"k":"what_happens_with_super_fast_rate_but_","v":{"s":"What happens with super-fast rate but tiny length?"}},{"k":"i_understand_explain_in_own_words","v":{"s":"I understand — explain in own words"}},{"k":"explain_stroke_efficiency_physics","v":{"s":"Explain stroke efficiency physics."}},{"k":"design_note_discrete_4_state_stroke_ma","v":{"s":"Design note: discrete 4-state stroke marker; no time score; no reveal — by design."}},{"k":"swimlab_error","v":{"s":"SwimLab error: "}},{"k":"readiness_label","v":{"s":"Water safety readiness"}},{"k":"readiness_blurb","v":{"s":"Learn the physiology, physics, and decisions behind safer swimming, cold-water survival, and bystander rescue."}},{"k":"education_status","v":{"s":"Education only - in an emergency, call 911"}},{"k":"progress_label","v":{"s":"SwimLab progress"}},{"k":"safety_essentials","v":{"s":"Safety essentials"}},{"k":"modules_explored","v":{"s":"Modules explored"}},{"k":"badges","v":{"s":"Badges"}},{"k":"recommended_next","v":{"s":"Recommended next"}},{"k":"continue_essentials","v":{"s":"Continue safety essentials"}},{"k":"continue_learning","v":{"s":"Continue learning"}},{"k":"choose_review","v":{"s":"Choose a module to review"}},{"k":"essential_route","v":{"s":"Three life-saving essentials"}},{"k":"essential_route_blurb","v":{"s":"Start with the modules most likely to change a real-world decision."}},{"k":"full_catalog","v":{"s":"Explore all modules, practice, and resources"}},{"k":"stroke_phase_diagram","v":{"s":"Swimming stroke phase diagram"}},{"k":"clear_history_confirmation_unavailable","v":{"s":"Confirmation is unavailable, so your saved answers were not changed."}},{"k":"clear_history_confirmation","v":{"s":"Clear all saved AI answers? This cannot be undone."}},{"k":"clear_history_confirmation_title","v":{"s":"Clear saved AI answers?"}},{"k":"keep_saved_answers","v":{"s":"Keep answers"}},{"k":"clear_history_confirmation_failed","v":{"s":"The confirmation could not open, so your saved answers were not changed."}},{"k":"saved_answers_kept","v":{"s":"Saved answers kept."}},{"k":"history_cleared","v":{"s":"History cleared."}},{"k":"hypothesis_input","v":{"s":"Stroke-efficiency hypothesis"}},{"k":"explanation_input","v":{"s":"Stroke-efficiency explanation"}}],"id":584}},{"k":"synth","v":{"o":[{"k":"ud83dudcbe_composition","v":{"s":"💾 Composition "}},{"k":"ud83cudfb5_loaded","v":{"s":"🎵 Loaded "}},{"k":"ud83duddd1_deleted","v":{"s":"🗑 Deleted "}},{"k":"happy_bright_the_most_common","v":{"s":"Happy, bright. The most common Western scale."}},{"k":"sad_dark_introspective","v":{"s":"Sad, dark, introspective."}},{"k":"exotic_dramatic_classical","v":{"s":"Exotic, dramatic, classical."}},{"k":"smooth_jazzy_sophisticated","v":{"s":"Smooth, jazzy, sophisticated."}},{"k":"universal_folk_rock","v":{"s":"Universal, folk, rock."}},{"k":"blues_rock_universal","v":{"s":"Blues, rock, universal."}},{"k":"soulful_gritty_expressive","v":{"s":"Soulful, gritty, expressive."}},{"k":"jazz_funk_sophisticated_minor","v":{"s":"Jazz, funk, sophisticated minor."}},{"k":"rock_folk_dominant_feel","v":{"s":"Rock, folk, dominant feel."}},{"k":"spanish_flamenco_metal","v":{"s":"Spanish, flamenco, metal."}},{"k":"dreamy_ethereal_film_scores","v":{"s":"Dreamy, ethereal, film scores."}},{"k":"mysterious_ambiguous_dreamlike","v":{"s":"Mysterious, ambiguous, dreamlike."}},{"k":"all_12_notes_complete_but","v":{"s":"All 12 notes. Complete but atonal."}},{"k":"happy_stable_resolved","v":{"s":"Happy, stable, resolved."}},{"k":"sad_introspective_dark","v":{"s":"Sad, introspective, dark."}},{"k":"tense_unstable_needs_to_resolve","v":{"s":"Tense, unstable, needs to resolve."}},{"k":"mysterious_unresolved_eerie","v":{"s":"Mysterious, unresolved, eerie."}},{"k":"smooth_lush_jazzy","v":{"s":"Smooth, lush, jazzy."}},{"k":"cool_mellow_relaxed","v":{"s":"Cool, mellow, relaxed."}},{"k":"bluesy_restless_wants_to_resolve","v":{"s":"Bluesy, restless, wants to resolve."}},{"k":"open_modern_shimmering","v":{"s":"Open, modern, shimmering."}},{"k":"suspended_yearning_to_resolve","v":{"s":"Suspended, yearning to resolve."}},{"k":"raw_strong_genredefining","v":{"s":"Raw, strong, genre-defining."}},{"k":"warm_jazzy_classic","v":{"s":"Warm, jazzy, classic."}},{"k":"sophisticated_minor","v":{"s":"Sophisticated minor."}},{"k":"bright_open_modern_pop","v":{"s":"Bright, open, modern pop."}},{"k":"rich_funky_bluesy","v":{"s":"Rich, funky, bluesy."}},{"k":"dreamy_lush","v":{"s":"Dreamy, lush."}},{"k":"cool_sophisticated","v":{"s":"Cool, sophisticated."}},{"k":"full_orchestral_complex","v":{"s":"Full, orchestral, complex."}},{"k":"symmetrical_passing","v":{"s":"Symmetrical, passing."}},{"k":"pure_tone_fundamental_only","v":{"s":"Pure tone, fundamental only"}},{"k