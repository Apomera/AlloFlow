ding..."}},{"k":"map_header","v":{"s":"Current model map (what the app requests)"}},{"k":"no_calls_yet","v":{"s":"No AI calls completed yet this session. Run an audit, generate text, or use any AI feature to populate."}},{"k":"not_in_catalog","v":{"s":"not in catalog"}},{"k":"not_in_catalog_tt","v":{"s":"This override is not in your current model catalog — may 404 at request time"}},{"k":"overridden_tt","v":{"s":"You have overridden this slot"}},{"k":"quota_hit","v":{"s":"Quota limit (HTTP 429) hit this session"}},{"k":"quota_hit_advice","v":{"s":"If retries keep failing, the daily quota is spent — free-tier quotas reset around midnight Pacific."}},{"k":"quota_ok","v":{"s":"No quota errors this session."}},{"k":"refresh","v":{"s":"Fetch catalog"}},{"k":"reload_hint","v":{"s":"Reload the page after changing a model override for it to take effect."}},{"k":"served_header","v":{"s":"Models actually used this session"}},{"k":"served_hint","v":{"s":"⇄ marks a row where Google served a different model than the one requested (silent reroute by the API)."}},{"k":"slot_aria","v":{"s":"Model override for slot"}},{"k":"unreported","v":{"s":"(unreported)"}},{"k":"usage_calls","v":{"s":"AI call(s):"}},{"k":"usage_caveat","v":{"s":"Honest limits of this meter: Google does not let apps see your remaining balance, so this counts AlloFlow’s own calls and resets when the page reloads. A 429 error is the only definitive “quota reached” signal — when one happens, a red banner appears at the top of the app (dismissable) and it’s recorded here."}},{"k":"usage_header","v":{"s":"Your Gemini usage (this session)"}},{"k":"usage_none","v":{"s":"No AI calls yet this session."}},{"k":"use_default_prefix","v":{"s":"Use app default"}}],"id":764}},{"k":"onboarding","v":{"o":[{"k":"ask_allobot_aria","v":{"s":"Open AlloBot onboarding help"}},{"k":"ask_allobot_label","v":{"s":"Not sure? Ask AlloBot"}},{"k":"coach_ask_disclosure","v":{"s":"Have a question? Ask AlloBot"}},{"k":"coach_cancel","v":{"s":"Cancel"}},{"k":"coach_consent_accept","v":{"s":"I understand — start using AlloBot"}},{"k":"coach_consent_body","v":{"s":"AlloBot is powered by Google Gemini. When you ask a question, the text you type is sent over the internet to Google's servers and may be logged there. AlloFlow blocks student data from your screen automatically, but it cannot read your mind — please do not type student names, ID numbers, test scores, addresses, or birthdays into the chat. Ask about strategies and tools in general terms."}},{"k":"coach_consent_decline","v":{"s":"Not now"}},{"k":"coach_consent_required","v":{"s":"Consent required."}},{"k":"coach_consent_title","v":{"s":"A heads-up about AlloBot"}},{"k":"coach_conversation_aria","v":{"s":"AlloBot conversation"}},{"k":"coach_cooldown","v":{"s":"One moment…"}},{"k":"coach_error","v":{"s":"Something went wrong."}},{"k":"coach_injection","v":{"s":"Can only help with onboarding."}},{"k":"coach_input_aria","v":{"s":"Ask AlloBot a question"}},{"k":"coach_input_placeholder","v":{"s":"Ask AlloBot anything about getting started…"}},{"k":"coach_limit_reached","v":{"s":"You've used today's coach quota. Reload to reset."}},{"k":"coach_network_error","v":{"s":"Network problem."}},{"k":"coach_no_backend","v":{"s":"AlloBot Coach needs Google Gemini."}},{"k":"coach_no_backend_body","v":{"s":"Switch your AI backend to Google Gemini in Settings, or use the static help cards above."}},{"k":"coach_no_backend_title","v":{"s":"AlloBot Coach needs Google Gemini."}},{"k":"coach_off_topic","v":{"s":"Off topic."}},{"k":"coach_pii","v":{"s":"Looks like student data."}},{"k":"coach_pii_high_advice","v":{"s":"AlloBot will scrub this before sending. To send anyway, rephrase without identifiers."}},{"k":"coach_pii_high_warn","v":{"s":"Looks like student data."}},{"k":"coach_pii_low_advice","v":{"s":"AlloBot can scrub the name before sending, or you can send as typed."}},{"k":"coach_pii_low_warn","v":{"s":"Looks like a real name."}},{"k":"coach_questions_remaining","v":{"s":"questions left this session"}},{"k":"coach_rate_limit","v":{"s":"You've used today's coach quota."}},{"k":"coach_reply_announce_prefix","v":{"s":"AlloBot replied: "}},{"k":"coach_reset_conversation","v":{"s":"Start over"}},{"k":"coach_retry","v":{"s":"Try again"}},{"k":"coach_safety","v":{"s":"Cannot answer that."}},{"k":"coach_send","v":{"s":"Send question to AlloBot"}},{"k":"coach_sending","v":{"s":"…"}},{"k":"coach_thinking","v":{"s":"AlloBot is thinking…"}},{"k":"coach_thinking_long","v":{"s":"Still working — Gemini is taking a moment."}},{"k":"coach_too_long","v":{"s":"Question too long."}},{"k":"coach_upstream","v":{"s":"AlloBot is taking a quick breather."}},{"k":"educator_best_if","v":{"s":"Best if you’re a teacher, clinician, or school psychologist on a password-protected workstation."}},{"k":"full_best_if","v":{"s":"Best if you want full control and you’re comfortable exploring on your own."}},{"k":"guided_best_if","v":{"s":"Best if you’re brand new and want a calmer interface that holds your hand at each step."}},{"k":"learning_tools_best_if","v":{"s":"Best if you’re a student or independent learner who wants to jump into activities right away."}},{"k":"open_settings","v":{"s":"Open settings"}},{"k":"panel_footer","v":{"s":"You can change modes any time. Just close this and click whichever card looks right."}},{"k":"panel_open_announcement","v":{"s":"AlloBot onboarding open. Four mode options are listed: Full AlloFlow, Guided Mode, Learning Tools, and Educator Tools. A Start the Tour button is at the bottom."}},{"k":"panel_subtitle","v":{"s":"Pick the option that best fits how you’ll use AlloFlow today."}},{"k":"panel_title","v":{"s":"Hi! I’m AlloBot."}},{"k":"show_offline_help","v":{"s":"Show offline help"}},{"k":"start_tour_cta","v":{"s":"Start the tour"}},{"k":"tour_offer_desc","v":{"s":"I’ll walk you through the workspace before you pick a mode."}},{"k":"tour_offer_title","v":{"s":"Want me to show you around first?"}},{"k":"tour_starting_speech","v":{"s":"Starting the tour."}},{"k":"tts_test_cue","v":{"s":"Voice on. I will read help out loud."}},{"k":"tts_toggle_label","v":{"s":"Read help aloud"}},{"k":"tts_toggle_sublabel","v":{"s":"Off by default. If you use a screen reader, leave this off — your reader already reads this panel."}},{"k":"tts_unavailable_globally_muted","v":{"s":"Sound is muted globally. Un-mute in the main toolbar to hear AlloBot."}}],"id":765}},{"k":"palette","v":{"o":[{"k":"aria","v":{"s":"AlloFlow command palette"}},{"k":"close","v":{"s":"Close command palette"}},{"k":"command_progress","v":{"s":"Command progress"}},{"k":"confirm","v":{"s":"Press Enter again to confirm."}},{"k":"dismiss_progress","v":{"s":"Dismiss progress for {label}"}},{"k":"escape_key","v":{"s":"Esc"}},{"k":"footer","v":{"s":"Every action is announced. Ctrl+K toggles."}},{"k":"group","v":{"o":[{"k":"favorites","v":{"s":"Favorites"}},{"k":"frequent","v":{"s":"Frequently used"}},{"k":"recent","v":{"s":"Recent"}}],"id":767}},{"k":"input_aria","v":{"s":"Search commands"}},{"k":"list_aria","v":{"s":"Matching commands"}},{"k":"nav","v":{"s":"navigate"}},{"k":"no_match","v":{"s":"No matching command. The bot chat (and soon voice) understands free-form requests."}},{"k":"pin_favorite","v":{"s":"Pin to favorites"}},{"k":"pin_selected_favorite","v":{"s":"Pin selected command to favorites"}},{"k":"placeholder","v":{"s":"Type a command — “bigger text”, “educator hub”, “read this page”…"}},{"k":"remove_favorite","v":{"s":"Remove from favorites"}},{"k":"remove_selected_favorite","v":{"s":"Remove selected command from favorites"}},{"k":"run","v":{"s":"run"}},{"k":"unavailable","v":{"s":"This command is not available in the current context."}}],"id":766}},{"k":"plan","v":{"o":[{"k":"empty","v":{"s":"There were no steps to run."}},{"k":"needs_confirm","v":{"s":" needs its own confirmation — run it from the Ctrl+K menu."}},{"k":"step_failed","v":{"s":"That step didn’t work."}},{"k":"step_timeout","v":{"s":" is taking a while and is still working in the background. I’ve held the remaining steps — once it finishes, ask me again for the rest."}},{"k":"stopped","v":{"s":"Stopped before step "}},{"k":"unavailable","v":{"s":"Step "}},{"k":"unavailable2","v":{"s":" isn’t available right now — it may need something an earlier step didn’t produce."}}],"id":768}},{"k":"ptour","v":{"o":[{"k":"altformats_text","v":{"s":"The same accessible content as braille-ready text, ePub for e-readers, plain text, and Markdown.\n**Why it matters:** accessibility isn't one format — a student with low vision may want ePub's reflowing text, while your district's braille transcriber wants the braille-ready file as a starting point. That's the tour — the ? button gives per-button help anywhere."}},{"k":"altformats_title","v":{"s":"More ways to share"}},{"k":"audit_text","v":{"s":"Prefer to look before fixing? Run Audit scores the document and shows every issue first — you choose Fix & Verify when you're ready.\n**Why it matters:** for sensitive documents (IEP-adjacent, anything going in a student file), seeing the issues before any rewriting happens keeps you in control of every change."}},{"k":"audit_title","v":{"s":"The careful path"}},{"k":"branding_text","v":{"s":"The accessible copy can match your original's colors, use a clean preset, or pick up your school's branding from a letterhead.\n**Why it matters:** every option is contrast-checked before it ships — a document students can't read isn't accessible no matter how good its tags are. Accessibility and looking professional aren't in tension here."}},{"k":"branding_title","v":{"s":"Make it look right"}},{"k":"dashboard_text","v":{"s":"This bar sticks to the top while you scroll. The score shows before → after; the chips jump straight to any section — Downloads is the one you'll use most.\n**Why it matters:** everything below is organized into sections (verification, recovered content, remaining issues, downloads, the tag inspector) — the chips mean you never scroll hunting for one."}},{"k":"dashboard_title","v":{"s":"Your navigation bar"}},{"k":"fillable_text","v":{"s":"Turns blanks and checkboxes into REAL typed-into form fields — review the detected list first, then download fillable HTML or a tagged fillable PDF. Students with dysgraphia type instead of handwriting."}},{"k":"fillable_title","v":{"s":"Make it fillable"}},{"k":"hero_text","v":{"s":"Make Accessible runs everything automatically: audit → fix → re-check until it hits the target → downloads ready. For most documents, this is all you need.\n**Why it matters:** the pipeline is built to be safe unattended — content is never silently dropped (anything unplaceable lands in a visible Recovery section), and the AI's work is re-checked by rule engines every pass."}},{"k":"hero_title","v":{"s":"The one-click path"}},{"k":"plain_text","v":{"s":"Rewrites the full document in plain language (pick the grade band). Facts kept, structure verified, original stays authoritative — and it gets its own compare, audio, and tagged PDF."}},{"k":"plain_title","v":{"s":"Easy-read version"}},{"k":"report_text","v":{"s":"Printable accessibility reports — for your records, an IEP file, or your district accessibility coordinator. There's also a tamper-evident signed version.\n**Why it matters:** public schools have legal accessibility obligations (ADA Title II). A dated report showing what was checked and fixed is the paper trail your district wants to have."}},{"k":"report_title","v":{"s":"Reports & records"}},{"k":"save_text","v":{"s":"Save Project keeps the whole session as one file — reload it later and everything returns. A backup also saves automatically after each remediation.\n**Why it matters:** in Gemini Canvas, nothing survives closing the tab EXCEPT downloaded files — the project file IS your save, and it carries your remediation history and settings too. That's the tour — hit Make Accessible when ready!"}},{"k":"save_title","v":{"s":"You can always come back"}},{"k":"score_text","v":{"s":"AlloFlow's own estimate: several independent AI reviews averaged, blended 50/50 with TWO deterministic rule engines (axe-core + IBM Equal Access — when they disagree, the lower score wins).\n**Why it matters:** it's honest but it's not a certification. For independent checks, use PAC or veraPDF, then review reading order and meaning with a screen reader and an accessibility specialist."}},{"k":"score_title","v":{"s":"The score, honestly"}},{"k":"settings_text","v":{"s":"The defaults are sensible. If you ever need to: more audit passes = steadier score, the target score decides when the automatic loop stops.\n**Why it matters:** more passes cost more of your daily AI quota and more time — the defaults balance reliability against both. The usage meter in AI settings shows what a run actually costs."}},{"k":"settings_title","v":{"s":"Settings (optional)"}},{"k":"tabs_text","v":{"s":"Flip to the Original tab anytime to see what the document looked like before the fixes.\n**Why it matters:** when a parent, administrator, or IEP team asks \"what actually changed?\", the answer is one click — and the Compare view shows both versions side by side."}},{"k":"tabs_title","v":{"s":"Before and after"}},{"k":"translate_text","v":{"s":"Translate the whole document for families — type ANY language. The structure is checked section by section, the copy gets compare/audio/tagged-PDF downloads of its own, and a review banner keeps it honest.\n**Why it matters:** IDEA requires parent-language access to key documents — districts pay per page for this."}},{"k":"translate_title","v":{"s":"Any language, verified"}},{"k":"whatnow_text","v":{"s":"This strip is your map: grab the recommended download, optionally compare before/after, and treat everything else on this screen as optional polish.\n**Why it matters:** this screen has over 300 elements — most are for digging deeper, not required. The strip names the one action that gets a usable document into students' hands."}},{"k":"whatnow_title","v":{"s":"Start here"}}],"id":769}},{"k":"readinglib_book_resource","v":{"s":"Illustrated story"}},{"k":"readinglib_docbuilder_added","v":{"s":"📄 Passage added — opening the Document Builder."}},{"k":"readinglib_passage","v":{"s":"Reading passage"}},{"k":"renderers","v":{"o":[{"k":"error_invalid_text_format","v":{"s":"Error: Invalid text format"}}],"id":770}},{"k":"research_hub","v":{"o":[{"k":"ai_calls_exhausted","v":{"s":"AI question quota used. Static help still available."}},{"k":"ai_calls_remaining_suffix","v":{"s":"AI questions left this session"}},{"k":"ai_convention_banner","v":{"s":"AlloBot helps by asking questions and surfacing alternatives. It will not write your model, your hypothesis, your argument, or your trade-off decisions for you. You author your work; AlloBot critiques."}},{"k":"back_to_lanes","v":{"s":"Choose a different lane"}},{"k":"confirm_reset","v":{"s":"All portfolio artifacts, sources, voice notes, method episodes, models, and AI history will be cleared. This cannot be undone."}},{"k":"dev_level_aria","v":{"s":"Select developmental level for prompts and rubrics"}},{"k":"dev_level_label","v":{"s":"Reading level"}},{"k":"educator_view_back","v":{"s":"Exit educator view"}},{"k":"educator_view_error","v":{"s":"The educator dashboard failed to render. Toggling back to student view."}},{"k":"educator_view_exit","v":{"s":"Return to student view"}},{"k":"educator_view_missing","v":{"s":"No educator view registered yet. Load research_hub_educator_module.js to enable."}},{"k":"educator_view_off","v":{"s":"Educator view"}},{"k":"educator_view_on","v":{"s":"Educator view"}},{"k":"educator_view_toggle_aria","v":{"s":"Toggle educator view"}},{"k":"educator_view_toggle_title","v":{"s":"Educator view — read-only inquiry trajectory"}},{"k":"exemplar_pair_prompt","v":{"s":"Which of these is stronger work, and why?"}},{"k":"exemplar_pair_reasoning_placeholder","v":{"s":"In 1–2 sentences: which is stronger, and what makes it stronger?"}},{"k":"exemplar_pair_record","v":{"s":"Record my judgment"}},{"k":"footer_persistence_note","v":{"s":"Your Inquiry Portfolio is saved on this device. Switching codenames mid-investigation will show prior work — clear the inquiry above to start fresh."}},{"k":"footer_tier_note","v":{"s":"Empirical · design · interpretive · qualitative · civic · creative inquiry."}},{"k":"journal_reset","v":{"s":"Reset this inquiry"}},{"k":"journal_state_summary","v":{"s":"Inquiry Portfolio"}},{"k":"lane_coming_soon","v":{"s":"Failed to load"}},{"k":"lane_preview_summary","v":{"s":"Preview the loop"}},{"k":"lane_render_error","v":{"s":"The selected lane failed to render. Going back to the lane selector."}},{"k":"lane_selector_help","v":{"s":"Six approaches open three connected workspaces. Your question, sources, evidence, voice notes, models, framings, and revision history stay together in one Inquiry Portfolio."}},{"k":"lane_under_construction_body","v":{"s":"The Hub and your inquiry journal are working. This lane’s workspace failed to load — try closing and reopening the Research Hub, or reload the page."}},{"k":"lane_under_construction_title","v":{"s":"This lane didn’t load."}},{"k":"method_selector_title","v":{"s":"Choose an inquiry approach (switch any time)"}},{"k":"modal_subtitle","v":{"s":"Investigate, interpret, design, source, and revise in one connected Inquiry Portfolio."}},{"k":"modal_subtitle_with_codename","v":{"s":"Inquiry Portfolio for "}},{"k":"modal_title","v":{"s":"Research & Inquiry Hub"}},{"k":"question_help","v":{"s":"A few words in your own voice. You can change this any time as your question evolves — loops are first-class here."}},{"k":"question_label","v":{"s":"What are you investigating?"}},{"k":"question_placeholder","v":{"s":"e.g., \"Why do the fish in fisherlab cluster at dawn?\" or \"How should our town respond to noise complaints?\""}},{"k":"reset_title","v":{"s":"Reset this inquiry?"}},{"k":"scratch_voice_help","v":{"s":"Talk through your thinking. Voice notes live in your inquiry journal and survive across stages and lanes."}},{"k":"scratch_voice_label","v":{"s":"Scratchpad voice note"}},{"k":"scratch_voice_summary","v":{"s":"Open a voice scratchpad"}},{"k":"voice_note","v":{"s":"Voice note"}},{"k":"voice_note_clear","v":{"s":"Clear"}},{"k":"voice_note_idle","v":{"s":"Up to 60s — local only"}},{"k":"voice_note_mic_denied","v":{"s":"Microphone permission was denied."}},{"k":"voice_note_pause","v":{"s":"Pause"}},{"k":"voice_note_pause_aria","v":{"s":"Pause voice note recording"}},{"k":"voice_note_pause_unsupported","v":{"s":"Pause is not supported in this browser. Stop and start a new note instead."}},{"k":"voice_note_paused","v":{"s":"Paused"}},{"k":"voice_note_recording","v":{"s":"Recording"}},{"k":"voice_note_rerecord","v":{"s":"Re-record"}},{"k":"voice_note_resume","v":{"s":"Resume"}},{"k":"voice_note_resume_aria","v":{"s":"Resume voice note recording"}},{"k":"voice_note_start","v":{"s":"Record"}},{"k":"voice_note_start_aria","v":{"s":"Start recording a voice note"}},{"k":"voice_note_stop","v":{"s":"Stop"}},{"k":"voice_note_stop_aria","v":{"s":"Stop recording"}},{"k":"voice_note_unsupported","v":{"s":"Voice notes are not supported in this browser."}},{"k":"ai_calls_remaining_prefix","v":{"s":"AI questions remaining: "}}],"id":771}},{"k":"resource","v":{"o":[{"k":"whiteboard_meta","v":{"s":"Drawn in the AlloFlow Whiteboard"}}],"id":772}},{"k":"router","v":{"o":[{"k":"done","v":{"s":"Done."}},{"k":"failed","v":{"s":"That did not work: "}},{"k":"still_working","v":{"s":"Still working - it will finish in the background."}}],"id":773}},{"k":"save","v":{"o":[{"k":"decrypt_failed","v":{"s":"Wrong password, or the file is corrupt."}},{"k":"encrypt_failed","v":{"s":"Could not encrypt the file. Save cancelled."}},{"k":"encrypted_title","v":{"s":"Encrypted project"}},{"k":"enter_password","v":{"s":"This project is password-protected. Enter the password to open it."}},{"k":"open_project","v":{"s":"Open project"}},{"k":"password_dialog_loading","v":{"s":"The password dialog is still loading. Please wait a moment and try again."}}],"id":774}},{"k":"scientific","v":{"o":[{"k":"acknowledge_superseded","v":{"s":"I understand — keep as a record"}},{"k":"add_card_button","v":{"s":"+ Add card"}},{"k":"add_evidence_label","v":{"s":"Log an evidence card"}},{"k":"another_reading_label","v":{"s":"AI offers another reading (additional, not the alternative)"}},{"k":"ask_another_button","v":{"s":"Show me another reading"}},{"k":"asking","v":{"s":"Asking…"}},{"k":"assumption_probes_label","v":{"s":"Questions about phrases from your model"}},{"k":"assumptions_required_label","v":{"s":"Questions about what would have to hold:"}},{"k":"back_to_hub_lanes","v":{"s":"Choose a different lane"}},{"k":"blocked_generic","v":{"s":"AI couldn't help with that — try again later."}},{"k":"blocked_prefix","v":{"s":"AI helper paused:"}},{"k":"claim_placeholder","v":{"s":"A specific claim about your investigation…"}},{"k":"claims_help","v":{"s":"Claims should be ABOUT what you investigated. Label EACH yourself before AI questions your labels."}},{"k":"claims_label","v":{"s":"Your claims (≥2; label each honestly)"}},{"k":"comparison_help","v":{"s":"Given OUR evidence: which reading is stronger, and what additional evidence would distinguish them? You author this — AI does not."}},{"k":"comparison_label","v":{"s":"Compare the readings:"}},{"k":"confidence_label","v":{"s":"Confidence:"}},{"k":"coverage_questions_label","v":{"s":"Questions about coverage:"}},{"k":"cross_cutting_exemplars_title","v":{"s":"How is strong inquiry recognized? (cross-cutting examples)"}},{"k":"cycle_center_label","v":{"s":"Loops are first-class. Click any stage."}},{"k":"cycle_nav_aria","v":{"s":"Phenomenon Workbench cycle navigation"}},{"k":"disconfirmer_label","v":{"s":"Questions about what would disconfirm this:"}},{"k":"draft_model_label","v":{"s":"Draft your current model"}},{"k":"educator_panel_p1","v":{"s":"This lane is intentionally NOT linear. The 6-stage cycle is a thinking loop, not a checklist. A student who loops back 3+ times — because new evidence surprised them, or a peer review changed their mind — is doing BETTER science than one who walks 1→6 once and never revises."}},{"k":"educator_panel_p2","v":{"s":"When grading, weight the loop log + model-version trajectory + claim labeling honesty AS MUCH OR MORE than the final stage-6 artifact. PHEOC linearity is a textbook fiction; real inquiry is iterative and serendipitous. AI here asks questions and surfaces alternatives — it never proposes finished revisions, finished models, or finished interpretations."}},{"k":"educator_panel_p3","v":{"s":"Two cross-cutting rubric exemplars at lane exit reward loop-back density and model-trajectory depth specifically. Grade with those."}},{"k":"educator_panel_summary","v":{"s":"For teachers: why this lane is intentionally non-linear"}},{"k":"evidence_placeholder","v":{"s":"What did you observe / measure / find? Be specific."}},{"k":"exemplar_required_prefix","v":{"s":"Before AI can help here:"}},{"k":"exemplar_required_suffix","v":{"s":"check this example pair (1 min)."}},{"k":"exemplar_skip","v":{"s":"I've got it — skip without judging"}},{"k":"expected_column","v":{"s":"Expected"}},{"k":"known_unknowns_label","v":{"s":"What you do NOT know yet (be honest):"}},{"k":"known_unknowns_placeholder","v":{"s":"e.g., I don't know whether the wire's material matters or just its thickness."}},{"k":"loopback_commit","v":{"s":"Loop back to "}},{"k":"loopback_modal_help","v":{"s":"Loops are evidence of thinking change — not setbacks. Your downstream work stays; you can return to where you were."}},{"k":"loopback_modal_title","v":{"s":"Why are you looping back?"}},{"k":"loopback_other_placeholder","v":{"s":"Briefly: what made you loop back? (≥10 chars)"}},{"k":"method_menu_title","v":{"s":"Pick a method (none is \"best\" — each has trade-offs)"}},{"k":"model_placeholder","v":{"s":"What do you think is happening, and WHY? Name the things involved and how you think they relate. It is fine — and useful — to be tentative."}},{"k":"no_evidence_yet","v":{"s":"Nothing yet."}},{"k":"no_snapshots_yet","v":{"s":"No model snapshots yet. Save one to start the trajectory."}},{"k":"per_claim_label","v":{"s":"Questions about your labels"}},{"k":"plan_no_ai_note","v":{"s":"There's no AI helper on this stage by design — picking a method is your call."}},{"k":"question_my_labels","v":{"s":"Question my labels"}},{"k":"questioning","v":{"s":"Questioning…"}},{"k":"questions_to_consider_label","v":{"s":"More questions to consider:"}},{"k":"return_to_where_i_was","v":{"s":"Return to where I was: "}},{"k":"review_exemplar_again","v":{"s":"Review the example pair again"}},{"k":"revised_model_help","v":{"s":"What changed in your thinking, and why? Save a new snapshot."}},{"k":"revised_model_label","v":{"s":"Revised model (becomes vN+1 snapshot)"}},{"k":"revised_unknowns_placeholder","v":{"s":"What is still unknown at this version?"}},{"k":"revision_obs_label","v":{"s":"Questions about what changed:"}},{"k":"revision_reflection_help","v":{"s":"Articulate what shifted between your v1 model and now — in your own words."}},{"k":"revision_reflection_label","v":{"s":"What changed in your thinking? (export gate, ≥40 chars)"}},{"k":"save_revised_snapshot","v":{"s":"Save revised snapshot"}},{"k":"save_snapshot","v":{"s":"Save model snapshot"}},{"k":"sort_button","v":{"s":"Sort my wonderings"}},{"k":"sorted_label","v":{"s":"Your wonderings sorted"}},{"k":"sorting","v":{"s":"Sorting…"}},{"k":"sr_looped_back","v":{"s":"Looped back to "}},{"k":"sr_now_on","v":{"s":"Now on: "}},{"k":"sr_work_preserved","v":{"s":"Your earlier work is preserved; you can return to where you were."}},{"k":"superseded_banner","v":{"s":"Your work here was written against earlier upstream content. The upstream changed; this is preserved as a record of your earlier thinking."}},{"k":"surface_button","v":{"s":"Surface my model"}},{"k":"surfacing","v":{"s":"Surfacing…"}},{"k":"surprise_check","v":{"s":"Didn't expect this"}},{"k":"surprise_column","v":{"s":"Didn't expect this"}},{"k":"timeline_label","v":{"s":"Model trajectory"}},{"k":"timeline_revision_after_loop","v":{"s":"Revision after looping back from: "}},{"k":"timeline_unknowns_at_v","v":{"s":"Known unknowns at this version:"}},{"k":"what_cant_tell","v":{"s":"What this method CAN'T tell you:"}},{"k":"what_cant_tell_placeholder","v":{"s":"Be honest about the method's limits…"}},{"k":"why_method_fits","v":{"s":"Why does THIS method fit MY question?"}},{"k":"why_method_placeholder","v":{"s":"Explain in your own words…"}},{"k":"wondering_placeholder","v":{"s":"I wonder whether…"}},{"k":"wonderings_help","v":{"s":"List at least "}},{"k":"wonderings_title","v":{"s":"Your wonderings"}},{"k":"your_assumptions_help","v":{"s":"What would have to be true for your reading to hold?"}},{"k":"your_assumptions_label","v":{"s":"Assumptions YOUR OWN reading requires (one per line, ≥2)"}},{"k":"your_disconfirmers_help","v":{"s":"What evidence would tell you your reading is wrong?"}},{"k":"your_disconfirmers_label","v":{"s":"What would disconfirm YOUR OWN reading (one per line, ≥2)"}},{"k":"your_reading_help","v":{"s":"What do YOU think the data shows? Be specific. ≥40 chars."}},{"k":"your_reading_label","v":{"s":"Your reading of the evidence"}},{"k":"your_steelman_help","v":{"s":"Argue the other side as strongly as you can. Try \"Someone could reasonably read this as …\". ≥50 chars."}},{"k":"your_steelman_label","v":{"s":"Your steelman of an OPPOSING reading"}}],"id":775}},{"k":"sdturbo","v":{"o":[{"k":"downloading","v":{"s":"Downloading the local image generator (~2 GB). Keep working — a toast will confirm when it’s ready."}},{"k":"failed","v":{"s":"The local image generator could not load on this device."}},{"k":"offer_accept","v":{"s":"Download (~2 GB)"}},{"k":"offer_body","v":{"s":"Cloud image generation is unavailable right now (no key, or the daily limit was reached). AlloFlow can download a local image generator (about 2 GB, one time) that makes simpler images right on this device — private, free, and it works offline."}},{"k":"offer_decline","v":{"s":"Not now"}},{"k":"offer_title","v":{"s":"Keep making images — locally"}},{"k":"ready","v":{"s":"Local image generator ready — images will be made on this device while the cloud is unavailable."}}],"id":776}},{"k":"takehome","v":{"o":[{"k":"banner_count","v":{"s":"resources from your teacher"}},{"k":"banner_label","v":{"s":"Saved homework"}},{"k":"banner_title","v":{"s":"Homework saved on this device"}},{"k":"clear","v":{"s":"Remove saved homework from this device"}},{"k":"directions_added","v":{"s":"Directions added to the class pack — they sync to students automatically."}},{"k":"directions_empty","v":{"s":"Write the directions first — students see them as the front page of the assignment."}},{"k":"download","v":{"s":"Download a backup file (for a different device)"}},{"k":"empty_pack","v":{"s":"Your teacher sent homework, but no resources have arrived yet — stay connected a moment and ask them to resend."}},{"k":"evidence_caveat","v":{"s":"student-device reported — formative, not a grade"}},{"k":"evidence_goals","v":{"s":"goals"}},{"k":"evidence_recorded","v":{"s":"recorded"}},{"k":"evidence_self","v":{"s":"self-checked"}},{"k":"evidence_title","v":{"s":"Homework check-ins"}},{"k":"open","v":{"s":"Open"}},{"k":"save_failed","v":{"s":"This device would not save the homework — use the Download button on the homework banner to keep a file copy."}},{"k":"loaded","v":{"s":"Homework loaded: {title}"}},{"k":"saved","v":{"s":"📥 {title} saved to THIS device ({count} resources). Open AlloFlow at home to continue — no code needed."}}],"id":777}},{"k":"video_ref","v":{"o":[{"k":"attach_btn","v":{"s":"Choose file…"}},{"k":"attach_busy","v":{"s":"Opening the file…"}},{"k":"attach_failed","v":{"s":"Could not open that file: "}},{"k":"attach_hint","v":{"s":"Have the downloaded file? Drop the .webm/.mp4 or .allopack here to play it on this device — nothing is uploaded."}},{"k":"badge_captions","v":{"s":"captions"}},{"k":"badge_chapters","v":{"s":"chapters"}},{"k":"badge_descriptions","v":{"s":"visual descriptions"}},{"k":"badge_localizations","v":{"s":"localizations"}},{"k":"captions_track","v":{"s":"Captions"}},{"k":"close","v":{"s":"Close video card"}},{"k":"current_description","v":{"s":"Current visual description: "}},{"k":"default_title","v":{"s":"Video"}},{"k":"descriptions_ignored","v":{"s":"Video opened, but its visual descriptions were ignored because that file was not valid."}},{"k":"descriptions_summary","v":{"s":"Descriptions are separate from captions. They appear at their reviewed timestamps; choose a time to move the video there."}},{"k":"descriptions_title","v":{"s":"Reviewed visual descriptions"}},{"k":"descriptions_track","v":{"s":"Visual descriptions"}},{"k":"mismatch","v":{"s":"This file does not match the saved checksum. It may be a different export of the same lesson — check before sharing."}},{"k":"no_hosted_hint","v":{"s":"Tip: in Video Studio’s gallery you can paste a hosted link (YouTube/Drive/LMS) so colleagues can watch without the file."}},{"k":"player_title","v":{"s":"Video reference"}},{"k":"thumb_alt","v":{"s":"Video thumbnail"}},{"k":"verified","v":{"s":"File verified — matches the checksum saved with this card."}},{"k":"watch_hosted","v":{"s":"Watch hosted video"}}],"id":778}},{"k":"work_story","v":{"o":[{"k":"hide","v":{"s":"Hide the details"}},{"k":"kept","v":{"s":"What this keeps:"}},{"k":"never","v":{"s":"What it never keeps:"}},{"k":"show","v":{"s":"See everything in it"}},{"k":"title","v":{"s":"Your Work Story"}}],"id":779}},{"k":"view_announcer","v":{"o":[{"k":"loaded_prefix","v":{"s":"View loaded:"}}],"id":780}},{"k":"content","v":{"o":[{"k":"sources_unverified_note","v":{"s":"These sources were surfaced by AI-assisted search and have not been independently verified — confirm each one before citing it."}}],"