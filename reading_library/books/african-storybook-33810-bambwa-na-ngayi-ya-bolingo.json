  "pages": [
    {
      "n": 1,
      "img": null,
      "text": "Mama na ngayi azwelaka ngayi ba mbwa ya bana mibale. Bazalaka kitoko makasi!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=1",
      "sourceDigest": "sha256:ad41b54994ccd186c13d0fa7eb0e67daf4d64426abc75637fa7f668cdb69d758"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400151.png",
      "text": "Nazuaka mokano ya kopesa bango kombo ya Royalty na Blackie.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=2",
      "sourceDigest": "sha256:961276546cac46115be0b364200cbda16c250e227215c92c3ac142ba7ee51afa"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400152.png",
      "text": "Royalty azalaki na langi ya kaki pe azalaki lokola mwasi ya mokonzi. Blackie azalaki mbwa ya bolingo na langi ya moyindo na ba suki ya milayi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=3",
      "sourceDigest": "sha256:631d8df5efba9d0a94d25b1899b8e447eae012b6b9d3c98f61878fd4e59b6366"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400153.png",
      "text": "Namesanaki ko tambwisa bango mikolo nionso soki nawuti eteyelo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=4",
      "sourceDigest": "sha256:a76e4d5b3b6aca191e9787b8109963bee15b177f5ec0074abe58de47a9a11c5a"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400154.png",
      "text": "Tango mosusu na sokolaka bango ngayi moko. Royalty azalaki kokima tango nioso!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=5",
      "sourceDigest": "sha256:e92ac5c79cef5a978962c985b96730861e6ec383f179fd61b9b5517ba0ac7ab6"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400155.png",
      "text": "Pena sima tolongwaka pe tokenda na ndako ya etage. Pe kuna balingaka bambwa te.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=6",
      "sourceDigest": "sha256:86371b677cc953ac83256152ba50894915ed22103acc182016393d22de94a8be"
    },
    {
      "n": 7,
      "img": null,
      "text": "Bongo totikaka Blackie na Royalty epayi ya bana ya mama leki na ngayi. Natongo moko, nazwaka mokano ya kokende kotala bambwa na ngayi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=7",
      "sourceDigest": "sha256:40f400f85d3a4b73fa4578a604c1ee75ee7f6dcf0fa772dbea5ae3b75121a80f"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/91400156.png",
      "text": "Nakutaki ke Blackie abunga, pe Royalty azalaki kaka ye moko. Nayokaka mabe makasi na motema na ngayi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33810#page=8",
      "sourceDigest": "sha256:45e12c7e7fa46b1550cee93eaca49758bbff3faa6ecd3eb38b0b35a7e627515e"
    }
