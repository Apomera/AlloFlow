 white flame"}},{"k":"most_abundant_metal_in_earth","v":{"s":"Most abundant metal in Earth\\"}},{"k":"semiconductor_that_powers_the_digital","v":{"s":"Semiconductor that powers the digital age"}},{"k":"essential_for_dna_and_bones","v":{"s":"Essential for DNA and bones; glows in the dark"}},{"k":"yellow_element_with_distinctive_rottenegg","v":{"s":"Yellow element with distinctive rotten-egg smell"}},{"k":"greenishyellow_gas_used_to_purify","v":{"s":"Greenish-yellow gas used to purify water"}},{"k":"third_most_abundant_gas_in","v":{"s":"Third most abundant gas in atmosphere"}},{"k":"essential_nutrient_found_in_bananas","v":{"s":"Essential nutrient found in bananas"}},{"k":"builds_bones_and_teeth_5th","v":{"s":"Builds bones and teeth; 5th most abundant element"}},{"k":"most_used_metal_core_of","v":{"s":"Most used metal; core of Earth is mostly iron"}},{"k":"reddish_metal_used_since_the","v":{"s":"Reddish metal used since the Bronze Age"}},{"k":"bluishwhite_metal_that_prevents_rust","v":{"s":"Bluish-white metal that prevents rust"}},{"k":"best_conductor_of_electricity_among","v":{"s":"Best conductor of electricity among all metals"}},{"k":"dense_soft_shiny_precious_metal","v":{"s":"Dense, soft, shiny precious metal — never rusts"}},{"k":"strong_as_steel_but_45","v":{"s":"Strong as steel but 45% lighter"}},{"k":"shiny_metal_that_gives_rubies","v":{"s":"Shiny metal that gives rubies their red color"}},{"k":"essential_for_steel_production_and","v":{"s":"Essential for steel production and bone health"}},{"k":"corrosionresistant_metal_used_in_coins","v":{"s":"Corrosion-resistant metal used in coins worldwide"}},{"k":"only_nonmetal_liquid_at_room","v":{"s":"Only non-metal liquid at room temperature"}},{"k":"essential_trace_element_for_thyroid","v":{"s":"Essential trace element for thyroid function"}},{"k":"precious_metal_rarer_than_gold","v":{"s":"Precious metal rarer than gold"}},{"k":"dense_radioactive_metal_that_powers","v":{"s":"Dense radioactive metal that powers nuclear plants"}},{"k":"only_metal_liquid_at_room","v":{"s":"Only metal liquid at room temperature"}},{"k":"dense_soft_metal_once_used","v":{"s":"Dense, soft metal once used in pipes & paint"}},{"k":"soft_silvery_metal_used_since","v":{"s":"Soft, silvery metal used since the Bronze Age"}},{"k":"has_the_highest_melting_point","v":{"s":"Has the highest melting point of all metals"}},{"k":"essential_for_life","v":{"s":"Essential for life"}},{"k":"carbon_dioxide","v":{"s":"Carbon Dioxide"}},{"k":"greenhouse_gas","v":{"s":"Greenhouse gas"}},{"k":"sodium_chloride","v":{"s":"Sodium chloride"}},{"k":"cleaning_agent","v":{"s":"Cleaning agent"}},{"k":"methane","v":{"s":"Methane"}},{"k":"natural_gas","v":{"s":"Natural gas"}},{"k":"hydrogen_peroxide","v":{"s":"Hydrogen Peroxide"}},{"k":"disinfectant","v":{"s":"Disinfectant"}},{"k":"ethanol","v":{"s":"Ethanol"}},{"k":"alcohol","v":{"s":"Alcohol"}},{"k":"sulfuric_acid","v":{"s":"Sulfuric Acid"}},{"k":"battery_acid","v":{"s":"Battery acid"}},{"k":"glucose","v":{"s":"Glucose"}},{"k":"blood_sugar","v":{"s":"Blood sugar"}},{"k":"baking_soda","v":{"s":"Baking Soda"}},{"k":"sodium_bicarbonate","v":{"s":"Sodium bicarbonate"}},{"k":"chalk_marble","v":{"s":"Chalk & marble"}},{"k":"rust","v":{"s":"Rust"}},{"k":"sodium_hydroxide","v":{"s":"Sodium Hydroxide"}},{"k":"lye_caustic_soda","v":{"s":"Lye / caustic soda"}},{"k":"hydrochloric_acid","v":{"s":"Hydrochloric Acid"}},{"k":"stomach_acid","v":{"s":"Stomach acid"}},{"k":"acetic_acid","v":{"s":"Acetic Acid"}},{"k":"vinegar","v":{"s":"Vinegar"}},{"k":"nitrogen_dioxide","v":{"s":"Nitrogen Dioxide"}},{"k":"brown_smog_gas","v":{"s":"Brown smog gas"}},{"k":"sulfur_dioxide","v":{"s":"Sulfur Dioxide"}},{"k":"acid_rain_precursor","v":{"s":"Acid rain precursor"}},{"k":"ozone","v":{"s":"Ozone"}},{"k":"uv_shield","v":{"s":"UV shield"}},{"k":"laughing_gas","v":{"s":"Laughing Gas"}},{"k":"nitrous_oxide","v":{"s":"Nitrous oxide"}},{"k":"silicon_dioxide","v":{"s":"Silicon Dioxide"}},{"k":"sand_glass","v":{"s":"Sand & glass"}},{"k":"hu2082o","v":{"s":"H₂O"}},{"k":"cou2082","v":{"s":"CO₂"}},{"k":"chu2084","v":{"s":"CH₄"}},{"k":"nacl","v":{"s":"NaCl"}},{"k":"nhu2083","v":{"s":"NH₃"}}],"id":559}},{"k":"physics","v":{"o":[{"k":"sr_explanation_ready","v":{"s":"Explanation ready."}},{"k":"a11y_range_estimation_comparison_and_reflection","v":{"s":"Range estimation comparison and reflection"}},{"k":"a11y_how_the_measured_range_affected_the_estimate","v":{"s":"How the measured range affected the estimate"}},{"k":"angle_u00b0","v":{"s":"Angle (°)"}},{"k":"velocity_ms","v":{"s":"Velocity (m/s)"}},{"k":"gravity_msu00b2","v":{"s":"Gravity (m/s²)"}},{"k":"loading","v":{"s":"Loading..."}},{"k":"target_cadet_1","v":{"s":"Cadet 1"}},{"k":"target_r1_desc","v":{"s":"Angle locked at 45°. Calculate velocity to hit 80m."}},{"k":"target_cadet_2","v":{"s":"Cadet 2"}},{"k":"target_r2_desc","v":{"s":"Velocity locked at 35 m/s. Calculate angle to hit 120m."}},{"k":"target_cadet_3","v":{"s":"Cadet 3"}},{"k":"target_r3_desc","v":{"s":"Angle locked at 30°. Hit the 60m crate."}},{"k":"target_gunner_1","v":{"s":"Gunner 1"}},{"k":"target_r4_desc","v":{"s":"Velocity locked at 40 m/s. Hit 150m."}},{"k":"target_gunner_2","v":{"s":"Gunner 2"}},{"k":"target_r5_desc","v":{"s":"On the Moon! Angle locked at 55°. Hit 100m."}},{"k":"target_gunner_3","v":{"s":"Gunner 3"}},{"k":"target_r6_desc","v":{"s":"Two targets! Angle locked at 40°. Hit both."}},{"k":"target_sniper_1","v":{"s":"Sniper 1"}},{"k":"target_r7_desc","v":{"s":"Air drag ON! Angle locked at 35°. Compensate!"}},{"k":"target_sniper_2","v":{"s":"Sniper 2"}},{"k":"target_r8_desc","v":{"s":"Mars gravity. Velocity locked at 45 m/s. Hit 200m."}},{"k":"target_sniper_3","v":{"s":"Sniper 3"}},{"k":"target_r9_desc","v":{"s":"Triple targets! Same angle, adjust velocity each shot."}},{"k":"target_ace","v":{"s":"Ace"}},{"k":"target_r10_desc","v":{"s":"Final challenge: drag ON, velocity locked at 38 m/s. Prove your mastery."}},{"k":"preset_earth","v":{"s":"Earth"}},{"k":"preset_moon","v":{"s":"Moon"}},{"k":"preset_mars","v":{"s":"Mars"}},{"k":"preset_jupiter","v":{"s":"Jupiter"}},{"k":"challenge_land_50m","v":{"s":"Land at 50m"}},{"k":"challenge_hit_100m_flag","v":{"s":"Hit the 100m flag"}},{"k":"challenge_reach_200m","v":{"s":"Reach 200m range"}},{"k":"next_predict_then_launch","v":{"s":"Predict the range, then launch once and compare the result."}},{"k":"next_turn_on_vectors","v":{"s":"Turn on vectors or energy and explain what changes during flight."}},{"k":"next_one_controlled_change","v":{"s":"Use one controlled change to improve your next target attempt."}},{"k":"next_change_only_one","v":{"s":"Change only angle, velocity, or gravity and compare the new trajectory."}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"projectile_mission","v":{"s":"Projectile mission"}},{"k":"physics_simulator","v":{"s":"Physics Simulator"}},{"k":"tool_intro_blurb","v":{"s":"Investigate how launch conditions shape motion, then support each claim with trajectory evidence."}},{"k":"recommended_next_move","v":{"s":"Recommended next move"}},{"k":"metric_angle","v":{"s":"Angle"}},{"k":"metric_speed","v":{"s":"Speed"}},{"k":"metric_launches","v":{"s":"Launches"}},{"k":"investigation_pathway","v":{"s":"Projectile investigation pathway"}},{"k":"step_predict","v":{"s":"Predict"}},{"k":"step_predict_detail","v":{"s":"Choose variables and estimate range."}},{"k":"step_launch","v":{"s":"Launch"}},{"k":"step_launch_detail","v":{"s":"Observe motion and collect evidence."}},{"k":"step_explain","v":{"s":"Explain"}},{"k":"step_explain_detail","v":{"s":"Connect forces to the trajectory."}},{"k":"exit_fullscreen","v":{"s":"Exit fullscreen"}},{"k":"fullscreen","v":{"s":"Fullscreen"}},{"k":"for_the_physics_canvas","v":{"s":" for the physics canvas"}},{"k":"aria_canvas","v":{"s":"Physics projectile simulator — use arrow keys to adjust angle and velocity, Space to launch"}},{"k":"launch","v":{"s":"Launch!"}},{"k":"predict_landing","v":{"s":"Predict landing:"}},{"k":"aria_predicted_landing","v":{"s":"Predicted landing distance in meters"}},{"k":"aria_air_drag_currently","v":{"s":"Air drag, currently "}},{"k":"state_on_lc","v":{"s":"on"}},{"k":"state_off_lc","v":{"s":"off"}},{"k":"aria_click_to_toggle","v":{"s":". Click to toggle."}},{"k":"label_air_drag","v":{"s":"Air Drag "}},{"k":"on","v":{"s":"ON"}},{"k":"off","v":{"s":"OFF"}},{"k":"aria_vectors_currently","v":{"s":"Force vectors, currently "}},{"k":"label_vectors","v":{"s":"Vectors "}},{"k":"aria_energy_currently","v":{"s":"Energy display, currently "}},{"k":"label_energy","v":{"s":"Energy "}},{"k":"aria_learn_currently","v":{"s":"Learn panel, currently "}},{"k":"label_learn","v":{"s":"Learn"}},{"k":"aria_data_currently","v":{"s":"Flight data, currently "}},{"k":"label_data","v":{"s":"Data "}},{"k":"aria_show_work_currently","v":{"s":"Show your work formulas panel, currently "}},{"k":"label_show_work","v":{"s":"Show Work "}},{"k":"aria_compare_currently","v":{"s":"Trajectory comparison overlay, currently "}},{"k":"label_compare","v":{"s":"Compare "}},{"k":"aria_motion_currently","v":{"s":"Motion component graphs (Vx vs t and Vy vs t), currently "}},{"k":"label_motion","v":{"s":"Motion "}},{"k":"aria_clear_trails","v":{"s":"Clear all trajectory trails"}},{"k":"clear_trails","v":{"s":"Clear Trails"}},{"k":"sim_speed","v":{"s":"Simulation speed"}},{"k":"speed_caps","v":{"s":"SPEED"}},{"k":"pause","v":{"s":"Pause"}},{"k":"sim_speed_prefix","v":{"s":"Simulation speed "}},{"k":"aria_step_frame","v":{"s":"Step one frame forward (only useful when paused)"}},{"k":"step","v":{"s":"Step"}},{"k":"aria_symmetry_demo","v":{"s":"Symmetry demo: fire current angle, then the complementary angle, at the same velocity"}},{"k":"symmetry_demo","v":{"s":"Symmetry Demo"}},{"k":"slider_angle","v":{"s":"Angle (°)"}},{"k":"slider_velocity","v":{"s":"Velocity (m/s)"}},{"k":"slider_gravity","v":{"s":"Gravity (m/s²)"}},{"k":"slider_mass","v":{"s":"Mass (kg)"}},{"k":"launches_count","v":{"s":"Launches: "}},{"k":"targets_count","v":{"s":"Targets: "}},{"k":"prediction_streak_count","v":{"s":"Prediction streak: "}},{"k":"streak_count","v":{"s":"Streak: "}},{"k":"aria_show_work_panel","v":{"s":"Show your work formulas panel"}},{"k":"show_your_work_title","v":{"s":"Show Your Work (no-drag ideal)"}},{"k":"row_range","v":{"s":"Range:"}},{"k":"row_max_height","v":{"s":"Max Height:"}},{"k":"row_flight_time","v":{"s":"Flight Time:"}},{"k":"air_drag_warning","v":{"s":"Air drag is ON. Actual values will be lower than these no-drag predictions."}},{"k":"motion_components","v":{"s":"Motion Components"}},{"k":"launch_to_see_vx_vy","v":{"s":"Launch a projectile to see Vx-vs-t and Vy-vs-t."}},{"k":"motion_components_recent","v":{"s":"Motion Components (most recent launch)"}},{"k":"vx_vs_t_label","v":{"s":"Vx vs t — horizontal velocity"}},{"k":"aria_vx_graph","v":{"s":"Horizontal velocity over time, a flat line"}},{"k":"axis_time_s","v":{"s":"time (s)"}},{"k":"vx_flat_note","v":{"s":"Flat → no horizontal force, Vx is constant."}},{"k":"vy_vs_t_label","v":{"s":"Vy vs t — vertical velocity"}},{"k":"aria_vy_graph","v":{"s":"Vertical velocity over time, decreasing through zero at apex"}},{"k":"vy_line_note","v":{"s":"Straight line → constant gravity. Crosses zero at apex."}},{"k":"motion_independent_note","v":{"s":"Horizontal and vertical motion are independent. Gravity only affects Vy."}},{"k":"aria_range_angle_graph","v":{"s":"Range as a function of launch angle, peaking at 45 degrees"}},{"k":"axis_45_max","v":{"s":"45° (max)"}},{"k":"axis_launch_angle","v":{"s":"launch angle (θ)"}},{"k":"sweep_note_drag","v":{"s":"With drag, the actual optimum is lower than 45° (~38-42°). This chart is no-drag."}},{"k":"sweep_note_nodrag","v":{"s":"Range peaks at exactly 45° without drag. Complementary angles (e.g. 30° and 60°) hit the same R."}},{"k":"physics_concepts","v":{"s":"Physics Concepts"}},{"k":"concept_projectile_label","v":{"s":"Projectile Motion: "}},{"k":"concept_projectile_body","v":{"s":"An object launched into the air follows a parabolic path. Horizontal velocity (Vx) stays constant while vertical velocity (Vy) changes due to gravity. Enable Vectors to see!"}},{"k":"concept_newton2_label","v":{"s":"Newton's 2nd Law: "}},{"k":"concept_newton2_body","v":{"s":"F = ma. The only force on a projectile (ignoring drag) is gravity: a = g downward. This creates the curved trajectory."}},{"k":"concept_optimal_label","v":{"s":"Optimal Angle: "}},{"k":"concept_optimal_body","v":{"s":"Without air resistance, 45° gives maximum range. With drag, the optimal angle shifts lower (~38-42°). Try it!"}},{"k":"concept_energy_label","v":{"s":"Energy Conservation: "}},{"k":"concept_energy_body","v":{"s":"Kinetic Energy (KE = ½mv²) converts to Potential Energy (PE = mgh) and back. Enable the Energy bar to watch this live!"}},{"k":"concept_air_label","v":{"s":"Air Resistance: "}},{"k":"concept_air_body","v":{"s":"Drag force opposes motion and increases with speed (F_drag ∝ v²). It shortens range, lowers max height, and makes the trajectory asymmetric."}},{"k":"concept_gravity_label","v":{"s":"Gravity Varies: "}},{"k":"concept_gravity_body","v":{"s":"Different planets have different gravitational pull. Moon (1.6 m/s²) lets projectiles fly 6x farther than Earth (9.8 m/s²)! Try Jupiter for a challenge."}},{"k":"myth1_label","v":{"s":"Myth: “A moving object needs a forward push.” "}},{"k":"myth1_body","v":{"s":"Watch Vx — it never changes, and the Vectors view shows NO horizontal arrow. With no sideways force, the object keeps moving sideways on its own (Newton's 1st Law)."}},{"k":"myth2_label","v":{"s":"Myth: “Heavier objects fall faster.” "}},{"k":"myth2_body","v":{"s":"Drag the Mass slider — the trajectory does NOT change. In a vacuum every mass falls with the same g; mass only scales the energy bar, never the path."}},{"k":"myth3_label","v":{"s":"Myth: “Velocity points where the force points.” "}},{"k":"myth3_body","v":{"s":"At the very top of the arc the velocity is purely horizontal, yet gravity still points straight DOWN. A force changes motion — it doesn't have to point along it."}},{"k":"flight_data_title","v":{"s":"Flight Data"}},{"k":"launch_to_see_flight_data","v":{"s":"Launch a projectile to see flight data"}},{"k":"caption_data_table","v":{"s":"physics data table"}},{"k":"target_mode_title","v":{"s":"Target Destruction Mode"}},{"k":"start_mission","v":{"s":"Start Mission"}},{"k":"next_round","v":{"s":"Next Round"}},{"k":"retry","v":{"s":"Retry"}},{"k":"end","v":{"s":"End"}},{"k":"round_prefix","v":{"s":"Round "}},{"k":"score_prefix","v":{"s":"Score: "}},{"k":"lock_angle_prefix","v":{"s":"Angle LOCKED at "}},{"k":"lock_angle_suffix","v":{"s":"° — adjust velocity or gravity to hit the target"}},{"k":"lock_velocity_prefix","v":{"s":"Velocity LOCKED at "}},{"k":"lock_velocity_suffix","v":{"s":" m/s — adjust angle or gravity to hit the target"}},{"k":"calculation_helper","v":{"s":"Calculation Helper"}},{"k":"no_active_target","v":{"s":"No active target"}},{"k":"equation_label","v":{"s":"Equation: "}},{"k":"substitution_label","v":{"s":"Substitution: "}},{"k":"try_setting_prefix","v":{"s":"Try setting "}},{"k":"to_approximately","v":{"s":" to approximately "}},{"k":"attempts_prefix","v":{"s":"Attempts: "}},{"k":"challenges_title","v":{"s":"Challenges"}},{"k":"challenge_tier_1","v":{"s":"Tier 1"}},{"k":"challenge_desc_1","v":{"s":"Hit the 50m flag"}},{"k":"challenge_tier_2","v":{"s":"Tier 2"}},{"k":"challenge_desc_2","v":{"s":"Hit 100m with Air Drag ON"}},{"k":"challenge_tier_3","v":{"s":"Tier 3"}},{"k":"challenge_desc_3","v":{"s":"Hit 200m on Mars"}},{"k":"kinematic_equations","v":{"s":"Kinematic Equations"}},{"k":"label_range","v":{"s":"Range"}},{"k":"label_max_height","v":{"s":"Max Height"}},{"k":"label_flight_time","v":{"s":"Flight Time"}},{"k":"label_position","v":{"s":"Position"}},{"k":"air_drag_modifies","v":{"s":"Air drag modifies these equations — real range will be shorter than the idealized calculation below."}},{"k":"predict_the_landing","v":{"s":"Predict the Landing"}},{"k":"aria_generate_quiz","v":{"s":"Generate landing prediction quiz"}},{"k":"new_question","v":{"s":"New Question"}},{"k":"start_quiz","v":{"s":"Start Quiz"}},{"k":"quiz_q_prefix","v":{"s":"A projectile is launched at "}},{"k":"quiz_q_with_velocity","v":{"s":" with velocity "}},{"k":"quiz_q_and_gravity","v":{"s":" and gravity "}},{"k":"planet_earth_paren","v":{"s":" (Earth)"}},{"k":"planet_moon_paren","v":{"s":" (Moon)"}},{"k":"planet_mars_paren","v":{"s":" (Mars)"}},{"k":"planet_jupiter_paren","v":{"s":" (Jupiter)"}},{"k":"quiz_q_suffix","v":{"s":". How far does it land?"}},{"k":"quiz_correct_prefix","v":{"s":"Correct! R = v²sin(2θ)/g = "}},{"k":"quiz_not_quite","v":{"s":"Not quite."}},{"k":"myth35_1_s","v":{"s":"A heavier cannonball falls faster, so it lands sooner."}},{"k":"myth35_1_why","v":{"s":"Gravity speeds up EVERY mass equally (with air resistance off) — a 10 kg ball and a 1 kg ball trace the exact same arc. Galileo’s big idea."}},{"k":"myth35_1_tryit","v":{"s":"Launch with mass = 1 kg, then slide mass to 10 kg and launch again. Same arc, same landing spot."}},{"k":"myth35_2_s","v":{"s":"At the very top of the arc, the ball has stopped moving."}},{"k":"myth35_2_why","v":{"s":"Only the UP-DOWN part of the motion pauses at the top. The ball keeps moving forward the whole time."}},{"k":"myth35_2_tryit","v":{"s":"Turn on Vectors and watch the horizontal arrow at the top of the arc — it never shrinks."}},{"k":"myth35_3_s","v":{"s":"Doubling the launch speed doubles the distance."}},{"k":"myth35_3_why","v":{"s":"Distance grows with speed × speed. Double the speed and it lands FOUR times farther."}},{"k":"myth35_3_tryit","v":{"s":"Launch at 15 m/s, then at 30 m/s with the same angle — compare the landing markers."}},{"k":"myth35_4_s","v":{"s":"Aiming at 45° throws the farthest (no air)."}},{"k":"myth35_4_why","v":{"s":"Lower angles fly flat but fall too soon; higher angles waste speed going up. 45° is the perfect trade."}},{"k":"myth35_4_tryit","v":{"s":"Run the complementary-angles demo — 30° and 60° even land on the SAME spot."}},{"k":"myth68_1_s","v":{"s":"After launch, a force keeps pushing the ball forward."}},{"k":"myth68_1_why","v":{"s":"Once it leaves the cannon, the ONLY force is gravity, pulling straight down. Forward motion continues because nothing stops it — Newton’s first law."}},{"k":"myth68_1_tryit","v":{"s":"Watch the vector overlay in flight: there is no forward force, yet Vx stays perfectly constant."}},{"k":"myth68_2_s","v":{"s":"A ball fired horizontally and a ball dropped from the same height hit the ground at the same time."}},{"k":"myth68_2_why","v":{"s":"Horizontal and vertical motion are independent. Both balls fall with the same gravity from the same height, so they land together."}},{"k":"myth68_2_tryit","v":{"s":"Fire at a very low angle and compare the flight time with a steep, short lob from the same height."}},{"k":"myth912_1_s","v":{"s":"With air resistance ON, 45° is still the best angle."}},{"k":"myth912_1_why","v":{"s":"Drag punishes long, high flights — it bleeds v² the whole way. The optimum drops to roughly 30–40° depending on speed."}},{"k":"myth912_1_tryit","v":{"s":"Toggle air resistance on and sweep the angle slider — watch where the landing marker actually peaks."}},{"k":"physics_myths_title","v":{"s":"Physics Myths — true or false?"}},{"k":"aria_start_myth","v":{"s":"Start a physics myth question"}},{"k":"new_myth","v":{"s":"New Myth"}},{"k":"start","v":{"s":"Start"}},{"k":"aria_answer","v":{"s":"Answer "}},{"k":"true_lc","v":{"s":"true"}},{"k":"false_lc","v":{"s":"false"}},{"k":"true_cap","v":{"s":"True"}},{"k":"false_cap","v":{"s":"False"}},{"k":"correct_dash","v":{"s":"Correct — "}},{"k":"not_quite_dash","v":{"s":"Not quite — "}},{"k":"true_period","v":{"s":"TRUE."}},{"k":"false_period","v":{"s":"FALSE."}},{"k":"try_it_in_sim","v":{"s":"Try it in the sim: "}},{"k":"snapshot","v":{"s":"Snapshot"}},{"k":"iq_near_optimal","v":{"s":"Near-optimal range"}},{"k":"iq_reasonable","v":{"s":"Reasonable range"}},{"k":"iq_far_from_optimal","v":{"s":"Far from optimal"}},{"k":"iq_title","v":{"s":"Gravity-angle discovery"}},{"k":"iq_intro","v":{"s":"Three sliders control gravity (any planet), launch angle, and velocity. The simulator tells you whether your projectile range is near-optimal, reasonable, or far-off — a discrete 3-state outcome (no numeric score). Sweep the sliders. Log observations. Type what you discover."}},{"k":"iq_range_prefix","v":{"s":"Range "}},{"k":"iq_range_mid","v":{"s":" m (max possible at this v + g: "}},{"k":"iq_range_end","v":{"s":" m)"}},{"k":"slider_launch_angle","v":{"s":"Launch angle (°)"}},{"k":"iq_log","v":{"s":"Log"}},{"k":"iq_reset","v":{"s":"Reset"}},{"k":"iq_logged","v":{"s":" logged"}},{"k":"iq_col_angle","v":{"s":"angle°"}},{"k":"iq_col_range","v":{"s":"range m"}},{"k":"iq_col_state","v":{"s":"state"}},{"k":"iq_hypothesis_label","v":{"s":"Your hypothesis (free text — no right answer):"}},{"k":"iq_hypothesis_placeholder","v":{"s":"Is the optimal angle the same on every planet? Does doubling velocity double range? Type your own theory."}},{"k":"iq_stuck_btn","v":{"s":"I'm stuck — show me questions to think about (no answers)"}},{"k":"iq_open_prompts","v":{"s":"Open prompts — investigate by manipulating:"}},{"k":"iq_prompt_1","v":{"s":"Hold two sliders steady. Move the third. Watch what happens."}},{"k":"iq_prompt_2","v":{"s":"Find two different settings that both produce the same state. What do they share?"}},{"k":"iq_prompt_3","v":{"s":"Try switching planets via the gravity slider. Does the best angle change?"}},{"k":"iq_prompt_4","v":{"s":"Log several \"optimal\" observations. What angle do they share?"}},{"k":"iq_prompt_5","v":{"s":"Real artillery uses tables not formulas. What does that suggest about the relationship between angle and range?"}},{"k":"iq_no_answers","v":{"s":"No answers. Investigate."}},{"k":"iq_understand_label","v":{"s":"I think I understand the trade-offs — let me explain them in my own words"}},{"k":"iq_explanation_input","v":{"s":"Projectile physics explanation"}},{"k":"iq_explain_placeholder","v":{"s":"Explain in your own words: how do gravity, angle, and velocity interact? Why is 45° special — or is it?"}},{"k":"iq_saved_note","v":{"s":"Saved. Notice — nobody checked your answer."}},{"k":"iq_design_note","v":{"s":"Design note: no numeric range target, no reveal button. Range quality is shown as a discrete 3-state marker, not a continuous gradient — by design, to discourage optimization-gaming behavior."}},{"k":"level_plain","v":{"s":"Plain"}},{"k":"level_grade5","v":{"s":"Grade 5"}},{"k":"level_high_school","v":{"s":"High School"}},{"k":"ai_not_available","v":{"s":"AI tutor not available."}},{"k":"ai_could_not_reach","v":{"s":"Could not reach AI tutor. Try again in a moment."}},{"k":"explain_at_my_level","v":{"s":"Explain at my level"}},{"k":"aria_reading_level","v":{"s":"Reading level"}},{"k":"aria_reading_level_prefix","v":{"s":"Reading level: "}},{"k":"selected_suffix","v":{"s":" (selected)"}},{"k":"aria_generate_ai_prefix","v":{"s":"Generate AI explanation at "}},{"k":"aria_level_suffix","v":{"s":" level"}},{"k":"thinking","v":{"s":"Thinking..."}},{"k":"re_explain","v":{"s":"Re-explain"}},{"k":"explain","v":{"s":"Explain"}},{"k":"ai_empty_hint","v":{"s":"Click “Explain” for the AI tutor to describe what happens at the current angle, velocity, and gravity settings."}}],"id":560}},{"k":"planet_quiz","v":{"o":[{"k":"u2705_correct","v":{"s":"✅ Correct! "}},{"k":"u274c_the_answer_is","v":{"s":"❌ The answer is "}},{"k":"discoveries","v":{"s":"Discoveries"}},{"k":"xp_earned","v":{"s":"XP Earned"}},{"k":"wasd","v":{"s":"WASD"}}],"id":561}},{"k":"planet_view","v":{"o":[{"k":"planet","v":{"s":"Planet"}},{"k":"gravity","v":{"s":"Gravity"}},{"k":"temp","v":{"s":"Temp"}},{"k":"atmos","v":{"s":"Atmos"}},{"k":"mission_briefing","v":{"s":"MISSION BRIEFING"}},{"k":"caloris_basin","v":{"s":"Caloris Basin"}