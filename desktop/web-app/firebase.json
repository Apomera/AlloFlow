{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "firebase.*.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.ps1",
      "stem_lab/*.txt",
      "stem_lab/_*.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Alt-Svc",
            "value": "clear"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://cdn.sheetjs.com https://apis.google.com https://accounts.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://alloflow-cdn.pages.dev https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' data: blob: https:; connect-src 'self' data: blob: https://alloflow-cdn.pages.dev https://alloflow.org https://alloflow.dev https://*.workers.dev https://generativelanguage.googleapis.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://*.run.app https://www.google.com https://www.gstatic.com https://accounts.google.com https://apis.google.com https://script.google.com https://script.googleusercontent.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://cdn.sheetjs.com https://huggingface.co https://*.hf.co https://api.openai.com https://api.anthropic.com https://api.duckduckgo.com https://duckduckgo.com https://google.serper.dev https://raw.githubusercontent.com https://*.wikipedia.org https://*.wikimedia.org https://api.crossref.org https://*.ncbi.nlm.nih.gov http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), geolocation=(), payment=(), usb=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "cse-config.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/song_library/songs.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{classroom-import,classroom-import.html,data_lab/data_lab,data_lab/data_lab.html}",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/{access_lens,video_studio,whiteboard,it_coach,alphafold_explorer,immersive_geometry}/**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/allo_sheet/**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://alloflow-cdn.pages.dev; object-src 'none'; base-uri 'none'"
          }
        ]
      },
      {
        "source": "/{zoom_gallery,timeline_studio,circuit_shelf,molecule_shelf,sim_shelf,life_skills_outing,text_inquiry}/**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/{educator-evaluation*,walkthrough-copilot*,school-rewards-practice*,accessibility_demo*,geometry_world_demo*,speech_device_test*}",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/data_lab/tutor_plugin*",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://codap.concord.org https://*.concord.org; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/storage_bridge*",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; img-src 'none'; form-action 'none'; frame-ancestors 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  }
}
