+// Isolated warning markup in Chromium; uses the current Tailwind configuration.
+// No app server, live profile, provider request or application save is involved.
+import { beforeAll, afterEach, afterAll, describe, it, expect } from 'vitest';
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { fixtures, copy, setupDraftReader, cleanupDraftReader, mountDraft } from './helpers/reader_draft_locale_harness.js';
+const require = createRequire(import.meta.url), webRequire = createRequire(resolve('desktop/web-app/package.json'));
+const report = resolve('reports/draft-layout'), results = [];
+let browser, css;
+(process.env.ALLO_READER_DRAFT_LAYOUT === '1' ? describe : describe.skip)('localized inline draft warning reflow', () => {
+  beforeAll(async () => {
+    setupDraftReader();
+    const config = { ...require(resolve('desktop/web-app/tailwind.config.js')), content: [resolve('view_simplified_source.jsx')] };
+    css = (await webRequire('postcss')([webRequire('tailwindcss')(config)]).process('@tailwind base;\n@tailwind components;\n@tailwind utilities;', { from: undefined })).css;
+    browser = await require('@playwright/test').chromium.launch({ headless: true }); mkdirSync(report, { recursive: true });
+  }, 60000);
+  afterEach(cleanupDraftReader);
+  afterAll(async () => { await browser?.close(); writeFileSync(resolve(report, 'results.json'), JSON.stringify(results, null, 2) + '\n'); });
+  for (const f of fixtures.filter(f => f.reselectable !== false)) for (const scale of [1, 2]) it(f.id + ' at 320px and ' + scale + 'x text', async () => {
+    const h = mountDraft(f); await h.edit(f.word); h.change();
+    const warning = [...h.host.querySelectorAll('[role=status]')].find(n => n.querySelector('button'));
+    const fieldset = h.host.querySelector('[data-gloss-draft]');
+    const page = await browser.newPage({ viewport: { width: 320, height: 800 } }); const errors = []; page.on('pageerror', e => errors.push(e.message));
+    await page.route('**/*', route => route.abort());
+    try {
+      await page.setContent('<!doctype html><html lang="' + f.tag + '" dir="' + f.direction + '"><head><meta charset="utf-8"><style>' + css + '\nhtml{font-size:' + (16 * scale) + 'px}</style></head><body><fieldset class="' + fieldset.className + '">' + warning.outerHTML + '</fieldset></body></html>');
+      const button = page.getByRole('button', { name: copy(f, 'gloss_draft_choose_occurrence'), exact: true });
+      await page.keyboard.press('Tab'); expect(await button.evaluate(n => document.activeElement === n)).toBe(true);
+      const geometry = await page.locator('[role=status]').evaluate(n => {
+        const b = n.querySelector('button'), rect = b.getBoundingClientRect();
+        return { documentWidth: document.documentElement.scrollWidth, warningWidth: n.clientWidth, warningScroll: n.scrollWidth, buttonWidth: b.clientWidth, buttonScroll: b.scrollWidth, left: rect.left, right: rect.right, direction: getComputedStyle(n).direction };
+      });
+      expect(geometry.documentWidth).toBe(320); expect(geometry.warningScroll).toBeLessThanOrEqual(geometry.warningWidth + 1);
+      expect(geometry.buttonScroll).toBeLessThanOrEqual(geometry.buttonWidth + 1); expect(geometry.left).toBeGreaterThanOrEqual(0); expect(geometry.right).toBeLessThanOrEqual(321); expect(geometry.direction).toBe(f.direction);
+      expect(await button.textContent()).toBe(copy(f, 'gloss_draft_choose_occurrence')); expect(errors).toEqual([]);
+      await page.locator('fieldset').screenshot({ path: resolve(report, f.id + '-' + scale + 'x.png') });
+      results.push({ fixture: f.id, viewportCssPx: 320, rootTextScale: scale, nativeZoom: false, scope: 'warning in its fieldset; not full reader', geometry, errors });
+    } finally { await page.close(); }
+  }, 30000);
+});
