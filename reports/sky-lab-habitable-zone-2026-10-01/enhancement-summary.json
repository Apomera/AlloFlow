{
  "title": "Sky Lab habitable-zone explorer",
  "checkedOn": "2026-10-01",
  "enhancements": [
    "Replaced the text-only habitable-zone section with linked orbit and energy-balance diagrams.",
    "Added independent temperature, total luminosity, orbital distance and Bond albedo controls.",
    "Used the published one-Earth-mass conservative climate coefficients and retained their 5780 K polynomial offset.",
    "Added NASA Venus, Earth and Mars input presets with measured surface-temperature comparisons.",
    "Made chart selection accessible by keyboard and touch, added a page shortcut and preserved other saved investigations.",
    "Verified readable 320px contrast figures and a source table with visible model assumptions."
  ],
  "sources": {
    "checkedOn": "2026-10-01",
    "publishedBoundaryModel": {
      "paper": "Kopparapu et al. 2014",
      "url": "https://arxiv.org/abs/1404.5292",
      "massEarth": 1,
      "rangeK": [
        2600,
        7200
      ],
      "temperatureOffsetK": 5780,
      "coefficientsFile": "coefficients.dat",
      "authorCodeFile": "author-model.f90"
    },
    "solarReference": {
      "temperatureK": 5772,
      "irradianceWm2": 1361,
      "source": "IAU 2015 Resolution B3",
      "url": "https://arxiv.org/abs/1510.07674"
    },
    "equilibriumModel": {
      "sigma": 5.670374419e-8,
      "constantsUrl": "https://physics.nist.gov/cuu/pdf/all.pdf",
      "energySource": "https://science.nasa.gov/earth/earth-observatory/climate-and-earths-energy-budget/",
      "equations": [
        "S/S_Earth=L/r^2",
        "r_boundary=sqrt(L/S_eff)",
        "S_eff=c0+c1*(T-5780)+c2*(T-5780)^2+c3*(T-5780)^3+c4*(T-5780)^4",
        "T_eq=[1361*(L/r^2)*(1-A)/(4*sigma)]^(1/4)"
      ]
    },
