+++ b/tests/reader_draft_locale_catalogs.test.js
@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const guard = require('../dev-tools/i18n/apply_reader_draft_locales.cjs');
+const payload = JSON.parse(readFileSync('translations/reader-draft-locales.json', 'utf8'));
+const clone = () => JSON.parse(JSON.stringify(payload));
+const read = file => JSON.parse(readFileSync(file, 'utf8'));
+it('freezes exactly seven English messages and five locale batches', () => {
+  expect(guard.validatePayload(payload)).toHaveLength(7); expect(guard.LOCALES).toHaveLength(5);
+  expect(guard.run(false)).toEqual({ keys: 7, locales: 5, changedFiles: 0, mode: 'check' });
+});
+it('registers each owned fallback verbatim at a literal reader lookup', () => {
+  const parser = require('@babel/parser'), traverse = require('@babel/traverse').default;
+  const source = readFileSync('view_simplified_source.jsx', 'utf8'), calls = new Map();
+  traverse(parser.parse(source, { sourceType: 'script', plugins: ['jsx'] }), { CallExpression(p) {
+    const n = p.node; if (n.callee.name === 'simplifiedText' && guard.KEYS.includes(n.arguments[0]?.value)) calls.set(n.arguments[0].value, n.arguments[1]?.value);
+  } });
+  expect(Object.fromEntries(calls)).toEqual(payload.english);
+});
+it.each(['English', ...guard.LOCALES])('ships the bounded keys and an exact public mirror for %s', locale => {
+  const file = locale === 'English' ? 'ui_strings.js' : 'lang/' + locale + '.js';
+  const pack = read(file), values = locale === 'English' ? payload.english : payload.locales[locale];
+  for (const key of guard.KEYS) { expect(guard.lookup(pack, key)).toBe(values[key]); expect(guard.placeholders(values[key])).toEqual(guard.placeholders(payload.english[key])); }
+  expect(readFileSync('desktop/web-app/public/' + file, 'utf8')).toBe(readFileSync(file, 'utf8'));
+});
+it.each(['missing','duplicate','renamed','extra'])('rejects %s inline action slots before writing', mode => {
+  const p = clone(), key = 'simplified.gloss_draft_passage_changed';
+  p.locales.arabic[key] = mode === 'missing' ? 'No action.' : mode === 'duplicate' ? '{chooseOccurrence}{chooseOccurrence}' : mode === 'renamed' ? '{choose}' : '{chooseOccurrence}{other}';
+  expect(() => guard.validatePayload(p)).toThrow('Placeholder mismatch');
+});
+it('rejects frozen English changes and conflicting owner translations', () => {
+  const p = clone(); p.english['simplified.gloss_save_and_continue'] += '!'; expect(() => guard.validatePayload(p)).toThrow('English copy changed');
+  expect(() => guard.mergePack({ simplified: { gloss_save_and_continue: 'Other owner wording' } }, payload.locales.arabic)).toThrow('Existing catalog value differs');
+});
+it('preserves other catalog values and refuses extra keys or untranslated copy', () => {
+  const old = { common: { save: 'Keep' }, simplified: { other: 'Keep too' } }, before = JSON.stringify(old);
+  const merged = guard.mergePack(old, payload.locales.arabic); expect(JSON.stringify(old)).toBe(before); expect(merged.common).toEqual(old.common); expect(merged.simplified.other).toBe('Keep too');
+  const extra = clone(); extra.locales.arabic.extra = 'No'; expect(() => guard.validatePayload(extra)).toThrow('Key coverage');
+  const untranslated = clone(); untranslated.locales.arabic['simplified.gloss_save_and_continue'] = untranslated.english['simplified.gloss_save_and_continue']; expect(() => guard.validatePayload(untranslated)).toThrow('Missing translation');
+});
+
+it.each(['{', '}'])('rejects stray %s braces even when the action token survives', brace => {
+  const p = clone(); p.locales.arabic['simplified.gloss_draft_passage_changed'] += brace;
+  expect(() => guard.validatePayload(p)).toThrow('Malformed placeholder');
+});
