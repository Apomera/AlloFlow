: 10px; color: var(--allo-stem-text-soft, #94a3b8); margin-top: 3px; line-height: 1.45;"},"Changing the angle changes both the member length and force. Compare designs under the same load to see the trade-off."]],["DIV",{"style":"padding: 8px; border-radius: 6px; background: var(--allo-stem-canvas, #0f172a); border: 1px solid var(--allo-stem-border, #334155);"},["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); text-transform: uppercase; letter-spacing: 0.5px;"},"Total member length"],["DIV",{"style":"font-size: 13px; font-weight: 800; color: rgb(148, 163, 184); margin-top: 2px;"},"146.5 m"],["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); margin-top: 3px; line-height: 1.45;"},"All the pieces laid end to end. More length = more material = more cost."]],["DIV",{"style":"padding: 8px; border-radius: 6px; background: var(--allo-stem-canvas, #0f172a); border: 1px solid var(--allo-stem-border, #334155);"},["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); text-transform: uppercase; letter-spacing: 0.5px;"},"Estimated mass"],["DIV",{"style":"font-size: 13px; font-weight: 800; color: rgb(148, 163, 184); margin-top: 2px;"},"16100 kg"],["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); margin-top: 3px; line-height: 1.45;"},"What the bare structure weighs. A bridge must carry itself before it carries anything else."]],["DIV",{"style":"padding: 8px; border-radius: 6px; background: var(--allo-stem-canvas, #0f172a); border: 1px solid var(--allo-stem-border, #334155);"},["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); text-transform: uppercase; letter-spacing: 0.5px;"},"Estimated material cost"],["DIV",{"style":"font-size: 13px; font-weight: 800; color: rgb(134, 239, 172); margin-top: 2px;"},"$96601"],["DIV",{"style":"font-size: 10px; color: var(--allo-stem-text-soft, #94a3b8); margin-top: 3px; line-height: 1.45;"},"The engineering game: the C