248, 113, 113);"},"α"]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.625rem] font-mono w-5 flex-shrink-0","style":"color: rgb(148, 163, 184);"},"15"],["SPAN",{"class":"text-[0.6875rem] font-black w-16 flex-shrink-0","style":"color: rgb(203, 213, 225);"},"Pb-206"],["SPAN",{"class":"text-[0.6875rem] font-mono flex-1","style":"color: rgb(203, 213, 225);"},"stable"],["SPAN",{"class":"text-[0.6875rem] font-bold","style":"color: rgb(203, 213, 225);"},"■"]]]]],["DIV",{"data-nk-exploration-progress":"chainSeen","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(192, 132, 252, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(192, 132, 252);"},"Try another option"],["PROGRESS",{"value":"0","max":"4","aria-label":"0 of 4 chain steps deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(192, 132, 252);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 4 chain steps deliberately compared"]],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(251, 191, 36, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(251, 191, 36);"},"Why the whole chain runs at uranium-238's pace"],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"Every step below the parent is far faster than it, so each daughter decays about as fast as it is made. The chain settles into secular equilibrium and the whole thing ticks along at the rate of the slowest step — 4.47 billion years. That is why radon keeps appearing in a basement year after year and never runs out: it is being made continuously from uranium in the ground beneath, and the supply lasts as long as the planet does."]],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(192, 132, 252, 0.333); background: rgba(15, 23, 42, 0.5);"},["P",{"class":"text-[0.6875rem] font-bold leading-relaxed","style":"color: rgb(192, 132, 252);"},"🤔 Radon has a half-life of under four days. Sealing a basement for a fortnight would clear what is already there. Why does that not fix the problem?"],["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 mt-1.5 px-3 py-2 rounded-lg text-[0.6875rem] font-black","style":"background: rgb(192, 132, 252); color: rgb(11, 16, 32); border: 1px solid rgb(192, 132, 252);"},"Worked it out? Check"]]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-enrichment","data-nk-sec":"enrichment","aria-labelledby":"nkheading-enrichment","tabindex":"-1","style":"border-color: rgba(251, 146, 60, 0.333) rgba(251, 146, 60, 0.333) rgba(251, 146, 60, 0.333) rgb(251, 146, 60); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(251, 146, 60, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-enrichment","style":"color: rgb(251, 146, 60); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(251, 146, 60, 0.267);"},"🔢 4. Enrichment: why reactor fuel is not a bomb"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"Natural uranium is 99.3% U-238 and only 0.72% the fissile U-235. Separating them is the hardest industrial step in the whole business — and the reason a power reactor is not a weapon waiting to happen."],["DIV",{"role":"list","class":"space-y-1"},["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(52, 211, 153);"},"0.72%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"Natural uranium"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 1%; background: rgb(52, 211, 153);"}]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(52, 211, 153);"},"3.5%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"Reactor fuel (LEU)"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 3.5%; background: rgb(52, 211, 153);"}]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(52, 211, 153);"},"5%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"Upper limit for most fuel"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 5%; background: rgb(52, 211, 153);"}]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(52, 211, 153);"},"19.75%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"HALEU ceiling"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 19.75%; background: rgb(52, 211, 153);"}]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(251, 146, 60);"},"20%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"The safeguards line"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 20%; background: rgb(251, 146, 60);"}]]]],["DIV",{"role":"listitem"},["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 w-full text-left rounded-lg px-2.5 py-1.5 border transition-colors","style":"background: rgba(148, 163, 184, 0.06); border-color: rgba(148, 163, 184, 0.2);"},["SPAN",{"class":"flex items-center gap-2"},["SPAN",{"class":"text-[0.6875rem] font-black w-14 flex-shrink-0","style":"color: rgb(248, 113, 113);"},"90%"],["SPAN",{"class":"text-[0.6875rem] font-bold flex-1","style":"color: rgb(226, 232, 240);"},"Weapons-grade"]],["SPAN",{"class":"block h-1.5 rounded-full mt-1","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["SPAN",{"class":"block h-1.5 rounded-full","style":"width: 90%; background: rgb(248, 113, 113);"}]]]]],["DIV",{"data-nk-exploration-progress":"enrSeen","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(251, 146, 60, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(251, 146, 60);"},"Try another option"],["PROGRESS",{"value":"0","max":"3","aria-label":"0 of 3 enrichment levels deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(251, 146, 60);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 3 enrichment levels deliberately compared"]],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(52, 211, 153, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(52, 211, 153);"},"The answer to \"could a reactor explode like a bomb?\""],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"No, and not because of the safety systems. A weapon needs a fast chain reaction in material enriched above about 90%, held together for the microseconds it takes to run. Reactor fuel at 3–5% cannot sustain a fast chain reaction at ANY mass or shape: the U-238 that makes up the other 95% absorbs the fast neutrons before they find a U-235 nucleus. The fuel only works at all because a moderator slows the neutrons down first — and moderated neutrons are far too slow for the runaway a weapon needs. Chernobyl was a steam explosion that wrecked the building, not a nuclear detonation."]],["P",{"class":"text-[0.6875rem] mt-2 leading-relaxed","style":"color: rgb(203, 213, 225);"},"This is also why enrichment is what arms-control regimes actually watch. The centrifuge cascade that takes uranium from 0.72% to 5% is most of the way, in separative work, to one that could reach 90% — so the equipment matters more than the material."]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-shielding","data-nk-sec":"shielding","aria-labelledby":"nkheading-shielding","tabindex":"-1","style":"border-color: rgba(56, 189, 248, 0.333) rgba(56, 189, 248, 0.333) rgba(56, 189, 248, 0.333) rgb(56, 189, 248); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(56, 189, 248, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-shielding","style":"color: rgb(56, 189, 248); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(56, 189, 248, 0.267);"},"🛡️ 5. What actually stops it"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"\"Radiation\" is four different things that behave nothing alike. Pick one and try to stop it."],["DIV",{"class":"flex flex-wrap gap-1 mb-2"},["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"α Alpha. Study Alpha radiation","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"α Alpha"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"β Beta. Study Beta radiation","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"β Beta"],["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"γ Gamma. Study Gamma radiation","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(167, 139, 250); color: rgb(11, 16, 32); border: 1px solid rgb(167, 139, 250);"},"γ Gamma"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"n Neutron. Study Neutron radiation","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"n Neutron"]],["DIV",{"data-nk-exploration-progress":"radTried","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(56, 189, 248, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(56, 189, 248);"},"Try another option"],["PROGRESS",{"value":"0","max":"4","aria-label":"0 of 4 radiation types deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(56, 189, 248);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 4 radiation types deliberately compared"]],["DIV",{"class":"flex flex-wrap gap-1 mb-1"},["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Air. Shield with Air","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Air"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Water. Shield with Water","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Water"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Concrete. Shield with Concrete","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Concrete"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Steel. Shield with Steel","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Steel"],["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"Lead. Shield with Lead","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(148, 163, 184); color: rgb(11, 16, 32); border: 1px solid rgb(148, 163, 184);"},"Lead"]],["DIV",{"class":"nk-slider flex items-center gap-2 mt-1.5"},["LABEL",{"for":"nk-thick","class":"text-[0.6875rem] font-bold w-28 flex-shrink-0","style":"color: rgb(203, 213, 225);"},"Thickness"],["INPUT",{"__playwright_value_":"2","id":"nk-thick","type":"range","min":"0.1","max":"30","step":"0.1","aria-valuetext":"2 cm","class":"nk-slider-input flex-1 min-w-0 min-h-11 accent-violet-500","value":"2"}],["OUTPUT",{"for":"nk-thick","class":"text-[0.6875rem] font-bold w-24 text-right","style":"color: rgb(196, 181, 253);"},"2 cm"]],["DIV",{"class":"mt-2"},["DIV",{"class":"h-4 rounded-full overflow-hidden","aria-hidden":"true","style":"background: rgba(148, 163, 184, 0.15);"},["DIV",{"style":"height: 100%; width: 21.4%; background: rgb(167, 139, 250); border-radius: 999px; transition: width 160ms linear;"}]],["P",{"class":"text-[0.6875rem] font-black mt-1","style":"color: rgb(167, 139, 250);"},"21.4% of the gamma gets through 2 cm of lead"],["P",{"role":"status","aria-live":"polite","aria-atomic":"true","class":"sr-only"}],["P",{"class":"text-[0.6875rem] mt-1 leading-relaxed","style":"color: rgb(226, 232, 240);"},"Substantially attenuated. The \"half-value layer\" for this material is 0.9 cm — every one of those halves the intensity again."]],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(167, 139, 250, 0.376); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(167, 139, 250);"},"γ  Gamma"],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"A high-energy photon. No mass, no charge — just light far beyond violet."],["P",{"class":"text-[0.6875rem] mt-1 leading-relaxed","style":"color: rgb(226, 232, 240);"},["B",{},"Stopped by: "],"Nothing stops it completely. Lead or concrete cuts it exponentially."],["P",{"class":"text-[0.6875rem] mt-1 leading-relaxed","style":"color: rgb(252, 165, 165);"},["B",{},"Why it matters: "],"Passes right through you, so it irradiates every organ. This is the dominant external hazard after an accident."]],["P",{"class":"text-[0.6875rem] mt-2","style":"color: rgb(148, 163, 184);"},"The densest practical shield. Thin lead does what thick concrete does — which is why aprons are lead, not concrete."]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-criticality","data-nk-sec":"criticality","aria-labelledby":"nkheading-criticality","tabindex":"-1","style":"border-color: rgba(52, 211, 153, 0.333) rgba(52, 211, 153, 0.333) rgba(52, 211, 153, 0.333) rgb(52, 211, 153); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(52, 211, 153, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-criticality","style":"color: rgb(52, 211, 153); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(52, 211, 153, 0.267);"},"⚛️ 6. The chain reaction, and what holds it steady"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"A uranium-235 nucleus absorbs a neutron, splits, and releases 2 or 3 more. k is how many of those go on to cause another fission. Everything about reactor control is holding k at exactly 1."],["P",{"class":"text-[0.6875rem] mb-1 font-bold","style":"color: rgb(251, 191, 36);"},"The core is shut down. Withdraw the rods until k reads exactly 1.000."],["DIV",{"class":"nk-slider flex items-center gap-2 mt-1.5"},["LABEL",{"for":"nk-rods","class":"text-[0.6875rem] font-bold w-28 flex-shrink-0","style":"color: rgb(203, 213, 225);"},"Control rods in"],["INPUT",{"__playwright_value_":"65","id":"nk-rods","type":"range","min":"0","max":"100","step":"1","aria-valuetext":"65%","class":"nk-slider-input flex-1 min-w-0 min-h-11 accent-violet-500","value":"65"}],["OUTPUT",{"for":"nk-rods","class":"text-[0.6875rem] font-bold w-24 text-right","style":"color: rgb(196, 181, 253);"},"65%"]],["DIV",{"class":"nk-stat-grid mt-2 grid gap-2"},["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(96, 165, 250, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"k (neutron multiplication)"],["P",{"class":"text-sm font-black","style":"color: rgb(96, 165, 250);"},"0.910"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(96, 165, 250, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"State"],["P",{"class":"text-sm font-black","style":"color: rgb(96, 165, 250);"},"subcritical"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(251, 191, 36, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"After 12 generations"],["P",{"class":"text-sm font-black","style":"color: rgb(251, 191, 36);"},"35 neutrons"]]],["DIV",{"class":"flex items-end gap-0.5 mt-2","aria-hidden":"true","style":"height: 54px;"},["DIV",{"style":"flex: 1 1 0%; height: 50%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 48.976%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 47.9521%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 46.9281%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 45.9041%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 44.8802%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 43.8562%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 42.8322%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 41.8083%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 40.7843%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 39.7603%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}],["DIV",{"style":"flex: 1 1 0%; height: 38.7364%; background: rgb(96, 165, 250); border-radius: 2px 2px 0px 0px;"}]],["P",{"class":"text-[0.625rem] mt-1","style":"color: rgb(148, 163, 184);"},"Neutrons per generation, on a log scale. Twelve generations is under a thousandth of a second."],["P",{"class":"text-[0.6875rem] mt-2 leading-relaxed","style":"color: rgb(226, 232, 240);"},"Subcritical: k < 1. The chain dies out. This is a shut-down reactor — though it still needs cooling, because decay heat continues for days. That is precisely what went wrong at Fukushima: the reactors shut down correctly and then could not be cooled."],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(52, 211, 153, 0.333); background: rgba(15, 23, 42, 0.5);"},["P",{"class":"text-[0.6875rem] font-bold leading-relaxed","style":"color: rgb(52, 211, 153);"},"🤔 A bomb needs k far above 1 with fast neutrons and over 90% enrichment. Reactor fuel is 3–5%. Why can a power reactor not explode like a weapon, whatever else goes wrong?"],["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 mt-1.5 px-3 py-2 rounded-lg text-[0.6875rem] font-black","style":"background: rgb(52, 211, 153); color: rgb(11, 16, 32); border: 1px solid rgb(52, 211, 153);"},"Worked it out? Check"]]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-binding","data-nk-sec":"binding","aria-labelledby":"nkheading-binding","tabindex":"-1","style":"border-color: rgba(56, 189, 248, 0.333) rgba(56, 189, 248, 0.333) rgba(56, 189, 248, 0.333) rgb(56, 189, 248); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(56, 189, 248, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-binding","style":"color: rgb(56, 189, 248); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(56, 189, 248, 0.267);"},"⛰️ 7. One curve explains fission AND fusion"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"Binding energy per nucleon is how tightly each particle is held. The curve climbs steeply from hydrogen, peaks, then falls slowly — and HIGHER on this curve means more tightly bound. Move toward the peak from either side and the nuclei end up more tightly bound than they started, so the leftover energy comes out. Light nuclei get there by joining; heavy ones get there by splitting. One curve, two industries."],["DIV",{"class":"nk-chart-frame rounded-lg overflow-hidden border mb-2","style":"border-color: rgba(56, 189, 248, 0.35); height: 190px;"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":41,\"top\":23076.78125,\"right\":41,\"bottom\":23294.78125}","role":"img","data-a11y-static":"true","aria-describedby":"nk-binding-description","aria-label":"Binding energy per nucleon against mass number. It climbs steeply from hydrogen at zero, through helium-4 at 7.07, peaks at nickel-62 at 8.795 MeV, then falls slowly to uranium-238 at 7.57. Light nuclei release energy by fusing up the left slope; heavy nuclei release it by splitting down the right slope.","style":"width: 100%; height: 100%; display: block;"}]],["P",{"id":"nk-binding-description","class":"text-[0.625rem] mb-2","style":"color: rgb(148, 163, 184);"},"Mass number across, MeV per nucleon up. The marked peak is where nothing can release energy by changing at all."],["DIV",{"class":"flex flex-wrap gap-1 mb-2"},["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Deuterium + tritium. Work out the energy from Deuterium + tritium","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Deuterium + tritium"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Proton-proton chain. Work out the energy from Proton-proton chain","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Proton-proton chain"],["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"Uranium-235 fission. Work out the energy from Uranium-235 fission","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(167, 139, 250); color: rgb(11, 16, 32); border: 1px solid rgb(167, 139, 250);"},"Uranium-235 fission"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Burning carbon. Work out the energy from Burning carbon","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Burning carbon"]],["DIV",{"data-nk-exploration-progress":"reactionsSeen","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(56, 189, 248, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(56, 189, 248);"},"Try another option"],["PROGRESS",{"value":"0","max":"3","aria-label":"0 of 3 reactions deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(56, 189, 248);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 3 reactions deliberately compared"]],["DIV",{"class":"rounded-lg border p-2.5","style":"border-color: rgba(167, 139, 250, 0.44); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-mono mb-1.5","style":"color: rgb(226, 232, 240);"},"U-235 + n → Ba-141 + Kr-92 + 3n"],["DIV",{"class":"nk-stat-grid grid gap-2"},["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(251, 191, 36, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Energy released"],["P",{"class":"text-sm font-black","style":"color: rgb(251, 191, 36);"},"200 MeV"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(56, 189, 248, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Per nucleon"],["P",{"class":"text-sm font-black","style":"color: rgb(56, 189, 248);"},"0.85 MeV"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(244, 114, 182, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Mass converted"],["P",{"class":"text-sm font-black","style":"color: rgb(244, 114, 182);"},"0.091%"]]],["P",{"class":"text-[0.6875rem] mt-2 leading-relaxed","style":"color: rgb(226, 232, 240);"},"A reactor does this about 10²⁰ times a second. The products sit near the peak of the curve, so the drop is large in total even though it is modest per nucleon."],["P",{"class":"text-[0.6875rem] mt-1.5 font-mono","style":"color: rgb(148, 163, 184);"},"E = Δm c², and 1 atomic mass unit = 931.494 MeV. The mass really is missing — weigh the products and they come out lighter than what went in."]],["P",{"class":"text-[0.6875rem] mt-2 leading-relaxed","style":"color: rgb(226, 232, 240);"},"Fusion of deuterium and tritium releases about 3.5 MeV per nucleon; fission of uranium-235 about 0.85. Fusion wins per nucleon by roughly four to one — which is why it is worth the hundred-million-degree problem."],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(251, 191, 36, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(251, 191, 36);"},"A detail almost every textbook gets slightly wrong"],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"The peak is usually given as iron-56. The actual maximum is nickel-62 at 8.795 MeV per nucleon, just above iron-58 and then iron-56 at 8.790. Iron-56 is the most ABUNDANT end point, because stellar burning makes nickel-56 which decays to it — that is a statement about supernovae, not about binding. Both facts are true; they are answers to different questions."]],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(56, 189, 248, 0.333); background: rgba(15, 23, 42, 0.5);"},["P",{"class":"text-[0.6875rem] font-bold leading-relaxed","style":"color: rgb(56, 189, 248);"},"🤔 Nothing past the peak can release energy by fusing, and nothing before it by splitting. What does that mean for a star once its core is iron and nickel?"],["BUTTON",{"type":"button","aria-expanded":"false","class":"min-h-11 mt-1.5 px-3 py-2 rounded-lg text-[0.6875rem] font-black","style":"background: rgb(56, 189, 248); color: rgb(11, 16, 32); border: 1px solid rgb(56, 189, 248);"},"Worked it out? Check"]]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-weighting","data-nk-sec":"weighting","aria-labelledby":"nkheading-weighting","tabindex":"-1","style":"border-color: rgba(232, 121, 249, 0.333) rgba(232, 121, 249, 0.333) rgba(232, 121, 249, 0.333) rgb(232, 121, 249); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(232, 121, 249, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-weighting","style":"color: rgb(232, 121, 249); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(232, 121, 249, 0.267);"},"🎚️ 8. Gray and sievert: the same joule, weighted twice"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"Everything below this point is quoted in millisieverts, and a sievert is not a physical measurement. It is a physical measurement multiplied by two judgements about biology. Both multiplications are worth seeing, because alpha has little penetrating power through intact skin but is far more damaging when contamination reaches living tissue."],["DIV",{"class":"nk-slider flex items-center gap-2 mt-1.5"},["LABEL",{"for":"nk-absorbed","class":"text-[0.6875rem] font-bold w-28 flex-shrink-0","style":"color: rgb(203, 213, 225);"},"Energy absorbed"],["INPUT",{"__playwright_value_":"1","id":"nk-absorbed","type":"range","min":"0.1","max":"20","step":"0.1","aria-valuetext":"1 mGy","class":"nk-slider-input flex-1 min-w-0 min-h-11 accent-violet-500","value":"1"}],["OUTPUT",{"for":"nk-absorbed","class":"text-[0.6875rem] font-bold w-24 text-right","style":"color: rgb(196, 181, 253);"},"1 mGy"]],["P",{"class":"text-[0.625rem] mb-2","style":"color: rgb(148, 163, 184);"},"The gray is joules per kilogram of tissue, and nothing else. It does not know what kind of radiation delivered them or which organ received them. It is the one honestly physical quantity here."],["P",{"class":"text-[0.6875rem] font-bold mb-1","style":"color: rgb(203, 213, 225);"},"Delivered by"],["DIV",{"class":"flex flex-wrap gap-1 mb-1"},["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"γ Gamma / X-ray  ×1. Gamma / X-ray, radiation weighting factor 1","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(167, 139, 250); color: rgb(11, 16, 32); border: 1px solid rgb(167, 139, 250);"},"γ Gamma / X-ray  ×1"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"β Beta (electrons)  ×1. Beta (electrons), radiation weighting factor 1","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"β Beta (electrons)  ×1"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"p Protons  ×2. Protons, radiation weighting factor 2","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"p Protons  ×2"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"n Neutrons (fission energy)  ×20. Neutrons (fission energy), radiation weighting factor 20","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"n Neutrons (fission energy)  ×20"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"α Alpha  ×20. Alpha, radiation weighting factor 20","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"α Alpha  ×20"]],["DIV",{"data-nk-exploration-progress":"wrTried","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(232, 121, 249, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(232, 121, 249);"},"Try another option"],["PROGRESS",{"value":"0","max":"3","aria-label":"0 of 3 radiation types deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(232, 121, 249);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 3 radiation types deliberately compared"]],["P",{"class":"text-[0.6875rem] mb-2 leading-relaxed","style":"color: rgb(226, 232, 240);"},"The reference. A photon deposits its energy thinly along a track metres long, so the damage is spread out and cells usually repair it."],["P",{"class":"text-[0.6875rem] font-bold mb-1","style":"color: rgb(203, 213, 225);"},"To which tissue"],["DIV",{"class":"flex flex-wrap gap-1 mb-2"},["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"Whole body  1.00. Whole body, tissue weighting factor 1","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(232, 121, 249); color: rgb(11, 16, 32); border: 1px solid rgb(232, 121, 249);"},"Whole body  1.00"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Red bone marrow  0.12. Red bone marrow, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Red bone marrow  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Colon  0.12. Colon, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Colon  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Lung  0.12. Lung, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Lung  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Stomach  0.12. Stomach, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Stomach  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Breast  0.12. Breast, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Breast  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Remainder tissues  0.12. Remainder tissues, tissue weighting factor 0.12","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Remainder tissues  0.12"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Gonads  0.08. Gonads, tissue weighting factor 0.08","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Gonads  0.08"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Bladder  0.04. Bladder, tissue weighting factor 0.04","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Bladder  0.04"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Oesophagus  0.04. Oesophagus, tissue weighting factor 0.04","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Oesophagus  0.04"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Liver  0.04. Liver, tissue weighting factor 0.04","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Liver  0.04"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Thyroid  0.04. Thyroid, tissue weighting factor 0.04","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Thyroid  0.04"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Bone surface  0.01. Bone surface, tissue weighting factor 0.01","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Bone surface  0.01"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Brain  0.01. Brain, tissue weighting factor 0.01","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Brain  0.01"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Salivary glands  0.01. Salivary glands, tissue weighting factor 0.01","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Salivary glands  0.01"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Skin  0.01. Skin, tissue weighting factor 0.01","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Skin  0.01"]],["DIV",{"class":"grid grid-cols-1 sm:grid-cols-3 gap-2"},["DIV",{"class":"rounded-lg border p-2","style":"border-color: rgba(148, 163, 184, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(148, 163, 184);"},"ABSORBED DOSE"],["P",{"class":"text-sm font-black","style":"color: rgb(226, 232, 240);"},"1 mGy"],["P",{"class":"text-[0.625rem] mt-0.5","style":"color: rgb(148, 163, 184);"},"Pure physics: joules per kilogram."]],["DIV",{"class":"rounded-lg border p-2","style":"border-color: rgba(167, 139, 250, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(148, 163, 184);"},"EQUIVALENT DOSE"],["P",{"class":"text-sm font-black","style":"color: rgb(167, 139, 250);"},"1 mSv"],["P",{"class":"text-[0.625rem] mt-0.5","style":"color: rgb(148, 163, 184);"},"× wᴿ = 1, for how concentrated the damage is."]],["DIV",{"class":"rounded-lg border p-2","style":"border-color: rgba(232, 121, 249, 0.6); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(148, 163, 184);"},"EFFECTIVE DOSE"],["P",{"class":"text-sm font-black","style":"color: rgb(232, 121, 249);"},"1 mSv"],["P",{"class":"text-[0.625rem] mt-0.5","style":"color: rgb(148, 163, 184);"},"× wᵀ = 1.00, for how much that tissue contributes to whole-body risk."]]],["P",{"class":"text-[0.6875rem] mt-2 leading-relaxed","style":"color: rgb(226, 232, 240);"},"With gamma or beta the first multiplication does nothing — 1 mGy is 1 mSv, and this is why the two units get used interchangeably and then quietly confused. Switch to alpha and watch what the same joule becomes."],["P",{"class":"text-[0.6875rem] mt-1.5 leading-relaxed","style":"color: rgb(226, 232, 240);"},"Irradiate the whole body and every tissue weight applies at once. They are defined to sum to exactly 1.00, so effective dose and equivalent dose come out equal — the weights apportion risk, they never create or destroy it."],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(251, 146, 60, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(251, 146, 60);"},"What effective dose is NOT"],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"ICRP says this plainly and it is routinely ignored: effective dose is a protection quantity for setting limits and comparing procedures across a population. It is not a measure of harm to a particular person. The weights are averaged over both sexes and all ages, so applying them to one patient — to say \"your scan gave you this much risk\" — uses the number for something it was never built to do. Every figure in this tool is an effective dose, and that caveat rides along with all of them."]],["P",{"class":"text-[0.625rem] mt-2 leading-relaxed","style":"color: rgb(148, 163, 184);"},"Weighting factors from ICRP Publication 103 (2007), Tables 2 and 3. The neutron factor is shown as its ~1 MeV peak; the published value is a continuous function of energy from about 2.5 to 20."]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-biohalf","data-nk-sec":"biohalf","aria-labelledby":"nkheading-biohalf","tabindex":"-1","style":"border-color: rgba(244, 114, 182, 0.333) rgba(244, 114, 182, 0.333) rgba(244, 114, 182, 0.333) rgb(244, 114, 182); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(244, 114, 182, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-biohalf","style":"color: rgb(244, 114, 182); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(244, 114, 182, 0.267);"},"🫀 9. Half-life inside a body is a different number"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"Every half-life so far has been PHYSICAL — how fast the nuclei fall apart, a rate that is effectively fixed under ordinary conditions. But a nuclide inside a person is also being excreted, and the two processes run at once. Decay and excretion are rates, so they add: 1/Tₑ = 1/Tₚ + 1/Tᵦ. That makes the effective half-life shorter than EITHER of them — always. When the two are far apart the shorter one very nearly sets it on its own; when they are close, as they are for strontium and polonium below, neither number will do and only the formula gets you there."],["DIV",{"class":"flex flex-wrap gap-1 mb-2"},["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Technetium-99m. Compare the physical and biological half-life of Technetium-99m","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Technetium-99m"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Tritium (as water). Compare the physical and biological half-life of Tritium (as water)","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Tritium (as water)"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Potassium-40. Compare the physical and biological half-life of Potassium-40","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Potassium-40"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Iodine-131. Compare the physical and biological half-life of Iodine-131","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Iodine-131"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Polonium-210. Compare the physical and biological half-life of Polonium-210","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Polonium-210"],["BUTTON",{"type":"button","aria-pressed":"true","aria-label":"Caesium-137. Compare the physical and biological half-life of Caesium-137","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgb(244, 114, 182); color: rgb(11, 16, 32); border: 1px solid rgb(244, 114, 182);"},"Caesium-137"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Strontium-90. Compare the physical and biological half-life of Strontium-90","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Strontium-90"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Radium-226. Compare the physical and biological half-life of Radium-226","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Radium-226"],["BUTTON",{"type":"button","aria-pressed":"false","aria-label":"Plutonium-239. Compare the physical and biological half-life of Plutonium-239","data-nk-explored":"false","class":"min-h-11 px-3 py-2 rounded-lg text-[0.6875rem] font-bold transition-colors","style":"background: rgba(148, 163, 184, 0.12); color: rgb(226, 232, 240); border: 1px solid rgba(148, 163, 184, 0.3);"},"Plutonium-239"]],["DIV",{"data-nk-exploration-progress":"bioSeen","class":"nk-exploration-progress flex flex-wrap items-center gap-2 mb-2 rounded-lg border px-2.5 py-1.5","style":"border-color: rgba(244, 114, 182, 0.333); background: rgba(15, 23, 42, 0.5);"},["SPAN",{"class":"text-[0.625rem] font-black","style":"color: rgb(244, 114, 182);"},"Try another option"],["PROGRESS",{"value":"0","max":"4","aria-label":"0 of 4 nuclides deliberately compared","class":"flex-1 min-w-[7rem] h-2","style":"accent-color: rgb(244, 114, 182);"}],["SPAN",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"0 of 4 nuclides deliberately compared"]],["DIV",{"class":"nk-stat-grid grid gap-2"},["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(203, 213, 225, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Physical half-life"],["P",{"class":"text-sm font-black","style":"color: rgb(203, 213, 225);"},"30 years"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(56, 189, 248, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Biological half-life"],["P",{"class":"text-sm font-black","style":"color: rgb(56, 189, 248);"},"70 days"]],["DIV",{"class":"rounded-lg p-2 text-center","style":"background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(244, 114, 182, 0.314);"},["P",{"class":"text-[0.625rem] font-bold","style":"color: rgb(203, 213, 225);"},"Effective half-life"],["P",{"class":"text-sm font-black","style":"color: rgb(244, 114, 182);"},"69.6 days"]]],["P",{"class":"text-[0.6875rem] mt-2","style":"color: rgb(148, 163, 184);"},"Where it goes: Whole body — it behaves like potassium."],["DIV",{"class":"nk-chart-frame rounded-lg overflow-hidden border mt-2","style":"border-color: rgba(244, 114, 182, 0.35); height: 175px;"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":41,\"top\":40131.09375,\"right\":41,\"bottom\":40349.09375}","role":"img","data-a11y-static":"true","aria-describedby":"nk-bio-description","aria-label":"How much Caesium-137 is left in the body over time. Radioactive decay alone would leave 97.8 percent after 347.8 days, but with excretion as well only 3.1 percent remains. The effective half-life is 69.6 days.","style":"width: 100%; height: 100%; display: block;"}]],["P",{"id":"nk-bio-description","class":"text-[0.625rem] mt-1","style":"color: rgb(148, 163, 184);"},"Grey: decay alone. Colour: what is actually left, once the body is also getting rid of it."],["P",{"class":"text-[0.6875rem] mt-2 font-bold","style":"color: rgb(244, 114, 182);"},"Biology is running this one. The physical half-life is 157 times the biological one, so decay barely enters the calculation and the effective half-life lands within 0.6% of the biological figure alone."],["P",{"class":"text-[0.6875rem] mt-1.5 leading-relaxed","style":"color: rgb(226, 232, 240);"},"THE misconception in this whole tool. Caesium-137 defines the exclusion zones for thirty years because that is how long it persists in SOIL. Inside a person it is chemically potassium, and the body flushes potassium: about seventy days, and faster in children. The land and the person are two different clocks and they get quoted as one."],["DIV",{"class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(56, 189, 248, 0.5); background: rgba(15, 23, 42, 0.6);"},["P",{"class":"text-[0.6875rem] font-black mb-1","style":"color: rgb(56, 189, 248);"},"What potassium iodide tablets do, and what they do not"],["P",{"class":"text-[0.6875rem] leading-relaxed","style":"color: rgb(226, 232, 240);"},"KI is one of the most misunderstood things in this entire subject. It is not an anti-radiation pill. It works on exactly one nuclide by exactly one mechanism: it saturates the thyroid with ordinary iodine so there is no room left to take up iodine-131. That is the whole of it. It does nothing about caesium, nothing about external gamma, nothing about any other part of a release — and taken without radioiodine present it is simply a drug with side effects, which is why authorities distribute it in advance and then tell people when to take it rather than leaving it to judgement."],["ASIDE",{"role":"note","aria-label":"Educational safety notice","class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(248, 113, 113, 0.6); background: rgba(69, 10, 10, 0.35);"},["P",{"class":"text-[0.6875rem] font-black","style":"color: rgb(248, 113, 113);"},"Educational model — not emergency or medical instructions"],["P",{"class":"text-[0.6875rem] mt-1 leading-relaxed","style":"color: rgb(254, 202, 202);"},"Take potassium iodide only when public-health officials tell you to; it does not protect against most radiation hazards."],["A",{"href":"https://www.nrc.gov/about-nrc/emerg-preparedness/in-radiological-emerg","target":"_blank","rel":"noopener noreferrer","class":"inline-block mt-1 text-[0.6875rem] font-bold underline","style":"color: rgb(248, 113, 113);"},"Official NRC emergency guidance ↗"]]],["P",{"class":"text-[0.625rem] mt-2 leading-relaxed","style":"color: rgb(148, 163, 184);"},"Biological half-lives from the ICRP 30 and ICRP 137 biokinetic models, rounded. Unlike physical half-lives, which are constants of nature, these vary substantially with age, diet, chemical form and the individual — caesium clears roughly twice as fast in a small child as in an adult. Treat them as the right order of magnitude, not as measurements of you."]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-mydose","data-nk-sec":"mydose","aria-labelledby":"nkheading-mydose","tabindex":"-1","style":"border-color: rgba(34, 211, 238, 0.333) rgba(34, 211, 238, 0.333) rgba(34, 211, 238, 0.333) rgb(34, 211, 238); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(34, 211, 238, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},["H4",{"class":"nk-section-heading font-black mb-3 pb-2","id":"nkheading-mydose","style":"color: rgb(34, 211, 238); font-size: 0.875rem; line-height: 1.35rem; letter-spacing: -0.01em; border-bottom: 1px solid rgba(34, 211, 238, 0.267);"},"🧮 10. Estimate your own annual dose"],["P",{"class":"text-[0.6875rem] mb-2","style":"color: rgb(203, 213, 225);"},"Everyone is exposed, all the time, mostly from the ground and from radon. Put your own numbers in and see where yours comes from."],["ASIDE",{"role":"note","aria-label":"Educational safety notice","class":"mt-2 rounded-lg border p-2.5","style":"border-color: rgba(248, 113, 113, 0.6); background: rgba(69, 10, 10, 0.35);"},["P",{"class":"text-[0.6875rem] font-black","style":"color: rgb(248, 113, 113);"},"Educational model — not emergency or medical instructions"],["P",{"class":"text-[0.6875rem] mt-1 leading-relaxed","style":"color: rgb(254, 202, 202);"},"This personal-dose estimate is educational, not a medical assessment. Ask a qualified clinician, health physicist, or local radon program about a real exposure."],["A",{"href":"https://www.nrc.gov/about-nrc/emerg-preparedness/in-radiological-emerg","target":"_blank","rel":"noopener noreferrer","class":"inline-block mt-1 text-[0.6875rem] font-bold underline","style":"color: rgb(248, 113, 113);"},"Official NRC emergency guidance ↗"]],["DIV",{"class":"nk-slider flex items-center gap-2 mt-1.5"},["LABEL",{"for":"ds-alt","class":"text-[0.6875rem] font-bold w-28 flex-shrink-0","style":"color: 