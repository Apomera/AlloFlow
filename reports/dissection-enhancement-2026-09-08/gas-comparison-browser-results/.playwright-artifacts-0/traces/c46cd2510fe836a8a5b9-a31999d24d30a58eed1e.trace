itor__body { display: grid; gap: 0.55rem; padding: 0.6rem; }\n.diss-field-monitor__body > .diss-stage__telemetry, .diss-field-monitor__body > .diss-field-readiness { margin: 0px; }\n.diss-field-monitor__body > .diss-stage__telemetry-detail { padding: 0.45rem 0.55rem; border: 1px solid rgb(184, 205, 227); border-radius: 0.65rem; background: rgb(255, 255, 255); }\n.diss-field-readiness { display: grid; gap: 0.45rem; margin: -0.05rem 0px 0.65rem; padding: 0.52rem 0.62rem; border: 1px solid rgb(184, 205, 227); border-radius: 0.78rem; background: rgb(248, 251, 255); color: rgb(41, 75, 112); }\n.diss-field-readiness[data-tone=\"ready\"] { border-color: rgb(117, 201, 174); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-field-readiness[data-tone=\"caution\"] { border-color: rgb(228, 176, 90); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-field-readiness[data-tone=\"restricted\"] { border-color: rgb(224, 139, 139); background: rgb(255, 241, 242); color: rgb(136, 19, 55); }\n.diss-field-readiness__header { display: flex; min-width: 0px; align-items: baseline; justify-content: space-between; gap: 0.6rem; }\n.diss-field-readiness__header strong { color: currentcolor; font-size: 0.68rem; font-weight: 900; }\n.diss-field-readiness__score { color: currentcolor; font-size: 0.62rem; font-variant-numeric: tabular-nums; font-weight: 900; }\n.diss-field-readiness__cue { margin: 0px; color: currentcolor; font-size: 0.59rem; line-height: 1.35; opacity: 0.84; }\n.diss-field-readiness__checks { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 0.32rem; }\n.diss-field-readiness__check { min-width: 0px; padding: 0.3rem 0.38rem; border: 1px solid rgb(184, 205, 227); border-radius: 0.48rem; background: rgb(255, 255, 255); color: rgb(54, 80, 111); }\n.diss-field-readiness__check[data-ready=\"true\"] { border-color: rgb(117, 201, 174); background: rgb(240, 253, 244); color: rgb(6, 95, 70); }\n.diss-field-readiness__check[data-ready=\"false\"] { border-color: rgb(228, 176, 90); background: rgb(255, 251, 235); color: rgb(146, 64, 14); }\n.diss-field-readiness__check-head { display: flex; align-items: center; gap: 0.24rem; }\n.diss-field-readiness__check-head b { display: inline-grid; width: 0.95rem; height: 0.95rem; flex: 0 0 auto; place-items: center; border: 1px solid; border-radius: 999px; font-size: 0.55rem; }\n.diss-field-readiness__check-head span { overflow: hidden; font-size: 0.57rem; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }\n.diss-field-readiness__check-detail { display: block; margin-top: 0.16rem; overflow: hidden; font-size: 0.53rem; line-height: 1.25; opacity: 0.78; text-overflow: ellipsis; white-space: nowrap; }\n.diss-field-readiness__actions { display: flex; flex-wrap: wrap; gap: 0.32rem; }\n.diss-field-readiness__action { min-height: 2rem; padding: 0.28rem 0.48rem; border: 1px solid; border-radius: 0.45rem; background: transparent; color: currentcolor; font-size: 0.58rem; font-weight: 900; cursor: pointer; }\n.diss-field-readiness__action:hover { background: rgba(255, 255, 255, 0.62); }\n.diss-field-readiness__action:disabled { cursor: not-allowed; opacity: 0.68; }\n.diss-stage__telemetry-detail { border-top: 1px solid rgba(125, 174, 194, 0.58); padding-top: 0.34rem; }\n.diss-stage__telemetry-detail summary { display: flex; min-height: 2rem; align-items: center; cursor: pointer; color: currentcolor; font-size: 0.6rem; font-weight: 900; }\n.diss-stage__telemetry-detail[open] summary { margin-bottom: 0.35rem; }\n.diss-stage__telemetry-detail-body { display: grid; gap: 0.35rem; }\n.diss-stage__telemetry-detail-body > p { margin: 0px; color: currentcolor; font-size: 0.59rem; line-height: 1.4; }\n.diss-stage__telemetry-replay { justify-self: start; min-height: 2rem; padding: 0.28rem 0.48rem; border: 1px solid; border-radius: 0.45rem; background: transparent; color: currentcolor; font-size: 0.58rem; font-weight: 900; cursor: pointer; }\n.diss-stage__telemetry-replay