    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/8517.png",
      "text": "Haweeney duq ah ayaa haysatay digaag iyo diiq gaboobay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=1",
      "sourceDigest": "sha256:19355850b902bcb98100b5d05a912956bf1486550b9d4a1221e7cd5c4ad8eb70"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/8518.png",
      "text": "Wiil ayeeyo ay u tahay ayaa soo booqday. Waxay goaansatay inay disho diiqa duqa ah.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=2",
      "sourceDigest": "sha256:05d9dcf44cbf394ea29c7addb8f5ba83046b2b5d456ddb4a66ce288eaa253c12"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/8519.png",
      "text": "Diiqii duqqa ahaa wuxuu u cararay xagga gudaha magaalada weyn.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=3",
      "sourceDigest": "sha256:fbfaca41baf6353b4040a819bdb584fc602aaa344497d63d9ff279e168fc6b86"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/8520.png",
      "text": "Diiqii gaboobay ahaa waxaa uu lakulmay bisad ka cararaysa mulkiilaheedii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=4",
      "sourceDigest": "sha256:ee03e8ce57506180a0c343c5961e39c605aef0af5317fe6459872347514c3f65"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/8521.png",
      "text": "Diiqii gaboobay iyo bisaddii waxay lakulmeen ey cararaya mulkiilihiisii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=5",
      "sourceDigest": "sha256:6d0e34c59c05c2d8d746d333af2e02b65fc66c2d501d1f00e0399539eece4828"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/8522.png",
      "text": "Waxaa ku soo biiray faras asaguna ka cararaya mulkilihiisii sidoo kale.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=6",
      "sourceDigest": "sha256:2e7e8943c5fe164949cd5e5e714ef678911f64aefc67d4bb56a091a526568f3a"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/8523.png",
      "text": "Xayawaankii waxay yimaadeen guri. Waxay ku arkeen tuugo gudaha!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=7",
      "sourceDigest": "sha256:efef16b29a54cbd74fd622f9565c4641b219c578e94558ecb81668ac2adddb08"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/8524.png",
      "text": "Xayawaankii waxay ku heeseen si cod dheer ah si ay u cayriyaan tuugadii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=8",
      "sourceDigest": "sha256:c08a226b60a6b46b1bece9fa46e04cd0737b9e4c12aabcd10a054d199dac61eb"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/8525.png",
      "text": "Waxay cuneen cuntadii ay ka heleen guriga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=9",
      "sourceDigest": "sha256:0658c8e82ef82a7a6954b69fe1ff1d55e13a063478a130380ef048b71f4d1126"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/8526.png",
      "text": "Tuugadii way soo noqdeen mar danbe. Xayawaankii baa weeraray ayaga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=10",
      "sourceDigest": "sha256:531c05e42d8ffcfd8767276bdddf955fdbf6f32c4f1fb1bd83bd97952156c1ec"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/8527.png",
      "text": "Tuugadii way carareen dib danbe uma soo noqon.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=11",
      "sourceDigest": "sha256:c7bbb2df53f1c0c3bec2ad99345e25f3fa78f03e6f520b7f9c7f547ce00f1af4"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/8528.png",
      "text": "Xayawaankii waxay ku noolaadeen si wada jir ah farxad guriga gudihiisa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52479#page=12",
      "sourceDigest": "sha256:8af5c7b27ab46cb4dc5d5db12595f6377c140de53a2421d6954e25ef101dd194"
