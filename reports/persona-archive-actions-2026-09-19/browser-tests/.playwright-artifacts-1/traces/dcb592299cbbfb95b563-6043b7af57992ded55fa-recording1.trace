:"save_mapped","v":{"s":"Save mapped CSV as a region pack"}},{"k":"save_mapped_hint","v":{"s":"Map a CSV above first, then keep it as a reusable pack."}},{"k":"template","v":{"s":"Download a starter pack (JSON)"}},{"k":"list_heading","v":{"s":"Loaded region packs"}},{"k":"use","v":{"s":"Use"}},{"k":"download","v":{"s":"Download"}},{"k":"remove","v":{"s":"Remove"}},{"k":"empty","v":{"s":"No custom packs yet. Packs you load travel with the project file and device-local autosave."}},{"k":"active","v":{"s":"Active"}},{"k":"places","v":{"s":"places"}},{"k":"limit_note","v":{"s":"Up to 12 packs, 250 places, and 8 attributes each. Every pack gets generated inquiry missions; the hand-authored Maine series and official layers stay with the built-in packs."}},{"k":"limit_reached","v":{"s":"Remove a region pack before loading another. The studio keeps up to 12 custom packs."}},{"k":"status_replaced","v":{"s":"Updated region pack"}},{"k":"status_loaded","v":{"s":"Loaded region pack"}},{"k":"too_large","v":{"s":"Choose a region pack smaller than 2 MB."}},{"k":"rows_skipped","v":{"s":"rows were skipped for missing names, coordinates, or values."}},{"k":"unreadable","v":{"s":"That file could not be read."}},{"k":"status_removed","v":{"s":"Removed region pack"}},{"k":"quick_link","v":{"s":"Load a different region…"}},{"k":"coverage_summary","v":{"s":"Coverage notes (optional)"}},{"k":"coverage_intro","v":{"s":"Say which areas these points represent and which they leave out. The coverage lens shows these notes beside the map so nobody mistakes a sample for the whole region."}},{"k":"represented","v":{"s":"Represented areas (comma separated)"}},{"k":"gaps","v":{"s":"Known gaps (comma separated)"}},{"k":"coverage_note","v":{"s":"Coverage note"}},{"k":"preview_heading","v":{"s":"Review before using"}},{"k":"preview_caption","v":{"s":"First rows of the region pack"}},{"k":"preview_name","v":{"s":"Place"}},{"k":"preview_lat","v":{"s":"Latitude"}},{"k":"preview_lon","v":{"s":"Longitude"}},{"k":"preview_hint","v":{"s":"Adjust the pack name, area, and coverage notes above, then use the pack. Nothing is mapped until you confirm."}},{"k":"use_this","v":{"s":"Use this pack"}},{"k":"cancel_preview","v":{"s":"Discard preview"}},{"k":"rows_skipped_short","v":{"s":"rows skipped"}},{"k":"rows_truncated","v":{"s":"rows beyond the 250-place cap were dropped"}},{"k":"row","v":{"s":"Row"}},{"k":"paste","v":{"s":"Or paste region rows (CSV) or a JSON pack"}},{"k":"paste_placeholder","v":{"s":"name,latitude,longitude,population,elevation (m)\nPlace A,44.0,-70.0,1200,40"}},{"k":"paste_preview","v":{"s":"Preview pasted region"}},{"k":"include_boundaries","v":{"s":"Include the current boundary layer in the saved pack"}},{"k":"boundary_features","v":{"s":"boundary features"}},{"k":"pasted_label","v":{"s":"Pasted region"}},{"k":"paste_empty","v":{"s":"Paste region rows or a JSON pack first."}},{"k":"derived_boundaries","v":{"s":"Built from a boundary layer. Each place is the representative point of one boundary, and the boundaries came along as the polygon layer."}},{"k":"derived_points","v":{"s":"Built from the point features in this layer."}},{"k":"privacy_label","v":{"s":"Check this before mapping:"}},{"k":"privacy_note","v":{"s":"{precise} place(s) use 4 or more decimal places, which can identify a building, and {named} have identifier-like labels. Do not map student homes or other sensitive locations. Aggregate, blur, or suppress them first."}},{"k":"privacy_examples","v":{"s":"High precision:"}},{"k":"privacy_round","v":{"s":"Round these coordinates to 2 decimal places"}},{"k":"budget_exceeded","v":{"s":"These boundaries need {incoming} kB and your packs already use {used} kB of the {budget} kB the studio keeps on this device. Remove a pack with boundaries, or load this one without them."}},{"k":"quality_label","v":{"s":"Worth checking before you map this:"}},{"k":"quality_duplicate_names","v":{"s":"{count} place name(s) appear more than once, so rows may be double counted:"}},{"k":"quality_null_island","v":{"s":"{count} place(s) sit at 0, 0 in the Gulf of Guinea, which usually means a coordinate did not parse:"}},{"k":"quality_far_from_the_rest","v":{"s":"{count} place(s) lie more than 3,000 km from the rest, which often means a missing minus sign or swapped columns:"}},{"k":"quality_no_variation","v":{"s":"{count} attribute(s) hold the same value everywhere, so they cannot make a thematic map:"}}],"id":461}},{"k":"sr_region_pack_loaded","v":{"s":"Region pack loaded and mapped."}},{"k":"sr_region_pack_error","v":{"s":"Region pack error."}},{"k":"sr_region_pack_removed","v":{"s":"Region pack removed."}},{"k":"sr_region_pack_downloaded","v":{"s":"Region pack downloaded."}},{"k":"sr_region_pack_template_downloaded","v":{"s":"Region pack template downloaded."}},{"k":"sr_region_pack_previewed","v":{"s":"Region pack previewed. Review the places and attributes, then choose Use this pack."}},{"k":"sr_region_pack_preview_cancelled","v":{"s":"Region pack preview discarded."}},{"k":"gen","v":{"o":[{"k":"place_one","v":{"s":"place"}},{"k":"place_many","v":{"s":"places"}},{"k":"compare_title","v":{"s":"{a} and {b}"}},{"k":"duration_medium","v":{"s":"20-30 minutes"}},{"k":"compare_question","v":{"s":"How do the {a} and {b} patterns compare across the {n} mapped {places} in {scope}?"}},{"k":"compare_evidence","v":{"s":"Make one comparison claim. Cite at least two named places, one from each map, and name one limitation of the values in this pack."}},{"k":"compare_teacher","v":{"s":"Two synchronized maps invite students to confuse correlation with cause. Ask what else varies between the places, and whether {n} reference points can represent {scope}."}},{"k":"practice_pattern","v":{"s":"Spatial pattern comparison"}},{"k":"practice_argument","v":{"s":"Evidence-based argument"}},{"k":"practice_limits","v":{"s":"Data limitations and scale"}},{"k":"compare_step_setup","v":{"s":"Prepare the synchronized {a} and {b} maps."}},{"k":"compare_step_pattern","v":{"s":"Identify one similarity and one difference between the two patterns."}},{"k":"step_evidence_places","v":{"s":"Record evidence from at least two named places."}},{"k":"compare_step_limits","v":{"s":"Explain why the maps cannot prove what caused the pattern."}},{"k":"buffer_title","v":{"s":"{r} km service radius"}},{"k":"buffer_question","v":{"s":"Which mapped {places} in {scope} fall within a hypothetical {r} km straight-line radius of a center you choose?"}},{"k":"buffer_evidence","v":{"s":"State which places are inside the buffer and their {a} values, then explain why a circular straight-line buffer is not the same as travel time or equitable access."}},{"k":"buffer_teacher","v":{"s":"The {r} km radius is scaled to the extent of this pack, not to any real service standard. Students should say what radius would make sense for a real question and why."}},{"k":"practice_proximity","v":{"s":"GIS proximity analysis"}},{"k":"practice_models","v":{"s":"Model assumptions and limitations"}},{"k":"practice_quantitative","v":{"s":"Quantitative spatial reasoning"}},{"k":"buffer_step_setup","v":{"s":"Prepare a {r} km radius-buffer analysis on {a}."}},{"k":"buffer_step_place","v":{"s":"Place the center and inspect the selected point rows."}},{"k":"buffer_step_evidence","v":{"s":"Summarize the selected count and selected attribute values."}},{"k":"buffer_step_limits","v":{"s":"Contrast straight-line proximity with real transportation access."}},{"k":"extremes_title","v":{"s":"Highest and lowest {a}"}},{"k":"duration_short","v":{"s":"15-25 minutes"}},{"k":"extremes_question","v":{"s":"Where are the highest and lowest {a} values in {scope}, and what is near each of them?"}},{"k":"extremes_evidence","v":{"s":"Name the highest and lowest places with their values{unit}, describe where each sits on the map, and say what the pack does not tell you about them."}},{"k":"extremes_teacher","v":{"s":"Sorting the table twin is the accessible route to the same evidence as scanning the map. Push students from \"where\" to \"why might that be\" without letting them claim causes the data cannot support."}},{"k":"practice_table_map","v":{"s":"Table and map as equivalent evidence"}},{"k":"practice_distribution","v":{"s":"Describing spatial distribution"}},{"k":"practice_provenance","v":{"s":"Questioning data provenance"}},{"k":"extremes_step_setup","v":{"s":"Open the map with {a} as the thematic attribute and sort the table by value."}},{"k":"extremes_step_pattern","v":{"s":"Locate the highest and lowest places on the map or in the table."}},{"k":"extremes_step_evidence","v":{"s":"Record both places, their values, and what surrounds them."}},{"k":"extremes_step_limits","v":{"s":"Name one thing about these places the pack cannot show."}},{"k":"boundaries_title","v":{"s":"Inside the boundaries"}},{"k":"duration_long","v":{"s":"30-40 minutes"}},{"k":"boundaries_question","v":{"s":"Which mapped {places} fall inside each of the {k} boundary features in {scope}, and how would a different boundary change the answer?"}},{"k":"boundaries_evidence","v":{"s":"Choose a boundary, report its approximate area or perimeter and the places inside it, then describe how a different boundary could change the result."}},{"k":"boundaries_teacher","v":{"s":"These boundaries came with the pack. Ask who drew them, for what purpose, and whether the reference points are representative of the areas inside them."}},{"k":"practice_region","v":{"s":"Scale and region concepts"}},{"k":"practice_systems","v":{"s":"Systems and models"}},{"k":"practice_boundary","v":{"s":"Boundary and classification literacy"}},{"k":"boundaries_step_setup","v":{"s":"Load the pack boundaries as a polygon layer."}},{"k":"boundaries_step_measure","v":{"s":"Measure one polygon and select mapped places inside it."}},{"k":"boundaries_step_evidence","v":{"s":"Use the feature table and point table as evidence."}},{"k":"boundaries_step_limits","v":{"s":"Explain how boundaries and classification choices shape conclusions."}}],"id":462}},{"k":"time","v":{"o":[{"k":"mismatch_label","v":{"s":"Different region:"}},{"k":"mismatch_note","v":{"s":"This time series is the built-in Maine sample. It does not describe {pack}. Import a time-series CSV for your own region, or read the change results as a separate Maine dataset."}}],"id":463}},{"k":"sr_region_pack_rounded","v":{"s":"Region pack coordinates rounded to two decimal places."}},{"k":"autosave","v":{"o":[{"k":"ok","v":{"s":"Autosaved locally at {time}."}},{"k":"without_boundaries","v":{"s":"Autosaved locally at {time}, without the region pack boundaries. Download a project file to keep them."}},{"k":"without_packs","v":{"s":"Autosaved locally at {time}, without the region packs or the polygon layer. Download a project file to keep them."}},{"k":"unavailable","v":{"s":"Local autosave is unavailable or the project is too large. Download a project file instead."}},{"k":"draft_without_boundaries","v":{"s":"It was saved without region pack boundaries."}},{"k":"draft_without_packs","v":{"s":"It was saved without region packs or the polygon layer."}}],"id":464}},{"k":"compare","v":{"o":[{"k":"single_label","v":{"s":"One attribute only:"}},{"k":"single_note","v":{"s":"{pack} carries only {attribute}, so both maps show the same layer and there is no contrast to read. Add another numeric column to the pack, map a GeoJSON layer to compare against, or switch to a pack with more attributes."}}],"id":465}},{"k":"composer","v":{"o":[{"k":"stray_label","v":{"s":"Outside this region:"}},{"k":"stray_note","v":{"s":"{count} callout(s) sit outside the mapped places, so the exported map stretches to fit them and the region shrinks:"}},{"k":"stray_remove","v":{"s":"Remove the callouts outside this region"}},{"k":"outside_tag","v":{"s":"outside this region"}}],"id":466}},{"k":"sr_stray_annotations_removed","v":{"s":"{count} annotation(s) outside the mapped region removed."}},{"k":"remote","v":{"o":[{"k":"mismatch_label","v":{"s":"Different region:"}},{"k":"mismatch_note","v":{"s":"This lab uses a fixed illustrative Maine scene so the spectral values stay teachable. It does not show {region}. Read the change results as a separate Maine example, not as evidence about your own region."}}],"id":467}},{"k":"sr_studio_loaded","v":{"s":"GIS Studio loaded. Map layers and equivalent tables show {region}. Import CSV or GeoJSON, load a different region pack, compare satellite imagery, or explore projections."}},{"k":"sr_studio_active","v":{"s":"GIS Studio active."}},{"k":"sr_studio_terse","v":{"s":"GIS Studio."}},{"k":"sr_vertex_added","v":{"s":"Measurement vertex added at {lat}, {lon}."}},{"k":"sr_buffer_selected","v":{"s":"{radius} buffer selected {count} of {total} points."}},{"k":"sr_nearest_point","v":{"s":"{name} is nearest at {distance}."}},{"k":"sr_no_mapped_points","v":{"s":"No mapped points are available."}},{"k":"sr_workspace_opened","v":{"s":"{name} workspace"}},{"k":"sr_csv_rows_previewed","v":{"s":"{count} CSV rows previewed. Review the coordinate system and column mapping."}},{"k":"sr_csv_preview_error","v":{"s":"CSV preview error."}},{"k":"sr_csv_locations_mapped","v":{"s":"{count} CSV locations converted to WGS84 and mapped."}},{"k":"sr_csv_error","v":{"s":"CSV error."}},{"k":"sr_features_ready_for_review","v":{"s":"{count} spatial features are ready for review. The active map has not changed."}},{"k":"sr_features_mapped_from","v":{"s":"{count} {format} features mapped from {source}."}},{"k":"sr_spatial_layer_error","v":{"s":"Spatial layer error."}},{"k":"sr_join_rows_ready","v":{"s":"{rows} join rows and {columns} columns ready."}},{"k":"sr_join_match_summary","v":{"s":"{matched} boundaries matched. {rows} CSV rows and {boundaries} boundaries unmatched."}},{"k":"sr_join_applied","v":{"s":"Join applied. The choropleth now maps {field}."}},{"k":"sr_region_loaded","v":{"s":"{name} loaded."}},{"k":"sr_points_inside_boundary","v":{"s":"{count} of {total} points selected inside the boundary."}},{"k":"s