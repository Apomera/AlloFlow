<span data-dino-part-label="head" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Head</span>
