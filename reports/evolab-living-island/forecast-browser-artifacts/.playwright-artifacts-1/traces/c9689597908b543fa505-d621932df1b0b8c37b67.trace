lex-shrink: 0; }\n.ei-life-steps { list-style: none; margin: 0px; padding: 0px; display: grid; gap: 0px; }\n.ei-life-steps > li { position: relative; display: grid; grid-template-columns: 26px minmax(0px, 1fr); gap: 10px; padding: 14px 0px; }\n.ei-life-steps > li:not(:last-child)::before { content: \"\"; position: absolute; left: 12px; top: 35px; bottom: -14px; width: 2px; background: rgb(198, 215, 200); }\n.ei-life-number { position: relative; z-index: 1; display: grid; place-items: center; border-radius: 50%; width: 26px; height: 26px; background: rgb(44, 97, 78); color: rgb(255, 255, 255); font-size: 12px; font-weight: 700; }\n.ei-life-steps h3 { font-size: 14px; margin: 2px 0px; }\n.ei-life .ei-stack { gap: 9px; }\n.ei-life-result { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; padding: 11px; background: rgb(237, 242, 230); border: 1px solid rgb(209, 223, 205); border-radius: 10px; }\n.ei-life-result strong { display: block; font-size: 19px; line-height: 1.25; }\n.ei-life-result small { display: block; font-size: 10px; margin-top: 5px; }\n.ei-life-change { padding-left: 9px; border-left: 3px solid rgb(164, 123, 56); }\n.ei-app .ei-life-link { display: grid; text-align: left; gap: 3px; background: rgb(233, 241, 230); border-color: rgb(169, 195, 172); }\n.ei-life-link small { font-weight: 400; font-size: 11px; }\n.ei-life-context { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 16px; background: rgb(244, 243, 229); border-bottom: 1px solid rgb(190, 207, 189); }\n.ei-life-context > div { flex: 1 1 240px; min-width: 0px; }\n.ei-life-context strong { font-size: 13px; overflow-wrap: anywhere; }\n.ei-life-context button { font-size: 11px; }\n.ei-life { scroll-margin-top: calc(var(--ei-command-height,140px) + 14px); }\n.ei-resemblance-details { border: 1px solid rgb(191, 210, 196); border-radius: 10px; background: rgb(246, 247, 238); padding: 10px; }\n.ei-resemblance-details > summary, .ei-pairing-details > summary { font-size: 12px; font-weight: 700; cursor: pointer; line-height: 1.5; }\n.ei-resemblance-details[open] > .ei-resemblance { margin-top: 12px; }\n.ei-resemblance-family { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 5px; }\n.ei-resemblance-member { display: grid; grid-template-rows: auto 45px 1fr auto auto 5px; justify-items: center; align-content: stretch; gap: 5px; border: 1px solid rgb(210, 220, 204); border-radius: 9px; padding: 8px 4px; min-width: 0px; background: rgb(255, 254, 249); text-align: center; }\n.ei-resemblance-member.ei-resemblance-child { border-color: rgb(114, 149, 125); background: rgb(233, 240, 227); }\n.ei-life .ei-resemblance-member .ei-portrait { width: 40px; height: 45px; }\n.ei-resemblance-member strong { font-size: 11px; overflow-wrap: anywhere; max-width: 100%; }\n.ei-resemblance-member small { font-size: 10px; }\n.ei-resemblance-member b { font-size: 15px; font-variant-numeric: tabular-nums; }\n.ei-resemblance-member .ei-meter { width: 100%; height: 5px; margin-top: 2px; }\n.ei-resemblance-member .ei-meter span { background: rgb(67, 110, 87); }\n.ei-resemblance-insight { border-left: 3px solid rgb(100, 136, 108); padding-left: 9px; }\n.ei-pairing-details > .ei-stack { margin-top: 10px; }\n.ei-pairing-grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 7px; }\n.ei-app .ei-pairing-grid button { display: grid; gap: 4px; padding: 9px 5px; text-align: center; font-size: 11px; }\n.ei-pairing-grid button strong { font-size: 19px; }\n.ei-pairing-grid button small { font-size: 9px; }\n.ei-pairing-grid button[data-recorded-pair=\"true\"] { border: 2px solid rgb(150, 114, 47); }\n.ei-app .ei-pairing-grid button[aria-pressed=\"true\"] { background: rgb(224, 237, 240); color: rgb(24, 78, 94); border-color: rgb(53, 118, 138); box-shadow: rgb(53, 118, 138) 0px 0px 0px 1px inset; }\n.ei-pairing-result, .ei-resemblance-record { padding: 10px; border-radius: 8px; background: rgb(230, 237, 226); font-size: 12px; }\n.ei-pairing-result p { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.ei-resemblance small { line-height: 1.5; }\n.ei-app .ei-resemblance-details select { font-size: 12px; }\n.ei-siblings { border-top: 1px solid rgb(199, 215, 197); padding-top: 10px; }\n.ei-siblings > summary { font-size: 12px; font-weight: 700; cursor: pointer; line-height: 1.5; }\n.ei-siblings > .ei-stack { margin-top: 10px; }\n.ei-sibling-groups, .ei-sibling-comparison { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 7px; }\n.ei-app .ei-sibling-groups button { display: flex; align-items: center; justify-content: space-between; gap: 5px; padding: 9px 8px; font-size: 11px; }\n.ei-app .ei-sibling-groups button[aria-pressed=\"true\"] { background: rgb(37, 92, 71); color: rgb(255, 254, 247); border-color: rgb(37, 92, 71); }\n.ei-sibling-groups span { font-variant-numeric: tabular-nums; }\n.ei-sibling-browse { display: grid; grid-template-columns: minmax(0px, 1fr) auto minmax(0px, 1fr); align-items: center; gap: 5px; text-align: center; }\n.ei-app .ei-sibling-browse button { font-size: 10px; padding: 7px 4px; min-height: 36px; }\n.ei-sibling-browse small { font-variant-numeric: tabular-nums; }\n.ei-sibling-parents { overflow-wrap: anywhere; }\n.ei-siblings { min-width: 0px; }\n.ei-siblings select { max-width: 100%; min-width: 0px; }\n.ei-app .ei-birth-shortcut { display: grid; gap: 3px; text-align: left; background: rgb(240, 238, 225); border-color: rgb(196, 187, 150); }\n.ei-birth-shortcut small { font-size: 11px; font-weight: 400; }\n.ei-birth-resemblance > summary { scroll-margin-top: 12px; }\n.ei-birth-intro { margin: 10px 0px !important; }\n.ei-parent-visits { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 6px; }\n.ei-app .ei-parent-visits button { display: grid; gap: 4px; padding: 8px 5px; min-width: 0px; font-size: 11px; }\n.ei-parent-visits small { font-size: 10px; overflow-wrap: anywhere; font-w