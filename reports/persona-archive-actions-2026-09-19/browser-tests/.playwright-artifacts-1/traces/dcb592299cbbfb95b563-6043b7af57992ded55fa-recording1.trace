":"i - VI - III - VII"}},{"k":"i_v_vi_iii_iv","v":{"s":"I - V - vi - iii - IV"}},{"k":"12_bar_blues_2","v":{"s":"12-Bar Blues"}},{"k":"the_science_of_chord_progressions","v":{"s":"🔬 The Science of Chord Progressions"}},{"k":"chord_progressions_create_emotional_jo","v":{"s":"Chord progressions create emotional journeys. The I chord (tonic) feels like 'home.' The V chord (dominant) creates tension that wants to resolve back to I. The vi chord (relative minor) adds sadness or depth. The IV chord (subdominant) moves away from home gently. The I-V-vi-IV progression is estimated to appear in over 70% of pop songs because it balances these emotions perfectly."}},{"k":"roman_numerals_i_ii_iii_iv_v_vi_vii_re","v":{"s":"Roman numerals (I, ii, iii, IV, V, vi, vii°) represent scale degrees. Uppercase = major chord. Lowercase = minor chord."}},{"k":"musical_notation","v":{"s":"🎼 Musical Notation"}},{"k":"click_notes_to_hear_them","v":{"s":"Click notes to hear them!"}},{"k":"add_melody_notes_in_the_grid_above","v":{"s":"Add melody notes in the grid above ↑"}},{"k":"drums","v":{"s":"Drums"}},{"k":"click_melody_cells_in_the_grid_above_t","v":{"s":"Click melody cells in the grid above to see notation here"}},{"k":"whole_note","v":{"s":"Whole Note"}},{"k":"held_for_a_full_bar","v":{"s":"Held for a full bar"}},{"k":"half_note","v":{"s":"Half Note"}},{"k":"held_for_half_a_bar","v":{"s":"Held for half a bar"}},{"k":"quarter_note","v":{"s":"Quarter Note"}},{"k":"one_tap_per_beat","v":{"s":"One tap per beat"}},{"k":"eighth_note","v":{"s":"Eighth Note"}},{"k":"two_per_beat_1_2","v":{"s":"Two per beat (1 & 2 &)"}},{"k":"rhythm_challenge","v":{"s":"🥊 Rhythm Challenge"}},{"k":"challenge_me","v":{"s":"🎲 Challenge me!"}},{"k":"random","v":{"s":"Random"}},{"k":"random_2","v":{"s":"🎲 Random"}},{"k":"load_this_rhythm_into_row_0_kick","v":{"s":"Load this rhythm into row 0 (Kick)?"}},{"k":"load_to_grid","v":{"s":"Load to Grid"}},{"k":"load_to_grid_2","v":{"s":"▶ Load to Grid"}},{"k":"click_challenge