+import { beforeAll, afterEach, describe, expect, it } from 'vitest';
+import { fixtures, copy, setupDraftReader, cleanupDraftReader, mountDraft } from './helpers/reader_passage_label_harness.js';
+beforeAll(setupDraftReader); afterEach(cleanupDraftReader);
+// Run against the assembled reader and host literal-placeholder fix.
+describe.each(fixtures)('$id literal learner text in the localized pin label', f => {
+  it.each(['$&','$$','{start}','{item}'])('preserves the exact learner suffix %s', suffix => {
+    const word = f.word + suffix, passage = '«' + word + '»';
+    const h = mountDraft({ ...f, word, passage }, { adapted: false });
+    const checkbox = h.host.querySelector('li input[type=checkbox]');
+    const occurrence = word + ', text position 2–' + (1 + word.length) + ': ' + passage;
+    expect(checkbox.getAttribute('aria-label')).toBe(copy(f, 'gloss_pin_for').replace('{item}', () => occurrence));
+    expect(h.saved().annotations[0].quote).toBe(word); expect(h.current().sourceSnapshot.text).toBe(passage); expect(h.onUpdate).not.toHaveBeenCalled();
+  });
+});
