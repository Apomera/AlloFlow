+export const english = JSON.parse(readFileSync('ui_strings.js', 'utf8'));
+export const BODY = 'The sun warms water in lakes. Water evaporates into the air, cools into clouds, and falls as rain. Rivers carry water back to lakes.';
+let createContentEngine;
+const hostSource = readFileSync('AlloFlowANTI.txt', 'utf8');
+const translators = [...hostSource.matchAll(/const t = useCallback\((\(keyString, params = \{\}\) => \{[\s\S]+?\}), \[languagePack\]\);/g)];
+if (translators.length !== 1) throw Error('Host translator boundary changed; review fixture extraction.');
+const createTranslator = new Function('languagePack', 'UI_STRINGS', 'WORD_SOUNDS_STRINGS', 'return (' + translators[0][1] + ');');
+const localePacks = new Map(fixtures.map(fixture => [fixture.locale, fixture.locale === 'English' ? {} : JSON.parse(readFileSync('lang/' + fixture.locale + '.js', 'utf8'))]));
+export function hostTranslator(locale, overridePack) {
+  return createTranslator(overridePack ?? localePacks.get(locale), english, {});
+}
+export function setupEngine() {
+  loadAlloModule('text_pipeline_helpers_module.js');
+  loadAlloModule('own_sources_module.js');
+  window.__alloUtils = { ...window.AlloModules.TextPipelineHelpers, cleanJson: value => String(value || '').trim(), safeJsonParse: value => { try { return JSON.parse(value); } catch (_) { return null; } } };
+  new Function(readFileSync('content_engine_source.jsx', 'utf8'))();
+  createContentEngine = window.AlloModules.createContentEngine;
+}
+export function sourceHarness(fixture, { partial = false, translate = hostTranslator(fixture.locale) } = {}) {
+  vi.useFakeTimers();
+  const priorReading = { id: 'existing-' + fixture.id, data: fixture.oldInput, config: { language: fixture.tag } };
+  const state = { inputText: fixture.oldInput, generatedContent: priorReading, activeView: 'output', error: null,
+    gradeLevel: '5th Grade', sourceTopic: 'Water cycle', currentUiLanguage: fixture.uiLanguage, leveledTextLanguage: 'English',
+    selectedLanguages: [], studentInterests: [], selectedConcepts: [], sourceCustomInstructions: '', sourceLength: partial ? '1500' : '250',
+    sourceLevel: '5th Grade', sourceTone: 'Informative', sourceVocabulary: '', resourceCount: 1, targetStandards: [], dokLevel: '', selectedFont: 'Default',
+    includeSourceCitations: false, useOwnSources: false, documentsOnly: false, standardsPromptString: '', ai: { backend: 'gemini' },
+    alloBotRef: { current: null }, showSourceGen: true, isGeneratingSource: false, generationStep: '', recordSourceProvenance: vi.fn() };
+  for (const key of ['activeView','error','generatedContent','generationStep','inputText','isGeneratingSource','showSourceGen']) state['set' + key[0].toUpperCase() + key.slice(1)] = vi.fn(value => { state[key] = typeof value === 'function' ? value(state[key]) : value; });
+  let articleCalls = 0; const unexpected = [];
+  const callGemini = vi.fn(async prompt => {
+    if (/Plan a comprehensive educational article/.test(prompt)) return JSON.stringify(['Evaporation','Condensation','Rain']);
+    if (/Write a self-contained educational article|Write the section/.test(prompt)) { articleCalls++; return partial && articleCalls === 2 ? '## Condensation\n\n' + BODY : ''; }
+    unexpected.push(prompt); throw Error('Unexpected request: ' + String(prompt).slice(0,80));
+  });
+  const addToast = vi.fn(), engine = createContentEngine({ callGemini, addToast, t: translate, getState: () => state, flyToElement: () => {} });
+  return { state, priorReading, callGemini, addToast, engine, unexpected };
+}
+export async function finish(h) { const operation = h.engine.handleGenerateSource(); const completed = operation.then(value => ({ value }), error => ({ error })); await vi.runAllTimersAsync(); const result = await completed; if (result.error) throw result.error; }
+export function cleanupEngine() { delete window.callGemini; delete window.__contentEngineState; vi.clearAllTimers(); vi.useRealTimers(); vi.restoreAllMocks(); }
