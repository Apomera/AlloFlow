,"v":{"s":"Bake verdict"}},{"k":"verdict_flat","v":{"s":"Flat and dense — more like a cracker than a cake."}},{"k":"verdict_low","v":{"s":"Slight rise. Think biscuit or thick pancake."}},{"k":"verdict_medium","v":{"s":"Soft and tender. Good for muffins or banana bread."}},{"k":"verdict_high","v":{"s":"Fluffy and airy. Classic cake or quick-bread territory."}},{"k":"verdict_peak","v":{"s":"Maximum lift! Think soufflé or tall layer cake."}},{"k":"verdict_over","v":{"s":"Over-leavened — will collapse as it cools."}},{"k":"explain_soda_no_acid","v":{"s":"Baking soda needs an acid. With no acid, it just tastes metallic and the dough won't rise much."}},{"k":"explain_soda","v":{"s":"Baking soda (NaHCO₃) + {acid} → carbon dioxide gas (CO₂). The bubbles get trapped in the dough and make it rise."}},{"k":"explain_powder","v":{"s":"Baking powder already contains an acid (cream of tartar). Just add water and heat to activate it — no extra acid needed."}},{"k":"explain_yeast","v":{"s":"Yeast is alive. It eats sugars and breathes out CO₂. Slow but powerful — this is how real bread rises."}}],"id":94}},{"k":"emulsion","v":{"o":[{"k":"tagline","v":{"s":"Oil and water don't mix. Egg yolks help."}},{"k":"choose_goal","v":{"s":"Choose a goal"}},{"k":"your_mix","v":{"s":"Your mix"}},{"k":"shake_btn","v":{"s":"Shake & check"}},{"k":"stable","v":{"s":"Stable"}},{"k":"broken","v":{"s":"Broken"}},{"k":"mixing","v":{"s":"Mixing…"}},{"k":"oil","v":{"s":"Oil"}},{"k":"water","v":{"s":"Water"}},{"k":"yolk","v":{"s":"Egg yolk"}},{"k":"target","v":{"s":"target"}},{"k":"oil_layer","v":{"s":"Oil layer"}},{"k":"water_layer","v":{"s":"Water layer"}},{"k":"success_toast","v":{"s":"Stable! Your {name} holds together."}},{"k":"not_quite","v":{"s":"Not quite — try adjusting toward the target."}},{"k":"science_title","v":{"s":"The science"}}],"id":95}},{"k":"scaler","v":{"o":[{"k":"tagline","v":{"s":"Scale recipes with ratios — and see baker's percentages."}},{"k":"recipe","v":{"s":"Recipe"}},{"k":"scale","v":{"s":"Scale"}},{"k":"units","v":{"s":"Units"}},{"k":"makes_servings","v":{"s":"Makes {n} servings"}},{"k":"cup_warning","v":{"s":"Cup conversions are approximate — always weigh for precision."}},{"k":"save_btn","v":{"s":"Save scaled recipe"}},{"k":"flour_anchor","v":{"s":"Flour = 100% (baker's %)"}},{"k":"col_ingredient","v":{"s":"Ingredient"}},{"k":"col_amount","v":{"s":"Amount"}},{"k":"col_bakers","v":{"s":"Baker's %"}},{"k":"hydration","v":{"s":"Hydration"}},{"k":"hydration_hint","v":{"s":"Liquid weight ÷ flour weight. Higher hydration = more open crumb."}},{"k":"lock_flour","v":{"s":"Lock flour weight"}},{"k":"lock_flour_hint","v":{"s":"Pick a flour amount and everything else scales by baker's %."}},{"k":"flour_weight","v":{"s":"Flour weight"}},{"k":"math_title","v":{"s":"The math"}},{"k":"scaled_toast","v":{"s":"Recipe scaled to {n} servings."}}],"id":96}},{"k":"oven","v":{"o":[{"k":"tagline","v":{"s":"Slide the temperature to see what happens inside the oven."}},{"k":"temperature","v":{"s":"Temperature"}},{"k":"unit_f","v":{"s":"°F"}},{"k":"unit_c","v":{"s":"°C"}},{"k":"happening_now","v":{"s":"Happening now"}},{"k":"coming_up","v":{"s":"Coming up at {temp}"}},{"k":"degrees_to_go","v":{"s":"{n} to go"}},{"k":"all_milestones","v":{"s":"You've hit every oven milestone!"}},{"k":"oven_cold","v":{"s":"Oven is still cold. Raise the temperature to start reactions."}},{"k":"all_events","v":{"s":"All oven events"}},{"k":"science_title","v":{"s":"The science"}},{"k":"bake_zones_title","v":{"s":"Bake zones"}},{"k":"zone_meringue","v":{"s":"Meringue"}},{"k":"zone_proof","v":{"s":"Proof dough"}},{"k":"zone_custard","v":{"s":"Custard"}},{"k":"zone_cookies","v":{"s":"Cookies"}},{"k":"zone_cake","v":{"s":"Cake"}},{"k":"zone_bread","v":{"s":"Bread"}},{"k":"zone_pizza","v":{"s":"Pizza"}}],"id":97}},{"k":"diagnosis","v":{"o":[{"k":"tagline","v":{"s":"Something went wrong in the bake. Which explanation fits best?"}},{"k":"symptom","v":{"s":"Symptom"}},{"k":"pick_cause","v":