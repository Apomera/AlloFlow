side_the_wide_line_adjust_your_line_tight","v":{"s":"Wide. Outside the wide line — adjust your line tighter to off-stump."}},{"k":"sr_dot_ball_passes_the_bat_without_hitting_stumps_de","v":{"s":"Dot ball — passes the bat without hitting stumps. Defensible delivery."}},{"k":"sr_short_of_a_length_ball_bounced_too_far_in_front_o","v":{"s":"Short of a length — ball bounced too far in front of the batter."}},{"k":"sr_serve_in_receivable_but_landed_in_court_point_sta","v":{"s":"Serve in. Receivable, but landed in court — point stays in play."}},{"k":"sr_net_hit_the_tape_service_error_add_launch_angle_b","v":{"s":"Net! Hit the tape — service error. Add launch angle by 2-4°."}},{"k":"sr_out_wide_of_the_sideline_adjust_horizontal_aim","v":{"s":"Out wide of the sideline — adjust horizontal aim."}},{"k":"sr_long_past_the_back_line_reduce_speed_by_5_8_mph_o","v":{"s":"Long — past the back line. Reduce speed by 5-8 mph or steepen launch slightly."}},{"k":"sr_short_landed_on_your_side_of_the_net_add_power","v":{"s":"Short — landed on your side of the net. Add power."}},{"k":"sr_fairway_solid_strike_in_the_short_grass","v":{"s":"Fairway! Solid strike, in the short grass."}},{"k":"sr_in_the_rough_playable_but_the_next_shot_is_harder","v":{"s":"In the rough. Playable, but the next shot is harder out of long grass."}},{"k":"sr_in_the_trees_way_off_line_check_your_horizontal_a","v":{"s":"In the trees! Way off-line — check your horizontal aim or spin axis."}},{"k":"sr_short_of_the_green_need_more_clubhead_speed_or_a","v":{"s":"Short of the green. Need more clubhead speed or a longer club."}},{"k":"sr_long_flew_the_green_same_club_ease_back_on_speed","v":{"s":"Long — flew the green. Same club, ease back on speed by 5-10 mph."}},{"k":"sr_topped_or_shanked_barely_got_airborne","v":{"s":"Topped or shanked — barely got airborne."}},{"k":"sr_replay_analysis_finished_full_trajectory_shown","v":{"s":"Replay analysis finished. Full trajectory shown."}},{"k":"sr_replay_shown_without_animation_because_reduced_mo","v":{"s":"Replay shown without animation because reduced motion is enabled. Use the timeline or step controls to inspect frames."}},{"k":"sr_replay_complete","v":{"s":"Replay complete."}},{"k":"sr_immersive_perspective_snapshot_prepared","v":{"s":"Immersive perspective snapshot prepared."}},{"k":"sr_immersive_camera_overlays_vectors_and_replay_sett","v":{"s":"Immersive camera, overlays, vectors, and replay settings reset."}},{"k":"sr_daily_challenge_already_complete_come_back_tomorr","v":{"s":"Daily Challenge already complete. Come back tomorrow for a new one."}},{"k":"sr_drill_stopped","v":{"s":"Drill stopped."}},{"k":"sr_behind_launch_3d_view_selected","v":{"s":"Behind-launch 3D view selected."}},{"k":"sr_sideline_3d_view_selected","v":{"s":"Sideline 3D view selected."}},{"k":"sr_overhead_3d_view_selected","v":{"s":"Overhead 3D view selected."}},{"k":"sr_3d_camera_reset","v":{"s":"3D camera reset."}},{"k":"sr_replay_paused","v":{"s":"Replay paused."}},{"k":"a11y_3d_view_presets","v":{"s":"3D view presets"}},{"k":"a11y_3d_learning_overlays","v":{"s":"3D learning overlays"}},{"k":"a11y_3d_camera_controls","v":{"s":"3D camera controls"}},{"k":"a11y_rotate_camera_left_15_degrees","v":{"s":"Rotate camera left 15 degrees"}},{"k":"a11y_rotate_camera_right_15_degrees","v":{"s":"Rotate camera right 15 degrees"}},{"k":"a11y_lower_camera","v":{"s":"Lower camera"}},{"k":"a11y_raise_camera","v":{"s":"Raise camera"}},{"k":"a11y_reset_3d_camera","v":{"s":"Reset 3D camera"}},{"k":"a11y_physics_vector_overlays","v":{"s":"Physics vector overlays"}},{"k":"a11y_immersive_analysis_exports_and_reset","v":{"s":"Immersive analysis exports and reset"}},{"k":"a11y_step_replay_backward_one_physics_sample","v":{"s":"Step replay backward one physics sample"}},{"k":"a11y_step_replay_forward_one_physics_sample","v":{"s":"Step replay forward one physics sample"}},{"k":"a11y_finish_replay_analysis_and_show_the_full_trajec","v":{"s":"Finish replay analysis and show the full trajectory"}},{"k":"a11y_trajectory_replay_timeline","v":{"s":"Trajectory replay timeline"}},{"k":"a11y_replay_progress","v":{"s":"Replay progress"}},{"k":"a11y_replay_speed","v":{"s":"Replay speed"}},{"k":"a11y_saved_comparison_trajectories","v":{"s":"Saved comparison trajectories"}},{"k":"a11y_current_throw_lab_session_summary","v":{"s":"Current Throw Lab session summary"}},{"k":"fuchsia","v":{"s":"Fuchsia"}},{"k":"cyan","v":{"s":"Cyan"}},{"k":"lime","v":{"s":"Lime"}},{"k":"orange","v":{"s":"Orange"}},{"k":"math_behind_the_throw","v":{"s":"Math behind the throw"}},{"k":"g","v":{"s":"g = "}},{"k":"m_s","v":{"s":" m/s² ("}},{"k":"ball_m","v":{"s":"Ball: m = "}},{"k":"r","v":{"s":"r = "}},{"k":"cd","v":{"s":"Cd = "}},{"k":"cm","v":{"s":"Cm = "}},{"k":"a_r","v":{"s":"A = πr² = "}},{"k":"drag_force","v":{"s":"Drag force"}},{"k":"f_drag_v_rel_cd_a","v":{"s":"F_drag = ½·ρ·|v_rel|²·Cd·A"}},{"k":"n_at_release","v":{"s":" N at release"}},{"k":"magnus_lift_force","v":{"s":"Magnus (lift) force"}},{"k":"f_mag_v_rel_cm_a_v","v":{"s":"F_mag = ½·ρ·|v_rel|²·Cm·A · (ω̂ × v̂)"}},{"k":"n_max_possible_at_this_speed","v":{"s":" N (max possible at this speed)"}},{"k":"ideal_no_drag_range","v":{"s":"Ideal (no-drag) range"}},{"k":"r_v_sin_2_g","v":{"s":"R = v²·sin(2θ)/g"}},{"k":"m_at","v":{"s":" m at θ = "}},{"k":"actual","v":{"s":" · actual: "}},{"k":"bounce_coefficient_of_restitution","v":{"s":"Bounce (coefficient of restitution)"}},{"k":"v_after_e_v_before_ke_after_e_ke_befor","v":{"s":"|v_after| = e · |v_before|     KE_after = e²·KE_before"}},{"k":"e","v":{"s":"e = "}},{"k":"for_a","v":{"s":" for a "}},{"k":"on_a_regulation_surface","v":{"s":" on a regulation surface. "}},{"k":"a_1m_drop_bounces_back","v":{"s":"A 1m drop bounces back "}},{"k":"m_of_height_energy_retained","v":{"s":" m of height (energy retained)."}},{"k":"why_it_matters","v":{"s":"Why it matters:"}},{"k":"close_scenario_intro","v":{"s":"Close scenario intro"}},{"k":"the_story","v":{"s":"📜 The story"}},{"k":"try_these_before_you_run_it","v":{"s":"🤔 Try these before you run it"}},{"k":"run_it_now","v":{"s":"🎯 Run it now"}},{"k":"explore_controls_first","v":{"s":"🔧 Explore controls first"}},{"k":"pitch_added_to_your_locker","v":{"s":"Pitch added to your locker"}},{"k":"back_to_stem_lab","v":{"s":"Back to STEAM Lab"}},{"k":"back","v":{"s":"← Back"}},{"k":"same_arm_different_ball_different_game","v":{"s":"Same arm, different ball, different game."}},{"k":"pitch_locker","v":{"s":"Pitch Locker"}},{"k":"sport_modes","v":{"s":"Sport modes"}},{"k":"pitcher_s_mound_60_ft_6_in_to_home_pla","v":{"s":"Pitcher's Mound — 60 ft 6 in to home plate"}},{"k":"6_grips_6_trajectories_fastball_straig","v":{"s":"6 grips, 6 trajectories. Fastball straight; curve drops via topspin; slider breaks late; splitter dies; sinker bores in; changeup deceives. Magnus force IS real — spin axis decides everything."}},{"k":"free_throw_15_ft_from_line_to_hoop","v":{"s":"Free Throw — 15 ft from line to hoop"}},{"k":"same_line_same_23cm_rim_very_different","v":{"s":"Same line, same 23cm rim, very different shooters. Shaq career 52%, Steph Curry 91%. Soft arc, backspin, knees-into-shot — muscle memory you build one shot at a time."}},{"k":"free_kick_22m_a_4_defender_wall","v":{"s":"Free Kick — 22m + a 4-defender wall"}},{"k":"beckham_knuckle_roberto_carlos_banana_","v":{"s":"Beckham knuckle, Roberto Carlos banana, Messi top-bin. Magnus = the curl. Hit the seam off-center, side-spin bends it around the wall, into the corner the keeper can’t reach."}},{"k":"field_goal_18_5_ft_wide_10_ft_up","v":{"s":"Field Goal — 18.5 ft wide, 10 ft up"}},{"k":"justin_tucker_has_hit_66_yds_from_30_y","v":{"s":"Justin Tucker has hit 66+ yds. From 30 yd a pro hits ~95%; from 50+ it drops fast. Wind and the snap matter as much as leg power. Loneliest position on the field."}},{"k":"bowler_s_crease_22_yd_to_the_stumps","v":{"s":"Bowler's Crease — 22 yd to the stumps"}},{"k":"yorker_at_the_toes_bouncer_at_the_ches","v":{"s":"Yorker at the toes, bouncer at the chest, off-cutter that nips, googly that turns the wrong way. Fast bowlers hit 95+ mph and the ball BOUNCES — Test cricket’s purest weapon."}},{"k":"golf_tee_shot_driver_to_wedge","v":{"s":"Golf Tee Shot — driver to wedge"}},{"k":"driver_carries_250_yd_sand_wedge_85_ba","v":{"s":"Driver carries 250+ yd; sand wedge 85. Backspin keeps the ball aloft (lift); topspin runs out fast. ~6 sec in the air. Smash factor 1.50 = the ceiling. Find the fairway."}},{"k":"server_s_line_over_a_2_43m_net_in_9_9m","v":{"s":"Server's Line — over a 2.43m net, in 9×9m"}},{"k":"jump_serve_70_mph_float_serve_has_no_s","v":{"s":"Jump-serve > 70 mph. Float serve has NO spin — the wake destabilizes mid-flight, divers and dips unpredictably. Top-spin jump serve = the receiving line’s nightmare."}},{"k":"scenarios","v":{"s":"Scenarios"}},{"k":"delete_this_custom_scenario","v":{"s":"Delete this custom scenario"}},{"k":"run_a_random_scenario_go_straight_to_t","v":{"s":"Run a random scenario — go straight to throwing without reading setup"}},{"k":"pick_a_random_scenario_and_start_immed","v":{"s":"Pick a random scenario and start immediately — no setup, just throw"}},{"k":"run_something_cool","v":{"s":"🎲 Run something cool"}},{"k":"save_current_setup_as_a_custom_scenari","v":{"s":"Save current setup as a custom scenario"}},{"k":"save_the_current_mode_preset_gravity_w","v":{"s":"Save the current mode + preset + gravity + wind as a personalized scenario"}},{"k":"save_current","v":{"s":"⭐ Save current"}},{"k":"print_activity_sheet_for_all_scenarios","v":{"s":"Print activity sheet for all scenarios"}},{"k":"open_a_printable_activity_sheet_with_a","v":{"s":"Open a printable activity sheet with all scenarios + discussion questions"}},{"k":"print_activity_sheet","v":{"s":"📄 Print activity sheet"}},{"k":"export_your_last_throw_as_a_printable_","v":{"s":"Export your last throw as a printable trading card"}},{"k":"make_a_topps_style_trading_card_from_y","v":{"s":"Make a Topps-style trading card from your last throw + stats + badges"}},{"k":"trading_card","v":{"s":"📇 Trading card"}},{"k":"badge_achievements","v":{"s":"Badge achievements"}},{"k":"session_stats","v":{"s":"Session stats"}},{"k":"scenario_briefing","v":{"s":"Scenario briefing"}},{"k":"dismiss_scenario_briefing","v":{"s":"Dismiss scenario briefing"}},{"k":"dismiss","v":{"s":"✕ Dismiss"}},{"k":"discussion","v":{"s":"💭 Discussion"}},{"k":"skill_level","v":{"s":"Skill level"}},{"k":"rookie","v":{"s":"🏆 Rookie"}},{"k":"pro","v":{"s":"🏆 Pro"}},{"k":"all_star","v":{"s":"🏆 All-Star"}},{"k":"hall_of_fame","v":{"s":"🏆 Hall of Fame"}},{"k":"gravity_preset","v":{"s":"Gravity preset"}},{"k":"stop_the_current_drill","v":{"s":"Stop the current drill"}},{"k":"toggle_fullscreen_for_the_throw_lab_ca","v":{"s":"Toggle fullscreen for the throw lab canvas"}},{"k":"fullscreen","v":{"s":"Fullscreen"}},{"k":"speed","v":{"s":"Speed"}},{"k":"show_physics_overlays_no_spin_referenc","v":{"s":"Show physics overlays (no-spin reference trajectory)"}},{"k":"show_formulas_math_behind_the_throw","v":{"s":"Show formulas (math behind the throw)"}},{"k":"space","v":{"s":"Space"}},{"k":"to_throw","v":{"s":" to throw"}},{"k":"coach","v":{"s":"🤖 Coach"}},{"k":"preset","v":{"s":"Preset"}},{"k":"speed_2","v":{"s":"Speed"}},{"k":"spin","v":{"s":"Spin"}},{"k":"axis","v":{"s":"Axis"}},{"k":"launch","v":{"s":"Launch"}},{"k":"release_controls","v":{"s":"Release controls"}},{"k":"wind_relative_to_throw","v":{"s":"Wind (relative to throw)"}},{"k":"wind_presets","v":{"s":"Wind presets"}},{"k":"optimal_trajectory","v":{"s":"🎯 Optimal trajectory"}},{"k":"45_near_no_spin_max_distance","v":{"s":"45° near no-spin → max distance."}},{"k":"long_throw","v":{"s":"🟡 Long throw"}},{"k":"high_range_but_off_axis","v":{"s":"High range but off-axis."}},{"k":"medium_throw","v":{"s":"🟠 Medium throw"}},{"k":"acceptable_range","v":{"s":"Acceptable range."}},{"k":"short_throw","v":{"s":"🔴 Short throw"}},{"k":"sub_optimal_angle_or_low_velocity","v":{"s":"Sub-optimal angle or low velocity."}},{"k":"throw_angle_discovery","v":{"s":"🎯 Throw angle discovery"}},{"k":"sliders_for_angle_velocity_spin_discre","v":{"s":"Sliders for angle, velocity, spin. Discrete 4-state trajectory. No score, no reveal."}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_why_is_45_special_what_abou","v":{"s":"Hypothesis: Why is 45° special? What about with spin?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"real_quarterbacks_throw_at_lower_angle","v":{"s":"Real quarterbacks throw at lower angles. Why?"}},{"k":"how_does_spin_magnus_effect_alter_traj","v":{"s":"How does spin (Magnus effect) alter trajectory?"}},{"k":"i_understand_explain_in_own_words","v":{"s":"I understand — explain in own words"}},{"k":"explain_throw_trajectory_physics","v":{"s":"Explain throw trajectory physics."}},{"k":"design_note_discrete_4_state_trajector","v":{"s":"Design note: discrete 4-state trajectory marker; no distance score; no reveal — by design."}},{"k":"toggle_slow_motion_replay_3_5x_slower","v":{"s":"Toggle slow-motion replay (3.5x slower)"}},{"k":"toggle_slow_motion_replays_at_3_5_slow","v":{"s":"Toggle slow-motion — replays at 3.5× slower so you can see the curl / drop / break"}},{"k":"clear_all_saved_reference_trajectories","v":{"s":"Clear all saved reference trajectories"}},{"k":"clear","v":{"s":"Clear"}},{"k":"coach_voice","v":{"s":"Coach voice"}},{"k":"throw_pitch_action","v":{"s":"THROW PITCH"}},{"k":"strike_action","v":{"s":"STRIKE"}},{"k":"kick_action","v":{"s":"KICK"}},{"k":"bowl_action","v":{"s":"BOWL"}},{"k":"tee_off_action","v":{"s":"TEE OFF"}},{"k":"serve_action","v":{"s":"SERVE"}},{"k":"shoot_action","v":{"s":"SHOOT"}},{"k":"strikes","v":{"s":"Strikes"}},{"k":"goals","v":{"s":"Goals"}},{"k":"made","v":{"s":"Made"}},{"k":"wickets","v":{"s":"Wickets"}},{"k":"greens","v":{"s":"Greens"}},{"k":"aces","v":{"s":"Aces"}},{"k":"makes","v":{"s":"Makes"}},{"k":"calm_air","v":{"s":"Calm air"}},{"k":"r