]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-shelter","data-nk-sec":"shelter","aria-labelledby":"nkheading-shelter","tabindex":"-1","style":"border-color: rgba(163, 230, 53, 0.333) rgba(163, 230, 53, 0.333) rgba(163, 230, 53, 0.333) rgb(163, 230, 53); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(163, 230, 53, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},[[1,1400]],[[1,1407]],[[1,1409]],[[1,1411]],[[1,1417]],[[1,1423]],[[1,1429]],[[1,1431]],[[1,1442]],[[1,1444]],[[1,1446]],["DIV",{"class":"nk-chart-frame rounded-lg overflow-hidden border mb-2","style":"border-color: rgba(163, 230, 53, 0.35); height: 180px;"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":41,\"top\":94430.359375,\"right\":41,\"bottom\":94648.359375}","role":"img","data-a11y-static":"true","aria-describedby":"nk-shelter-summary","aria-label":"Dose against how long it takes to get clear. Sheltering in a brick or concrete house through a 8 hour release gives a flat 3.2 millisieverts. Evacuating gives 7.2 millisieverts after 4 hours in the open. The two are equal at 1.8 hours: get clear faster than that and leaving costs less dose, slower and it costs more.","style":"width: 100%; height: 100%; display: block;","width":"560","height":"218"}]],[[1,1459]],[[1,1466]],[[1,1479]],[[1,1481]],[[1,1497]],[[1,1504]],[[1,1506]]],[[1,1605]],[[1,1661]],[[1,1708]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-operate","data-nk-sec":"operate","aria-labelledby":"nkheading-operate","tabindex":"-1","style":"border-color: rgba(52, 211, 153, 0.333) rgba(52, 211, 153, 0.333) rgba(52, 211, 153, 0.333) rgb(52, 211, 153); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(52, 211