    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/8556.png",
      "text": "Ke tsoa taolong ha moea o mphehla.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=2",
      "sourceDigest": "sha256:0b8a7b38a9092bbd05cd51c1999725b0bce781e1ff2fa5a5f1a28b4390414058"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/8558.png",
      "text": "'Na le uena re metsoalle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=3",
      "sourceDigest": "sha256:93f4ebd79123f182e708750be06315a3314897671b3e4a6409863f8bc58c14fa"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/8557.png",
      "text": "Ke u phehela lijo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=4",
      "sourceDigest": "sha256:43e7e1ffc8114e72cefd4fce6092a999e2fb33e6ee00f0ea6a84ecaad09355ba"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/8559.png",
      "text": "Kea u khants'etsa bosiu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=5",
      "sourceDigest": "sha256:bb7d93a72d14f5817b8e6a60c0b9cdd09378c29a95ae3b3b3efdeb5df0cb52af"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/8560.png",
      "text": "Ke na le maqiti a mangata.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=6",
      "sourceDigest": "sha256:f0043d5d22399729a96353a2e737f8c63929145a490428fdb72b5b16409519b8"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/8561.png",
      "text": "Ke karolo ea lelapa leno.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36344#page=7",
