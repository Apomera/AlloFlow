d or learned. Future you will thank present you."}},{"k":"victory","v":{"s":"· ✅ victory"}},{"k":"fell","v":{"s":"· 💥 fell"}},{"k":"loading_allobot_sage","v":{"s":"Loading AlloBot Sage..."}},{"k":"crystal_nebula_subtitle","v":{"s":"Glittering dust and slow-moving shards"}},{"k":"whispering_archive_subtitle","v":{"s":"A library of forgotten runes, guarded by words"}},{"k":"ember_clockwork_subtitle","v":{"s":"Gears of starlight and tides of molten logic"}},{"k":"deep_tide_subtitle","v":{"s":"Coral spires and a hush of pressure"}},{"k":"aurora_atelier_subtitle","v":{"s":"A drifting studio of color and chord"}},{"k":"easy_desc","v":{"s":"Build confidence — longer crit window, fewer rooms."}},{"k":"standard_desc","v":{"s":"Balanced challenge — 6-second crit window, 3 rooms."}},{"k":"hard_desc","v":{"s":"Sharpen retrieval speed — short window, 4 rooms."}},{"k":"workload_learning_risk_chart","v":{"s":"Workload, learning, and risk chart"}},{"k":"hypothesis_input","v":{"s":"AI workload hypothesis"}},{"k":"explanation_input","v":{"s":"AI workload explanation"}},{"k":"run_reflection","v":{"s":"Run reflection"}}],"id":472}},{"k":"anatomy","v":{"o":[{"k":"a11y_review","v":{"s":"Review {value1}: {value2}"}},{"k":"a11y_chosen_response_local_response_system_outcome","v":{"s":"Chosen response: {value1}. Local response: {value2} System outcome: {value3}"}},{"k":"a11y_trigger_mechanism_outcome","v":{"s":"Trigger: {value1} Mechanism: {value2} Outcome: {value3}"}},{"k":"a11y_connected_pathway","v":{"s":"Connected pathway: {value1}"}},{"k":"a11y_open_suggested_system_focus","v":{"s":"Open suggested {value1} system focus"}},{"k":"a11y_open_connection_details","v":{"s":"Open {value1} connection details"}},{"k":"a11y_open_system_diagram_from","v":{"s":"Open {value1} system diagram from {value2}"}},{"k":"a11y_review_2","v":{"s":"Review {value1}"}},{"k":"a11y_show_only_layer","v":{"s":"Show only {value1} layer"}},{"k":"a11y_open_comparison_target","v":{"s":"Open comparison target {value1}"}},