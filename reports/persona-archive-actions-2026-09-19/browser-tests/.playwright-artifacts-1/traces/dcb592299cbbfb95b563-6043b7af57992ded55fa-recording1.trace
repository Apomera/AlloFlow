":{"s":"Mass stays "}},{"k":"mass_weight_force_suffix","v":{"s":" kg in both places; gravity changes weight force."}},{"k":"mission_control_reply_time","v":{"s":"How long until mission control hears back?"}},{"k":"model_boundary_label","v":{"s":"Model boundary: "}},{"k":"model_shows_sunlight_is","v":{"s":"The model shows sunlight is "}},{"k":"nasa_mass_vs_weight","v":{"s":"NASA mass vs weight ↗"}},{"k":"not_started","v":{"s":"Not started"}},{"k":"object_mass_kg","v":{"s":"Object mass (kg)"}},{"k":"predict_before_recording","v":{"s":"Predict before you record"}},{"k":"predict_geometry_effect","v":{"s":"Predict the geometry effect"}},{"k":"prediction_made","v":{"s":"Prediction made"}},{"k":"revise_using_acceleration","v":{"s":"Revise using acceleration. "}},{"k":"revise_with_geometry","v":{"s":"Revise with the geometry. "}},{"k":"revise_with_readout","v":{"s":"Revise with the readout. "}},{"k":"run_synchronized_vacuum_drop","v":{"s":"Run synchronized vacuum drop"}},{"k":"run_the_gravity_drop_investigation","v":{"s":"Run the gravity-drop investigation"}},{"k":"same_time","v":{"s":"Same time"}},{"k":"save_gravity_evidence","v":{"s":"Save gravity evidence to journal"}},{"k":"save_prediction_evidence","v":{"s":"Save prediction + evidence to journal"}},{"k":"save_signal_evidence","v":{"s":"Save signal evidence to journal"}},{"k":"season_sunlight_prediction","v":{"s":"Season sunlight prediction"}},{"k":"seasons_investigation","v":{"s":"Tilt + Seasons"}},{"k":"seasons_investigation_description","v":{"s":"Test how axial tilt changes sunlight geometry."}},{"k":"seasons_lab_instructions","v":{"s":"Scrub through a year, keep the rotation axis pointed in one direction, and compare the sunlight geometry at 45° north and south."}},{"k":"seasons_model_boundary","v":{"s":"daylight and noon-Sun angle use ideal horizon geometry at ±45° latitude. This is not a temperature or climate forecast; it omits atmosphere, refraction, terrain, weather, oceans, ice, and thermal inertia."}},{"k":"s