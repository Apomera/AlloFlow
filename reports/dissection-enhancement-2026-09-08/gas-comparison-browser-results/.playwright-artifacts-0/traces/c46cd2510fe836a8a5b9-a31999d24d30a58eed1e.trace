eight: 500; }\n.diss-structure-list [data-exposure-state] { opacity: 1 !important; }\n.diss-structure-list .text-green-500 { color: rgb(4, 120, 87); }\n.diss-directory-filters { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 0.35rem; margin: 0.65rem 0px; }\n.diss-directory-filters button { padding: 0.5rem 0.55rem; border: 1px solid rgb(179, 197, 216); border-radius: 0.6rem; background: rgb(255, 255, 255); color: rgb(39, 69, 99); font-size: 0.78rem; font-weight: 700; text-align: left; }\n.diss-directory-filters button[aria-pressed=\"true\"] { border: 2px solid rgb(18, 99, 107); background: rgb(231, 247, 244); color: rgb(18, 75, 81); }\n.diss-directory-filters button span { float: right; margin-left: 0.3rem; font-variant-numeric: tabular-nums; }\n.diss-search-reset { min-height: 2.75rem; margin-top: 0.45rem; padding: 0.4rem 0.7rem; border: 1px solid rgb(66, 104, 138); border-radius: 0.5rem; background: rgb(255, 255, 255); color: rgb(23, 77, 119); font-size: 0.8rem; font-weight: 750; }\n.diss-other-layers { margin-top: 0.75rem; border-top: 1px solid rgb(181, 198, 216); padding-top: 0.65rem; color: rgb(36, 62, 86); }\n.diss-other-layers summary { cursor: pointer; font-size: 0.83rem; font-weight: 800; }\n.diss-other-layers ul { display: grid; gap: 0.45rem; list-style: none; margin: 0.5rem 0px 0px; padding: 0px; }\n.diss-other-layers li { padding: 0.65rem; border: 1px solid rgb(194, 207, 222); border-radius: 0.65rem; background: rgb(245, 248, 252); font-size: 0.8rem; line-height: 1.5; }\n.diss-other-layers li strong { display: block; color: rgb(23, 59, 85); }\n.diss-other-layers li p { margin: 0.2rem 0px; }\n.diss-other-layers li button { width: 100%; margin-top: 0.4rem; padding: 0.5rem; border: 1px solid rgb(89, 127, 159); border-radius: 0.5rem; background: rgb(255, 255, 255); color: rgb(21, 77, 116); font-weight: 750; }\n.diss-mission-shortcuts { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.8rem; }\n.diss-mission-shortcuts button 