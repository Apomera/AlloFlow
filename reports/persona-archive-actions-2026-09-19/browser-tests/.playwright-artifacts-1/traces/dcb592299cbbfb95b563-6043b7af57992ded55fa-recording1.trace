"}},{"k":"partial_credit_label","v":{"s":"Allow partial credit"}},{"k":"partial_credit_desc","v":{"s":"Applies to multi-select, multi-step diagnostics, answer + evidence, and numeric value/unit checks."}},{"k":"live_policy_label","v":{"s":"Live session response policy"}},{"k":"policy_accuracy","v":{"s":"Accuracy — correctness, never speed"}},{"k":"policy_confidence","v":{"s":"Confidence check — accuracy + learner certainty"}},{"k":"policy_confidence_desc","v":{"s":"Learners report how sure they were after answering. Confidence never changes correctness or points."}},{"k":"policy_accuracy_desc","v":{"s":"Uses the answer key and configured partial credit. Response speed never changes points."}},{"k":"written_feedback_label","v":{"s":"Written-response feedback"}},{"k":"written_ai","v":{"s":"Immediate AI feedback (provisional)"}},{"k":"written_teacher","v":{"s":"Submit for teacher review"}},{"k":"written_ai_desc","v":{"s":"Students receive immediate guidance; teachers can override it."}},{"k":"written_teacher_desc","v":{"s":"Written responses are collected without an automatic correctness judgment."}},{"k":"presets_title","v":{"s":"Save or reuse this setup"}},{"k":"presets_select_aria","v":{"s":"Saved assessment presets"}},{"k":"presets_choose","v":{"s":"Choose a saved preset…"}},{"k":"presets_delete","v":{"s":"Delete"}},{"k":"preset_name_aria","v":{"s":"New preset name"}},{"k":"preset_name_placeholder","v":{"s":"e.g. Friday concept check"}},{"k":"preset_save","v":{"s":"Save"}},{"k":"answer_options","v":{"s":"Answer options"}},{"k":"progress_answered","v":{"s":"answered"}},{"k":"question_image","v":{"s":"Question image"}},{"k":"results_share_failed","v":{"s":"Could not share — no students connected."}},{"k":"results_shared","v":{"s":"Anonymous results shared with the class."}},{"k":"share_results_aria","v":{"s":"Share anonymous results with the class"}},{"k":"share_results_btn","v":{"s":"Share anonymous results"}},{"k":"share_results_tooltip","v":{"s":"Send anonymous per-question results to every connected student (peer-to-peer, nothing stored)"}},{"k":"shared_results_kicker","v":{"s":"Anonymous class results"}},{"k":"shared_results_note","v":{"s":"Class totals only — no names, and nothing is stored."}},{"k":"shared_results_title","v":{"s":"How the class did"}},{"k":"present_questions","v":{"s":"Present questions"}},{"k":"student_view_title","v":{"s":"Your assessment"}},{"k":"student_view_help","v":{"s":"Answer the questions below. You can review your responses before submitting."}},{"k":"practice_games","v":{"s":"Practice games"}},{"k":"practice_games_help","v":{"s":"Practice games can reveal answers and explanations. They do not submit this assessment."}},{"k":"presentation_visibility_help","v":{"s":"This is a discussion screen. Selecting an option only marks it for discussion. Reveal an answer or explanation when everyone is ready; anything revealed is visible to people viewing this screen. This does not submit student responses or control their screens."}},{"k":"presentation_guides_visible","v":{"s":"Questions with visible answers or explanations: {count}"}},{"k":"presentation_guides_hidden","v":{"s":"Answer guides and explanations are hidden."}},{"k":"presentation_hide_guides","v":{"s":"Hide all answers and explanations"}},{"k":"presentation_selection_differs","v":{"s":"The selected option differs from the answer guide."}}],"id":112}},{"k":"outline","v":{"o":[{"k":"title","v":{"s":"Visual Organizer"}},{"k":"structure_label","v":{"s":"Organizer Structure"}},{"k":"venn","v":{"s":"Venn Diagram (Interactive)"}},{"k":"t_chart","v":{"s":"T-Chart (Two Columns)"}},{"k":"fishbone","v":{"s":"Fishbone (Cause Categories)"}},{"k":"structured","v":{"s":"Structured Outline"}},{"k":"concept_map","v":{"s":"Key Concept Map"}},{"k":"flow_chart","v":{"s":"Flow Chart / Sequence"}},{"k":"cause_effect","v":{"s":"Cause and Effect"}},{"k":"problem_solution","v":{"s":"Problem & Solution"}},{"k":"instructions_label","v":{"s":"Custom Instructions (Optional)"}},{"k":"placeholder_instructions","v":{"s":"e.g., Focus only on the first 3 steps..."}},{"k":"generate","v":{"s":"Generate Organizer"}},{"k":"view_static","v":{"s":"Static List"}},{"k":"view_interactive","v":{"s":"Interactive Map"}},{"k":"tooltip_static","v":{"s":"Switch to Standard List View"}},{"k":"tooltip_interactive","v":{"s":"Switch to Interactive Mode"}},{"k":"edit_text","v":{"s":"Edit Text"}},{"k":"labels","v":{"o":[{"k":"start","v":{"s":"Start"}},{"k":"end","v":{"s":"End"}},{"k":"cause","v":{"s":"Cause"}},{"k":"effect","v":{"s":"Effect"}},{"k":"causes","v":{"s":"Causes"}},{"k":"effects","v":{"s":"Effects"}},{"k":"problem","v":{"s":"The Challenge"}},{"k":"solutions","v":{"s":"Solutions & Steps"}},{"k":"outcome","v":{"s":"Outcome & Evaluation"}},{"k":"add_result","v":{"s":"+ Add Result Step"}},{"k":"problem_label","v":{"s":"Problem"}},{"k":"generate_outcome","v":{"s":"Generate Outcome"}}],"id":122}},{"k":"cmap_fallback_title","v":{"s":"Concept map unavailable"}},{"k":"cmap_fallback_desc","v":{"s":"Couldn't render the concept map. Showing items as a list."}},{"k":"edit_cause","v":{"s":"Edit cause"}},{"k":"fishbone_fallback_title","v":{"s":"Fishbone unavailable"}},{"k":"fishbone_fallback_desc","v":{"s":"Couldn't render the fishbone diagram. Showing items as a list."}},{"k":"no_items","v":{"s":"No items yet."}},{"k":"tchart_fallback_title","v":{"s":"T-chart unavailable"}},{"k":"tchart_fallback_desc","v":{"s":"Couldn't render the T-chart. Showing items as a list."}},{"k":"tchart_left_default","v":{"s":"Left"}},{"k":"tchart_right_default","v":{"s":"Right"}},{"k":"venn_fallback_title","v":{"s":"Venn diagram unavailable"}},{"k":"venn_fallback_desc","v":{"s":"Couldn't render the Venn diagram. Showing items as a list."}},{"k":"frayer","v":{"s":"Frayer Model (Vocabulary)"}},{"k":"concept_space_3d","v":{"s":"3D Concept Space (strands in depth)"}},{"k":"memory_palace","v":{"s":"Memory Palace (method of loci)"}},{"k":"kwl","v":{"s":"KWL Chart (Know / Want / Learned)"}},{"k":"cer","v":{"s":"Claim, Evidence, Reasoning (CER)"}},{"k":"story_map","v":{"s":"Story Map (Plot Diagram)"}},{"k":"see_think_wonder","v":{"s":"See, Think, Wonder"}},{"k":"frayer_caption","v":{"s":"Frayer Model: vocabulary term in the center, definition + characteristics + examples + non-examples in the four quadrants."}},{"k":"kwl_caption","v":{"s":"KWL Chart: prior knowledge on the left, anticipated questions in the middle, learning captured on the right after the lesson."}},{"k":"kwl_learned_placeholder","v":{"s":"(students fill this in after the lesson)"}},{"k":"see_think_wonder_caption","v":{"s":"See, Think, Wonder (Harvard Project Zero): observation, inference, and open questioning kept distinct."}},{"k":"story_map_caption","v":{"s":"Story Map: tension rises through Rising Action to the Climax, then falls toward Resolution. The arc visualizes the shape of narrative tension."}},{"k":"branches_to","v":{"s":"Branches to:"}},{"k":"step_target","v":{"s":"Step {number}: {title}"}},{"k":"frayer_refine_visual_aria","v":{"s":"Refine the Examples-quadrant visual via image-to-image edit"}},{"k":"frayer_refine_visual_button","v":{"s":"✨ Refine visual"}},{"k":"frayer_remove_visual_aria","v":{"s":"Remove the Examples-quadrant visual"}},{"k":"frayer_remove_visual_button","v":{"s":"Remove visual"}},{"k":"frayer_add_visual_aria","v":{"s":"Generate an AI visual for the Examples quadrant"}},{"k":"frayer_add_visual_button","v":{"s":"🖼️ Add visual to Examples"}},{"k":"plot_diagram_arc_aria","v":{"s":"Plot diagram arc showing narrative tension rising to the climax and falling toward resolution"}},{"k":"all_nodes_collapsed","v":{"s":"All flow nodes collapsed"}},{"k":"all_nodes_expanded","v":{"s":"All flow nodes expanded"}},{"k":"cer_caption","v":{"s":"Evidence becomes persuasive when reasoning clearly connects it to the claim."}},{"k":"cer_claim","v":{"s":"Claim"}},{"k":"cer_claim_caption","v":{"s":"The answer or position"}},{"k":"cer_evidence","v":{"s":"Evidence"}},{"k":"cer_