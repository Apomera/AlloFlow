</select>
</div>
<div class="dinolab-evidence-statement" style="padding:12px 0;border-top:1px solid var(--allo-stem-border, #334155)">
<label for="dino-bench-sort-feathers" style="display:block;font-weight:700;font-size:14px;line-height:1.6;margin-bottom:7px">3. Velociraptor had large feathers on its forearms.</label>
<select id="dino-bench-sort-feathers" style="padding:9px 12px;min-height:44px;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:700;cursor:pointer;width:100%;box-sizing:border-box">
