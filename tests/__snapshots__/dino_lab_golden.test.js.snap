<span data-dino-part-label="neck" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Neck</span>
<span data-dino-part-label="forelimb" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Upper arm</span>
<span data-dino-part-label="knee" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Knee</span>
<span data-dino-part-label="ankle" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Ankle</span>
<span data-dino-part-label="thigh" style="display:none;position:absolute;left:0;top:0;width:max-content;min-width:96px;max-width:176px;min-height:28px;padding:4px 8px;box-sizing:border-box;border:1px solid #5eead4;border-radius:7px;background:#0f172a;color:#f0fdfa;text-align:center;font-size:12px;font-weight:800;line-height:18px;white-space:normal;overflow-wrap:anywhere">Thigh</span>
</div>
<div class="dinolab-3d-readouts" style="position:absolute;left:10px;top:10px;right:10px;display:flex;gap:6px;flex-wrap:wrap;pointer-events:none">
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(56,189,248,0.62);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Length 12.3 m | Height 3.7 m | Mass 8.4 t</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(94,234,212,0.68);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Surface · Evidence-led</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(20,184,166,0.65);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Scene Neutral studio</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(245,158,11,0.62);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Pose Balanced biped</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(148,163,184,0.55);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Colour illustrated</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(34,197,94,0.70);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Fossils abundant</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(251,146,60,0.62);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Body Powerful pelvis</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(167,139,250,0.62);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Head Deep power skull</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(245,158,11,0.65);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Focus Skull</span>
<span class="dinolab-3d-chip" style="padding:5px 8px;border-radius:999px;background:rgba(15,23,42,0.82);border:1px solid rgba(34,197,94,0.65);color:#e2e8f0;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.22)">Scan 0/3 | Logged 0/3 | Path 0/2</span>
</div>
<div class="dinolab-3d-orientation-cue" role="note" aria-label="3D viewer orientation tips" style="position:absolute;left:14px;top:52px;max-width:min(330px, calc(100% - 28px));padding:10px;border-radius:10px;border:1px solid rgba(20,184,166,0.48);background:rgba(15,23,42,0.94);color:#e2e8f0;box-shadow:0 10px 28px rgba(0,0,0,0.28);z-index:4">
<div style="font-size:12.5px;font-weight:900;margin-bottom:3px">New to the field station?</div>
<div style="font-size:11.5px;color:#cbd5e1;line-height:1.45;max-width:280px">Drag to orbit. Use the wheel or Page Up/Page Down to zoom. Start with the amber Skull target.</div>
<button type="button" aria-label="Dismiss 3D viewer orientation tips" style="margin-top:8px;padding:6px 9px;border-radius:7px;border:1px solid #5eead4;background:rgba(20,184,166,0.16);color:#e2e8f0;cursor:pointer;font-size:11.5px;font-weight:800">Got it</button>
</div>
<button type="button" class="dinolab-fit-model" style="position:absolute;left:12px;bottom:52px;margin-top:0;padding:8px 12px;border-radius:9px;border:1px solid #94a3b8;background:#0f172a;color:#f8fafc;font-size:12px;font-weight:800;cursor:pointer">Fit whole animal</button>
<div class="dinolab-3d-camera-readout" aria-label="Current 3D camera view" style="position:absolute;right:10px;bottom:56px;margin:0;padding:5px 8px;border-radius:8px;background:rgba(15,23,42,0.78);color:#e2e8f0;font-size:11px;font-weight:800;pointer-events:none">Camera view loading...</div>
<div id="dino3d-status-tyrannosaurus" class="dinolab-3d-status" role="status" aria-live="polite" aria-atomic="true" style="position:absolute;left:10px;bottom:10px;right:10px;margin:0;padding:7px 10px;border-radius:9px;background:rgba(15,23,42,0.78);color:#cbd5e1;font-size:11px;pointer-events:none">Loading 3D reconstruction...</div>
</div>
<div class="dinolab-study-controls" role="group" aria-label="Study details" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:10px;max-width:560px">
<span style="color:var(--allo-stem-text-soft, #94a3b8);font-size:12px;font-weight:800;grid-column:1 / -1">Study details</span>
<button type="button" aria-label="Study whole animal" aria-pressed="true" style="padding:8px 12px;border-radius:8px;border:1px solid #0f766e;background:#0f766e;color:#ffffff;cursor:pointer;font-size:12px;font-weight:800">Whole animal</button>
<button type="button" aria-label="Study head details" aria-pressed="false" style="padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:12px;font-weight:800">Head</button>
<button type="button" aria-label="Study body details" aria-pressed="false" style="padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:12px;font-weight:800">Body</button>
<button type="button" aria-label="Study tail details" aria-pressed="false" style="padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:12px;font-weight:800">Tail</button>
</div>
<section class="dinolab-anatomy-quest" aria-label="Anatomy Quest" style="margin-top:10px;max-width:620px;border:1px solid var(--allo-stem-border, #334155);border-radius:10px;background:var(--allo-stem-deeper, #0b1220);overflow:hidden">
<button type="button" aria-label="Anatomy Quest" aria-expanded="false" style="min-height:44px;padding:9px 12px;border-radius:0;border:0;background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:13px;font-weight:800;cursor:pointer;display:block;width:100%;text-align:left">Anatomy Quest · 5 clues</button>
</section>
<div class="dinolab-body-label-controls" style="margin-top:10px">
<button type="button" aria-pressed="false" style="min-height:44px;padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:800;cursor:pointer">Body-part labels</button>
</div>
<div class="dinolab-size-controls" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:10px">
<button type="button" aria-label="Study size reference" aria-pressed="false" style="padding:9px 12px;min-height:44px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:800;cursor:pointer">Size reference</button>
<span style="flex:1 1 240px;font-size:11.5px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.5">Estimated length 12.3 m (cyan) · height 3.7 m (gold). Reference bars show catalog estimates; the modeled pose can differ.</span>
</div>
<div class="dinolab-motion-controls" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:10px">
<button type="button" aria-pressed="false" style="padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:800;cursor:pointer">Pause motion</button>
<span role="status" aria-live="polite" style="flex:1 1 220px;font-size:11.5px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.4">Pause breathing, the head turn, the leg gait, feather movement, and auto spin.</span>
</div>
<div class="dinolab-3d-evidence-route" role="list" aria-label="Evidence route" style="display:grid;grid-template-columns:100px repeat(3,minmax(0,1fr)) minmax(140px,1.2fr);gap:7px;align-items:center;margin-top:8px;padding:8px;border-radius:10px;background:rgba(15,23,42,0.82);border:1px solid rgba(245,158,11,0.48);box-shadow:0 10px 24px rgba(0,0,0,0.24);z-index:3">
<div style="display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:6px;color:#f8fafc;font-size:11px;font-weight:900;letter-spacing:0.03em;text-transform:uppercase">
<span>Evidence route</span>
<span style="color:#fbbf24;font-size:10px">0/3</span>
</div>
<div role="listitem" style="margin-top:0">
<button type="button" aria-current="step" aria-pressed="true" aria-label="Focus Skull evidence anchor, current focus" style="width:100%;display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:6px;padding:5px 6px;border-radius:7px;border:1px solid rgba(245,158,11,0.68);background:rgba(245,158,11,0.16);color:#f8fafc;cursor:pointer;text-align:left;font-size:11.5px;font-weight:850">
<span aria-hidden="true" style="width:18px;height:18px;display:grid;place-items:center;border-radius:999px;background:#b45309;color:#fff;font-size:10px;font-weight:900">1</span>
<span>Skull</span>
<span style="color:#fbbf24;font-size:9.5px;font-weight:900;text-transform:uppercase">Current</span>
</button>
</div>
<div role="listitem" style="margin-top:4px">
<button type="button" aria-pressed="false" aria-label="Focus Shoulder evidence anchor, next focus" style="width:100%;display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:6px;padding:5px 6px;border-radius:7px;border:1px solid rgba(148,163,184,0.24);background:rgba(15,23,42,0.44);color:#f8fafc;cursor:pointer;text-align:left;font-size:11.5px;font-weight:850">
<span aria-hidden="true" style="width:18px;height:18px;display:grid;place-items:center;border-radius:999px;background:rgba(148,163,184,0.22);color:#fff;font-size:10px;font-weight:900">2</span>
<span>Shoulder</span>
<span style="color:#cbd5e1;font-size:9.5px;font-weight:900;text-transform:uppercase">Next</span>
</button>
</div>
<div role="listitem" style="margin-top:4px">
<button type="button" aria-pressed="false" aria-label="Focus Hip evidence anchor, next focus" style="width:100%;display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:6px;padding:5px 6px;border-radius:7px;border:1px solid rgba(148,163,184,0.24);background:rgba(15,23,42,0.44);color:#f8fafc;cursor:pointer;text-align:left;font-size:11.5px;font-weight:850">
<span aria-hidden="true" style="width:18px;height:18px;display:grid;place-items:center;border-radius:999px;background:rgba(148,163,184,0.22);color:#fff;font-size:10px;font-weight:900">3</span>
<span>Hip</span>
<span style="color:#cbd5e1;font-size:9.5px;font-weight:900;text-transform:uppercase">Next</span>
</button>
</div>
<div style="margin-top:7px;color:#cbd5e1;font-size:10.5px;line-height:1.35">Start the field scan to log observations.</div>
</div>
<details class="dinolab-3d-controls-disclosure" style="margin-top:8px">
<summary style="cursor:pointer;color:var(--allo-stem-text, #f1f5f9);font-size:12.5px;font-weight:900;padding:6px 0">View controls &amp; layers<span class="dinolab-camera-state" role="status" aria-live="polite" aria-atomic="true" style="display:inline-flex;align-items:center;margin-left:8px;padding:2px 7px;border-radius:999px;border:1px solid var(--allo-stem-border, #334155);background:transparent;color:var(--allo-stem-text-soft, #94a3b8);font-size:11.5px;font-weight:800">Free orbit | drag + wheel</span>
</summary>
<div class="dinolab-studio-light-controls" role="group" aria-label="Studio light angle" style="margin-top:10px;margin-bottom:10px">
<div style="font-size:12px;font-weight:800;color:var(--allo-stem-text-soft, #94a3b8);margin-bottom:6px">Studio light angle</div>
<div style="display:flex;flex-wrap:wrap;gap:6px">
<button type="button" aria-label="Balanced studio lighting" aria-pressed="true" style="min-height:44px;padding:8px 12px;border-radius:8px;border:1px solid #0f766e;background:#0f766e;color:#ffffff;cursor:pointer;font-size:12px;font-weight:800">Balanced</button>
<button type="button" aria-label="Surface detail studio lighting" aria-pressed="false" style="min-height:44px;padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:12px;font-weight:800">Surface detail</button>
<button type="button" aria-label="Rim light studio lighting" aria-pressed="false" style="min-height:44px;padding:8px 12px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:12px;font-weight:800">Rim light</button>
</div>
<div class="dinolab-lighting-description" style="color:var(--allo-stem-text-soft, #94a3b8);font-size:11.5px;line-height:1.5;margin-top:6px">Even studio lighting gives an overall view of the reconstruction.</div>
</div>
<div class="dinolab-3d-view-controls" role="group" aria-label="3D camera viewpoints and body inference opacity" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:4px">
<button type="button" aria-label="Front camera view" aria-pressed="false" style="padding:7px 10px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:11.5px;font-weight:800">Front</button>
<button type="button" aria-label="Side camera view" aria-pressed="false" style="padding:7px 10px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:11.5px;font-weight:800">Side</button>
<button type="button" aria-label="Overhead camera view" aria-pressed="false" style="padding:7px 10px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:11.5px;font-weight:800">Overhead</button>
<button type="button" aria-label="Reset view camera view" aria-pressed="false" style="padding:7px 10px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;font-size:11.5px;font-weight:800">Reset view</button>
<label style="display:flex;align-items:center;gap:7px;flex:1 1 220px;min-width:190px;padding-left:4px;color:var(--allo-stem-text-soft, #94a3b8);font-size:11.5px;font-weight:800">
<span style="white-space:nowrap">Body inference 28%</span>
<input type="range" min="10" max="100" step="1" aria-label="Body inference opacity" aria-valuetext="28 percent" style="flex:1;min-width:90px;accent-color:#14b8a6" value="28"/>
</label>
</div>
</details>
</div>
<div class="dinolab-field-context-strip" data-dinolab-evidence-strip="true" role="group" aria-label="Reconstruction evidence context" style="margin-top:10px;padding:10px;border-radius:11px;border:1px solid rgba(94,234,212,0.28);background:linear-gradient(135deg, rgba(15,23,42,0.88), rgba(20,184,166,0.08));box-shadow:0 8px 24px rgba(2,6,23,0.18)">
<div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px">
<div style="color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:900;letter-spacing:0.04em;text-transform:uppercase">Evidence context</div>
<div style="color:var(--allo-stem-text-soft, #94a3b8);font-size:11.5px;line-height:1.35">Keep observations separate from inference as you explore</div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));gap:7px">
<div style="min-width:0;padding:8px 9px;border-radius:9px;border:1px solid rgba(20,184,166,0.34);background:rgba(20,184,166,0.10)">
<div style="color:#5eead4;font-size:10.5px;font-weight:900;letter-spacing:0.03em;text-transform:uppercase;margin-bottom:3px">Evidence trail</div>
<div style="color:var(--allo-stem-text, #f1f5f9);font-size:12.5px;font-weight:900;line-height:1.3">0/3 anchors</div>
<div style="color:var(--allo-stem-text-soft, #94a3b8);font-size:11px;line-height:1.35;margin-top:2px">0/2 links connected</div>
</div>
<div style="min-width:0;padding:8px 9px;border-radius:9px;border:1px solid rgba(167,139,250,0.34);background:rgba(167,139,250,0.10)">
