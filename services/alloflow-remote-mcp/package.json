{
  "name": "@alloflow/remediation-remote-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Stateless Streamable HTTP MCP gateway for AlloFlow document remediation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "preflight:staging": "node scripts/pilot-preflight.cjs --config wrangler.pilot.local.jsonc",
    "preflight:staging:accepted": "node scripts/pilot-preflight.cjs --config wrangler.pilot.local.jsonc --allow-synthetic-acceptance",
    "provision:staging:plan": "node scripts/pilot-provision.cjs --config wrangler.pilot.local.jsonc",
    "provision:staging:apply": "node scripts/pilot-provision.cjs --config wrangler.pilot.local.jsonc --apply",
    "lifecycle:check": "node scripts/pilot-lifecycle.cjs",
    "lifecycle:apply:staging": "node scripts/pilot-lifecycle.cjs --config wrangler.pilot.local.jsonc --apply",
    "admission:pause:staging": "node scripts/pilot-admission.cjs pause --config wrangler.pilot.local.jsonc --reason staging-release",
    "admission:drain:staging": "node scripts/pilot-admission.cjs drain --config wrangler.pilot.local.jsonc --timeout-seconds 2100",
    "admission:resume:staging": "node scripts/pilot-admission.cjs resume --force --config wrangler.pilot.local.jsonc --reason operator-approved-recovery",
    "alerts:check": "node scripts/pilot-alerts.cjs",
    "canary:staging": "node scripts/pilot-release-canary.cjs --config wrangler.pilot.local.jsonc",
    "runner:canary": "node --test runner/test/server.test.cjs",
    "deploy:staging": "node scripts/pilot-deploy.cjs --config wrangler.pilot.local.jsonc",
    "deploy:staging:accepted": "node scripts/pilot-deploy.cjs --config wrangler.pilot.local.jsonc --allow-synthetic-acceptance",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --config wrangler.jsonc && wrangler types pilot-configuration.d.ts --config wrangler.pilot.example.jsonc --env-interface PilotDeploymentEnv --include-runtime false --strict-vars false",
    "types:check": "wrangler types --config wrangler.jsonc --check && wrangler types pilot-configuration.d.ts --config wrangler.pilot.example.jsonc --env-interface PilotDeploymentEnv --include-runtime false --strict-vars false --check",
    "preflight:test": "node --test scripts/test/*.test.cjs",
    "check": "npm run runner:stage:check && npm run lifecycle:check && npm run types:check && npm run typecheck && npm test && npm run preflight:test && wrangler deploy --dry-run --outdir .wrangler-build",
    "startup:check": "wrangler check startup --config wrangler.jsonc --outfile .wrangler-build/worker-startup.cpuprofile",
    "runner:stage": "node scripts/stage-runner.cjs",
    "runner:stage:check": "node scripts/stage-runner.cjs --check",
    "runner:test": "npm --prefix runner test",
    "runner:check": "npm run runner:stage:check && npm run runner:test"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-oauth-provider": "0.8.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "jose": "6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
