# AlloFlow "School Box" — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Firebase configuration is OPTIONAL — only needed for:
#   - Live teacher-student sessions (real-time sync)
#   - Cloud backup
#   - Student authentication
#
# Without Firebase, AlloFlow works fully offline with PocketBase + Ollama.

# ─── Service Ports ──────────────────────────────────────────────────
# Default: reachable only on this computer. For a trusted classroom LAN, set
# the box's LAN IPv4 address (see README.md); 0.0.0.0 shares every IPv4 interface.
ALLOFLOW_BIND_ADDRESS=127.0.0.1
# Optional override to keep backend databases/models/search on loopback even if frontend uses 0.0.0.0:
# ALLOFLOW_BACKEND_BIND_ADDRESS=127.0.0.1
# SearXNG session/CSRF secret (32 random hex bytes: openssl rand -hex 32):
# SEARXNG_SECRET=
# Optional bearer token for AlloFlow NPU inference server (docker/npu_server.py):
# ALLOFLOW_NPU_API_TOKEN=
# Exact browser origins for LAN speech, comma-separated, without trailing /.
# Example: http://192.168.1.50:3000
ALLOFLOW_TTS_ALLOWED_ORIGINS=
WEB_PORT=3000
PB_PORT=8090
OLLAMA_PORT=11434
FLUX_PORT=7860
# Local images: SANA-Sprint by default; set flux to retain the previous backend.
IMAGE_BACKEND=sana-sprint
# Empty selects the backend default (SANA-Sprint 1.6B or FLUX.1-schnell).
# Optional smaller model: Efficient-Large-Model/Sana_Sprint_0.6B_1024px_diffusers
IMAGE_MODEL=
# Built-in models use reviewed commit pins. Custom models require a full commit ID.
IMAGE_MODEL_REVISION=
# Install/verify model files explicitly before Start; ordinary startup stays offline.
ALLOFLOW_IMAGE_OFFLINE=1
# Generation is disabled until a private token of at least 32 bytes is set.
# Do not reuse a cloud-provider key or put this in any REACT_APP_* variable.
ALLOFLOW_FLUX_API_TOKEN=
# Exact browser origins, comma-separated; no wildcard or trailing slash.
# Include http://localhost:7860 to use the standalone image studio in a browser.
# For example: http://localhost:3000,https://alloflow-cdn.pages.dev
ALLOFLOW_FLUX_ALLOWED_ORIGINS=
TTS_PORT=5001
PIPER_PORT=10200
SEARCH_PORT=8888

# ─── Data Backend ────────────────────────────────────────────────
# 'auto'       = try PocketBase → Firebase → localStorage (recommended)
# 'pocketbase' = force PocketBase (requires running PocketBase service)
# 'firebase'   = force Firebase (requires Firebase config below)
# 'local'      = localStorage only (fully offline, no server needed)
REACT_APP_DATA_BACKEND=auto
REACT_APP_POCKETBASE_URL=http://localhost:8090

# ─── Firebase (Optional) ────────────────────────────────────────────
REACT_APP_API_KEY=
REACT_APP_AUTH_DOMAIN=
REACT_APP_PROJECT_ID=
REACT_APP_STORAGE_BUCKET=
REACT_APP_MESSAGING_SENDER_ID=
REACT_APP_APP_ID=
REACT_APP_MEASUREMENT_ID=

# ─── AI Keys (Optional — not needed if using Ollama locally) ────────
REACT_APP_GEMINI_API_KEY=
