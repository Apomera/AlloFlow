"}},{"k":"sr_center_the_selected_earth_target_inside_the_viole","v":{"s":"Center the selected Earth target inside the violet Cupola bracket before starting the frame lock."}},{"k":"sr_catch_and_hold_the_nearby_rail_then_stop_rotation","v":{"s":"Catch and hold the nearby rail, then stop rotation before taking the handheld Earth image."}},{"k":"sr_camera_frame_lock_started_stay_braced_and_hold_p","v":{"s":"Camera frame lock started. Stay braced and hold P for one point two seconds."}},{"k":"sr_earth_frame_lock_interrupted_by_lost_bracing_reac","v":{"s":"Earth frame lock interrupted by lost bracing, reach, or alignment. Release P and set up the camera again."}},{"k":"sr_stable_earth_image_captured_release_p_then_press","v":{"s":"Stable Earth image captured. Release P, then press it again to close all seven Cupola shutters."}},{"k":"sr_the_bulky_transfer_bag_is_already_docked_in_desti","v":{"s":"The bulky transfer bag is already docked in Destiny."}},{"k":"sr_the_transfer_tether_is_clipped_keep_both_your_bod","v":{"s":"The transfer tether is clipped. Keep both your body and the lagging bag centered through the hatch."}},{"k":"sr_secure_the_item_or_finish_the_current_tool_activi","v":{"s":"Secure the item or finish the current tool activity before clipping the bulky transfer tether."}},{"k":"sr_return_to_the_harmony_side_of_the_forward_hatch_t","v":{"s":"Return to the Harmony side of the forward hatch to begin the bulky transfer."}},{"k":"sr_move_within_zero_point_seven_eight_meters_of_the","v":{"s":"Move within zero point seven eight meters of the staged transfer bag before pressing B."}},{"k":"sr_tether_clipped_the_twelve_kilogram_bag_follows_wi","v":{"s":"Tether clipped. The twelve kilogram bag follows with spring and damping lag. Center your body, then allow clearance for the bag before crossing into Destiny."}},{"k":"sr_bulky_hatch_transfer_complete_both_your_body_and","v":{"s":"Bulky hatch transfer complete. Both your body and the lagging bag made their own centered crossings before the bag docked in Destiny."}},{"k":"sr_torque_tool_released_before_the_filter_fastener_w","v":{"s":"Torque tool released before the filter fastener was secure. Hold it for one point five seconds while braced."}},{"k":"sr_finish_the_bulky_hatch_transfer_before_using_the","v":{"s":"Finish the bulky hatch transfer before using the torque tool."}},{"k":"sr_the_tranquility_inlet_filter_is_already_serviced","v":{"s":"The Tranquility inlet filter is already serviced."}},{"k":"sr_the_filter_maintenance_worksite_is_in_tranquility","v":{"s":"The filter maintenance worksite is in Tranquility."}},{"k":"sr_face_the_filter_worksite_more_directly_before_usi","v":{"s":"Face the filter worksite more directly before using the torque tool."}},{"k":"sr_the_unbraced_tool_turned_your_body_instead_of_the","v":{"s":"The unbraced tool turned your body instead of the fastener. Catch a rail, stop the roll, release T, and try again."}},{"k":"sr_torque_tool_engaged_while_braced_hold_t_steadily","v":{"s":"Torque tool engaged while braced. Hold T steadily for one point five seconds."}},{"k":"sr_stable_maintenance_interrupted_release_t_catch_th","v":{"s":"Stable maintenance interrupted. Release T, catch the rail, realign with the filter, and try again."}},{"k":"sr_filter_serviced_while_braced_reaction_torque_main","v":{"s":"Filter serviced while braced. Reaction-torque maintenance challenge complete."}},{"k":"sr_finish_the_bulky_hatch_transfer_before_handling_t_2","v":{"s":"Finish the bulky hatch transfer before handling the Unity cargo pouch."}},{"k":"sr_the_cargo_pouch_is_already_secured_at_the_unity_r","v":{"s":"The cargo pouch is already secured at the Unity restraint point."}},{"k":"sr_secure_the_carried_harmony_cabin_item_before_hand","v":{"s":"Secure the carried Harmony cabin item before handling the Unity cargo pouch."}},{"k":"sr_carry_the_pouch_back_to_the_marked_restraint_poin","v":{"s":"Carry the pouch back to the marked restraint point in Unity."}},{"k":"sr_brace_on_