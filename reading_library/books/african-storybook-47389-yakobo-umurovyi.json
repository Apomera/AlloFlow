    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/8126.png",
      "text": "Uyu ni Yakobo umurovyi aba mu Nyarumanga Kabezi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=1",
      "sourceDigest": "sha256:fcdea090e505fefbb8d6126f349e6d60a3059a825d6f0fda5674705afbcd4714"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/8127.png",
      "text": "Araroba amafi mu kiyaga Tanganyika.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=2",
      "sourceDigest": "sha256:169128ad5fed0f78a66b3e7ab38435d5e3825708d87853950cc07b29cec4fe4f"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/8128.png",
      "text": "Arafise ubwato, urusenga hamwe n'igera.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=3",
      "sourceDigest": "sha256:4d864673c0be98b3bab238606ff4448a4d30b4e24ae03962d854b377b7f1dfc2"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/8129.png",
      "text": "Arazinduka iminsi yose hakiri kare mu gatondo gufata ifi muri Tanganyika.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=4",
      "sourceDigest": "sha256:b88532b76142eced021a8fd01863646188c4b9213f7acd21d0d0fa9b5338277e"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/8130.png",
      "text": "Imbere y'umutaga mu masaha ya sayine, aba ariko aragurisha amafi yarovye kw'isoko rya Bujumbura.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=5",
      "sourceDigest": "sha256:ae8c86bd91796b975d8a4c9c2764b4d9147da101f849ecfb77a6340cac03815e"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/8131.png",
      "text": "Yakobo habaye iki? Hari icatakaye? Yari ashavuye cane.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=6",
      "sourceDigest": "sha256:599198d6c5a408b0a099d7047062dd18aedba5e0fdfee23fa6f0668b22f49b5a"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/8132.png",
      "text": "\"Uno munsi ikirerere cari kibi. Umuyaga wambujije kuroba. Kandi urusenga rumwe hamwe n'igera vyatwawe n'amazi.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=7",
      "sourceDigest": "sha256:9ccdf4d5699c55409b51fa05b26e3b96ee28420b0a5453dd6ce2b58923aee328"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/8133.png",
      "text": "\"Ariko ndizeyeko ejo bizogenda neza kubera namaze kugura igera rindi rishasha.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47389#page=8",
      "sourceDigest": "sha256:b78c781c234c761ea508aa59ca669f300dc7203a16c57abb00e60acb2efc1a08"
    }
  ],
