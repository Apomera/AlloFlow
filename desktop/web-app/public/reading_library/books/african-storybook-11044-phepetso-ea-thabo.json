    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/11032.png",
      "text": "Thabo le Neo baea sekolong. Thabo a bona hore Neo o tsamaea butle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11044#page=1",
      "sourceDigest": "sha256:23c8d55e30d17680ca560bf335dd01a47febb5c0965ec377eb92754f7668d00c"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/11033.png",
      "text": "Hang-hang aloha leqheka laho mots'osa. Eaba Thabo a re, \"Reseiloe ke nako. Ah! Jooeee! Bona noha keeoo!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11044#page=2",
      "sourceDigest": "sha256:06f2600728fed217c84479e29d3ca6c8fe20535d1ed73301df50ed17a71f0afa"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/11034.png",
      "text": "\"Etsa kapele, etsa kapele! Re balehe noha ena. Matha kapele Neo!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11044#page=3",
      "sourceDigest": "sha256:7e3cad63d36d874f6eff1469a2556ba449108131bde3b0c5fff80bd9a758b65d"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/11035.png",
      "text": "Eaba Thabo o ts'oara Neo ka letsoho o ea mohula. Ba matha, ba matha!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11044#page=4",
      "sourceDigest": "sha256:f32c2dd787bd2e3da4da45362af75e512f32f6198b90cbde05fa90d99345169d"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/11037.png",
      "text": "Haba fihla sekolong Thabo a re, \"Ke ne ke o ts'osa fela Neo. Ene ese noha, ene ele thupa fela. Ha, ha, ha!\" Eaba Neo o ea ts'eha le bana ba bang, bathabile haholo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11044#page=5",
      "sourceDigest": "sha256:5bb5ba8031918a439dbfca8aad0c37f93fb71e79437cbba796a8924ac9d90318"
    }
  ],
