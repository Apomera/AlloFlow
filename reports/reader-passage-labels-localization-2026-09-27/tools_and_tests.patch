+++ b/tests/reader_passage_label_locales.test.js
@@ -0,0 +1,69 @@
+import { readFileSync } from 'node:fs';
+import { afterEach, beforeAll, describe, expect, it } from 'vitest';
+import { act, fixtures, payload, copy, translator, setupDraftReader, cleanupDraftReader, mountDraft, click, type } from './helpers/reader_passage_label_harness.js';
+beforeAll(setupDraftReader); afterEach(cleanupDraftReader);
+const usable = text => { expect(text.trim()).not.toBe(''); expect(text).not.toMatch(/simplified\.gloss_|\{(?:passage|item)\}/); };
+const wordInput = h => h.host.querySelector('[data-gloss-draft] input[type=text]');
+const pinBox = h => h.host.querySelector('li input[type=checkbox]');
+const matchMessage = h => [...h.host.querySelectorAll('[data-gloss-draft] [role=status]')].find(n => n.textContent.trim());
+describe.each(fixtures)('$id', f => {
+  it.each([false, true])('uses complete passage-kind sentences without English noun fragments (adapted=%s)', async adapted => {
+    const h = mountDraft(f, { adapted }), before = JSON.stringify(h.current()); await h.requestAdd();
+    const suffix = adapted ? 'adapted' : 'original', label = wordInput(h).closest('label');
+    expect(label.textContent).toBe(copy(f, 'gloss_word_from_' + suffix)); usable(label.textContent);
+    type(wordInput(h), 'no-match-12345');
+    expect(matchMessage(h)?.textContent).toBe(copy(f, 'gloss_no_exact_match_' + suffix)); usable(matchMessage(h).textContent);
+    expect(h.saveButton().disabled).toBe(true); expect(h.onUpdate).not.toHaveBeenCalled(); expect(JSON.stringify(h.current())).toBe(before);
+  });
+  it('localizes the visible and accessible pin label, then announces both confirmed states', async () => {
+    const h = mountDraft(f, { adapted: false }), checkbox = pinBox(h), before = JSON.stringify(h.current());
+    const start = f.passage.indexOf(f.word), context = f.word + ', text position ' + (start + 1) + '–' + (start + f.word.length) + ': ' + f.passage;
+    expect(checkbox.closest('label').textContent).toBe(copy(f, 'gloss_always_show_in_lighter_view'));
+    expect(checkbox.getAttribute('aria-label')).toBe(copy(f, 'gloss_pin_for').replace('{item}', () => context)); usable(checkbox.getAttribute('aria-label'));
+    expect(checkbox.checked).toBe(false); await click(checkbox);
+    expect(pinBox(h).checked).toBe(true); expect(h.host.querySelector('[data-gloss-notice]').textContent).toBe(copy(f, 'gloss_pinned_notice'));
+    expect(h.saved().annotations[0]).toMatchObject({ pinned: true, quote: f.word, start });
+    await click(pinBox(h)); expect(pinBox(h).checked).toBe(false);
