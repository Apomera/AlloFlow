  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/14612.png",
      "text": "Izuba ryafashe rija kuramutsa mwenewabo Ukwezi yaba inyuma y'ijuru y'ibicu. Izuba ribwira ibicu riti, \"Nzogaruka vuba.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=1",
      "sourceDigest": "sha256:2df9d896bf8175350d485c20c5cdf4aef128256e59c4ae559dcb9ef20c67878f"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/14598.png",
      "text": "Izuba rigiye, imitumba ica yifuka iburengeti bwera.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=2",
      "sourceDigest": "sha256:720966770810e09fce1bc97e5e755e72f38de7905c597b5ec6510b568e1bb527"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/14600.png",
      "text": "Habaye impari hagati y'umuyaga n' ibiti. Ibiti birashavura. Ibiti bishwiragiza amababi yavyo mu mpande zose.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=3",
      "sourceDigest": "sha256:69045ef972c12788d8518971205623afa2a496b404d90e66544c4cbdb0a133ae"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/14602.png",
      "text": "Ijuru ritangura kwidoga. Ukwezi guca guhindura ibara.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=4",
      "sourceDigest": "sha256:3f22c9ab010184dbb0d7426c678217a6bbb473898a6cea9aa262e1dc91a2c30e"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/14604.png",
      "text": "Ibicu vyararababajwe nibibaye, bitangura kurira. Hari amarira menshi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=5",
      "sourceDigest": "sha256:1d5cf54d73e1bc9b2acd5e983f836708b1068b0b866c595ca0bdd6b5b36dcc86"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/14605.png",
      "text": "Isi yose inyikira munsi mazi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=6",
      "sourceDigest": "sha256:91e457567ca42383aa800c1f139b5ddd398ade19125e0ac2351e6ecaf7561223"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/14606.png",
      "text": "Murako kanya, kurundi ruhande rw'ijuru, Izuba rigire ritahe. Risezera mwenwabo Ukwezi rica rirataha muhira.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=7",
      "sourceDigest": "sha256:09bc7654356c1ea876b9d328e13d0bd8c51d5dcb091cdd87b3e2a877174ea421"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/14607.png",
      "text": "Ijuru rihimbagwa nukubona Izuba ritanze umuco wubururu. Imituma ica yambara impuzi nziza zisa n'icatsi kibisi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=8",
      "sourceDigest": "sha256:9c22e3d711fcbcdd0593e9abd1213f185aa8935049273cef38bb2d851bb9fb2f"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/14608.png",
      "text": "Umuyaga wigira kuryama. Ibiti birashamika kandi bimwenyura.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=9",
      "sourceDigest": "sha256:0db520dccfc8bf7b96cad5880dee1619f0d114e50c4580dcbdc864ec461df419"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/14609.png",
      "text": "Ibicu vyarahimbawe cane kubona Izuba rigarutse. Ibicu varagiye gukina.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=10",
      "sourceDigest": "sha256:e219f43b393e2a30f3ce74cf00e838a3baf6770bbffaa2f467eb9d1301abd860"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/14610.png",
      "text": "Ibitegwa vyinshi bitobito biva mukuzimu bivuga biti, \"Amahoro.\" Isi yose irakayangana.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=11",
      "sourceDigest": "sha256:10fc79f493506dd3399c7ba8e89f51b63b0c42f0cf9e05201a3be599150c268b"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/14611.png",
      "text": "Izuba ribonesha hose. Rirasa imishwarara rivuga riti, \"Nari narababwiyeko nzogaruka.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47392#page=12",
      "sourceDigest": "sha256:def6d2957e95a398f3255c221d3e23efd83c791ae3f8a81e05b5dc2ef7be03b8"
    }
  ],
