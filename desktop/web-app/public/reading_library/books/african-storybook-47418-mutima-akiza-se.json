  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/8221.png",
      "text": "Kera habaye agahungu kitwa Mutima. Kabana na se yitwa Sakubu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=1",
      "sourceDigest": "sha256:8f8461f33be6aff510aaa17e3764886cfcbb5ec7a5896a232bbbf4b3f63b7bd2"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/8222.png",
      "text": "Sakubu yaguma mu bunywero bw'inzoga akanywa bukamwirirako. Vyari bigoye ko Mutima amubona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=2",
      "sourceDigest": "sha256:a235014265c38f364af976fca578c04e8783a7d5c746c677d6feaabb8d22981e"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/8223.png",
      "text": "Sakubu atashe yagenda arasemerera ngo, \"Bantu, bantu! Ngo muntabare! Imfyisi iranteye.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=3",
      "sourceDigest": "sha256:909347ac30f2308d79d8d192985e597cb706ac5d72afb5aab64af104f78702f0"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/8224.png",
      "text": "Bumvise ingene Sakubu atabaza, abantu bakazana imiheto, amacumu n'imipanga kumutabara. Bagasanga yariko arabahenda, kari akaborerwe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=4",
      "sourceDigest": "sha256:8e0f4ac99e8e1374258ce09591671d1968453fb9fee1ae9e53222bd4c2c5f7a1"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/8225.png",
      "text": "Sakubu arabandanya iyo ngeso yo kuborerwa, kandi akama atabaza abantu hageze mw'ijoro. Abantu nabo bakaza gutabara bazanye imiheto, amacumu n'imipanga. Mugabo basanga ari vya bindi vyiwe vyo kubahenda gusa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=5",
      "sourceDigest": "sha256:8dfa546b9ebab397e8b1ff450ec2e12c46eba60e648fb2e8dd8d009d1a8a99d4"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/8226.png",
      "text": "Imisi yose Sakubu yama ataha atevye, Mutima yama avyurwa n'urwamo rwiwe atabaza. Yari asigaye azi neza ijwi rya se. Yaramwumviriza aho ageze hose akamurindira kugeza ashitse ku rugi muhira.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=6",
      "sourceDigest": "sha256:868625f5a4688bb9a6ff142c1e342e66cf713f6ee1aae02622937d6a3caf6222"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/8227.png",
      "text": "Ijoro rimwe Sakubu yatashe yaborewe nk'uko vyari bimenyerewe. Mugabo ubu naho hariho imfyisi yinyegeje iruhande y'inzu. Igihe yasemerera, imfyisi ica iramutera.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=7",
      "sourceDigest": "sha256:602cd3a7f29821e23065425be7a478d349b7fbac4a38b95b5a510983443be66e"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/8228.png",
      "text": "Sakubu arasemerera cane atabaza. Ariko abantu baravuga bati, \"Sakubu atugeze ahantu mu kutubuza amahoro.\" Bakisubirira mu bitanda bakisinzinzirira.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=8",
      "sourceDigest": "sha256:565d2545530f28850cde88da88f5054bdf36fb742f97d6fac7b3c5ff086f5315"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/8229.png",
      "text": "Nk'uko vyari bisanzwe bimeze, rwa rwamo rwa se rugakangura wa muhungu wiwe Mutima. Muri iryo joro, akumviriza imigere ya se nk'uko yahora abikora. Ariko akarindira ko se ashika muhira akabura. Mutima atega ugutwi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=9",
      "sourceDigest": "sha256:5d75fd7e1ca6054b7540614fd33ce0a8556b6292a20373f061c70da471f80e54"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/8230.png",
      "text": "Mutima akavuga ati, \"Data ashobora kuba abangamiwe. Ubu ntariko abesha.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=10",
      "sourceDigest": "sha256:e4d6671f6b0e4e1240ec13cd6c213f7af6ff6719220b2a5617fdb5a7b3d256e7"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/8231.png",
      "text": "Akaca ava mu gitanda ningoga. Aca afata igiti kivuye mu muriro asohoka yiruka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=11",
      "sourceDigest": "sha256:189b96d71f1ebf56d8f8604d5a9b15514796954c7bea05f62fa492c894688dad"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/8232.png",
      "text": "Agahamagara ati, \"Dawe, dawe.\" Hari ku kwezi mw'ijoro Mutima akabona se agwana n'igikoko. Akaduza ca giti kiriko umuriro. Ya mfyisi ibonye ca giti caka umuriro ikaca yiruka igahunga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=12",
      "sourceDigest": "sha256:f61afb5743b02051917ad8fdcd02427ea4c848349770f5b38ceea053eb415cff"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/8234.png",
      "text": "Inyuma y'aho, Sakubu ntiyasubiye iyo ngeso yo kuja kunywa. Umwanya wiwe yawukoresha mu gutera udukuru abana kw'ishure.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47418#page=13",
      "sourceDigest": "sha256:f19ebc0876e8982e1957e0fd5b2349791f09e37935ab9166b3633718b3cc0da9"
    }
  ],
