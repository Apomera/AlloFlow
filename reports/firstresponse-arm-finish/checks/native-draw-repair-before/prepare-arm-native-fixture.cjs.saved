const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const work=__dirname,prior=path.resolve(work,'../firstresponse-wrist-shading-work');
const baselineSHA='179ddeefd0c930ca4a084d98fc683c321fb4f36f720e62cddf8b30d56b576466';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
if(sha(fs.readFileSync(path.join(work,'before.js')))!==baselineSHA)throw Error('Baseline drift');
function replace(s,a,b){if(s.split(a).length!==2)throw Error('Expected single anchor: '+a.slice(0,90));return s.replace(a,b);}
function migrate(s){return s.replaceAll('f6cfbcccc65323918d7ca7b209737dcd13cf57a31246da4110f2ab980907147f',baselineSHA).replaceAll('firstresponse-wrists-preview','firstresponse-arm-preview').replaceAll('playwright-wrists','playwright-arm').replaceAll('run-wrists-browser','run-arm-browser').replaceAll('wrist-capture-png','arm-capture-png').replaceAll('FIRST_RESPONSE_WRISTS','FIRST_RESPONSE_ARMS').replaceAll('wrist-preview-metrics','arm-preview-metrics');}
let spec=migrate(fs.readFileSync(path.join(prior,'firstresponse-wrists-preview.spec.ts'),'utf8'));
spec=replace(spec,'return {attributes:attributes,index:g.index?bufferHash(g.index.array):null,groups:g.groups,parameters:geometryParameters(g.parameters||null)};','return {attributes:attributes,index:g.index?bufferHash(g.index.array):null,indexCount:g.index?g.index.count:null,drawRange:{start:g.drawRange.start,count:g.drawRange.count===Infinity?"Infinity":g.drawRange.count},groups:g.groups,parameters:geometryParameters(g.parameters||null)};');
spec=replace(spec,'var joints=[],hands=[],handParts=[],heels=[],wristContext=[];','var joints=[],hands=[],handParts=[],heels=[],wristContext=[],arms=[];');
spec=replace(spec,'wristContext.push(joint);','wristContext.push(joint);\n      arms.push(forearm,hand.getObjectByName(hand.name+\'-upper-arm\'));');
spec=replace(spec,"if(o.geometry&&!joints.some(function(j){return j.object===o;}))preservedGeometry.push([key,descriptor(o)]);","if(o.geometry&&arms.indexOf(o)<0)preservedGeometry.push([key,descriptor(o)]);");
spec=replace(spec,'joints:joints.map(function(j){','arms:arms.map(function(o){return {name:o.name,geometry:descriptor(o),material:material(o.material),visible:visible(o)};}),\n      elbowProjection:projection(arms,function(o,p,i){var half=o.geometry.parameters.height/2;return /-forearm$/.test(o.name)?p.getY(i)>=half*.70:p.getY(i)<=-half*.70;}),\n      joints:joints.map(function(j){');
const start=spec.indexOf('  const margin=22,left='),end=spec.indexOf('\n}\nfunction valid',start);
if(start<0||end<start)throw Error('capture replacement anchors');
spec=spec.slice(0,start)+`  const cropStart=Date.now();
  function detail(projection:any,suffix:string,required:boolean){
    const p=projection,intersects=p.inFrame>0&&p.max[0]>-1&&p.min[0]<1&&p.max[1]>-1&&p.min[1]<1;
    if(!intersects){expect(required,suffix+' absent in this existing camera').toBe(false);return null;}
    const margin=22,left=b.x+(Math.max(-1,p.min[0])+1)*b.width/2,top=b.y+(1-Math.min(1,p.max[1]))*b.height/2,right=b.x+(Math.min(1,p.max[0])+1)*b.width/2,bottom=b.y+(1-Math.max(-1,p.min[1]))*b.height/2;
    const cropX=Math.max(0,Math.floor(left-margin)-x),cropY=Math.max(0,Math.floor(top-margin)-y),cropWidth=Math.min(width-cropX,Math.ceil(right+margin)-x-cropX),cropHeight=Math.min(height-cropY,Math.ceil(bottom+margin)-y-cropY);
    expect(cropWidth).toBeGreaterThan(4);expect(cropHeight).toBeGreaterThan(4);
    const cropped=cropPng(buffer,{x:cropX,y:cropY,width:cropWidth,height:cropHeight},{width,height}),file=prefix+'-'+suffix+'.png';writeFileSync(resolve(report,file),cropped.buffer);
    return {file,clip:{x:x+cropX,y:y+cropY,width:cropWidth,height:cropHeight},proof:cropped.proof,visibleVertices:p.inFrame,totalVertices:p.total,partiallyClipped:p.inFrame<p.total};
  }
  return {capture,detail:detail(value.wristProjection,'wrists',true),elbowDetail:detail(value.elbowProjection,'elbows',false),captureInfo:{stageClip:{x,y,width,height},observedCanvas:b,screenshotMs,cropMs:Date.now()-cropStart}};`+spec.slice(end);
spec=replace(spec,'function valid(value:any,view:any){','function valid(value:any,view:any,variant:string){');
const validEnd=spec.indexOf('\nfunction matching(value:any,reference:any){');
if(validEnd<0)throw Error('valid end');
spec=spec.slice(0,validEnd)+`
function validArmRanges(value:any,variant:string){
  expect(value.arms).toHaveLength(4);
  for(const arm of value.arms){
    expect(arm.name).toMatch(/^fr-rescuer-(lower|upper)-(forearm|upper-arm)$/);expect(arm.visible).toBe(true);
    const g=arm.geometry,p=g.parameters,side=p.radialSegments*p.heightSegments*6,cap=p.radialSegments*3;
    expect(g.indexCount).toBe(side+cap*2);
    expect(g.groups).toEqual([{start:0,count:side,materialIndex:0},{start:side,count:cap,materialIndex:1},{start:side+cap,count:cap,materialIndex:2}]);
    expect(g.drawRange).toEqual(variant==='baseline'?{start:0,count:'Infinity'}:{start:0,count:/-forearm$/.test(arm.name)?side:side+cap});
  }
}
`+spec.slice(validEnd);
const matchingStart=spec.indexOf('  // This refinement changes shading only.'),matchingEnd=spec.indexOf('\nexpect(value.camera)',matchingStart);
if(matchingStart<0||matchingEnd<matchingStart)throw Error('matching anchors');
spec=spec.slice(0,matchingStart)+`  // Only the declared internal cap draw ranges may change. Every buffer stays exact.
  expect(value.wristProjection).toEqual(reference.wristProjection);
  expect(value.elbowProjection).toEqual(reference.elbowProjection);
  expect(value.joints).toEqual(reference.joints);
  let removedTriangles=0;
  for(let i=0;i<value.arms.length;i++){
    const arm=value.arms[i],prior=reference.arms[i],retained=JSON.parse(JSON.stringify(arm)),expected=JSON.parse(JSON.stringify(prior));
    expect(arm.name).toBe(prior.name);
    removedTriangles+=(prior.geometry.indexCount-arm.geometry.drawRange.count)/3;
    delete retained.geometry.drawRange;delete expected.geometry.drawRange;
    expect(retained,'all arm buffers, cap groups, materials and visibility stay exact').toEqual(expected);
  }
  expect(removedTriangles).toBe(144);
  expect(value.draw.triangles).toBe(reference.draw.triangles-removedTriangles);
  expect(value.draw.calls).toBe(reference.draw.calls);`+spec.slice(matchingEnd);
spec=replace(spec,'valid(value,view);','valid(value,view,variant);validArmRanges(value,variant);');
spec=replace(spec,"for(const view of views)test('rescuer wrist '","for(const view of views)test('rescuer arm cap finish '");
spec=replace(spec,'expect(value.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));','expect(value.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));expect(value.arms).toEqual(released.arms);');
spec=replace(spec,'expect(repeated.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));','expect(repeated.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));expect(repeated.arms).toEqual(released.arms);');
spec=replace(spec,"const {cropPng}=require('./arm-capture-png.cjs');", "const {cropPng}=require('./arm-capture-png.cjs');\nconst {runMountWithWaitWindow}=require('./arm-mount-window.cjs');");
spec=replace(spec,'await harness.mount(page,','attempt.mountWindow=await runMountWithWaitWindow(page,()=>harness.mount(page,');
spec=replace(spec,"');await page.addStyleTag", "'));expect(attempt.mountWindow.adjustedWaits).toBe(4);await page.addStyleTag");
let runner=migrate(fs.readFileSync(path.join(prior,'run-wrists-browser.cjs'),'utf8'));
runner=replace(runner,"{spawn}=require('node:child_process')","{spawn,spawnSync}=require('node:child_process')");
runner=replace(runner,"if(!baselineOnly&&finalSHA===baselineSHA)throw Error('Candidate is unchanged');","if(!baselineOnly&&finalSHA===baselineSHA)throw Error('Candidate is unchanged');if(!baselineOnly){const delta=JSON.parse(fs.readFileSync(path.join(work,'delta.json'),'utf8'));if(delta.afterSHA256!==finalSHA)throw Error('Candidate/delta pin mismatch');}");
runner=replace(runner,"const inputs=Object.fromEntries(guard.map", "if(!baselineOnly)guard.push(path.join(work,'delta.json'));\nconst inputs=Object.fromEntries(guard.map");
runner=replace(runner,"fs.writeFileSync(path.join(report,'runner.json')", "let timedOut=false;const limit=setTimeout(()=>{timedOut=true;spawnSync('taskkill',['/PID',String(child.pid),'/T','/F'],{windowsHide:true,stdio:'ignore'});},900000);\nfs.writeFileSync(path.join(report,'runner.json')");
runner=replace(runner,"console.log('START wrist browser pid='","console.log('START arm browser pid='");
runner=replace(runner,"child.on('close',code=>{stream.end();try{", "child.on('close',code=>{clearTimeout(limit);stream.end();try{if(timedOut)throw Error('Native runner exceeded 900000ms bound');");
runner=replace(runner,"throw Error('Incomplete captures');", "throw Error('Incomplete captures');if(images.filter(p=>p.endsWith('-elbows.png')).length!==metrics.evidence.filter(e=>e.elbowDetail).length)throw Error('Elbow capture count mismatch');for(const e of metrics.evidence){if(!e.detail.proof.sameCapturedFrame||e.elbowDetail&&(!e.elbowDetail.proof.sameCapturedFrame||e.elbowDetail.proof.sourceSHA256!==e.detail.proof.sourceSHA256))throw Error('Detail crops do not use same stage frame');}");
runner=replace(runner,"perWorkflowTimeoutMs:450000,images", "perWorkflowTimeoutMs:450000,runnerTimeoutMs:900000,elbowCaptureCount:metrics.evidence.filter(e=>e.elbowDetail).length,images");
runner=replace(runner,"path.join(work,'firstresponse-arm-preview.spec.ts'),", "path.join(work,'firstresponse-arm-preview.spec.ts'),path.join(work,'arm-mount-window.cjs'),");
const files={
  'arm-mount-window.cjs':fs.readFileSync(path.join(work,'arm-mount-window.cjs'),'utf8'),
  'firstresponse-arm-preview.spec.ts':spec,
  'run-arm-browser.cjs':runner,
  'playwright-arm.config.cjs':migrate(fs.readFileSync(path.join(prior,'playwright-wrists.config.cjs'),'utf8')),
  'arm-capture-png.cjs':fs.readFileSync(path.join(prior,'wrist-capture-png.cjs'),'utf8').replaceAll('wrist crop','arm crop').replaceAll('Wrist crop','Arm crop'),
  'check-arm-fixture.cjs':migrate(fs.readFileSync(path.join(prior,'check-wrists-fixture.cjs'),'utf8')).replace("'arm-capture-png.cjs'","'arm-capture-png.cjs','arm-mount-window.cjs'"),
};
for(const[name,text]of Object.entries(files))fs.writeFileSync(path.join(work,name),text);
fs.writeFileSync(path.join(work,'browser-fixture-preparation.json'),JSON.stringify({baselineSHA,files:Object.fromEntries(Object.keys(files).map(name=>[name,sha(fs.readFileSync(path.join(work,name)))])),browserLaunched:false,scope:'Only named forearm and upper-arm drawRange may differ; all vertex/index buffers remain exact',views:['adult-heel-side','child-heel-side-contrast'],perWorkflowTimeoutMs:450000,runnerTimeoutMs:900000},null,2));
console.log('Prepared native arm fixture with exact cap range assertions and same-frame elbow crops.');
