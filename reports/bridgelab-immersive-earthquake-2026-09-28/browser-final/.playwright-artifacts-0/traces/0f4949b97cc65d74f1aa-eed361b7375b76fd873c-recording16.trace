 construction."],["DIV",{"style":"margin-top: 14px; padding: 10px; border-top: 2px solid rgb(15, 23, 42); font-size: 10.5px; color: rgb(71, 85, 105); line-height: 1.5;"},"Sources: NGSS Lead States (2013) · Hibbeler, R.C. (2017), Structural Analysis · AASHTO LRFD Bridge Design Specifications · Petroski, H. (1994), Design Paradigms (Tacoma Narrows + Tay Bridge + Hyatt). Printed from AlloFlow STEAM Lab."]]]]]],[[148,20]],[[148,21]],[[148,22]],[[148,23]],[[148,24]],[[148,25]],[[148,26]],[[148,27]],[[23,37]]]],"viewport":{"width":1000,"height":900},"timestamp":431337.825,"wallTime":1790654322924,"collectionTime":7.5,"resourceOverrides":[],"isMainFrame":true}}
