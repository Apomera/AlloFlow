giant","v":{"s":"Blue Giant"}},{"k":"hot_brief_main_sequence","v":{"s":"Hot, brief main sequence"}},{"k":"red_supergiant","v":{"s":"Red Supergiant"}},{"k":"onion_shell_fusion","v":{"s":"Onion-shell fusion"}},{"k":"supernova","v":{"s":"Supernova"}},{"k":"catastrophic_collapse_explosion","v":{"s":"Catastrophic collapse + explosion"}},{"k":"neutron_star","v":{"s":"Neutron Star"}},{"k":"or_black_hole_if_25_m","v":{"s":"Or black hole if > 25 M☉"}},{"k":"time","v":{"s":"Time"}},{"k":"total_lifespan","v":{"s":"Total lifespan: "}},{"k":"current_stage","v":{"s":"Current stage: "}},{"k":"moon_phase_dial","v":{"s":"🌙 Moon Phase Dial"}},{"k":"drag_the_slider_to_orbit_the_moon_arou","v":{"s":"Drag the slider to orbit the Moon around Earth. Watch the phase update in real time based on the Sun-Earth-Moon angle."}},{"k":"earth_3","v":{"s":"Earth"}},{"k":"orbit","v":{"s":"Orbit"}},{"k":"eclipse_theater","v":{"s":"☀ Eclipse Theater"}},{"k":"drag_the_alignment_slider_to_line_up_s","v":{"s":"Drag the alignment slider to line up Sun, Moon, and Earth. Switch between solar and lunar eclipses."}},{"k":"earth_4","v":{"s":"Earth"}},{"k":"alignment","v":{"s":"Alignment"}},{"k":"center","v":{"s":"Center"}},{"k":"aurora_tuner","v":{"s":"✨ Aurora Tuner"}},{"k":"adjust_solar_wind_latitude_and_altitud","v":{"s":"Adjust solar wind, latitude, and altitude to tune the aurora. Color depends on what particles excite which atmospheric atoms."}},{"k":"solar_wind","v":{"s":"Solar wind"}},{"k":"latitude","v":{"s":"Latitude"}},{"k":"altitude","v":{"s":"Altitude"}},{"k":"comet_tail_builder","v":{"s":"☄ Comet Tail Builder"}},{"k":"a_comet_gets_two_tails_when_it_nears_t","v":{"s":"A comet gets two tails when it nears the Sun. Adjust distance + wind angle to see how they form."}},{"k":"nucleus_coma","v":{"s":"Nucleus + Coma"}},{"k":"dust_tail","v":{"s":"Dust tail"}},{"k":"ion_tail","v":{"s":"Ion tail"}},{"k":"distance_to_sun_au","v":{"s":"Distance to Sun (AU)"}},{"k":"wind_angle","v":{"s":"Wind angle (°)"}},{"k":"dust_tail_2","v":{"s":"Dust tail "}},{"k":"curved_pushed_by_photon_radiation_pres","v":{"s":"— curved, pushed by photon radiation pressure (slower)"}},{"k":"ion_tail_2","v":{"s":"Ion tail "}},{"k":"straight_pushed_by_solar_wind_charged_","v":{"s":"— straight, pushed by solar wind charged particles (faster)"}},{"k":"black_hole_visualizer","v":{"s":"⚫ Black Hole Visualizer"}},{"k":"adjust_mass_and_spin_watch_the_event_h","v":{"s":"Adjust mass and spin. Watch the event horizon grow and the accretion disk respond. Heavy spin launches polar jets."}},{"k":"mass","v":{"s":"Mass"}},{"k":"spin","v":{"s":"Spin"}},{"k":"black_hole_has_3_properties_mass_spin_","v":{"s":"Black hole has 3 properties: mass, spin, charge. The event horizon is the point of no return — once light crosses it, nothing escapes. The accretion disk is matter spiraling in, heated to millions of degrees by friction. Fast-spinning holes can launch relativistic jets along the spin axis."}},{"k":"orbital_speed_race","v":{"s":"🏁 Orbital Speed Race"}},{"k":"scrub_earth_years_and_watch_all_five_i","v":{"s":"Scrub Earth years and watch all five inner planets orbit at their real relative speeds. Kepler's third law in motion."}},{"k":"mercury_2","v":{"s":"Mercury"}},{"k":"venus_2","v":{"s":"Venus"}},{"k":"earth_5","v":{"s":"Earth"}},{"k":"mars_3","v":{"s":"Mars"}},{"k":"jupiter_3","v":{"s":"Jupiter"}},{"k":"earth_years","v":{"s":"Earth years"}},{"k":"kepler_s_third_law_orbital_period_squa","v":{"s":"Kepler's third law: orbital period squared ∝ distance cubed. Inner planets sprint; outer planets crawl. Jupiter takes 12 Earth years for one orbit; Mercury laps every 88 days."}},{"k":"spacecraft_designer","v":{"s":"🚀 Spacecraft Designer"}},{"k":"build_a_spacecraft_from_real_component","v":{"s":"Build a spacecraft from real components. Choose core, power, propulsion + payload — watch mass + cost update."}},{"k":"probe","v":{"s":"Probe"}},{"k":"orbiter","v":{"s":"Orbiter"}},{"k":"crewed","v":{"s":"Crewed"}},{"k":"solar_panels","v":{"s":"Solar Panels"}},{"k":"rtg_nuclear","v":{"s":"RTG (Nuclear)"}},{"k":"battery_only","v":{"s":"Battery only"}},{"k":"chemical","v":{"s":"Chemical"}},{"k":"ion_drive","v":{"s":"Ion drive"}},{"k":"nuclear_thermal","v":{"s":"Nuclear thermal"}},{"k":"optical_camera","v":{"s":"Optical Camera"}},{"k":"spectrometer","v":{"s":"Spectrometer"}},{"k":"sample_drill","v":{"s":"Sample Drill"}},{"k":"onboard_lab","v":{"s":"Onboard Lab"}},{"k":"payload_multi","v":{"s":"Payload (multi)"}},{"k":"solar_cycle_visualizer","v":{"s":"☀ Solar Cycle Visualizer"}},{"k":"the_sun_has_an_11_year_cycle_of_sunspo","v":{"s":"The Sun has an 11-year cycle of sunspot activity. Scrub through to see sunspots come and go + CME launches."}},{"k":"cycle_year","v":{"s":"Cycle year"}},{"k":"the_sun_cycles_every_11_years_between_","v":{"s":"The Sun cycles every ~11 years between minimum (few sunspots, calm) and maximum (many sunspots, frequent solar flares + CMEs). Current Cycle 25 is rising, peaking ~2025."}},{"k":"habitable_zone_calculator","v":{"s":"🌱 Habitable Zone Calculator"}},{"k":"where_could_life_as_we_know_it_survive","v":{"s":"Where could life-as-we-know-it survive around any star? Adjust star luminosity + planet distance to see."}},{"k":"planet","v":{"s":"Planet"}},{"k":"star_luminosity_l","v":{"s":"Star luminosity (L☉)"}},{"k":"planet_distance_au","v":{"s":"Planet distance (AU)"}},{"k":"the_habitable_zone_is_where_surface_wa","v":{"s":"The habitable zone is where surface water can stay liquid. Inner edge: greenhouse effect dries off. Outer edge: ice traps CO2, runaway freeze. Edges scale as √L."}},{"k":"tidal_forces_visualizer","v":{"s":"🌊 Tidal Forces Visualizer"}},{"k":"drag_the_moon_closer_to_make_earth_s_t","v":{"s":"Drag the Moon closer to make Earth's tides bigger. Note the bulge is on both the near + far sides."}},{"k":"moon","v":{"s":"Moon"}},{"k":"earth_moon_tidal_bulge","v":{"s":"Earth + Moon Tidal Bulge"}},{"k":"moon_distance","v":{"s":"Moon distance"}},{"k":"moon_angle","v":{"s":"Moon angle (°)"}},{"k":"tides_happen_because_gravity_pulls_mor","v":{"s":"Tides happen because gravity pulls more strongly on the near side than the far side of Earth. Both sides bulge outward. Sun and Moon together create spring (aligned) + neap (perpendicular) tides."}},{"k":"day_night_globe","v":{"s":"🌍 Day/Night Globe"}},{"k":"rotate_earth_and_adjust_season_watch_t","v":{"s":"Rotate Earth and adjust season. Watch the day/night terminator move + the axis tilt shift the sunlit hemisphere."}},{"k":"daily_rotation","v":{"s":"Daily rotation"}},{"k":"time_of_year","v":{"s":"Time of year"}},{"k":"lagrange_points_lab","v":{"s":"⚖ Lagrange Points Lab"}},{"k":"five_gravitational_sweet_spots_between","v":{"s":"Five gravitational sweet spots between two bodies where spacecraft can hover. James Webb sits at L2."}},{"k":"earth_6","v":{"s":"Earth"}},{"k":"lagrange_points","v":{"s":"Lagrange Points"}},{"k":"green_stable_equilibria_l4_l5_yellow_u","v":{"s":"Green: stable equilibria (L4, L5) • Yellow: unstable but useful (L1, L2, L3)"}},{"k":"five_points_in_any_two_body_orbit_wher","v":{"s":"Five points in any two-body orbit where gravity and centrifugal effects balance. Spacecraft can park here with minimal fuel. JWST sits at L2 — always behind Earth, away from Sun."}},{"k":"spectroscopy_lab","v":{"s":"🌈 Spectroscopy Lab"}},{"k":"each_element_fingerprints_light_in_spe","v":{"s":"Each element fingerprints light in specific wavelengths. Cycle through elements to see how astronomers identify them in distant stars."}},{"k":"hydrogen","v":{"s":"Hydrogen"}},{"k":"helium","v":{"s":"Helium"}},{"k":"sodium","v":{"s":"Sodium"}},{"k":"neon","v":{"s":"Neon"}},{"k":"mercury_3","v":{"s":"Mercury"}},{"k":"argon","v":{"s":"Argon"}},{"k":"380nm_uv","v":{"s":"380nm (UV)"}},{"k":"780nm_ir","v":{"s":"780nm (IR)"}},{"k":"visible_light_continuum","v":{"s":"Visible light continuum"}},{"k":"element_emission_lines_fingerprint","v":{"s":"Element emission lines (fingerprint)"}},{"k":"every_element_emits_its_own_unique_pat","v":{"s":"Every element emits its own unique pattern of light wavelengths — its spectral fingerprint. By looking at light from distant stars, we can determine what they're made of. This is how we know the Sun is 75% hydrogen!"}},{"k":"constellation_hunter","v":{"s":"✨ Constellation Hunter"}},{"k":"click_constellations_to_see_their_star","v":{"s":"Click constellations to see their stars + connecting lines. Each star has its own color + true name."}},{"k":"orion","v":{"s":"Orion"}},{"k":"betelgeuse","v":{"s":"Betelgeuse"}},{"k":"rigel","v":{"s":"Rigel"}},{"k":"bellatrix","v":{"s":"Bellatrix"}},{"k":"saiph","v":{"s":"Saiph"}},{"k":"alnitak","v":{"s":"Alnitak"}},{"k":"alnilam","v":{"s":"Alnilam"}},{"k":"mintaka","v":{"s":"Mintaka"}},{"k":"ursa_major_big_dipper","v":{"s":"Ursa Major (Big Dipper)"}},{"k":"dubhe","v":{"s":"Dubhe"}},{"k":"merak","v":{"s":"Merak"}},{"k":"phecda","v":{"s":"Phecda"}},{"k":"megrez","v":{"s":"Megrez"}},{"k":"alioth","v":{"s":"Alioth"}},{"k":"mizar","v":{"s":"Mizar"}},{"k":"alkaid","v":{"s":"Alkaid"}},{"k":"cassiopeia","v":{"s":"Cassiopeia"}},{"k":"caph","v":{"s":"Caph"}},{"k":"schedar","v":{"s":"Schedar"}},{"k":"gamma_cas","v":{"s":"Gamma Cas"}},{"k":"ruchbah","v":{"s":"Ruchbah"}},{"k":"segin","v":{"s":"Segin"}},{"k":"constellations_are_patterns_of_stars_t","v":{"s":"Constellations are patterns of stars that cultures recognized over millennia. The IAU codified 88 official constellations in 1922. The stars within a constellation usually aren't physically near each other — they just appear close from Earth."}},{"k":"trajectory_designer","v":{"s":"🛰 Trajectory Designer"}},{"k":"how_much_delta_v_travel_time_to_reach_","v":{"s":"How much delta-v + travel time to reach different destinations? Hohmann transfer orbits visualized."}},{"k":"moon_2","v":{"s":"Moon"}},{"k":"mars_4","v":{"s":"Mars"}},{"k":"jupiter_4","v":{"s":"Jupiter"}},{"k":"pluto_3","v":{"s":"Pluto"}},{"k":"voyager_interstellar","v":{"s":"Voyager (interstellar)"}},{"k":"earth_7","v":{"s":"Earth"}},{"k":"hohmann_transfer","v":{"s":"Hohmann transfer"}},{"k":"a_hohmann_transfer_is_the_most_fuel_ef_2","v":{"s":"A Hohmann transfer is the most fuel-efficient way to move between two circular orbits. It uses two burns: one to enter the transfer ellipse, one to circularize at the destination. Δv is the total change in velocity required."}},{"k":"mars_rover_pathfinder","v":{"s":"🚗 Mars Rover Pathfinder"}},{"k":"pilot_a_rover_from_start_to_goal_plan_","v":{"s":"Pilot a rover from start to goal. Plan around rocks and mountains; watch your fuel!"}},{"k":"reset_2","v":{"s":"Reset"}},{"k":"drive_the_rover_from_start_to_goal_cos","v":{"s":"Drive the rover from start to goal. Costs: flat ground 1, "}},{"k":"rocks_2","v":{"s":" rocks 2, "}},{"k":"boulders_3","v":{"s":" boulders 3, "}},{"k":"mountains_5","v":{"s":" mountains 5"}},{"k":"plan_the_path_to_conserve_fuel_like_re","v":{"s":"Plan the path to conserve fuel. Like real Mars rovers, every meter requires fuel budgeting."}},{"k":"cosmic_distance_ladder","v":{"s":"📏 Cosmic Distance Ladder"}},{"k":"how_astronomers_measure_distance_each_","v":{"s":"How astronomers measure distance: each method bootstraps the next. Climb from Earth size to the observable universe."}},{"k":"earth_diameter","v":{"s":"Earth diameter"}},{"k":"compared_sun_angle_in_two_cities_first","v":{"s":"Compared sun angle in two cities. First measure of Earth."}},{"k":"hipparchus_150_bce_used_earth_s_shadow","v":{"s":"Hipparchus (~150 BCE) used Earth's shadow on Moon during eclipse to estimate distance."}},{"k":"1_au_earth_sun","v":{"s":"1 AU (Earth-Sun)"}},{"k":"defines_the_astronomical_unit_modern_r","v":{"s":"Defines the astronomical unit. Modern radar bounces are precise to meters."}},{"k":"outer_planets","v":{"s":"Outer planets"}},{"k":"kepler_s_third_law_distance_from_orbit","v":{"s":"Kepler's third law: distance from orbital period. Now confirmed by spacecraft."}},{"k":"nearby_stars","v":{"s":"Nearby stars"}},{"k":"earth_s_orbit_gives_2_au_baseline_star","v":{"s":"Earth's orbit gives 2 AU baseline. Star appears to shift seasonally."}},{"k":"within_milky_way","v":{"s":"Within Milky Way"}},{"k":"pulsation_period_reveals_true_brightne","v":{"s":"Pulsation period reveals true brightness. Compare with apparent brightness for distance."}},{"k":"nearby_galaxies","v":{"s":"Nearby galaxies"}},{"k":"same_cepheid_method_extended_to_other_","v":{"s":"Same Cepheid method extended to other galaxies. Hubble showed Andromeda was extragalactic in 1923."}},{"k":"distant_galaxies","v":{"s":"Distant galaxies"}},{"k":"more_distant_galaxies_are_receding_fas","v":{"s":"More distant galaxies are receding faster. v = H × d gives distance."}},{"k":"edge_of_observable_universe","v":{"s":"Edge of observable universe"}},{"k":"cosmic_microwave_background_is_light_f","v":{"s":"Cosmic Microwave Background is light from 13.8 billion years ago, stretched by expansion."}},{"k":"cosmic_distance_ladder_2","v":{"s":"Cosmic Distance Ladder"}},{"k":"closer","v":{"s":"← Closer"}},{"k":"farther","v":{"s":"Farther →"}},{"k":"doppler_shift_demo","v":{"s":"🚦 Doppler Shift Demo"}},{"k":"light_from_receding_objects_redshifts_","v":{"s":"Light from receding objects redshifts; from approaching, blueshifts. This is how we measure cosmic distances + know universe is expanding."}},{"k":"rest_656nm","v":{"s":"rest 656nm"}},{"k":"observer","v":{"s":"Observer"}},{"k":"galaxy","v":{"s":"Galaxy"}},{"k":"hydrogen_alpha_line_656nm","v":{"s":"Hydrogen-alpha line (656nm)"}},{"k":"velocity_km_s","v":{"s":"Velocity (km/s)"}},{"k":"planetary_albedo_lab","v":{"s":"❄ Planetary Albedo Lab"}},{"k":"how_much_of_a_planet_s_incoming_sunlig","v":{"s":"How much of a planet's incoming sunlight is reflected vs absorbed? This drives global temperature."}},{"k":"ice_cover","v":{"s":"Ice cover (%)"}},{"k":"cloud_cover","v":{"s":"Cloud cover (%)"}},{"k":"albedo_fraction_of_light_reflected_ice","v":{"s":"Albedo = fraction of light reflected. Ice + clouds are highly reflective (high albedo); dark soil + water absorb (low albedo). More reflection = cooler planet. This is the ice-albedo feedback that drives ice ages."}},{"k":"big_bang_stretch","v":{"s":"💥 Big Bang Stretch"}},{"k":"13_8_billion_years_compressed_into_a_s","v":{"s":"13.8 billion years compressed into a slider. Scrub from singularity to today."}},{"k":"big_bang_singularity","v":{"s":"Big Bang singularity"}},{"k":"spacetime_matter_compressed_to_a_point","v":{"s":"Spacetime + matter compressed to a point"}},{"k":"inflation_epoch_10_s","v":{"s":"Inflation epoch (10⁻³⁶ s)"}},{"k":"universe_expands_by_10_in_a_fraction_o","v":{"s":"Universe expands by 10²⁶ in a fraction of a second"}},{"k":"quark_soup_10_s","v":{"s":"Quark soup (10⁻⁶ s)"}},{"k":"quarks_bind_into_protons_and_neutrons","v":{"s":"Quarks bind into protons and neutrons"}},{"k":"nucleosynthesis_3_min","v":{"s":"Nucleosynthesis (3 min)"}},{"k":"first_atomic_nuclei_hydrogen_helium_li","v":{"s":"First atomic nuclei: hydrogen, helium, lithium"}},{"k":"recombination_380_000_yr","v":{"s":"Recombination (380,000 yr)"}},{"k":"first_atoms_cmb_photons_released","v":{"s":"First atoms; CMB photons released"}},{"k":"cosmic_dark_ages","v":{"s":"Cosmic Dark Ages"}},{"k":"no_stars_mostly_neutral_hydrogen_dark_","v":{"s":"No stars; mostly neutral hydrogen + dark matter"}},{"k":"first_stars_200_my","v":{"s":"First stars (200 My)"}},{"k":"population_iii_stars_massive_short_liv","v":{"s":"Population III stars: massive, short-lived"}},{"k":"first_galaxies_500_my","v":{"s":"First galaxies (500 My)"}},{"k":"mergers_create_the_first_galaxy_seeds","v":{"s":"Mergers create the first galaxy seeds"}},{"k":"galaxy_maturation_1_9_gy","v":{"s":"Galaxy maturation (1-9 Gy)"}},{"k":"most_galaxies_assembled_star_formation","v":{"s":"Most galaxies assembled; star formation peaks"}},{"k":"solar_system_forms_9_gy","v":{"s":"Solar System forms (9 Gy)"}},{"k":"our_sun_and_planets_accrete","v":{"s":"Our Sun and planets accrete"}},{"k":"present_day_13_8_gy","v":{"s":"Present day (13.8 Gy)"}},{"k":"expansion_accelerating_due_to_dark_ene","v":{"s":"Expansion accelerating due to dark energy"}},{"k":"time_2","v":{"s":"Time"}},{"k":"the_universe_is_13_8_billion_years_old","v":{"s":"The universe is 13.8 billion years old. It began infinitely dense + hot, then expanded + cooled. Galaxies formed by 1 billion years, our Sun by 9 billion years, and we are here at 13.8 billion years."}},{"k":"asteroid_defender","v":{"s":"🎯 Asteroid Defender"}},{"k":"click_incoming_asteroids_before_they_r","v":{"s":"Click incoming asteroids before they reach Earth. Like NASA's DART mission planetary defense."}},{"k":"earth_8","v":{"s":"Earth"}},{"k":"new_wave","v":{"s":"🚀 New Wave"}},{"k":"real_nasa_program_dart_double_asteroid","v":{"s":"Real NASA program: DART (Double Asteroid Redirection Test) successfully changed Dimorphos's orbit in 2022. The Planetary Defense Coordination Office tracks +30,000 near-Earth objects."}},{"k":"galaxy_spiral_map","v":{"s":"🌌 Galaxy Spiral Map"}},{"k":"four_galaxy_morphologies_spirals_like_","v":{"s":"Four galaxy morphologies. Spirals like ours show arms tracing star formation. Ellipticals are old, irregulars are chaotic."}},{"k":"spiral_like_milky_way","v":{"s":"Spiral (like Milky Way)"}},{"k":"barred_spiral","v":{"s":"Barred Spiral"}},{"k":"elliptical_2","v":{"s":"Elliptical"}},{"k":"irregular_lmc_like","v":{"s":"Irregular (LMC-like)"}},{"k":"100_billion_stars_typical","v":{"s":"~100 billion stars typical"}},{"k":"rotate","v":{"s":"Rotate"}},{"k":"telescope_aperture_lab","v":{"s":"🔭 Telescope Aperture Lab"}},{"k":"bigger_aperture_gathers_more_light_res","v":{"s":"Bigger aperture gathers more light + resolves finer detail. Magnification matters less than you think."}},{"k":"aperture_cm","v":{"s":"Aperture (cm)"}},{"k":"magnification","v":{"s":"Magnification"}},{"k":"aperture_matters_more_than_magnificati","v":{"s":"Aperture matters more than magnification! Bigger objective gathers more light + resolves finer detail. Magnification beyond 50×/cm aperture just blurs. JWST aperture 6.5m sees galaxies just 200 million years after Big Bang."}},{"k":"atmospheric_layers","v":{"s":"🌫 Atmospheric Layers"}},{"k":"drag_the_altitude_slider_up_through_ea","v":{"s":"Drag the altitude slider up through Earth's atmosphere. Pressure drops, temp swings, and chemistry changes layer by layer."}},{"k":"troposphere_2","v":{"s":"Troposphere"}},{"k":"weather_happens_here_temperature_decre","v":{"s":"Weather happens here. Temperature decreases with altitude."}},{"k":"stratosphere_3","v":{"s":"Stratosphere"}},{"k":"ozone_layer_absorbs_uv_temperature_inc","v":{"s":"Ozone layer absorbs UV. Temperature increases with altitude."}},{"k":"mesosphere","v":{"s":"Mesosphere"}},{"k":"meteors_burn_up_here_coldest_layer_90_","v":{"s":"Meteors burn up here. Coldest layer (-90°C)."}},{"k":"thermosphere_2","v":{"s":"Thermosphere"}},{"k":"iss_orbits_here_400km_aurora_glow_very","v":{"s":"ISS orbits here (400km). Aurora glow. Very thin air but hot."}},{"k":"exosphere","v":{"s":"Exosphere"}},{"k":"boundary_to_space_air_escapes_to_space","v":{"s":"Boundary to space. Air escapes to space."}},{"k":"iss_400km","v":{"s":"🛰 ISS (400km)"}},{"k":"space","v":{"s":"⭐ Space ⭐"}},{"k":"altitude_2","v":{"s":"Altitude"}},{"k":"phases_of_venus_galileo","v":{"s":"♀ Phases of Venus (Galileo)"}},{"k":"galileo_s_1610_observations_venus_goes","v":{"s":"Galileo's 1610 observations: Venus goes through phases. This proved Venus orbits the Sun, not Earth."}},{"k":"earth_9","v":{"s":"Earth"}},{"k":"venus_3","v":{"s":"Venus"}},{"k":"galileo_s_1610_discovery_venus_has_pha","v":{"s":"Galileo's 1610 discovery: Venus has phases like the Moon"}},{"k":"orbit_2","v":{"s":"Orbit"}},{"k":"in_1610_galileo_observed_venus_through","v":{"s":"In 1610 Galileo observed Venus through his telescope and saw it went through phases — like the Moon. This was proof Venus orbits the Sun, not Earth. Ptolemy's geocentric system can't explain a full Venus. Major evidence for Copernican heliocentrism."}},{"k":"magnetic_field_visualizer","v":{"s":"🧲 Magnetic Field Visualizer"}},{"k":"a_magnetic_field_deflects_solar_wind_p","v":{"s":"A magnetic field deflects solar wind + protects atmosphere. Mars lost both; that's why it's barren."}},{"k":"earth_10","v":{"s":"Earth"}},{"k":"magnetic_field_3","v":{"s":"Magnetic field"}},{"k":"solar_wind_2","v":{"s":"Solar wind"}},{"k":"earth_s_magnetic_field_deflects_most_s","v":{"s":"Earth's magnetic field deflects most solar wind, protecting atmosphere + life. Mars lost its magnetic field ~4 billion years ago and slowly lost its atmosphere. Jupiter has the strongest field in the solar system."}},{"k":"solar_system_scale","v":{"s":"📐 Solar System Scale"}},{"k":"switch_between_size_and_distance_views","v":{"s":"Switch between size and distance views. Both can't be shown to scale at once — that's how empty space really is."}},{"k":"mercury_4","v":{"s":"Mercury"}},{"k":"venus_4","v":{"s":"Venus"}},{"k":"earth_11","v":{"s":"Earth"}},{"k":"mars_5","v":{"s":"Mars"}},{"k":"jupiter_5","v":{"s":"Jupiter"}},{"k":"saturn_2","v":{"s":"Saturn"}},{"k":"uranus_2","v":{"s":"Uranus"}},{"k":"neptune_3","v":{"s":"Neptune"}},{"k":"true_scales_are_hard_to_show_simultane","v":{"s":"True scales are hard to show simultaneously. If Earth were a pea, the Sun would be a beach ball 200 feet away. If the distances are to scale, the planets become invisible dots. Most diagrams compromise."}},{"k":"lunar_lander_mini_game","v":{"s":"🛬 Lunar Lander Mini-Game"}},{"k":"thrust_to_slow_your_descent_land_softe","v":{"s":"Thrust to slow your descent. Land softer than 2.5 m/s or crash. Manage fuel — there's not enough for free hover."}},{"k":"landing_pad","v":{"s":"Landing pad"}},{"k":"thrust","v":{"s":"🔥 Thrust"}},{"k":"fall_tick","v":{"s":"⏬ Fall (tick)"}},{"k":"apollo_11_nearly_ran_out_of_fuel_durin","v":{"s":"Apollo 11 nearly ran out of fuel during the lunar descent. Neil Armstrong manually overrode the autopilot to find a smoother landing area. Touchdown happened with ~25 seconds of fuel left."}},{"k":"light_year_walker","v":{"s":"⏱ Light-Year Walker"}},{"k":"pick_a_destination_see_how_long_light_","v":{"s":"Pick a destination + see how long light takes to reach it. Beyond the solar system, distances grow staggering."}},{"k":"moon_3","v":{"s":"Moon"}},{"k":"384_400_km","v":{"s":"384,400 km"}},{"k":"150_million_km","v":{"s":"150 million km"}},{"k":"mars_closest","v":{"s":"Mars (closest)"}},{"k":"78_million_km","v":{"s":"78 million km"}},{"k":"jupiter_6","v":{"s":"Jupiter"}},{"k":"778_million_km","v":{"s":"778 million km"}},{"k":"pluto_4","v":{"s":"Pluto"}},{"k":"5_9_billion_km","v":{"s":"5.9 billion km"}},{"k":"proxima_centauri","v":{"s":"Proxima Centauri"}},{"k":"nearest_star","v":{"s":"Nearest star"}},{"k":"sirius","v":{"s":"Sirius"}},{"k":"brightest_star","v":{"s":"Brightest star"}},{"k":"vega","v":{"s":"Vega"}},{"k":"future_pole_star","v":{"s":"Future pole star"}},{"k":"andromeda","v":{"s":"Andromeda"}},{"k":"nearest_large_galaxy","v":{"s":"Nearest large galaxy"}},{"k":"edge_of_observable_universe_2","v":{"s":"Edge of observable universe"}},{"k":"light_travel_expansion","v":{"s":"Light travel + expansion"}},{"k":"earth_12","v":{"s":"Earth"}},{"k":"light_moves_300_000_km_s_we_see_distan","v":{"s":"Light moves 300,000 km/s. We see distant objects as they were when light left them. The Sun we see is 8 minutes old; Proxima Centauri is 4 years old. Andromeda Galaxy is 2.5 million years old."}},{"k":"sun_path_across_latitudes","v":{"s":"☀ Sun Path Across Latitudes"}},{"k":"where_exactly_does_the_sun_rise_set_it","v":{"s":"Where exactly does the Sun rise + set? It depends on your latitude + the day. Try Maine vs Arctic Circle."}},{"k":"latitude_2","v":{"s":"Latitude"}},{"k":"day_of_year","v":{"s":"Day of year"}},{"k":"sun_path_depends_on_latitude_season_at","v":{"s":"Sun path depends on latitude + season. At the equator, sun goes straight overhead. At Arctic Circle, midnight sun on summer solstice + polar night on winter solstice. Maine's Portland: midsummer sun is high; midwinter, sun barely clears horizon."}},{"k":"habitable_moons","v":{"s":"🌙 Habitable Moons"}},{"k":"some_moons_may_host_life_europa_encela","v":{"s":"Some moons may host life: Europa + Enceladus + Titan + Ganymede have subsurface oceans. Active missions search now."}},{"k":"europa_jupiter","v":{"s":"Europa (Jupiter)"}},{"k":"subsurface_ocean_has_2_water_of_earth_","v":{"s":"Subsurface ocean has 2× water of Earth oceans. Hydrothermal vents possible at sea floor. JUICE + Europa Clipper missions ongoing."}},{"k":"enceladus_saturn","v":{"s":"Enceladus (Saturn)"}},{"k":"cassini_discovered_geysers_spraying_wa","v":{"s":"Cassini discovered geysers spraying water + organics + hydrogen + silica. Habitable conditions confirmed by chemistry of plumes."}},{"k":"titan_saturn","v":{"s":"Titan (Saturn)"}},{"k":"thick_atmosphere_of_n2_ch4_lakes_of_li","v":{"s":"Thick atmosphere of N2 + CH4. Lakes of liquid methane on surface. Water-ammonia ocean below. Life possible but very different."}},{"k":"ganymede_jupiter","v":{"s":"Ganymede (Jupiter)"}},{"k":"largest_moon_subsurface_ocean_confirme","v":{"s":"Largest moon. Subsurface ocean confirmed by Hubble. JUICE mission will study it."}},{"k":"callisto_jupiter","v":{"s":"Callisto (Jupiter)"}},{"k":"oldest_visible_surface_in_solar_system","v":{"s":"Oldest visible surface in solar system. Possible subsurface ocean. Lower radiation than other Jovian moons."}},{"k":"io_jupiter","v":{"s":"Io (Jupiter)"}},{"k":"most_volcanically_active_body_in_solar","v":{"s":"Most volcanically active body in solar system. 400+ active volcanoes. Sulfur dioxide atmosphere. Not habitable."}},{"k":"mars_terraforming_lab","v":{"s":"🌱 Mars Terraforming Lab"}},{"k":"what_would_it_take_to_make_mars_liveab","v":{"s":"What would it take to make Mars liveable? Adjust greenhouse gas, ice melt, and plant cover — watch Mars transform."}},{"k":"co_release_greenhouse","v":{"s":"CO₂ release (greenhouse)"}},{"k":"polar_ice_melt","v":{"s":"Polar ice melt"}},{"k":"plant_cover","v":{"s":"Plant cover"}},{"k":"terraforming_mars_would_take_thousands","v":{"s":"Terraforming Mars would take thousands of years. Need to: thicken atmosphere (greenhouse gases), warm surface (melts ice), introduce plants (oxygen). NASA studies suggest current Mars CO2 reserves are too thin to terraform without huge imports. Still mostly science fiction."}},{"k":"hubble_deep_field","v":{"s":"🔬 Hubble Deep Field"}},{"k":"hubble_stared_at_an_empty_patch_of_sky","v":{"s":"Hubble stared at an empty patch of sky for 10 days and found 3000 distant galaxies. Look closer + each fuzzy blob is a galaxy."}},{"k":"hubble_deep_field_simulated","v":{"s":"Hubble Deep Field (simulated)"}},{"k":"each_fuzzy_blob_is_a_galaxy_of_100_bil","v":{"s":"Each fuzzy blob is a galaxy of 100+ billion stars"}},{"k":"zoom","v":{"s":"Zoom"}},{"k":"in_1995_hubble_pointed_at_a_tiny_dark_","v":{"s":"In 1995, Hubble pointed at a tiny dark patch of sky for 10 days. Result: 3000 distant galaxies in one image. JWST has now pushed this deeper, finding galaxies just 300 million years after the Big Bang."}},{"k":"star_color_temperature","v":{"s":"🌟 Star Color + Temperature"}},{"k":"hotter_stars_look_bluer_cooler_stars_r","v":{"s":"Hotter stars look bluer; cooler stars redder. Stars are classified OBAFGKM by spectral type."}},{"k":"red_dwarf_coolest_most_common_stars_75","v":{"s":"Red dwarf — coolest + most common stars (75% of all stars)"}},{"k":"orange_dwarf_quieter_than_sun_longer_l","v":{"s":"Orange dwarf — quieter than Sun, longer-lived"}},{"k":"yellow_sun_like","v":{"s":"Yellow (Sun-like)"}},{"k":"white_sirius_vega","v":{"s":"White (Sirius, Vega)"}},{"k":"blue_white_rigel","v":{"s":"Blue-white (Rigel)"}},{"k":"blue_hottest_rarest_stars_lifespans_on","v":{"s":"Blue — hottest + rarest stars, lifespans only millions of years"}},{"k":"temperature","v":{"s":"Temperature"}},{"k":"star_color_temperature_astronomy_mnemo","v":{"s":"Star color = temperature. Astronomy mnemonic for the OBAFGKM spectral sequence (hottest to coolest): 'Oh Be A Fine Girl/Guy, Kiss Me.' Hotter stars are bigger + brighter + shorter-lived."}},{"k":"tidal_locking_simulator","v":{"s":"🔒 Tidal Locking Simulator"}},{"k":"why_does_the_moon_always_show_the_same","v":{"s":"Why does the Moon always show the same face? Tidal forces slowed its rotation. See how distance + mass affect time-to-lock."}},{"k":"planet_2","v":{"s":"Planet"}},{"k":"distance","v":{"s":"Distance"}},{"k":"planet_mass","v":{"s":"Planet mass"}},{"k":"tidal_forces_gradually_slow_a_moon_s_r","v":{"s":"Tidal forces gradually slow a moon's rotation until it matches its orbital period. Our Moon is tidally locked: same face always toward Earth. Mercury is in a 3:2 resonance with the Sun (not quite locked)."}},{"k":"crater_counter","v":{"s":"🌑 Crater Counter"}},{"k":"click_each_crater_real_planetary_scien","v":{"s":"Click each crater. Real planetary scientists count craters to age surfaces — more craters = older."}},{"k":"click_craters_to_count_them","v":{"s":"🔍 Click craters to count them"}},{"k":"reset_3","v":{"s":"Reset"}},{"k":"crater_counting_is_how_scientists_dete","v":{"s":"Crater counting is how scientists determine the age of planetary surfaces. More craters = older surface. The Moon's highlands are heavily cratered (very old); maria are younger lava flows."}},{"k":"gravity_well_visualizer","v":{"s":"⚖ Gravity Well Visualizer"}},{"k":"mass_curves_spacetime_drag_mass_watch_","v":{"s":"Mass curves spacetime. Drag mass + watch the well deepen. Roll the ball to see how it falls in."}},{"k":"mass_2","v":{"s":"Mass"}},{"k":"ball_position","v":{"s":"Ball position"}},{"k":"einstein_s_general_relativity_says_mas","v":{"s":"Einstein's general relativity says mass curves spacetime. Objects don't feel a force — they follow geodesics through the curved geometry. This is gravity. Black holes curve spacetime so steeply that not even light escapes."}},{"k":"asteroid_composition","v":{"s":"🪨 Asteroid Composition"}},{"k":"three_main_asteroid_types_c_s_m_mining","v":{"s":"Three main asteroid types: C, S, M. Mining companies eye M-type for iron + platinum."}},{"k":"c_type_carbonaceous","v":{"s":"C-type (Carbonaceous)"}},{"k":"most_common_75_dark_primitive_water_ri","v":{"s":"Most common (75%). Dark, primitive, water-rich. Found in outer belt."}},{"k":"s_type_silicaceous","v":{"s":"S-type (Silicaceous)"}},{"k":"stony_17_lighter_made_of_silicate_mine","v":{"s":"Stony (17%). Lighter, made of silicate minerals + iron. Found in inner belt."}},{"k":"m_type_metallic","v":{"s":"M-type (Metallic)"}},{"k":"metal_rich_8_mostly_iron_nickel_possib","v":{"s":"Metal-rich (8%). Mostly iron + nickel. Possibly from core of broken protoplanets. Mining target."}},{"k":"cosmic_microwave_background","v":{"s":"📡 Cosmic Microwave Background"}},{"k":"light_from_380_000_years_after_the_big","v":{"s":"Light from 380,000 years after the Big Bang. Tiny variations are the seeds of every galaxy."}},{"k":"cosmic_microwave_background_simulated","v":{"s":"Cosmic Microwave Background (simulated)"}},{"k":"temperature_fluctuations_of_0_0001_see","v":{"s":"Temperature fluctuations of 0.0001% — seeds of all structure"}},{"k":"contrast","v":{"s":"Contrast"}},{"k":"the_cmb_is_leftover_light_from_380_000","v":{"s":"The CMB is leftover light from 380,000 years after the Big Bang. Tiny temperature variations show where matter was slightly denser. Those denser spots grew into all galaxies + stars we see today. Discovered accidentally by Penzias + Wilson (1965 Nobel Prize)."}},{"k":"saturn_ring_composer","v":{"s":"🪐 Saturn Ring Composer"}},{"k":"saturn_s_rings_are_99_water_ice_in_tri","v":{"s":"Saturn's rings are 99% water ice in trillions of pieces. They might be just 100 million years old."}},{"k":"saturn_s_rings","v":{"s":"Saturn's Rings"}},{"k":"ice_fraction","v":{"s":"Ice fraction"}},{"k":"ring_density","v":{"s":"Ring density"}},{"k":"saturn_s_rings_are_mostly_water_ice_pa","v":{"s":"Saturn's rings are mostly water ice particles ranging from dust grains to house-sized chunks. They span 282,000 km but are < 1 km thick. Likely formed from a destroyed moon ~100 million years ago — relatively young!"}},{"k":"custom_planet_builder","v":{"s":"🪐 Custom Planet Builder"}},{"k":"pick_a_core_surface_atmosphere_and_lif","v":{"s":"Pick a core, surface, atmosphere, and life. See what kind of world you've made."}},{"k":"your_world","v":{"s":"Your World"}},{"k":"add_life","v":{"s":"Add life"}},{"k":"pulsar_beam_sweeper","v":{"s":"📡 Pulsar Beam Sweeper"}},{"k":"pulsars_are_spinning_neutron_stars_wit","v":{"s":"Pulsars are spinning neutron stars with magnetic beams. Earth sees a pulse only when a beam sweeps by."}},{"k":"neutron_star_pulsar","v":{"s":"Neutron Star Pulsar"}},{"k":"spin_angle","v":{"s":"Spin angle"}},{"k":"axis_tilt","v":{"s":"Axis tilt"}},{"k":"a_pulsar_is_a_rapidly_rotating_neutron","v":{"s":"A pulsar is a rapidly rotating neutron star. Its magnetic poles emit beams of radiation. We see a pulse only when the beam sweeps past us — like a lighthouse. Some pulse 700 times per second. Jocelyn Bell Burnell discovered the first in 1967."}},{"k":"solar_wind_streamer","v":{"s":"💨 Solar Wind Streamer"}},{"k":"stream_of_charged_particles_from_sun_h","v":{"s":"Stream of charged particles from Sun, hitting Earth. Stronger wind = more auroras + GPS disruption."}},{"k":"earth_13","v":{"s":"Earth"}},{"k":"wind_speed","v":{"s":"Wind speed"}},{"k":"density","v":{"s":"Density"}},{"k":"solar_wind_is_a_stream_of_charged_part","v":{"s":"Solar wind is a stream of charged particles (mostly protons + electrons) constantly flowing from the Sun. Speed varies 250-800 km/s. Strong storms cause auroras + can disrupt GPS + power grids. Carrington 1859 event: telegraphs sparked + caught fire."}},{"k":"iss_orbital_position","v":{"s":"🛰 ISS Orbital Position"}},{"k":"the_iss_orbits_earth_every_90_minutes_","v":{"s":"The ISS orbits Earth every 90 minutes. Sometimes in daylight, sometimes in Earth's shadow."}},{"k":"orbit_3","v":{"s":"Orbit"}},{"k":"the_iss_orbits_400_km_up_at_17_500_mph","v":{"s":"The ISS orbits 400 km up at 17,500 mph (28,000 km/h). It completes one orbit every 90 minutes — so astronauts see 16 sunrises + sunsets per day. ISS is the largest object humans have built in space."}},{"k":"voyager_position_tracker","v":{"s":"🚀 Voyager Position Tracker"}},{"k":"voyager_1_2_launched_1977_they_are_now","v":{"s":"Voyager 1 + 2 launched 1977. They are now in interstellar space — both crossed the heliopause this decade."}},{"k":"year","v":{"s":"Year"}},{"k":"voyagers_1_2_launched_1977_to_study_ou","v":{"s":"Voyagers 1 + 2 launched 1977 to study outer planets. Both crossed the heliopause (boundary of solar wind) in 2012 + 2018 — now in interstellar space. Each carries Golden Record with greetings + music for any aliens who find them."}},{"k":"mercury_transit","v":{"s":"🌑 Mercury Transit"}},{"k":"mercury_passes_in_front_of_the_sun_eve","v":{"s":"Mercury passes in front of the Sun every few years. Watch it cross — but only with a proper solar filter."}},{"k":"watch_with_proper_solar_filter_only_ne","v":{"s":"Watch with PROPER solar filter only — NEVER look directly!"}},{"k":"time_3","v":{"s":"Time"}},{"k":"a_transit_happens_when_mercury_or_venu","v":{"s":"A transit happens when Mercury (or Venus) passes between Earth + the Sun. It looks like a small black dot on the Sun. Next Mercury transit: November 13, 2032. Next Venus transit: December 2117 — won't happen again until 2125."}},{"k":"foucault_pendulum","v":{"s":"🎯 Foucault Pendulum"}},{"k":"l_on_foucault_1851_proved_earth_rotate","v":{"s":"Léon Foucault 1851 proved Earth rotates with a giant pendulum. Its swing-plane rotates faster at the poles."}},{"k":"foucault_pendulum_2","v":{"s":"Foucault Pendulum"}},{"k":"latitude_3","v":{"s":"Latitude"}},{"k":"hours_elapsed","v":{"s":"Hours elapsed"}},{"k":"l_on_foucault_1851_demonstrated_earth_","v":{"s":"Léon Foucault 1851 demonstrated Earth's rotation with a giant pendulum. Its swing plane appears to rotate because Earth turns under it. At the poles: 24 hours. At equator: never. In Maine: ~34 hours."}},{"k":"saturn_hexagon","v":{"s":"⬡ Saturn Hexagon"}},{"k":"saturn_s_north_pole_has_a_perfect_hexa","v":{"s":"Saturn's north pole has a perfect hexagonal storm 30,000 km wide. Discovered by Voyager 1981."}},{"k":"saturn_s_hexagonal_pole_storm","v":{"s":"Saturn's Hexagonal Pole Storm"}},{"k":"persistent_feature_30_000_km_wide_5_ea","v":{"s":"Persistent feature 30,000 km wide — 5× Earth diameter"}},{"k":"rotation","v":{"s":"Rotation"}},{"k":"saturn_has_a_perfect_hexagonal_storm_a","v":{"s":"Saturn has a perfect hexagonal storm at its north pole — first imaged by Voyager (1981), confirmed by Cassini. The hexagon is 30,000 km wide and persistent. Why hexagonal? Atmospheric jet stream pattern + Rossby waves."}},{"k":"sundial_demo","v":{"s":"🕰 Sundial Demo"}},{"k":"the_original_clock_as_the_sun_arcs_acr","v":{"s":"The original clock. As the Sun arcs across the sky, the gnomon casts a rotating shadow that marks the hours."}},{"k":"hour","v":{"s":"Hour"}},{"k":"sundials_predate_clocks_by_millennia_a","v":{"s":"Sundials predate clocks by millennia. As Sun moves across sky, the gnomon's shadow rotates. Ancient Egyptians, Greeks, Romans, Chinese all built precise sundials. Modern ones must correct for daylight saving time + equation of time."}},{"k":"local_group_map","v":{"s":"🌐 Local Group Map"}},{"k":"80_galaxies_span_10_million_light_year","v":{"s":"80 galaxies span 10 million light-years around us. Milky Way + Andromeda will collide in 4 billion years."}},{"k":"milky_way","v":{"s":"Milky Way"}},{"k":"our_home_galaxy","v":{"s":"Our home galaxy"}},{"k":"andromeda_m31","v":{"s":"Andromeda (M31)"}},{"k":"2_5_mly_away_heading_toward_us","v":{"s":"2.5 Mly away — heading toward us!"}},{"k":"triangulum_m33","v":{"s":"Triangulum (M33)"}},{"k":"2_7_mly_away","v":{"s":"2.7 Mly away"}},{"k":"large_magellanic_cloud","v":{"s":"Large Magellanic Cloud"}},{"k":"160k_ly_satellite_of_milky_way","v":{"s":"160k ly — satellite of Milky Way"}},{"k":"small_magellanic_cloud","v":{"s":"Small Magellanic Cloud"}},{"k":"200k_ly_satellite","v":{"s":"200k ly — satellite"}},{"k":"canis_major_dwarf","v":{"s":"Canis Major Dwarf"}},{"k":"25k_ly_closest_to_mw","v":{"s":"25k ly — closest to MW"}},{"k":"sagittarius_dwarf","v":{"s":"Sagittarius Dwarf"}},{"k":"70k_ly_being_torn_apart","v":{"s":"70k ly — being torn apart"}},{"k":"ursa_minor_dwarf","v":{"s":"Ursa Minor Dwarf"}},{"k":"200k_ly","v":{"s":"200k ly"}},{"k":"sculptor_dwarf","v":{"s":"Sculptor Dwarf"}},{"k":"290k_ly","v":{"s":"290k ly"}},{"k":"ic_10","v":{"s":"IC 10"}},{"k":"2_2_mly_small_spiral","v":{"s":"2.2 Mly — small spiral"}},{"k":"local_group_80_galaxies_in_10_million_","v":{"s":"Local Group — ~80 galaxies in 10 million light-years"}},{"k":"our_local_group_has_80_galaxies_domina","v":{"s":"Our Local Group has ~80 galaxies dominated by Milky Way + Andromeda. Andromeda is approaching at 110 km/s — collision expected in 4 billion years. Result: Milkomeda mega-galaxy."}},{"k":"asteroid_impact_outcomes","v":{"s":"☄ Asteroid Impact Outcomes"}},{"k":"what_size_asteroid_kills_which_level_o","v":{"s":"What size asteroid kills which level of life? Compare from pebble to dinosaur-killer."}},{"k":"size_m","v":{"s":"Size (m)"}},{"k":"atmospheric_entry_destroys_most_rocks_","v":{"s":"Atmospheric entry destroys most rocks < 5m. Chelyabinsk 2013 (20m) shattered windows but no crater. Tunguska 1908 (50m) flattened 2000km² of forest. Chicxulub 66Ma (10km) killed the dinosaurs."}},{"k":"coronal_mass_ejection","v":{"s":"⚡ Coronal Mass Ejection"}},{"k":"a_cme_blasts_billions_of_tons_of_plasm","v":{"s":"A CME blasts billions of tons of plasma from Sun. Days later, it can cause spectacular auroras + GPS failures."}},{"k":"earth_14","v":{"s":"Earth"}},{"k":"aurora","v":{"s":"⚡ AURORA!"}},{"k":"time_after_launch","v":{"s":"Time after launch"}},{"k":"cme_size","v":{"s":"CME size"}},{"k":"a_coronal_mass_ejection_blasts_billion","v":{"s":"A Coronal Mass Ejection blasts billions of tons of plasma into space at 1-2 million mph. Takes 1-5 days to reach Earth. Strong CMEs cause geomagnetic storms, vivid auroras, and can disrupt satellites + power grids."}},{"k":"cepheid_variable_star","v":{"s":"💫 Cepheid Variable Star"}},{"k":"cepheids_pulse_on_a_regular_cycle_thei","v":{"s":"Cepheids pulse on a regular cycle. Their period reveals their true brightness — a cosmic ruler."}},{"k":"cepheid_variable_star_2","v":{"s":"Cepheid Variable Star"}},{"k":"time_days","v":{"s":"Time (days)"}},{"k":"period_2","v":{"s":"Period"}},{"k":"cepheid_variables_pulse_on_a_regular_c","v":{"s":"Cepheid variables pulse on a regular cycle. Their period directly correlates with their intrinsic brightness (Henrietta Leavitt 1908). Astronomers measure the period + use it to determine true luminosity + distance."}},{"k":"comet_orbit_drawer","v":{"s":"☄ Comet Orbit Drawer"}},{"k":"orbits_range_from_circles_to_long_elli","v":{"s":"Orbits range from circles to long ellipses. Adjust eccentricity to draw planet-like or comet-like paths."}},{"k":"perihelion_2","v":{"s":"Perihelion"}},{"k":"aphelion_2","v":{"s":"Aphelion"}},{"k":"eccentricity_2","v":{"s":"Eccentricity"}},{"k":"orbital_eccentricity_goes_from_0_perfe","v":{"s":"Orbital eccentricity goes from 0 (perfect circle) to 1 (parabolic escape). Planets are nearly circular. Comets are highly elliptical — they sweep close to the Sun + far into the outer system. Hyperbolic orbits (e>1) mean a one-time pass through the solar system."}},{"k":"atmospheric_window","v":{"s":"🌐 Atmospheric Window"}},{"k":"earth_s_atmosphere_blocks_most_wavelen","v":{"s":"Earth's atmosphere blocks most wavelengths. Only visible light + radio waves reach the ground."}},{"k":"earth_ground_level","v":{"s":"Earth ground level"}},{"k":"visible_light_radio_waves_penetrate_th","v":{"s":"✔ Visible light + radio waves penetrate the atmosphere"}},{"k":"earth_atmosphere_blocks_most_wavelengt","v":{"s":"Earth atmosphere blocks most wavelengths. Only visible light + radio waves reach the ground. Why all telescopes for UV/X-ray/gamma rays must be in space: Hubble, JWST, Chandra, Fermi."}},{"k":"star_spectra_comparison","v":{"s":"📊 Star Spectra Comparison"}},{"k":"spectra_reveal_what_stars_are_made_of_","v":{"s":"Spectra reveal what stars are made of + their stage of life."}},{"k":"sun_g2_star","v":{"s":"Sun (G2 star)"}},{"k":"red_giant_2","v":{"s":"Red Giant"}},{"k":"planetary_nebula_2","v":{"s":"Planetary Nebula"}},{"k":"supernova_2","v":{"s":"Supernova"}},{"k":"hydrogen_2","v":{"s":"🔴 Hydrogen"}},{"k":"helium_2","v":{"s":"🟡 Helium"}},{"k":"heavier","v":{"s":"🔵 Heavier"}},{"k":"different_stages_of_stellar_life_show_","v":{"s":"Different stages of stellar life show different spectra. The Sun is hydrogen-dominated. Red giants have more helium (hydrogen consumed). Supernovae show heavy elements (made in last fusion stages + the explosion itself)."}},{"k":"time_zone_visualizer","v":{"s":"🕐 Time Zone Visualizer"}},{"k":"earth_rotates_15_per_hour_watch_when_i","v":{"s":"Earth rotates 15° per hour. Watch when it's noon in Tokyo, when sunrise hits Portland."}},{"k":"tokyo","v":{"s":"Tokyo"}},{"k":"beijing","v":{"s":"Beijing"}},{"k":"mumbai","v":{"s":"Mumbai"}},{"k":"cairo","v":{"s":"Cairo"}},{"k":"london","v":{"s":"London"}},{"k":"sao_paulo","v":{"s":"Sao Paulo"}},{"k":"new_york","v":{"s":"New York"}},{"k":"portland","v":{"s":"Portland"}},{"k":"utc_hour","v":{"s":"UTC Hour"}},{"k":"earth_rotates_15_per_hour_utc_coordina","v":{"s":"Earth rotates 15° per hour. UTC (Coordinated Universal Time) is the global reference. Time zones offset by ±hours. Portland Maine is UTC-5 (EST) or UTC-4 (EDT). Globally, half of Earth is daylit while half is night."}},{"k":"mind_blowing_facts_gallery","v":{"s":"💡 Mind-Blowing Facts Gallery"}},{"k":"click_through_12_astronomy_facts_that_","v":{"s":"Click through 12 astronomy facts that defy intuition."}},{"k":"previous","v":{"s":"← Previous"}},{"k":"next_3","v":{"s":"Next →"}},{"k":"earth_moon_true_scale","v":{"s":"📐 Earth-Moon True Scale"}},{"k":"textbook_diagrams_lie_the_moon_is_much","v":{"s":"Textbook diagrams lie. The Moon is much farther than drawn. See the real scale."}},{"k":"earth_15","v":{"s":"Earth"}},{"k":"moon_4","v":{"s":"Moon"}},{"k":"earth_16","v":{"s":"Earth"}},{"k":"moon_too_big_close","v":{"s":"Moon (too big + close)"}},{"k":"most_textbooks_draw_the_moon_too_big_t","v":{"s":"Most textbooks draw the Moon too big + too close. Truth: Moon diameter is 1/4 of Earth's, and the distance to the Moon is ~30 Earth diameters. Light takes 1.3 seconds to make the trip."}},{"k":"day_length_comparison","v":{"s":"⏰ Day Length Comparison"}},{"k":"jupiter_has_the_shortest_day_10_hr_ven","v":{"s":"Jupiter has the shortest day (10 hr). Venus has the longest (243 Earth days!)."}},{"k":"jupiter_7","v":{"s":"Jupiter"}},{"k":"saturn_3","v":{"s":"Saturn"}},{"k":"neptune_4","v":{"s":"Neptune"}},{"k":"uranus_3","v":{"s":"Uranus"}},{"k":"earth_17","v":{"s":"Earth"}},{"k":"mars_6","v":{"s":"Mars"}},{"k":"mercury_5","v":{"s":"Mercury"}},{"k":"venus_5","v":{"s":"Venus"}},{"k":"day_length_across_the_solar_system_log","v":{"s":"Day length across the Solar System (log scale)"}},{"k":"jupiter_spins_fast_venus_rotates_slowe","v":{"s":"Jupiter spins fast. Venus rotates slower than its year."}},{"k":"gas_giants_spin_fast_because_of_how_th","v":{"s":"Gas giants spin fast because of how they formed. Venus rotates slowest, possibly due to a tidal lock with Sun + thick atmosphere drag. Earth slows down by ~1.7 milliseconds per century due to Moon's gravity."}},{"k":"eclipse_path_maker","v":{"s":"🗺 Eclipse Path Maker"}},{"k":"total_eclipses_cover_narrow_strips_the","v":{"s":"Total eclipses cover narrow strips. The 2024 eclipse path crossed northern Maine."}},{"k":"april_8_2024_total_solar_eclipse_path","v":{"s":"April 8, 2024 Total Solar Eclipse path"}},{"k":"latitude_4","v":{"s":"Latitude"}},{"k":"longitude","v":{"s":"Longitude"}},{"k":"total_solar_eclipses_only_happen_along","v":{"s":"Total solar eclipses only happen along narrow paths ~100-150 km wide. April 8, 2024 eclipse crossed northern Maine — many Mainers traveled north for totality. Next total eclipse in Maine: not for centuries!"}},{"k":"cosmic_calendar","v":{"s":"📅 Cosmic Calendar"}},{"k":"sagan_s_cosmic_calendar_13_8_billion_y","v":{"s":"Sagan's Cosmic Calendar: 13.8 billion years in one year. Humans arrive in the last second."}},{"k":"13_8_billion_years_ago","v":{"s":"13.8 billion years ago"}},{"k":"10_billion_years_ago","v":{"s":"~10 billion years ago"}},{"k":"8_billion_years_ago","v":{"s":"~8 billion years ago"}},{"k":"4_6_billion_years_ago","v":{"s":"4.6 billion years ago"}},{"k":"4_billion_years_ago","v":{"s":"~4 billion years ago"}},{"k":"600_million_years_ago","v":{"s":"~600 million years ago"}},{"k":"470_million_years_ago","v":{"s":"~470 million years ago"}},{"k":"250_million_years_ago","v":{"s":"~250 million years ago"}},{"k":"66_million_years_ago","v":{"s":"~66 million years ago"}},{"k":"50_million_years_ago","v":{"s":"~50 million years ago"}},{"k":"200_000_years_ago","v":{"s":"~200,000 years ago"}},{"k":"5_000_years_ago","v":{"s":"~5,000 years ago"}},{"k":"200_years_ago","v":{"s":"~200 years ago"}},{"k":"earlier","v":{"s":"← Earlier"}},{"k":"later","v":{"s":"Later →"}},{"k":"carl_sagan_s_cosmic_calendar_compresse","v":{"s":"Carl Sagan's Cosmic Calendar: compresses 13.8 billion years into 1 year. Big Bang = Jan 1. Now = Dec 31 midnight. Humans appeared in the last seconds. Civilizations exist in the last fraction of a second."}},{"k":"drake_equation_calculator","v":{"s":"👽 Drake Equation Calculator"}},{"k":"how_many_alien_civilizations_adjust_ea","v":{"s":"How many alien civilizations? Adjust each unknown factor + see the answer."}},{"k":"in_our_milky_way_galaxy_at_any_time","v":{"s":"in our Milky Way Galaxy at any time"}},{"k":"r_star_formation_rate","v":{"s":"R: Star formation rate"}},{"k":"fp_fraction_w_planets","v":{"s":"fp: Fraction w/ planets"}},{"k":"ne_habitable_per_system","v":{"s":"ne: # habitable per system"}},{"k":"fl_fraction_with_life","v":{"s":"fl: Fraction with life"}},{"k":"fi_intelligent_life","v":{"s":"fi: Intelligent life"}},{"k":"fc_communicating","v":{"s":"fc: Communicating"}},{"k":"l_lifespan_years","v":{"s":"L: Lifespan (years)"}},{"k":"frank_drake_1961_estimating_other_civi","v":{"s":"Frank Drake 1961: estimating other civilizations. Most factors are unknown — answers from <1 (alone) to millions. Reveals what we don't know more than gives an answer. Adjust the sliders to see how sensitive the result is."}},{"k":"world_telescopes_catalog","v":{"s":"🔭 World Telescopes Catalog"}},{"k":"dozen_biggest_best_telescopes_hubble_j","v":{"s":"Dozen biggest + best telescopes: Hubble, JWST, Keck, VLT, ALMA, and what they observe."}},{"k":"hubble_space_telescope","v":{"s":"Hubble Space Telescope"}},{"k":"optical_uv_ir_space_telescope_30_year_","v":{"s":"Optical/UV/IR space telescope. 30+ year service."}},{"k":"james_webb_jwst","v":{"s":"James Webb (JWST)"}},{"k":"infrared_space_telescope_at_l2_lagrang","v":{"s":"Infrared space telescope. At L2 Lagrange point."}},{"k":"keck_i_ii","v":{"s":"Keck I + II"}},{"k":"twin_10m_telescopes_on_mauna_kea_hawai","v":{"s":"Twin 10m telescopes on Mauna Kea, Hawaii."}},{"k":"very_large_telescope_vlt","v":{"s":"Very Large Telescope (VLT)"}},{"k":"eso_chile_four_8_2m_telescopes","v":{"s":"ESO Chile, four 8.2m telescopes."}},{"k":"gemini_north_south","v":{"s":"Gemini North + South"}},{"k":"twin_8m_mauna_kea_cerro_pach_n","v":{"s":"Twin 8m: Mauna Kea + Cerro Pachón."}},{"k":"atacama_large_millimeter_array","v":{"s":"Atacama Large Millimeter Array"}},{"k":"66_antenna_radio_array_chilean_desert","v":{"s":"66-antenna radio array, Chilean desert."}},{"k":"hubble_in_space","v":{"s":"Hubble (in space)"}},{"k":"optical_uv_ir_space_telescope_still_op","v":{"s":"Optical/UV/IR space telescope. Still operating."}},{"k":"chandra_x_ray_observatory","v":{"s":"Chandra X-ray Observatory"}},{"k":"nasa_x_ray_space_telescope","v":{"s":"NASA X-ray space telescope."}},{"k":"spitzer_space_telescope","v":{"s":"Spitzer Space Telescope"}},{"k":"infrared_space_telescope_retired_2020","v":{"s":"Infrared space telescope, retired 2020."}},{"k":"subaru","v":{"s":"Subaru"}},{"k":"japanese_8_2m_on_mauna_kea","v":{"s":"Japanese 8.2m on Mauna Kea."}},{"k":"square_kilometre_array","v":{"s":"Square Kilometre Array"}},{"k":"future_radio_telescope_australia_s_afr","v":{"s":"Future radio telescope, Australia + S Africa."}},{"k":"extremely_large_telescope","v":{"s":"Extremely Large Telescope"}},{"k":"coming_39m_eso_telescope_chile","v":{"s":"Coming 39m ESO telescope. Chile."}},{"k":"a_dozen_of_the_world_s_most_powerful_t","v":{"s":"A dozen of the world's most powerful telescopes. Aperture (mm) is the diameter of the primary mirror. Bigger aperture = more light + finer detail. Space telescopes avoid atmospheric distortion."}},{"k":"star_lifespan_calculator","v":{"s":"⏳ Star Lifespan Calculator"}},{"k":"massive_stars_live_fast_die_young_adju","v":{"s":"Massive stars live fast + die young. Adjust mass + see how long the star burns."}},{"k":"mass_3","v":{"s":"Mass"}},{"k":"massive_stars_burn_fuel_fast_lifespan_","v":{"s":"Massive stars burn fuel fast. Lifespan ∝ M^-2.5. Sun: 10 Gyr (we are halfway). 10 M☉: only 30 Myr. 0.1 M☉ red dwarf: trillions of years."}},{"k":"your_cosmic_journey","v":{"s":"🎯 Your Cosmic Journey"}},{"k":"track_your_progress_planets_explored_p","v":{"s":"Track your progress: planets explored, points earned, missions logged."}},{"k":"planets_explored","v":{"s":"🌍 Planets explored"}},{"k":"research_points","v":{"s":"⭐ Research Points"}},{"k":"missions_logged","v":{"s":"🛰 Missions logged"}},{"k":"vocab_looked_up","v":{"s":"📚 Vocab looked up"}},{"k":"this_tool_features_35_interactive_mini","v":{"s":"This tool features 35+ interactive mini-tools spanning astronomy, physics, and exploration. From simulating black holes to flying lunar landers, you can explore the Solar System and beyond."}},{"k":"astronomy_hall_of_fame","v":{"s":"👨‍🚀 Astronomy Hall of Fame"}},{"k":"16_milestones_from_ancient_greek_astro","v":{"s":"16 milestones from ancient Greek astronomy to JWST. Names you should know."}},{"k":"aristarchus","v":{"s":"Aristarchus"}},{"k":"ptolemy","v":{"s":"Ptolemy"}},{"k":"copernicus","v":{"s":"Copernicus"}},{"k":"galileo_2","v":{"s":"Galileo"}},{"k":"kepler","v":{"s":"Kepler"}},{"k":"newton","v":{"s":"Newton"}},{"k":"herschel","v":{"s":"Herschel"}},{"k":"galle_le_verrier","v":{"s":"Galle + Le Verrier"}},{"k":"hubble","v":{"s":"Hubble"}},{"k":"hubble_2","v":{"s":"Hubble"}},{"k":"apollo_11","v":{"s":"Apollo 11"}},{"k":"voyager_1_2","v":{"s":"Voyager 1"}},{"k":"nasa_esa_csa","v":{"s":"NASA + ESA + CSA"}},{"k":"a_2300_year_journey_from_aristarchus_t","v":{"s":"A 2300-year journey from Aristarchus to JWST. Each discovery built on the last. Science is a relay race — every astronomer stands on the shoulders of those before them."}},{"k":"obafgkm_spectral_classes","v":{"s":"⭐ OBAFGKM Spectral Classes"}},{"k":"click_each_spectral_class_to_see_its_t","v":{"s":"Click each spectral class to see its temperature, color, and example stars."}},{"k":"obafgkm_oh_be_a_fine_guy_girl_kiss_me_","v":{"s":"OBAFGKM — \"Oh Be A Fine Guy/Girl, Kiss Me!\" Hottest to coolest. O stars: massive, blue, brief. M stars: tiny, red, eternal. Sun is G2V — yellow main sequence dwarf."}},{"k":"mars_vs_earth_atmosphere","v":{"s":"🌐 Mars vs Earth Atmosphere"}},{"k":"mars_has_100_thinner_air_made_of_mostl","v":{"s":"Mars has 100× thinner air made of mostly CO₂. Compare gas composition + pressure."}},{"k":"earth_18","v":{"s":"Earth"}},{"k":"mars_7","v":{"s":"Mars"}},{"k":"mars_atmosphere_is_100_thinner_than_ea","v":{"s":"Mars atmosphere is 100× thinner than Earth's. Composition: 95% CO₂. To breathe on Mars you would need oxygen + pressure 100× more. Almost no nitrogen for fertilization."}},{"k":"black_hole_vocabulary","v":{"s":"🕳 Black Hole Vocabulary"}},{"k":"10_essential_black_hole_terms_event_ho","v":{"s":"10 essential black hole terms: event horizon, singularity, spaghettification, Hawking radiation."}},{"k":"event_horizon_telescope_captured_first","v":{"s":"Event Horizon Telescope captured first image of M87* black hole (2019) + Sgr A* (2022). The orange ring = light bent around a black sphere where light cannot escape."}},{"k":"auroras_across_solar_system","v":{"s":"🌈 Auroras Across Solar System"}},{"k":"five_planets_have_auroras_earth_s_is_g","v":{"s":"Five planets have auroras. Earth's is green/red, Jupiter's is the most powerful, Mars's is diffuse."}},{"k":"earth_aurora","v":{"s":"Earth aurora"}},{"k":"green_oxygen_red_atomic_o_blue_nitroge","v":{"s":"Green (oxygen) + red (atomic O) + blue (nitrogen). Best seen near magnetic poles."}},{"k":"jupiter_aurora","v":{"s":"Jupiter aurora"}},{"k":"most_powerful_in_solar_system_driven_b","v":{"s":"Most powerful in solar system. Driven by Io's volcanism + Jupiter's magnetic field. Permanent UV aurora."}},{"k":"saturn_aurora","v":{"s":"Saturn aurora"}},{"k":"powered_by_solar_wind_less_colorful_th","v":{"s":"Powered by solar wind. Less colorful than Earth's but huge. Lasts days at a time."}},{"k":"uranus_aurora","v":{"s":"Uranus aurora"}},{"k":"strange_orientation_due_to_98_axial_ti","v":{"s":"Strange orientation due to 98° axial tilt. Hard to image."}},{"k":"mars_diffuse_aurora","v":{"s":"Mars (diffuse aurora)"}},{"k":"weak_no_global_magnetic_field_auroras_","v":{"s":"Weak — no global magnetic field. Auroras around remnant crustal magnetic anomalies."}},{"k":"famous_space_missions","v":{"s":"🚀 Famous Space Missions"}},{"k":"10_missions_that_defined_planetary_exp","v":{"s":"10 missions that defined planetary exploration. From Apollo to Cassini to JWST."}},{"k":"apollo_11_2","v":{"s":"Apollo 11"}},{"k":"first_humans_walk_on_moon","v":{"s":"First humans walk on Moon"}},{"k":"voyager_1_2_2","v":{"s":"Voyager 1+2"}},{"k":"grand_tour_golden_records","v":{"s":"Grand tour + Golden Records"}},{"k":"viking_1_2","v":{"s":"Viking 1+2"}},{"k":"first_mars_landers_life_experiments","v":{"s":"First Mars landers + life experiments"}},{"k":"20_years_of_saturn_titan_exploration","v":{"s":"20 years of Saturn + Titan exploration"}},{"k":"mars_curiosity","v":{"s":"Mars Curiosity"}},{"k":"nuclear_powered_rover_still_active","v":{"s":"Nuclear-powered rover, still active"}},{"k":"new_horizons_2","v":{"s":"New Horizons"}},{"k":"first_close_up_of_pluto_arrokoth","v":{"s":"First close-up of Pluto + Arrokoth"}},{"k":"sample_return_from_asteroid","v":{"s":"Sample return from asteroid"}},{"k":"first_planetary_defense_test","v":{"s":"First planetary defense test"}},{"k":"perseverance_ingenuity","v":{"s":"Perseverance + Ingenuity"}},{"k":"rover_first_mars_helicopter","v":{"s":"Rover + first Mars helicopter"}},{"k":"replaced_hubble_for_infrared_deep_fiel","v":{"s":"Replaced Hubble for infrared deep field"}},{"k":"star_magnitude_scale","v":{"s":"✨ Star Magnitude Scale"}},{"k":"brightness_counts_backward_smaller_bri","v":{"s":"Brightness counts backward: smaller = brighter. Visible range spans 60 magnitudes."}},{"k":"moon_full","v":{"s":"Moon (full)"}},{"k":"venus_max","v":{"s":"Venus (max)"}},{"k":"jupiter_8","v":{"s":"Jupiter"}},{"k":"sirius_2","v":{"s":"Sirius"}},{"k":"canopus","v":{"s":"Canopus"}},{"k":"arcturus","v":{"s":"Arcturus"}},{"k":"vega_2","v":{"s":"Vega"}},{"k":"polaris_north_star","v":{"s":"Polaris (North Star)"}},{"k":"faintest_naked_eye","v":{"s":"Faintest naked-eye"}},{"k":"backyard_scope_limit","v":{"s":"Backyard scope limit"}},{"k":"jwst_limit","v":{"s":"JWST limit"}},{"k":"magnitudes_count_backward_smaller_brig","v":{"s":"Magnitudes count BACKWARD: smaller = brighter. Each step of 5 = 100× brighter. Hipparchus invented in 130 BCE. Sun: -26.7. JWST sees to mag 34. Reach: 100^((34-(-26))/5) ≈ 10^48 times the Sun."}},{"k":"celestial_coordinate_systems","v":{"s":"🧭 Celestial Coordinate Systems"}},{"k":"four_ways_astronomers_describe_positio","v":{"s":"Four ways astronomers describe positions in the sky."}},{"k":"equatorial_ra_dec","v":{"s":"Equatorial (RA/Dec)"}},{"k":"star_fixed_coordinates_right_ascension","v":{"s":"Star-fixed coordinates. Right ascension (h:m:s) + Declination (°). Used in astronomical catalogs."}},{"k":"observer_centered_altitude_above_horiz","v":{"s":"Observer-centered. Altitude (above horizon) + Azimuth (from north). Used to point telescopes."}},{"k":"ecliptic","v":{"s":"Ecliptic"}},{"k":"centered_on_sun_earth_plane_used_for_s","v":{"s":"Centered on Sun-Earth plane. Used for solar system objects."}},{"k":"galactic","v":{"s":"Galactic"}},{"k":"centered_on_milky_way_plane_used_for_g","v":{"s":"Centered on Milky Way plane. Used for galactic studies."}},{"k":"astronomers_use_multiple_coordinate_sy","v":{"s":"Astronomers use multiple coordinate systems. Equatorial is global + objects keep same coords as Earth rotates. Alt-Az changes constantly as Earth rotates. Galactic is best for studying Milky Way structure."}},{"k":"big_numbers_in_astronomy","v":{"s":"🔢 Big Numbers in Astronomy"}},{"k":"from_1_sun_to_10_22_stars_the_scale_of","v":{"s":"From 1 Sun to 10^22 stars. The scale of the universe is staggering."}},{"k":"astronomy_operates_on_absurd_scales_ho","v":{"s":"Astronomy operates on absurd scales. \"How many stars?\" — more than grains of sand on every beach on Earth. \"How old?\" — 13.8 billion years. Yet some quantities (black hole evaporation) are even bigger."}},{"k":"space_debris_tracker","v":{"s":"🛰 Space Debris Tracker"}},{"k":"36_500_objects_orbit_earth_at_various_","v":{"s":"36,500 objects orbit Earth at various altitudes. Move altitude slider to see what's there."}},{"k":"altitude_3","v":{"s":"Altitude"}},{"k":"36_500_tracked_objects_millions_of_fra","v":{"s":"36,500 tracked objects + millions of fragments orbit Earth. Risk of Kessler Syndrome: cascade of collisions makes space unusable. SpaceX Starlink has 5000+ satellites; planning many more."}},{"k":"constellation_mythology","v":{"s":"📜 Constellation Mythology"}},{"k":"every_culture_sees_stories_in_the_star","v":{"s":"Every culture sees stories in the stars. From Greek heroes to Aboriginal Emu in the Sky."}},{"k":"orion_2","v":{"s":"Orion"}},{"k":"ursa_major","v":{"s":"Ursa Major"}},{"k":"cassiopeia_2","v":{"s":"Cassiopeia"}},{"k":"scorpius","v":{"s":"Scorpius"}},{"k":"lyra","v":{"s":"Lyra"}},{"k":"cygnus","v":{"s":"Cygnus"}},{"k":"pleiades","v":{"s":"Pleiades"}},{"k":"crux","v":{"s":"Crux"}},{"k":"previous_2","v":{"s":"← Previous"}},{"k":"next_4","v":{"s":"Next →"}},{"k":"stories_projected_onto_stars_by_cultur","v":{"s":"Stories projected onto stars by cultures worldwide. Aboriginal Australian Emu in the Sky uses dark dust clouds. Polynesian wayfinders use stars to navigate Pacific by memory. Astronomy is also storytelling."}},{"k":"exoplanet_detection_methods","v":{"s":"🔍 Exoplanet Detection Methods"}},{"k":"5_ways_astronomers_find_planets_around","v":{"s":"5 ways astronomers find planets around other stars. Transit + Doppler dominate."}},{"k":"transit_method","v":{"s":"Transit method"}},{"k":"watch_a_star_and_look_for_tiny_brightn","v":{"s":"Watch a star and look for tiny brightness dips when a planet passes in front. Used by Kepler + TESS."}},{"k":"radial_velocity","v":{"s":"Radial velocity"}},{"k":"a_planet_s_gravity_makes_its_star_wobb","v":{"s":"A planet's gravity makes its star wobble. We see the wobble as Doppler shift in starlight."}},{"k":"microlensing","v":{"s":"Microlensing"}},{"k":"gravity_of_a_passing_star_planet_bends","v":{"s":"Gravity of a passing star+planet bends light from a more distant star. Distance-independent."}},{"k":"direct_imaging","v":{"s":"Direct imaging"}},{"k":"block_out_the_star_s_light_photograph_","v":{"s":"Block out the star's light + photograph nearby planets. Only works for big/distant planets so far."}},{"k":"pulsar_timing","v":{"s":"Pulsar timing"}},{"k":"variations_in_pulsar_pulses_reveal_orb","v":{"s":"Variations in pulsar pulses reveal orbiting bodies. First exoplanets found this way (1992)."}},{"k":"first_exoplanet_around_a_sun_like_star","v":{"s":"First exoplanet around a Sun-like star: 51 Pegasi b (1995). Now 5500+ confirmed. JWST is doing atmospheric spectroscopy on exoplanets — searching for biosignatures."}},{"k":"upcoming_eclipses","v":{"s":"🌙 Upcoming Eclipses"}},{"k":"schedule_of_eclipses_2024_2079_maine_s","v":{"s":"Schedule of eclipses 2024-2079. Maine's next total solar eclipse: 2079."}},{"k":"total_solar_eclipses_are_rare_about_2_","v":{"s":"Total solar eclipses are rare. About 2 per year somewhere on Earth, but each visible from only a narrow path. Lunar eclipses are visible across the whole night side."}},{"k":"galaxy_types_gallery","v":{"s":"🌌 Galaxy Types Gallery"}},{"k":"hubble_s_classification_spirals_ellipt","v":{"s":"Hubble's classification: spirals, ellipticals, irregulars + everything between."}},{"k":"spiral_sa","v":{"s":"Spiral (Sa)"}},{"k":"tight_arms_big_central_bulge","v":{"s":"Tight arms, big central bulge"}},{"k":"spiral_sb","v":{"s":"Spiral (Sb)"}},{"k":"moderate_arms","v":{"s":"Moderate arms"}},{"k":"spiral_sc","v":{"s":"Spiral (Sc)"}},{"k":"loose_arms_small_bulge","v":{"s":"Loose arms, small bulge"}},{"k":"barred_spiral_sbb","v":{"s":"Barred Spiral (SBb)"}},{"k":"bar_through_center","v":{"s":"Bar through center"}},{"k":"elliptical_e0","v":{"s":"Elliptical (E0)"}},{"k":"nearly_spherical_old","v":{"s":"Nearly spherical, old"}},{"k":"elliptical_e7","v":{"s":"Elliptical (E7)"}},{"k":"very_flattened","v":{"s":"Very flattened"}},{"k":"lenticular_s0","v":{"s":"Lenticular (S0)"}},{"k":"disk_but_no_arms","v":{"s":"Disk but no arms"}},{"k":"irregular","v":{"s":"Irregular"}},{"k":"no_defined_shape","v":{"s":"No defined shape"}},{"k":"dwarf","v":{"s":"Dwarf"}},{"k":"small_faint","v":{"s":"Small + faint"}},{"k":"starburst","v":{"s":"Starburst"}},{"k":"forming_stars_rapidly","v":{"s":"Forming stars rapidly"}},{"k":"edwin_hubble_classified_galaxies_in_19","v":{"s":"Edwin Hubble classified galaxies in 1936 — \"Hubble tuning fork.\" Spirals + ellipticals + irregulars. Galaxies evolve via mergers — Milky Way is in mid-life, Andromeda merger in 4 billion years."}},{"k":"cosmic_speeds_chart","v":{"s":"⚡ Cosmic Speeds Chart"}},{"k":"from_walking_to_light_speed_log_scale_","v":{"s":"From walking to light speed (log scale). Voyager 1 is fastest human-made object, but still glacial cosmically."}},{"k":"voyager_1_is_the_fastest_object_humans","v":{"s":"Voyager 1 is the fastest object humans have made — yet would take 80,000 years to reach the nearest star. Light makes the same trip in 4 years."}},{"k":"star_forming_region","v":{"s":"✨ Star Forming Region"}},{"k":"watch_stars_form_from_cold_dust_to_hot","v":{"s":"Watch stars form from cold dust to hot suns. 6 stages over a few million years."}},{"k":"stars_are_born_in_clusters_from_giant_","v":{"s":"Stars are born in clusters from giant molecular clouds. Total process: a few million years. Famous examples: Orion Nebula (M42), Eagle Nebula (Pillars of Creation), Tarantula Nebula."}},{"k":"big_cosmic_questions","v":{"s":"❓ Big Cosmic Questions"}},{"k":"10_of_the_deepest_open_questions_in_co","v":{"s":"10 of the deepest open questions in cosmology. Some have partial answers; some are pure mystery."}},{"k":"previous_3","v":{"s":"← Previous"}},{"k":"next_5","v":{"s":"Next →"}},{"k":"solar_system_side_by_side","v":{"s":"📊 Solar System Side-by-Side"}},{"k":"quick_table_of_planet_properties_diame","v":{"s":"Quick table of planet properties. Diameter, gravity, day length, moons."}},{"k":"diameter_km","v":{"s":"Diameter (km)"}},{"k":"gravity_g","v":{"s":"Gravity (g)"}},{"k":"day_hours","v":{"s":"Day (hours)"}},{"k":"moons","v":{"s":"Moons"}},{"k":"property","v":{"s":"Property"}},{"k":"side_by_side_comparison_of_key_planet_","v":{"s":"Side-by-side comparison of key planet properties. Earth = baseline. Sun is 1000× Earth radius. Jupiter has 95 known moons. Venus rotates so slowly its day exceeds its year."}},{"k":"about_this_tool","v":{"s":"🌌 About This Tool"}},{"k":"40_visual_interactive_mini_tools_made_","v":{"s":"40+ visual + interactive mini-tools. Made for curious students + adults."}},{"k":"solar_system_explorer_2","v":{"s":"Solar System Explorer"}},{"k":"40_interactive_mini_tools_svg_visualiz","v":{"s":"40+ interactive mini-tools, SVG visualizations, and educational simulations."}},{"k":"from_a_moon_phase_dial_to_a_black_hole","v":{"s":"From a moon-phase dial to a black hole visualizer to a Foucault pendulum, every tool is built to make abstract concepts visceral + playable."}},{"k":"built_for_k_12_curious_adults_open_all","v":{"s":"Built for K-12 + curious adults. Open all the tools, or just one — each works standalone."}},{"k":"part_of_alloflow_stem_lab_built_in_mai","v":{"s":"Part of AlloFlow STEAM Lab. Built in Maine, USA. All data drawn from NASA, ESA, JAXA, USGS, IAU + public scientific sources. Educational use free."}},{"k":"meteor_shower_calendar","v":{"s":"☄ Meteor Shower Calendar"}},{"k":"9_annual_meteor_showers_their_best_vie","v":{"s":"9 annual meteor showers + their best viewing dates. Mark your calendar."}},{"k":"quadrantids","v":{"s":"Quadrantids"}},{"k":"lyrids","v":{"s":"Lyrids"}},{"k":"eta_aquarids","v":{"s":"Eta Aquarids"}},{"k":"perseids","v":{"s":"Perseids"}},{"k":"draconids","v":{"s":"Draconids"}},{"k":"orionids","v":{"s":"Orionids"}},{"k":"leonids","v":{"s":"Leonids"}},{"k":"geminids","v":{"s":"Geminids"}},{"k":"ursids","v":{"s":"Ursids"}},{"k":"meteor_showers_happen_when_earth_cross","v":{"s":"Meteor showers happen when Earth crosses a comet's debris stream. Best viewing: dark site, no Moon, after midnight. Perseids + Geminids are the most reliable annual showers."}},{"k":"famous_astronomy_quotes","v":{"s":"💬 Famous Astronomy Quotes"}},{"k":"10_quotes_from_astronomers_space_trave","v":{"s":"10 quotes from astronomers + space travelers that capture wonder."}},{"k":"previous_4","v":{"s":"← Previous"}},{"k":"next_6","v":{"s":"Next →"}},{"k":"tonight_sky_observing_guide","v":{"s":"🔭 Tonight Sky Observing Guide"}},{"k":"10_things_you_can_spot_tonight_with_ju","v":{"s":"10 things you can spot tonight with just your eyes or binoculars."}},{"k":"best_naked_eye_observing_dark_site_awa","v":{"s":"Best naked-eye observing: dark site (away from city lights), Moon below horizon, eyes adapted (20-30 min in the dark). Free apps: Stellarium, SkyView, Star Walk help identify what you see."}},{"k":"pale_blue_dot","v":{"s":"🌍 Pale Blue Dot"}},{"k":"carl_sagan_s_most_quoted_reflection_a_","v":{"s":"Carl Sagan's most-quoted reflection. A pixel containing everyone we have ever known."}},{"k":"the_pale_blue_dot","v":{"s":"The Pale Blue Dot"}},{"k":"from_this_distant_vantage_point_the_ea","v":{"s":"\"From this distant vantage point, the Earth might not seem of any particular interest. But for us, it's different. Consider again that dot. That's here. That's home. That's us. On it everyone you love, everyone you know, everyone you ever heard of, every human being who ever was, lived out their lives.\""}},{"k":"carl_sagan_pale_blue_dot_1994","v":{"s":"— Carl Sagan, Pale Blue Dot (1994)"}},{"k":"voyager_1_took_this_photo_of_earth_fro","v":{"s":"Voyager 1 took this photo of Earth from 6 billion km away on Feb 14, 1990 — a request from Carl Sagan. Earth is a single pixel. Every human in history lived on that pixel."}},{"k":"famous_nebulae","v":{"s":"☁ Famous Nebulae"}},{"k":"8_iconic_deep_sky_objects_star_nurseri","v":{"s":"8 iconic deep-sky objects. Star nurseries, dying-star shells, supernova remnants."}},{"k":"orion_nebula_m42","v":{"s":"Orion Nebula (M42)"}},{"k":"stellar_nursery_24_ly_across_visible_n","v":{"s":"Stellar nursery 24 ly across. Visible naked-eye in Orion's Sword."}},{"k":"crab_nebula_m1","v":{"s":"Crab Nebula (M1)"}},{"k":"remains_of_supernova_witnessed_in_1054","v":{"s":"Remains of supernova witnessed in 1054 CE. Contains pulsar."}},{"k":"ring_nebula_m57","v":{"s":"Ring Nebula (M57)"}},{"k":"planetary_nebula_in_lyra_glowing_shell","v":{"s":"Planetary nebula in Lyra. Glowing shell from dying Sun-like star."}},{"k":"eagle_nebula_m16","v":{"s":"Eagle Nebula (M16)"}},{"k":"home_of_pillars_of_creation_hubble_199","v":{"s":"Home of Pillars of Creation (Hubble 1995). Star formation pillars."}},{"k":"cat_s_eye_ngc_6543","v":{"s":"Cat's Eye (NGC 6543)"}},{"k":"complex_planetary_nebula_many_shell_la","v":{"s":"Complex planetary nebula. Many shell layers from pulsations."}},{"k":"helix_nebula_ngc_7293","v":{"s":"Helix Nebula (NGC 7293)"}},{"k":"closest_planetary_nebula_looks_like_an","v":{"s":"Closest planetary nebula. Looks like an eye in space."}},{"k":"tarantula_nebula","v":{"s":"Tarantula Nebula"}},{"k":"in_large_magellanic_cloud_largest_know","v":{"s":"In Large Magellanic Cloud. Largest known star-forming region."}},{"k":"veil_nebula","v":{"s":"Veil Nebula"}},{"k":"supernova_remnant_8000_years_old_massi","v":{"s":"Supernova remnant ~8000 years old. Massive arcs in Cygnus."}},{"k":"previous_5","v":{"s":"← Previous"}},{"k":"next_7","v":{"s":"Next →"}},{"k":"astronomy_toolkit_guide","v":{"s":"🛠 Astronomy Toolkit Guide"}},{"k":"what_you_need_to_start_observing_from_","v":{"s":"What you need to start observing — from free apps to scopes that fit any budget."}},{"k":"stellarium","v":{"s":"Stellarium"}},{"k":"free_planetarium_software_shows_night_","v":{"s":"Free planetarium software. Shows night sky from anywhere, anytime."}},{"k":"skyview_lite","v":{"s":"SkyView Lite"}},{"k":"phone_app_point_at_sky_to_identify_wha","v":{"s":"Phone app. Point at sky to identify what you're looking at."}},{"k":"nasa_eyes","v":{"s":"NASA Eyes"}},{"k":"interactive_3d_solar_system_jwst_missi","v":{"s":"Interactive 3D solar system + JWST + mission visualizations."}},{"k":"binoculars_7_50_or_10_50","v":{"s":"Binoculars 7×50 or 10×50"}},{"k":"best_starter_scope_reveals_galilean_mo","v":{"s":"Best starter scope. Reveals Galilean moons of Jupiter, Andromeda, Pleiades cluster."}},{"k":"beginner_telescope","v":{"s":"Beginner Telescope"}},{"k":"celestron_starsense_explorer_102_or_or","v":{"s":"Celestron StarSense Explorer 102 or Orion 4.5\" Newtonian."}},{"k":"better_telescope","v":{"s":"Better Telescope"}},{"k":"celestron_nexstar_8se_or_apertura_ad8_","v":{"s":"Celestron NexStar 8SE or Apertura AD8 Dobsonian."}},{"k":"local_astronomy_club","v":{"s":"Local astronomy club"}},{"k":"most_cities_have_one_members_lend_scop","v":{"s":"Most cities have one. Members lend scopes, teach, run star parties."}},{"k":"dark_site","v":{"s":"Dark site"}},{"k":"drive_30_min_from_city_lights_maine_is","v":{"s":"Drive 30+ min from city lights. Maine is full of them. Acadia is a Dark Sky Park."}},{"k":"most_important_tool_dark_sky_light_pol","v":{"s":"Most important tool: dark sky. Light pollution wipes out 90% of stars. Acadia NP, Allagash Wilderness, Mt Mansfield (VT), Baxter SP — all International Dark Sky Parks."}},{"k":"how_stars_die","v":{"s":"⚱ How Stars Die"}},{"k":"star_s_fate_depends_on_mass_brown_dwar","v":{"s":"Star's fate depends on mass: brown dwarf, white dwarf, neutron star, or black hole."}},{"k":"how_a_star_dies_depends_almost_entirel","v":{"s":"How a star dies depends almost entirely on its initial mass. The cutoff between neutron star + black hole is uncertain (Tolman-Oppenheimer-Volkoff limit ~2-3 M☉ for the remnant)."}},{"k":"cosmic_distance_reference","v":{"s":"📏 Cosmic Distance Reference"}},{"k":"from_1km_to_93_billion_light_years_ref","v":{"s":"From 1km to 93 billion light-years. Reference table of cosmic scales."}},{"k":"distances_jump_in_scale_km_to_au_to_ly","v":{"s":"Distances jump in scale: km to AU to ly to billions of ly. Each step is ~10,000-100,000× larger. Astronomy lives on a log scale."}},{"k":"maine_night_sky_by_season","v":{"s":"🌲 Maine Night Sky by Season"}},{"k":"maine_has_world_class_dark_skies_what_","v":{"s":"Maine has world-class dark skies. What to look for each season."}},{"k":"maine_has_fantastic_dark_skies_especia","v":{"s":"Maine has fantastic dark skies — especially north of the cities. Acadia NP, Allagash Wilderness, Baxter SP, and Cobscook State Park are all IDA Dark Sky locations. Winter nights are long + crystal-clear."}},{"k":"space_news_timeline","v":{"s":"📰 Space News Timeline"}},{"k":"major_space_missions_events_2024_2027_","v":{"s":"Major space missions + events 2024-2027. Live in interesting times."}},{"k":"space_exploration_is_in_a_renaissance_","v":{"s":"Space exploration is in a renaissance. New countries (India, Japan, UAE), new private companies (SpaceX, Blue Origin), new missions (Europa Clipper, Artemis, JWST). Look up — and pay attention."}},{"k":"solar_system_at_a_glance","v":{"s":"📊 Solar System At a Glance"}},{"k":"quick_reference_summary_of_solar_syste","v":{"s":"Quick-reference summary of solar system contents + mass distribution."}},{"k":"solar_system_stats","v":{"s":"Solar System Stats"}},{"k":"the_sun_contains_99_86_of_all_solar_sy","v":{"s":"The Sun contains 99.86% of all solar system mass. Jupiter accounts for two-thirds of the remaining 0.14%. Earth + everything else is the rest."}},{"k":"10_most_famous_moons","v":{"s":"🌑 10 Most Famous Moons"}},{"k":"from_our_own_luna_to_triton_enceladus_","v":{"s":"From our own Luna to Triton + Enceladus. Some are bigger than Mercury."}},{"k":"luna_earth","v":{"s":"Luna (Earth)"}},{"k":"io_jupiter_2","v":{"s":"Io (Jupiter)"}},{"k":"europa_jupiter_2","v":{"s":"Europa (Jupiter)"}},{"k":"ganymede_jupiter_2","v":{"s":"Ganymede (Jupiter)"}},{"k":"callisto_jupiter_2","v":{"s":"Callisto (Jupiter)"}},{"k":"titan_saturn_2","v":{"s":"Titan (Saturn)"}},{"k":"enceladus_saturn_2","v":{"s":"Enceladus (Saturn)"}},{"k":"iapetus_saturn","v":{"s":"Iapetus (Saturn)"}},{"k":"triton_neptune","v":{"s":"Triton (Neptune)"}},{"k":"charon_pluto","v":{"s":"Charon (Pluto)"}},{"k":"most_spectacular_moons_in_the_solar_sy","v":{"s":"Most spectacular moons in the solar system. Many are larger than Pluto. Europa + Enceladus + Titan have subsurface oceans and are prime astrobiology targets."}},{"k":"why_utc_matters","v":{"s":"🌐 Why UTC Matters"}},{"k":"astronomers_report_everything_in_utc_t","v":{"s":"Astronomers report everything in UTC. Time zone explainer."}},{"k":"why_we_use_utc","v":{"s":"Why we use UTC"}},{"k":"utc_coordinated_universal_time_is_the_","v":{"s":"UTC (Coordinated Universal Time) is the global reference. Atomic clocks based."}},{"k":"astronomers_report_events_in_utc_so_ob","v":{"s":"Astronomers report events in UTC so observatories worldwide can compare. SpaceX launches in UTC. NASA missions in UTC."}},{"k":"maine_utc_5_est_or_utc_4_edt_london_ut","v":{"s":"Maine: UTC-5 (EST) or UTC-4 (EDT). London: UTC+0 (GMT) or UTC+1 (BST). Japan: UTC+9."}},{"k":"tip_when_you_read_an_astronomy_event_t","v":{"s":"Tip: when you read an astronomy event timetable, always check whether it's in UTC or local."}},{"k":"utc_replaced_gmt_in_1972_based_on_atom","v":{"s":"UTC replaced GMT in 1972. Based on atomic clocks at national laboratories worldwide, averaged. Leap seconds added when needed."}},{"k":"final_inspiration","v":{"s":"✨ Final Inspiration"}},{"k":"keep_looking_up","v":{"s":"Keep Looking Up"}},{"k":"40_interactive_tools_to_explore_in_thi","v":{"s":"40+ interactive tools to explore in this app. Each opens a new window on something cosmic."}},{"k":"astronomy_bucket_list","v":{"s":"✅ Astronomy Bucket List"}},{"k":"15_cosmic_experiences_worth_chasing_mo","v":{"s":"15 cosmic experiences worth chasing. Most are free + within reach."}},{"k":"15_cosmic_experiences_worth_chasing_mo_2","v":{"s":"15 cosmic experiences worth chasing. Most cost nothing but time. The night sky asks nothing of you — go meet it."}},{"k":"surprising_planet_facts","v":{"s":"💎 Surprising Planet Facts"}},{"k":"12_facts_that_defy_what_you_think_you_","v":{"s":"12 facts that defy what you think you know about the planets."}},{"k":"12_things_that_surprise_people_about_o","v":{"s":"12 things that surprise people about our solar system. Each one defies the intuitive picture."}},{"k":"messages_to_the_stars","v":{"s":"📜 Messages to the Stars"}},{"k":"pioneer_plaques_voyager_golden_records","v":{"s":"Pioneer plaques + Voyager Golden Records + Arecibo Message — humanity's signals to whoever might be listening."}},{"k":"messages_to_the_stars_2","v":{"s":"Messages to the Stars"}},{"k":"pioneer_plaque_1972_73","v":{"s":"Pioneer Plaque (1972/73): "}},{"k":"gold_anodized_aluminum_on_pioneer_10_1","v":{"s":"Gold-anodized aluminum on Pioneer 10 + 11. Shows nude humans, Earth's location, hydrogen."}},{"k":"voyager_golden_record_1977","v":{"s":"Voyager Golden Record (1977): "}},{"k":"phonograph_record_on_voyager_1_2_115_p","v":{"s":"Phonograph record on Voyager 1 + 2. 115 photos, music (Beethoven to Chuck Berry), greetings in 55 languages, sounds of Earth."}},{"k":"arecibo_message_1974","v":{"s":"Arecibo Message (1974): "}},{"k":"radio_broadcast_to_globular_cluster_m1","v":{"s":"Radio broadcast to globular cluster M13. Will reach in ~25,000 years."}},{"k":"carl_sagan_frank_drake_linda_salzman_s","v":{"s":"Carl Sagan + Frank Drake + Linda Salzman Sagan + many others designed these. Voyager Record committee included Ann Druyan — whose brainwaves are encoded as part of the record."}},{"k":"credits","v":{"s":"🎓 Credits"}},{"k":"acknowledgments_sources","v":{"s":"Acknowledgments + sources."}},{"k":"credits_sources","v":{"s":"Credits + Sources"}},{"k":"data_nasa_esa_jaxa_usgs_iau_smithsonia","v":{"s":"Data: NASA, ESA, JAXA, USGS, IAU, Smithsonian, Wikipedia"}},{"k":"designed_by_aaron_pomeranz_alloflow_ma","v":{"s":"Designed by Aaron Pomeranz, AlloFlow Maine"}},{"k":"40_interactive_tools_svg_react","v":{"s":"40+ interactive tools = SVG + React"}},{"k":"educational_use_share_freely_keep_curi","v":{"s":"Educational use — share freely + keep curious"}},{"k":"keep_wondering","v":{"s":"🌠 Keep Wondering"}},{"k":"every_answer_is_a_doorway_to_the_next_","v":{"s":"Every answer is a doorway to the next question."}},{"k":"done_exploring_keep_wondering","v":{"s":"Done exploring? Keep wondering."}},{"k":"every_answer_leads_to_a_deeper_questio","v":{"s":"Every answer leads to a deeper question. That is science."}},{"k":"mission_log","v":{"s":"📋 Mission Log"}},{"k":"no_entries_yet_start_exploring","v":{"s":"No entries yet. Start exploring!"}},{"k":"no_entries_yet_start_exploring_2","v":{"s":"No entries yet. Start exploring!"}},{"k":"welcome_to_solar_system_explorer","v":{"s":"Welcome to Solar System Explorer!"}},{"k":"your_interactive_guide_to_our_cosmic_n","v":{"s":"Your interactive guide to our cosmic neighborhood"}},{"k":"click_any_planet_in_the_3d_view_to_sel","v":{"s":"Click any planet in the 3D view to select it"}},{"k":"surface_view_shows_the_planet_with_orb","v":{"s":"Surface View shows the planet with orbiting moons"}},{"k":"interior_view_reveals_the_hidden_layer","v":{"s":"Interior View reveals the hidden layers inside each planet"}},{"k":"deploy_a_rover_probe_to_explore_planet","v":{"s":"Deploy a rover/probe to explore planet surfaces in 3D"}},{"k":"earn_research_points_by_completing_exp","v":{"s":"Earn Research Points by completing exploration challenges"}},{"k":"ask_the_ai_space_tutor_any_question_ab","v":{"s":"Ask the AI Space Tutor any question about the cosmos"}},{"k":"start_exploring","v":{"s":"Start Exploring!"}},{"k":"start_exploring_2","v":{"s":"🚀 Start Exploring!"}},{"k":"learning_path","v":{"s":"🗺️ Learning Path"}},{"k":"field_journal","v":{"s":"📓 Field Journal"}},{"k":"what_i_predicted","v":{"s":"What I predicted:"}},{"k":"before_exploring_i_thought","v":{"s":"Before exploring, I thought..."}},{"k":"what_i_observed","v":{"s":"What I observed:"}},{"k":"i_noticed_that","v":{"s":"I noticed that..."}},{"k":"what_surprised_me","v":{"s":"What surprised me:"}},{"k":"i_was_surprised_that","v":{"s":"I was surprised that..."}},{"k":"one_question_i_still_have","v":{"s":"One question I still have:"}},{"k":"i_wonder","v":{"s":"I wonder...