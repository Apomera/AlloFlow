  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/15299.png",
      "text": "Khale-khale polasing e nyane pela motse o monyane...",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=1",
      "sourceDigest": "sha256:b6d9231d4c6afefcab03a8138cc194989fedb46af8770cf52e4f7c2366ab6102"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/15300.png",
      "text": "...Ho ne ho phela tsuonyana e neng e bitsoa Deise.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=2",
      "sourceDigest": "sha256:6da1a5500e327ba7b328092ce822322c16fc7381484c952a4d8bdc88b307eb1f"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/15301.png",
      "text": "\"Ha ke hola, ke batla ho fofela holimo-limo sebakeng,\" ho rialo Deise.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=3",
      "sourceDigest": "sha256:52d7750cde0262303cc9b4923a0e3c3234311fc81d469fbc6529cd271fd4cafb"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/15302.png",
      "text": "Empa litsuonyana tse ling tsa mo ts'eha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=4",
      "sourceDigest": "sha256:b2ce53f7ae2f124beedde367a5bb641d855c9ae1c3650500fa88f3729f7b5eca"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/15303.png",
      "text": "\"U makatsa hore,\" tsa hlalosa. \"Ha re sa tla bapala le uena.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=5",
      "sourceDigest": "sha256:d912ee5b89f7492078791b6f42f397a88e1f25058e239f345d0f781b3c6d7d15"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/15322.png",
      "text": "\"Deise, kaofela ha rona re ka otlanya mapheo a rona, empa ho thata haholo hore litsuonyana li fofe,\" 'M'e oa eona a e joetsa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=6",
      "sourceDigest": "sha256:1b76874970f43078c64c31cfeefde1e55f7229eb279a04943aeba0f938522d0d"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/15305.png",
      "text": "Deise ea se ke ea tela. Tsatsi le leng le le leng e ne e ikoetlisa e otlanya mapheo a eona. Ea otlanya, ea otlanya, ea otlanya mapheo a eona empa e sa khone ho tloha fats'e.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=7",
      "sourceDigest": "sha256:9c304829824d37c61d358417b1d4a0c2b424879414b5e09f13eb72c1fa1188e0"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/15307.png",
      "text": "Eare ha e se e ikoetlisitse, ea nahana ho fofela holimo sebakeng hore e shebele tse ling tlase. Ea nahana feela ha e se e fofa e feta lirobele le mafokotsane. Linonyana tsa re, \"Khele! Tsuonyana e tsebang ho fofa?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=8",
      "sourceDigest": "sha256:63d3c2ff4af6a860b87f6de1870e6eed0fad1bfdaccc0922ba9692e45778ccce"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/15308.png",
      "text": "Joale tsatsi le leng le le leng Deise e ne e otlanya, e otlanya, e otlanya mapheo a eona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=9",
      "sourceDigest": "sha256:43496f1034e380b7d82a8d0ced664be46f55310cdea86063826d8bfb67e1fffb"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/15309.png",
      "text": "Ea phahama fats'e, empa ea boela ea oela fats'e hape.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=10",
      "sourceDigest": "sha256:49d0a918bccd804cbeb69ceae15811b4216d3ee16a7552181c507433e7834dc2"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/15310.png",
      "text": "\"Ha ke sa tla fofa!\" Deise ea llela ho 'm'e oa eona. \"Ba bang ba nepile.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=11",
      "sourceDigest": "sha256:c81c84801ec2c9641bd20618e2e595a1530095c263bcba18cfa053009aec85b3"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/15311.png",
      "text": "\"Deise, u fapane le litsuonyana tse ling. Ha li batle ho fofa empa uena u ua fofa! U khona ho fofa,\" ha rialo 'm'e oa eona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=12",
      "sourceDigest": "sha256:ddb83e4196fb5c7c2accfa05ab2366e00cb122a240675ee27eb03dc59318a622"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/15312.png",
      "text": "Ka tsatsi le hlahlamang, Deise ea hloella holima setlojane sa likhoho eaba e ea otlanya, e ea otlanya, e otlanya mapheo a eona. Eaba e fofela moeeng, ea otlanya mapheo a eona, ea otlanya mapheo a eona, ea otlanya mapheo a eona eaba...",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=13",
      "sourceDigest": "sha256:5accfa6301b82f10221ae29de7edffba2d8c3b376d3e92f46d4bc069bfe64da3"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/15313.png",
      "text": "PUTLA!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=14",
      "sourceDigest": "sha256:379373463c4327775768cd8ec3412bf759b9aee2f02e5ae85208ef7531695486"
    },
    {
      "n": 15,
      "img": "https://www.africanstorybook.org/illustrations/pages/15314.png",
      "text": "Litsuonyana tse ling tsa e ts'eha haholo. \"Ha ha ha! Re u joetsitse! Litsuonyana ha li fofe!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=15",
      "sourceDigest": "sha256:68b3aae636880c51b12d142c49d0ead4f0f81bf27903db83e235f62947341d31"
    },
    {
      "n": 16,
      "img": "https://www.africanstorybook.org/illustrations/pages/15315.png",
      "text": "Empa ka tsatsi le hlahlamang, Deise ea hloella holimo-limo haholo ntlong ea mokhoro. Ea otlanya, ea otlanya, ea otlanya, Deise ea otlanya mapheo a eona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=16",
      "sourceDigest": "sha256:ad21f3d63e532b2a194b97a88d0ee9a150cbb9d0dd8e05951f6f4b2c5ea06ea6"
    },
    {
      "n": 17,
      "img": "https://www.africanstorybook.org/illustrations/pages/15316.png",
      "text": "Ea fofela moeeng, ea otlanya mapheo a eona, ea otlanya mapheo a eona, ea otlanya mapheo a eona eaba...",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=17",
      "sourceDigest": "sha256:99a293ff30d04acde96b0b4b17b319367a617bd5aac8778ac08060b0ff376ff6"
    },
    {
      "n": 18,
      "img": "https://www.africanstorybook.org/illustrations/pages/15317.png",
      "text": "E tsoelapele ho fofa! Moea o ka tlasa mapheo a eona oa ba matla, eaba e ntse e fofela holimo-limo! Lirobele le mafokotsane tsa re, \"Mohlolo o makatsang! Tsuonyana e fofang!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=18",
      "sourceDigest": "sha256:2a3fc1595d48b86405b279384a62a658a1928a7654c6be2f54cdbc0bc7b1e5e5"
    },
    {
      "n": 19,
      "img": "https://www.africanstorybook.org/illustrations/pages/15318.png",
      "text": "Eaba litsuonyana tse ling li batla ho ts'oana le eona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=19",
      "sourceDigest": "sha256:d4aaf4c6ebdd2a145ccc873bb31ffbd52bd2d7fbc553ceff222be28a00a37f41"
    },
    {
      "n": 20,
      "img": "https://www.africanstorybook.org/illustrations/pages/15319.png",
      "text": "Tsa re, \"Khele Deise, u ua makatsa ruri!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36338#page=20",
      "sourceDigest": "sha256:a45de022406e4902efca525f065df74c21ac9c8c5ca4a90dd1d79b36e8d6c041"
    }
  ],
