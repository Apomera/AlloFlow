+import { beforeAll, beforeEach, afterEach, describe, it, expect } from 'vitest';
+import { setupRecoveryReader, prepareRecoveryCase, cleanupRecoveryCase, navigationFixtures, mountPrepared, openPreparedCard, preparedReading, mountReader, act, click, translator } from './helpers/reader_navigation_locale_harness.js';
+beforeAll(setupRecoveryReader, 60000);
+beforeEach(prepareRecoveryCase);
+afterEach(cleanupRecoveryCase);
+const readable = element => expect(element.textContent).not.toMatch(/simplified\.[a-z_]+|\{(?:count|word)\}/);
+describe('localized navigation and prepared word help', () => {
+  for (const fixture of navigationFixtures) {
+    it(fixture.id + ': names controls and keyboard instructions in the interface language', () => {
+      const { host, t } = mountPrepared(fixture);
+      expect(host.querySelector('[data-reader-skip]').textContent).toBe(t('simplified.skip_passage'));
+      expect(host.querySelector('[data-reader-display]').textContent).toContain(t('simplified.display_menu'));
+      for (const [mode, key] of [['define', 'word_meaning'], ['phonics', 'word_sounds']]) expect(host.querySelector('[data-reading-mode="' + mode + '"]').textContent).toBe(t('simplified.' + key));
+      const status = host.querySelector('[data-reading-mode-status="define"]');
+      expect(status.textContent).toContain(t('simplified.define_hint'));
+      expect(status.textContent).toContain(t('simplified.word_arrows_hint')); readable(status);
+      const paragraph = host.querySelector('[data-reading-paragraph="1"]');
+      expect(paragraph.lang).toBe(fixture.tag); expect(paragraph.dir).toBe(fixture.dir);
+      const words = [...paragraph.querySelectorAll('[data-reading-word]')];
+      expect(words.length).toBeGreaterThan(1);
+      act(() => { words[0].focus(); words[0].dispatchEvent(new KeyboardEvent('keydown', { key: fixture.dir === 'rtl' ? 'ArrowLeft' : 'ArrowRight', bubbles: true })); });
+      expect(document.activeElement).toBe(words[1]);
+    });
+    it(fixture.id + ': names the immersive reading region and its line-focus instructions', () => {
+      const { host, t } = mountReader(fixture, { generatedContent: { ...preparedReading(fixture), immersiveData: [] }, isImmersiveReaderActive: true, immersiveSettings: { textSize: 20, lineFocus: true }, lineHeight: 1.5, letterSpacing: 0, immersiveToolbarBottom: 0, immersiveRulerY: 100, setImmersiveRulerY: () => {}, ErrorBoundary: ({ children }) => children, FocusReaderOverlay: () => null, PerspectiveCrawlOverlay: () => null, KaraokeReaderOverlay: () => null, ImmersiveToolbar: () => null, ImmersiveWord: () => null });
+      expect(host.querySelector('[data-immersive-passage]').getAttribute('aria-label')).toBe(t('simplified.reader_reading_passage_when_line_focus_is'));
+    });
+    it(fixture.id + ': opens localized teacher help, preserves language and restores focus on Escape', async () => {
+      const { host, card, opener, t, props } = await openPreparedCard(fixture);
+      expect(card.textContent).toContain(t('simplified.word_help_card_prepared'));
+      for (const [selector, key] of [['hear', 'hear_word'], ['listen', 'listen'], ['more', 'more'], ['all', 'all']]) expect(card.querySelector('[data-word-help-card-' + selector + ']').textContent).toBe(t('simplified.word_help_card_' + key));
+      expect(card.querySelector('h5').textContent).toBe(fixture.quote); expect(card.querySelector('h5').lang).toBe(fixture.tag); expect(card.querySelector('h5').dir).toBe(fixture.dir);
+      expect(card.querySelector('[data-word-help-card-text]').textContent).toBe(fixture.explanation); readable(card);
+      expect(document.activeElement).toBe(card); expect(props.handleWordClick).not.toHaveBeenCalled(); expect(props.handleSpeak).not.toHaveBeenCalled();
+      act(() => card.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true })));
+      expect(host.querySelector('[data-word-help-card]')).toBeNull(); expect(document.activeElement).toBe(opener);
+    });
+    for (const state of ['shown', 'hidden', 'stale']) it(fixture.id + ': localizes the ' + state + ' support summary', () => {
+      const item = preparedReading(fixture, { shown: state !== 'hidden', stale: state === 'stale' });
+      const { host, t } = mountReader(fixture, { generatedContent: item, isTeacherMode: true });
+      const summary = host.querySelector('[data-word-help-summary]');
+      expect(summary).not.toBeNull();
+      if (state === 'stale') expect(summary.textContent).toContain(t('simplified.word_help_summary_needs_review'));
+      else { expect(summary.textContent).toContain(t('simplified.word_help_summary_one')); expect(summary.textContent).toContain(t('simplified.word_help_summary_' + state)); }
+      readable(summary);
+    });
+  }
+  it('keeps an Arabic help card RTL under an English interface', async () => {
+    const fixture = { ...navigationFixtures.find(f => f.locale === 'arabic'), locale: 'English' };
+    const { card, host } = await openPreparedCard(fixture);
+    expect(host.querySelector('[data-reader-skip]').textContent).toBe('Skip reading controls');
+    expect(card.textContent).toContain('Word help from your teacher'); expect(card.querySelector('h5').dir).toBe('rtl'); expect(card.querySelector('h5').lang).toBe('ar');
+  });
+  it.each(['missing', 'echoed'])('uses readable English navigation and card labels when the translator is %s', async mode => {
+    const t = mode === 'missing' ? () => undefined : key => key;
+    const { host, card } = await openPreparedCard(navigationFixtures[0], { t });
+    expect(host.querySelector('[data-reader-skip]').textContent).toBe('Skip reading controls');
+    expect(card.querySelector('[data-word-help-card-hear]').textContent).toBe('Hear the word'); readable(card);
+  });
+});
