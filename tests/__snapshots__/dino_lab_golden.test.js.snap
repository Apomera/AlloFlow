<button id="dinotab-classify" role="tab" data-tab-group="Investigate" title="Investigate: Classify" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🌳 Classify</button>
<button id="dinotab-birds" role="tab" data-tab-group="Explain" title="Explain: Bird Link" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🐦 Bird Link</button>
