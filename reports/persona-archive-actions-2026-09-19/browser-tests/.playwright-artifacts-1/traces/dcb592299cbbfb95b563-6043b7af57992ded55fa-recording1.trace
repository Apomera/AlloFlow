"}},{"k":"call_and_launch","v":{"s":"3 · Call it and launch"}},{"k":"call_your_shot","v":{"s":"Call your shot"}},{"k":"evidence_loop_tagline","v":{"s":"Build evidence one throw at a time."}},{"k":"fieldgoal_learning_goal","v":{"s":"Goal: clear the crossbar between the uprights. Test how launch angle, speed, distance, and wind trade height for range."}},{"k":"freekick_learning_goal","v":{"s":"Goal: clear the wall and find the goal. Vertical angle creates clearance; horizontal aim sets the line; sidespin creates curl."}},{"k":"golf_learning_goal","v":{"s":"Goal: match carry to the target. Club speed sets range while loft and backspin trade forward motion for lift and stopping power."}},{"k":"how_the_lab_works","v":{"s":"How Throw Lab works"}},{"k":"lab_extensions","v":{"s":"Extend the lab"}},{"k":"lab_extensions_detail","v":{"s":"Optional scenarios, gravity, skill levels, drills, rewards, and session stats."}},{"k":"load_one_change_rep","v":{"s":"Load one-change next rep"}},{"k":"loop_choose","v":{"s":"Choose"}},{"k":"loop_choose_detail","v":{"s":"Pick a sport and setup"}},{"k":"loop_compare","v":{"s":"Compare"}},{"k":"loop_compare_detail","v":{"s":"Change one variable"}},{"k":"loop_launch","v":{"s":"Launch"}},{"k":"loop_launch_detail","v":{"s":"Watch the evidence"}},{"k":"loop_predict","v":{"s":"Hypothesize"}},{"k":"loop_predict_detail","v":{"s":"Make an ungraded call"}},{"k":"next_rep","v":{"s":"Next rep"}},{"k":"next_rep_keeps_baseline","v":{"s":"This restores the launched setup, changes only the named control, and keeps the result visible for comparison."}},{"k":"next_rep_prefix","v":{"s":"Next rep:"}},{"k":"pitching_learning_goal","v":{"s":"Goal: cross the strike zone. Speed changes reaction time; spin rate and spin axis shape late break. Start with a preset, then change one control."}},{"k":"prediction_no_penalty","v":{"s":"Make an ungraded call before launch. A match is not a score; both matches and surprises can guide the next test."}},{"k":"set_up_first_rep","v":{"s":"SET UP FIRST REP"}},{"k":"set_up_next_rep","v":{"s":"SET UP NEXT REP"}},{"k":"successful_basketball_reps","v":{"s":"Successful reps"}},{"k":"tune_release_controls","v":{"s":"2 · Tune the release"}},{"k":"volleyball_learning_goal","v":{"s":"Goal: clear the net and land in court. Speed creates depth; launch angle creates clearance; topspin helps the ball dive."}}],"id":587}},{"k":"titration","v":{"o":[{"k":"sr_explanation_ready","v":{"s":"Explanation ready."}},{"k":"a11y_safety_briefing_progress","v":{"s":"Safety briefing progress"}},{"k":"a11y_safety_station_1_of_4","v":{"s":"Safety station 1 of 4"}},{"k":"a11y_ppe_readiness","v":{"s":"PPE readiness"}},{"k":"a11y_safety_station_2_of_4","v":{"s":"Safety station 2 of 4"}},{"k":"a11y_safety_station_3_of_4","v":{"s":"Safety station 3 of 4"}},{"k":"a11y_safety_station_4_of_4","v":{"s":"Safety station 4 of 4"}},{"k":"a11y_safety_drill_timer","v":{"s":"Safety drill timer"}},{"k":"a11y_quick_safety_reference","v":{"s":"Quick safety reference"}},{"k":"a11y_chemical_hazard_information","v":{"s":"Chemical hazard information"}},{"k":"a11y_live_titration_metrics","v":{"s":"Live titration metrics"}},{"k":"a11y_equivalence_progress","v":{"s":"Equivalence progress"}},{"k":"a11y_progress_toward_equivalence_volume","v":{"s":"Progress toward equivalence volume"}},{"k":"a11y_titration_lab_sections","v":{"s":"Titration Lab sections"}},{"k":"a11y_scrollable_titration_curve_plot","v":{"s":"Scrollable titration curve plot"}},{"k":"a11y_titration_curve_legend","v":{"s":"Titration curve legend"}},{"k":"a11y_recorded_trial_readings","v":{"s":"Recorded trial readings"}},{"k":"a11y_graded_titration_result","v":{"s":"Graded titration result"}},{"k":"a11y_completed_unknown_runs","v":{"s":"Completed unknown runs"}},{"k":"a11y_glassware_comparison","v":{"s":"Glassware comparison"}},{"k":"a11y_animated_reference_curve_showing_ph_versus_titr","v":{"s":"Animated reference curve showing pH versus titrant volume for a strong acid titrated by a strong base."}},{"k":"a11y_buffer_observations","v":{"s":"Buffer observations"}},{"k":"hcl_naoh","v":{"s":"HCl + NaOH"}},{"k":"strong_acid_strong_base","v":{"s":"Strong acid + Strong base"}},{"k":"ch_cooh_naoh","v":{"s":"CH₃COOH + NaOH"}},{"k":"weak_acid_strong_base","v":{"s":"Weak acid + Strong base"}},{"k":"hcl_nh","v":{"s":"HCl + NH₃"}},{"k":"strong_acid_weak_base","v":{"s":"Strong acid + Weak base"}},{"k":"ch_cooh_nh","v":{"s":"CH₃COOH + NH₃"}},{"k":"both_weak","v":{"s":"Both weak"}},{"k":"h_po_naoh","v":{"s":"H₃PO₄ + NaOH"}},{"k":"polyprotic_acid_3_equiv_pts","v":{"s":"Polyprotic acid (3 equiv pts)"}},{"k":"fe_kmno","v":{"s":"Fe²⁺ + KMnO₄"}},{"k":"redox_titration","v":{"s":"Redox titration"}},{"k":"antacid_back","v":{"s":"Antacid (back)"}},{"k":"back_titration_of_antacid","v":{"s":"Back-titration of antacid"}},{"k":"phenolphthalein","v":{"s":"Phenolphthalein"}},{"k":"methyl_orange","v":{"s":"Methyl Orange"}},{"k":"bromothymol_blue","v":{"s":"Bromothymol Blue"}},{"k":"universal","v":{"s":"Universal"}},{"k":"hydrochloric_acid","v":{"s":"Hydrochloric Acid"}},{"k":"sodium_hydroxide","v":{"s":"Sodium Hydroxide"}},{"k":"acetic_acid","v":{"s":"Acetic Acid"}},{"k":"ammonia","v":{"s":"Ammonia"}},{"k":"phosphoric_acid","v":{"s":"Phosphoric Acid"}},{"k":"potassium_permanganate","v":{"s":"Potassium Permanganate"}},{"k":"ferrous_sulfate","v":{"s":"Ferrous Sulfate"}},{"k":"antacid_tablet_caco_mg_oh","v":{"s":"Antacid Tablet (CaCO₃/Mg(OH)₂)"}},{"k":"safety_goggles_on","v":{"s":"Safety goggles on"}},{"k":"splash_proof_chemical_safety_goggles_n","v":{"s":"Splash-proof chemical safety goggles — not regular glasses"}},{"k":"nitrile_gloves_worn","v":{"s":"Nitrile gloves worn"}},{"k":"protects_skin_from_corrosive_acids_and","v":{"s":"Protects skin from corrosive acids and bases"}},{"k":"lab_coat_on","v":{"s":"Lab coat on"}},{"k":"button_it_up_protects_clothing_and_ski","v":{"s":"Button it up — protects clothing and skin from splashes"}},{"k":"closed_toe_shoes","v":{"s":"Closed-toe shoes"}},{"k":"no_sandals_or_open_toed_shoes_in_the_c","v":{"s":"No sandals or open-toed shoes in the chemistry lab"}},{"k":"eyewash_station_located","v":{"s":"Eyewash station located"}},{"k":"know_where_it_is_before_you_start_you_","v":{"s":"Know where it is BEFORE you start — you have 10 seconds if splashed"}},{"k":"fire_extinguisher_located","v":{"s":"Fire extinguisher located"}},{"k":"acetic_acid_is_flammable_know_your_nea","v":{"s":"Acetic acid is flammable — know your nearest extinguisher"}},{"k":"sds_reviewed_for_chemicals","v":{"s":"SDS reviewed for chemicals"}},{"k":"safety_data_sheets_list_all_hazards_pp","v":{"s":"Safety Data Sheets list all hazards, PPE, and emergency procedures"}},{"k":"always_add_titrant_slowly_near_the_exp","v":{"s":"Always add titrant slowly near the expected endpoint. A single drop can change the pH dramatically!"}},{"k":"the_ph_is_changing_rapidly_in_a_real_l","v":{"s":"The pH is changing rapidly! In a real lab, switch to drop-by-drop addition and swirl after each drop."}},{"k":"you_overshot_the_equivalence_point_in_","v":{"s":"You overshot the equivalence point! In a real lab, you would need to restart with a fresh sample."}},{"k":"good_lab_practice_always_rinse_the_bur","v":{"s":"Good lab practice: always rinse the burette with distilled water, then with titrant solution before refilling."}},{"k":"at_the_half_equivalence_point_ph_pka_t","v":{"s":"At the half-equivalence point, pH = pKa. This is the center of the buffer region!"}},{"k":"kmno_is_a_strong_oxidizer_in_a_real_la","v":{"s":"KMnO₄ is a strong oxidizer! In a real lab, keep away from organic solvents and use a fume hood. Purple → colorless = endpoint."}},{"k":"polyprotic_acids_have_multiple_equival","v":{"s":"Polyprotic acids have multiple equivalence points! Watch for the S-curve to flatten between each one (buffer regions)."}},{"k":"in_a_back_titration_you_add_excess_aci","v":{"s":"In a back-titration, you add EXCESS acid first, then titrate the leftover acid. This works for insoluble analytes like CaCO₃."}},{"k":"never_add_water_to_concentrated_acid_a","v":{"s":"NEVER add water to concentrated acid! Always add acid TO water. \"Do as you oughta — add acid to water.\" The exothermic reaction can cause dangerous splashing."}},{"k":"when_using_volatile_reagents_like_nh_o","v":{"s":"When using volatile reagents like NH₃ or HCl (conc.), always work in a fume hood. Breathing acid/base fumes damages lung tissue."}},{"k":"read_the_burette_at_the_bottom_of_the_","v":{"s":"Read the burette at the BOTTOM of the meniscus, with your eye level at the liquid surface. Parallax errors affect accuracy!"}},{"k":"acid_splash_on_skin","v":{"s":"Acid Splash on Skin!"}},{"k":"while_pouring_hcl_some_splashes_on_you","v":{"s":"While pouring HCl, some splashes on your forearm."}},{"k":"remove_clothing_rinse_under_running_wa","v":{"s":"Remove clothing, rinse under running water for 15+ minutes"}},{"k":"correct_immediate_and_prolonged_rinsin","v":{"s":"Correct! Immediate and prolonged rinsing is critical. The 15-minute rule saves tissue damage."}},{"k":"wipe_it_off_with_a_paper_towel","v":{"s":"Wipe it off with a paper towel"}},{"k":"wrong_wiping_can_spread_the_acid_and_p","v":{"s":"WRONG! Wiping can spread the acid and push it into your skin. You need running water immediately."}},{"k":"apply_baking_soda_paste_directly_to_sk","v":{"s":"Apply baking soda paste directly to skin"}},{"k":"not_recommended_the_neutralization_rea","v":{"s":"Not recommended! The neutralization reaction generates heat (exothermic) which can cause additional burns. Water is always the first response."}},{"k":"it_s_dilute_just_keep_working","v":{"s":"It's dilute, just keep working"}},{"k":"dangerous_even_dilute_acids_can_cause_","v":{"s":"DANGEROUS! Even dilute acids can cause burns over time. Always treat chemical contact immediately."}},{"k":"chemical_splash_in_eyes","v":{"s":"Chemical Splash in Eyes!"}},{"k":"naoh_solution_splashes_into_your_eyes_","v":{"s":"NaOH solution splashes into your eyes while swirling the flask."}},{"k":"go_to_eyewash_station_immediately_rins","v":{"s":"Go to eyewash station immediately, rinse 15+ min, hold eyelids open"}},{"k":"correct_speed_is_everything_you_have_a","v":{"s":"Correct! Speed is everything — you have about 10 seconds before serious damage starts. Hold eyelids open and tilt head to prevent cross-contamination to the other eye."}},{"k":"rub_your_eyes_and_blink_rapidly","v":{"s":"Rub your eyes and blink rapidly"}},{"k":"never_rub_this_spreads_the_chemical_ac","v":{"s":"NEVER rub! This spreads the chemical across more of the eye surface and can scratch the cornea."}},{"k":"use_eye_drops_from_the_first_aid_kit","v":{"s":"Use eye drops from the first aid kit"}},{"k":"eye_drops_are_insufficient_you_need_hi","v":{"s":"Eye drops are insufficient! You need high-volume flushing for 15+ minutes. Eye drops cannot provide that."}},{"k":"finish_the_experiment_first_then_wash","v":{"s":"Finish the experiment first, then wash"}},{"k":"extremely_dangerous_naoh_causes_alkali","v":{"s":"EXTREMELY DANGEROUS! NaOH causes alkali burns that penetrate deeper over time. Every second counts. Chemical eye injuries are the #1 cause of lab blindness."}},{"k":"large_acid_spill_on_bench","v":{"s":"Large Acid Spill on Bench!"}},{"k":"you_knock_over_the_beaker_of_0_1m_hcl_","v":{"s":"You knock over the beaker of 0.1M HCl, spilling ~200 mL across the bench."}},{"k":"alert_others_contain_with_absorbent_ne","v":{"s":"Alert others, contain with absorbent, neutralize with NaHCO₃, clean with water"}},{"k":"perfect_procedure_1_alert_nearby_stude","v":{"s":"Perfect procedure! (1) Alert nearby students, (2) contain the spread with absorbent pads, (3) sprinkle sodium bicarbonate to neutralize, (4) clean with water, (5) dispose of waste properly."}},{"k":"just_flood_it_with_lots_of_water","v":{"s":"Just flood it with lots of water"}},{"k":"partially_right_but_incomplete_floodin","v":{"s":"Partially right but incomplete. Flooding spreads the acid further and doesn't neutralize it. Always contain first, then neutralize, then rinse."}},{"k":"tell_the_teacher_and_don_t_touch_it","v":{"s":"Tell the teacher and don't touch it"}},{"k":"telling_the_teacher_is_good_but_at_0_1","v":{"s":"Telling the teacher is good, but at 0.1M this is manageable. You should start containment immediately while someone alerts the instructor. Don't let it reach the edge of the bench."}},{"k":"soak_it_up_with_paper_towels","v":{"s":"Soak it up with paper towels"}},{"k":"paper_towels_are_not_appropriate_for_a","v":{"s":"Paper towels are not appropriate for acid spills! They don't neutralize the acid and you'll be handling acid-soaked material. Use proper spill kits."}},{"k":"mysterious_fumes_rising","v":{"s":"Mysterious Fumes Rising!"}},{"k":"while_working_with_ammonia_nh_you_noti","v":{"s":"While working with ammonia (NH₃), you notice a strong smell and your eyes start watering."}},{"k":"move_the_experiment_to_the_fume_hood_i","v":{"s":"Move the experiment to the fume hood immediately, ventilate the area"}},{"k":"correct_volatile_chemicals_like_nh_mus","v":{"s":"Correct! Volatile chemicals like NH₃ must be handled in a fume hood. If you smell it, you're breathing it. Open windows and move to fresh air if the fume hood is far away."}},{"k":"put_on_a_face_mask_and_continue","v":{"s":"Put on a face mask and continue"}},{"k":"a_regular_face_mask_does_not_protect_a","v":{"s":"A regular face mask does NOT protect against chemical fumes! You need proper respiratory protection (not available in most teaching labs) or a fume hood."}},{"k":"fan_the_fumes_away_with_your_hand","v":{"s":"Fan the fumes away with your hand"}},{"k":"fanning_is_for_wafting_to_detect_odors","v":{"s":"Fanning is for WAFTING to detect odors (gently directing air toward your nose). It does NOT remove hazardous fumes from the area. You need ventilation!"}},{"k":"it_s_just_a_little_smell_keep_going","v":{"s":"It's just a little smell, keep going"}},{"k":"dangerous_if_you_can_smell_nh_the_conc","v":{"s":"DANGEROUS! If you can smell NH₃, the concentration may exceed safe limits (25 ppm). Prolonged exposure causes chemical burns to airways. NH₃ at >300 ppm can be fatal."}},{"k":"someone_brought_bleach","v":{"s":"Someone Brought Bleach!"}},{"k":"a_classmate_suggests_cleaning_the_benc","v":{"s":"A classmate suggests cleaning the bench with bleach while you still have ammonia solution open."}},{"k":"stop_them_immediately_bleach_ammonia_t","v":{"s":"STOP them immediately! Bleach + ammonia = toxic chloramine gas"}},{"k":"life_saving_action_naocl_2nh_2nh_cl_ch","v":{"s":"LIFE-SAVING action! NaOCl + 2NH₃ → 2NH₂Cl (chloramine) — a toxic gas that causes severe respiratory damage. This is one of the most dangerous accidental mixings in a lab. Always neutralize and remove all chemicals before using any cleaning agents."}},{"k":"sure_bleach_is_a_disinfectant_it_shoul","v":{"s":"Sure, bleach is a disinfectant, it should be fine"}},{"k":"extremely_dangerous_mixing_bleach_naoc","v":{"s":"EXTREMELY DANGEROUS! Mixing bleach (NaOCl) with ammonia produces toxic chloramine gas. This has caused deaths in laboratories and homes. NEVER mix bleach with any other chemical."}},{"k":"it_should_be_fine_if_the_ammonia_is_di","v":{"s":"It should be fine if the ammonia is diluted"}},{"k":"wrong_even_dilute_ammonia_reacts_with_","v":{"s":"WRONG! Even dilute ammonia reacts with bleach to produce toxic chloramine gas. The reaction occurs at ANY concentration. There is no safe dilution for mixing these chemicals."}},{"k":"just_open_a_window_and_it_will_be_fine","v":{"s":"Just open a window and it will be fine"}},{"k":"ventilation_does_not_make_it_safe_to_g","v":{"s":"Ventilation does NOT make it safe to generate toxic gas! Chloramine causes immediate respiratory distress. Prevention is the only acceptable approach."}},{"k":"burette","v":{"s":"Burette"}},{"k":"delivers_precise_volumes_of_titrant","v":{"s":"Delivers precise volumes of titrant."}},{"k":"erlenmeyer_flask","v":{"s":"Erlenmeyer Flask"}},{"k":"holds_the_analyte_solution_being_titra","v":{"s":"Holds the analyte solution being titrated."}},{"k":"volumetric_pipette","v":{"s":"Volumetric Pipette"}},{"k":"measures_exact_volumes_of_analyte","v":{"s":"Measures exact volumes of analyte."}},{"k":"ph_indicator","v":{"s":"pH Indicator"}},{"k":"changes_color_to_signal_the_endpoint","v":{"s":"Changes color to signal the endpoint."}},{"k":"wash_bottle","v":{"s":"Wash Bottle"}},{"k":"contains_distilled_water_for_rinsing","v":{"s":"Contains distilled water for rinsing."}},{"k":"goggles_gloves_and_lab_coat","v":{"s":"Goggles, gloves, and lab coat"}},{"k":"all_three_are_mandatory_goggles_protec","v":{"s":"All three are mandatory: goggles protect eyes from splashes, gloves protect hands from corrosives, and the lab coat protects clothing and skin."}},{"k":"rinse_with_running_water_for_15_min","v":{"s":"Rinse with running water for 15+ min"}},{"k":"water_first_always_the_15_minute_rinse","v":{"s":"Water first, always! The 15-minute rinse is critical. Neutralizers can cause exothermic reactions on skin."}},{"k":"where_moles_of_acid_moles_of_base","v":{"s":"Where moles of acid = moles of base"}},{"k":"the_equivalence_point_is_the_stoichiom","v":{"s":"The equivalence point is the stoichiometric point. The pH at equivalence depends on acid/base strength — it's only pH 7 for strong acid + strong base."}},{"k":"the_exothermic_reaction_can_cause_viol","v":{"s":"The exothermic reaction can cause violent boiling and splashing"}},{"k":"when_water_hits_concentrated_acid_the_","v":{"s":"When water hits concentrated acid, the heat released can boil the water instantly, causing a violent splash of hot acid. Adding acid to water spreads the heat through a larger water volume."}},{"k":"above_7","v":{"s":"Above 7"}},{"k":"at_equivalence_only_the_conjugate_base","v":{"s":"At equivalence, only the conjugate base (A⁻) remains. Conjugate bases of weak acids are themselves weak bases, making the solution basic (pH > 7)."}},{"k":"strong_acid_strong_base_or_weak_acid_s","v":{"s":"Strong acid + Strong base or Weak acid + Strong base"}},{"k":"phenolphthalein_transitions_at_ph_8_2_","v":{"s":"Phenolphthalein transitions at pH 8.2-10.0, which matches the basic equivalence pH of weak acid + strong base titrations. It also works for SA+SB since the sharp jump crosses its range."}},{"k":"ammonia_or_acids","v":{"s":"Ammonia or acids"}},{"k":"bleach_ammonia_chloramine_gas_toxic_bl","v":{"s":"Bleach + ammonia = chloramine gas (toxic). Bleach + acid = chlorine gas (toxic). Both can cause severe respiratory injury or death. NEVER combine bleach with any chemical."}},{"k":"23_45_has_4_significant_figures_the_la","v":{"s":"23.45 has 4 significant figures. The last digit (5) is estimated between the graduations. Burettes are precise to ±0.05 mL."}},{"k":"ph_pka","v":{"s":"pH = pKa"}},{"k":"at_half_equivalence_ha_a_so_henderson_","v":{"s":"At half-equivalence, [HA] = [A⁻], so Henderson–Hasselbalch gives pH = pKa + log(1) = pKa. This is the center of the buffer region."}},{"k":"when_handling_1m_concentrated_acids_or","v":{"s":"When handling >1M concentrated acids or bases"}},{"k":"face_shields_provide_splash_protection","v":{"s":"Face shields provide splash protection for the entire face. Required for concentrated (>1M) corrosives, heating operations, and any procedure with splash risk beyond the eye area."}},{"k":"suit_up","v":{"s":"Suit Up"}},{"k":"lab_scan","v":{"s":"Lab Scan"}},{"k":"chemicals","v":{"s":"Chemicals"}},{"k":"safety_drill","v":{"s":"Safety Drill"}},{"k":"naoh_causes_alkali_burns_that_penetrat","v":{"s":"NaOH causes alkali burns that penetrate the eye within 10 seconds. Without goggles, a single splash can cause permanent vision loss."}},{"k":"concentrated_hcl_dissolves_skin_on_con","v":{"s":"Concentrated HCl dissolves skin on contact. Even dilute acids cause irritation. Your hands are closest to the chemicals."}},{"k":"a_splash_of_acid_or_base_will_burn_thr","v":{"s":"A splash of acid or base will burn through clothing and skin. Lab coats provide a removable barrier layer."}},{"k":"a_dropped_beaker_sends_glass_and_chemi","v":{"s":"A dropped beaker sends glass and chemicals across the floor. Open-toed shoes mean acid on bare feet."}},{"k":"lab_access_granted","v":{"s":"Lab Access Granted"}},{"k":"all_safety_protocols_confirmed","v":{"s":"All safety protocols confirmed"}},{"k":"back","v":{"s":"Back"}},{"k":"back_2","v":{"s":"← Back"}},{"k":"lab_safety_briefing","v":{"s":"Lab Safety Briefing"}},{"k":"personal_protective_equipment","v":{"s":"🛡️ Personal Protective Equipment"}},{"k":"equip_each_piece_of_ppe_before_proceed","v":{"s":"Equip each piece of PPE before proceeding. In a real lab, you cannot touch chemicals without full protection."}},{"k":"equipped_protected","v":{"s":"✔ EQUIPPED — Protected"}},{"k":"continue_to_lab_scan_station","v":{"s":"Continue to Lab Scan station"}},{"k":"continue_to_lab_scan","v":{"s":"🔬 Continue to Lab Scan →"}},{"k":"locate_emergency_equipment","v":{"s":"🔍 Locate Emergency Equipment"}},{"k":"find_each_piece_of_safety_equipment_on","v":{"s":"Find each piece of safety equipment on the lab map. In a real emergency, seconds matter — you must know where everything is BEFORE you start."}},{"k":"fume_hood","v":{"s":"FUME HOOD"}},{"k":"bench_1","v":{"s":"Bench 1"}},{"k":"bench_2","v":{"s":"Bench 2"}},{"k":"bench_3","v":{"s":"Bench 3"}},{"k":"you_are_here","v":{"s":"YOU ARE HERE"}},{"k":"sink","v":{"s":"Sink"}},{"k":"fire_ext","v":{"s":"FIRE EXT."}},{"k":"sds_binder","v":{"s":"SDS BINDER"}},{"k":"locate_eyewash_station","v":{"s":"Locate eyewash station"}},{"k":"locate_fire_extinguisher","v":{"s":"Locate fire extinguisher"}},{"k":"locate_sds_binder","v":{"s":"Locate SDS binder"}},{"k":"eyewash_station_located_2","v":{"s":"🚿 Eyewash Station Located!"}},{"k":"the_10_second_rule_if_chemicals_splash","v":{"s":"THE 10-SECOND RULE: If chemicals splash in your eyes, you have approximately 10 seconds to reach the eyewash before permanent damage begins. Hold eyelids open and rinse for 15+ minutes."}},{"k":"fire_extinguisher_located_2","v":{"s":"🧯 Fire Extinguisher Located!"}},{"k":"remember_p_a_s_s_pull_the_pin_aim_at_b","v":{"s":"Remember P.A.S.S.: Pull the pin, Aim at base of fire, Squeeze handle, Sweep side to side. Acetic acid and some solvents are flammable — know this location before you begin."}},{"k":"safety_data_sheets_located","v":{"s":"📋 Safety Data Sheets Located!"}},{"k":"sds_documents_list_all_hazards_require","v":{"s":"SDS documents list ALL hazards, required PPE, first aid procedures, and emergency contacts for every chemical in the lab. Review them BEFORE handling any substance."}},{"k":"eyewash","v":{"s":"Eyewash"}},{"k":"fire_ext_2","v":{"s":"Fire Ext."}},{"k":"sds_binder_2","v":{"s":"SDS Binder"}},{"k":"lab_safety_map_complete","v":{"s":"🗺️ Lab Safety Map Complete!"}},{"k":"you_can_now_locate_all_emergency_equip","v":{"s":"You can now locate all emergency equipment from your bench. In an emergency, every second counts — this knowledge could save a life."}},{"k":"back_to_ppe_station","v":{"s":"Back to PPE station"}},{"k":"ppe","v":{"s":"← PPE"}},{"k":"continue_to_chemical_briefing","v":{"s":"Continue to Chemical Briefing"}},{"k":"continue_to_chemical_briefing_2","v":{"s":"☣️ Continue to Chemical Briefing →"}},{"k":"chemical_hazard_briefing","v":{"s":"☣️ Chemical Hazard Briefing"}},{"k":"review_every_chemical_you_will_handle_","v":{"s":"Review EVERY chemical you will handle today. Tap each card to acknowledge you understand the hazards."}},{"k":"first_aid","v":{"s":"🏥 First Aid: "}},{"k":"tap_to_acknowledge_you_ve_reviewed_thi","v":{"s":"☝ Tap to acknowledge you’ve reviewed this chemical"}},{"k":"back_to_lab_scan","v":{"s":"Back to Lab Scan"}},{"k":"lab_scan_2","v":{"s":"← Lab Scan"}},{"k":"continue_to_safety_drill","v":{"s":"Continue to Safety Drill"}},{"k":"continue_to_safety_drill_2","v":{"s":"🚨 Continue to Safety Drill →"}},{"k":"emergency_response_drill","v":{"s":"🚨 Emergency Response Drill"}},{"k":"begin_safety_drill","v":{"s":"Begin safety drill"}},{"k":"begin_emergency_drill","v":{"s":"🚨 Begin Emergency Drill"}},{"k":"correct_response","v":{"s":"✅ Correct response:"}},{"k":"back_to_chemical_briefing","v":{"s":"Back to Chemical Briefing"}},{"k":"chemicals_2","v":{"s":"← Chemicals"}},{"k":"retry_drill","v":{"s":"Retry drill"}},{"k":"retry_drill_2","v":{"s":"↺ Retry Drill"}},{"k":"enter_lab_safety_confirmed","v":{"s":"Enter lab — safety confirmed"}},{"k":"lab_safety_confirmed_enter_virtual_lab","v":{"s":"🧪 Lab Safety Confirmed — Enter Virtual Lab"}},{"k":"titration_lab_keyboard_shortcuts_1_thr","v":{"s":"Titration Lab. Keyboard shortcuts: 1 through 5 switch tabs."}},{"k":"ppe_active_lab_safety_verified","v":{"s":"PPE Active • Lab Safety Verified"}},{"k":"safety_info","v":{"s":"Safety Info"}},{"k":"safety_info_2","v":{"s":"⚠️ Safety Info"}},{"k":"hazards","v":{"s":"Hazards"}},{"k":"hazards_2","v":{"s":"☣️ Hazards"}},{"k":"quick_safety_reference","v":{"s":"⚠️ Quick Safety Reference"}},{"k":"eyewash_10_second_rule_fire_extinguish","v":{"s":"🚿 Eyewash: 10-second rule • 🧯 Fire extinguisher located • 📋 SDS reviewed"}},{"k":"chemical_hazard_information","v":{"s":"☣️ Chemical Hazard Information"}},{"k":"first_aid_2","v":{"s":"First Aid: "}},{"k":"safety_tip","v":{"s":"Safety Tip"}},{"k":"back_3","v":{"s":"Back"}},{"k":"back_4","v":{"s":"← Back"}},{"k":"virtual_titration_lab","v":{"s":"🧪 Virtual Titration Lab"}},{"k":"ml_burette","v":{"s":" mL)  •  Burette: "}},{"k":"titrate","v":{"s":"🧪 Titrate"}},{"k":"challenge","v":{"s":"🏆 Challenge"}},{"k":"safety_drills","v":{"s":"🚨 Safety Drills"}},{"k":"equipment","v":{"s":"🔬 Equipment"}},{"k":"dilution_calc","v":{"s":"🧮 Dilution Calc"}},{"k":"buffers","v":{"s":"🛡️ Buffers"}},{"k":"titrate_find_the_equivalence_point","v":{"s":"Titrate — find the equivalence point"}},{"k":"add_titrant_drop_by_drop_until_indicat","v":{"s":"Add titrant drop-by-drop until indicator changes color. Equivalence point = stoichiometric balance; endpoint = where indicator switches. They are not exactly the same."}},{"k":"challenge_graded_titrations","v":{"s":"Challenge — graded titrations"}},{"k":"match_real_world_unknowns_by_titrating","v":{"s":"Match real-world unknowns by titrating to within ±0.05 mL of theoretical. Tracks accuracy + speed; AP Chem-aligned scoring."}},{"k":"safety_drills_what_could_go_wrong","v":{"s":"Safety drills — what could go wrong"}},{"k":"burette_explodes_acid_burns_spill_indi","v":{"s":"Burette explodes, acid-burns spill, indicator added too early. Practice the right response sequence before it matters in a real lab."}},{"k":"equipment_burette_flask_pipette","v":{"s":"Equipment — burette, flask, pipette"}},{"k":"burette_tolerance_0_05_ml_volumetric_f","v":{"s":"Burette tolerance 0.05 mL; volumetric flask 0.10 mL; pipette 0.02 mL. Precision class A vs B doubles tolerance. Calibration matters more than students realize."}},{"k":"dilution_calculator_m_v_m_v","v":{"s":"Dilution calculator — M₁V₁ = M₂V₂"}},{"k":"stock_diluent_desired_concentration_th","v":{"s":"Stock + diluent → desired concentration. The 4 most-tested AP Chem problems all reduce to this single equation. Track significant figures: weakest measurement sets the answer."}},{"k":"buffer_discovery_when_does_a_buffer_ho","v":{"s":"Buffer discovery — when does a buffer hold?"}},{"k":"adjust_acid_strength_a_ha_ratio_starti","v":{"s":"Adjust acid strength, [A⁻]/[HA] ratio, starting pH. Discrete outcome: good buffer or poor buffer (after 20% more acid added). No score, no reveal — just sweep and observe."}},{"k":"endpoint_equivalence","v":{"s":"⚠ Endpoint ≠ equivalence. "}},{"k":"good_indicator_choice","v":{"s":"✔ Good indicator choice. "}},{"k":"redox_titration_not_a_ph_curve","v":{"s":"⚗ Redox titration — not a pH curve. "}},{"k":"the_trace_shows_relative_reaction_prog","v":{"s":"The trace shows relative reaction progress, not pH — there is no pH meter here. The endpoint is the first faint, lasting pink from a tiny excess of MnO₄⁻ (it reacts purple → colorless until then). Read this endpoint by COLOR."}},{"k":"titrant_volume","v":{"s":"TITRANT VOLUME:"}},{"k":"titrant_volume_2","v":{"s":"Titrant volume"}},{"k":"reset_titration_volume_to_zero","v":{"s":"Reset titration volume to zero"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"burette_flask","v":{"s":"BURETTE & FLASK"}},{"k":"current_ph","v":{"s":"CURRENT pH"}},{"k":"titration_curve","v":{"s":"TITRATION CURVE"}},{"k":"buffer_region","v":{"s":"Buffer Region"}},{"k":"ph_7","v":{"s":"pH 7"}},{"k":"volume_of_titrant_ml","v":{"s":"Volume of Titrant (mL)"}},{"k":"current_ph_2","v":{"s":"CURRENT pH"}},{"k":"volume_added","v":{"s":"VOLUME ADDED"}},{"k":"equivalence_point","v":{"s":"EQUIVALENCE POINT"}},{"k":"titration_science","v":{"s":"📖 Titration Science"}},{"k":"what_is_titration","v":{"s":"What is Titration?"}},{"k":"henderson_hasselbalch_equation","v":{"s":"Henderson–Hasselbalch Equation"}},{"k":"ph_pk_log_a_ha","v":{"s":"pH = pKₐ + log([A⁻] / [HA])"}},{"k":"key_concepts","v":{"s":"Key Concepts"}},{"k":"equivalence_point_2","v":{"s":"Equivalence Point"}},{"k":"where_moles_of_acid_moles_of_base_the_","v":{"s":" — Where moles of acid = moles of base. The pH at this point depends on the acid/base strength."}},{"k":"endpoint","v":{"s":"Endpoint"}},{"k":"where_the_indicator_changes_color_idea","v":{"s":" — Where the indicator changes color. Ideally chosen so the endpoint ≈ equivalence point."}},{"k":"buffer_region_2","v":{"s":"Buffer Region"}},{"k":"the_flat_part_of_a_weak_acid_base_curv","v":{"s":" — The flat part of a weak acid/base curve where pH resists change (Henderson–Hasselbalch applies)."}},{"k":"indicators","v":{"s":"Indicators"}},{"k":"weak_acids_bases_that_change_color_at_","v":{"s":" — Weak acids/bases that change color at specific pH ranges. Choose one whose transition range includes the equivalence pH."}},{"k":"lab_safety_best_practices","v":{"s":"⚠️ Lab Safety Best Practices"}},{"k":"spill_response","v":{"s":"🧪 Spill Response"}},{"k":"acid_spill_neutralize_with_sodium_bica","v":{"s":" — Acid spill: neutralize with sodium bicarbonate, then rinse. Base spill: neutralize with dilute citric acid. Always alert others in the lab."}},{"k":"never_mix","v":{"s":"❌ Never Mix"}},{"k":"never_mix_bleach_with_ammonia_toxic_ch","v":{"s":" — Never mix bleach with ammonia (toxic chloramine gas). Never add water to concentrated acid (exothermic splash risk — always add acid to water)."}},{"k":"equipment_2","v":{"s":"🧪 Equipment"}},{"k":"rinse_the_burette_with_the_titrant_sol","v":{"s":" — Rinse the burette with the titrant solution before filling. Swirl the flask gently after each addition. Read the burette at the meniscus bottom."}},{"k":"waste_disposal","v":{"s":"♻️ Waste Disposal"}},{"k":"neutralized_acid_base_solutions_ph_6_8","v":{"s":" — Neutralized acid/base solutions (pH 6–8) can go down the drain with excess water. Check your institution's chemical waste policy for concentrated solutions."}},{"k":"plain","v":{"s":"Plain"}},{"k":"using_simple_everyday_words_and_short_","v":{"s":"using simple everyday words and short sentences"}},{"k":"grade_5","v":{"s":"Grade 5"}},{"k":"for_a_5th_grade_student_brief_and_frie","v":{"s":"for a 5th grade student, brief and friendly"}},{"k":"high_school","v":{"s":"High School"}},{"k":"for_a_high_school_chemistry_student_ac","v":{"s":"for a high school chemistry student, accurate but accessible"}},{"k":"ai_titration_tutor","v":{"s":"AI titration tutor"}},{"k":"explain_at_my_level","v":{"s":"✨ Explain at my level"}},{"k":"reading_level","v":{"s":"Reading level"}},{"k":"click_explain_to_have_the_ai_tutor_des","v":{"s":"Click “Explain” to have the AI tutor describe this titration at your chosen reading level."}},{"k":"lab_safety_chemistry_challenge","v":{"s":"🏆 Lab Safety & Chemistry Challenge"}},{"k":"next_question","v":{"s":"Next Question"}},{"k":"next_question_2","v":{"s":"Next Question →"}},{"k":"lab_safety_incident_simulator","v":{"s":"🚨 Lab Safety Incident Simulator"}},{"k":"practice_responding_to_real_lab_emerge","v":{"s":"Practice responding to real lab emergencies. Choose the correct response to each scenario. These drills could save your life in a real lab!"}},{"k":"what_do_you_do","v":{"s":"What do you do?"}},{"k":"next_scenario","v":{"s":"Next Scenario"}},{"k":"next_scenario_2","v":{"s":"Next Scenario →"}},{"k":"lab_equipment_proper_technique","v":{"s":"🔬 Lab Equipment & Proper Technique"}},{"k":"master_the_correct_technique_for_each_","v":{"s":"Master the correct technique for each piece of equipment. Good technique = accurate results + safe lab work."}},{"k":"correct_technique","v":{"s":"✅ Correct Technique"}},{"k":"common_errors","v":{"s":"⚠️ Common Errors"}},{"k":"safety_note","v":{"s":"🛡️ Safety Note"}},{"k":"dilution_molarity_calculator","v":{"s":"🧮 Dilution & Molarity Calculator"}},{"k":"c_v_c_v_calculate_how_to_dilute_a_stoc","v":{"s":"C₁V₁ = C₂V₂ — Calculate how to dilute a stock solution to a target concentration."}},{"k":"critical_safety_reminder","v":{"s":"CRITICAL SAFETY REMINDER"}},{"k":"always_add_acid_to_water_never_water_t","v":{"s":"Always add acid TO water, never water to acid. Exothermic mixing can cause violent boiling and splash concentrated acid."}},{"k":"stock_solution","v":{"s":"Stock Solution"}},{"k":"c_concentration","v":{"s":"C₁ (Concentration)"}},{"k":"stock_solution_concentration","v":{"s":"Stock solution concentration"}},{"k":"v_volume_needed","v":{"s":"V₁ (Volume needed)"}},{"k":"calculated_from_c_v_c","v":{"s":"Calculated from C₂V₂/C₁"}},{"k":"desired_solution","v":{"s":"Desired Solution"}},{"k":"c_target_concentration","v":{"s":"C₂ (Target concentration)"}},{"k":"target_concentration","v":{"s":"Target concentration"}},{"k":"v_final_volume","v":{"s":"V₂ (Final volume)"}},{"k":"final_volume","v":{"s":"Final volume"}},{"k":"dilution_procedure","v":{"s":"📐 Dilution Procedure"}},{"k":"add_the_stock_solution_to_the_water_ne","v":{"s":"Add the stock solution TO the water (never water to acid!)"}},{"k":"stopper_and_invert_10_times_to_mix_tho","v":{"s":"Stopper and invert 10 times to mix thoroughly"}},{"k":"dilution_factor","v":{"s":"Dilution Factor"}},{"k":"water_to_add","v":{"s":"Water to Add"}},{"k":"moles_solute","v":{"s":"Moles Solute"}},{"k":"save_titration_snapshot","v":{"s":"Save titration snapshot"}},{"k":"titration_lab","v":{"s":"Titration Lab"}},{"k":"snapshot","v":{"s":"📸 Snapshot"}},{"k":"titration_curve_finding_the_equivalenc","v":{"s":"Titration Curve — Finding the equivalence point"}},{"k":"strong_acid_strong_base_ph_meter_shows","v":{"s":"strong acid + strong base · pH meter shows the jump"}},{"k":"good_buffer","v":{"s":"🛡️ GOOD BUFFER"}},{"k":"poor_buffer","v":{"s":"💥 POOR BUFFER"}},{"k":"buffer_strength_discovery","v":{"s":"🛡️ Buffer strength discovery"}},{"k":"three_sliders_weak_acid_strength_ka_bu","v":{"s":"Three sliders: weak acid strength (Ka), buffer ratio [A⁻]/[HA], and starting pH. The simulation tells you whether the buffer HOLDS or FAILS after adding 20% more acid (discrete outcome — no numeric \"buffer score\"). Sweep the sliders. Log observations. Type what you discover about what makes a good buffer."}},{"k":"acid_strength_pka","v":{"s":"Acid strength (pKa)"}},{"k":"a_ha_ratio","v":{"s":"[A⁻]/[HA] ratio"}},{"k":"starting_ph_display_only","v":{"s":"Starting pH (display only)"}},{"k":"log_observation","v":{"s":"📋 Log observation"}},{"k":"reset_2","v":{"s":"↺ Reset"}},{"k":"your_hypothesis_free_text_no_right_ans","v":{"s":"Your hypothesis (free text — no right answer):"}},{"k":"what_single_condition_makes_the_differ","v":{"s":"What single condition makes the difference between GOOD and POOR? Does ratio matter more than pKa? Does the starting pH matter at all? Type your own theory."}},{"k":"i_m_stuck_show_me_questions_to_think_a","v":{"s":"🤔 I'm stuck — show me questions to think about (no answers)"}},{"k":"open_questions_investigate_by_manipula","v":{"s":"Open questions — investigate by manipulating:"}},{"k":"fix_ratio_at_1_0_sweep_pka_from_2_to_1","v":{"s":"Fix ratio at 1.0. Sweep pKa from 2 to 12. Are some pKa values just inherently better buffers? Why might that be?"}},{"k":"set_pka_4_74_acetic_acid_sweep_ratio_f","v":{"s":"Set pKa = 4.74 (acetic acid). Sweep ratio from 0.05 to 20. At which ratios does the buffer hold? Is there a symmetric \"good band\"?"}},{"k":"find_one_good_buffer_then_change_one_s","v":{"s":"Find one GOOD buffer. Then change ONE slider until it becomes POOR. Which single change was most efficient?"}},{"k":"log_4_5_good_buffers_with_different_pk","v":{"s":"Log 4-5 GOOD buffers with different pKa values. What do their starting pH values have in common with their pKa?"}},{"k":"in_real_biochemistry_blood_is_buffered","v":{"s":"In real biochemistry, blood is buffered at pH 7.4 — what pKa would be ideal for that buffer system? Investigate by looking up phosphate and bicarbonate buffers."}},{"k":"no_answers_will_be_revealed_investigat","v":{"s":"No answers will be revealed. Investigate."}},{"k":"i_think_i_understand_the_trade_offs_le","v":{"s":"I think I understand the trade-offs — let me explain them in my own words"}},{"k":"explain_in_your_own_words_what_is_the_","v":{"s":"Explain in your own words: what is the relationship between pKa, ratio, and starting pH? What single condition (or combination) makes a buffer hold against more acid? Why does ratio range matter?"}},{"k":"saved_notice_nobody_checked_your_answe","v":{"s":"✓ Saved. Notice — nobody checked your answer. That is what learner-driven inquiry looks like."}},{"k":"design_note_no_buffer_capacity_score_n","v":{"s":"Design note: no buffer-capacity score, no reveal button, no quiz validation. Outcome is shown as a discrete 2-state marker (GOOD / POOR), not a continuous gradient — by design, to discourage optimization-gaming behavior. The point is the inquiry, not the number."}},{"k":"safety_equipment_map","v":{"s":"Safety equipment map. Locate the eyewash, fire extinguisher, and SDS station."}},{"k":"safety_drill_countdown","v":{"s":"Safety drill countdown"}},{"k":"resume_safety_drill","v":{"s":"Resume safety drill"}},{"k":"pause_safety_drill","v":{"s":"Pause safety drill"}},{"k":"resume","v":{"s":"Resume"}},{"k":"pause","v":{"s":"Pause"}},{"k":"add_fifteen_seconds","v":{"s":"Add 15 seconds to safety drill"}},{"k":"flask_diagram","v":{"s":"Titration flask diagram showing the current pH and indicator state."}},{"k":"above","v":{"s":"20 cm above"}},{"k":"accuracy","v":{"s":"Accuracy"}},{"k":"aliquot","v":{"s":"Aliquot in flask"}},{"k":"analyte","v":{"s":"Analyte"}},{"k":"at_half_equivalence_e_equals_e0","v":{"s":"At half-equivalence exactly half the Fe²⁺ has been oxidised, so [Fe³⁺] = [Fe²⁺], the log term in the Nernst equation goes to zero, and the electrode reads E° for the couple itself — the redox twin of pH = pKa."}},{"k":"axis_cell_potential","v":{"s":"Cell potential (V)"}},{"k":"below","v":{"s":"20 cm below"}},{"k":"bench_fallback","v":{"s":"The 3D bench needs WebGL. The table below carries the same comparison."}},{"k":"bench_hint","v":{"s":"Drag or arrow keys — orbit · heights are equalised, bores are true"}},{"k":"bench_punchline_a","v":{"s":"In the "}},{"k":"bench_punchline_b","v":{"s":", one millilitre stands "}},{"k":"bench_punchline_c","v":{"s":" mm tall — about "}},{"k":"bench_punchline_d","v":{"s":"× what the same millilitre manages in a 250 mL beaker, where it is a "}},{"k":"bench_punchline_e","v":{"s":" mm film you could not see, let alone read. That is the entire reason you titrate from a burette and not out of a beaker."}},{"k":"bore_explains_tolerance","v":{"s":"A tolerance is not an arbitrary number stamped on the glass — it follows from how wide the vessel is where you read it. The blue slice in each vessel below is one millilitre, drawn to scale against that vessel's real bore."}},{"k":"cell_potential_caps","v":{"s":"CELL POTENTIAL"}},{"k":"challenge_mode","v":{"s":"Challenge mode"}},{"k":"concentration_error","v":{"s":"Concentration error"}},{"k":"concordant","v":{"s":"concordant ✓"}},{"k":"deliver","v":{"s":"Deliver "}},{"k":"deliver_titrant","v":{"s":"DELIVER TITRANT"}},{"k":"determine_a_concentration","v":{"s":"Determine a concentration"}},{"k":"elevation_note","v":{"s":"Side elevation. The green line is where the meniscus really sits; the amber line is where your sight line crosses the scale."}},{"k":"exag_note","v":{"s":"Drawn as a wide bore seen from close in, so the effect is visible — about "}},{"k":"exag_note_tail","v":{"s":"× life. The numbers on the scale and the millilitre figures come from real burette geometry, not from the picture."}},{"k":"explain_label","v":{"s":"Your explanation"}},{"k":"eye_height","v":{"s":"Eye height vs the meniscus"}},{"k":"finish_and_report","v":{"s":"✅ Finish and report the mean"}},{"k":"flask_diagram_redox","v":{"s":"Titration flask diagram showing the permanganate colour of the solution."}},{"k":"fresh_sample","v":{"s":"↺ Fresh sample"}},{"k":"get_level","v":{"s":"Get level"}},{"k":"gl_hint","v":{"s":"Drag or arrow keys — orbit · scroll or ± — zoom · 0 — reset"}},{"k":"graded_unknown","v":{"s":"🎯 Graded unknown"}},{"k":"in_the_flask","v":{"s":"IN THE FLASK"}},{"k":"indicator_label","v":{"s":"Indicator"}},{"k":"mean_is_biased","v":{"s":"Mean is biased"}},{"k":"mean_is_off_by","v":{"s":"mean off by "}},{"k":"mean_is_right","v":{"s":"Mean is right"}},{"k":"mean_of","v":{"s":"Mean of "}},{"k":"methyl_red","v":{"s":"Methyl Red"}},{"k":"ml_from_truth","v":{"s":" mL from the true value. Repeating a measurement cannot reveal an error that repeats with it — that is a SYSTEMATIC error, and no number of extra trials will average it away."}},{"k":"ml_over","v":{"s":" mL over "}},{"k":"ml_yet_sit","v":{"s":" mL, yet their mean sits "}},{"k":"need_two","v":{"s":"Select at least two concordant titres before reporting."}},{"k":"new_unknown","v":{"s":"🎲 New unknown"}},{"k":"next_unknown","v":{"s":"→ Next unknown"}},{"k":"no_ph_meter","v":{"s":"No pH readout in graded mode — you judge the endpoint the way you would at a real bench."}},{"k":"not_concordant","v":{"s":"not concordant — run another"}},{"k":"obs_flash","v":{"s":"A flash of colour where each drop lands — it disappears when you swirl. Slow down: you are one drop away."}},{"k":"obs_none","v":{"s":"No colour change yet."}},{"k":"obs_over","v":{"s":"Strong, deep colour throughout — you have gone past the endpoint."}},{"k":"obs_persist","v":{"s":"Faint colour that PERSISTS after swirling. This is the endpoint — stop here."}},{"k":"one_drop_is","v":{"s":"One drop = "}},{"k":"precise_not_accurate_body","v":{"s":"Your replicates agree with each other to "}},{"k":"precise_not_accurate_head","v":{"s":"⚠ Precise, but not accurate. "}},{"k":"precision","v":{"s":"Precision"}},{"k":"question_bank","v":{"s":"❓ Question bank"}},{"k":"read_the_burette","v":{"s":"READ THE BURETTE"}},{"k":"record_trial","v":{"s":"📋 Record trial "}},{"k":"redox_colour_and_formal_potential","v":{"s":"You can also read the endpoint by eye — permanganate is self-indicating: it goes purple → colourless as it reacts, so the first faint lasting pink means a trace is left over. Two honest caveats: real 1 M H₂SO₄ shifts the iron couple down to a formal potential near 0.68 V because sulfate complexes Fe³⁺, and at exactly 0 mL the potential is undefined (no Fe³⁺ yet) — the curve starts from the trace of Fe³⁺ that air oxidation always leaves."}},{"k":"redox_potentiometric_curve","v":{"s":"⚗ Redox titration — the y-axis is volts, not pH. "}},{"k":"redox_potentiometric_explainer","v":{"s":"You follow a redox titration with a platinum electrode on a potentiometer. Before equivalence the Fe³⁺/Fe²⁺ couple sets the potential; after it, the leftover MnO₄⁻/Mn²⁺ couple takes over. The near-vertical jump between them is the endpoint."}},{"k":"replicates_agree","v":{"s":"Replicates agree"}},{"k":"replicates_scatter","v":{"s":"Replicates scatter"}},{"k":"reset_view","v":{"s":"Reset view"}},{"k":"run_log","v":{"s":"Run log"}},{"k":"safety_and_theory_mcqs","v":{"s":"Safety and theory MCQs"}},{"k":"spread_is","v":{"s":"spread "}},{"k":"spread_label","v":{"s":"spread "}},{"k":"sr_above","v":{"s":"above"}},{"k":"sr_below","v":{"s":"below"}},{"k":"sr_by","v":{"s":" by "}},{"k":"sr_centimetres","v":{"s":" centimetres "}},{"k":"sr_cm","v":{"s":" cm "}},{"k":"sr_currently","v":{"s":". Currently "}},{"k":"sr_curve_for","v":{"s":"Titration curve for "}},{"k":"sr_equiv_near","v":{"s":". Equivalence point near "}},{"k":"sr_exactly_at","v":{"s":"exactly at the meniscus."}},{"k":"sr_eye_level_meets","v":{"s":"The eye is level with the meniscus and the sight line meets the scale at the true reading of "}},{"k":"sr_level_suffix","v":{"s":" level"}},{"k":"sr_level_with","v":{"s":"level with"}},{"k":"sr_level_with_meniscus","v":{"s":"Level with the meniscus"}},{"k":"sr_meniscus_crosses","v":{"s":" the meniscus. The sight line crosses the scale "}},{"k":"sr_meniscus_so_crosses","v":{"s":" the meniscus, so the sight line crosses the scale at "}},{"k":"sr_millilitres","v":{"s":" millilitres."}},{"k":"sr_minus","v":{"s":"minus "}},{"k":"sr_ml_added_at","v":{"s":" mL of titrant added at "}},{"k":"sr_ml_at","v":{"s":" mL at "}},{"k":"sr_ml_fresh_aliquot","v":{"s":" millilitres. Fresh aliquot in the flask."}},{"k":"sr_ml_instead_of_true","v":{"s":" millilitres instead of the true "}},{"k":"sr_molar_from","v":{"s":" molar from "}},{"k":"sr_outside_tol","v":{"s":"Outside this activity’s 0.05 millilitre stopping target."}},{"k":"sr_plus","v":{"s":"plus "}},{"k":"sr_reading_error","v":{"s":". Reading error "}},{"k":"sr_reading_level","v":{"s":"Reading level: "}},{"k":"sr_recorded_at","v":{"s":" recorded at "}},{"k":"sr_reported","v":{"s":"Reported. "}},{"k":"sr_seconds_remaining","v":{"s":" seconds remaining"}},{"k":"sr_selected","v":{"s":" (selected)"}},{"k":"sr_side_view","v":{"s":"Side view: eye "}},{"k":"sr_the_eye_is","v":{"s":"The eye is "}},{"k":"sr_too_high","v":{"s":"too high"}},{"k":"sr_too_low","v":{"s":"too low"}},{"k":"sr_trial_word","v":{"s":"Trial "}},{"k":"sr_trials_dot","v":{"s":" trials. "}},{"k":"sr_true_level_so","v":{"s":" the true level, so the reading is "}},{"k":"sr_within_tol","v":{"s":"Within tolerance."}},{"k":"titrant_known","v":{"s":"Titrant (known)"}},{"k":"trials","v":{"s":"🧾 TRIALS"}},{"k":"trials_suffix","v":{"s":" trials"}},{"k":"trials_was","v":{"s":" trials was "}},{"k":"true_equivalence_was","v":{"s":"True equivalence was at "}},{"k":"true_value","v":{"s":"True value"}},{"k":"unknown_run","v":{"s":"Unknown"}},{"k":"why_tolerances_differ","v":{"s":"📐 WHY THE TOLERANCES DIFFER"}},{"k":"your_answer","v":{"s":"Your answer"}},{"k":"your_mean_was","v":{"s":"the mean of your "}}],"id":588}},{"k":"tools_menu","v":{"o":[{"k":"2d_side_view_physics_sandbox_force","v":{"s":"2D side-view physics sandbox (force vectors, energy graph) + gearing lab (chainring/cassette math, climb sim) + hands-on repair simulator (patch tube, brakes, chain, derailleur)."}},{"k":"3d_building_with_blocks_columns_arches","v":{"s":"3D building with blocks, columns, arches, and ramps. Snap to grid, measure, and export STL."}},{"k":"3d_interactive_solar_system_with_orbit","v":{"s":"3D interactive solar system with orbit, zoom, planet facts and quiz."}},{"k":"3d_print_lab","v":{"s":"3D Print Lab"}},{"k":"3d_volume_explorer","v":{"s":"3D Volume Explorer"}},{"k":"access_lens","v":{"s":"Access Lens"}},{"k":"adjust_frequency_amplitude_wavelength_explore_interference","v":{"s":"Adjust frequency, amplitude, wavelength. Explore interference patterns."}},{"k":"adolescent_safe_nutrition_science_macros_micros","v":{"s":"Adolescent-safe nutrition science: macros, micros, food labels, metabolism, digestion, food + mental health, eating-disorder awareness. Physiology-first framing — NOT weight-loss. Sources: USDA / NIH / Harvard / AAP / NEDA."}},{"k":"air_traffic_control_simulator_manage_approaching","v":{"s":"Air Traffic Control simulator — manage approaching aircraft, solve rate problems, and learn the math behind aviation safety."}},{"k":"algebra_solver","v":{"s":"Algebra Solver"}},{"k":"all","v":{"s":"All"}},{"k":"animal_migration_lab","v":{"s":"Animal Migration Lab"}},{"k":"ap_physics_2_geometric_wave_optics","v":{"s":"AP Physics 2 geometric + wave optics: ray diagrams, Snell's law, mirrors, lenses, double-slit interference, single-slit diffraction, polarization. Side-by-side draggable sims + calculators with show-the-math, sample problems, glossary, misconceptions, AP exam quiz, and AI-graded explanations."}},{"k":"applab_ai_app_generator","v":{"s":"AppLab: AI App Generator"}},{"k":"applied","v":{"s":"Applied"}},{"k":"applied_k_12_behavior_practice_what","v":{"s":"Applied K-12 behavior practice — what school psychs and educators actually do with the science. PBIS three-tier framework, replacement behaviors mapped to FBA functions, setting events (slow triggers most BIPs miss), Geoff Colvin's seven-phase Acting-Out Cycle, Restraint & Seclusion ethics anchored in Maine Chapter 33. Sister tool to BehaviorLab."}},{"k":"aquaculture_ocean_lab","v":{"s":"Aquaculture & Ocean Lab"}},{"k":"aquaculturelab_mussel_farm_sim","v":{"s":"AquacultureLab: Mussel Farm Sim"}},{"k":"architecture_studio","v":{"s":"Architecture Studio"}},{"k":"area_perimeter_lab","v":{"s":"Area & Perimeter Lab"}},{"k":"arithmetic_strategy_studio","v":{"s":"Arithmetic Strategy Studio"}},{"k":"assessment_literacy_lab","v":{"s":"Assessment Literacy Lab"}},{"k":"atc_tower","v":{"s":"ATC Tower"}},{"k":"audit_websites_for_wcag_2_1","v":{"s":"Audit websites for WCAG 2.1 AA compliance. Learn how accessibility barriers affect people with disabilities and how to fix them."}},{"k":"author_functions_re_light_a_neon","v":{"s":"Author functions, re-light a neon city, and battle across two function-powered Circuit Clash arenas."}},{"k":"bar_pie_line_scatter_box_histogram","v":{"s":"Bar, pie, line, scatter, box & histogram charts. Import CSV or enter your own data. Switch to Regression mode for curve fitting, R², residuals and outlier analysis."}},{"k":"base_10_blocks_abacus_slide_rule","v":{"s":"Base-10 blocks, abacus & slide rule. Explore place value, counting, and multiplication with hands-on tools."}},{"k":"beehive_colony_simulator","v":{"s":"Beehive Colony Simulator"}},{"k":"behavior_shaping_lab","v":{"s":"Behavior Shaping Lab"}},{"k":"bikelab_physics_repair","v":{"s":"BikeLab: Physics & Repair"}},{"k":"birdlab_i_spy_ornithology","v":{"s":"BirdLab: I-Spy Ornithology"}},{"k":"birdlab_life_list","v":{"s":"BirdLab Life List"}},{"k":"bloom_s_taxonomy_udl_framework_metacognition","v":{"s":"Bloom's Taxonomy, UDL framework, metacognition, cognitive load, spaced repetition + retrieval practice, study strategies that actually work, neuromyth debunking. Cited primary sources (Dunlosky 2013, Pashler 2008, Sweller 1988, CAST UDL 3.0)."}},{"k":"build_3d_shapes_measure_properties_and","v":{"s":"Build 3D shapes, measure properties, and export STL files for 3D printing."}},{"k":"build_circuits_with_resistors_and_batteries","v":{"s":"Build circuits with resistors and batteries. Calculate voltage and current."}},{"k":"build_compare_compose_sequence_annotate_and","v":{"s":"Build, compare, compose, sequence, annotate, and export accessible GIS and remote-sensing investigations: import CSV/GeoJSON, choropleths, buffers, change over time, NDVI/NDWI/NDBI, swipe scenes, story maps, and table-first evidence reports."}},{"k":"build_molecules_with_atoms_and_bonds","v":{"s":"Build molecules with atoms and bonds. Explore molecular geometry."}},{"k":"build_rectangular_prisms_with_unit_cubes","v":{"s":"Build rectangular prisms with unit cubes. Rotate, zoom, explore layers."}},{"k":"build_your_own_world_of_forms","v":{"s":"Build your own World of Forms: fill an archetypal 3D structure (Venn, story mountain, fishbone…) with your OWN ideas, sculpt them, and get AI coaching on the whole composition."}},{"k":"calculate_a_flight_path_by_hand","v":{"s":"Calculate a flight path by hand, debug FORTRAN-style code, sequence punch cards, run a batch job, and independently verify the machine result."}},{"k":"carbon_calculator_renewables_impact_simulator_climate","v":{"s":"Carbon calculator, renewables impact simulator, climate justice map, and solutions spotlight. Understand your footprint, design clean energy futures, and discover real-world innovations."}},{"k":"cell_atlas_lab","v":{"s":"Cell Atlas Lab"}},{"k":"cellular_automaton_lab","v":{"s":"Cellular Automaton Lab"}},{"k":"charts_graphs","v":{"s":"Charts & Graphs"}},{"k":"chemistry_lab","v":{"s":"Chemistry Lab"}},{"k":"city_planning_lab","v":{"s":"City Planning Lab"}},{"k":"classify_human_pancreatic_cell_types_from","v":{"s":"Classify human pancreatic cell types from gene-expression evidence, compare marker profiles, solve mystery cells, and follow insulin toward AlphaFold structure."}},{"k":"coaster_lab","v":{"s":"Coaster Lab"}},{"k":"codap_data_science","v":{"s":"CODAP Data Science"}},{"k":"coin_flips_dice_rolls_and_spinners","v":{"s":"Coin flips, dice rolls, and spinners. Visualize outcomes and explore chance."}},{"k":"coins_bills_making_change_grocery_store","v":{"s":"Coins, bills, making change, grocery store sim, money word problems, and currency exchange. Multi-currency with USD, EUR, GBP & more."}},{"k":"colonize_an_alien_planet_turn_based","v":{"s":"Colonize an alien planet! Turn-based cooperative strategy where mastering science unlocks colony survival."}},{"k":"companion_animal_science_physiology_ethology_nutrition","v":{"s":"Companion-animal SCIENCE: physiology, ethology, nutrition, genetics, domestication, zoonoses. Service & support animals. Cross-species training that assumes BehaviorLab's operant theory."}},{"k":"compare_fractions_side_by_side_compare","v":{"s":"Compare fractions side-by-side (Compare tab) or practice with interactive challenges (Challenge tab)."}},{"k":"compare_scientific_theories_and_philosophical_views","v":{"s":"Compare scientific theories and philosophical views of consciousness through evidence, predictions, real cases, and thought experiments. Reading depth and knowledge checks adapt from K-2 through graduate study."}},{"k":"compare_what_you_learned_from_each","v":{"s":"Compare what you learned from each tool"}},{"k":"computing_ai_digital_literacy","v":{"s":"💻 Computing, AI & Digital Literacy"}},{"k":"conduction_convection_and_radiation_on_a","v":{"s":"Conduction, convection and radiation on a real heat-equation model; insulation R-values; calorimetry mixing; the water heating curve; and why no heat engine reaches 100%."}},{"k":"consciousness_theory_lab","v":{"s":"Consciousness Theory Lab"}},{"k":"construct_geometric_proofs_step_by_step","v":{"s":"Construct geometric proofs step-by-step with interactive diagrams."}},{"k":"convert_between_metric_and_imperial_units","v":{"s":"Convert between metric and imperial units for length, mass, volume, and more."}},{"k":"cooking_life_skills_culinary_science_usda","v":{"s":"Cooking life skills + culinary science: USDA safe temps + bacteria danger zone, knife cuts (dice/julienne/chiffonade/brunoise), heat techniques (sauté/sear/simmer/braise/roast/fry/steam), Maillard chemistry, top-9 allergens, real-time recipe sim (coming next ship). Sister to NutritionLab + BakingScience."}},{"k":"cozy_sci_fi_roguelite_allobot_s","v":{"s":"Cozy sci-fi roguelite. AlloBot’s spells unlock as you master other STEAM Lab tools — and every cast is a retrieval-practice micro-challenge. Spaced practice, in-game."}},{"k":"creative","v":{"s":"Creative"}},{"k":"cyber_defense_lab","v":{"s":"Cyber Defense Lab"}},{"k":"data_statistics_probability","v":{"s":"📊 Data, Statistics & Probability"}},{"k":"describe_what_you_want_and_ai","v":{"s":"Describe what you want and AI generates a complete interactive mini-app. Science demos, visualizations, calculators, and educational tools — created from your imagination."}},{"k":"design_a_roller_coaster_in_full","v":{"s":"Design a roller coaster in full 3D, predict its speeds and g-forces with real physics, pass the certification inspection, and ride onboard with checkpoint questions."}},{"k":"design_build_and_test_your_own","v":{"s":"Design, build, and test your own games with a visual coding interface."}},{"k":"design_or_import_a_model_inspect","v":{"s":"Design or import a model, inspect scale and printability, compare materials, and prepare a reviewed school-store print request."}},{"k":"detailed_cerebral_regions_lobes_nuclei_and","v":{"s":"Detailed cerebral regions, lobes, nuclei and clinical correlations. Lateral, medial, inferior & coronal views."}},{"k":"diagnose_fix_a_vehicle_obd_ii","v":{"s":"Diagnose + fix a vehicle: OBD-II codes, fluid / sound / visual diagnosis, 7 step-by-step repairs (oil, brakes, alternator, tires, A/C, timing belt). Maine vocational pathways + ASE certification info. Pairs with RoadReady."}},{"k":"dig_a_3d_voxel_cross_section","v":{"s":"Dig a 3D voxel cross-section of the crust — identify rocks, read the layers, and find the pluton that cuts them."}},{"k":"digital_accessibility_lab","v":{"s":"Digital Accessibility Lab"}},{"k":"dino_lab","v":{"s":"Dino Lab"}},{"k":"disability_first_keyboarding_dyslexia_font_high","v":{"s":"Disability-first keyboarding — dyslexia font, high-contrast, audio cues, error-tolerant mode, pace reference, on-screen keyboard. 8+ drill tiers, AI-personalized passages, IEP-ready progress reports."}},{"k":"discover_items","v":{"s":"Discover Items"}},{"k":"dissection_lab","v":{"s":"Dissection Lab"}},{"k":"dna_lab","v":{"s":"DNA Lab"}},{"k":"earn_xp","v":{"s":"Earn XP"}},{"k":"earth_space_science","v":{"s":"🌎 Earth & Space Science"}},{"k":"earth_space_science_constellations_with_wabanaki","v":{"s":"Earth & Space Science: constellations (with Wabanaki + cross-cultural sky traditions), moon phases, planets, seasons, stars, galaxies, eclipses, observing practice, light-pollution awareness. NGSS MS-ESS1 + HS-ESS1. Place-based for Maine. Printable observing checklists."}},{"k":"echo_navigator","v":{"s":"Echo Navigator"}},{"k":"ecology_environment_animals","v":{"s":"🌍 Ecology, Environment & Animals"}},{"k":"economics_lab","v":{"s":"Economics Lab"}},{"k":"ecosystem","v":{"s":"Ecosystem"}},{"k":"educational_flight_simulator_learn_aerodynamics_navigation","v":{"s":"Educational flight simulator — learn aerodynamics, navigation, and world geography by flying between real airports with real physics."}},{"k":"engineering","v":{"s":"Engineering"}},{"k":"engineering_design","v":{"s":"⚙️ Engineering & Design"}},{"k":"environmental_stewardship_campaigns","v":{"s":"Environmental Stewardship Campaigns"}},{"k":"epidemic_simulator","v":{"s":"Epidemic Simulator"}},{"k":"evolab_evolution","v":{"s":"EvoLab: Evolution"}},{"k":"evolution_natural_selection_selection_sandbox_galpagos","v":{"s":"Evolution + natural selection: Selection Sandbox, Galápagos Beak Lab, Phylogenetic Tree Builder, plus quick labs on Hardy-Weinberg, genetic drift, common ancestry, evolution misconceptions. Maine wildlife examples."}},{"k":"experience_13_8_billion_years_of","v":{"s":"Experience 13.8 billion years of cosmic history, from the Big Bang to the far future."}},{"k":"explore_360_dinosaurs_across_deep_time","v":{"s":"Explore 360+ dinosaurs across deep time: search, compare, dig fossils, build food webs, and meet the bird connection — with how-we-know notes on every species."}},{"k":"explore_3d_migration_routes_navigation_climate","v":{"s":"Explore 3D migration routes, navigation, climate triggers, conservation challenges, and an explicit monarch butterfly simulation."}},{"k":"explore_65_000_years_of_indigenous","v":{"s":"Explore 65,000+ years of Indigenous fire knowledge, fire-adapted ecosystems, prescribed burn planning, and forest management science. Centers Aboriginal Australian, Karuk, Martu, Plains Nations, and more."}},{"k":"explore_a_3d_world_where_geometry","v":{"s":"Explore a 3D world where geometry questions unlock new areas. Talk to NPCs and solve shape puzzles!"}},{"k":"explore_a_clickable_3d_map_of","v":{"s":"Explore a clickable 3D map of the ISS, live an astronaut’s day, trace the water and air recycling loops, and run real orbital mechanics in the Orbit Lab."}},{"k":"explore_all_11_body_systems_with","v":{"s":"Explore all 11 body systems with interactive canvas — skeletal, muscular, circulatory, nervous, and more."}},{"k":"explore_color_theory_mix_colors_draw","v":{"s":"Explore color theory, mix colors, draw pixel art, create symmetry patterns, and check accessibility contrast."}},{"k":"explore_document","v":{"s":"Explore + document"}},{"k":"explore_fronts_pressure_humidity_wind_radar","v":{"s":"Explore fronts, pressure, humidity, wind, radar, station models, severe-weather hazards, and evidence-based forecasting."}},{"k":"explore_ratio_tables_double_number_lines","v":{"s":"Explore ratio tables, double number lines, unit rates, percents, and proportional relationships."}},{"k":"explore_tectonic_plates_earthquakes_volcanoes_and","v":{"s":"Explore tectonic plates, earthquakes, volcanoes, and continental drift."}},{"k":"explore_the_ancient_milpa_three_sisters","v":{"s":"Explore the ancient milpa / Three Sisters system — corn, beans, and squash growing in symbiosis. Soil chemistry, nitrogen cycles, and 7,000 years of agricultural science."}},{"k":"explore_transistors_logic_gates_silicon_doping","v":{"s":"Explore transistors, logic gates, silicon doping, and chip design fundamentals."}},{"k":"extract_sequence_and_analyze_dna_explore","v":{"s":"Extract, sequence, and analyze DNA. Explore genetics through interactive experiments."}},{"k":"farm_log","v":{"s":"Farm Log"}},{"k":"fifteen_environmental_stewardship_campaigns_across_eleven","v":{"s":"Fifteen environmental stewardship campaigns across eleven regions. Five deep multi-period Maine campaigns plus ten cross-region scenarios across all five mechanic families: fire (Yarralin Australia, Karuk Northern California), conservation (Yellowstone, Akagera Rwanda), public health (Mumbai dengue, Liberia 2014 Ebola), watershed (Klamath River, Murray–Darling Basin), climate (Marshall Islands, Bangladesh delta). Family Pairing Insights unlock when you complete Maine + cross-region in the same mechanic family."}},{"k":"find_countries_on_a_live_map","v":{"s":"Find countries on a live map, quiz capitals, continents and landmarks, compare sizes, estimate distances, and spin a 3D globe."}},{"k":"find_open_textures_and_visual_assets","v":{"s":"Find open textures and visual assets for educational materials or artwork, with source and reuse information."}},{"k":"first_response_lab","v":{"s":"First Response Lab"}},{"k":"fisher_life_log","v":{"s":"Fisher Life Log"}},{"k":"fisherlab_boating_fishing_sim","v":{"s":"FisherLab: Boating & Fishing Sim"}},{"k":"fly_through_a_3d_milky_way","v":{"s":"Fly through a 3D Milky Way. Discover star types, nebulae, and black holes."}},{"k":"follow_water_through_evaporation_condensation_precipitation","v":{"s":"Follow water through evaporation, condensation, precipitation, and collection."}},{"k":"football_soccer_play_design_drag_to","v":{"s":"Football + soccer play design: drag-to-place routes, animated simulation, Coach Mode coverage analysis, drills + saved plays. Built for athletic kids."}},{"k":"full_apollo_mission_simulator_launch_orbit","v":{"s":"Full Apollo mission simulator — launch, orbit, land on the Moon, walk in 1/6 gravity, collect rocks, and splash down!"}},{"k":"game_studio","v":{"s":"Game Studio"}},{"k":"games","v":{"s":"Games"}},{"k":"genetic_crosses_with_alleles_predict_genotype","v":{"s":"Genetic crosses with alleles. Predict genotype and phenotype ratios."}},{"k":"geometry_measurement","v":{"s":"📐 Geometry & Measurement"}},{"k":"geometry_prover","v":{"s":"Geometry Prover"}},{"k":"geometry_sandbox","v":{"s":"Geometry Sandbox"}},{"k":"graphing_calculator","v":{"s":"Graphing Calculator"}},{"k":"half_life_and_decay_you_can","v":{"s":"Half-life and decay you can run, what actually stops alpha, beta and gamma, fission and fusion, radiation doses on a readable scale, why the same accident gets two death tolls a hundredfold apart, the three accidents in honest numbers, the waste question, and where small modular reactors really stand."}},{"k":"heat_thermodynamics_lab","v":{"s":"Heat & Thermodynamics Lab"}},{"k":"how_cognitive_personality_career_and_employer","v":{"s":"How cognitive, personality, career, and employer tests actually work. Build mock batteries, critique pseudoscience, coach yourself ethically for hiring tests."}},{"k":"how_each_renewable_source_actually_generates","v":{"s":"How each renewable source actually generates electricity. Live sliders for solar PV, wind (Betz limit + cube of wind speed), hydro (head x flow), geothermal (depth x gradient), CSP, wave/tidal, biomass, and storage. Cited to NREL, IEA, IRENA."}},{"k":"how_llms_actually_work_when_they","v":{"s":"How LLMs actually work, when they fail, how to prompt well, and when to use AI as a scaffold vs. let it substitute for your thinking."}},{"k":"how_swimming_works_stroke_physics_survival","v":{"s":"How swimming works (stroke physics + survival skills) plus what every swimmer should know about cold water, rip currents, ice, life jackets, and rescue. Visual stroke breakdowns, the science of buoyancy and propulsion, and the survival skills (back float, eggbeater, HELP, huddle) that actually save lives. Sources: CDC, USCG, AAP, NAA, NOAA, USA Swimming. Educational only — find a Water Safety Instructor for actual swim training."}},{"k":"human_body_health_safety","v":{"s":"🫀 Human Body, Health & Safety"}},{"k":"inferential_statistics_t_tests_anova_correlation","v":{"s":"Inferential statistics: t-tests, ANOVA, correlation, regression, chi-square, non-parametric, power analysis. AP Psych / AP Bio focus. Transparent computation, plain-English results, APA write-ups, AI interpretation grader."}},{"k":"interactive_number_line_with_draggable_markers","v":{"s":"Interactive number line with draggable markers. Great for addition, subtraction, fractions."}},{"k":"interactive_times_table_grid_spot_patterns","v":{"s":"Interactive times table grid. Spot patterns, practice facts with challenges."}},{"k":"junk_science","v":{"s":"Junk-Science"}},{"k":"kepler_colony","v":{"s":"Kepler Colony"}},{"k":"layered_habitat_i_spy_with_animated","v":{"s":"Layered habitat I-Spy with animated birds whose movement signatures double as field marks. Field Marks Trainer, Beak & Feet Lab, Bird Calls, Maine Birds Spotlight, Migration, Citizen Science, Photo ID, and a Life List that persists across habitats. Pairs with Cornell Lab’s Merlin Bird ID."}},{"k":"learn_all_four_operations_through_models","v":{"s":"Learn all four operations through models, strategies, estimation, and mistake analysis."}},{"k":"learning_behavioral_science","v":{"s":"🧠 Learning & Behavioral Science"}},{"k":"learning_lab_how_learning_works","v":{"s":"Learning Lab: How Learning Works"}},{"k":"leavening_chemistry_emulsions_recipe_scaling_oven","v":{"s":"Leavening chemistry, emulsions, recipe scaling, oven timeline, and Maillard browning — the science behind every bake."}},{"k":"levers_pulleys_ramps_wedges_and_screws","v":{"s":"Levers, pulleys, ramps, wedges and screws. See how simple machines trade distance for force, and prove it with your own predictions."}},{"k":"life_science_genetics","v":{"s":"🧬 Life Science & Genetics"}},{"k":"life_skills_careers_economics","v":{"s":"💰 Life Skills, Careers & Economics"}},{"k":"life_skills_lab","v":{"s":"Life Skills Lab"}},{"k":"link_clocks_model_elapsed_time_reason","v":{"s":"Link clocks, model elapsed time, reason about schedules, and convert 12/24-hour time."}},{"k":"literary_rpg_explore_worlds_craft_items","v":{"s":"Literary RPG — explore worlds, craft items, build structures, and battle through the strength of your prose. Your eloquence IS your superpower."}},{"k":"logic_gates_truth_tables_and_boolean","v":{"s":"Logic gates, truth tables, and Boolean algebra puzzles."}},{"k":"look_up_public_alphafold_db_protein","v":{"s":"Look up public AlphaFold DB protein structures by UniProt/accession, inspect them in Mol*, import downloaded prediction files, and prepare AlphaFold Server-ready JSON with guardrails for public or synthetic classroom sequences only."}},{"k":"lumen_research_canvas","v":{"s":"Lumen Research Canvas"}},{"k":"magnetism_lab","v":{"s":"Magnetism Lab"}},{"k":"manage_a_living_honeybee_colony_nectar","v":{"s":"Manage a living honeybee colony — nectar economics, waggle dances, seasonal cycles, threats, and the science of superorganisms. Connected to Companion Planting!"}},{"k":"manage_aquarium_tanks_simulate_sustainable_fishing","v":{"s":"Manage aquarium tanks, simulate sustainable fishing, and explore marine ecosystems. Water chemistry, population dynamics and species studies."}},{"k":"marine_biology_behavioral_science_of_octopuses","v":{"s":"Marine biology + behavioral science of octopuses, squid, cuttlefish, nautilus. Headline: Hunter Sim — pick species + habitat + prey + tactic, run the camouflage minigame, time the strike. Unlocks field-note biology trivia (chromatophore mechanics, 9 brains, blue blood, jet propulsion). 10-species field guide with intelligence + camouflage + jet-speed stats."}},{"k":"math","v":{"s":"Math"}},{"k":"math_manipulatives","v":{"s":"Math Manipulatives"}},{"k":"measure_and_construct_angles_classify_acute","v":{"s":"Measure and construct angles. Classify acute, right, obtuse, and reflex."}},{"k":"microscope_mode_observe_control_and_quiz","v":{"s":"Microscope mode: observe, control, and quiz on living organisms. Earn XP!"}},{"k":"mig_tig_stick_oxy_fuel_processes","v":{"s":"MIG / TIG / Stick / Oxy-Fuel processes, heat-input physics, weld-bead geometry, defect ID, AWS welding symbols, OSHA-aligned PPE. Maine career pathways (Bath Iron Works, EMCC, AWS cert ladder)."}},{"k":"model_disease_spread_with_sir_seir","v":{"s":"Model disease spread with SIR/SEIR models. Adjust R0, vaccination rates, and social distancing. Flatten the curve!"}},{"k":"money_math","v":{"s":"Money Math"}},{"k":"moon_mission","v":{"s":"Moon Mission"}},{"k":"navigate_virtual_spaces_using_only_spatial","v":{"s":"Navigate virtual spaces using only spatial audio echoes — real HRTF binaural sound. Wear headphones!"}},{"k":"ngss_ms_ets1_hs_ets1_3","v":{"s":"NGSS MS-ETS1 + HS-ETS1-3 + MS-ESS3-3. Design a town on a 144-parcel grid against requirements that genuinely conflict. Three towns, each with a different binding constraint: Riverbend, where stormwater and the bond bite; Mesa Hollow, where the aquifer is fixed and the farms are drinking it; and Harborlight, where the plan has to still work in 2050. Rational-method runoff, water balance, sea-level allowance, network walk distance and a costed road network, each openable to show its formula. The Assumption Lab reruns one plan under two published parameter sets so students can see which conclusions survive both. Map, editable parcel table and a 3D model of the same plan. Discussion prompts and documented history carry the questions the tool refuses to model. No score and no answer key."}},{"k":"ngss_ms_ets1_hs_ets1_hs","v":{"s":"NGSS MS-ETS1 + HS-ETS1 + HS-PS2. Truss stress simulator with adjustable span/height/load/material, bridge type comparison (beam/truss/arch/suspension/cable-stayed), materials database, force types, real-world case studies (Tacoma Narrows, Hyatt Regency, Tay, Silver, plus Brooklyn/Golden Gate/Akashi/Millau), engineering design cycle, AP-style quiz, printable design specs."}},{"k":"ngss_ms_ls1_hs_ls1_hs","v":{"s":"NGSS MS-LS1 + HS-LS1 + HS-LS3 + HS-LS4. The microbial world: bacteria (beneficial + pathogenic), viruses (COVID, flu, HIV, phages, measles), microscopy (light + phase + fluorescent + EM + AFM), antibiotic resistance evolution, the human + soil + ocean microbiome, vaccines + immune system, fermentation (sourdough, yogurt, kimchi, sauerkraut, kombucha, cheese), case studies (Snow, Fleming, MRSA, COVID/mRNA, FMT), quiz, printable lab safety + microbes reference."}},{"k":"nuclear_radiation_lab","v":{"s":"Nuclear & Radiation Lab"}},{"k":"nutritionlab_nutrition_science","v":{"s":"NutritionLab: Nutrition Science"}},{"k":"openbim_companion","v":{"s":"OpenBIM Companion"}},{"k":"opticslab_ap","v":{"s":"OpticsLab AP"}},{"k":"oratory_speech_lab","v":{"s":"Oratory & Speech Lab"}},{"k":"particle_lab_3d","v":{"s":"Particle Lab 3D"}},{"k":"petslab_decoder","v":{"s":"PetsLab Decoder"}},{"k":"photosynthesis_at_the_whole_tree_scale","v":{"s":"Photosynthesis at the whole-tree scale in 3D: what limits the rate hour to hour, what a big tree spends just staying alive, why rings narrow with age, and how trees make more of themselves with seeds and without."}},{"k":"pilot_a_maine_skiff_from_portland","v":{"s":"Pilot a Maine skiff from Portland Harbor out to the fishing grounds. Learn IALA-B buoyage (red-right-returning), COLREGS rules of the road, charts, tides, and weather while fishing for cod, haddock, pollock, striper, and pulling lobster traps. Full 3D three.js sim with Maine-default DMR regs and a region toggle."}},{"k":"pitcher_s_mound_dial_spin_speed","v":{"s":"Pitcher's Mound: dial spin, speed, and release point and watch the Magnus + drag integrator shape the ball's path. 6 pitch types. Hot-Hand streaks + Rookie/Pro tiers."}},{"k":"play_a_piano_build_beats_and","v":{"s":"Play a piano, build beats, and learn the science of sound with real-time waveform visualization."}},{"k":"playlab_strategy_on_the_field","v":{"s":"PlayLab: Strategy on the Field"}},{"k":"plot_linear_quadratic_and_trig_functions","v":{"s":"Plot linear, quadratic, and trig functions. Adjust coefficients in real-time."}},{"k":"point_your_camera_at_the_world","v":{"s":"Point your camera at the world: scene descriptions read aloud (built for students who are blind or have low vision), large-print re-reading of any text, translation of signs and handouts, and a Socratic investigate mode where the AI asks questions instead of pronouncing answers."}},{"k":"practice_public_speaking_with_real_time","v":{"s":"Practice public speaking with real-time pacing analysis, vocal warm-ups, and speech delivery coaching."}},{"k":"practice_reading_and_completing_the_documents","v":{"s":"Practice reading and completing the documents adult life runs on — job applications, W-4s, leases, medical intake, driver permits, and your own IEP meeting invitation. Every field decoded in plain language, the boxes that can cost you flagged, pressure scenarios for when someone wants you to sign now, and scripts for asking for time. All practice uses a made-up person, never your real information."}},{"k":"predator_prey_dynamics_with_lotka_volterra","v":{"s":"Predator-prey dynamics with Lotka-Volterra simulation. Adjust birth and death rates."}},{"k":"printingpress","v":{"s":"PrintingPress"}},{"k":"projectile_motion_velocity_vectors_and_trajectory","v":{"s":"Projectile motion, velocity vectors, and trajectory visualization."}},{"k":"quiz_score","v":{"s":"Quiz Score"}},{"k":"ratios_rates_proportions_lab","v":{"s":"Ratios, Rates & Proportions Lab"}},{"k":"reactive_research_canvas_collect_analyze_present","v":{"s":"Reactive research canvas — collect, analyze & present as one honest, provenance-bound object. 9 chart types, correlation-not-causation guards, FERPA-aware exports."}},{"k":"read_what_special_education_law_actually","v":{"s":"Read what special-education law actually says, in its own words. The real text of IDEA Part B and Section 504, fetched from eCFR and date-stamped, searchable, with federal and state rules side by side. Nothing is paraphrased or generated — if the official text is not loaded, the tool says so instead of guessing."}},{"k":"real_data_science_in_codap_the","v":{"s":"Real data science in CODAP — the Concord Consortium’s open data workspace — with an AlloFlow Socratic tutor beside it that sees your column summaries and a bounded row sample and asks questions instead of giving answers."}},{"k":"recognize_respond_to_medical_emergencies_hands","v":{"s":"Recognize + respond to medical emergencies. Hands-only CPR rhythm trainer, AED walkthrough, Stop the Bleed, choking, seizure, stroke, anaphylaxis. Disability-affirming peer response. Maine 911 + text-to-911. Educational only."}},{"k":"renewables_lab","v":{"s":"Renewables Lab"}},{"k":"riemann_sums_area_under_curves_and","v":{"s":"Riemann sums, area under curves, and derivative tangent lines."}},{"k":"roguelike_missions_across_the_solar_system","v":{"s":"Roguelike missions across the solar system. AI-generated challenges teach real science through strategic decisions."}},{"k":"run_a_maine_shellfish_farm_pilot","v":{"s":"Run a Maine shellfish farm. Pilot your skiff out to a Bagaduce River lease, deploy seeded longlines, monitor water quality (DO, salinity, pH, temp, chlorophyll-a), harvest mussels and oysters, navigate weather and tides. Full 3D three.js sim teaching boating navigation alongside aquaculture fundamentals."}},{"k":"run_fully_3d_particle_experiments_with","v":{"s":"Run fully 3D particle experiments with states of matter, gas laws, diffusion, collisions, attraction, live measurements, and particle tracing."}},{"k":"science","v":{"s":"Science"}},{"k":"science_of_pets_lab","v":{"s":"Science of Pets Lab"}},{"k":"see_magnetic_field_lines_with_a","v":{"s":"See magnetic field lines with a live compass, build an electromagnet, spin a DC motor, generate electricity with Faraday’s law, and explore Earth’s magnetic shield."}},{"k":"see_the_world_through_sound_sonar","v":{"s":"See the world through sound! Sonar vision, wave physics, Doppler effect, bat biology, and acoustic ecology with interactive canvas simulations."}},{"k":"shape_clay_by_wheel_or_hand","v":{"s":"Shape clay by wheel or hand, investigate wall and coil stability, control kiln heatwork, test fired performance, and compare pottery technologies in specific cultural contexts."}},{"k":"sim_shelf","v":{"s":"Sim Shelf"}},{"k":"sixteen_hand_picked_phet_simulations_university","v":{"s":"Sixteen hand-picked PhET simulations (University of Colorado Boulder) — forces, circuits, light, matter, orbits, evolution, fractions, probability — wrapped in a Predict → Explore → Explain coach that makes you commit to a guess before you touch anything."}},{"k":"skatelab_skate_bmx_physics","v":{"s":"SkateLab: Skate + BMX Physics"}},{"k":"skyschool","v":{"s":"SkySchool"}},{"k":"solar_system","v":{"s":"Solar System"}},{"k":"sourcebook","v":{"s":"Sourcebook"}},{"k":"space_station","v":{"s":"Space Station"}},{"k":"spend_time","v":{"s":"Spend Time"}},{"k":"sports_movement_science","v":{"s":"🏅 Sports & Movement Science"}},{"k":"spot_phishing_emails_forge_strong_passwords","v":{"s":"Spot phishing emails, forge strong passwords, and crack ciphers. Gamified cybersecurity training aligned with Digital Citizenship standards."}},{"k":"statistical_tests","v":{"s":"Statistical Tests"}},{"k":"statslab_ap","v":{"s":"StatsLab AP"}},{"k":"step_by_step_equation_solving_factoring","v":{"s":"Step-by-step equation solving, factoring, simplification — powered by AI. See every algebraic rule applied."}},{"k":"strategy_games","v":{"s":"⚔️ Strategy Games"}},{"k":"supply_demand_curves_personal_finance_life","v":{"s":"Supply & demand curves, personal finance life sim, stock market trading, AI business startup sim, and a national economy policy simulator."}},{"k":"swimlab","v":{"s":"SwimLab"}},{"k":"tax_paycheck_calculator_data_literacy_decision","v":{"s":"Tax & paycheck calculator, data literacy, decision matrix, contract reader, records and paperwork, transportation planning, job readiness, resume building, portfolio proof organization, interview practice, communication skills, time management, health insurance, dental care, body care ergonomics, sleep routines, medication labels, appointment prep, home safety, digital safety, food confidence, and applied science for daily life."}},{"k":"the_gutenberg_style_screw_press_as","v":{"s":"The Gutenberg-style screw press as a working simulation. Pull the bar, set your own type, see the impression. Plus the materials science (lead-tin-antimony alloy), economics (cost-per-book collapse), history (Reformation, scientific revolution), typography, and the people behind the press (including women printers history forgot). Built for interdisciplinary middle-school work."}},{"k":"the_physics_that_lands_a_720","v":{"s":"The physics that lands a 720: kickflips, halfpipe pumps, gap jumps. Energy conservation + angular momentum, made for kids who learn through tricks."}},{"k":"three_js_stoop_simulator_deep_science","v":{"s":"Three.js stoop simulator + deep science of raptor hunt mechanics. Fly as a peregrine at 240 mph, a harpy with 530 psi talons, or a silent great horned owl. 8 species + 12 sections covering talon force, vision (4-8× human, UV in kestrels), flight physics, owl silent flight, terminal-velocity calculator, DDT recovery + ongoing conservation crises, field ID by silhouette + gestalt."}},{"k":"throwlab_sports_physics","v":{"s":"ThrowLab: Sports Physics"}},{"k":"tile_compare_decompose_and_investigate_2","v":{"s":"Tile, compare, decompose, and investigate 2-D shapes while building measurement reasoning."}},{"k":"tool_specific","v":{"s":"Tool-Specific"}},{"k":"trace_the_transformation_of_igneous_sedimentary","v":{"s":"Trace the transformation of igneous, sedimentary, and metamorphic rocks."}},{"k":"train_a_virtual_mouse_using_operant","v":{"s":"Train a virtual mouse using operant conditioning! Learn ABA fundamentals: reinforcement, shaping, extinction, and schedules of reinforcement."}},{"k":"turn_a_building_idea_into_a","v":{"s":"Turn a building idea into a reviewed semantic IFC proposal, then prepare an open project for the Bonsai authoring environment."}},{"k":"type_equations_plot_functions_explore_data","v":{"s":"Type equations, plot functions, explore data. Learn what every button really does."}},{"k":"virtual_frog_dissection_peel_back_layers","v":{"s":"Virtual frog dissection — peel back layers to explore organs, muscles, and skeleton."}},{"k":"virtual_titration_with_live_s_curve","v":{"s":"Virtual titration with live S-curve graphing, indicator selection, and pH calculation."}},{"k":"visual_block_coding_with_turtle_graphics","v":{"s":"Visual block coding with turtle graphics. Learn sequencing, loops, and conditionals. Toggle between blocks and text code."}},{"k":"visual_multiplication_and_division_with_color","v":{"s":"Visual multiplication and division with color-coded rows and columns."}},{"k":"vocal_range_exploration_pitch_matching_breathing","v":{"s":"Vocal range exploration, pitch matching, breathing exercises, and the science of the singing voice."}},{"k":"voice_singing_lab","v":{"s":"Voice & Singing Lab"}},{"k":"walk_the_ranked_tree_of_life","v":{"s":"Walk the ranked tree of life, meet the lookalike pairs that fool experienced foragers, and learn why the boxes keep moving — Linnaean ranks vs cladistics, what a species even is, and the organisms that break the system. Photo identification is built but held back pending expert review of its hazard copy."}},{"k":"weather_systems_forecasting","v":{"s":"Weather Systems & Forecasting"}},{"k":"weldlab_welding_metal_joining","v":{"s":"WeldLab: Welding & Metal Joining"}},{"k":"what_did_you_learn","v":{"s":"What did you learn?"}},{"k":"what_the_parenting_literature_actually_says","v":{"s":"What the parenting literature actually says — warmth and structure as two dials, with a strength-of-evidence badge on every claim (RCT-supported to popular-but-unsupported). Strengths-based and non-diagnostic. Sister tool to BehaviorLab and Learning Lab."}},{"k":"what_was_the_most_important_thing","v":{"s":"What was the most important thing you learned?"}},{"k":"wheel_fire_pottery_lab","v":{"s":"Wheel & Fire: Pottery Lab"}},{"k":"write_a_question_you_still_have","v":{"s":"Write a question you still have"}},{"k":"writecraft","v":{"s":"WriteCraft"}},{"k":"written_response","v":{"s":"Written Response"}},{"k":"xp_quiz_reflection","v":{"s":"XP + quiz + reflection"}},{"k":"xp_time_in_each_tool","v":{"s":"XP + time in each tool"}},{"k":"zoom_deep_into_real_openly_licensed","v":{"s":"Zoom deep into real, openly-licensed images in OpenSeadragon — the viewer museums use — from the Pillars of Creation and Saturn’s rings to an Apollo bootprint, the real Apollo 11 capsule, and a coral fan. Smithsonian Open Access (CC0) + NASA (public domain), with a Notice → Wonder observation coach beside it."}},{"k":"zoom_gallery","v":{"s":"Zoom Gallery"}},{"k":"math_fundamentals","v":{"s":"Math Fundamentals"}},{"k":"base10_blocks","v":{"s":"Base-10 Blocks"}},{"k":"coordinate_grid","v":{"s":"Coordinate Grid"}},{"k":"plot_points_draw_lines_and","v":{"s":"Plot points, draw lines, and explore the coordinate plane."}},{"k":"angle_explorer","v":{"s":"Angle Explorer"}},{"k":"multiplication_table","v":{"s":"Multiplication Table"}},{"k":"advanced_math","v":{"s":"Advanced Math"}},{"k":"function_grapher","v":{"s":"Function Grapher"}},{"k":"inequality_grapher","v":{"s":"Inequality Grapher"}},{"k":"graph_inequalities_on_number_lines","v":{"s":"Graph inequalities on number lines and coordinate planes."}},{"k":"calculus_visualizer","v":{"s":"Calculus Visualizer"}},{"k":"probability","v":{"s":"Probability"}},{"k":"fractions","v":{"s":"Fractions"}},{"k":"unit_converter","v":{"s":"Unit Converter"}},{"k":"life_earth_science","v":{"s":"Life & Earth Science"}},{"k":"cell_simulator","v":{"s":"Cell Simulator"}},{"k":"galaxy_explorer","v":{"s":"Galaxy Explorer"}},{"k":"universe_timelapse","v":{"s":"Universe Time-Lapse"}},{"k":"rocks_minerals","v":{"s":"Rocks & Minerals"}},{"k":"interactive_rock_cycle_mineral_properties","v":{"s":"Interactive rock cycle, mineral properties & geology"}},{"k":"water_cycle","v":{"s":"Water Cycle"}},{"k":"rock_cycle","v":{"s":"Rock Cycle"}},{"k":"decomposer","v":{"s":"Decomposer"}},{"k":"break_materials_into_elements","v":{"s":"Break materials into elements"}},{"k":"human_anatomy","v":{"s":"Human Anatomy"}},{"k":"brain_atlas","v":{"s":"Brain Atlas"}},{"k":"molecule_builder","v":{"s":"Molecule Builder"}},{"k":"physics_chemistry","v":{"s":"Physics & Chemistry"}},{"k":"wave_simulator","v":{"s":"Wave Simulator"}},{"k":"circuit_builder","v":{"s":"Circuit Builder"}},{"k":"equation_balancer","v":{"s":"ChemLab: Reactions & Elements"}},{"k":"balance_chemical_equations_with_visual","v":{"s":"Balance chemical equations with visual atom counting."}},{"k":"punnett_square","v":{"s":"Punnett Square"}},{"k":"physics_simulator","v":{"s":"Physics Simulator"}},{"k":"data_plotter","v":{"s":"Data Plotter"}},{"k":"plot_data_points_fit_trend","v":{"s":"Plot data points, fit trend lines, calculate correlation."}},{"k":"arts_music","v":{"s":"Arts & Music"}},{"k":"music_synthesizer","v":{"s":"Music Synthesizer"}},{"k":"art_design_studio","v":{"s":"Art & Design Studio"}}],"id":589}},{"k":"typingpractice","v":{"o":[{"k":"sr_saved_typing_draft_restored_continue_when_you_are","v":{"s":"Saved typing draft restored. Continue when you are ready."}},{"k":"sr_drill_search_focused_type_to_filter_the_library","v":{"s":"Drill search focused. Type to filter the library."}},{"k":"sr_drill_library_focused_use_tab_to_move_through_fil","v":{"s":"Drill library focused. Use Tab to move through filters, sort, and drill cards."}},{"k":"sr_reading_time_complete_the_typing_area_is_ready","v":{"s":"Reading time complete. The typing area is ready."}},{"k":"sr_typing_resumed","v":{"s":"Typing resumed."}},{"k":"sr_typing_paused_your_wpm_is_not_affected","v":{"s":"Typing paused. Your WPM is not affected."}},{"k":"sr_drill_closed_returning_to_typing_practice_home","v":{"s":"Drill closed. Returning to Typing Practice home."}},{"k":"sr_exit_canceled_typing_resumed_confirmation_time_wa","v":{"s":"Exit canceled. Typing resumed; confirmation time was excluded from WPM."}},{"k":"sr_exit_canceled_the_drill_remains_paused","v":{"s":"Exit canceled. The drill remains paused."}},{"k":"sr_saved_practice_kept_new_drill_not_started","v":{"s":"Saved practice