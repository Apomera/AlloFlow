    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/10419.png",
      "text": "Enoa ke Palesa. Ke tichere ea ka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=1",
      "sourceDigest": "sha256:64828d15eb40b4dd5ab6842d4189ee34aae328b2444c648453efbbd7db8da88e"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/10418.png",
      "text": "Palesa o sebelisa lithupa ho tsamaea.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=2",
      "sourceDigest": "sha256:8e12ecf432dc90f1c15af5c396298fc903e0421fe3ce4a7ac19ee549f9c805fd"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/10420.png",
      "text": "Enoa ke Thapelo. Ke seboholi se bapalang 'mino seea-le-moeeng seo ke se ratang haholo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=3",
      "sourceDigest": "sha256:48d0d86c7b376803bc107bfd081336bd9c637e60b04afba58b0dcb17e87f1d61"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/10421.png",
      "text": "Thapelo o na le mathata a mahlo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=4",
      "sourceDigest": "sha256:ebb04dfcf1d25d81a7acc958f3eb0931541cb778919a54d88a7cb7ff9983d41a"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/10422.png",
      "text": "Enoa ke Selemeng. Ke moahisane oa ka. Selemeng ke sehoai.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=5",
      "sourceDigest": "sha256:06a5dc94df0acc61ffff1e3760ea0c51ac7c50a203d885db64e6abc32aae2b58"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/10424.png",
      "text": "Selemeng ha utloe ka litsebeng. O sebelisa puo ea matsoho ha a buoa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=6",
      "sourceDigest": "sha256:45f6052cc32df3ce14956ca790745430931081abf15bb66829a8411af0dfb5f2"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/10425.png",
      "text": "Enoa ke Sechaba. Ke sebapali sa bolo ea maoto se hloahloa sekolong sa ka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=7",
      "sourceDigest": "sha256:688ba0d46cafbeebb5b5f7c54ce806521095f75edbe4a17f130a8f061e2da177"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/10426.png",
      "text": "Sechaba ha a na matsoho. Empa o hlabela sehlopha sa rona lintlha tse ngata!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36343#page=8",
      "sourceDigest": "sha256:a63e22f5adc0431c7e55f514e19d5adb2653b8eea8cb4198c98343b1bb04a8b0"
    }
