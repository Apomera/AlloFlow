urces","v":{"s":"more resources"}},{"k":"manage_shared","v":{"s":"Manage shared"}},{"k":"test_as_student","v":{"s":"Test as student"}},{"k":"print_qr","v":{"s":"Print QR"}},{"k":"revoke_homework_link","v":{"s":"Revoke homework link"}},{"k":"make_self_contained_version_no_accounts","v":{"s":"Make self-contained version (no accounts needed)"}},{"k":"the_activity_images_included_is_stored","v":{"s":"The activity (images included) is stored in YOUR Google Drive via your Class Mailbox — students need no account, and"}},{"k":"the_whole_activity_travels_inside_the","v":{"s":"The whole activity travels inside the link — students need no account, nothing is stored online, and"}},{"k":"personal_ai_optional","v":{"s":"Personal AI optional"}},{"k":"student_ai_off","v":{"s":"Student AI off"}},{"k":"no_live_session","v":{"s":"No live session"}},{"k":"teacher_prepared_resource_one","v":{"s":"{count} teacher-prepared resource"}},{"k":"teacher_prepared_resource_many","v":{"s":"{count} teacher-prepared resources"}},{"k":"ready_to_scan","v":{"s":"Ready to scan"}},{"k":"qr_unavailable_use_link","v":{"s":"QR unavailable - use the link below"}},{"k":"validating_qr_code","v":{"s":"Validating QR code..."}},{"k":"expires_default_window","v":{"s":"14 days after creation"}}],"id":17}},{"k":"mailbox","v":{"o":[{"k":"live_dialog_aria","v":{"s":"Class Mailbox live session"}},{"k":"webapp_url_aria","v":{"s":"Class Mailbox web app URL"}},{"k":"admin_token_placeholder","v":{"s":"Admin token (only when reconnecting from a new device)"}},{"k":"admin_token_aria","v":{"s":"Class Mailbox admin token (optional)"}},{"k":"copy_admin_token","v":{"s":"Copy admin token"}},{"k":"copy_class_code","v":{"s":"Copy class code"}},{"k":"join_link_aria","v":{"s":"Selectable mailbox live join link"}},{"k":"rtc_aria","v":{"s":"real-time connection"}},{"k":"rtc_title","v":{"s":"Real-time connection"}},{"k":"hand_aria","v":{"s":"hand raised"}},{"k":"hand_title","v":{"s":"Hand raised"}},{"k":"standard_live_session","v":{"s":"Standard live session"}},{"k":"use_the_configured_firebase_district_or","v":{"s":"Use the configured Firebase, district, or local-network session backend."}},{"k":"class_mailbox_qr_session","v":{"s":"Class Mailbox QR session"}},{"k":"students_scan_a_qr_and_join","v":{"s":"Students scan a QR and join without accounts through your Google Apps Script mailbox."}},{"k":"prepare_live_run","v":{"s":"Prepare live lesson"}},{"k":"choose_a_lesson_step_then_add","v":{"s":"Choose a lesson step, then add teacher-only cues or an optional checkpoint. Preparation is stored only on this browser and students receive nothing until you launch it in a live session."}},{"k":"loading_lesson_preparation_tools","v":{"s":"Loading lesson preparation tools..."}},{"k":"done_choose_connection","v":{"s":"Done - choose connection"}},{"k":"live_class_without_accounts","v":{"s":"Live class without accounts"}},{"k":"runs_from_a_google_apps_script","v":{"s":"Runs from a Google Apps Script project that you create and control. Students use codenames and scan a QR without signing into Google. Live state is temporary; hosted homework and completed mailbox submissions are saved in your private Drive folder."}},{"k":"why_might_google_say_unverified_app","v":{"s":"Why might Google say “unverified app” or “unsafe”?"}},{"k":"google_can_show_this_warning_because","v":{"s":"Google can show this warning because a script you create for yourself is an unpublished OAuth app, not because Google has identified this mailbox as malware. The warning is still meaningful: continue only when"}},{"k":"you_created_this_apps_script_project","v":{"s":"you created this Apps Script project"}},{"k":"pasted_code_from_the_alloflow_copy","v":{"s":", pasted code from the AlloFlow copy shown here, and recognize the Google account and project name. Cancel if the prompt is unexpected or belongs to someone else."}},{"k":"the_script_requests_google_drive_access","v":{"s":"The script requests Google Drive access to create the private “AlloFlow Class Mailbox” folder for hosted activities, admin-token recovery, and student submissions. You can review the code before authorizing and revoke access later from your Google Account connections."}},{"k":"google_s_apps_script_authorization_explanation","v":{"s":"Google’s Apps Script authorization explanation"}},{"k":"k_12_privacy_ferpa_checklist_is","v":{"s":"K–12 privacy / FERPA checklist: is this appropriate for my class?"}},{"k":"a_google_account_alone_does_not","v":{"s":"A Google account alone does not make a workflow FERPA-compliant."}},{"k":"use_a_school_managed_google_workspace","v":{"s":"Use a school-managed Google Workspace for Education account when available, confirm that Apps Script and this workflow are approved by your school or district, and follow local consent, records, security, and retention policies. If your administrator blocks “Anyone” web apps, ask IT rather than bypassing that control with a personal account."}},{"k":"use_student_codenames_do_not_ask","v":{"s":"Use student codenames; do not ask students to enter names, emails, disability information, or other unnecessary identifiers."}},{"k":"treat_each_qr_link_as_a","v":{"s":"Treat each QR/link as a classroom invitation: anyone who receives it can attempt to join or submit until it expires."}},{"k":"keep_the_admin_token_private_rotate","v":{"s":"Keep the admin token private, rotate it if exposed, and delete submission/homework files from Drive according to district retention rules."}},{"k":"use_only_for_students_and_purposes","v":{"s":"Use only for students and purposes approved by your school. This checklist is practical guidance, not a legal determination."}},{"k":"u_s_department_of_education_student","v":{"s":"U.S. Department of Education student-privacy FAQ"}},{"k":"what_is_stored_where_and_for","v":{"s":"What is stored, where, and for how long?"}},{"k":"live_messages_and_class_state_bounded","v":{"s":"Live messages and class state: bounded Apps Script cache, normally expiring within 45 minutes to 6 hours and eligible for earlier eviction."}},{"k":"session_recovery_marker_and_random_secret","v":{"s":"Session recovery marker and random secret: Script Properties for at most 6 hours."}},{"k":"hosted_homework_and_completed_mailbox_submission","v":{"s":"Hosted homework and completed mailbox submissions: ordinary files in your private “AlloFlow Class Mailbox” Drive folder until you delete them."}},{"k":"admin_token_recovery_note_the_same","v":{"s":"Admin-token recovery note: the same private Drive folder. It is never placed in a student QR."}},{"k":"no_mailbox_content_is_stored_on","v":{"s":"No mailbox content is stored on an AlloFlow-operated server."}},{"k":"how_do_student_saving_and_submissions","v":{"s":"How do student saving and submissions work in each mode?"}},{"k":"mailbox_live_session_or_mailbox_hosted","v":{"s":"Mailbox live session or mailbox-hosted homework:"}},{"k":"standard_firebase_live_session","v":{"s":"Standard Firebase live session:"}},{"k":"live_quiz_answer_content_travels_peer","v":{"s":"live quiz answer content travels peer-to-peer to the teacher. If that connection is unavailable, only a content-free submission receipt syncs and the answer remains unscored. Progress signals and supported activity metadata sync during the session; the complete portfolio is not retained as a permanent Firebase record."}},{"k":"self_contained_non_live_homework","v":{"s":"Self-contained/non-live homework:"}},{"k":"work_stays_on_the_student_device","v":{"s":"work stays on the student device until they download the submission file and send it through your approved LMS, email, or other school workflow."}},{"k":"teacher_review","v":{"s":"Teacher review:"}},{"k":"open_drive_alloflow_class_mailbox_download","v":{"s":"open Drive → “AlloFlow Class Mailbox,” download the submission JSON files, then use AlloFlow’s Submission Inbox to import, review, and grade them."}},{"k":"one_time_setup_about_3_5","v":{"s":"One-time setup (about 3–5 minutes):"}},{"k":"sign_into_the","v":{"s":"Sign into the"}},{"k":"school_managed_google_account","v":{"s":"school-managed Google account"}},{"k":"that_should_own_the_mailbox_and","v":{"s":"that should own the mailbox and confirm this use is allowed by your school or district."}},{"k":"copy_and_review_the_mailbox_script","v":{"s":"Copy and review the mailbox script:"}},{"k":"retry_loading","v":{"s":"retry loading"}},{"k":"view_the_same_source_online","v":{"s":"view the same source online"}},{"k":"open","v":{"s":"Open"}},{"k":"paste_over_the_starter_code_name","v":{"s":", paste over the starter code, name it “AlloFlow Class Mailbox,” and save."}},{"k":"choose_deploy_new_deployment_web_app","v":{"s":"Choose Deploy → New deployment → Web app → Execute as"}},{"k":"access","v":{"s":"→ access"}},{"k":"anyone","v":{"s":"Anyone"}},{"k":"deploy_review_the_authorization_prompt_if","v":{"s":"→ Deploy. Review the authorization prompt; if Google shows the unpublished-app warning, use the explanation above before deciding whether to continue."}},{"k":"copy_the_web_app_url_ending","v":{"s":"Copy the web app URL ending in"}},{"k":"paste_it_below_then_run_the","v":{"s":", paste it below, then run the self-test."}},{"k":"deploy_manage_deployments_pencil_icon_version","v":{"s":"Deploy → Manage deployments → pencil icon → Version:"}},{"k":"new_version","v":{"s":"New version"}},{"k":"deploy","v":{"s":"→ Deploy."}},{"k":"start_a_new_session_instead","v":{"s":"Start a new session instead"}},{"k":"connected_mailbox","v":{"s":"Connected mailbox:"}},{"k":"admin_token_save_it_like_a","v":{"s":"Admin token — save it like a password"}},{"k":"students_never_receive_this_token_the","v":{"s":"Students never receive this token. The QR contains only a one-session join secret."}},{"k":"rotate_token","v":{"s":"Rotate token"}},{"k":"close_all_sessions","v":{"s":"Close all sessions"}},{"k":"completed_student_submissions_save_automatically","v":{"s":"Completed student submissions save automatically as JSON files in your private Drive mailbox folder. Students receive a local backup download if delivery fails. To review them, download the JSON files from Drive and import them through AlloFlow’s Submission Inbox."}},{"k":"save_setup_to_a_file","v":{"s":"Save setup to a file"}},{"k":"change_mailbox","v":{"s":"Change mailbox"}},{"k":"forget_mailbox","v":{"s":"Forget mailbox"}},{"k":"class_code_tap_to_copy","v":{"s":"Class code (tap to copy)"}},{"k":"validating_live_session_qr","v":{"s":"Validating live-session QR..."}},{"k":"waiting_for_students_to_scan","v":{"s":"Waiting for students to scan…"}},{"k":"your_resource_pack_shares_to_the","v":{"s":"Your resource pack shares to the class automatically, like a regular live session."}},{"k":"add_to_pack","v":{"s":"Add to pack"}},{"k":"cancel","v":{"s":"Cancel"}},{"k":"write_assignment_directions","v":{"s":"Write assignment directions"}},{"k":"send_home_saves_on_student_devices","v":{"s":"Send home (saves on student devices)"}},{"k":"students_keep_the_pack_directions_on","v":{"s":"Students keep the pack + directions on their device for homework — no code needed at home."}},{"k":"end_session","v":{"s":"End session"}},{"k":"leave_session","v":{"s":"Leave session"}},{"k":"retry_resources","v":{"s":"Retry resources"}},{"k":"retry","v":{"s":"Retry"}},{"k":"or","v":{"s":"(or"}},{"k":"your_mailbox_script_is_v","v":{"s":"Your mailbox script is v"}},{"k":"and_paste_it_over_the_old","v":{"s":"and paste it over the old code in your Apps Script project (script.google.com → your AlloFlow Class Mailbox)."}},{"k":"resume_class","v":{"s":"Resume class"}},{"k":"script_v","v":{"s":"Script v"}},{"k":"ms_round_trip_security_check_ready","v":{"s":"ms round trip · security check ready"}},{"k":"restore_from_a_file","v":{"s":"Restore from a file"}},{"k":"the_saved_file_holds_an_access","v":{"s":"The saved file holds an access key for your mailbox. Keep it somewhere you would keep a password, and it will restore this setup on another device or after storage is cleared."