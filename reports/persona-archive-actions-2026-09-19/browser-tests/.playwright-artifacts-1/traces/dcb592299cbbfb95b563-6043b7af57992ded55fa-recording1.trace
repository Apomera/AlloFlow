ty_desc","v":{"s":"Start with food safety, then explore knife preparation and heat techniques."}},{"k":"path_safety_tag","v":{"s":"LEARN + REHEARSE"}},{"k":"path_recipe_title","v":{"s":"Put skills together"}},{"k":"path_recipe_desc","v":{"s":"Manage a recipe with adjustable heat and pause controls. Try competition when you are ready."}},{"k":"path_recipe_tag","v":{"s":"APPLY + REFLECT"}},{"k":"evidence_independent","v":{"s":"Cooked independently"}},{"k":"evidence_supported","v":{"s":"Cooked without coaching, with support"}},{"k":"evidence_coached","v":{"s":"Cooked with coaching on"}},{"k":"evidence_independent_detail","v":{"s":"No coaching, and no instrument beyond the one check the recipe asks for."}},{"k":"frame_unavailable","v":{"s":"The 3D view is not loading here"}},{"k":"open_recipe_kitchen_tab","v":{"s":"Open the Recipe Kitchen in a new tab →"}},{"k":"frame_why_recipe","v":{"s":"The two-pot pasta bench is a separate page. Everything it teaches about water, crowding and browning is also in the Recipe Sim, which runs right here."}},{"k":"open_studio_tab","v":{"s":"Open the Skills Studio in a new tab →"}},{"k":"frame_why_studio","v":{"s":"The six practice stations are a separate page. If it will not open, the Safety, Knife Lab and Heat tabs here cover the same ground without 3D."}}],"id":540}},{"k":"layers_slider","v":{"s":"Layers"}},{"k":"learning_lab","v":{"o":[{"k":"a11y_memory_retention_curves_over_days","v":{"s":"Memory retention curves over {value1} days"}},{"k":"a11y_working_memory_bucket_with_of_chunks","v":{"s":"Working memory bucket with {value1} of {value2} chunks"}},{"k":"a11y_add_load_chunk","v":{"s":"Add {value1} load chunk"}},{"k":"a11y_hypnogram_showing_sleep_stages_over_hours","v":{"s":"Hypnogram showing sleep stages over {value1} hours"}},{"k":"a11y_desk_view_showing_phone_at_position","v":{"s":"Desk view showing phone at position: {value1}"}},{"k":"a11y_open_goal_status_progress_percent","v":{"s":"Open goal: {value1}. Status {value2}. Progress