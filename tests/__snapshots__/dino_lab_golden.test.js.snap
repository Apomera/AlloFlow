<nav aria-label="Dino Lab section navigation" style="background:var(--allo-stem-deeper, #0b1220)">
<div class="dinolab-section-cue" style="display:flex;align-items:center;gap:10px;padding:7px 12px 0;color:var(--allo-stem-text-soft, #94a3b8);font-size:11.5px">
<span style="text-transform:uppercase;letter-spacing:0.06em;font-weight:900;color:#115e59">Explain</span>
<select id="dino-section-picker" aria-label="Jump to a lab section" style="margin-left:auto;flex:0 1 260px;min-width:0;max-width:70%;min-height:44px;padding:7px 10px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-panel, #1e293b);color:var(--allo-stem-text, #f1f5f9);font-size:13px;font-weight:700">
<optgroup label="Discover">
<option value="explore">Explore</option>
<option value="timeline">Timeline</option>
<option value="deeptime">Deep Time</option>
<option value="sites">Sites</option>
<option value="map">Map</option>
<option value="ecosystem">Ecosystems</option>
</optgroup>
<optgroup label="Investigate">
<option value="compare">Compare</option>
<option value="field3d">Field Station</option>
<option value="dig">Dig Site</option>
<option value="classify">Classify</option>
<option value="anatomy">Anatomy</option>
</optgroup>
<optgroup label="Explain">
<option value="birds" selected="">Bird Link</option>
<option value="extinction">Extinction</option>
<option value="records">Records</option>
</optgroup>
<optgroup label="Practice and teach">
<option value="quiz">Quiz</option>
<option value="notes">Field Notes</option>
<option value="glossary">Glossary</option>
<option value="classroom">Classroom</option>
</optgroup>
</select>
</div>
<div class="dinolab-tablist" role="tablist" aria-label="Dino Lab sections" aria-orientation="horizontal" style="display:flex;flex-wrap:nowrap;overflow-x:auto;gap:4px;padding:10px 12px;border-bottom:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220)">
<button id="dinotab-explore" role="tab" data-tab-group="Discover" title="Discover: Explore" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🔍 Explore</button>
<button id="dinotab-timeline" role="tab" data-tab-group="Discover" title="Discover: Timeline" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">⏳ Timeline</button>
<button id="dinotab-deeptime" role="tab" data-tab-group="Discover" title="Discover: Deep Time" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🕰️ Deep Time</button>
<button id="dinotab-sites" role="tab" data-tab-group="Discover" title="Discover: Sites" tabindex="-1" aria-selected="false" aria-controls="dinopanel" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" style="flex-shrink:0;min-height:44px;padding:7px 11px;border-radius:9px;border:none;cursor:pointer;font-size:12.5px;font-weight:500;box-shadow:none;background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap">🗺️ Sites</button>
