evious version."}},{"k":"axe_only_comparison","v":{"s":", axe-only comparison"}},{"k":"axe_only_committed","v":{"s":"{label}: AI verification unavailable — committed with the deterministic axe-core score only."}},{"k":"fidelity_delta","v":{"s":"Fidelity: {before}% → {after}%{detail}"}},{"k":"reinserted_ai","v":{"s":"{count} reinserted (AI)"}},{"k":"reinserted_sentence","v":{"s":"{count} reinserted (sentence)"}},{"k":"reinserted_fuzzy","v":{"s":"{count} reinserted (fuzzy)"}},{"k":"in_recovery_appendix","v":{"s":"{count} in recovery appendix"}},{"k":"duplicates_removed_one","v":{"s":"{count} duplicate removed"}},{"k":"duplicates_removed_other","v":{"s":"{count} duplicates removed"}},{"k":"auto_continue_round","v":{"s":"Auto-continue round {round}/{max}: {detail}, score {score}/100 (target {target})..."}},{"k":"violation_one","v":{"s":"{count} violation"}},{"k":"violation_other","v":{"s":"{count} violations"}},{"k":"ai_issue_one","v":{"s":"{count} AI-flagged issue"}},{"k":"ai_issue_other","v":{"s":"{count} AI-flagged issues"}},{"k":"view_last_audit","v":{"s":"View Last Audit"}},{"k":"start_new_audit","v":{"s":"Start New Audit"}},{"k":"apply_and_export","v":{"s":"Apply & Export"}},{"k":"applying_remarkup","v":{"s":"Re-applying accessible markup to your approved text…"}},{"k":"rejected_count","v":{"s":"{n} rejected"}},{"k":"undo_all_rejections","v":{"s":"undo all"}},{"k":"granularity_warning","v":{"s":"Changing granularity will reset your rejections. Continue?"}},{"k":"remarkup_failed","v":{"s":"Couldn't reapply full markup — exported plain paragraphs. Retry later if needed."}},{"k":"reject_selection","v":{"s":"Reject selection"}},{"k":"keep_selection","v":{"s":"Keep selection"}},{"k":"edits_applied","v":{"s":"Edits applied. Accessible HTML updated."}},{"k":"start_new_confirm","v":{"s":"Start a new audit? Your current audit will be cleared — make sure you have downloaded the remediated HTML if you need it."}},{"k":"modal_aria","v":{"s":"PDF Accessibility Audit"}},{"k":"close_modal_aria","v":{"s":"Close audit modal"}},{"k":"close_wait_title","v":{"s":"Wait for remediation to finish or click Stop first"}},{"k":"close_esc_title","v":{"s":"Close (Esc)"}},{"k":"web","v":{"o":[{"k":"heading","v":{"s":"🌐 Website & HTML Accessibility"}},{"k":"subheading","v":{"s":"Audit a website URL or paste HTML for full WCAG 2.2 AA audit + remediation"}},{"k":"static_scope_subheading","v":{"s":"Static HTML/source evidence under WCAG 2.2 AA; live behavior and external styles require review"}},{"k":"url_label","v":{"s":"Website URL"}},{"k":"url_aria","v":{"s":"Website URL to audit"}},{"k":"fetch_aria","v":{"s":"Fetch website HTML"}},{"k":"or_paste_hint","v":{"s":"Or paste HTML source code directly below"}},{"k":"html_label","v":{"s":"HTML Source"}},{"k":"html_placeholder","v":{"s":"Paste HTML source code here, or use Fetch above..."}},{"k":"html_aria","v":{"s":"HTML source code to audit"}}],"id":146}},{"k":"batch","v":{"o":[{"k":"drop_text","v":{"s":"Drag & drop PDFs, Word, or PowerPoint files here"}},{"k":"browse_files","v":{"s":"Browse Files"}},{"k":"scan_folder","v":{"s":"Scan Folder (PDF, DOCX, PPTX, incl. subfolders)"}},{"k":"scan_folder_hint","v":{"s":"Pick a folder and AlloFlow will remediate every document, then give you a report."}},{"k":"folder_empty","v":{"s":"No PDF, DOCX, or PPTX files found in that folder"}},{"k":"folder_loading","v":{"s":"Loading {count} document(s)..."}},{"k":"folder_unreadable","v":{"s":"Could not read any documents from that folder"}},{"k":"folder_remediating","v":{"s":"Remediating {count} document(s)..."}},{"k":"folder_scan_failed","v":{"s":"Folder scan failed: "}},{"k":"clear_all","v":{"s":"Clear All"}},{"k":"summary_title","v":{"s":"Batch Processing Complete"}},{"k":"tile_processed","v":{"s":"Processed"}},{"k":"tile_fully_verified","v":{"s":"Fully verified"}},{"k":"tile_need_review","v":{"s":"Need review"}},{"k":"tile_verified_90","v":{"s":"Verified at 90+"}},{"k":"progress_aria","v":{"s":"Batch remediation progress"}},{"k":"stop_aria","v":{"s":"Stop batch remediation"}},{"k":"avg_improvement","v":{"s":"Avg Improvement"}},{"k":"scored_90_plus","v":{"s":"Scored 90+"}},{"k":"new_batch","v":{"s":"New Batch"}},{"k":"resume","v":{"o":[{"k":"title","v":{"s":"Previous batch interrupted"}},{"k":"summary","v":{"s":"{done}/{total} file(s) completed before the tab closed."}},{"k":"remaining","v":{"s":"{n} remaining."}},{"k":"files_label","v":{"s":"Files:"}},{"k":"files_more","v":{"s":"+ {n} more"}},{"k":"resume_button","v":{"s":"Resume Batch"}},{"k":"discard_button","v":{"s":"Discard"}},{"k":"toast","v":{"s":"Resuming batch · {done} cached, {remaining} to process"}},{"k":"settings_toast","v":{"s":"Resuming with the batch’s original settings — current slider values apply to new batches."}}],"id":148}}],"id":147}},{"k":"agreement","v":{"o":[{"k":"tooltip","v":{"s":"Flagged by {n} of {total} auditors"}},{"k":"unanimous_suffix","v":{"s":" (unanimous)"}},{"k":"minority_suffix","v":{"s":" — minority opinion, lower confidence"}}],"id":149}},{"k":"divergence","v":{"o":[{"k":"semantic","v":{"s":"Structurally compliant but semantically weak — AI flagged content quality (alt text, heading meaning, reading order) that axe-core can't detect"}},{"k":"structural","v":{"s":"Code-level WCAG violations detected — axe-core found machine-checkable failures the AI rubric weighted lightly"}},{"k":"critical_override","v":{"s":"axe-core found {n} critical WCAG violation(s) — review them before trusting the blended score; an average can hide a hard failure"}},{"k":"no_text_layer","v":{"s":"Image-only scan — no searchable text layer. The high automated score is by construction (the checker only sees an empty text reconstruction, not the scanned pages); this document needs OCR before it can be made accessible."}}],"id":150}},{"k":"tagged","v":{"o":[{"k":"born_digital_note","v":{"s":"Heads-up: for text-layer PDFs the semantic tags use ActualText associations rather than full content linkage. The file is substantially more accessible, but verify in PAC 2024 or Acrobat before claiming PDF/UA conformance."}}],"id":151}},{"k":"one_click","v":{"o":[{"k":"label","v":{"s":"Make Accessible"}},{"k":"badge","v":{"s":"fully automatic — audit, fix, verify, repeat to target"}},{"k":"desc","v":{"s":"One click runs the whole pipeline hands-free with the default settings; downloads are ready at the end. Prefer control? Use \"Run Audit\" below, review the results, then click Fix & Verify yourself."}}],"id":152}},{"k":"run_audit_label","v":{"s":"Run Audit (step 1 of 2)"}},{"k":"manual_path_explainer","v":{"s":"\"Run Audit\" scores the document and shows what needs fixing — you then review and click Fix & Verify yourself (step 2). \"Make Accessible\" above does both steps plus re-checking, automatically. \"Text Extraction\" just pulls the raw text for content generation."}},{"k":"tagged_report","v":{"o":[{"k":"heading","v":{"s":"Tagged PDF report"}},{"k":"close_aria","v":{"s":"Dismiss tagged-PDF report"}},{"k":"note","v":{"s":"This panel stays until you dismiss it. The same details ship inside the Adobe-style A11y Report download."}}],"id":153}},{"k":"tagtree","v":{"o":[{"k":"label","v":{"s":"Pre-existing tag structure"}},{"k":"tooltip","v":{"s":"This PDF includes a PDF/UA-style tag tree. Auditors were instructed to credit the existing structure rather than penalize it as missing."}}],"id":154}},{"k":"resolution","v":{"o":[{"k":"heading","v":{"s":"Issue Resolution"}},{"k":"subheading","v":{"s":"Resolved {resolved} of {total} original issues ({pct}%)"}},{"k":"resolved_label","v":{"s":"Resolved"}},{"k":"persisted_label","v":{"s":"Still Present"}},{"k":"introduced_label","v":{"s":"Newly Introduced"}},{"k":"resolved_tip","v":{"s":"Issues from the original audit no longer found in the verification audit"}},{"k":"persisted_tip","v":{"s":"Issues from the original audit still present after the fix"}},{"k":"introduced_tip","v":{"s":"New issues that did not exist before the fix"}},{"k":"all_clean","v":{"s":"✓ All {total} original issues resolved — none remaining"}},{"k":"all_resolved_new","v":{"s":"✓ All {total} original issues resolved · ⊕ {introduced} new issue(s) introduced — review below"}}],"id":155}},{"k":"report","v":{"o":[{"k":"download_title","v":{"s":"Download audit report"}},{"k":"text_extract_title","v":{"s":"Extract text for content generation"}}],"id":156}},{"k":"choose_how","v":{"s":"Choose how to process this PDF:"}},{"k":"settings","v":{"o":[{"k":"audit_passes_aria","v":{"s":"Number of audit passes"}},{"k":"storm_budget","v":{"s":"Rate-limit waiting budget"}},{"k":"storm_budget_aria","v":{"s":"Minutes of rate-limit waiting before the AI passes pause"}},{"k":"storm_budget_minutes","v":{"s":"min"}},{"k":"storm_budget_minutes_long","v":{"s":"minutes"}},{"k":"storm_budget_default","v":{"s":"default"}},{"k":"storm_budget_unbounded","v":{"s":"Keep waiting"}},{"k":"storm_budget_unbounded_long","v":{"s":"Keep waiting (no budget)"}},{"k":"storm_budget_hint","v":{"s":"When Canvas rate-limits the AI, the run waits instead of failing. Once this much waiting adds up, the AI passes pause at the last verified version and you can resume later. Deterministic fixes and the audit are always kept."}},{"k":"target_score_aria","v":{"s":"Target accessibility score"}},{"k":"max_fix_passes_aria","v":{"s":"Max fix pass count"}},{"k":"auto_continue_aria","v":{"s":"Auto-continue remediation until target score"}},{"k":"polish_passes_aria","v":{"s":"Polish pass count"}}],"id":157}},{"k":"brand","v":{"o":[{"k":"heading","v":{"s":"Brand Colors"}},{"k":"where_from","v":{"s":"Where do the colors come from?"}},{"k":"match_original","v":{"s":"🎨 Match Original"}},{"k":"match_original_desc","v":{"s":"Extract colors from this PDF"}},{"k":"upload_guide","v":{"s":"📎 Upload Brand Guide"}},{"k":"upload_guide_desc","v":{"s":"Use a different doc/logo"}},{"k":"no_branding","v":{"s":"⬜ No Branding"}},{"k":"no_branding_desc","v":{"s":"Use default palette"}},{"k":"tip","v":{"s":"Tip: If you pick a specific Style Seed below (not \"Match Original\"), that seed's colors override your branding choice. To use your brand colors, pair them with the Match Original seed."}}],"id":158}},{"k":"style","v":{"o":[{"k":"heading","v":{"s":"Style Seed"}},{"k":"subtext","v":{"s":"What design style should the AI apply? WCAG compliance guaranteed by deterministic sanitizer."}},{"k":"your_custom","v":{"s":"Your Custom Styles"}},{"k":"name_label","v":{"s":"Style Name"}},{"k":"name_placeholder","v":{"s":"My Style"}},{"k":"name_aria","v":{"s":"Custom style name"}},{"k":"font_aria","v":{"s":"Font family"}},{"k":"font_inter","v":{"s":"Inter (Clean)"}},{"k":"font_georgia","v":{"s":"Georgia (Serif)"}},{"k":"font_atkinson","v":{"s":"Atkinson (A11y)"}},{"k":"font_lexend","v":{"s":"Lexend (Readable)"}},{"k":"font_comic","v":{"s":"Comic Sans (Fun)"}},{"k":"font_times","v":{"s":"Times (Classic)"}},{"k":"heading_color_label","v":{"s":"Heading Color"}},{"k":"heading_color_aria","v":{"s":"Heading color"}},{"k":"accent_color_label","v":{"s":"Accent Color"}},{"k":"accent_color_aria","v":{"s":"Accent color"}},{"k":"bg_color_aria","v":{"s":"Background color"}}],"id":159}},{"k":"triage","v":{"o":[{"k":"source_type","v":{"s":"Source type"}},{"k":"issues_to_fix","v":{"s":"Issues to fix:"}},{"k":"estimated_time","v":{"s":"Estimated remediation time:"}}],"id":160}},{"k":"post_fix","v":{"o":[{"k":"label","v":{"s":"Post-fix mode"}},{"k":"aria","v":{"s":"Post-fix mode"}}],"id":161}},{"k":"quick_downloads","v":{"o":[{"k":"heading","v":{"s":"Quick downloads (no remediation needed)"}},{"k":"tagged_pdf_title","v":{"s":"Download a Tagged PDF based on the original. For richer tagging — extracted headings, properly scoped tables, alt text — run Fix & Verify first and download the tagged version after."}}],"id":162}},{"k":"loading","v":{"o":[{"k":"title","v":{"s":"Auditing PDF Accessibility..."}},{"k":"subtitle","v":{"s":"Running 5 parallel WCAG 2.2 AA audits with triangulation. This may take 15-30 seconds."}},{"k":"progress_aria","v":{"s":"Audit in progress"}}],"id":163}},{"k":"knowbility","v":{"o":[{"k":"partner_badge","v":{"s":"Accessibility Partner"}},{"k":"mission_lead","v":{"s":"Creating an inclusive digital world for people with disabilities"}},{"k":"ada_title","v":{"s":"The Americans with Disabilities Act (ADA) Title II"}},{"k":"wcag_label","v":{"s":"WCAG 2.1 Level AA"}},{"k":"deadline_range","v":{"s":"April 2027 to April 2028"}},{"k":"broader_reach_desc","v":{"s":"Accessible content works on any device, any bandwidth, any assistive technology — reaching more users"}},{"k":"seo_desc","v":{"s":"Structured headings, alt text, and semantic HTML improve search ranking and content discovery"}},{"k":"cognitive_desc","v":{"s":"Clear navigation, consistent layouts, and plain language help all users — especially in high-cognitive-load contexts"}},{"k":"future_desc","v":{"s":"WCAG-compliant content adapts to new devices, AI readers, and emerging assistive technologies"}},{"k":"italic_callout","v":{"s":"WCAG AA isn't just about avoiding litigation — it's about building documents that are perceivable, operable, understandable, and robust for every human being."}},{"k":"audit_service_desc","v":{"s":"Expert WCAG audits and document remediation by certified professionals"}},{"k":"usability_service_desc","v":{"s":"Real-world usability testing by people who use assistive technology daily"}},{"k":"docrem_service_desc","v":{"s":"Specialist team for PDF and MS Office docs — full usability with assistive technology"}},{"k":"training_service_desc","v":{"s":"Annual conference and on-demand courses — beginner to advanced accessibility skills"}},{"k":"mission_strong","v":{"s":"Mission: Create an inclusive digital world for people with disabilities."}},{"k":"testing_desc","v":{"s":"Manual WCAG audits producing actionable reports and remediation paths for websites, apps, and documents"}},{"k":"docrem_full_desc","v":{"s":"Specialist team for PDF and MS Office documents — ensuring full usability with assistive technology"}},{"k":"accessworks_desc","v":{"s":"Real-world usability testing by people with disabilities who use assistive technology daily"}},{"k":"training_full_desc","v":{"s":"Annual conference and on-demand courses — from beginner to advanced accessibility skills"}}],"id":164}},{"k":"unavailable","v":{"o":[{"k":"title","v":{"s":"Audit Unavailable"}},{"k":"body","v":{"s":"The AI accessibility audit could not complete. This is usually caused by a temporary API issue, rate limiting, or a very large/complex PDF."}},{"k":"proceed_hint","v":{"s":"You can still proceed — Fix & Verify will transform the document and run a full audit afterward."}},{"k":"retry_hint","v":{"s":"A completed baseline audit is required before remediation. Retry the audit, or cancel and re-export the source document before trying again."}}],"id":165}},{"k":"tabs","v":{"o":[{"k":"aria","v":{"s":"Audit view"}},{"k":"remediation_results","v":{"s":"Remediation Results"}},{"k":"original_audit","v":{"s":"Original Audit"}}],"id":166}},{"k":"doc_props","v":{"o":[{"k":"aria","v":{"s":"Document properties"}},{"k":"contains_images","v":{"s":"Contains Images"}},{"k":"contains_tables","v":{"s":"Contains Tables"}},{"k":"contains_forms","v":{"s":"Contains Forms"}}],"id":167}},{"k":"reliability","v":{"o":[{"k":"std_dev","v":{"s":"Standard Deviation"}},{"k":"icc_title","v":{"s":"Custom 1−(SD/50) index; not textbook ICC"}},{"k":"icc_label","v":{"s":"Auditor Consistency (ICC-like)"}},{"k":"cronbach","v":{"s":"Auditor Consistency (α-like)"}},{"k":"cronbach_title","v":{"s":"CV + pairwise hybrid heuristic across AI passes; not textbook Cronbach's α"}},{"k":"basis_note","v":{"s":"These figures measure how consistently the AI auditors agreed with each other across re-prompts (reproducibility) — they are NOT the measurement uncertainty of the document’s true accessibility, and a tight range does not mean the score is correct."}},{"k":"ci95_title","v":{"s":"Spread of repeated AI estimates across re-prompts (reproducibility) — NOT the measurement uncertainty of the document’s true accessibility"}}],"id":168}},{"k":"score","v":{"o":[{"k":"total_checks","v":{"s":"Total checks performed"}},{"k":"issues_found","v":{"s":"Issues found"}},{"k":"ai_rubric_label","v":{"s":"AI Rubric"}},{"k":"confirmed_issues","v":{"s":"confirmed issue(s)"}},{"k":"starts_at_100","v":{"s":"Starts at 100, deducts per issue type"}},{"k":"how_ai_scores","v":{"s":"How AI scores"}},{"k":"ai_critical_rule","v":{"s":"Critical: -15 each (lang, title, alt, landmark, contrast)"}},{"k":"ai_major_rule","v":{"s":"Major: -10 each (headings, tables, forms)"}},{"k":"ai_minor_rule","v":{"s":"Minor: -5 each (skip-nav, landmarks, links, lists)"}},{"k":"ai_passes_rule","v":{"s":"Passes reduce total deductions proportionally"}},{"k":"axe_desc","v":{"s":"Deque automated WCAG 2.2 AA checker"}},{"k":"how_axe_scores","v":{"s":"How axe-core scores"}},{"k":"no_violations","v":{"s":"No violations detected"}},{"k":"average_both","v":{"s":"Average of both engines (equal weight)"}},{"k":"ai_countweight_rule","v":{"s":"A repeated issue deducts more, scaled by how many places it occurs (×1 to ×3)."}},{"k":"ai_floor_rule","v":{"s":"Floored at 0. Computed from the issue list shown — no model-reported number is used."}},{"k":"ai_incomplete_short","v":{"s":"incomplete"}},{"k":"ai_only_note","v":{"s":"AI content rubric only (automated checks unavailable)"}},{"k":"ai_passes_rule_v3","v":{"s":"Passes are informational; the score is 100 minus deductions, so passes don’t change it."}},{"k":"ai_weights_v3","v":{"s":"Critical −15 · Serious −10 · Moderate −5 · Minor −2, per unique issue"}},{"k":"and_word","v":{"s":"and"}},{"k":"automated_label","v":{"s":"Automated WCAG — the stricter of axe-core / IBM Equal Access, run on the HTML reconstruction (passes by construction; blind to byte-level PDF tagging — see the PDF/UA badge)."}},{"k":"automated_short","v":{"s":"automated"}},{"k":"axe_counts_na","v":{"s":"ran on an empty text reconstruction — counts not meaningful"}},{"k":"axe_proxy_note","v":{"s":"Runs on a text reconstruction of the extracted content — not the original PDF bytes — so page-structure/landmark rules can pass by construction. Treat as a content-level check, not a PDF/UA validation."}},{"k":"companion_tip","v":{"s":"A density read so a long document is not judged the same as a short one — the same issues spread over more pages are less pervasive. These numbers keep moving as you remediate even while a floored score sits at 0. This is NOT the score; the score above reflects only confirmed issues."}},{"k":"confirmed_fails","v":{"s":"confirmed rule failure(s)"}},{"k":"conservative_note","v":{"s":"The blend uses the more conservative of the two engines."}},{"k":"content_label","v":{"s":"Content & semantics — the AI rubric reading of meaning, alt-text quality and reading order. Reproducible: 100 minus the count-weighted deductions for the issues listed below."}},{"k":"content_short","v":{"s":"content"}},{"k":"deduction","v":{"s":"deduction"}},{"k":"det_only_incomplete","v":{"s":"structural/automated checks only; AI semantic audit incomplete — re-run for a full score"}},{"k":"ea_explains_body","v":{"s":"axe-core scored {axe}, but the second independent WCAG engine, IBM Equal Access, scored {ea} ({n} confirmed rule failure(s)). The automated layer always reports the stricter of the two engines. The headline is governed by the lower content layer, not by this number."}},{"k":"ea_explains_lead","v":{"s":"About the automated layer:"}},{"k":"ea_fails_baseline_summary","v":{"s":"What Equal Access flagged at baseline"}},{"k":"ea_fails_summary","v":{"s":"What Equal Access flagged"}},{"k":"ea_governs_body","v":{"s":"axe-core scored {axe}, but the second independent WCAG engine, IBM Equal Access, scored {ea} ({n} confirmed rule failure(s)). The headline always uses the stricter of the two engines, so Equal Access governs here, not the higher axe-core number."}},{"k":"ea_governs_lead","v":{"s":"Why the automated layer is the lower number:"}},{"k":"ea_more","v":{"s":"and"}},{"k":"ea_more2","v":{"s":"more"}},{"k":"ea_na_no_text","v":{"s":"n/a (no text layer — ran on an empty reconstruction)"}},{"k":"ea_places","v":{"s":"places"}},{"k":"ea_unavailable","v":{"s":"Second engine (IBM Equal Access) unavailable this run — score uses axe-core alone."}},{"k":"engines_agree","v":{"s":"Two independent engines agree: 0 confirmed violations (axe-core + IBM Equal Access)"}},{"k":"floored_note","v":{"s":"(floored at 0 — deductions exceed 100; with this many critical issues the 0–100 scale can’t rank further)"}},{"k":"governed_by_automated","v":{"s":"Governed by the automated layer — the WCAG checkers scored lower."}},{"k":"governed_by_content","v":{"s":"Governed by the content layer — the AI rubric scored lower."}},{"k":"governed_no_text","v":{"s":"Automated checks are not applicable (no text layer) — the content rubric governs by definition."}},{"k":"governing_lead","v":{"s":"headline = the lower (governing) layer"}},{"k":"issues_word","v":{"s":"issues"}},{"k":"lower_of","v":{"s":"lower of"}},{"k":"needs_review","v":{"s":"needing human review"}},{"k":"new_word","v":{"s":"new"}},{"k":"no_average_note","v":{"s":"The two layers measure different things and are shown separately, never averaged."}},{"k":"page","v":{"s":"page"}},{"k":"pages","v":{"s":"pages"}},{"k":"passed_checks","v":{"s":"Checks passed (informational)"}},{"k":"passed_info_title","v":{"s":"Informational only — the score is deduction-based (100 minus issues), NOT this pass ratio. A check that \"passed\" was found present, not independently verified for quality."}},{"k":"per_page","v":{"s":"per page across"}},{"k":"resolved","v":{"s":"resolved"}},{"k":"score_label","v":{"s":"score"}},{"k":"second_engine","v":{"s":"Second engine (IBM Equal Access):"}},{"k":"second_engine_baseline","v":{"s":"Second engine at baseline (IBM Equal Access):"}},{"k":"since_last","v":{"s":"Since your last audit"}},{"k":"trend_tip","v":{"s":"Change since your last audit of this file — visible even while a floored score sits at 0."}}],"id":169}},{"k":"multi_session","v":{"o":[{"k":"no_pdf_attached","v":{"s":"Original PDF isn't attached to this session — you'll be prompted to re-select it from disk when you start the fix. (Project files don't include the PDF bytes to stay small.)"}},{"k":"autosave_aria","v":{"s":"Auto-save project file after each completed range"}},{"k":"autosave_label","v":{"s":"Auto-save project file after each range"}}],"id":170}},{"k":"page_range","v":{"o":[{"k":"start_aria","v":{"s":"Start page"}},{"k":"end_aria","v":{"s":"End page"}},{"k":"clear_aria","v":{"s":"Clear page range and remediate whole document"}}],"id":171}},{"k":"fix_pass","v":{"o":[{"k":"additional_sweep","v":{"s":"Additional Sweep"}},{"k":"progress_aria","v":{"s":"Fix and verify progress"}}],"id":172}},{"k":"pipeline","v":{"o":[{"k":"tracker_aria","v":{"s":"Pipeline progress tracker"}},{"k":"why_matters","v":{"s":"Why this matters:"}}],"id":173}},{"k":"boring_palette","v":{"o":[{"k":"prompt","v":{"s":"Would you like to keep the original look or apply a theme?"}},{"k":"countdown_note","v":{"s":"Optional — no response needed. Keeping the original look automatically in {s}s; the run continues either way."}},{"k":"region_aria","v":{"s":"Optional styling choice"}}],"id":174}},{"k":"live_chunk","v":{"o":[{"k":"review_aria","v":{"s":"Live chunk remediation review"}},{"k":"heading_short","v":{"s":"Live Remediation"}},{"k":"no_fixes_title","v":{"s":"This section already meets WCAG accessibility standards — the pipeline made no changes because none were needed."}},{"k":"retried_title","v":{"s":"AI had to retry this section once after the first attempt failed integrity or token-preservation checks."}},{"k":"content_verified_title","v":{"s":"AI content-preservation check passed — the section's text content was preserved through the rewrite."}},{"k":"ai_skipped_long_title","v":{"s":"AI rewrite failed or was rejected for this section — only deterministic (rule-based) fixes were applied. The section is still more accessible than the original, just less so than successfully AI-fixed sections."}},{"k":"ai_skipped_rule_only","v":{"s":"AI skipped · rule-based only"}},{"k":"review_heading","v":{"s":"Live Remediation Review"}},{"k":"review_subhead","v":{"s":"Watch each section get fixed in real time — reject or re-fix anything that looks wrong"}},{"k":"progress_aria","v":{"s":"Live remediation progress"}},{"k":"rule_based_title","v":{"s":"Rule-based (deterministic) regex fixes applied — always safe, no AI involved"}},{"k":"targeted_title","v":{"s":"AI-diagnosed targeted micro-fixes applied via deterministic tools (content-preserving)"}},{"k":"ai_skipped_short_title","v":{"s":"AI rewrite failed or was rejected for this section — only rule-based fixes were applied. Still more accessible than the original."}},{"k":"ai_skipped_short","v":{"s":"AI skipped"}},{"k":"verified_title","v":{"s":"AI verified content preserved"}},{"k":"integrity_title","v":{"s":"Word overlap integrity check passed"}},{"k":"before","v":{"s":"Before (original)"}},{"k":"after","v":{"s":"After (fixed)"}},{"k":"integrity_note","v":{"s":"Integrity note:"}},{"k":"violations_targeted","v":{"s":"Violations targeted in this pass"}},{"k":"clear_history_aria","v":{"s":"Clear live review history"}},{"k":"no_changes_card","v":{"s":"no changes"}},{"k":"no_changes_card_title","v":{"s":"No changes were made to this section this run. The green badges below confirm its content is intact — not that it was edited."}},{"k":"not_scored","v":{"s":"not scored (AI throttled)"}},{"k":"reject_title","v":{"s":"Revert this section to the original text. Works while the loop is running: it adopts your choice at its next pass and will not revert it."}},{"k":"waiting","v":{"s":"Waiting for the first section… If this stays empty while the run progresses, the live view lost run ownership (see the 🔧 Log — the remediation itself is unaffected)."}}],"id":175}},{"k":"why_matters","v":{"o":[{"k":"heading","v":{"s":"Why Accessible Documents Matter"}},{"k":"udl_part1","v":{"s":"Accessible materials support Universal Design for Learning (UDL) — benefiting"}},{"k":"all","v":{"s":"all"}},{"k":"udl_part2","v":{"s":"learners regardless of ability, language, or learning style"}},{"k":"ux_part1","v":{"s":"Clear headings, logical structure, and sufficient contrast make documents easier to read for"}},{"k":"ux_part2","v":{"s":"users — including on mobile and in bright sunlight"}},{"k":"seo_desc","v":{"s":"Semantic HTML, alt text, and proper headings help search engines index content — boosting discoverability and organic reach"}},{"k":"innovation_desc","v":{"s":"Voice recognition, closed captioning, and screen readers all began as accessibility features — then became essential tools used by millions"}}],"id":176}},{"k":"ada","v":{"o":[{"k":"heading","v":{"s":"ADA Title II & WCAG 2.1 AA"}},{"k":"deadline_badge","v":{"s":"Deadline: April 26, 2027"}},{"k":"title_strong","v":{"s":"Title II of the Americans with Disabilities Act (ADA)"}},{"k":"wcag_strong","v":{"s":"WCAG 2.1 Level AA"}},{"k":"deadline_50k","v":{"s":"April 26, 2027"}},{"k":"deadline_small","v":{"s":"April 26, 2028"}},{"k":"covered_desc","v":{"s":"Public-facing websites, mobile apps, digital documents (PDFs, Word, Excel, PowerPoint), and social media published by government entities"}},{"k":"who_desc","v":{"s":"All state and local government entities — including public schools, universities, courts, libraries, transit agencies, and municipal services"}},{"k":"matters_desc","v":{"s":"Beyond legal compliance: accessible documents ensure people with disabilities can equally access education, public services, employment, and civic participation"}},{"k":"standard_callout","v":{"s":"AlloFlow targets WCAG 2.2 Level AA, which builds on the WCAG 2.1 Level AA standard this federal rule requires."}},{"k":"extension_note","v":{"s":"DOJ extended these deadlines in 2026, citing the unreliability of automated remediation tools — verified accessibility is exactly the gap this pipeline exists to close. HHS Section 504 deadlines were similarly extended to May 2027/2028."}}],"id":177}},{"k":"doc_details","v":{"o":[{"k":"heading","v":{"s":"Document Details"}}],"id":178}},{"k":"images","v":{"o":[{"k":"review_heading","v":{"s":"Review Image Descriptions"}},{"k":"download_all_title","v":{"s":"Download every extracted image — useful as a manual fallback if AI reinsertion misplaces or skips one."}},{"k":"edit_alt_hint","v":{"s":"Edit alt text below — changes apply to the final document"}},{"k":"download_one_title","v":{"s":"Download this image"}},{"k":"ai_generated_badge","v":{"s":"AI Generated"}},{"k":"alt_placeholder","v":{"s":"Describe this image for screen reader users..."}},{"k":"regen_title","v":{"s":"Regenerate this image via AI using the stored description"}},{"k":"dropped_by_ai","v":{"s":"Dropped by AI pass"}},{"k":"regen_hint","v":{"s":"Click Regenerate to recreate an image via AI using its stored description, or use Upload/Replace inside the figure in the preview."}},{"k":"dup_badge","v":{"s":"copies"}},{"k":"dup_title","v":{"s":"This exact image appears "}},{"k":"dup_title2","v":{"s":" times in the document — one description covers every copy."}}],"id":179}},{"k":"integrity","v":{"o":[{"k":"verifying","v":{"s":"Verifying content integrity…"}},{"k":"diff_open_verifying_aria","v":{"s":"Open diff view (verification still running in background)"}},{"k":"diff_open_verifying_title","v":{"s":"Open the word-level diff view. The integrity verification is still running in the background, but the diff itself is ready now."}},{"k":"unverified","v":{"s":"Content integrity unverified"}},{"k":"diff_open_aria","v":{"s":"Open diff view of source PDF text vs. final HTML"}},{"k":"diff_open_title","v":{"s":"Side-by-side word-level diff: see every insertion, deletion, and paraphrase between the source PDF and the remediated HTML."}},{"k":"recheck_aria","v":{"s":"Re-run pdf.js content integrity check"}},{"k":"recheck_title","v":{"s":"Re-run the fidelity recovery ladder (Stages A-D) against the current remediated HTML."}}],"id":180}},{"k":"verification","v":{"o":[{"k":"details_heading","v":{"s":"Verification details"}},{"k":"char_coverage","v":{"s":"Char coverage"}},{"k":"word_coverage","v":{"s":"Word coverage"}},{"k":"source_words","v":{"s":"Source words"}},{"k":"recovery_stages","v":{"s":"Recovery stages applied"}},{"k":"ai_retry","v":{"s":"AI retry"}},{"k":"ground_truth","v":{"s":"Ground truth:"}},{"k":"open_diff_title","v":{"s":"Open the word-level diff view"}},{"k":"estimated_min_basis","v":{"s":"Basis"}},{"k":"estimated_min_body","v":{"s":"Lower confidence: this uses the lower of the last successful AI audit and the current automated checks. Complete the final audit to verify the score."}},{"k":"estimated_min_label","v":{"s":"Estimated minimum"}},{"k":"probing","v":{"s":"testing with one small call..."}},{"k":"reaudit","v":{"s":"Complete final audit"}},{"k":"reaudit_aria","v":{"s":"Re-run the AI audit on all sections to recover sections the service throttled"}},{"k":"reaudit_title","v":{"s":"Re-checks the whole document, so the sections the AI service throttled last time get audited again and the score becomes full-coverage."}},{"k":"reauditing","v":{"s":"Completing final audit..."}},{"k":"reauditing_short","v":{"s":"Completing audit..."}},{"k":"waiting_for_checker","v":{"s":"Waiting for the AI checker to settle..."}},{"k":"ai_incomplete_summary","v":{"s":"AI semantic verification incomplete{detail}. The score shown is structural/automated checks; use “Complete final audit” below to finish the AI check when the service is calm — it audits only, and keeps this document as it is."}}],"id":181}},{"k":"fidelity","v":{"o":[{"k":"heading","v":{"s":"Verify Text Fidelity"}},{"k":"run_title","v":{"s":"Compare the remediated document against the source text — flags any words that appear in the source but not in the current remediated output."}},{"k":"run_aria","v":{"s":"Run text fidelity check against source OCR"}},{"k":"restore_title","v":{"s":"Splice missing words back into the remediated document using fuzzy context-anchor matching. Unplaceable words go to a Content Recovery appendix so nothing is lost."}},{"k":"restore_aria","v":{"s":"Restore missing words into the remediated document"}},{"k":"not_ready","v":{"s":"Remediation not ready."}}],"id":182}},{"k":"resume","v":{"o":[{"k":"heading","v":{"s":"Saved Progress Found"}}],"id":183}},{"k":"start_new_title","v":{"s":"Clear this audit result and start fresh with a new PDF"}},{"k":"results","v":{"o":[{"k":"verified_accessible","v":{"s":"Verified Accessible"}},{"k":"zero_violations","v":{"s":"Zero WCAG violations detected"}},{"k":"ai_reported_passing","v":{"s":"Reported passing (AI rubric — not independently verified)"}},{"k":"ready_heading","v":{"s":"Your accessible copy is ready"}},{"k":"ready_heading_verify","v":{"s":"Accessible copy ready — verify content before sharing"}},{"k":"ready_heading_working","v":{"s":"Draft accessible copy ready — still improving…"}}],"id":184}},{"k":"wcag_report","v":{"o":[{"k":"coverage_note","v":{"s":"Coverage may be incomplete — this view aggregates axe-core rules by WCAG SC. Manual review still required for some criteria (e.g. semantic meaning, reading order, complex forms)."}},{"k":"guidance","v":{"s":"Guidance"}},{"k":"untested_inapplicable","v":{"s":"Automated tests exist but none applied to this content"}},{"k":"untested_manual","v":{"s":"No automated test exists — manual review only"}},{"k":"untested_note","v":{"s":"These criteria are in scope for WCAG 2.2 AA but produced no automated result on this document. They are neither passing nor failing here — they are unmeasured, and a conformance claim that covers them needs a human reviewer."}},{"k":"which_rules","v":{"s":"Which checks ran"}},{"k":"scope","v":{"s":"Scope: WCAG 2.2 Level A and AA — {total} success criteria. {exercised} were exercised by an automated engine on this document; {untested} were not."}},{"k":"untested_heading","v":{"s":"Not evaluated on this document ({untested} of {total} criteria)"}}],"id":185}},{"k":"auto_fix","v":{"o":[{"k":"stop_aria","v":{"s":"Stop auto-continue remediation"}},{"k":"progress_aria","v":{"s":"Auto-fix progress"}}],"id":186}},{"k":"section_map","v":{"o":[{"k":"heading","v":{"s":"Document Section Map"}},{"k":"rule_based_title","v":{"s":"Rule-based (deterministic) fixes applied"}},{"k":"targeted_title","v":{"s":"AI-diagnosed targeted micro-fixes"}},{"k":"ai_skipped_title","v":{"s":"AI rewrite was rejected — only rule-based fixes applied"}},{"k":"ai_skipped","v":{"s":"AI skipped"}}],"id":187}},{"k":"expert_referral","v":{"o":[{"k":"heading","v":{"s":"This Document Needs Expert Accessibility Remediation"}}],"id":188}},{"k":"diff","v":{"o":[{"k":"button_aria","v":{"s":"Open word-level diff view between source PDF and remediated HTML"}},{"k":"button_title","v":{"s":"Open the word-level diff modal — see every insertion, deletion, and paraphrase between the source PDF text and the remediated HTML, with click-to-reject and Apply & Export."}}],"id":189}},{"k":"pdf_from_html","v":{"o":[{"k":"title","v":{"s":"Regenerate a PDF from the remediated HTML. Layout reflows — page breaks, fonts, and pagination may differ from the original. Works well for simple prose documents."}}],"id":190}},{"k":"tagged_pdf","v":{"o":[{"k":"title","v":{"s":"Preserve the original PDF's visual layout byte-identical and inject accessibility tags into its structure tree. Best for textbooks, multi-column documents, and branded PDFs where visual fidelity matters."}},{"k":"office_note","v":{"s":"Tagged PDF applies to PDF inputs — use Word/HTML"}},{"k":"office_note_title","v":{"s":"Structure tags can only be injected into PDF bytes. For Word/PowerPoint inputs, the accessible Word and HTML downloads carry the remediated structure."}},{"k":"sanitized_label","v":{"s":"Rebuild clean (drops embedded scripts)"}},{"k":"sanitized_title","v":{"s":"Rebuild a CLEAN tagged PDF from the remediated content instead of tagging the original file. Because it regenerates the PDF, it drops embedded JavaScript, open/launch actions, file attachments, and original metadata."}},{"k":"typeset_label","v":{"s":"Tagged PDF (generated layout)"}},{"k":"typeset_title","v":{"s":"Word/PowerPoint inputs have no PDF bytes to tag — this generates a CLEAN typeset PDF from the remediated content (simple layout, NOT the original design) and runs the full tagger on it: real structure tree, verified after saving, declaration only when earned."}}],"id":191}},{"k":"docx_export","v":{"o":[{"k":"title","v":{"s":"Convert the remediated content into a Word document with real heading styles, alt text on images, table header rows, list structure, and working hyperlinks. Verify with Word's built-in Accessibility Checker (Review → Check Accessibility) before distributing."}}],"id":192}},{"k":"pptx_export","v":{"o":[{"k":"title","v":{"s":"Rebuild the remediated content as a PowerPoint deck with real slide titles, alt text on images, header-styled table rows, true bullet lists, and reading order = visual order. A rebuilt accessible layout — not a visual clone of the original. Verify with PowerPoint's Accessibility Checker before distributing."}}],"id":193}},{"k":"dashboard","v":{"o":[{"k":"aria","v":{"s":"Remediation results overview and section navigation"}},{"k":"score_title","v":{"s":"Accessibility score: before → after"}},{"k":"zero_issues","v":{"s":"0 issues"}},{"k":"section_from_full_audit","v":{"s":"This section is produced by a full audit — your latest pass was an incremental fix, so it was not regenerated. Run a fresh audit to refresh it; the rest of the results are below."}},{"k":"issues_left","v":{"s":"issues left"}},{"k":"verify","v":{"s":"Verification"}},{"k":"recovery","v":{"s":"Recovery"}},{"k":"axe","v":{"s":"Issues (axe)"}},{"k":"downloads","v":{"s":"Downloads"}},{"k":"tags","v":{"s":"Tag inspector"}},{"k":"workbench","v":{"s":"Workbench"}},{"k":"changed","v":{"s":"What changed"}},{"k":"foundations","v":{"s":"HTML foundations"}},{"k":"foundations_tips","v":{"s":"best-practice tip(s)"}},{"k":"foundations_advisory_title","v":{"s":"Best-practice structure recommendations — these IMPROVE the document outline / landmarks but are NOT WCAG failures and are NOT counted in the score (axe's region / page-has-heading-one / heading-order are best-practice rules). Recommendations:"}},{"k":"automated_tag","v":{"s":"automated"}},{"k":"automated_tag_title","v":{"s":"Headline governed by the automated layer (axe-core / IBM Equal Access) — the lower of the engines. The AI content rubric may be higher; see the breakdown below."}},{"k":"content_structural_tag","v":{"s":"structural only"}},{"k":"content_tag","v":{"s":"content"}},{"k":"estimated_min","v":{"s":"est. min"}},{"k":"estimated_min_title","v":{"s":"Lower-confidence estimate: the lower of the last successful AI audit and the current automated checks. Complete the final audit for a verified score."}},{"k":"fidelity_limited","v":{"s":"⚠ verify content"}},{"k":"fidelity_limited_title","v":{"s":"Asterisk: content fidelity is limited on this run (reduced coverage or fidelity notes) — a high score must not be read as “all good”. See the fidelity panel below for the specifics."}},{"k":"human_edit","v":{"s":"human edit"}},{"k":"human_edits","v":{"s":"human edits"}},{"k":"human_edits_title","v":{"s":"The automated loop adopted this many human edits while it ran. This is a collaborative result (automated passes + human edits) — the scores describe the combined document."}},{"k":"pdfua_title","v":{"s":"PDF/UA conformance of the EXPORTED tagged PDF — the actual file you hand out, distinct from the content score."}},{"k":"pdfua_validating","v":{"s":"PDF/UA: validating…"}},{"k":"reading_order","v":{"s":"Reading order"}},{"k":"reading_order_title","v":{"s":"Logical reading order of the EXPORTED tagged PDF, verified from the saved structure tree used by assistive technology."}},{"k":"score_incomplete_title","v":{"s":"Structural/automated checks only — the AI semantic audit was throttled and did not finish, so this is NOT a verified content score."}},{"k":"section_unavailable","v":{"s":"That section has nothing to show for this pass — everything else is below."}}],"id":194}},{"k":"tag_to_workbench_title","v":{"s":"Send this block to the Expert Workbench: prefills a targeted command (including any warnings) so you can fix it with one instruction"}},{"k":"tag_to_workbench_aria","v":{"s":"Send to Expert Workbench"}},{"k":"pptx_theme_aria","v":{"s":"PowerPoint export theme"}},{"k":"pptx_theme_title","v":{"s":"Slide theme for the PowerPoint export. All presets are contrast-checked (WCAG AA); the AI option matches your topic, with legibility enforced locally either way."}},{"k":"alt_formats","v":{"o":[{"k":"intro","v":{"s":"Download the remediated document in accessible alternative formats"}}],"id":195}},{"k":"export_menu","v":{"o":[{"k":"button","v":{"s":"Export / Download"}},{"k":"aria","v":{"s":"Export formats"}},{"k":"intro","v":{"s":"Download the remediated document in any format — pick the one that fits how it’ll be used."}},{"k":"group_docs","v":{"s":"Documents"}},{"k":"tagged_pdf","v":{"s":"Tagged PDF (PDF/UA — give to students)"}},{"k":"word","v":{"s":"Word (.docx — keep editing)"}},{"k":"pptx","v":{"s":"PowerPoint (.pptx — present it)"}},{"k":"html","v":{"s":"HTML (opens anywhere, no software)"}},{"k":"group_access","v":{"s":"Accessible formats"}},{"k":"daisy","v":{"s":"DAISY talking book (full text)"}},{"k":"daisy_title","v":{"s":"DAISY 3 (DTBook) full-text talking-book package. Open in a DAISY reader, which provides speech, braille, or large print. (For synced read-aloud audio, use Read-along below.)"}},{"k":"readalong","v":{"s":"Read-along ebook (synced audio)"}},{"k":"readalong_progress","v":{"s":"Narrating… {done}/{total}"}},{"k":"readalong_title","v":{"s":"Read-along ebook (EPUB3 Media Overlays): generates text-to-speech for each paragraph and syncs it to the text so a reading system highlights words as they’re spoken. Makes many voice calls — can take a few minutes."}},{"k":"group_text","v":{"s":"Text & editable"}},{"k":"odt","v":{"s":"ODT (LibreOffice / Google Docs)"}},{"k":"odt_title","v":{"s":"OpenDocument Text — opens natively in LibreOffice and Google Docs (and Word)."}},{"k":"group_audio","v":{"s":"Audio narration"}},{"k":"audio","v":{"s":"Audio narration (standard)"}},{"k":"audio_title","v":{"s":"Spoken narration of the document (MP3/WAV)."}},{"k":"audio_sr","v":{"s":"Audio (screen-reader style)"}},{"k":"audio_sr_title","v":{"s":"Same voice, but announcing structure the way a screen reader would (heading levels, list counts, table rows, image alts)."}}],"id":196}},{"k":"mo","v":{"o":[{"k":"confirm","v":{"s":"Build a read-along ebook? This narrates {n} text sections with text-to-speech — about {n} voice calls, which can take a few minutes."}},{"k":"confirm_action","v":{"s":"Build read-along"}},{"k":"confirm_title","v":{"s":"Build read-along ebook?"}}],"id":197}},{"k":"expert","v":{"o":[{"k":"command_aria","v":{"s":"Expert remediation command"}},{"k":"log_aria","v":{"s":"Agent activity log"}}],"id":198}},{"k":"translate","v":{"o":[{"k":"lang_aria","v":{"s":"Translation language — type any language or pick from suggestions"}},{"k":"lang_placeholder","v":{"s":"🌐 Type language (e.g. Spanish, Tagalog, Dari...)"}},{"k":"close","v":{"s":"Close"}},{"k":"compare_aria","v":{"s":"Original and translated document, side by side"}},{"k":"compare_close","v":{"s":"Close comparison"}},{"k":"compare_heading","v":{"s":"Original ↔ "}},{"k":"iframe_original","v":{"s":"Remediated original document"}},{"k":"iframe_translated","v":{"s":"Translated document — "}},{"k":"kept_original","v":{"s":"sections kept the original text"}},{"k":"pane_note","v":{"s":"AI-translated, review before official use"}},{"k":"pane_original","v":{"s":"Remediated original"}},{"k":"stale_title","v":{"s":"The document changed after this translation was made — regenerate it to re-sync."}}],"id":199}},{"k":"simplify","v":{"o":[{"k":"level_aria","v":{"s":"Adapted text grade level"}}],"id":200}},{"k":"plain_summary","v":{"o":[{"k":"intro","v":{"s":"Generate an easy-to-read version for parents, guardians, or community members."}},{"k":"lang_aria","v":{"s":"Translation language"}}],"id":201}},{"k":"close_confirm","v":{"o":[{"k":"title","v":{"s":"Close without saving?"}},{"k":"save_close","v":{"s":"Save & close"}}],"id":202}},{"k":"preview","v":{"o":[{"k":"modal_aria","v":{"s":"Accessible document preview and editor"}},{"k":"close_aria","v":{"s":"Close preview"}},{"k":"edit_hint","v":{"s":"Click anywhere in the preview to edit text directly. Use the controls below to customize appearance."}},{"k":"wcag_guaranteed","v":{"s":"Text contrast is re-verified by the deterministic sanitizer on every style change (contrast only — not a full WCAG audit)."}},{"k":"ai_restyle_hint","v":{"s":"One-click AI restyling. These override the theme above."}},{"k":"body_font_aria","v":{"s":"Body font"}},{"k":"font_system","v":{"s":"System (Default)"}},{"k":"font_georgia","v":{"s":"Georgia (Serif)"}},{"k":"font_times_new","v":{"s":"Times New Roman"}},{"k":"font_atkinson_hyper","v":{"s":"Atkinson Hyperlegible"}},{"k":"font_comic_short","v":{"s":"Comic Sans"}},{"k":"font_courier","v":{"s":"Courier (Mono)"}},{"k":"font_size_aria","v":{"s":"Font size"}},{"k":"live_preview","v":{"s":"Live Preview"}},{"k":"iframe_title","v":{"s":"Accessible document preview"}},{"k":"export_dequeued","v":{"s":"Remediation settled - generating the tagged PDF you queued."}},{"k":"print_style_label","v":{"s":"Save as PDF (print-style, unverified)"}},{"k":"print_style_title","v":{"s":"Print-style copy via your browser’s Save as PDF — tag preservation depends on the browser and this copy is not independently verified. Use Generate Tagged PDF above for the verified accessible file."}}],"id":203}},{"k":"wordart","v":{"o":[{"k":"text_placeholder","v":{"s":"Your word art text..."}},{"k":"text_aria","v":{"s":"Word art text"}}],"id":204}},{"k":"a11y_inspect","v":{"o":[{"k":"headings","v":{"s":"Headings (H1-H6)"}},{"k":"images","v":{"s":"Images + alt text"}},{"k":"tables","v":{"s":"Tables + headers"}},{"k":"figures","v":{"s":"Figures + captions"}},{"k":"main_landmark","v":{"s":"Main landmark"}},{"k":"aria_roles","v":{"s":"ARIA roles"}},{"k":"reading_order","v":{"s":"Reading order (#1, #2 … — the order a screen reader walks the blocks)"}}],"id":205}},{"k":"ai_image","v":{"o":[{"k":"prompt_placeholder","v":{"s":"Describe an image to generate..."}},{"k":"prompt_aria","v":{"s":"Image generation prompt"}},{"k":"select_hint","v":{"s":"Click an image in the preview to select it, then:"}}],"id":206}},{"k":"layout","v":{"o":[{"k":"insert_blocks","v":{"s":"Insert Blocks"}},{"k":"header_branding","v":{"s":"Header / Branding"}}],"id":207}},{"k":"templates","v":{"o":[{"k":"aria","v":{"s":"Document template"}},{"k":"apply_placeholder","v":{"s":"Apply template..."}},{"k":"saved_heading","v":{"s":"Saved Accessible Templates"}}],"id":208}},{"k":"version_stamp","v":{"o":[{"k":"heading","v":{"s":"Version Stamp"}}],"id":209}},{"k":"extracted_images","v":{"o":[{"k":"drag_hint","v":{"s":"Drag a thumbnail onto any image placeholder in the preview to insert it, or click \"📷 Upload\" inside a placeholder and choose \"Use extracted image\"."}},{"k":"drag_hint2","v":{"s":"Click a thumbnail to insert it into the first open image slot, or drag it onto any specific placeholder or image in the preview. ×N = the same image appeared on N pages (usually a letterhead or logo)."}},{"k":"insert_aria","v":{"s":"Insert extracted image into the first open slot"}}],"id":210}},{"k":"toolbar","v":{"o":[{"k":"aria","v":{"s":"Text formatting"}},{"k":"bullet_list","v":{"s":"Bullet list"}},{"k":"numbered_list","v":{"s":"Numbered list"}},{"k":"align_left","v":{"s":"Align left"}},{"k":"align_center","v":{"s":"Align center"}},{"k":"align_center_title","v":{"s":"Center"}},{"k":"insert_link","v":{"s":"Insert link"}},{"k":"remove_link","v":{"s":"Remove link"}},{"k":"clear_formatting","v":{"s":"Clear formatting"}},{"k":"undo","v":{"s":"Undo"}},{"k":"redo","v":{"s":"Redo"}},{"k":"text_color","v":{"s":"Text color"}},{"k":"highlight_color","v":{"s":"Highlight color"}},{"k":"insert_table_aria","v":{"s":"Insert table"}},{"k":"insert_table_title","v":{"s":"Insert accessible table"}},{"k":"smart_table_aria","v":{"s":"Smart table: paste data, get an accessible table"}},{"k":"smart_table_title","v":{"s":"Smart table — paste ANY data (rows from email, notes, CSV) and get a clean accessible table. Delimited data parses instantly with no AI; messy data is organized by AI using only your values."}}],"id":211}},{"k":"cached_result_hint","v":{"s":"Retry Audit runs fresh"}},{"k":"cached_result_pill","v":{"s":"Cached audit"}},{"k":"chips","v":{"o":[{"k":"ai_calls_title","v":{"s":"Text AI requests made so far in this run"}},{"k":"ai_vision_title","v":{"s":"AI Vision requests — pages and images the AI has read visually"}},{"k":"recovered_title","v":{"s":"Retries that then succeeded"}},{"k":"retries_title","v":{"s":"Requests re-attempted after a timeout or rate-limit — nothing is skipped, retried work is re-attempted later in the run"}},{"k":"throttle_title","v":{"s":"Times the AI service signaled a rate limit and this run deliberately backed off"}}],"id":212}},{"k":"clear_cache_btn","v":{"s":"Clear cache"}},{"k":"clear_cache_done","v":{"s":"Cleared cached results"}},{"k":"clear_cache_failed","v":{"s":"Could not clear the cache"}},{"k":"clear_cache_title","v":{"s":"Forget every cached audit/remediation result so all documents run fresh"}},{"k":"clear_cache_unavailable","v":{"s":"Cache clearing is unavailable on this host version."}},{"k":"companion","v":{"o":[{"k":"stale","v":{"s":"out of date — regenerate"}}],"id":213}},{"k":"compare","v":{"o":[{"k":"transcript_heading","v":{"s":"AI transcript of the original recording — review for transcription errors; the After pane is the remediated document built from it."}}],"id":214}},{"k":"diag","v":{"o":[{"k":"caches_cleared","v":{"s":"Document caches cleared"}},{"k":"clear","v":{"s":"Clear"}},{"k":"close","v":{"s":"Close"}},{"k":"close_aria","v":{"s":"Close diagnostics log"}},{"k":"copied","v":{"s":"Diagnostics log copied"}},{"k":"copy","v":{"s":"Copy"}},{"k":"copy_failed","v":{"s":"Could not copy — select the text manually."}},{"k":"empty","v":{"s":"No log entries yet — run a remediation and they will appear here live."}},{"k":"forget_caches","v":{"s":"Forget caches"}},{"k":"forget_caches_title","v":{"s":"Forget cached audit/remediation results so the next run is fully fresh (diagnostics)"}},{"k":"label","v":{"s":"Log"}},{"k":"lines","v":{"s":"lines"}},{"k":"open_aria","v":{"s":"Open pipeline diagnostics log"}},{"k":"open_title","v":{"s":"Pipeline diagnostics log — view + copy the remediation log (works inside Canvas, no browser console needed)"}},{"k":"region_aria","v":{"s":"Pipeline diagnostics log"}},{"k":"title","v":{"s":"Pipeline diagnostics"}},{"k":"warn_only","v":{"s":"Warnings only"}}],"id":215}},{"k":"fidelity_gate","v":{"o":[{"k":"anyway","v":{"s":"Download anyway (I’ve reviewed)"}},{"k":"body","v":{"s":"The remediated document may be missing source content"}},{"k":"body2","v":{"s":"A tagged PDF will look complete but could be missing text. Open the Diff to compare it against the original first."}},{"k":"diff","v":{"s":"Open the Diff to review"}},{"k":"dismiss","v":{"s":"Dismiss"}},{"k":"heading","v":{"s":"Review the content before distributing this document"}}],"id":216}},{"k":"fillable","v":{"o":[{"k":"apply","v":{"s":"Convert"}},{"k":"apply2","v":{"s":"fields"}},{"k":"approx_title","v":{"s":"Position estimated from character widths — check this one in the result."}},{"k":"cancel","v":{"s":"Cancel"}},{"k":"checkboxes","v":{"s":"checkboxes"}},{"k":"footer","v":{"s":"Amber labels need a name — unlabeled fields confuse screen readers."}},{"k":"include_aria","v":{"s":"Include field: "}},{"k":"label_ph","v":{"s":"Field label (needed for screen readers)"}},{"k":"panel_aria","v":{"s":"Review detected form fields"}},{"k":"panel_heading","v":{"s":"Detected blanks — review before converting"}},{"k":"panel_note","v":{"s":"uncheck any false positives; edit labels (screen readers announce them)."}},{"k":"pdf_apply","v":{"s":"Place"}},{"k":"pdf_apply2","v":{"s":"fields + download"}},{"k":"pdf_footer","v":{"s":"The original visual layout is preserved exactly."}},{"k":"pdf_found","v":{"s":"blanks across"}},{"k":"pdf_note","v":{"s":"fields go exactly where the blanks print. ~ marks position-estimated ones."}},{"k":"pdf_pages","v":{"s":"page(s)"}},{"k":"pdf_panel_aria","v":{"s":"Review detected PDF form fields"}},{"k":"pdf_panel_heading","v":{"s":"Blanks found on the original pages — review before placing fields"}},{"k":"text_fields","v":{"s":"text fields"}}],"id":217}},{"k":"format_legend","v":{"o":[{"k":"body","v":{"s":"📄 Tagged PDF — give this to students (looks identical to the original, works with screen readers). 📝 Word — keep editing it. 📽 PowerPoint — present it. 📄 HTML — opens anywhere, no software needed."}},{"k":"lead","v":{"s":"Which file?"}}],"id":218}},{"k":"genimg","v":{"o":[{"k":"label","v":{"s":"(AI-generated illustration — verify it matches the intended diagram before sharing)"}}],"id":219}},{"k":"hidden_tab","v":{"o":[{"k":"accrued","v":{"s":"This run was hidden ~{m} min so far."}},{"k":"tip","v":{"s":"💡 Keep this tab visible — a minimized or covered tab runs slower (the browser pauses page rendering), though nothing is lost."}},{"k":"welcome_back","v":{"s":"Welcome back — this tab was hidden for about {m} min, which slows the run (the browser pauses page rendering in hidden tabs). Nothing was lost; the run continued safely."}}],"id":220}},{"k":"issue","v":{"o":[{"k":"ai_applied","v":{"s":"✨ Applied to this section — re-checking…"}},{"k":"ai_aria","v":{"s":"Describe a fix for this section for the AI"}},{"k":"ai_btn","v":{"s":"Apply with AI"}},{"k":"ai_btn_title","v":{"s":"The AI edits ONLY this section (bounded), then re-checks — accept or revert."}},{"k":"ai_nochange","v":{"s":"The AI made no change here (or it was busy) — rephrase, or edit the HTML directly above."}},{"k":"ai_norescore","v":{"s":"✨ Applied. Couldn’t re-score automatically (the checker was busy) — the document is updated; re-run the audit when ready."}},{"k":"ai_placeholder","v":{"s":"or describe the fix — the AI edits just this section"}},{"k":"ai_running","v":{"s":"✨ Asking the AI to apply that to this section…"}},{"k":"ai_scoped_hint","v":{"s":"Scoped to this section only — bounded so the agent can’t touch the rest of the document."}},{"k":"ai_unavailable","v":{"s":"The AI agent is unavailable right now — edit the HTML directly above instead."}},{"k":"edit","v":{"s":"Edit & re-check"}},{"k":"edit_ambiguous","v":{"s":"This exact markup appears more than once — use the Expert Workbench for a targeted fix instead."}},{"k":"edit_applied_no_reaudit","v":{"s":"✏ Edit applied. (Couldn’t re-score automatically — the preview is updated; re-run audit when ready.)"}},{"k":"edit_aria","v":{"s":"Edit the HTML for this issue"}},{"k":"edit_cancel","v":{"s":"Cancel"}},{"k":"edit_hint","v":{"s":"Edits the HTML directly, then runs the same check the Workbench uses — no AI."}},{"k":"edit_moved","v":{"s":"That section changed since you opened it — close and reopen Source, then try again."}},{"k":"edit_nochange","v":{"s":"No change to save."}},{"k":"edit_rechecked","v":{"s":"📊 Re-checked: "}},{"k":"edit_save","v":{"s":"Save & re-check"}},{"k":"edit_saved","v":{"s":"✏ Manual edit applied — re-checking…"}},{"k":"edit_saving","v":{"s":"Re-checking…"}},{"k":"edit_title","v":{"s":"Edit this section’s HTML yourself and re-check — a direct expert path that does not use the AI (works even when the AI is rate-limited)."}},{"k":"find","v":{"s":"Find"}},{"k":"find_aria","v":{"s":"Find in preview"}},{"k":"find_title","v":{"s":"Scroll the preview to this spot and highlight it"}},{"k":"no_jump","v":{"s":"No precise spot for this one — it’s document-level or couldn’t be pinpointed."}},{"k":"preview_gone","v":{"s":"Open the preview to jump to an issue."}},{"k":"sent_workbench","v":{"s":"🛠 Loaded into the Expert Workbench below — review and run it."}},{"k":"source","v":{"s":"Source"}},{"k":"source_anchor","v":{"s":"Auditor note"}},{"k":"source_aria","v":{"s":"Show source"}},{"k":"source_coarse","v":{"s":"This issue is document- or page-level — there is no single text spot to show."}},{"k":"source_context","v":{"s":"Context (text around this issue)"}},{"k":"source_html","v":{"s":"Source (from the remediated document)"}},{"k":"source_page","v":{"s":"page"}},{"k":"source_page_cap","v":{"s":"Page"}},{"k":"source_region","v":{"s":"Source of issue"}},{"k":"source_title","v":{"s":"Show the source of this issue inline — no need to open the preview"}},{"k":"spot_moved","v":{"s":"Couldn’t find that spot in the current preview (the text may have changed)."}},{"k":"workbench_aria","v":{"s":"Send to Expert Workbench"}},{"k":"workbench_title","v":{"s":"Send to the Expert Workbench — prefills a targeted fix command (with the exact spot when known)"}}],"id":221}},{"k":"palette","v":{"o":[{"k":"ai_asking","v":{"s":"✨ Asking the AI for a palette:"}},{"k":"ai_failed","v":{"s":"The AI couldn’t suggest a palette right now (it may be busy) — pick a preset above; contrast is guaranteed either way."}},{"k":"applied","v":{"s":"🎨 Applied palette:"}},{"k":"failed","v":{"s":"Palette apply failed:"}},{"k":"reverted","v":{"s":"↩ Reverted to the original colours."}},{"k":"unavailable","v":{"s":"Palette tools are still loading — try again in a moment."}}],"id":222}},{"k":"pdfua_badge","v":{"o":[{"k":"lead","v":{"s":"PDF/UA-1"}},{"k":"title","v":{"s":"PDF/UA-1 (ISO 14289-1) conformance of the EXPORTED tagged PDF — the actual file you hand out. Shown beside the content score, never blended into it (a different artifact)."}},{"k":"validating","v":{"s":"Validating PDF/UA-1 (ISO 14289-1) with veraPDF…"}}],"id":223}},{"k":"plain","v":{"o":[{"k":"compare_aria","v":{"s":"Original and plain-language version, side by side"}},{"k":"compare_heading","v":{"s":"Original ↔ Plain language"}},{"k":"iframe","v":{"s":"Plain-language version"}},{"k":"pane_note","v":{"s":"Plain language — AI-simplified, original stays authoritative"}},{"k":"stale_title","v":{"s":"The document changed after this plain-language version was made — regenerate it to re-sync."}}],"id":224}},{"k":"reattach_digest_mismatch","v":{"s":"This PDF does not match the document used for this remediation. Select the original PDF to continue."}},{"k":"recovery_review","v":{"o":[{"k":"anchor_found","v":{"s":"Found the matching spot in the remediated document — insert the word there?"}},{"k":"anchor_missing","v":{"s":"No confident match in the remediated document (the surrounding text was rewritten). The word stays safely in the Content Recovery appendix."}},{"k":"aria","v":{"s":"Content recovery word review"}},{"k":"close","v":{"s":"Close"}},{"k":"close_aria","v":{"s":"Close review"}},{"k":"done","v":{"s":"Review complete:"}},{"k":"heading","v":{"s":"Word"}},{"k":"insert","v":{"s":"Insert at match"}},{"k":"inserted","v":{"s":"inserted in context"}},{"k":"kept","v":{"s":"kept in the appendix"}},{"k":"skip","v":{"s":"Keep in appendix"}},{"k":"source_ctx","v":{"s":"In the original document:"}},{"k":"start","v":{"s":"Review one by one"}},{"k":"start_title","v":{"s":"Step through each word the automatic restore could not confidently place — see its original context and decide where it belongs, one at a time (like a spell checker)."}}],"id":225}},{"k":"region","v":{"o":[{"k":"ambiguous","v":{"s":"That block looks identical to another one — I can’t tell them apart safely. Use the issue list or the Expert Workbench for a targeted fix."}},{"k":"apply_ai","v":{"s":"Apply with AI"}},{"k":"applying","v":{"s":"Applying…"}},{"k":"arm_off","v":{"s":"Select a region"}},{"k":"arm_on","v":{"s":"Drawing — drag a box"}},{"k":"arm_title","v":{"s":"Drag a box over the preview to pick a block, then describe a change the AI applies to ONLY that region (bounded — accept or revert)."}},{"k":"edit_html","v":{"s":"✏ Or edit the HTML yourself"}},{"k":"editor_aria","v":{"s":"Selected-region editor"}},{"k":"editor_close","v":{"s":"Clear region selection"}},{"k":"editor_heading","v":{"s":"Selected region"}},{"k":"empty","v":{"s":"No block was at least half inside that box — try a box that covers a paragraph or heading."}},{"k":"heading_no_h1","v":{"s":"⚠ Heading added, but this document has no H1. Mark the document title as the single top-level heading (H1) so the outline is complete."}},{"k":"heading_skip","v":{"s":"⚠ Heading added, but it skips a level (e.g. H2 → H4). Re-level it (or the surrounding headings) so the outline has no gaps."}},{"k":"honesty","v":{"s":"Bounded to this block only — the rest of the document is untouched. Re-checks after applying; one-click revert if you don’t like it."}},{"k":"intent_ph","v":{"s":"Describe the change for this block — e.g. “make this a bulleted list”, “turn this into a callout”, “simplify the wording”"}},{"k":"make_callout","v":{"s":"Make a callout"}},{"k":"make_callout_title","v":{"s":"Wrap this block as a callout. A fixed transform (the AI never rewrites your content); refused if it would move or drop a word, link, or image. The usual re-check still runs after."}},{"k":"make_heading","v":{"s":"Make a heading"}},{"k":"make_heading_title","v":{"s":"Promote this short title-like paragraph to a real heading at an outline-safe level (never skips a level, never an H1). A fixed transform — text unchanged. Re-level with Ctrl+2/3 in the preview if needed."}},{"k":"make_list","v":{"s":"Make a list"}},{"k":"make_list_title","v":{"s":"Turn line-broken or bulleted text into a real list. A fixed transform (no AI rewrite); refused if it would flatten a link/format or move content. The usual re-check still runs after."}},{"k":"no_preview","v":{"s":"Open the preview first, then drag a box over a block."}},{"k":"restyle_already","v":{"s":"This block is already a list."}},{"k":"restyle_already_callout","v":{"s":"This block is already a callout."}},{"k":"restyle_already_heading","v":{"s":"This block is already a heading."}},{"k":"restyle_cant","v":{"s":"Couldn’t restyle this block."}},{"k":"restyle_context","v":{"s":"Pick the whole list / parent block, not a single item (list item, table cell, or caption) — restyling it in place would break the structure."}},{"k":"restyle_inline","v":{"s":"Skipped — this text has links or formatting that a list would flatten. Add line breaks between items, or use “Apply with AI”."}},{"k":"restyle_label","v":{"s":"Quick restyle (no-AI edit):"}},{"k":"restyle_multiblock","v":{"s":"That selection holds several blocks — select a single paragraph to make a list, or use “Make a callout” to wrap them."}},{"k":"restyle_nolist","v":{"s":"Couldn’t find list items here — separate items with line breaks or bullets first."}},{"k":"restyle_norescore","v":{"s":"✨ Restyle applied. Couldn’t re-score automatically (the checker was busy) — the document is updated; re-run the audit when ready."}},{"k":"restyle_ro","v":{"s":"Skipped — that restyle would have changed the content or reading order (a link, image, or word would move/disappear), so it was refused for content safety."}},{"k":"restyle_toolong","v":{"s":"That block is too long to be a heading — headings should be short titles."}},{"k":"restyled","v":{"s":"✨ Restyled this block — re-checking…"}},{"k":"save_recheck","v":{"s":"Save (no-AI edit) & re-check"}},{"k":"selected","v":{"s":"▭ Region selected — describe the change, then Apply with AI (scoped to just this block)."}},{"k":"suggest_applied","v":{"s":"✨ Applied — re-checking…"}},{"k":"suggest_failed","v":{"s":"Couldn’t get suggestions right now (the AI may be busy) — try again later."}},{"k":"suggest_none","v":{"s":"No structure changes suggested — the document already reads cleanly."}},{"k":"suggest_stale","v":{"s":"That block changed since the suggestion was made — re-run “Suggest” to refresh."}},{"k":"suggest_unavailable","v":{"s":"Suggestion tools are still loading — try again in a moment."}},{"k":"suggesting","v":{"s":"✨ Looking for blocks that would read better as callouts or lists…"}},{"k":"too_small","v":{"s":"Draw a box over a paragraph or heading to select it."}},{"k":"unavailable","v":{"s":"Restyle tools are still loading — try again in a moment."}}],"id":226}},{"k":"review_queue","v":{"o":[{"k":"all_done","v":{"s":"All current review findings handled — new ones will appear here if a later pass surfaces any."}},{"k":"aria","v":{"s":"Findings that need human judgment"}},{"k":"as_of","v":{"s":"as of pass"}},{"k":"bucket_incomplete","v":{"s":"needs review"}},{"k":"bucket_manual","v":{"s":"manual check"}},{"k":"bucket_potential","v":{"s":"potential issue"}},{"k":"current","v":{"s":"current result"}},{"k":"done_aria","v":{"s":"Mark reviewed"}},{"k":"done_title","v":{"s":"Mark as reviewed — I checked this myself. Recorded in the audit report as a human attestation."}},{"k":"element","v":{"s":"element"}},{"k":"elements","v":{"s":"elements"}},{"k":"explainer","v":{"s":"The automated engines flagged these but cannot decide them — semantic meaning, context, and intent need a person. Work through them here while the automatic passes handle the mechanical fixes; findings a later pass resolves drop off on their own."}},{"k":"explainer_settled","v":{"s":"The automated engines flagged these but cannot decide them — semantic meaning, context, and intent need a person. Work through them with the Workbench, or mark each reviewed once you have checked it yourself."}},{"k":"heading","v":{"s":"Needs your judgment"}},{"k":"reset","v":{"s":"reset"}},{"k":"reset_title","v":{"s":"Bring back the findings you marked as reviewed — also clears the attestations recorded for the report"}},{"k":"reviewed","v":{"s":"reviewed"}},{"k":"wb_title","v":{"s":"Send to the Expert Workbench — prefills a targeted command you review and run"}}],"id":227}},{"k":"running","v":{"o":[{"k":"generic","v":{"s":"improving toward the target score"}},{"k":"human_edit","v":{"s":"edit of yours kept"}},{"k":"human_edits","v":{"s":"edits of yours kept"}},{"k":"human_edits_title","v":{"s":"Your edits were picked up mid-run. The loop rebased onto them and will not revert them when it ships."}},{"k":"lead","v":{"s":"STILL WORKING"}},{"k":"note","v":{"s":"Results below update live; keep this open."}},{"k":"stop","v":{"s":"Stop after this round"}}],"id":228}},{"k":"selfcheck","v":{"o":[{"k":"failed","v":{"s":"failed"}},{"k":"note","v":{"s":"AlloFlow's own PDF/UA-1 (ISO 14289-1) rules, re-parsed from the exported PDF bytes — a self-check, not certification. For an ISO verdict, validate in veraPDF or PAC 2024."}},{"k":"pass","v":{"s":"rules pass"}},{"k":"title","v":{"s":"PDF/UA-1 self-check (exported bytes)"}},{"k":"warn","v":{"s":"warn"}}],"id":229}},{"k":"smart_table","v":{"o":[{"k":"build","v":{"s":"Build table at cursor"}},{"k":"busy","v":{"s":"Structuring…"}},{"k":"close","v":{"s":"Close smart table builder"}},{"k":"data_ph","v":{"s":"Paste your data — anything works: rows copied from email, lesson notes, CSV, a messy list…"}},{"k":"heading","v":{"s":"Smart table — paste data, get an accessible table"}},{"k":"honesty","v":{"s":"Clean rows parse instantly with no AI. Messy data goes to AI with one hard rule: only YOUR values, never invented — blanks stay blank. Review the result; every cell stays editable."}},{"k":"region","v":{"s":"Smart table builder"}},{"k":"spec_ph","v":{"s":"Optional: what should it look like? e.g. “columns: word, definition, example — one row per word”"}}],"id":230}},{"k":"start_new_running_title","v":{"s":"Remediation is still running — clearing now would lose this run."}},{"k":"start_new_title_short","v":{"s":"Start a new audit?"}},{"k":"stop_running","v":{"s":"Stop (still working…)"}},{"k":"stop_then_new_title","v":{"s":"Remediation is still improving the document. Stop it (keeps what’s done) — then this becomes “Start New Audit”."}},{"k":"taginspect","v":{"o":[{"k":"decorative_title","v":{"s":"Mark this image as decorative (artifact — screen readers skip it) / restore as content"}},{"k":"desync","v":{"s":"The preview changed since this tag list was built — the list was refreshed. Please re-apply your edit."}},{"k":"move_down_title","v":{"s":"Move later in the reading order"}},{"k":"move_up_title","v":{"s":"Move earlier in the reading order"}},{"k":"retag_title","v":{"s":"Re-tag this block — change its role (e.g. a paragraph that should be a heading)"}},{"k":"table_colhead_title","v":{"s":"Make the first COLUMN header cells (th, scope=row) — so rows are announced"}},{"k":"table_rowhead_title","v":{"s":"Make the first ROW header cells (th, scope=col) — so columns are announced"}}],"id":231}},{"k":"tour","v":{"o":[{"k":"results_cta","v":{"s":"Tour"}},{"k":"results_title","v":{"s":"A 60-second guided walk through this screen — what to download, what the score means, where the reports live."}}],"id":232}},{"k":"verapdf","v":{"o":[{"k":"auto_toggle","v":{"s":"Auto-validate with veraPDF after every Make Accessible (recommended)"}},{"k":"auto_toggle_aria","v":{"s":"Auto-validate with veraPDF after Make Accessible"}},{"k":"auto_toggle_title","v":{"s":"When on, AlloFlow opens + warms the veraPDF validator during Make Accessible and validates the tagged output automatically — no extra click. Turn off to validate only on demand."}},{"k":"autofix","v":{"s":"Auto-fix remaining issues (veraPDF closed loop)"}},{"k":"btn","v":{"s":"Independently validate with veraPDF (ISO 14289-1)"}},{"k":"disclaimer","v":{"s":"Independent open-source validation — not a legal accessibility certificate; human review still recommended."}},{"k":"failed","v":{"s":"rule(s) failed (veraPDF)"}},{"k":"fallback","v":{"s":"rely on the self-check above and verify in PAC 2024."}},{"k":"fix_failed","v":{"s":"veraPDF auto-fix failed"}},{"k":"fix_review","v":{"s":"Auto-fix made changes to review before distribution"}},{"k":"fixed_partial","v":{"s":"Applied veraPDF auto-fixes (some rules need richer repair) — downloaded the improved file."}},{"k":"fixed_pass","v":{"s":"Auto-fixed to PDF/UA-1 — downloaded the independently-validated file."}},{"k":"fixing","v":{"s":"Auto-fixing to PDF/UA-1 (validate → repair → re-validate)…"}},{"k":"pass","v":{"s":"Passes PDF/UA-1 (independently validated by veraPDF)"}},{"k":"running","v":{"s":"Validating with veraPDF… (first run downloads ~25 MB, ~15s)"}},{"k":"unavailable","v":{"s":"veraPDF validation unavailable"}}],"id":233}},{"k":"verdict","v":{"o":[{"k":"more","v":{"s":"more — see the panels below"}}],"id":234}},{"k":"watch_live","v":{"o":[{"k":"cta","v":{"s":"Watch live"}},{"k":"hide","v":{"s":"Hide"}},{"k":"iframe","v":{"s":"Live remediated document (read-only)"}},{"k":"note","v":{"s":"Showing the last committed version — section-by-section changes stream in the panel above. To intervene, use a section’s Reject button or the Expert Workbench; the loop adopts your change at its next pass."}},{"k":"on","v":{"s":"Watching"}},{"k":"title","v":{"s":"Live document — read-only; repaints each time a round commits"}},{"k":"toggle_title","v":{"s":"Watch the document itself update as each round commits — read-only, so nothing you do here can collide with the run"}}],"id":235}},{"k":"whatnow","v":{"o":[{"k":"fidelity","v":{"s":"⚠ Before sharing: some source content may not have carried over (see the fidelity notes below). 1️⃣ Open Compare/Diff and confirm scores, numbers, dates, and key text match the original. 2️⃣ Only then grab the "}},{"k":"go","v":{"s":"Take me to Downloads"}},{"k":"lead","v":{"s":"What now?"}},{"k":"materials","v":{"s":"Make learning materials"}},{"k":"materials_running_title","v":{"s":"Remediation is still running — closing now would interrupt it. Click “Stop after this round” first."}},{"k":"materials_title","v":{"s":"Open the content tools with this document as the source — glossary, quiz, leveled text, lesson plan, games: everything generates from the same accessible text."}},{"k":"office","v":{"s":"1️⃣ Scroll to Downloads and grab the Word file — that’s your share-ready copy. 2️⃣ Optional: open Compare to see before/after. 3️⃣ Anything flagged below is optional polish."}},{"k":"pdf","v":{"s":"1️⃣ Scroll to Downloads and grab the Tagged PDF — that’s your share-ready copy. 2️⃣ Optional: open Compare to see before/after. 3️⃣ Anything flagged below is optional polish."}}],"id":236}},{"k":"youtube","v":{"o":[{"k":"file_label","v":{"s":"YouTube transcript"}}],"id":237}},{"k":"storm_budget_paused_toast","v":{"s":"AI remediation paused: this run reached its rate-limit waiting budget. Your last verified version is preserved; choose Resume AI remediation to continue with a fresh budget, or raise the budget in Pipeline Settings."}},{"k":"storm_budget_paused_body","v":{"s":"This run reached its rate-limit waiting budget (Pipeline Settings). Deterministic fixes and the audit were kept and your last verified version was preserved; resuming continues with a fresh budget."}},{"k":"storm_wait_round","v":{"s":"Canvas is rate-limiting — pausing before round {round}/{max} so calls are not wasted (rechecking in ~{s}s; your checkpoint will remain resumable)"}}],"id":144}},{"k":"concept_sort","v":{"o":[{"k":"explanation_unavailable","v":{"s":"Couldn't generate an explanation right now. Try again in a moment."}},{"k":"title","v":{"s":"Concept Sort"}},{"k":"subtitle","v":{"s":"Drag cards into the correct category."}},{"k":"instructions","v":{"s":"Drag items to the correct section."}},{"k":"categories","v":{"s":"Categories"}},{"k":"max_categories","v":{"s":"(Max 5)"}},{"k":"placeholder_categories","v":{"s":"e.g. Biotic, Abiotic"}},{"k":"items","v":{"s":"Number of Items to Sort"}},{"k":"generate","v":{"s":"Generate Activity"}},{"k":"start","v":{"s":"Start Activity"}},{"k":"preview","v"