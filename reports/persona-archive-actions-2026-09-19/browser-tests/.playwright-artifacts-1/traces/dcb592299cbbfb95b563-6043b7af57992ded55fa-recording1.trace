h_wire","v":{"s":"Wireframe"}}],"id":537}},{"k":"graphcalc","v":{"o":[{"k":"str","v":{"s":"( )"}},{"k":"entering_functions","v":{"s":"Entering Functions"}},{"k":"type_y_mx_b_where_m_is_the_slope_and_b","v":{"s":"Type y = mx + b where m is the slope and b is the y-intercept. Try: 2x + 3"}},{"k":"zoom_window","v":{"s":"Zoom & Window"}},{"k":"use_zoom_presets_to_change_how_much_of","v":{"s":"Use zoom presets to change how much of the graph you see."}},{"k":"reading_the_table","v":{"s":"Reading the Table"}},{"k":"the_table_shows_exact_y_values_for_eac","v":{"s":"The table shows exact y-values for each x."}},{"k":"multiple_functions","v":{"s":"Multiple Functions"}},{"k":"enter_different_equations_to_compare_t","v":{"s":"Enter different equations to compare them. Where lines cross is an intersection!"}},{"k":"linear_vs_quadratic","v":{"s":"Linear vs Quadratic"}},{"k":"y_2x_1_is_a_line_y_x_2_is_a_parabola_t","v":{"s":"y = 2x + 1 is a line. y = x^2 is a parabola. The exponent determines the shape!"}},{"k":"finding_zeros","v":{"s":"Finding Zeros"}},{"k":"where_the_graph_crosses_the_x_axis_y_0","v":{"s":"Where the graph crosses the x-axis, y = 0. These are zeros or x-intercepts."}},{"k":"transformations","v":{"s":"Transformations"}},{"k":"y_x_3_2_shifts_right_by_3_y_x_2_5_shif","v":{"s":"y = (x-3)^2 shifts right by 3. y = x^2 + 5 shifts up by 5."}},{"k":"trig_functions","v":{"s":"Trig Functions"}},{"k":"sin_x_cos_x_tan_x_create_waves_period_","v":{"s":"sin(x), cos(x), tan(x) create waves. Period of sin(x) is 2π."}},{"k":"logarithms","v":{"s":"Logarithms"}},{"k":"log_x_is_the_inverse_of_10_x_ln_x_is_t","v":{"s":"log(x) is the inverse of 10^x. ln(x) is the natural log."}},{"k":"asymptotes","v":{"s":"Asymptotes"}},{"k":"y_1_x_approaches_x_0_and_y_0_but_never","v":{"s":"y = 1/x approaches x=0 and y=0 but never touches them."}},{"k":"standard","v":{"s":"Standard"}},{"k":"trig","v":{"s":"Trig"}},{"k":"quadratic","v":{"s":"Quadratic"}},{"k":"wide","v":{"s":"Wide"}},{"k":"positive","v":{"s":"Positive"}},{"k":"graph_y_3x_2_what_is_the_y_intercept","v":{"s":"Graph y = 3x - 2. What is the y-intercept?"}},{"k":"the_y_intercept_is_where_the_line_cros","v":{"s":"The y-intercept is where the line crosses the y-axis (x=0)."}},{"k":"graph_y_x_5_and_y_x_1_where_do_they_in","v":{"s":"Graph y = -x + 5 and y = x - 1. Where do they intersect?"}},{"k":"the_intersection_is_where_both_equatio","v":{"s":"The intersection is where both equations give the same y for the same x."}},{"k":"enter_y_x_2_look_at_the_table_what_pat","v":{"s":"Enter y = x^2. Look at the table. What pattern do you see?"}},{"k":"the_differences_between_consecutive_y_","v":{"s":"The differences between consecutive y-values increase by 2 each time!"}},{"k":"graph_y_x_2_4_where_are_the_zeros","v":{"s":"Graph y = x^2 - 4. Where are the zeros?"}},{"k":"set_y_0_x_2_4_so_x_2","v":{"s":"Set y = 0: x^2 = 4, so x = +/-2."}},{"k":"graph_y_x_2_y_x_3_2_y_x_2_2_what_chang","v":{"s":"Graph y = x^2, y = (x-3)^2, y = (x+2)^2. What changes?"}},{"k":"x_h_shifts_right_by_h_x_h_shifts_left","v":{"s":"(x-h) shifts RIGHT by h. (x+h) shifts LEFT."}},{"k":"graph_y_0_5x_y_x_y_2x_y_5x_what_happen","v":{"s":"Graph y = 0.5x, y = x, y = 2x, y = 5x. What happens?"}},{"k":"bigger_slope_steeper_line","v":{"s":"Bigger slope = steeper line."}},{"k":"graph_sin_x_and_cos_x_with_trig_preset","v":{"s":"Graph sin(x) and cos(x) with Trig preset. How are they related?"}},{"k":"cos_x_is_sin_x_shifted_left_by_pi_2","v":{"s":"cos(x) is sin(x) shifted left by pi/2."}},{"k":"graph_y_2_x_and_y_log_x_log_2_what_do_","v":{"s":"Graph y = 2^x and y = log(x)/log(2). What do you notice?"}},{"k":"inverse_functions_are_mirrors_across_y","v":{"s":"Inverse functions are mirrors across y = x."}},{"k":"graph_y_1_x_what_happens_near_x_0","v":{"s":"Graph y = 1/x. What happens near x = 0?"}},{"k":"the_graph_approaches_but_never_touches","v":{"s":"The graph approaches but never touches the axes."}},{"k":"explorer","v":{"s":"Explorer"}},{"k":"linear_func