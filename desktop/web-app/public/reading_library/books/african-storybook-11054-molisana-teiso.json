    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/11046.png",
      "text": "Tahlo ke abuti oa Teiso. A botsa Seoa, \"Tonki e kea?\" Teiso a araba, \"Eka sakeng.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=1",
      "sourceDigest": "sha256:3b9145881f84933db06649958d8de5a8973d361b5d2576077125048c4dca7583"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/11047.png",
      "text": "Tahlo a re, \"Teiso bulela tonki.\" Teiso a re, \"Haeka sakeng. E mabeleng a batho.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=2",
      "sourceDigest": "sha256:4faf35192699d41e491262c172bf183d35cae1f6eef0d9e764b1177e718a3e48"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/11048.png",
      "text": "Tahlo a omana ka bohale a re, \"Ooo! E mabeleng? Tsamaea o lolata tonki.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=3",
      "sourceDigest": "sha256:29f351b8787e4029117198d854dbca7335ca6ecbe58402db81f04a1dca078ef9"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/11049.png",
      "text": "Teiso a re, \"Eka pitseng.\" Eaba Teiso oea ka tlung. A koaolla pitsa. A fumana katse e robetse.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=4",
      "sourceDigest": "sha256:83d04e2dfc1a70832675aadc72f95df89d3ebb6bce151bf30ab45b627d834283"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/11050.png",
      "text": "Eaba Teiso oea ts'oha. Atsoa ka tlung a baleha. Empa katse ea molelekisa eaba ea mots'oara.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=5",
      "sourceDigest": "sha256:b1025db04a20443ddd5b4f3aac630c1357cd43ff2d55ef3c0783a738e4d7f669"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/11051.png",
      "text": "Ea moqhomela ka mahetleng a hae. Ea mometa eare, \"O mosali oaka. Seka touta!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=6",
      "sourceDigest": "sha256:e33bcc30834ba557cfa5859f007a2629653bd604f4c5c97c9c4566cd23729b87"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/11052.png",
      "text": "Leho fihlela tsatsing lena Teiso le katse balula 'moho. Pale ea rona e fella mona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=11054#page=7",
      "sourceDigest": "sha256:53ef447e03b9703b7f85ad5df925d619fa2974d5f9beda1de2581b1fdc32a377"
    }
  ],
