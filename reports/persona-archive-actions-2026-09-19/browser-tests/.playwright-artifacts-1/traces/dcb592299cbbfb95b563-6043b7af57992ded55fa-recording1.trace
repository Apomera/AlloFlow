lness","v":{"s":"AlloFlow has been helpful for my child's learning"}},{"k":"tam_parent_intention","v":{"s":"I would recommend AlloFlow to other parents"}}],"id":442}},{"k":"rti","v":{"o":[{"k":"progress_monitor","v":{"s":"RTI Progress Monitor"}},{"k":"baseline","v":{"s":"Baseline"}},{"k":"target_wcpm","v":{"s":"Target WCPM"}},{"k":"target_date","v":{"s":"Target Date"}},{"k":"trend_line_comparison","v":{"s":"Trend Line Comparison"}},{"k":"ncii_recommended","v":{"s":"NCII recommended"}},{"k":"frequency","v":{"s":"Frequency"}},{"k":"weekly","v":{"s":"Weekly"}},{"k":"group_size","v":{"s":"Group Size"}},{"k":"start_date","v":{"s":"Start Date"}},{"k":"download_report_title","v":{"s":"Download a growth-focused report suitable for sharing with the family"}},{"k":"four_point_analysis","v":{"s":"Four-Point Analysis"}},{"k":"median_of_last_3","v":{"s":"Median of Last 3"}}],"id":443}},{"k":"probes","v":{"o":[{"k":"benchmark_battery","v":{"s":"Benchmark Probe Battery"}},{"k":"standardized","v":{"s":"Standardized"}},{"k":"grade_k","v":{"s":"Grade K"}},{"k":"math_fluency","v":{"s":"Math Fluency Probe"}},{"k":"literacy_fluency","v":{"s":"Literacy Fluency Probes"}},{"k":"nwf","v":{"s":"Nonsense Word Fluency"}},{"k":"lnf","v":{"s":"Letter Naming Fluency"}},{"k":"ran","v":{"s":"Rapid Automatized Naming"}},{"k":"decodable_orf","v":{"s":"Timed passage from your Word Sounds pack"}},{"k":"missing_number","v":{"s":"Missing Number Probe"}},{"k":"correct","v":{"s":"Correct"}},{"k":"attempted","v":{"s":"Attempted"}},{"k":"accuracy","v":{"s":"Accuracy"}},{"k":"qd","v":{"s":"Quantity Discrimination Probe"}},{"k":"probe_results","v":{"s":"Probe Results"}},{"k":"target_wcpm","v":{"s":"Target WCPM"}},{"k":"target_date","v":{"s":"Target Date"}},{"k":"group_size","v":{"s":"Group Size"}},{"k":"start_date","v":{"s":"Start Date"}}],"id":444}},{"k":"learner","v":{"o":[{"k":"total_xp","v":{"s":"Total XP"}},{"k":"current_run","v":{"s":"Current Run"}},{"k":"daily_streak","v":{"s":"Daily Streak"}},{"k":"ws_accuracy","v":{"s":"Word Sounds Accuracy"}},{"k":"ws_first_try_accuracy","v":{"s":"Right First Try"}},{"k":"ws_practice_only_note","v":{"s":"Practice activities that never mark an answer wrong are not counted here."}},{"k":"coming_up","v":{"s":"Coming Up"}},{"k":"xp_earned","v":{"s":"XP Earned"}},{"k":"words_today","v":{"s":"Words Today"}},{"k":"xp_this_week","v":{"s":"XP This Week"}},{"k":"activities_week","v":{"s":"Activities"}},{"k":"words_this_week","v":{"s":"Words This Week"}},{"k":"words_correct","v":{"s":"Words Correct"}},{"k":"phonemes_touched","v":{"s":"Phonemes Touched"}},{"k":"sessions","v":{"s":"Sessions"}},{"k":"label_challenges","v":{"s":"Label Challenges"}},{"k":"recent_activity","v":{"s":"Recent Activity"}},{"k":"progress_report","v":{"s":"Learning Progress Report"}},{"k":"my_learning_journey","v":{"s":"My Learning Journey"}},{"k":"sessions_tracked","v":{"s":"sessions tracked"}},{"k":"level","v":{"s":"Level"}},{"k":"activities","v":{"s":"Activities"}},{"k":"quiz_avg","v":{"s":"Quiz Avg"}},{"k":"word_accuracy","v":{"s":"Word Accuracy"}},{"k":"my_badges","v":{"s":"My Badges"}},{"k":"my_strengths","v":{"s":"My Strengths"}},{"k":"my_growth_journey","v":{"s":"My Growth Journey"}},{"k":"session_history","v":{"s":"Session History"}},{"k":"word_sounds","v":{"s":"Word Sounds"}},{"k":"download_progress_report","v":{"s":"Download My Progress Report"}},{"k":"report_downloaded","v":{"s":"Your progress report has been downloaded!"}},{"k":"leave_empty_all_sessions","v":{"s":"Leave empty to include all sessions"}}],"id":445}},{"k":"research","v":{"o":[{"k":"construct","v":{"s":"Construct"}},{"k":"perceived_usefulness","v":{"s":"Perceived Usefulness"}},{"k":"perceived_ease","v":{"s":"Perceived Ease of Use"}},{"k":"behavioral_intention","v":{"s":"Behavioral Intention"}},{"k":"measure","v":{"s":"Measure"}},{"k":"metric","v":{"s":"Metric"}},{"k":"total_students","v":{"s":"Total Students"}},{"k":"total_sessions","v":{"s":"Total Sessions"}},{"k":"avg_sessions","v":{"s":"Avg Sessions Per Student"}},{"k":"fidelity_records","v":{"s":"Fidelity Records"}},{"k":"total_probes","v":{"s":"Total Probes Administered"}},{"k":"sessions_completed","v":{"s":"Sessions Completed"}},{"k":"quiz_responses","v":{"s":"Quiz Responses"}},{"k":"probes_administered","v":{"s":"Probes Administered"}},{"k":"survey_responses","v":{"s":"Survey Responses"}},{"k":"explore_challenges","v":{"s":"Explore Challenges"}},{"k":"intervention_logs","v":{"s":"Intervention Logs"}},{"k":"recent_probe_results","v":{"s":"Recent Probe Results"}},{"k":"external_cbm_scores","v":{"s":"External CBM Scores"}},{"k":"export_apa_title","v":{"s":"Export Research Report (APA-formatted)"}},{"k":"scale","v":{"s":"Scale"}},{"k":"value","v":{"s":"Value"}}],"id":446}},{"k":"stem","v":{"o":[{"k":"scaleExplorer","v":{"o":[{"k":"back_to_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"blurb","v":{"s":"Every step across the screen is one power of ten, so the same distance always means the same ratio. Zoom out far enough and the Earth is a dot; zoom in far enough and an atom fills the view."}},{"k":"canvas_aria","v":{"s":"Scale view. Left and right arrows zoom by a quarter of a power of ten, hold shift for a whole one, Page Up and Page Down jump three, Home returns to human scale, space plays or pauses the zoom."}},{"k":"cmp_a","v":{"s":"First thing"}},{"k":"cmp_b","v":{"s":"Second thing"}},{"k":"cmp_from_focus","v":{"s":"Compare this"}},{"k":"cmp_from_focus_aria","v":{"s":"Compare {name} with something else"}},{"k":"cmp_from_focus_sr","v":{"s":"{name} is now the first thing to compare. Choose the second."}},{"k":"cmp_go","v":{"s":"Compare them"}},{"k":"cmp_heading","v":{"s":"Compare two sizes"}},{"k":"cmp_line","v":{"s":"{big} is about {times} bigger across than {small}. That is {dec} powers of ten."}},{"k":"cmp_same","v":{"s":"{a} and {b} are about the same size."}},{"k":"copy_link","v":{"s":"Copy link to this view"}},{"k":"copy_link_aria","v":{"s":"Copy a link that opens Scale Explorer at {name}"}},{"k":"copy_link_title","v":{"s":"Copy a link that opens Scale Explorer here"}},{"k":"credit","v":{"s":"Sizes are the characteristic width, length or height of each thing, in metres. Where a size is genuinely uncertain or depends on where you decide something stops, the tool says so rather than pretending otherwise."}},{"k":"decade_sr","v":{"s":"Now at ten to the power {n}, about {len}."}},{"k":"decade_sr_near","v":{"s":"Now at about {len}."}},{"k":"dim_across","v":{"s":"across"}},{"k":"dim_distance","v":{"s":"distance"}},{"k":"dim_long","v":{"s":"long"}},{"k":"dim_tall","v":{"s":"tall"}},{"k":"dim_wide_at_the_base","v":{"s":"wide at the base"}},{"k":"edge_big","v":{"s":"You have zoomed out past everything. {name} is the largest thing here, because it is the largest thing anyone can see."}},{"k":"edge_small","v":{"s":"You have zoomed in past everything. Below about the size of {name}, asking how wide something is stops having a clear answer."}},{"k":"est_close","v":{"s":"Close — within a power of ten or so."}},{"k":"est_go","v":{"s":"Lock in my estimate"}},{"k":"est_heading","v":{"s":"Estimate first"}},{"k":"est_label","v":{"s":"Your estimate, in powers of ten"}},{"k":"est_new","v":{"s":"Another pair"}},{"k":"est_off","v":{"s":"Not yet. You were {off} powers of ten out, which is a factor of {factor}."}},{"k":"est_question","v":{"s":"How many powers of ten bigger across is {big} than {small}?"}},{"k":"est_reveal","v":{"s":"The gap is {dec} powers of ten: {big} is about {times} bigger across than {small}."}},{"k":"est_show","v":{"s":"Show me"}},{"k":"est_spot","v":{"s":"Spot on."}},{"k":"film_fast","v":{"s":"Fast"}},{"k":"film_group","v":{"s":"Play the zoom"}},{"k":"film_in","v":{"s":"▶ Play the zoom in to the proton"}},{"k":"film_normal","v":{"s":"Normal"}},{"k":"film_out","v":{"s":"▶ Play the zoom out to the universe"}},{"k":"film_pause","v":{"s":"⏸ Pause"}},{"k":"film_paused","v":{"s":"Paused. Press play to continue."}},{"k":"film_reduced","v":{"s":"Reduced motion is on, so this plays one power of ten at a time."}},{"k":"film_slow","v":{"s":"Slow"}},{"k":"film_speed","v":{"s":"Speed"}},{"k":"film_speed_aria","v":{"s":"Film speed, in powers of ten per second"}},{"k":"film_start_in","v":{"s":"Playing the zoom inward. Press space to pause."}},{"k":"film_start_out","v":{"s":"Playing the zoom outward. Press space to pause."}},{"k":"fit_line","v":{"s":"About {n} of {small} fit side by side across {big}."}},{"k":"fit_line_close","v":{"s":"{big} is only {n} times as wide as {small}: nearly the same size."}},{"k":"focus_heading","v":{"s":"In focus"}},{"k":"fullscreen","v":{"s":"⛶ Fullscreen"}},{"k":"in_one","v":{"s":"Zoom in one power of ten"}},{"k":"item_alpha_cen_dist_describe","v":{"s":"How far it is to Alpha Centauri, the closest star system to the Sun. Again a gap, not a size."}},{"k":"item_alpha_cen_dist_name","v":{"s":"Distance to the nearest star system"}},{"k":"item_andromeda_dist_describe","v":{"s":"How far away the nearest large galaxy is. This is a gap between things, not the size of a thing."}},{"k":"item_andromeda_dist_name","v":{"s":"Distance to the Andromeda Galaxy"}},{"k":"item_au_describe","v":{"s":"One astronomical unit, the standard yardstick for distances inside the Solar System."}},{"k":"item_au_name","v":{"s":"Distance from the Earth to the Sun"}},{"k":"item_basketball_describe","v":{"s":"A regulation basketball, about a seventh of a person's height. It is a useful rung on this ladder because almost everyone has held one and knows how big it feels."}},{"k":"item_basketball_name","v":{"s":"A basketball"}},{"k":"item_betelgeuse_describe","v":{"s":"A red supergiant in Orion. If it replaced the Sun, it would swallow the orbits of the inner planets."}},{"k":"item_betelgeuse_name","v":{"s":"The star Betelgeuse"}},{"k":"item_betelgeuse_note","v":{"s":"Genuinely uncertain: published radii run from about 640 to about 887 times the Sun's. Even famous stars are hard to measure."}},{"k":"item_blue_whale_describe","v":{"s":"The largest animal known to have lived, larger than any dinosaur yet found. Its heart alone is roughly the size of a small car, and it feeds on some of the smallest animals in the sea."}},{"k":"item_blue_whale_name","v":{"s":"A blue whale"}},{"k":"item_blue_whale_note","v":{"s":"Adults commonly reach 24 to 30 metres, so this is a typical length rather than a maximum."}},{"k":"item_carbon_describe","v":{"s":"The atom that life is built around, because it bonds readily in four directions at once."}},{"k":"item_carbon_name","v":{"s":"A carbon atom"}},{"k":"item_carbon_note","v":{"s":"An atom has no hard edge. This is twice the accepted atomic radius, which is itself a convention."}},{"k":"item_chicxulub_describe","v":{"s":"The buried scar of the asteroid impact that coincides with the extinction of the non-bird dinosaurs, most of it now under the sea off the Yucatan coast. It is invisible from the ground and was found from small variations in gravity."}},{"k":"item_chicxulub_name","v":{"s":"The Chicxulub crater"}},{"k":"item_coma_dist_describe","v":{"s":"How far away a dense swarm of more than a thousand galaxies lies, in the direction of the constellation Coma Berenices. It was here, in 1933, that galaxies were first seen moving too fast for their visible mass, the earliest evidence for dark matter."}},{"k":"item_coma_dist_name","v":{"s":"Distance to the Coma Cluster"}},{"k":"item_coma_dist_note","v":{"s":"About 320 million light years; distances on this scale carry an uncertainty of a few percent depending on the method."}},{"k":"item_dna_describe","v":{"s":"The thickness of the twisted ladder that stores genetic information. Its length is another matter entirely: about two metres of it is coiled inside almost every one of your cells."}},{"k":"item_dna_name","v":{"s":"The width of a DNA double helix"}},{"k":"item_door_describe","v":{"s":"A standard interior door, a handy everyday ruler you walk through several times a day."}},{"k":"item_door_name","v":{"s":"A doorway"}},{"k":"item_dust_mite_describe","v":{"s":"A tiny relative of spiders that lives in bedding and carpets and eats flakes of shed skin."}},{"k":"item_dust_mite_name","v":{"s":"A dust mite"}},{"k":"item_earth_describe","v":{"s":"Our planet, measured through the equator. It is very slightly wider than it is tall."}},{"k":"item_earth_name","v":{"s":"The Earth"}},{"k":"item_ecoli_describe","v":{"s":"A rod-shaped bacterium that lives in the gut, and one of the most studied living things on Earth. Under good conditions it can divide about every twenty minutes."}},{"k":"item_ecoli_name","v":{"s":"An E. coli bacterium"}},{"k":"item_egg_describe","v":{"s":"A hen's egg: a single very large cell surrounded by its food store and a shell of calcium carbonate. It is by far the biggest single cell most people ever handle."}},{"k":"item_egg_name","v":{"s":"A chicken egg"}},{"k":"item_eiffel_describe","v":{"s":"An iron lattice tower in Paris, for forty years the tallest structure people had built."}},{"k":"item_eiffel_name","v":{"s":"The Eiffel Tower"}},{"k":"item_elephant_describe","v":{"s":"The largest living land animal, measured at the shoulder. Its ears are laced with blood vessels and work as radiators, shedding heat into the air."}},{"k":"item_elephant_name","v":{"s":"An African elephant"}},{"k":"item_everest_describe","v":{"s":"The highest point on Earth above sea level, measured from sea level to the summit."}},{"k":"item_everest_name","v":{"s":"Mount Everest"}},{"k":"item_flea_describe","v":{"s":"A wingless insect that jumps many times its own body length using a spring of stored elastic protein."}},{"k":"item_flea_name","v":{"s":"A flea"}},{"k":"item_football_pitch_describe","v":{"s":"A standard association football field, useful because so many people can picture one."}},{"k":"item_football_pitch_name","v":{"s":"A football pitch"}},{"k":"item_galactic_centre_describe","v":{"s":"How far the Sun sits from the crowded middle of our own galaxy, where a supermassive black hole lies. This is a distance, not the size of a thing."}},{"k":"item_galactic_centre_name","v":{"s":"Distance to the centre of the Milky Way"}},{"k":"item_galactic_centre_note","v":{"s":"About 26,000 light years. Measuring it is hard because dust blocks the view straight toward the centre."}},{"k":"item_gamma_describe","v":{"s":"One wave of the most energetic light there is, given off by radioactive decay and by violent events in space. The shorter the wave, the more energy each packet of light carries."}},{"k":"item_gamma_name","v":{"s":"A gamma-ray wavelength"}},{"k":"item_gamma_note","v":{"s":"Gamma rays have no single wavelength; they are defined by being shorter than about ten picometres, so this is one point on an open-ended range."}},{"k":"item_giraffe_describe","v":{"s":"The tallest living land animal. Its neck has the same number of bones as yours: seven."}},{"k":"item_giraffe_name","v":{"s":"A giraffe"}},{"k":"item_grand_canyon_describe","v":{"s":"A gorge cut by a river through rock layers that record roughly two billion years of Earth history."}},{"k":"item_grand_canyon_name","v":{"s":"The Grand Canyon"}},{"k":"item_hair_describe","v":{"s":"The thickness of a single strand of hair, the classic everyday reference for \"very thin\". It sits right at the edge of what an unaided eye can pick out."}},{"k":"item_hair_name","v":{"s":"The width of a human hair"}},{"k":"item_hair_note","v":{"s":"Hair varies a great deal, from about 17 to 180 micrometres. This is a middling strand."}},{"k":"item_heliosphere_describe","v":{"s":"The bubble the Sun blows in the gas between the stars with its outgoing wind of particles. Crossing its edge is the closest thing there is to leaving the Sun behind."}},{"k":"item_heliosphere_name","v":{"s":"The heliosphere"}},{"k":"item_heliosphere_note","v":{"s":"Voyager 1 crossed the edge in 2012 at 121.6 times the Earth-Sun distance, and Voyager 2 in 2018 at about 119, in a different direction."}},{"k":"item_honeybee_describe","v":{"s":"A worker honeybee. It navigates by the position of the sun and by the pattern of polarised light in the sky, which it can see and we cannot."}},{"k":"item_honeybee_name","v":{"s":"A honeybee"}},{"k":"item_human_describe","v":{"s":"An adult human of roughly average height. This is the scale everything else here is easiest to feel from."}},{"k":"item_human_name","v":{"s":"A person"}},{"k":"item_hydrogen_describe","v":{"s":"The simplest and most common atom in the universe: one proton with one electron around it."}},{"k":"item_hydrogen_name","v":{"s":"A hydrogen atom"}},{"k":"item_jupiter_describe","v":{"s":"The largest planet in the Solar System, a ball of gas with no solid surface to stand on."}},{"k":"item_jupiter_name","v":{"s":"Jupiter"}},{"k":"item_ladybird_describe","v":{"s":"A small beetle whose bright spotted pattern warns predators that it tastes unpleasant. Its hard outer wing cases fold down over the flying wings underneath."}},{"k":"item_ladybird_name","v":{"s":"A ladybird beetle"}},{"k":"item_laniakea_describe","v":{"s":"The sheet of about a hundred thousand galaxies our own galaxy drifts within, all of them streaming toward a common region."}},{"k":"item_laniakea_name","v":{"s":"The Laniakea Supercluster"}},{"k":"item_laniakea_note","v":{"s":"About 520 million light years across, from the 2014 survey that first defined it."}},{"k":"item_liberty_describe","v":{"s":"A copper statue on an island in New York harbour, measured from the base of the pedestal to the tip of the torch. The copper skin is only about two millimetres thick."}},{"k":"item_liberty_name","v":{"s":"The Statue of Liberty"}},{"k":"item_light_describe","v":{"s":"One full wave of the light your eye is most sensitive to. Nothing smaller than about this can be resolved with an ordinary light microscope."}},{"k":"item_light_minute_describe","v":{"s":"How far light travels in one minute: about 18 million kilometres, or nearly fifty times the distance to the Moon. Sunlight is a little over eight of these old when it reaches you."}},{"k":"item_light_minute_name","v":{"s":"One light minute"}},{"k":"item_light_month_describe","v":{"s":"How far light travels in thirty days. No spacecraft has gone this far: Voyager 1, the most distant, is under one light day out after nearly fifty years of flight."}},{"k":"item_light_month_name","v":{"s":"One light month"}},{"k":"item_light_name","v":{"s":"A wavelength of green light"}},{"k":"item_light_note","v":{"s":"Visible light runs from roughly 380 nanometres (violet) to 700 (red). This is the green middle."}},{"k":"item_lightyear_describe","v":{"s":"How far light travels in a year, and the ruler astronomers reach for once kilometres stop being useful. Light crosses this whole distance in the time Earth takes to go once around the Sun."}},{"k":"item_lightyear_name","v":{"s":"One light year"}},{"k":"item_local_bubble_describe","v":{"s":"A cavity in the gas between the stars, blown clear by supernovae over the last ten to twenty million years, with our Solar System drifting through the middle of it."}},{"k":"item_local_bubble_name","v":{"s":"The Local Bubble"}},{"k":"item_local_bubble_note","v":{"s":"Roughly a thousand light years across, though it is lopsided rather than round and older estimates were much smaller."}},{"k":"item_milkyway_describe","v":{"s":"Our own galaxy: a flat spiral of a few hundred billion stars, with our Sun about halfway out from the centre."}},{"k":"item_milkyway_name","v":{"s":"The Milky Way galaxy"}},{"k":"item_milkyway_note","v":{"s":"Roughly 100,000 light years across. The edge is fuzzy, so the number depends on where you decide the galaxy stops."}},{"k":"item_mitochondrion_describe","v":{"s":"The part of your cells that releases usable energy. It carries its own separate DNA, a clue that it was once a free-living bacterium."}},{"k":"item_mitochondrion_name","v":{"s":"A mitochondrion"}},{"k":"item_moon_describe","v":{"s":"Earth's only natural satellite, a little over a quarter of Earth's width. It is large enough, relative to its planet, that some astronomers call the pair a double system."}},{"k":"item_moon_name","v":{"s":"The Moon"}},{"k":"item_mouse_describe","v":{"s":"A house mouse, measured head to rump; the tail adds about as much again. It is roughly the smallest mammal most people ever see indoors."}},{"k":"item_mouse_name","v":{"s":"A house mouse"}},{"k":"item_nucleus_describe","v":{"s":"Almost all of an atom's mass, packed into a speck about ten thousand times narrower than the atom itself. Atoms are overwhelmingly empty space."}},{"k":"item_nucleus_name","v":{"s":"The nucleus of a gold atom"}},{"k":"item_oort_describe","v":{"s":"A vast shell of icy bodies thought to surround the Solar System far beyond the planets, and the source of long-period comets."}},{"k":"item_oort_name","v":{"s":"The Oort Cloud"}},{"k":"item_oort_note","v":{"s":"Inferred from comet orbits rather than seen directly, so its size is an estimate."}},{"k":"item_orion_nebula_describe","v":{"s":"A glowing cloud of gas and dust where new stars are forming, visible as the middle \"star\" of Orion's sword."}},{"k":"item_orion_nebula_name","v":{"s":"The Orion Nebula"}},{"k":"item_paramecium_describe","v":{"s":"A single-celled pond organism that swims by beating thousands of tiny hairs, and is just visible without a microscope."}},{"k":"item_paramecium_name","v":{"s":"A paramecium"}},{"k":"item_pollen_describe","v":{"s":"A plant's package of genetic material, built with a tough patterned shell that survives for millions of years."}},{"k":"item_pollen_name","v":{"s":"A pollen grain"}},{"k":"item_proton_describe","v":{"s":"One of the particles in an atomic nucleus. Below about this size, \"how wide is it?\" stops having a clear answer."}},{"k":"item_proton_name","v":{"s":"A proton"}},{"k":"item_proton_note","v":{"s":"Measured as twice the charge radius. A proton has no surface, so its size is defined by how its charge is spread out."}},{"k":"item_pyramid_describe","v":{"s":"A stone pyramid built about 4,500 years ago, and the only one of the ancient wonders still standing."}},{"k":"item_pyramid_name","v":{"s":"The Great Pyramid of Giza"}},{"k":"item_rbc_describe","v":{"s":"A flexible disc that carries oxygen. It squeezes through capillaries narrower than itself."}},{"k":"item_rbc_name","v":{"s":"A red blood cell"}},{"k":"item_reef_describe","v":{"s":"The largest structure built by living things, a chain of thousands of reefs off the Australian coast."}},{"k":"item_reef_name","v":{"s":"The Great Barrier Reef"}},{"k":"item_ribosome_describe","v":{"s":"The molecular machine that reads genetic code and builds proteins from it. Every living cell has them."}},{"k":"item_ribosome_name","v":{"s":"A ribosome"}},{"k":"item_rice_describe","v":{"s":"A single seed, and one of the most common objects on Earth used for guessing at small sizes."}},{"k":"item_rice_name","v":{"s":"A grain of rice"}},{"k":"item_sand_describe","v":{"s":"A single sand grain, small enough that a handful holds tens of thousands of them."}},{"k":"item_sand_name","v":{"s":"A grain of sand"}},{"k":"item_sand_note","v":{"s":"Geologists define sand by size: anything from 0.0625 to 2 millimetres. This is a middling grain."}},{"k":"item_sequoia_describe","v":{"s":"Among the largest living things on Earth by volume. This is roughly the height of the tree called General Sherman."}},{"k":"item_sequoia_name","v":{"s":"A giant sequoia"}},{"k":"item_solar_system_describe","v":{"s":"The Sun and its planets, measured across the orbit of Neptune, the outermost planet."}},{"k":"item_solar_system_name","v":{"s":"The Solar System"}},{"k":"item_sun_describe","v":{"s":"Our star, a ball of hot plasma held together by its own gravity. About 109 Earths would fit side by side across it, and it holds more than 99 per cent of all the mass in the Solar System."}},{"k":"item_sun_name","v":{"s":"The Sun"}},{"k":"item_ten_billion_ly_describe","v":{"s":"A ruler for the deepest views: how far light travels in ten billion years. Light that has come this distance set out before the Sun and Earth existed; the faint red galaxies in the Webb telescope’s deep fields are seen by light older than this."}},{"k":"item_ten_billion_ly_name","v":{"s":"Ten billion light years"}},{"k":"item_trex_describe","v":{"s":"Measured nose to tail. Standing, it was only about four metres tall at the hip."}},{"k":"item_trex_name","v":{"s":"A Tyrannosaurus rex"}},{"k":"item_universe_describe","v":{"s":"Everything close enough that its light has had time to reach us since the universe began. It is not the whole universe, only the part we can possibly see."}},{"k":"item_universe_name","v":{"s":"The observable universe"}},{"k":"item_universe_note","v":{"s":"About 93 billion light years across. It is wider than the age of the universe in light years because space itself has stretched while the light travelled."}},{"k":"item_virgo_sc_describe","v":{"s":"A smaller grouping of galaxy clusters, once thought to be our largest neighbourhood until Laniakea was mapped around it."}},{"k":"item_virgo_sc_name","v":{"s":"The Virgo Supercluster"}},{"k":"item_virus_describe","v":{"s":"A protein shell around a short strand of genetic instructions. Too small to see with a light microscope, and not clearly alive on its own."}},{"k":"item_virus_name","v":{"s":"An influenza virus"}},{"k":"item_water_describe","v":{"s":"Two hydrogen atoms bonded to one oxygen, bent rather than straight, which is why water behaves so strangely."}},{"k":"item_water_name","v":{"s":"A water molecule"}},{"k":"item_xray_describe","v":{"s":"One wave of the light used to photograph bones. Its wavelength is close to the spacing between atoms in a crystal, which is exactly why bouncing X-rays off crystals reveals where the atoms sit."}},{"k":"item_xray_name","v":{"s":"An X-ray wavelength"}},{"k":"journey_end","v":{"s":"That is as far as the ladder goes."}},{"k":"journey_in","v":{"s":"▶ Journey inward"}},{"k":"journey_out","v":{"s":"▶ Journey outward"}},{"k":"journey_pause","v":{"s":"⏸ Pause the journey"}},{"k":"journey_paused","v":{"s":"Journey paused."}},{"k":"ladder_heading","v":{"s":"Everything, largest first"}},{"k":"link_copied","v":{"s":"Link copied"}},{"k":"link_copied_sr","v":{"s":"Link to {name} copied."}},{"k":"link_failed","v":{"s":"Copying was blocked here. Select the link and copy it by hand:"}},{"k":"link_field_aria","v":{"s":"Link to this view"}},{"k":"out_one","v":{"s":"Zoom out one power of ten"}},{"k":"panel_aria","v":{"s":"Scale details"}},{"k":"read_aloud","v":{"s":"Read this aloud"}},{"k":"read_aloud_busy","v":{"s":"Speaking…"}},{"k":"read_aloud_failed","v":{"s":"Read-aloud is not available right now."}},{"k":"returned_sr","v":{"s":"Returned to the STEAM Lab tools."}},{"k":"sci_toggle","v":{"s":"Also show sizes in scientific notation (the exponent is the power of ten)"}},{"k":"scrub_aria","v":{"s":"Scale position, in powers of ten"}},{"k":"scrub_label","v":{"s":"Where you are, across all 44 powers of ten"}},{"k":"see_photo","v":{"s":"See a real photo"}},{"k":"see_photo_aria","v":{"s":"Open a real photograph of {name} in Zoom Gallery"}},{"k":"size_line","v":{"s":"{len} {dim}"}},{"k":"stair_aria","v":{"s":"Steps of ten from {small} to {big}"}},{"k":"stair_caption","v":{"s":"{n} steps of ten from {small} to {big}. Each arrow is one power of ten; each chip is something that size."}},{"k":"title","v":{"s":"🪆 Scale Explorer — powers of ten"}},{"k":"to_big","v":{"s":"🌌 Biggest"}},{"k":"to_human","v":{"s":"🧍 Human scale"}},{"k":"to_small","v":{"s":"🔴 Smallest"}},{"k":"tour_done","v":{"s":"Tour complete. Choose another, or explore from here."}},{"k":"tour_group","v":{"s":"Guided tours"}},{"k":"tour_in_stop_0","v":{"s":"Start here: you. This time every stop is smaller than the last."}},{"k":"tour_in_stop_1","v":{"s":"Seventy micrometres: the width of a hair, about the smallest thing an unaided eye can pick out."}},{"k":"tour_in_stop_2","v":{"s":"Seven and a half micrometres. About ten of these fit across that hair."}},{"k":"tour_in_stop_3","v":{"s":"Two micrometres: a bacterium. Nearly four across one red blood cell."}},{"k":"tour_in_stop_4","v":{"s":"A hundred nanometres. Too small for light to show; this is where microscopes switch to electrons."}},{"k":"tour_in_stop_5","v":{"s":"Two nanometres wide: the double helix. A thousand of these across that bacterium."}},{"k":"tour_in_stop_6","v":{"s":"A water molecule, a quarter of a nanometre. One glass holds more of these than there are stars in the observable universe."}},{"k":"tour_in_stop_7","v":{"s":"One carbon atom. It has no hard edge, so this size is a convention, and the note on its card says so."}},{"k":"tour_in_stop_8","v":{"s":"The nucleus of a gold atom: tens of thousands of times narrower than the atom around it. Almost all of an atom is empty space."}},{"k":"tour_in_stop_9","v":{"s":"A proton. Below this, asking how wide something is stops having a clear answer, and the trip ends."}},{"k":"tour_in_title","v":{"s":"From you down to the proton"}},{"k":"tour_label","v":{"s":"Guided tour"}},{"k":"tour_next","v":{"s":"Next stop ▶"}},{"k":"tour_none","v":{"s":"Choose a tour…"}},{"k":"tour_out_stop_0","v":{"s":"Start here: you. Everything on this trip is measured against you."}},{"k":"tour_out_stop_1","v":{"s":"About fifteen of you, nose to tail. The largest animal that has ever lived is still something you could walk the length of."}},{"k":"tour_out_stop_2","v":{"s":"Nearly two hundred of you. Buildings are where human-sized things stop feeling human-sized."}},{"k":"tour_out_stop_3","v":{"s":"Five thousand of you. From here on nothing is built; everything is grown, piled up or blown."}},{"k":"tour_out_stop_4","v":{"s":"Twelve thousand kilometres across. At this size Everest is a bump far too small to see."}},{"k":"tour_out_stop_5","v":{"s":"One hundred and nine Earths across. The bright disc in the sky is this."}},{"k":"tour_out_stop_6","v":{"s":"The gap between the Earth and the Sun: about a hundred and seven Suns laid side by side."}},{"k":"tour_out_stop_7","v":{"s":"One light year: sixty-three thousand Earth-Sun distances. The nearest other star is four of these away."}},{"k":"tour_out_stop_8","v":{"s":"Our galaxy, about a hundred thousand light years across. Light takes a hundred thousand years to cross it."}},{"k":"tour_out_stop_9","v":{"s":"The observable universe, ninety-three billion light years across. Past this, no light has had time to reach us."}},{"k":"tour_out_title","v":{"s":"From you to the edge of everything"}},{"k":"tour_prev","v":{"s":"◀ Back"}},{"k":"tour_progress","v":{"s":"Stop {n} of {total}"}},{"k":"tour_select_aria","v":{"s":"Choose a guided tour"}},{"k":"tour_solar_stop_0","v":{"s":"Home: twelve thousand kilometres across."}},{"k":"tour_solar_stop_1","v":{"s":"A quarter of the Earth’s width, and it sits thirty Earths away, farther than most pictures suggest."}},{"k":"tour_solar_stop_2","v":{"s":"Eleven Earths across, and most of the planetary mass in the Solar System."}},{"k":"tour_solar_stop_3","v":{"s":"Ten Jupiters across; about a thousand Jupiters would fit inside."}},{"k":"tour_solar_stop_4","v":{"s":"One astronomical unit, the Earth’s distance from the Sun: eight light minutes."}},{"k":"tour_solar_stop_5","v":{"s":"Neptune’s orbit, sixty times the Earth-Sun distance. Light takes over eight hours to cross it."}},{"k":"tour_solar_stop_6","v":{"s":"The Sun’s bubble in the galaxy, where its wind gives out. Both Voyagers have crossed its edge."}},{"k":"tour_solar_stop_7","v":{"s":"The Oort cloud of comets, reaching most of a light year out: the true edge of the Sun’s family."}},{"k":"tour_solar_stop_8","v":{"s":"The nearest other star system, a little over four light years. Every stop so far fits into this gap."}},{"k":"tour_solar_title","v":{"s":"Around the Solar System"}},{"k":"tour_stop_sr","v":{"s":"Stop {n} of {total}: {name}. {line}"}},{"k":"view_line","v":{"s":"You are looking at things about {len} across ({p})."}},{"k":"you_apply","v":{"s":"Use my height"}},{"k":"you_cleared_sr","v":{"s":"Back to an average adult, 1.7 m tall."}},{"k":"you_cm","v":{"s":"cm"}},{"k":"you_describe","v":{"s":"That is you, at {len}. Everything else here is measured against you."}},{"k":"you_input_aria","v":{"s":"Your height in centimetres"}},{"k":"you_invalid","v":{"s":"Enter a height between 50 and 250 centimetres."}},{"k":"you_label","v":{"s":"Make the person your height:"}},{"k":"you_name","v":{"s":"You"}},{"k":"you_reset","v":{"s":"Back to average"}},{"k":"you_set_sr","v":{"s":"The person is now you, {len} tall."}}],"id":448}},{"k":"cellatlas","v":{"o":[{"k":"sr_all_marker_features_restored","v":{"s":"All marker features restored."}},{"k":"sr_keep_at_least_one_gene_in_the_marker_panel","v":{"s":"Keep at least one gene in the marker panel."}},{"k":"sr_downloaded_and_saved_cell_atlas_revision_attempt","v":{"s":"Downloaded and saved Cell Atlas revision attempt."}},{"k":"sr_returned_to_steam_lab_tools","v":{"s":"Returned to STEAM Lab tools."}},{"k":"a11y_cross_scale_record_context","v":{"s":"Cross-scale record context"}},{"k":"a11y_real_data_interpretation_choices","v":{"s":"Real-data interpretation choices"}},{"k":"a11y_metric_stress_test_explanation_choices","v":{"s":"Metric stress-test explanation choices"}},{"k":"a11y_pseudoreplication_interpretation_choices","v":{"s":"Pseudoreplication interpretation choices"}},{"k":"a11y_pseudonymous_source_replicate","v":{"s":"Pseudonymous source replicate"}},{"k":"a11y_replicate_transfer_metric","v":{"s":"Replicate transfer metric"}},{"k":"a11y_independent_replication_choices","v":{"s":"Independent replication choices"}},{"k":"a11y_download_cell_atlas_reproducibility_audit_md","v":{"s":"Download cell-atlas-reproducibility-audit.md"}},{"k":"a11y_download_cell_atlas_reproducibility_audit_json","v":{"s":"Download cell-atlas-reproducibility-audit.json"}},{"k":"a11y_replicate_sample_size_interpretation_choices","v":{"s":"Replicate sample-size interpretation choices"}},{"k":"a11y_ablation_metric","v":{"s":"Ablation metric"}},{"k":"a11y_gene_feature_to_remove","v":{"s":"Gene feature to remove"}},{"k":"a11y_marker_ablation_interpretation_choices","v":{"s":"Marker-ablation interpretation choices"}},{"k":"a11y_panel_metric","v":{"s":"Panel metric"}},{"k":"a11y_genes_included_in_marker_panel","v":{"s":"Genes included in marker panel"}},{"k":"a11y_panel_selection_interpretation_choices","v":{"s":"Panel-selection interpretation choices"}},{"k":"a11y_perturbation_metric","v":{"s":"Perturbation metric"}},{"k":"a11y_perturbation_envelope","v":{"s":"Perturbation envelope"}},{"k":"a11y_perturbation_outcome_distribution","v":{"s":"Perturbation outcome distribution"}},{"k":"a11y_perturbation_stability_interpretation_choices","v":{"s":"Perturbation-stability interpretation choices"}},{"k":"a11y_evidence_source_mode","v":{"s":"Evidence source mode"}},{"k":"a11y_real_data_metric","v":{"s":"Real-data metric"}},{"k":"a11y_real_snapshot_provenance_summary","v":{"s":"Real snapshot provenance summary"}},{"k":"a11y_marker_gene","v":{"s":"Marker gene"}},{"k":"a11y_mystery_cell_answer_choices","v":{"s":"Mystery cell answer choices"}},{"k":"a11y_quality_control_response_choices","v":{"s":"Quality-control response choices"}},{"k":"a11y_download_cell_atlas_study_design_md","v":{"s":"Download cell-atlas-study-design.md"}},{"k":"a11y_download_cell_atlas_study_design_json","v":{"s":"Download cell-atlas-study-design.json"}},{"k":"a11y_cross_tissue_systems_lens","v":{"s":"Cross-tissue systems lens"}},{"k":"a11y_notebook_completion_checks","v":{"s":"Notebook completion checks"}},{"k":"a11y_download_cell_atlas_cross_tissue_cer_md","v":{"s":"Download cell-atlas-cross-tissue-cer.md"}},{"k":"a11y_download_cell_atlas_cross_tissue_cer_json","v":{"s":"Download cell-atlas-cross-tissue-cer.json"}},{"k":"a11y_cautious_conclusion_choices","v":{"s":"Cautious conclusion choices"}},{"k":"a11y_claim_to_evidence_map","v":{"s":"Claim to evidence map"}},{"k":"a11y_confidence_level","v":{"s":"Confidence level"}},{"k":"a11y_saved_revision_attempts","v":{"s":"Saved revision attempts"}},{"k":"a11y_download_cell_atlas_teacher_review_portfolio_js","v":{"s":"Download Cell Atlas teacher review portfolio JSON"}},{"k":"a11y_download_cell_atlas_teacher_review_portfolio_ma","v":{"s":"Download Cell Atlas teacher review portfolio markdown"}},{"k":"a11y_back_to_steam_lab_tools","v":{"s":"Back to STEAM Lab tools"}},{"k":"a11y_investigation_progress","v":{"s":"Investigation progress"}},{"k":"a11y_evidence_route_progress","v":{"s":"Evidence route progress"}},{"k":"a11y_choose_a_human_cell_atlas_tissue_investigation","v":{"s":"Choose a Human Cell Atlas tissue investigation"}},{"k":"a11y_cell_atlas_investigation_views","v":{"s":"Cell Atlas investigation views"}}],"id":449}},{"k":"fisherlab","v":{"o":[{"k":"sr_slow_below_one_knot_before_hauling_the_trap","v":{"s":"Slow below one knot before hauling the trap."}},{"k":"sr_this_trap_has_already_been_hauled","v":{"s":"This trap has already been hauled."}},{"k":"sr_graphics_are_still_recovering_the_harbor_simulati","v":{"s":"Graphics are still recovering. The harbor simulation remains paused."}},{"k":"sr_harbor_simulation_remains_paused_press_p_or_use_r","v":{"s":"Harbor simulation remains paused. Press P or use Resume when ready."}},{"k":"sr_prolonged_fog_signal_already_logged","v":{"s":"Prolonged fog signal already logged."}},{"k":"sr_prolonged_fog_signal_made_visual_confirmation_rul","v":{"s":"Prolonged fog signal made. Visual confirmation: Rule 35 signal logged."}},{"k":"sr_fuel_exhausted_propulsion_offline","v":{"s":"Fuel exhausted. Propulsion offline."}},{"k":"sr_unsafe_speed_for_current_conditions_reduce_speed","v":{"s":"Unsafe speed for current conditions. Reduce speed."}},{"k":"sr_ten_seconds_remain_in_the_maneuver_window","v":{"s":"Ten seconds remain in the maneuver window."}},{"k":"sr_five_seconds_remain_complete_the_required_maneuve","v":{"s":"Five seconds remain. Complete the required maneuver actions."}},{"k":"sr_maneuver_reviewed_continue_the_voyage","v":{"s":"Maneuver reviewed. Continue the voyage."}},{"k":"sr_reached_the_fishing_grounds_drop_a_jig_with_f","v":{"s":"Reached the fishing grounds. Drop a jig with F."}},{"k":"sr_slow_below_one_knot_before_fishing","v":{"s":"Slow below one knot before fishing."}},{"k":"sr_fishing_setup_open_choose_a_spot_tackle_depth_and","v":{"s":"Fishing setup open. Choose a spot, tackle, depth, and presentation before casting."}},{"k":"sr_simulator_expanded_to_full_screen_press_the_same","v":{"s":"Simulator expanded to full screen. Press the same button to return."}},{"k":"sr_cast_meter_ready_aim_for_the_target_zone_from_75","v":{"s":"Cast meter ready. Aim for the target zone from 75 to 95 percent."}},{"k":"sr_cast_missed_the_selected_water_adjust_and_try_aga","v":{"s":"Cast missed the selected water. Adjust and try again."}},{"k":"sr_cast_placed_work_the_presentation_and_watch_for_a","v":{"s":"Cast placed. Work the presentation and watch for a bite."}},{"k":"sr_no_bite_review_the_setup_evidence_and_adapt_befor","v":{"s":"No bite. Review the setup evidence and adapt before the next cast."}},{"k":"sr_missed_bite_reset_and_watch_for_the_next_line_loa","v":{"s":"Missed bite. Reset and watch for the next line-load cue."}},{"k":"sr_fish_hooked_balance_reeling_and_giving_line_to_co","v":{"s":"Fish hooked. Balance reeling and giving line to control tension."}},{"k":"sr_line_break_give_line_sooner_when_tension_rises","v":{"s":"Line break. Give line sooner when tension rises."}},{"k":"sr_fish_lost_to_slack_line_reel_sooner_when_tension","v":{"s":"Fish lost to slack line. Reel sooner when tension falls."}},{"k":"sr_fish_lost_review_the_tension_history_and_try_agai","v":{"s":"Fish lost. Review the tension history and try again."}},{"k":"sr_fish_landed_moving_to_species_identification_and","v":{"s":"Fish landed. Moving to species identification and measurement."}},{"k":"sr_voyage_autosave_restored","v":{"s":"Voyage autosave restored."}},{"k":"sr_no_pending_voyage_save_needs_retrying","v":{"s":"No pending voyage save needs retrying."}},{"k":"sr_autosave_retry_failed_keep_this_tab_open_and_chec","v":{"s":"Autosave retry failed. Keep this tab open and check browser storage settings."}},{"k":"sr_voyage_rescue_file_downloaded","v":{"s":"Voyage rescue file downloaded."}},{"k":"sr_3d_engine_could_not_load_your_saved_voyage_remain","v":{"s":"3D engine could not load. Your saved voyage remains available. Use Chart Mode as a fallback."}},{"k":"sr_a_new_voyage_was_not_started_because_the_saved_vo","v":{"s":"A new voyage was not started because the saved voyage could not be cleared. Retry autosave or resume the saved voyage."}},{"k":"sr_the_invalid_saved_voyage_was_discarded","v":{"s":"The invalid saved voyage was discarded."}},{"k":"sr_the_invalid_saved_voyage_could_not_be_cleared_bec","v":{"s":"The invalid saved voyage could not be cleared because browser storage is unavailable."}},{"k":"sr_saved_voyage_could_not_be_discarded_because_brows","v":{"s":"Saved voyage could not be discarded because browser storage is unavailable. Retry autosave and try again."}},{"k":"sr_saved_voyage_discarded_start_a_new_voyage_when_re","v":{"s":"Saved voyage discarded. Start a new voyage when ready."}},{"k":"sr_no_safe_graphics_recovery_checkpoint_is_available","v":{"s":"No safe graphics recovery checkpoint is available. Leave the simulator and start a new voyage."}},{"k":"sr_restarting_graphics_from_the_latest_safe_voyage_c","v":{"s":"Restarting graphics from the latest safe voyage checkpoint."}},{"k":"sr_simulator_closed_voyage_briefing_focused","v":{"s":"Simulator closed. Voyage briefing focused."}},{"k":"sr_3d_engine_failed_to_initialize_use_chart_mode_2d","v":{"s":"3D engine failed to initialize. Use Chart Mode (2D fallback) instead."}},{"k":"sr_section_search_cleared","v":{"s":"Section search cleared"}},{"k":"sr_choose_a_review_needed_decision_first","v":{"s":"Choose a review-needed decision first."}},{"k":"sr_write_at_least_20_characters_before_saving_the_co","v":{"s":"Write at least 20 characters before saving the correction."}},{"k":"sr_that_decision_could_not_be_updated_the_original_j","v":{"s":"That decision could not be updated. The original journal record was preserved."}},{"k":"sr_no_visible_journal_observations_to_export","v":{"s":"No visible journal observations to export."}},{"k":"sr_field_journal_export_is_unavailable_in_this_brows","v":{"s":"Field journal export is unavailable in this browser."}},{"k":"sr_3d_simulator_section_open","v":{"s":"3D simulator section open"}},{"k":"sr_field_journal_filters_reset","v":{"s":"Field journal filters reset."}},{"k":"sr_graphics_are_still_recovering_resume_is_unavailab","v":{"s":"Graphics are still recovering. Resume is unavailable until restoration completes."}},{"k":"sr_focused_practice_target_cleared","v":{"s":"Focused practice target cleared."}},{"k":"a11y_navigation_light_sectors_seen_from_above_the_gr","v":{"s":"Navigation light sectors seen from above. The green starboard sidelight covers 112.5 degrees from dead ahead round to 22.5 degrees abaft the starboard beam. The red port sidelight covers the mirror-image 112.5 degrees to port. The white stern light covers the remaining 135 degrees astern. The three sectors together cover the full 360 degrees with no gap and no overlap."}},{"k":"a11y_rule_of_twelfths_between_high_and_low_water_the","v":{"s":"Rule of twelfths. Between high and low water the level changes by one twelfth of the range in the first hour, two twelfths in the second, three in the third, three in the fourth, two in the fifth and one in the sixth. Half the range has gone by mid-tide. Plotted against the smooth semidiurnal curve it approximates, the two never differ by more than about one sixtieth of the range."}},{"k":"a11y_spring_and_neap_tides_at_new_and_full_moon_the","v":{"s":"Spring and neap tides. At new and full moon the Sun and Moon pull in line and their tidal bulges add, giving the largest range, called a spring tide. At the quarter moons they pull at right angles and partly cancel, giving the smallest range, a neap tide."}},{"k":"a11y_water_column_of_the_gulf_of_maine_from_the_brig","v":{"s":"Water column of the Gulf of Maine, from the bright surface layer down to the continental slope and the seabed, shaded darker with depth. The depth axis is square-root compressed so the thin surface bands stay readable; tick marks give true depths of 0, 5, 30, 100, 200, 300 and 400 metres. Each band is labelled with its name, its light level and its depth range."}},{"k":"a11y_distance_to_the_horizon_an_observer_with_an_eye","v":{"s":"Distance to the horizon. An observer with an eye height of ten feet sees the horizon 3.7 nautical miles away, since 1.17 times the square root of 10 is 3.7. A hundred-foot lighthouse has its own horizon 11.7 miles away. Because both see the same point on the curve, the light can first be raised at about 15.4 miles. The earth curvature in the drawing is greatly exaggerated."}},{"k":"a11y_the_compass_correction_chain_remembered_as_can","v":{"s":"The compass correction chain, remembered as Can Dead Men Vote Twice: Compass, Deviation, Magnetic, Variation, True. Deviation is your own vessel's error and comes off its deviation card; variation is where magnetic north actually lies, about 16 degrees west in Maine. Working left to right corrects a compass reading to true; working right to left converts a charted true course into one you can steer."}},{"k":"a11y_anchor_scope_in_thirty_feet_of_water_measured_f","v":{"s":"Anchor scope. In thirty feet of water measured from the bow, a three to one scope of ninety feet pulls on the anchor at about nineteen degrees above the seabed, a five to one scope of a hundred and fifty feet at about twelve degrees, and a seven to one scope of two hundred and ten feet at about eight degrees. The flatter the pull, the better the anchor holds; a steep pull lifts the shank and the anchor breaks out."}},{"k":"a11y_the_seven_maine_lobster_management_zones_in_ord","v":{"s":"The seven Maine lobster management zones in order along the coast, from Zone A at the north-eastern end on the Canadian border through to Zone G at the south-western end by New Hampshire. Each is labelled with its letter and its leading port. The drawing is schematic: the order is exact, the boundaries and widths are not."}},{"k":"a11y_where_each_kind_of_gear_works_from_the_beach_ou","v":{"s":"Where each kind of gear works, from the beach out to deeper water. Wading the flats fishes ankle to waist depth on foot. A lobster trap sits on the seabed with a line up to a coloured surface buoy whose colours identify its licence holder. Trolling drags a lure through the top few metres behind a moving boat. Jigging works straight down from a drifting boat, from the seabed up into mid-water. A gillnet stands as a wall of mesh held up by floats on its headline and down by lead on its footrope, fishing the whole height of the wall. A longline lies along the bottom with short baited droppers, marked at the end by a buoy and flag."}},{"k":"a11y_a_labelled_fish_naming_the_parts_the_identifica","v":{"s":"A labelled fish, naming the parts the identification notes use: first, second and third dorsal fins along the back; the lateral line running the length of the flank; the gill cover behind the head; a barbel hanging under the chin; the pectoral fin behind the gill cover; the pelvic fin beneath it; the anal fin under the rear of the body; and the caudal or tail fin. The drawing is schematic — the parts are named the same on every fish, but the number of dorsal fins and the presence of a barbel vary by family."}},{"k":"a11y_atlantic_cod_compared_with_haddock_both_are_cod","v":{"s":"Atlantic cod compared with haddock. Both are cod-family fish carrying three dorsal fins and a barbel under the chin, small on haddock, so neither of those separates them. Cod has a pale lateral line that arches upward over the pectoral fin, a rounded first dorsal fin, and no dark mark on the shoulder. Haddock has a dark lateral line running straighter along the flank, a tall pointed first dorsal fin, and a black thumbprint mark above the pectoral fin. Telling them apart matters because cod is severely depleted in the Gulf of Maine while haddock has recovered."}},{"k":"a11y_channel_plan_for_red_right_returning_a_vessel_i","v":{"s":"Channel plan for red right returning. A vessel inbound from the sea toward the harbor keeps the red conical nun buoys, numbered even, on her starboard side, and the green cylindrical can buoys, numbered odd, on her port side. Outbound, the sides reverse."}},{"k":"a11y_voyage_rescue_file_actions","v":{"s":"Voyage rescue file actions"}},{"k":"a11y_choose_a_fisher_lab_voyage_rescue_json_file","v":{"s":"Choose a Fisher Lab voyage rescue JSON file"}},{"k":"a11y_confirm_voyage_rescue","v":{"s":"Confirm voyage rescue"}},{"k":"a11y_voyage_storage_recovery_actions","v":{"s":"Voyage storage recovery actions"}},{"k":"a11y_saved_voyage_actions","v":{"s":"Saved voyage actions"}},{"k":"a11y_accessibility_preferences","v":{"s":"Accessibility preferences"}},{"k":"a11y_display_and_motion_options","v":{"s":"Display and motion options"}},{"k":"a11y_fisherlab_learning_sections","v":{"s":"FisherLab learning sections"}},{"k":"a11y_fisherlab_learning_areas","v":{"s":"FisherLab learning areas"}},{"k":"a11y_matching_fisherlab_sections","v":{"s":"Matching FisherLab sections"}},{"k":"a11y_recent_condition_profiles","v":{"s":"Recent condition profiles"}},{"k":"a11y_species_ranking_hypothesis","v":{"s":"Species ranking hypothesis"}},{"k":"a11y_explain_the_species_ranking_in_your_own_words","v":{"s":"Explain the species ranking in your own words"}},{"k":"a11y_repeated_measurements","v":{"s":"Repeated measurements"}},{"k":"a11y_guided_investigation","v":{"s":"Guided investigation"}},{"k":"a11y_investigation_in_progress","v":{"s":"Investigation in progress"}},{"k":"a11y_investigation_steps","v":{"s":"Investigation steps"}},{"k":"a11y_recorded_model_trials","v":{"s":"Recorded model trials"}},{"k":"a11y_wind_and_navigation_instruments","v":{"s":"Wind and navigation instruments"}},{"k":"a11y_voyage_challenge","v":{"s":"Voyage challenge"}},{"k":"a11y_camera_view_v_cycles","v":{"s":"Camera view (V cycles)"}},{"k":"a11y_time_of_day","v":{"s":"Time of day"}},{"k":"a11y_weather","v":{"s":"Weather"}},{"k":"a11y_interactive_3d_harbor_focus_this_scene_to_steer","v":{"s":"Interactive 3D harbor. Focus this scene to steer with WASD or arrow keys. Press B for the fog horn, use 1 through 3 for a radar evidence call when prompted, F at the fishing grounds, H near a trap, and P to pause."}},{"k":"a11y_next_voyage_objective_and_relative_bearing","v":{"s":"Next voyage objective and relative bearing"}},{"k":"a11y_make_the_radar_evidence_call","v":{"s":"Make the radar evidence call"}},{"k":"a11y_voyage_log","v":{"s":"Voyage log"}},{"k":"a11y_on_screen_boat_controls","v":{"s":"On-screen boat controls"}},{"k":"a11y_sound_one_prolonged_fog_horn_blast","v":{"s":"Sound one prolonged fog-horn blast"}},{"k":"a11y_end_fishing_and_return_to_helm","v":{"s":"End fishing and return to helm"}},{"k":"a11y_observed_voyage_conditions","v":{"s":"Observed voyage conditions"}},{"k":"a11y_fishing_setup_affinity","v":{"s":"Fishing setup affinity"}},{"k":"a11y_presentation_cadence","v":{"s":"Presentation cadence"}},{"k":"a11y_catch_field_notes","v":{"s":"Catch field notes"}},{"k":"a11y_shellfish_measurement_diagram_with_fixed_and_ad","v":{"s":"Shellfish measurement diagram with fixed and adjustable caliper jaws. Use the range control to align the jaws with the marked reference points."}},{"k":"a11y_caliper_measurement_in_inches","v":{"s":"Caliper measurement in inches"}},{"k":"a11y_stylized_north_up_nautical_chart_of_the_portlan","v":{"s":"Stylized north-up nautical chart of the Portland Harbor approach. The mainland and Custom House Wharf are along the top, with Portland Head Light to the east. The channel runs down the middle to open water at the bottom. Three red nun buoys, numbered 2, 4 and 6, mark its eastern side on the right of the chart, and three green cans, numbered 1, 3 and 5, mark its western side on the left. A vessel returning from sea travels up the chart and keeps the red nuns to starboard; outbound the sides reverse. A red and white mid-channel safe-water mark sits at the seaward end, with Halfway Rock beyond it, and dashed 10-metre and 30-metre depth contours cross the chart."}},{"k":"a11y_questions_answered_in_this_round","v":{"s":"Questions answered in this round"}}],"id":450}},{"k":"pets","v":{"o":[{"k":"sr_completion_updated_with_activity_evidence","v":{"s":"Completion updated with activity evidence."}},{"k":"sr_back_to_menu","v":{"s":"Back to menu"}},{"k":"sr_starting_a_four_case_body_language_context_challe","v":{"s":"Starting a four-case body language context challenge."}},{"k":"sr_full_quiz_reset","v":{"s":"Full quiz reset"}},{"k":"sr_opening_body_language_signal_practice","v":{"s":"Opening Body Language signal practice."}},{"k":"sr_offline_rubric_check_ready","v":{"s":"Offline rubric check ready."}},{"k":"sr_getting_critique","v":{"s":"Getting critique..."}},{"k":"sr_critique_ready","v":{"s":"Critique ready."}},{"k":"sr_revision_reflection_saved_for_teacher_review","v":{"s":"Revision reflection saved for teacher review."}},{"k":"sr_3d_engine_ready","v":{"s":"3D engine ready."}},{"k":"sr_the_3d_engine_could_not_load_the_written_comparis","v":{"s":"The 3D engine could not load. The written comparison below still works."}},{"k":"sr_comparison_cleared_you_can_move_and_choose_a_new","v":{"s":"Comparison cleared. You can move and choose a new angle."}},{"k":"sr_the_3d_room_must_be_ready_before_a_comparison_fra","v":{"s":"The 3D room must be ready before a comparison frame can be captured."}},{"k":"sr_this_browser_could_not_capture_the_comparison_fra","v":{"s":"This browser could not capture the comparison frame."}},{"k":"sr_view_reset_to_the_room_entrance","v":{"s":"View reset to the room ent