    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150302.png",
      "text": "Mimi iyo saaxiibadeed waxay subax kasta ku dabaashaan webiga yar. Waxay jecel yihiin dabaasha biyaha qulqulaya.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=1",
      "sourceDigest": "sha256:92141ca6f7ac20da999eb9ad2df84537daa7050228c0aff8fa2e5f55158cd8e6"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150303.png",
      "text": "Terfa iyo walaalihiis waxay ku ciyaaraan agagaarka webiga marka dugsigu dhammaado. Waxay jecel yihiin ciyaarta meelaha bannaan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=2",
      "sourceDigest": "sha256:396ad3411b6e8b2a416fdd4171a5b619c6c399a11d3f1b17fff9eef00edd72ad"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150304.png",
      "text": "Markuu diiqu qayliyo, waxaan ognahay in ay tahay xilligee lakacaye. Diiqu wuxuu toosiyaa Ngutor iyo aabbihiis. Waxay bilaabaan beerashada aroortii hore.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=3",
      "sourceDigest": "sha256:0b9b2daa283eea9e446d85b8158aebb653c69c961776fcb335c6d4ba72135d91"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150305.png",
      "text": "Dooga iyo walaalkiis waxay jecel yihiin inay maqlaan shimbiraha codkooda. Waxay daawanayaan shimbirha oo buulal ka dhisaya geedaha guduhooda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=4",
      "sourceDigest": "sha256:e3e4315f8113fc3c1946416f0d9a8a695039df128ba1a97524a712e1b660d9ef"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150306.png",
      "text": "Hooyaday waxay fariisataa harka geedka. Waxay jeceshahay neecawda iyo geedaha sharqartooda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=5",
      "sourceDigest": "sha256:dedc6110256e11380dcd891698ff9ef53def91bd3b2030a82e100ded5b76a11c"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150307.png",
      "text": "Walaashayda iga yar waxay jeceshahay daawaashada xiddigaha dhalaalaya. Waxay ku hareeransanyihiin dayaxa oo ka dhageystaan dayaxa oo u sheegaya sheekooyin.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=6",
      "sourceDigest": "sha256:938438466fbd3a04cb8b08faa49eef840158b24bdbee42cd8051df2a122d60ff"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150308.png",
      "text": "Marka dayaxu buuxo, awoowgay wuxuu noo sheegaa sheekooyin cabsi leh. Waxaan jecelnahay inaan ciyaarno ciyaaraha iftiinka ee dayaxa buuxa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=7",
      "sourceDigest": "sha256:fdb0c7db88346da433c16333a30d49c487160492b9c6b49b66e9fd1abcd70d59"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/93150309.png",
      "text": "Waxaan jecelnahay dhammaan waxyaalahan ku saabsan dabeecadda. Adigu maxaad ka jeceshahay dabeecadaha?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=52011#page=8",
      "sourceDigest": "sha256:367b45222c2f6a22e2fec346e3659f91fd65ca3c95447955d603585539cff8d4"
    }
  ],
