  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940122.png",
      "text": "Bling azalaki kolinga makambo etali lisano ya ndembo. Tango azali koloba pona lisano, alobaka mingi boye, \"Ndembo ezali bomoyi!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=1",
      "sourceDigest": "sha256:d2f054e29ae7be1adcf5c1768d9ea06fc3fdca559beab237b6ff313433f21ed2"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940123.png",
      "text": "Bling azalaki moko ya babeti ndembo ya molakisi Tsepo. Molakisi oyo azalaki na lolendo pona lingomba naye ya ndembo. Bamingi balingaki basangana na bango.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=2",
      "sourceDigest": "sha256:f4484b470f59aa8f3127c50f138ba05e7d79f1d10ea667e06f81fb3f7fe43f3a"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940124.png",
      "text": "Lisano moko ya motuya ezalaki koya. Lingomba ezalaki koyekola mikolo nionso. Bato nionso bazalaki na esengo po na lisano ya monene!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=3",
      "sourceDigest": "sha256:3a7cbadb68cf7895465baa1ce32c621d323417139db7044c4dc1851db85d5855"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940125.png",
      "text": "Molakisi ya lingomba yabatelemeli azalaki moto ya zuwa. Azalaki na zuwa pona lokumu ya moninga naye molakisi Tsepo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=4",
      "sourceDigest": "sha256:3874c8cde3c76f181eadd95d2328ec7e988075604f5724eb51cc4b2d5c8971bb"
    },
    {
      "n": 5,
      "img": null,
      "text": "Molakisi ya zuwa akendeki nalopango ya masano na butu liboso ya bokutani. Alonaki eloko moko ya mabe. Alonaki Kisi!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=5",
      "sourceDigest": "sha256:e3bbff2e68ffe063123c9127e6e4f7c0c6dab297d95fe97fc7de6c14eb205801"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940126.png",
      "text": "Bling abima pona ebandeli moko ya makasi na lisano. Azalaki kokima mbango atia mokele.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=6",
      "sourceDigest": "sha256:2e3f473f8be250866fc9abbd2a5d8be331dd054e6e4af7c6bba55bdaa8b9a88a"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940127.png",
      "text": "Azangi ebeteli naye pe akweyi! \"Bling?\" bato bangangi \"Bling?\" molakisi Tsepo abondeli.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=7",
      "sourceDigest": "sha256:cbc2816c1ef44a07db351fc41f85471e653c71982dc46e60b93accac0b9ceef6"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/85940128.png",
      "text": "\"Eloko moko te eko kanga ngayi nase!\" Bling amilobeli. \"Ndembo ezali bomoyi.\" Atelemi pe abeti tii na suka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=33815#page=8",
      "sourceDigest": "sha256:73233f63246f2496c5f73d68b172c1edb948d44c3bcf5117e3099b9285778c1a"
    }
  ],
