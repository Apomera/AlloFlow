  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/25964.png",
      "text": "Hooyo, Aabe, iyo Lina waxay ka hadlayaan sida caafimaadka loo ilaashado.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=1",
      "sourceDigest": "sha256:9dffb1ccf686d2d4d827979587105e62d4a6f245b3209edf8af42ea48b6dea7e"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/25965.png",
      "text": "Lina waxay dugsiga waydiisay, \"Maxaa qasab ka dhigaya in gacmaha la dhaqo?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=2",
      "sourceDigest": "sha256:32578af854bdc55537b290ef1e4b27742f2b8bc1b20aa60377ed60fb9c922710"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25966.png",
      "text": "Macallimadu waxay tiri, \"Gacmaheenna jeermis bay leeyihiin, balse jeermiska indhaha laguma arki karo.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=3",
      "sourceDigest": "sha256:be9e31684e5b6a894bbbe6de1d518a529c6812c71ca730a24945506938e6925b"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25967.png",
      "text": "\"Jeermisku aad buu u yar yahay. Waxaan u baahanahay mikroskoob si aan u aragno.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=4",
      "sourceDigest": "sha256:187e475e9c66e1772502207295319a7af1e8a6b217572c0174fb0971176f9d16"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25968.png",
      "text": "Lina waxay fiirisay mikroskoobka dhexdiisa. Waxayna ku aragtay jeermisyada ku yaalla gacanteeda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=5",
      "sourceDigest": "sha256:6f2fd207b384de2b99ef346846f886f342c152ff8b641452f9fee3511935ba2b"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25969.png",
      "text": "\"Fayrasyada iyo bakteeriyadu waa noocyo ka mid ah jeermisyada. Jeermisyadu waxay nagu keeni karaan cudurro.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=6",
      "sourceDigest": "sha256:66127bcf2ff9cf8b1bf425ee38d18984da6ea66dab83835f8b6537b2bab1b2c6"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25970.png",
      "text": "\"Gacmo dhaqashadu waxay joojisaa fayrasyada iyo jeermiska inay fidaan,\" ayay tiri macallimaddu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=7",
      "sourceDigest": "sha256:a48ed2c7933a46f8dab0a06f947e825c4b9521fca4f31bc6236f66422b6385c2"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25971.png",
      "text": "Aabuhu wuxuu samaynayaa weel lagu dhaqo gacmaha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=8",
      "sourceDigest": "sha256:cef8aa158744390c1fe0d5c90c7d5dfdbf53e5f9ea65441e880e036d615af540"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/25972.png",
      "text": "Lina waxay waydiisay, \"Qalabkan sidee buu u shaqeeyaa?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=9",
      "sourceDigest": "sha256:ba8d07d49722b8a2a44cf741451f5e713f9d27ddc79563ce1459783bc993f258"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/25973.png",
      "text": "\"Qaybta alwaaxda ahi waxay weelka ku ridaysaa biyaha ka soo qulqulaya.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=10",
      "sourceDigest": "sha256:e315781fd4355208e2a702adf9e826f897aea55f39423af98f3b41ae4df1f453"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/25974.png",
      "text": "\"Ku dhaq saabuun iyo biyo, si tartiib ah u tiri ilaa 20 inta aad gacmahaaga dhaqayso.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=11",
      "sourceDigest": "sha256:c4c30fdfe504f28c0cfc7471079cdca5181eb702945bf88ad2921d1003fd5fcf"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/25975.png",
      "text": "\"Aabe caqli badan! Haddaba ma kugu salaami karaa suxulka.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52484#page=12",
      "sourceDigest": "sha256:5c4a9c86420786659c9c53dee96eb2a12d668409010e73f37e5a93d4faf94236"
    }
  ],
