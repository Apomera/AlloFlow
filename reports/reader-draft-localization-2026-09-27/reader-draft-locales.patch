diff --git a/dev-tools/i18n/apply_reader_draft_locales.cjs b/dev-tools/i18n/apply_reader_draft_locales.cjs
new file mode 100644
--- /dev/null
+++ b/dev-tools/i18n/apply_reader_draft_locales.cjs
@@ -0,0 +1,76 @@
+#!/usr/bin/env node
+// Only the frozen seven-message draft batch is writable; other catalog values are preserved.
+const fs = require('node:fs');
+const path = require('node:path');
+const ROOT = path.resolve(__dirname, '../..');
+const LOCALES = ['spanish_latin_america', 'spanish_castilian', 'arabic', 'chinese_simplified', 'thai'];
+const COPY = Object.freeze({
+  "simplified.gloss_draft_passage_changed": "The passage changed. Your draft is retained. Review the word supports, then {chooseOccurrence} before saving.",
+  "simplified.gloss_draft_choose_occurrence": "choose the occurrence in the current text",
+  "simplified.gloss_draft_passage_changed_error": "The passage changed. Your draft is retained. Review the current word supports and choose its occurrence again before saving.",
+  "simplified.gloss_save_and_continue": "Save and continue",
+  "simplified.gloss_save_word_support_confirmed": "Word support saved. Your wording will be kept when suggestions are refreshed.",
+  "simplified.gloss_save_support_unconfirmed": "The save did not confirm this word support. Your draft is retained.",
+  "simplified.gloss_save_changes_unconfirmed": "The save did not confirm all your changes. Your draft is retained. Try saving again."
+});
+const KEYS = Object.keys(COPY);
+const lookup = (object, key) => key.split('.').reduce((value, part) => value && value[part], object);
+const placeholders = text => [...text.matchAll(/\{([^{}]+)\}/g)].map(match => match[1]).sort();
+const sameKeys = (object, keys) => object && JSON.stringify(Object.keys(object).sort()) === JSON.stringify([...keys].sort());
+function validatePayload(payload) {
+  if (payload?.schemaVersion !== 1 || !sameKeys(payload.english, KEYS) || !sameKeys(payload.locales, LOCALES)) throw Error('Expected the frozen seven-message reader-draft contract and five locales.');
+  for (const key of KEYS) if (payload.english[key] !== COPY[key]) throw Error('English copy changed; review before translating: ' + key);
+  for (const locale of LOCALES) {
+    const values = payload.locales[locale];
+    if (!sameKeys(values, KEYS)) throw Error('Key coverage differs: ' + locale);
+    for (const key of KEYS) {
+      const value = values[key];
+      if (typeof value !== 'string' || !value.trim() || value.includes('simplified.') || value === COPY[key]) throw Error('Missing translation: ' + locale + ' ' + key);
+      if (JSON.stringify(placeholders(value)) !== JSON.stringify(placeholders(COPY[key]))) throw Error('Placeholder mismatch: ' + locale + ' ' + key);
+      if (/[{}]/.test(value.replace(/\{[^{}]+\}/g, ''))) throw Error('Malformed placeholder: ' + locale + ' ' + key);
+    }
+  }
+  return KEYS;
+}
+function mergePack(pack, values) {
+  if (!sameKeys(values, KEYS)) throw Error('Unexpected merge keys.');
+  const next = { ...pack, simplified: { ...pack.simplified } };
+  for (const key of KEYS) {
+    const leaf = key.slice('simplified.'.length), existing = next.simplified[leaf];
+    if (existing !== undefined && existing !== values[key]) throw Error('Existing catalog value differs; resolve ownership first: ' + key);
+    next.simplified[leaf] = values[key];
+  }
+  return next;
+}
+function plan(root = ROOT) {
+  const payload = JSON.parse(fs.readFileSync(path.join(root, 'translations/reader-draft-locales.json'), 'utf8'));
+  validatePayload(payload);
+  const targets = [['ui_strings.js', payload.english], ['desktop/web-app/public/ui_strings.js', payload.english]];
+  for (const locale of LOCALES) for (const prefix of ['lang', 'desktop/web-app/public/lang']) targets.push([prefix + '/' + locale + '.js', payload.locales[locale]]);
+  const changes = [];
+  for (const [relative, values] of targets) {
+    const file = path.join(root, relative), original = fs.readFileSync(file, 'utf8'), pack = JSON.parse(original), next = mergePack(pack, values);
+    if (KEYS.some(key => lookup(pack, key) !== values[key])) changes.push({ file, original, contents: JSON.stringify(next, null, 2) + (original.endsWith('\n') ? '\n' : '') });
+  }
+  return changes;
+}
+function run(apply = false, root = ROOT) {
+  const changes = plan(root);
+  if (!apply && changes.length) throw Error(changes.length + ' catalogs need the scoped merge; run with --apply.');
+  // Validate all targets before any write; preserve concurrent edits and use per-file atomic replacement.
+  for (const change of changes) if (fs.readFileSync(change.file, 'utf8') !== change.original) throw Error('Catalog changed during merge: ' + change.file);
+  for (const change of changes) {
+    if (fs.readFileSync(change.file, 'utf8') !== change.original) throw Error('Catalog changed during merge: ' + change.file);
+    const temporary = change.file + '.reader-draft-locale-' + process.pid + '.tmp';
+    try { fs.writeFileSync(temporary, change.contents); fs.renameSync(temporary, change.file); }
+    finally { if (fs.existsSync(temporary)) fs.unlinkSync(temporary); }
+  }
+  return { keys: KEYS.length, locales: LOCALES.length, changedFiles: changes.length, mode: apply ? 'apply' : 'check' };
+}
+function parseArgs(args) {
+  if (!args.length || args.length === 1 && args[0] === '--check') return false;
+  if (args.length === 1 && args[0] === '--apply') return true;
+  throw Error('Use --check (default) or --apply.');
+}
+module.exports = { COPY, KEYS, LOCALES, lookup, placeholders, validatePayload, mergePack, plan, run, parseArgs };
+if (require.main === module) console.log(JSON.stringify(run(parseArgs(process.argv.slice(2))), null, 2));
