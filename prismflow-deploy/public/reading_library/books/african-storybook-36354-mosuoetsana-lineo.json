    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/9353.png",
      "text": "Enoa ke mosuoetsana oa ka. Lebitso la hae ke Mosuoetsana Lineo. O re rata haholo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=1",
      "sourceDigest": "sha256:1dbec0058c637e0f776b855a3100d4607a3d251708735e89bffc0e71afbdc0c9"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/9354.png",
      "text": "Mosuoetsana Lineo o re ruta alfabete. O re ruta liluma-nosi. Ke khona ho bitsa litlhaku a, e, i, o, u.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=2",
      "sourceDigest": "sha256:606b30c80baa7f31c63ed0bbb2dbbdc6701eca67995a8deabbb99182da14747e"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/9364.png",
      "text": "Mosuoetsana Lineo o re ruta mebala. Ke tseba khubelu, putsoa, tala, ts'ehla le nts'o.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=3",
      "sourceDigest": "sha256:cf5f962f6f4946f62027b784c358a3416a75e717079c5db5e31adb9990aebb99"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/9367.png",
      "text": "Ka nako ea ho robala, Mosuoetsana Lineo o oa re koietsa. O re binela lipina tse koietsang.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=4",
      "sourceDigest": "sha256:de15285b345d99313706e80ee3370d12132949538050c898aea0a742a929722c"
    },
    {
      "n": 5,
      "img": null,
      "text": "Pina e koietsang e binoa tjena: Boroko ba khauta bo fa mahlo a lona pososelo. Pososelo e le emetse ha le tsoha. Robalang baratuoa ba batle, le se ke la lla. Ke tla le binela pina e monate e koietsang.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=5",
      "sourceDigest": "sha256:d2ff28f2d6154f11d2542b2afdc2bd0b0c6ef4b7744d2a71af498756a3922867"
    },
    {
      "n": 6,
      "img": null,
      "text": "Mosuoetsana Lineo o tseba lipale tse ngata. O re phetela pale e fapaneng letsatsi ka leng la beke.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=6",
      "sourceDigest": "sha256:ffcc388e51319735acec6d59fdcc8d857aa090d2e6b34c0aaa810dc003da58d7"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/9369.png",
      "text": "Ka 'Mantaha, o re phetela lipale tsa banna ba bahale.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=7",
      "sourceDigest": "sha256:690e5bce5c22504045bf3469c2079d6b35a48a97d71e4dcf341cf045cb1e0419"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/9372.png",
      "text": "Ka Labobeli, o re phetela lipale tsa basali ba bahale.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=8",
      "sourceDigest": "sha256:0483ef574dc348a013ea898b2dbf3c4ca57bf4f597f39257c74c8a4346606128"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/9689.png",
      "text": "Ka Laboraro, o re phetela lipale ka mefuta ea lipalangoang.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=9",
      "sourceDigest": "sha256:e8e8d43c7b88aedba6718919a0bba58d844c4bb65c91f14f9d6e72b80b8a5078"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/9690.png",
      "text": "Ka Labone o re phetela lipale ka temo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=10",
      "sourceDigest": "sha256:392ce2db97263e326104329a4d05580c6d4f47408aa875c0e0f773b2fc193b20"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/9691.png",
      "text": "'Me ka Labohlano, re phetela barutuoa ba bang lipale tsa rona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=11",
      "sourceDigest": "sha256:fe8a7c9442ce4f95807b7fb1725ae9a241f40bbdbcbde5a3302da1a3a18daa91"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/9692.png",
      "text": "Mosuoetsana oa rona ke mosuoetsana ea hloahloa ka ho fetisisa lefats'eng! Ha ke hola, ke batla ho ts'oana le Mosuoetsana Lineo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36354#page=12",
      "sourceDigest": "sha256:bb944bca24470ea93df9d62138611907473ff7713ff11a0bc9b1f8fb1e369358"
    }
  ],
