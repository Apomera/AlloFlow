<div class="dinolab-field-toolbar-actions" role="group" aria-label="3D model view controls" style="display:flex;flex-wrap:wrap;gap:6px;margin-left:auto">
<button aria-pressed="true" style="padding:9px 12px;border-radius:9px;border:1px solid #14b8a6;background:rgba(20,184,166,0.15);color:var(--allo-stem-text, #f1f5f9);font-size:12.5px;font-weight:800;cursor:pointer">Pause spin</button>
<button id="dinolab-field-tools-toggle" type="button" aria-expanded="false" aria-controls="dinolab-field-drawer" style="padding:9px 12px;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:transparent;color:var(--allo-stem-text, #f1f5f9);font-size:12.5px;font-weight:800;cursor:pointer">Open field tools</button>
<button id="dinolab-field-focus-toggle" type="button" aria-pressed="false" style="padding:9px 12px;border-radius:9px;border:1px solid #15803d;background:#15803d;color:#fff;font-size:12.5px;font-weight:800;cursor:pointer">Focus model</button>
</div>
</div>
<div class="dinolab-field-workflow" role="list" aria-label="Field Station workflow" style="display:grid;grid-template-columns:repeat(4, minmax(0, 1fr));gap:6px;margin-bottom:10px">
<div role="listitem" style="min-width:0">
<button id="dinolab-field-step-explore" type="button" aria-current="step" aria-label="Step 1 Explore, Current" style="width:100%;min-height:50px;display:grid;grid-template-columns:26px minmax(0, 1fr);gap:8px;align-items:center;text-align:left;padding:7px 9px;border-radius:8px;border:1px solid #14b8a6;background:rgba(20,184,166,0.12);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;opacity:1">
<span aria-hidden="true" style="width:24px;height:24px;display:grid;place-items:center;border-radius:999px;background:#0f766e;border:1px solid #5eead4;color:#f8fafc;font-size:11px;font-weight:900">1</span>
<span>
<span style="display:block;font-size:11.5px;font-weight:900;color:var(--allo-stem-text, #f1f5f9)">Explore</span>
<span style="display:block;margin-top:1px;font-size:10.5px;color:#115e59">Current</span>
</span>
</button>
</div>
<div role="listitem" style="min-width:0">
<button id="dinolab-field-step-scan" type="button" aria-label="Step 2 Scan, Ready" style="width:100%;min-height:50px;display:grid;grid-template-columns:26px minmax(0, 1fr);gap:8px;align-items:center;text-align:left;padding:7px 9px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:pointer;opacity:1">
<span aria-hidden="true" style="width:24px;height:24px;display:grid;place-items:center;border-radius:999px;background:var(--allo-stem-panel, #1e293b);border:1px solid var(--allo-stem-border, #334155);color:var(--allo-stem-text, #f1f5f9);font-size:11px;font-weight:900">2</span>
<span>
<span style="display:block;font-size:11.5px;font-weight:900;color:var(--allo-stem-text, #f1f5f9)">Scan</span>
<span style="display:block;margin-top:1px;font-size:10.5px;color:var(--allo-stem-text-soft, #94a3b8)">Ready</span>
</span>
</button>
</div>
<div role="listitem" style="min-width:0">
<button id="dinolab-field-step-assemble" type="button" disabled="" aria-label="Step 3 Assemble, Locked" style="width:100%;min-height:50px;display:grid;grid-template-columns:26px minmax(0, 1fr);gap:8px;align-items:center;text-align:left;padding:7px 9px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:not-allowed;opacity:0.62">
<span aria-hidden="true" style="width:24px;height:24px;display:grid;place-items:center;border-radius:999px;background:var(--allo-stem-panel, #1e293b);border:1px solid var(--allo-stem-border, #334155);color:var(--allo-stem-text, #f1f5f9);font-size:11px;font-weight:900">3</span>
<span>
<span style="display:block;font-size:11.5px;font-weight:900;color:var(--allo-stem-text, #f1f5f9)">Assemble</span>
<span style="display:block;margin-top:1px;font-size:10.5px;color:var(--allo-stem-text-soft, #94a3b8)">Finish scan</span>
</span>
</button>
</div>
<div role="listitem" style="min-width:0">
<button id="dinolab-field-step-claim" type="button" disabled="" aria-label="Step 4 Claim, Locked" style="width:100%;min-height:50px;display:grid;grid-template-columns:26px minmax(0, 1fr);gap:8px;align-items:center;text-align:left;padding:7px 9px;border-radius:8px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);cursor:not-allowed;opacity:0.62">
<span aria-hidden="true" style="width:24px;height:24px;display:grid;place-items:center;border-radius:999px;background:var(--allo-stem-panel, #1e293b);border:1px solid var(--allo-stem-border, #334155);color:var(--allo-stem-text, #f1f5f9);font-size:11px;font-weight:900">4</span>
<span>
<span style="display:block;font-size:11.5px;font-weight:900;color:var(--allo-stem-text, #f1f5f9)">Claim</span>
<span style="display:block;margin-top:1px;font-size:10.5px;color:var(--allo-stem-text-soft, #94a3b8)">Finish assembly</span>
</span>
</button>
</div>
</div>
<div class="dinolab-surface-presets" role="group" aria-label="Reconstruction views" style="margin:0 0 10px;display:grid;grid-template-columns:repeat(auto-fit, minmax(118px, 1fr));gap:7px">
<button aria-pressed="true" style="min-height:54px;text-align:left;border-radius:9px;border:1px solid #14b8a6;background:rgba(20,184,166,0.18);color:var(--allo-stem-text, #f1f5f9);padding:8px 10px;cursor:pointer;box-shadow:0 0 0 2px rgba(20,184,166,0.18)">
<span style="display:block;font-size:12.5px;font-weight:900;margin-bottom:2px">Full model</span>
<span style="display:block;font-size:11px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.25">All evidence layers</span>
</button>
<button aria-pressed="false" style="min-height:54px;text-align:left;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);padding:8px 10px;cursor:pointer;box-shadow:none">
<span style="display:block;font-size:12.5px;font-weight:900;margin-bottom:2px">Life view</span>
<span style="display:block;font-size:11px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.25">Opaque surface</span>
</button>
<button aria-pressed="false" style="min-height:54px;text-align:left;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);padding:8px 10px;cursor:pointer;box-shadow:none">
<span style="display:block;font-size:12.5px;font-weight:900;margin-bottom:2px">Fossil anchors</span>
<span style="display:block;font-size:11px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.25">Bones + markers</span>
</button>
<button aria-pressed="false" style="min-height:54px;text-align:left;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);padding:8px 10px;cursor:pointer;box-shadow:none">
<span style="display:block;font-size:12.5px;font-weight:900;margin-bottom:2px">Body inference</span>
<span style="display:block;font-size:11px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.25">Soft tissue focus</span>
</button>
<button aria-pressed="false" style="min-height:54px;text-align:left;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);padding:8px 10px;cursor:pointer;box-shadow:none">
<span style="display:block;font-size:12.5px;font-weight:900;margin-bottom:2px">Scale check</span>
<span style="display:block;font-size:11px;color:var(--allo-stem-text-soft, #94a3b8);line-height:1.25">Size comparison</span>
</button>
</div>
<button id="dinolab-compare-coverings" type="button" aria-controls="dinolab-field-drawer" aria-expanded="false" style="padding:9px 12px;min-height:44px;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:700;cursor:pointer;margin-bottom:10px;text-align:left">Compare coverings: Evidence-led</button>
<div class="dinolab-presentation-controls" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:10px">
<div role="group" aria-label="Scene lighting">
<button aria-pressed="true" aria-label="Studio" style="padding:6px 12px;border-radius:999px;cursor:pointer;font-size:12px;font-weight:600;box-shadow:0 1px 4px rgba(21,128,61,0.45);border:1px solid #15803d;background:#15803d;color:#fff;white-space:nowrap;margin-right:6px;margin-bottom:6px">Studio</button>
<button aria-pressed="false" aria-label="Habitat" style="padding:6px 12px;border-radius:999px;cursor:pointer;font-size:12px;font-weight:600;box-shadow:none;border:1px solid var(--allo-stem-border, #334155);background:transparent;color:var(--allo-stem-text-soft, #94a3b8);white-space:nowrap;margin-right:6px;margin-bottom:6px">Habitat</button>
</div>
<label for="dino-scene-labels" style="font-size:12px;font-weight:700;color:var(--allo-stem-text-soft, #94a3b8)">Model labels</label>
<select id="dino-scene-labels" style="padding:9px 12px;min-height:40px;border-radius:9px;border:1px solid var(--allo-stem-border, #334155);background:var(--allo-stem-deeper, #0b1220);color:var(--allo-stem-text, #f1f5f9);font-size:12px;font-weight:700;cursor:pointer">
