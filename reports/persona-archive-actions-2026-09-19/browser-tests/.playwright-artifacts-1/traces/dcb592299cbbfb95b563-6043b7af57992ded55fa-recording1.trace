yping Practice home."}},{"k":"sr_today_s_goal_cleared","v":{"s":"Today's goal cleared."}},{"k":"sr_iep_goal_and_notes_cleared","v":{"s":"IEP goal and notes cleared."}},{"k":"sr_typing_practice_profile_exported","v":{"s":"Typing Practice profile exported."}},{"k":"sr_import_failed_choose_a_typing_practice_profile_js","v":{"s":"Import failed. Choose a Typing Practice profile JSON file."}},{"k":"sr_typing_practice_profile_imported_settings_have_be","v":{"s":"Typing Practice profile imported. Settings have been updated."}},{"k":"sr_profile_import_failed_because_the_file_could_not","v":{"s":"Profile import failed because the file could not be read."}},{"k":"sr_full_typing_practice_backup_exported","v":{"s":"Full Typing Practice backup exported."}},{"k":"sr_restore_failed_choose_a_typing_practice_backup_js","v":{"s":"Restore failed. Choose a Typing Practice backup JSON file."}},{"k":"sr_restore_failed_because_the_backup_is_empty_or_cor","v":{"s":"Restore failed because the backup is empty or corrupted."}},{"k":"sr_restore_failed_because_the_backup_uses_an_unknown","v":{"s":"Restore failed because the backup uses an unknown keyboard layout."}},{"k":"sr_backup_restore_failed_because_the_file_could_not","v":{"s":"Backup restore failed because the file could not be read."}},{"k":"sr_all_typing_practice_data_permanently_cleared","v":{"s":"All Typing Practice data permanently cleared."}},{"k":"sr_session_comparison_mode_off","v":{"s":"Session comparison mode off."}},{"k":"sr_session_comparison_mode_on_select_two_sessions","v":{"s":"Session comparison mode on. Select two sessions."}},{"k":"sr_session_note_edit_canceled","v":{"s":"Session note edit canceled."}},{"k":"sr_battle_paused_while_you_confirm_whether_to_quit","v":{"s":"Battle paused while you confirm whether to quit."}},{"k":"sr_battle_match_ended_without_saving_returning_to_th","v":{"s":"Battle match ended without saving. Returning to the Battle menu."}},{"k":"sr_quit_canceled_battle_resumed_confirmation_time_wa","v":{"