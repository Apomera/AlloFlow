pps_came_to_be","v":{"s":"How real apps came to be"}},{"k":"core_case_studies","v":{"s":"Core Case Studies"}},{"k":"extra_case_studies","v":{"s":"Extra Case Studies"}},{"k":"showcase_projects","v":{"s":"Showcase Projects"}},{"k":"free_resources","v":{"s":"Free Resources"}},{"k":"best_free_learning_resources","v":{"s":"Best free learning resources"}},{"k":"where_to_get_help","v":{"s":"Where to Get Help"}},{"k":"communities_habits_anti_patterns","v":{"s":"Communities, habits, anti-patterns"}},{"k":"open_source_licenses","v":{"s":"Open Source Licenses"}},{"k":"mit_vs_apache_vs_gpl_vs_more","v":{"s":"MIT vs Apache vs GPL vs more"}},{"k":"quick_wins","v":{"s":"Quick Wins"}},{"k":"15_high_impact_actions_for_new_develop","v":{"s":"15 high-impact actions for new developers"}},{"k":"applab_sections","v":{"s":"AppLab sections"}},{"k":"back_to_stem_lab","v":{"s":"Back to STEAM Lab"}},{"k":"applab","v":{"s":"💡 AppLab"}},{"k":"ai_mini_app_generator_coding_curriculu","v":{"s":"AI Mini-App Generator + Coding Curriculum"}},{"k":"undo","v":{"s":"Undo"}},{"k":"redo","v":{"s":"Redo"}},{"k":"toggle_code_view","v":{"s":"Toggle code view"}},{"k":"save_to_gallery","v":{"s":"Save to gallery"}},{"k":"save_to_gallery_2","v":{"s":"Save to gallery"}},{"k":"export_as_html_file","v":{"s":"Export as HTML file"}},{"k":"export_as_html_file_2","v":{"s":"Export as HTML file"}},{"k":"import_html_file","v":{"s":"Import HTML file"}},{"k":"import_html_file_2","v":{"s":"Import HTML file"}},{"k":"toggle_fullscreen","v":{"s":"Toggle fullscreen"}},{"k":"ai_pipeline_configuration","v":{"s":"⚙️ AI Pipeline Configuration"}},{"k":"configure_which_ai_agents_run_when_gen","v":{"s":"Configure which AI agents run when generating an app. Toggle agents on or off, and reorder them — order matters, because an agent placed before the agent whose output it needs has nothing to work with and will be skipped. Each agent specializes in a different aspect of software development."}},{"k":"ai_agent_pipeline_drag_to_reorder_clic","v":{"s":"AI agent pipeline — drag to reorder, click to toggle"}},{"k":"your_prompt","v":{"s":"Your Prompt"}},{"k":"required","v":{"s":"Required"}},{"k":"your_app","v":{"s":"Your App"}},{"k":"experiment_try_disabling_the_reviewer_","v":{"s":"💡 Experiment: Try disabling the Reviewer to see what happens when code isn't checked. Or disable the Architect to see how the Builder does without a plan. This teaches how software quality depends on process, not just skill."}},{"k":"what_do_you_want_to_build","v":{"s":"What do you want to build?"}},{"k":"describe_an_interactive_app_simulation","v":{"s":"Describe an interactive app, simulation, or visualization...\n\nExamples:\n• \"Interactive solar system with orbiting planets and info on click\"\n• \"Color mixing tool where you combine primary colors\"\n• \"Simple calculator with history\""}},{"k":"app_description_prompt","v":{"s":"App description prompt"}},{"k":"suggested_projects","v":{"s":"✨ Suggested Projects"}},{"k":"quick_templates","v":{"s":"📋 Quick Templates"}},{"k":"saved_apps","v":{"s":"📂 Saved Apps"}},{"k":"load","v":{"s":"Load"}},{"k":"behind_the_scenes_how_ai_built_this_ap","v":{"s":"🤖 Behind the Scenes — How AI Built This App"}},{"k":"this_app_was_built_by_a_team_of_ai_age","v":{"s":"This app was built by a team of AI agents working together — each specializing in a different aspect of software development. This is called \"agentic AI\" or \"multi-agent orchestration.\" Each agent has a specific role and passes its work to the next agent in the pipeline."}},{"k":"how_does_this_relate_to_real_software_","v":{"s":"💡 How does this relate to real software engineering?"}},{"k":"source_code","v":{"s":"</> Source Code"}},{"k":"apply_changes","v":{"s":"▶ Apply Changes"}},{"k":"reset_2","v":{"s":"↩ Reset"}},{"k":"html_source_code_editor","v":{"s":"HTML source code editor"}},{"k":"applab_preview","v":{"s":"AppLab preview"}},{"k":"enhance_add_a_dark_mode_toggle_or_make","v":{"s":"Enhance: \"add a dark mode toggle\" or \"make the particles bigger\"..."}},{"k":"enhancement_prompt","v":{"s":"Enhancement prompt"}},{"k":"start_over","v":{"s":"Start over"}},{"k":"new","v":{"s":"🗑️ New"}},{"k":"this_usually_takes_5_15_seconds","v":{"s":"This usually takes 5-15 seconds"}},{"k":"precise_prompt","v":{"s":"Precise prompt"}},{"k":"specificity_constraints_examples_perso","v":{"s":"Specificity + constraints + examples + persona aligned. Output highly predictable across runs."}},{"k":"targeted","v":{"s":"Targeted"}},{"k":"mostly_clear_ask_may_need_one_revision","v":{"s":"Mostly clear ask. May need one revision pass."}},{"k":"vague_re_runs_vary","v":{"s":"Vague — re-runs vary"}},{"k":"open_ended_ask_same_prompt_yields_diff","v":{"s":"Open-ended ask. Same prompt yields different outputs run-to-run. Acceptable for brainstorming."}},{"k":"ai_will_fill_gaps_with_plausible_but_w","v":{"s":"AI will fill gaps with plausible-but-wrong defaults. Common cause of \"AI hallucinations\"."}},{"k":"minimal_prompt","v":{"s":"Minimal prompt"}},{"k":"roll_the_dice_sometimes_the_model_surp","v":{"s":"Roll the dice. Sometimes the model surprises you; usually it produces generic output."}},{"k":"prompt_craft_inquiry_predict_the_outpu","v":{"s":"🔬 Prompt-Craft Inquiry — Predict the Output Variance"}},{"k":"set_how_much_specificity_constraints_e","v":{"s":"Set how much specificity, constraints, examples, and persona you put into a prompt. Predict how reliable the AI output will be. No score, no reveal."}},{"k":"specificity_1_10","v":{"s":"Specificity (1-10)"}},{"k":"constraints_stated_1_10","v":{"s":"Constraints stated (1-10)"}},{"k":"example_count_0_5","v":{"s":"Example count (0-5)"}},{"k":"persona_role_clarity","v":{"s":"Persona / role clarity"}},{"k":"log_this_prompt_craft_profile","v":{"s":"📋 Log this prompt-craft profile"}},{"k":"reset_3","v":{"s":"Reset"}},{"k":"your_hypothesis_do_examples_or_constra","v":{"s":"Your hypothesis (do examples or constraints reduce variance more?)"}},{"k":"e_g_one_well_chosen_example_beats_five","v":{"s":"e.g., one well-chosen example beats five vague constraints because it pins down style + structure simultaneously..."}},{"k":"i_m_stuck_show_open_questions","v":{"s":"🤔 I'm stuck — show open questions"}},{"k":"open_questions_no_answer_key","v":{"s":"Open questions (no answer key)"}},{"k":"why_does_adding_one_good_example_often","v":{"s":"Why does adding one good example often beat adding five constraints?"}},{"k":"a_vague_prompt_is_fine_for_what_tasks_","v":{"s":"A vague prompt is fine for what tasks? (Hint: divergent vs convergent thinking.)"}},{"k":"how_does_persona_you_are_an_expert_x_c","v":{"s":"How does persona (\"you are an expert X\") change output style — and when is it manipulative?"}},{"k":"when_is_brittleness_actually_good_hint","v":{"s":"When is brittleness actually GOOD? (Hint: reproducible scientific outputs.)"}},{"k":"i_can_explain_why_this_prompt_craft_pr","v":{"s":"I can explain why this prompt-craft profile yields this output variance."}},{"k":"explain_in_your_own_words","v":{"s":"Explain in your own words..."}},{"k":"inquiry_widget_no_score_no_reveal_no_a","v":{"s":"Inquiry widget — no score, no reveal, no answer dump. Quality/brittleness indices are heuristics; real prompt engineering depends on model, temperature, system message, and task type. See OpenAI/Anthropic prompt-engineering docs."}},{"k":"hypothesis_input","v":{"s":"Prompt variance hypothesis"}},{"k":"explanation_input","v":{"s":"Prompt variance explanation"}},{"k":"ai_agent_pipeline_reorder_and_toggle","v":{"s":"AI agent pipeline — use the arrow buttons to reorder, and the ON/OFF button to toggle each agent"}},{"k":"experiment_try_disabling_the_reviewer_v2","v":{"s":"💡 Experiment: Turn the Reviewer off to see what ships when nobody checks the code. Move the Architect after the Builder and watch it get skipped — a plan that arrives after the work is done cannot change anything. Order and staffing are both part of software quality, not just skill."}},{"k":"multi_agent_run_takes_a_few_minutes","v":{"s":"The Architect splits your app into sections and several agents work on them at once. This usually takes a few minutes."}},{"k":"single_build_takes_under_a_minute","v":{"s":"Single-build mode — this usually takes under a minute."}},{"k":"assembler","v":{"s":"Assembler"}},{"k":"automatic","v":{"s":"Automatic"}},{"k":"cancel","v":{"s":"✕ Cancel"}},{"k":"cancel_generation","v":{"s":"Cancel generation"}},{"k":"warn_architect_after_builder","v":{"s":"Runs after the Builder — plan arrives too late, so it is skipped"}},{"k":"warn_reviewer_before_builder","v":{"s":"Runs before the Builder — no code exists yet, so it is skipped"}},{"k":"warn_fixer_no_reviewer","v":{"s":"Needs the Reviewer — with no issue list there is nothing to fix"}},{"k":"warn_fixer_before_reviewer","v":{"s":"Runs before the Reviewer — no issue list yet, so it is skipped"}},{"k":"import_html","v":{"s":"📄 Import HTML"}},{"k":"fix_these_errors","v":{"s":"🔧 Fix these"}},{"k":"fix_these_errors_with_ai","v":{"s":"Fix these errors with AI"}},{"k":"dismiss_errors","v":{"s":"Dismiss errors"}},{"k":"toggle_changes_view","v":{"s":"Toggle changes view"}},{"k":"show_what_changed","v":{"s":"Show what changed in the last step"}},{"k":"no_earlier_version_yet","v":{"s":"No earlier version to compare against yet"}},{"k":"what_changed_in_this_step","v":{"s":"± What changed in this step"}},{"k":"version_x_of_y","v":{"s":"Version "}},{"k":"diff_too_large","v":{"s":"This step rewrote too much of the file to show line by line — "}},{"k":"no_line_changes","v":{"s":"No line-level changes."}},{"k":"diff_teaching_note","v":{"s":"Reading a diff is how developers review each other's work. Green lines were added, red lines were removed, and everything else stayed the same. If an AI edit changed more than you asked for, this is where you would spot it."}}],"id":475}},{"k":"aquarium","v":{"o":[{"k":"a11y_3d_camera_presets","v":{"s":"3D camera presets"}},{"k":"sr_previous_habitat_layout_restored","v":{"s":"Previous habitat layout restored."}},{"k":"sr_habitat_preset_applied_with_three_editable_object","v":{"s":"Habitat preset applied with three editable objects."}},{"k":"sr_prediction_recorded_build_one_habitat_interventio","v":{"s":"Prediction recorded. Build one habitat intervention, then lock it for observation."}},{"k":"a11y_aquarium_learning_path_progress","v":{"s":"Aquarium learning path progress"}},{"k":"a11y_nitrogen_cycle_trends","v":{"s":"Nitrogen cycle trends"}},{"k":"a11y_close_chemistry_explanation","v":{"s":"Close chemistry explanation"}},{"k":"a11y_exchange_time_view","v":{"s":"Exchange time view"}},{"k":"a11y_focus_an_ecosystem_role","v":{"s":"Focus an ecosystem role"}},{"k":"a11y_closed_loop_aquarium_diagram_fish_use_oxygen_an","v":{"s":"Closed-loop aquarium diagram. Fish use oxygen and release carbon dioxide and ammonia. Bacteria convert ammonia and nitrite into nitrate. Plants use nitrate and carbon dioxide, produce oxygen by day, compete with algae, and provide shelter. Grazing organisms consume algae."}},{"k":"a11y_matter_source_and_sink_budgets_for_the_last_aqu","v":{"s":"Matter source and sink budgets for the last aquarium-hour tick"}},{"k":"a11y_filter_living_system_vitality","v":{"s":"Filter living system vitality"}},{"k":"a11y_living_system_vitality_totals","v":{"s":"Living system vitality totals"}},{"k":"a11y_filtered_organism_vitality_and_plant_health","v":{"s":"Filtered organism vitality and plant health"}},{"k":"a11y_ecosystem_comparison_baseline_controls","v":{"s":"Ecosystem comparison baseline controls"}},{"k":"a11y_controlled_investigation_progress","v":{"s":"Controlled investigation progress"}},{"k":"a11y_changes_since_the_marked_ecosystem_baseline","v":{"s":"Changes since the marked ecosystem baseline"}},{"k":"a11y_predicted_and_observed_ecosystem_directions","v":{"s":"Predicted and observed ecosystem directions"}},{"k":"a11y_organism_plant_relationship_totals","v":{"s":"Organism plant relationship totals"}},{"k":"a11y_individual_organism_relationships_with_aquarium","v":{"s":"Individual organism relationships with aquarium plants"}},{"k":"a11y_close_plant_field_guide","v":{"s":"Close plant field guide"}},{"k":"a11y_current_habitat_scores","v":{"s":"Current habitat scores"}},{"k":"a11y_habitat_field_missions","v":{"s":"Habitat field missions"}},{"k":"a11y_mission_learning_loop_stages","v":{"s":"Mission learning-loop stages"}},{"k":"a11y_choose_mission_prediction","v":{"s":"Choose mission prediction"}},{"k":"a11y_mission_observation_progress","v":{"s":"Mission observation progress"}},{"k":"a11y_mission_success_criteria","v":{"s":"Mission success criteria"}},{"k":"a11y_habitat_mission_prediction_revision","v":{"s":"Habitat mission prediction revision"}},{"k":"a11y_habitat_view_mode","v":{"s":"Habitat view mode"}},{"k":"a11y_habitat_ecological_overlay","v":{"s":"Habitat ecological overlay"}},{"k":"a11y_habitat_object_catalog","v":{"s":"Habitat object catalog"}},{"k":"a11y_editable_aquarium_habitat_floor_plan_select_a_s","v":{"s":"Editable aquarium habitat floor plan. Select a structure, then use the movement controls."}},{"k":"a11y_filter_interaction_pathways_by_modeled_strength","v":{"s":"Filter interaction pathways by modeled strength"}},{"k":"a11y_interaction_network_diagnostic","v":{"s":"Interaction network diagnostic"}},{"k":"a11y_average_interaction_pathway_strength","v":{"s":"Average interaction pathway strength"}},{"k":"a11y_interaction_strength_distribution","v":{"s":"Interaction strength distribution"}},{"k":"a11y_interaction_experiment_prompt","v":{"s":"Interaction experiment prompt"}},{"k":"a11y_interaction_baseline_comparison","v":{"s":"Interaction baseline comparison"}},{"k":"a11y_interaction_diagram_legend","v":{"s":"Interaction diagram legend"}},{"k":"a11y_interaction_direction_and_strength_key","v":{"s":"Interaction direction and strength key"}},{"k":"a11y_visible_organism_and_plant_interactions","v":{"s":"Visible organism and plant interactions"}},{"k":"a11y_endpoint_vitality","v":{"s":"Endpoint vitality"}},{"k":"a11y_selected_habitat_object_inspector","v":{"s":"Selected habitat object inspector"}},{"k":"a11y_move_selected_habitat_object","v":{"s":"Move selected habitat object"}},{"k":"a11y_move_toward_the_back","v":{"s":"Move toward the back"}},{"k":"a11y_move_left","v":{"s":"Move left"}},{"k":"a11y_move_right","v":{"s":"Move right"}},{"k":"a11y_move_toward_the_front","v":{"s":"Move toward the front"}},{"k":"a11y_habitat_structures","v":{"s":"Habitat structures"}},{"k":"a11y_reversible_habitat_design_forecasts","v":{"s":"Reversible habitat design forecasts"}},{"k":"a11y_habitat_fit_by_organism","v":{"s":"Habitat fit by organism"}},{"k":"a11y_filter_living_stock_by_organism_type","v":{"s":"Filter living stock by organism type"}},{"k":"a11y_organisms_currently_stocked","v":{"s":"Organisms currently stocked"}},{"k":"a11y_aquarium_equipment_systems","v":{"s":"Aquarium equipment systems"}},{"k":"a11y_aquarium_maintenance_planner","v":{"s":"Aquarium maintenance planner"}},{"k":"a11y_weekly_water_change_schedule","v":{"s":"Weekly water change schedule"}},{"k":"a11y_water_change_service_history","v":{"s":"Water change service history"}},{"k":"a11y_water_change_percentage","v":{"s":"Water change percentage"}},{"k":"a11y_aquarium_sound_volume","v":{"s":"Aquarium sound volume"}},{"k":"a11y_close_feeding_report","v":{"s":"Close feeding report"}},{"k":"a11y_dismiss_aquarium_event","v":{"s":"Dismiss aquarium event"}},{"k":"a11y_dismiss_aquarium_event_outcome","v":{"s":"Dismiss aquarium event outcome"}},{"k":"a11y_aquarium_event_log","v":{"s":"Aquarium event log"}},{"k":"a11y_reference_categories","v":{"s":"Reference categories"}},{"k":"bony_fish_osteichthyes","v":{"s":"Bony Fish (Osteichthyes)"}},{"k":"dorsal_fin","v":{"s":"Dorsal Fin"}},{"k":"stabilizes_the_fish_during_swimming_pr","v":{"s":"Stabilizes the fish during swimming, preventing rolling. Contains bony spines (rays) connected by thin membrane. Erected when alarmed."}},{"k":"caudal_fin_tail","v":{"s":"Caudal Fin (Tail)"}},{"k":"primary_propulsion_organ_shape_determi","v":{"s":"Primary propulsion organ. Shape determines swimming style — forked tails are built for speed, rounded for maneuverability."}},{"k":"pectoral_fins","v":{"s":"Pectoral Fins"}},{"k":"paired_fins_used_for_steering_braking_","v":{"s":"Paired fins used for steering, braking, and hovering. Act like hydrofoils. Can be fanned out to appear larger to rivals."}},{"k":"anal_pelvic_fins","v":{"s":"Anal/Pelvic Fins"}},{"k":"ventral_stabilizers_that_prevent_pitch","v":{"s":"Ventral stabilizers that prevent pitching and yawing. Pelvic fins evolved from ancestral limb buds."}},{"k":"gill_cover_operculum","v":{"s":"Gill Cover (Operculum)"}},{"k":"bony_plate_protecting_delicate_gill_fi","v":{"s":"Bony plate protecting delicate gill filaments. Pumps water over gills by rhythmically opening and closing."}},{"k":"lateral_line","v":{"s":"Lateral Line"}},{"k":"a_row_of_sensory_pores_detecting_vibra","v":{"s":"A row of sensory pores detecting vibrations and pressure changes. Allows fish to sense movement, currents, and obstacles in total darkness."}},{"k":"spherical_lens_focuses_light_most_fish","v":{"s":"Spherical lens focuses light. Most fish see in color and some perceive UV light. No eyelids — cornea is bathed in water."}},{"k":"swim_bladder_internal","v":{"s":"Swim Bladder (internal)"}},{"k":"gas_filled_organ_for_buoyancy_control_","v":{"s":"Gas-filled organ for buoyancy control. Fish add or remove gas to hover at any depth without expending energy."}},{"k":"scales_mucus","v":{"s":"Scales & Mucus"}},{"k":"overlapping_cycloid_or_ctenoid_scales_","v":{"s":"Overlapping cycloid or ctenoid scales covered in antibacterial mucus. Reduces hydrodynamic drag by up to 65%."}},{"k":"cartilaginous_fish_chondrichthyes","v":{"s":"Cartilaginous Fish (Chondrichthyes)"}},{"k":"dorsal_fin_2","v":{"s":"Dorsal Fin"}},{"k":"the_iconic_triangular_fin_provides_sta","v":{"s":"The iconic triangular fin provides stability. Made entirely of cartilage — sharks have no true bones anywhere in their body."}},{"k":"gill_slits_5","v":{"s":"Gill Slits (5)"}},{"k":"five_exposed_gill_slits_with_no_protec","v":{"s":"Five exposed gill slits with no protective cover. Sharks must swim to push water over gills — they cannot pump water like bony fish."}},{"k":"ampullae_of_lorenzini","v":{"s":"Ampullae of Lorenzini"}},{"k":"jelly_filled_pores_on_the_snout_that_d","v":{"s":"Jelly-filled pores on the snout that detect electrical fields as weak as 5 nanovolts — enough to sense a prey heartbeat buried in sand."}},{"k":"heterocercal_tail","v":{"s":"Heterocercal Tail"}},{"k":"upper_lobe_is_longer_generating_upward","v":{"s":"Upper lobe is longer, generating upward lift as the shark swims. This compensates for the lack of a swim bladder."}},{"k":"pectoral_fins_2","v":{"s":"Pectoral Fins"}},{"k":"rigid_wing_like_fins_that_generate_lif","v":{"s":"Rigid, wing-like fins that generate lift. Unlike bony fish, shark pectoral fins cannot fold flat — they act as airplane wings."}},{"k":"dermal_denticles","v":{"s":"Dermal Denticles"}},{"k":"tooth_like_scales_placoid_scales_that_","v":{"s":"Tooth-like scales (placoid scales) that channel water flow. Surface texture reduces drag by 8% — inspired NASA swimsuit designs."}},{"k":"cartilage_skeleton","v":{"s":"Cartilage Skeleton"}},{"k":"skeleton_is_100_cartilage_half_the_den","v":{"s":"Skeleton is 100% cartilage — half the density of bone. This makes sharks lighter and more agile, but fossils only preserve teeth and spines."}},{"k":"replaceable_teeth","v":{"s":"Replaceable Teeth"}},{"k":"teeth_grow_in_rows_on_a_conveyor_belt_","v":{"s":"Teeth grow in rows on a conveyor-belt jaw. A single shark may produce 30,000+ teeth in its lifetime, replacing them every 1-2 weeks."}},{"k":"cnidarian_medusa_form","v":{"s":"Cnidarian (Medusa Form)"}},{"k":"bell_medusa","v":{"s":"Bell (Medusa)"}},{"k":"the_dome_shaped_body_contracts_rhythmi","v":{"s":"The dome-shaped body contracts rhythmically for jet propulsion. Made of mesoglea — 95% water with collagen fibers for elasticity."}},{"k":"tentacles","v":{"s":"Tentacles"}},{"k":"trailing_appendages_lined_with_cnidocy","v":{"s":"Trailing appendages lined with cnidocytes — stinging cells that fire nematocysts in 700 nanoseconds, among the fastest events in nature."}},{"k":"oral_arms","v":{"s":"Oral Arms"}},{"k":"frilly_appendages_near_the_mouth_that_","v":{"s":"Frilly appendages near the mouth that capture food particles. In some species they fuse to form a feeding curtain."}},{"k":"gastrovascular_cavity","v":{"s":"Gastrovascular Cavity"}},{"k":"a_central_cavity_serves_as_both_stomac","v":{"s":"A central cavity serves as both stomach and circulatory system. One opening functions as both mouth and anus."}},{"k":"nerve_net","v":{"s":"Nerve Net"}},{"k":"no_brain_no_central_nervous_system_a_d","v":{"s":"No brain, no central nervous system. A diffuse nerve net coordinates swimming contractions. Some species have rhopalia (light/gravity sensors)."}},{"k":"radial_canals","v":{"s":"Radial Canals"}},{"k":"channels_radiating_from_the_central_ca","v":{"s":"Channels radiating from the central cavity to the bell margin, distributing nutrients. Their radial symmetry predates bilateral body plans by 200M+ years."}},{"k":"cnidarian_polyp_form_sea_anemone","v":{"s":"Cnidarian (Polyp Form — Sea Anemone)"}},{"k":"tentacles_2","v":{"s":"Tentacles"}},{"k":"ring_of_flexible_tentacles_armed_with_","v":{"s":"Ring of flexible tentacles armed with cnidocytes (stinging cells). Used to capture prey — small fish and shrimp are paralyzed by nematocyst venom and guided to the mouth."}},{"k":"oral_disc","v":{"s":"Oral Disc"}},{"k":"flat_upper_surface_surrounding_the_cen","v":{"s":"Flat upper surface surrounding the central mouth. The mouth is the only opening — it serves as both entrance for food and exit for waste, identical to the jellyfish body plan."}},{"k":"column","v":{"s":"Column"}},{"k":"muscular_cylindrical_body_wall_made_of","v":{"s":"Muscular cylindrical body wall made of two tissue layers (ectoderm and endoderm) separated by mesoglea. Can contract to retract tentacles when threatened."}},{"k":"pedal_disc","v":{"s":"Pedal Disc"}},{"k":"adhesive_base_that_anchors_the_anemone","v":{"s":"Adhesive base that anchors the anemone to rocks, shells, or coral. Despite appearing fixed, anemones can slowly glide across surfaces at ~1 cm/hour."}},{"k":"cnidocytes","v":{"s":"Cnidocytes"}},{"k":"specialized_stinging_cells_concentrate","v":{"s":"Specialized stinging cells concentrated on tentacles. Each cnidocyte fires a barbed nematocyst in under 700 nanoseconds — one of the fastest mechanical processes in nature."}},{"k":"zooxanthellae","v":{"s":"Zooxanthellae"}},{"k":"symbiotic_photosynthetic_algae_living_","v":{"s":"Symbiotic photosynthetic algae living inside the tissue. They provide up to 90% of the anemone's energy via photosynthesis, in exchange for shelter and nutrients."}},{"k":"crustacean_arthropoda","v":{"s":"Crustacean (Arthropoda)"}},{"k":"carapace_exoskeleton","v":{"s":"Carapace (Exoskeleton)"}},{"k":"hardened_shell_of_chitin_and_calcium_c","v":{"s":"Hardened shell of chitin and calcium carbonate. Must be molted (shed) to grow — the animal is soft and vulnerable for hours after."}},{"k":"antennae_2_pairs","v":{"s":"Antennae (2 pairs)"}},{"k":"long_antennae_detect_touch_chemicals_a","v":{"s":"Long antennae detect touch, chemicals, and water currents. Short antennules sense gravity and balance via statocysts."}},{"k":"compound_eyes","v":{"s":"Compound Eyes"}},{"k":"mounted_on_stalks_with_thousands_of_om","v":{"s":"Mounted on stalks with thousands of ommatidia (individual lenses). Excellent motion detection. Some species see polarized and UV light."}},{"k":"walking_legs_pereopods","v":{"s":"Walking Legs (Pereopods)"}},{"k":"five_pairs_of_jointed_walking_legs_fir","v":{"s":"Five pairs of jointed walking legs. First pair often modified into claws (chelipeds) for defense, feeding, and signaling."}},{"k":"swimmerets_pleopods","v":{"s":"Swimmerets (Pleopods)"}},{"k":"small_paddle_like_appendages_under_the","v":{"s":"Small paddle-like appendages under the abdomen. Used for swimming, carrying eggs, and circulating water over abdominal gills."}},{"k":"gills_under_carapace","v":{"s":"Gills (under carapace)"}},{"k":"feathery_gills_sit_in_chambers_under_t","v":{"s":"Feathery gills sit in chambers under the carapace. Appendages called scaphognathites act as pumps to draw water through."}},{"k":"cephalopod_mollusca","v":{"s":"Cephalopod (Mollusca)"}},{"k":"mantle","v":{"s":"Mantle"}},{"k":"muscular_body_housing_all_organs_contr","v":{"s":"Muscular body housing all organs. Contracts forcefully to jet water through the siphon, achieving speeds up to 40 km/h in squids."}},{"k":"arms_8_with_suckers","v":{"s":"Arms (8) with Suckers"}},{"k":"eight_arms_lined_with_suckers_containi","v":{"s":"Eight arms lined with suckers containing chemoreceptors — they can taste what they touch. Each sucker can exert tremendous grip force."}},{"k":"siphon_funnel","v":{"s":"Siphon (Funnel)"}},{"k":"a_muscular_nozzle_for_jet_propulsion_w","v":{"s":"A muscular nozzle for jet propulsion. Water is drawn into the mantle cavity, then expelled forcefully. Also ejects ink for escape."}},{"k":"camera_eyes","v":{"s":"Camera Eyes"}},{"k":"evolved_independently_from_vertebrate_","v":{"s":"Evolved independently from vertebrate eyes but are structurally similar. No blind spot (unlike human eyes). Can see polarized light."}},{"k":"chromatophores","v":{"s":"Chromatophores"}},{"k":"thousands_of_pigment_filled_sacs_that_","v":{"s":"Thousands of pigment-filled sacs that expand/contract in milliseconds. Controlled directly by the brain for instant camouflage, signaling, and hypnotic hunting displays."}},{"k":"three_hearts","v":{"s":"Three Hearts"}},{"k":"two_branchial_hearts_push_blood_throug","v":{"s":"Two branchial hearts push blood through the gills. One systemic heart circulates oxygenated blood. Blood is copper-based (hemocyanin) — it is blue."}},{"k":"beak","v":{"s":"Beak"}},{"k":"a_hard_parrot_like_beak_of_chitin_the_","v":{"s":"A hard, parrot-like beak of chitin — the only rigid structure. An octopus can squeeze through any gap larger than its beak."}},{"k":"echinoderm_asteroidea","v":{"s":"Echinoderm (Asteroidea)"}},{"k":"water_vascular_system","v":{"s":"Water Vascular System"}},{"k":"a_hydraulic_network_unique_to_echinode","v":{"s":"A hydraulic network unique to echinoderms. Seawater enters through the madreporite and fills radial canals powering hundreds of tube feet."}},{"k":"tube_feet","v":{"s":"Tube Feet"}},{"k":"tiny_suction_cup_appendages_powered_by","v":{"s":"Tiny suction-cup appendages powered by hydraulic pressure. Coordinated movement can pry open clam shells with sustained force of 5+ kg."}},{"k":"madreporite","v":{"s":"Madreporite"}},{"k":"a_small_sieve_plate_visible_as_a_pale_","v":{"s":"A small sieve plate (visible as a pale dot) that filters seawater into the water vascular system. Located off-center on the aboral surface."}},{"k":"eyespots","v":{"s":"Eyespots"}},{"k":"simple_photoreceptors_at_each_arm_tip_","v":{"s":"Simple photoreceptors at each arm tip — bright spots visible at extremities. Cannot form images but detect light direction and intensity."}},{"k":"pentaradial_symmetry","v":{"s":"Pentaradial Symmetry"}},{"k":"five_fold_body_plan_adults_develop_thi","v":{"s":"Five-fold body plan. Adults develop this from bilateral larvae — a unique metamorphosis among animals. No front, back, or sides."}},{"k":"regeneration_zone","v":{"s":"Regeneration Zone"}},{"k":"can_regrow_entire_arms_from_the_centra","v":{"s":"Can regrow entire arms from the central disc. Some species regenerate a complete animal from a single arm. Process takes months to years."}},{"k":"marine_mammal_cetacea","v":{"s":"Marine Mammal (Cetacea)"}},{"k":"blowhole","v":{"s":"Blowhole"}},{"k":"modified_nostril_s_on_top_of_skull_bre","v":{"s":"Modified nostril(s) on top of skull. Breathing is voluntary — cetaceans must consciously surface. Only half the brain sleeps at a time (unihemispheric sleep)."}},{"k":"melon_echolocation","v":{"s":"Melon (Echolocation)"}},{"k":"a_fatty_oil_filled_lens_in_the_forehea","v":{"s":"A fatty, oil-filled lens in the forehead that focuses outgoing clicks into a directional beam. Returning echoes are received through the lower jaw."}},{"k":"dorsal_fin_3","v":{"s":"Dorsal Fin"}},{"k":"dense_connective_tissue_no_bone_used_f","v":{"s":"Dense connective tissue (no bone). Used for thermoregulation — blood vessels release or retain heat. Shape and nicks identify individuals."}},{"k":"fluke_tail","v":{"s":"Fluke (Tail)"}},{"k":"horizontal_tail_moved_up_and_down_by_p","v":{"s":"Horizontal tail moved up-and-down by powerful back muscles (not side-to-side like fish). No bones — pure collagen and connective tissue."}},{"k":"pectoral_flippers","v":{"s":"Pectoral Flippers"}},{"k":"modified_forelimbs_containing_humerus_","v":{"s":"Modified forelimbs containing humerus, radius, ulna, and finger bones — the same skeletal plan as a human arm, adapted for steering and braking."}},{"k":"blubber_layer","v":{"s":"Blubber Layer"}},{"k":"thick_subcutaneous_fat_providing_insul","v":{"s":"Thick subcutaneous fat providing insulation, energy storage, buoyancy, and streamlining. Up to 50 cm thick in Arctic species like bowhead whales."}},{"k":"sea_turtle_testudines","v":{"s":"Sea Turtle (Testudines)"}},{"k":"carapace_shell","v":{"s":"Carapace (Shell)"}},{"k":"fused_vertebrae_and_ribs_covered_in_ke","v":{"s":"Fused vertebrae and ribs covered in keratinous scutes. Unlike land turtles, sea turtles cannot retract into their shell — it is streamlined for swimming."}},{"k":"front_flippers","v":{"s":"Front Flippers"}},{"k":"elongated_forelimbs_used_for_powerful_","v":{"s":"Elongated forelimbs used for powerful underwater flight. Leatherbacks can dive to 1,280 meters. Front flippers generate all thrust."}},{"k":"rear_flippers","v":{"s":"Rear Flippers"}},{"k":"shorter_and_rounder_than_front_flipper","v":{"s":"Shorter and rounder than front flippers. Used as rudders for steering. Females use them to dig egg chambers on nesting beaches."}},{"k":"salt_glands","v":{"s":"Salt Glands"}},{"k":"orbital_glands_near_the_eyes_excrete_c","v":{"s":"Orbital glands near the eyes excrete concentrated salt — this is why sea turtles appear to cry. Excreted salt is twice as concentrated as seawater."}},{"k":"scute_pattern","v":{"s":"Scute Pattern"}},{"k":"keratinous_plates_in_species_specific_","v":{"s":"Keratinous plates in species-specific arrangements. The pattern helps identify species. Growth rings on scutes record age like tree rings."}},{"k":"magnetic_navigation","v":{"s":"Magnetic Navigation"}},{"k":"magnetite_crystals_in_the_brain_create","v":{"s":"Magnetite crystals in the brain create an internal compass. Hatchlings imprint their natal beach's unique magnetic signature and return decades later to nest."}},{"k":"betta_labyrinth_fish","v":{"s":"Betta (Labyrinth Fish)"}},{"k":"flowing_dorsal_fin","v":{"s":"Flowing Dorsal Fin"}},{"k":"elaborate_sail_like_dorsal_fin_used_fo","v":{"s":"Elaborate, sail-like dorsal fin used for display. In male bettas, it can span nearly the entire body length. Breeding selects for longer, more colorful fins."}},{"k":"caudal_veil_tail","v":{"s":"Caudal Veil (Tail)"}},{"k":"dramatic_fan_shaped_tail_with_delicate","v":{"s":"Dramatic fan-shaped tail with delicate membrane. Multiple tail types exist: halfmoon, crowntail, plakat, veiltail. Susceptible to fin rot in poor water."}},{"k":"pectoral_fins_3","v":{"s":"Pectoral Fins"}},{"k":"small_rounded_fins_used_for_slow_scull","v":{"s":"Small, rounded fins used for slow sculling movements. Bettas hover and maneuver precisely rather than swimming fast."}},{"k":"labyrinth_organ","v":{"s":"Labyrinth Organ"}},{"k":"a_folded_lung_like_organ_above_the_gil","v":{"s":"A folded, lung-like organ above the gills that extracts oxygen from air. This allows bettas to survive in shallow, oxygen-poor water like rice paddies."}},{"k":"ventral_fins_display","v":{"s":"Ventral Fins (Display)"}},{"k":"long_trailing_ventral_fins_used_primar","v":{"s":"Long, trailing ventral fins used primarily for signaling. Males flare ventral fins alongside their gill covers when challenging rivals."}},{"k":"opercular_flare","v":{"s":"Opercular Flare"}},{"k":"gill_covers_extend_outward_to_display_","v":{"s":"Gill covers extend outward to display bright-colored gill membranes. This threat display makes the fish appear larger and more intimidating to rivals."}},{"k":"seahorse_syngnathidae","v":{"s":"Seahorse (Syngnathidae)"}},{"k":"coronet_crown","v":{"s":"Coronet (Crown)"}},{"k":"a_bony_crest_unique_to_each_individual","v":{"s":"A bony crest unique to each individual — like a fingerprint. Used for species identification. Grows more elaborate with age."}},{"k":"prehensile_tail","v":{"s":"Prehensile Tail"}},{"k":"muscular_gripping_tail_used_to_anchor_","v":{"s":"Muscular, gripping tail used to anchor to seagrass and coral. Has a square cross-section for superior grip strength — unique among fish."}},{"k":"brood_pouch_male","v":{"s":"Brood Pouch (male)"}},{"k":"males_carry_eggs_in_a_ventral_pouch_th","v":{"s":"Males carry eggs in a ventral pouch. The female deposits eggs during an elaborate upright dance. Males nourish embryos for 2-4 weeks before giving birth."}},{"k":"dorsal_fin_4","v":{"s":"Dorsal Fin"}},{"k":"tiny_translucent_dorsal_fin_that_beats","v":{"s":"Tiny, translucent dorsal fin that beats up to 35 times per second. This is the primary means of propulsion — making seahorses the slowest fish in the ocean."}},{"k":"tubular_snout","v":{"s":"Tubular Snout"}},{"k":"elongated_snout_acts_as_a_pipette_seah","v":{"s":"Elongated snout acts as a pipette — seahorses slurp up tiny crustaceans with a rapid head snap. Can strike and ingest prey in under 1 millisecond."}},{"k":"bony_armor_plates","v":{"s":"Bony Armor Plates"}},{"k":"body_encased_in_bony_rings_instead_of_","v":{"s":"Body encased in bony rings instead of scales. Provides excellent protection but limits flexibility. Few predators can digest the bony exterior."}},{"k":"pufferfish_tetraodontidae","v":{"s":"Pufferfish (Tetraodontidae)"}},{"k":"inflation_sac","v":{"s":"Inflation Sac"}},{"k":"a_highly_elastic_stomach_that_can_infl","v":{"s":"A highly elastic stomach that can inflate with water (or air) to 3x normal size. This makes the fish nearly impossible for predators to swallow."}},{"k":"fused_beak_teeth","v":{"s":"Fused Beak Teeth"}},{"k":"four_fused_teeth_form_a_strong_beak_th","v":{"s":"Four fused teeth form a strong beak that can crack open shellfish, sea urchins, and crabs. Teeth grow continuously — must eat hard food to keep them trimmed."}},{"k":"spines_when_inflated","v":{"s":"Spines (when inflated)"}},{"k":"short_spines_embedded_in_the_skin_beco","v":{"s":"Short spines embedded in the skin become erect when inflated. Combined with inflation, they create a spiky ball that deters all but the most determined predators."}},{"k":"large_eyes","v":{"s":"Large Eyes"}},{"k":"independently_moving_eyes_provide_near","v":{"s":"Independently moving eyes provide near 360° vision. Puffers are considered among the most intelligent fish — they recognize their owners and can learn tricks."}},{"k":"tetrodotoxin_organs","v":{"s":"Tetrodotoxin Organs"}},{"k":"liver_ovaries_and_skin_contain_tetrodo","v":{"s":"Liver, ovaries, and skin contain tetrodotoxin — 1,200× more lethal than cyanide. Produced by symbiotic bacteria. There is no antidote."}},{"k":"caudal_fin_rudder","v":{"s":"Caudal Fin (Rudder)"}},{"k":"small_tail_fin_for_slow_precise_maneuv","v":{"s":"Small tail fin for slow, precise maneuvering. Dorsal and anal fins do most of the work. Puffers swim awkwardly but compensate with excellent defenses."}},{"k":"deep_sea_anglerfish_lophiiformes","v":{"s":"Deep-Sea Anglerfish (Lophiiformes)"}},{"k":"bioluminescent_lure_esca","v":{"s":"Bioluminescent Lure (Esca)"}},{"k":"a_modified_dorsal_fin_spine_illicium_t","v":{"s":"A modified dorsal fin spine (illicium) tipped with a glowing bulb. Contains symbiotic bioluminescent bacteria. Attracts prey in the pitch-black deep sea."}},{"k":"enormous_mouth","v":{"s":"Enormous Mouth"}},{"k":"hinged_jaw_can_open_to_120_allowing_th","v":{"s":"Hinged jaw can open to 120°, allowing the anglerfish to swallow prey up to twice its own body size. Inward-pointing teeth prevent escape."}},{"k":"enormous_eye","v":{"s":"Enormous Eye"}},{"k":"large_forward_facing_eyes_sensitized_t","v":{"s":"Large, forward-facing eyes sensitized to detect bioluminescent flashes. In many species, eyes are adapted to see blue-green light wavelengths only."}},{"k":"expandable_stomach","v":{"s":"Expandable Stomach"}},{"k":"highly_distensible_stomach_can_accommo","v":{"s":"Highly distensible stomach can accommodate meals larger than the anglerfish itself. Meals are rare in the deep sea, so storage capacity is critical."}},{"k":"parasitic_male_attached","v":{"s":"Parasitic Male (attached)"}},{"k":"males_are_tiny_10_of_female_size_they_","v":{"s":"Males are tiny (<10% of female size). They bite the female and fuse permanently, becoming a parasite that provides sperm on demand."}},{"k":"pressure_adapted_body","v":{"s":"Pressure-Adapted Body"}},{"k":"gelatinous_flesh_with_minimal_bone_lac","v":{"s":"Gelatinous flesh with minimal bone. Lack of a swim bladder prevents implosion at extreme depths (1,000-4,000m). Metabolism is extremely slow."}},{"k":"angelfish_pterophyllum","v":{"s":"Angelfish (Pterophyllum)"}},{"k":"tall_dorsal_fin","v":{"s":"Tall Dorsal Fin"}},{"k":"extremely_elongated_dorsal_fin_gives_t","v":{"s":"Extremely elongated dorsal fin gives the diamond-shaped profile. Used for display and stability in slow-moving water. Vulnerable to fin nipping by tankmates."}},{"k":"trailing_anal_fin","v":{"s":"Trailing Anal Fin"}},{"k":"mirror_image_of_the_dorsal_fin_creates","v":{"s":"Mirror-image of the dorsal fin. Creates the characteristic angel profile. Both fins are supported by bony rays covered in thin membrane."}},{"k":"laterally_compressed_body","v":{"s":"Laterally Compressed Body"}},{"k":"disc_shaped_body_allows_navigation_thr","v":{"s":"Disc-shaped body allows navigation through dense vegetation. Angelfish are ambush predators that hide among plant stems in the Amazon basin."}},{"k":"caudal_fin_tail_2","v":{"s":"Caudal Fin (Tail)"}},{"k":"small_fan_shaped_tail_provides_gentle_","v":{"s":"Small, fan-shaped tail provides gentle propulsion. Angelfish are slow, deliberate swimmers — built for maneuverability, not speed."}},{"k":"vertical_bars","v":{"s":"Vertical Bars"}},{"k":"dark_vertical_bars_provide_camouflage_","v":{"s":"Dark vertical bars provide camouflage among underwater vegetation. Pattern intensity changes with mood — bars fade when stressed or dominant."}},{"k":"pectoral_fins_4","v":{"s":"Pectoral Fins"}},{"k":"fan_shaped_fins_for_precise_steering_u","v":{"s":"Fan-shaped fins for precise steering. Used to fan eggs during spawning. Both parents guard eggs by wafting fresh, oxygenated water over them."}},{"k":"tetra_characidae","v":{"s":"Tetra (Characidae)"}},{"k":"iridescent_stripe","v":{"s":"Iridescent Stripe"}},{"k":"the_famous_neon_stripe_is_made_of_guan","v":{"s":"The famous neon stripe is made of guanine crystals arranged in layers. Acts like a biological mirror — reflects light to create iridescent blue-green shimmer."}},{"k":"red_band","v":{"s":"Red Band"}},{"k":"pigment_cells_chromatophores_produce_t","v":{"s":"Pigment cells (chromatophores) produce the vivid red belly band. Color intensity signals health and breeding readiness to potential mates."}},{"k":"torpedo_body","v":{"s":"Torpedo Body"}},{"k":"streamlined_laterally_compressed_body_","v":{"s":"Streamlined, laterally compressed body optimized for darting through dense vegetation. Small size (3-4cm) allows passage through tight spaces."}},{"k":"forked_caudal_fin","v":{"s":"Forked Caudal Fin"}},{"k":"deeply_forked_tail_for_rapid_bursts_of","v":{"s":"Deeply forked tail for rapid bursts of speed. Tetras alternate between hovering in schools and explosive escape dashes when startled."}},{"k":"adipose_fin","v":{"s":"Adipose Fin"}},{"k":"a_small_fleshy_fin_between_dorsal_and_","v":{"s":"A small, fleshy fin between dorsal and tail found only in certain fish groups. Its function is debated — may detect water flow turbulence."}},{"k":"schooling_behavior","v":{"s":"Schooling Behavior"}},{"k":"large_eyes_positioned_for_wide_angle_v","v":{"s":"Large eyes positioned for wide-angle vision enable precise school coordination. Each fish maintains exact distance from neighbors using its lateral line."}},{"k":"livebearer_poeciliidae","v":{"s":"Livebearer (Poeciliidae)"}},{"k":"fan_shaped_caudal","v":{"s":"Fan-Shaped Caudal"}},{"k":"large_colorful_tail_fin_doubles_as_a_d","v":{"s":"Large, colorful tail fin doubles as a display organ. Males fan their tails to attract females. Tail shape varies: round, lyretail, swordtail, delta."}},{"k":"gravid_spot_female","v":{"s":"Gravid Spot (female)"}},{"k":"a_dark_patch_near_the_anal_fin_in_preg","v":{"s":"A dark patch near the anal fin in pregnant females. Darkens as embryos develop. Fry develop fully inside the mother — born live and free-swimming."}},{"k":"gonopodium_male","v":{"s":"Gonopodium (male)"}},{"k":"modified_anal_fin_used_for_internal_fe","v":{"s":"Modified anal fin used for internal fertilization — unique to livebearers. Guppies can store sperm for months, producing multiple broods from a single mating."}},{"k":"color_patterns","v":{"s":"Color Patterns"}},{"k":"male_coloration_is_genetically_determi","v":{"s":"Male coloration is genetically determined and Y-linked. Females prefer males with rare patterns — driving constant evolution of new color morphs."}},{"k":"compact_body","v":{"s":"Compact Body"}},{"k":"rounded_robust_body_optimized_for_quic","v":{"s":"Rounded, robust body optimized for quick starts rather than sustained swimming. Livebearers are surface-feeders that dart for food."}},{"k":"upturned_mouth","v":{"s":"Upturned Mouth"}},{"k":"slightly_upturned_jaw_adapted_for_feed","v":{"s":"Slightly upturned jaw adapted for feeding at the water surface. Guppies eat mosquito larvae, making them valuable for biocontrol of malaria."}},{"k":"bottom_dweller_loricariidae","v":{"s":"Bottom-Dweller (Loricariidae)"}},{"k":"sucker_mouth","v":{"s":"Sucker Mouth"}},{"k":"ventral_sucker_like_mouth_for_rasping_","v":{"s":"Ventral sucker-like mouth for rasping algae off surfaces. The lips form a vacuum seal. Specialized teeth scrape biofilm — a living algae scrubber."}},{"k":"bony_armor_plates_2","v":{"s":"Bony Armor Plates"}},{"k":"overlapping_bony_scutes_replace_scales","v":{"s":"Overlapping bony scutes replace scales. Provides armor-like protection from predators. So tough that some indigenous peoples use dried pleco skin as sandpaper."}},{"k":"dorsal_spine_array","v":{"s":"Dorsal Spine Array"}},{"k":"lockable_dorsal_spines_can_be_erected_","v":{"s":"Lockable dorsal spines can be erected and locked rigid. Once locked, predators cannot swallow the fish. Spines unlock with a special \"trigger\" mechanism."}},{"k":"high_set_eyes","v":{"s":"High-Set Eyes"}},{"k":"eyes_positioned_on_top_of_the_head_for","v":{"s":"Eyes positioned on top of the head for upward surveillance while bottom-feeding. Can see approaching predators while attached to rocks."}},{"k":"flat_ventral_profile","v":{"s":"Flat Ventral Profile"}},{"k":"body_flattened_from_top_to_bottom_dors","v":{"s":"Body flattened from top to bottom (dorsoventrally) for a low profile against substrates. Reduces drag in current and helps maintain position on rocks."}},{"k":"intestinal_breathing","v":{"s":"Intestinal Breathing"}},{"k":"some_species_can_absorb_atmospheric_ox","v":{"s":"Some species can absorb atmospheric oxygen through a modified intestine. They gulp air at the surface — essential in low-oxygen tropical waters."}},{"k":"deep_sea_eel_saccopharyngiformes","v":{"s":"Deep-Sea Eel (Saccopharyngiformes)"}},{"k":"massive_hinged_jaw","v":{"s":"Massive Hinged Jaw"}},{"k":"jaw_can_unhinge_to_an_angle_greater_th","v":{"s":"Jaw can unhinge to an angle greater than 180°. The entire head unfolds like a net to engulf prey. Can swallow fish larger than its own body."}},{"k":"distensible_stomach","v":{"s":"Distensible Stomach"}},{"k":"expandable_stomach_stretches_to_accomm","v":{"s":"Expandable stomach stretches to accommodate enormous meals. In the food-scarce deep sea, the ability to eat any prey encountered is essential for survival."}},{"k":"bioluminescent_tail_tip","v":{"s":"Bioluminescent Tail Tip"}},{"k":"the_tail_tip_emits_a_pinkish_red_glow_","v":{"s":"The tail tip emits a pinkish-red glow to lure prey. Functions as a fishing line in reverse — prey approaches the light and enters the gaping mouth."}},{"k":"tiny_eyes","v":{"s":"Tiny Eyes"}},{"k":"extremely_small_eyes_with_minimal_visu","v":{"s":"Extremely small eyes with minimal visual capability. In the lightless deep sea, vision is less important than detecting bioluminescent flashes."}},{"k":"whip_like_body","v":{"s":"Whip-Like Body"}},{"k":"extremely_elongated_and_laterally_comp","v":{"s":"Extremely elongated and laterally compressed body. The tail is 3-4x longer than the head and body combined. Enables slow, energy-efficient drifting."}},{"k":"reduced_skeleton","v":{"s":"Reduced Skeleton"}},{"k":"minimally_ossified_bones_reduce_weight","v":{"s":"Minimally ossified bones reduce weight for neutral buoyancy. No swim bladder, no pelvic fins, no scales — everything stripped for deep-sea efficiency."}},{"k":"manta_ray_mobulidae","v":{"s":"Manta Ray (Mobulidae)"}},{"k":"pectoral_wings","v":{"s":"Pectoral Wings"}},{"k":"enormously_expanded_pectoral_fins_crea","v":{"s":"Enormously expanded pectoral fins create wing-like surfaces. Mantas swim by \"flying\" through water with powerful downstrokes. Wingspan can reach 7 meters."}},{"k":"cephalic_fins","v":{"s":"Cephalic Fins"}},{"k":"unique_horn_like_fins_flanking_the_mou","v":{"s":"Unique horn-like fins flanking the mouth that funnel plankton-rich water inward. Can be rolled up when not feeding. Gave rise to the name \"devil ray.\""}},{"k":"terminal_mouth","v":{"s":"Terminal Mouth"}},{"k":"wide_forward_facing_mouth_with_rows_of","v":{"s":"Wide, forward-facing mouth with rows of tiny filter plates. Opens wide during feeding to maximize water intake. Can process thousands of liters per hour."}},{"k":"dark_dorsal_surface_blends_with_ocean_","v":{"s":"Dark dorsal surface blends with ocean depths when viewed from above. Light ventral surface matches bright surface when viewed from below. Classic marine camouflage."}},{"k":"whip_tail","v":{"s":"Whip Tail"}},{"k":"long_slender_tail_without_a_stinging_b","v":{"s":"Long, slender tail without a stinging barb (unlike stingrays). Used as a rudder for precise turns during barrel-roll feeding maneuvers."}},{"k":"gill_slits_ventral","v":{"s":"Gill Slits (ventral)"}},{"k":"five_pairs_of_gill_slits_on_the_unders","v":{"s":"Five pairs of gill slits on the underside filter oxygen. During feeding, water enters the mouth and exits the gills — a ram-ventilation system."}},{"k":"baleen_whale_mysticeti","v":{"s":"Baleen Whale (Mysticeti)"}},{"k":"baleen_plates","v":{"s":"Baleen Plates"}},{"k":"hundreds_of_keratinous_plates_hang_fro","v":{"s":"Hundreds of keratinous plates hang from the upper jaw like a curtain. Filter up to 4 tons of krill daily. Made of the same protein as human fingernails."}},{"k":"ventral_pleats","v":{"s":"Ventral Pleats"}},{"k":"accordion_like_throat_grooves_expand_t","v":{"s":"Accordion-like throat grooves expand to engulf enormous volumes of water. A blue whale's mouth can hold 90 tonnes of water in a single gulp."}},{"k":"blowhole_2","v":{"s":"Blowhole"}},{"k":"paired_nostrils_migrated_to_the_top_of","v":{"s":"Paired nostrils migrated to the top of the skull. Exhaled air can reach 9 meters high. Contains a muscular plug that seals watertight during dives."}},{"k":"fluke_tail_2","v":{"s":"Fluke (Tail)"}},{"k":"horizontal_tail_flukes_move_up_and_dow","v":{"s":"Horizontal tail flukes move up and down (unlike fish tails). Each fluke has a unique trailing edge pattern — used by researchers to identify individuals."}},{"k":"pectoral_flipper","v":{"s":"Pectoral Flipper"}},{"k":"contains_the_same_bones_as_a_human_arm","v":{"s":"Contains the same bones as a human arm (humerus, radius, ulna, fingers). Internal structure reveals the whale's evolution from land-dwelling mammals."}},{"k":"blubber_layer_2","v":{"s":"Blubber Layer"}},{"k":"up_to_30cm_of_insulating_fat_serves_as","v":{"s":"Up to 30cm of insulating fat. Serves as energy storage, thermal insulation, and streamlining. A blue whale's blubber can weigh 27 tonnes."}},{"k":"giant_tube_worm_riftia","v":{"s":"Giant Tube Worm (Riftia)"}},{"k":"plume_obturaculae","v":{"s":"Plume (Obturaculae)"}},{"k":"bright_red_feathery_plume_absorbs_hydr","v":{"s":"Bright red feathery plume absorbs hydrogen sulfide, oxygen, and CO₂ from vent water. The red color comes from hemoglobin — same iron-based molecule as in human blood."}},{"k":"chitin_tube","v":{"s":"Chitin Tube"}},{"k":"self_secreted_protective_tube_made_of_","v":{"s":"Self-secreted protective tube made of chitin and protein. Can grow over 2 meters tall. The worm can retract completely inside when threatened by predators."}},{"k":"trophosome_internal","v":{"s":"Trophosome (internal)"}},{"k":"a_spongy_organ_packed_with_billions_of","v":{"s":"A spongy organ packed with billions of chemosynthetic bacteria. These bacteria convert hydrogen sulfide into organic molecules — the worm's sole energy source."}},{"k":"no_mouth_or_gut","v":{"s":"No Mouth or Gut"}},{"k":"adult_tube_worms_have_no_digestive_sys","v":{"s":"Adult tube worms have no digestive system at all. They rely entirely on their symbiotic bacteria. Nutrients are delivered through the bloodstream."}},{"k":"vestimentiferan_body","v":{"s":"Vestimentiferan Body"}},{"k":"segmented_body_plan_divided_into_disti","v":{"s":"Segmented body plan divided into distinct regions. Anchors in the tube using tiny hooks called chaetae. Can grow at rates of 85cm per year — the fastest of any invertebrate."}},{"k":"hydrothermal_vent_base","v":{"s":"Hydrothermal Vent Base"}},{"k":"lives_exclusively_at_hydrothermal_vent","v":{"s":"Lives exclusively at hydrothermal vents where superheated water (up to 400°C) meets near-freezing ocean. Thrives in water containing lethal levels of hydrogen sulfide."}},{"k":"clownfish_amphiprioninae","v":{"s":"Clownfish (Amphiprioninae)"}},{"k":"white_bands","v":{"s":"White Bands"}},{"k":"distinctive_vertical_white_bands_borde","v":{"s":"Distinctive vertical white bands bordered by black margins. Band pattern varies by species — 0 to 3 bands. Produced by iridophore cells containing guanine crystals."}},{"k":"rounded_body","v":{"s":"Rounded Body"}},{"k":"compact_laterally_compressed_body_adap","v":{"s":"Compact, laterally compressed body adapted for quick turns among anemone tentacles. Shape allows rapid darting rather than sustained swimming."}},{"k":"mucus_coating","v":{"s":"Mucus Coating"}},{"k":"special_mucus_layer_prevents_anemone_s","v":{"s":"Special mucus layer prevents anemone stings. Built up gradually through careful acclimation touching. Composition includes sugars that inhibit nematocyst discharge."}},{"k":"rounded_tail","v":{"s":"Rounded Tail"}},{"k":"small_rounded_caudal_fin_for_quick_man","v":{"s":"Small, rounded caudal fin for quick maneuvers near host anemone. Clownfish rarely venture far from their home anemone — typically within 1 meter."}},{"k":"protandrous_sex","v":{"s":"Protandrous Sex"}},{"k":"all_clownfish_are_born_male_the_domina","v":{"s":"All clownfish are born male. The dominant individual transitions to female. If the female dies, the next-largest male becomes female."}},{"k":"pectoral_hovering","v":{"s":"Pectoral Hovering"}},{"k":"rapid_pectoral_fin_waving_creates_the_","v":{"s":"Rapid pectoral fin waving creates the characteristic hovering motion near the anemone. The constant fluttering also aerates the anemone."}},{"k":"cichlid_cichlidae","v":{"s":"Cichlid (Cichlidae)"}},{"k":"spiny_dorsal_fin","v":{"s":"Spiny Dorsal Fin"}},{"k":"long_dorsal_fin_with_sharp_anterior_sp","v":{"s":"Long dorsal fin with sharp anterior spines and soft posterior rays. Spines lock erect for defense. Cichlids raise their dorsal to signal aggression."}},{"k":"thick_oval_body","v":{"s":"Thick Oval Body"}},{"k":"deep_laterally_compressed_body_provide","v":{"s":"Deep, laterally compressed body provides power for territorial defense. Cichlids are among the most diverse vertebrate families — over 2,000 species."}},{"k":"protrusible_jaw","v":{"s":"Protrusible Jaw"}},{"k":"pharyngeal_jaws_in_the_throat_grind_fo","v":{"s":"Pharyngeal jaws in the throat grind food independently of the outer jaw. This dual-jaw system enabled explosive adaptive radiation in African rift lakes."}},{"k":"lateral_line_2","v":{"s":"Lateral Line"}},{"k":"sensory_canal_running_head_to_tail_det","v":{"s":"Sensory canal running head to tail detects water pressure changes. Enables cichlids to sense approaching rivals and fine-tune territorial spacing."}},{"k":"pelvic_fans","v":{"s":"Pelvic Fans"}},{"k":"modified_pelvic_fins_used_for_fanning_","v":{"s":"Modified pelvic fins used for fanning eggs and signaling. Many cichlids are mouthbrooders — carrying fertilized eggs inside their mouth."}},{"k":"color_patches","v":{"s":"Color Patches"}},{"k":"chromatophore_driven_color_patterns_si","v":{"s":"Chromatophore-driven color patterns signal mood, dominance, and breeding readiness. Colors intensify during courtship and territorial displays."}},{"k":"goldfish_carassius_auratus","v":{"s":"Goldfish (Carassius auratus)"}},{"k":"rounded_body_2","v":{"s":"Rounded Body"}},{"k":"selectively_bred_for_1_000_years_to_ac","v":{"s":"Selectively bred for 1,000+ years to achieve the deep, egg-shaped body. Wild-type carp have streamlined bodies — the round shape is entirely artificial selection."}},{"k":"double_tail_fin","v":{"s":"Double Tail Fin"}},{"k":"flowing_double_or_triple_caudal_fin_wi","v":{"s":"Flowing double or triple caudal fin with delicate membrane. Fancy varieties include butterfly, veil, and fantail. Creates drag but enhances display."}},{"k":"dorsal_fin_5","v":{"s":"Dorsal Fin"}},{"k":"single_dorsal_fin_absent_in_some_fancy","v":{"s":"Single dorsal fin — absent in some fancy breeds like ranchu. When present, it provides stability during the slow, waddling swim of round-bodied varieties."}},{"k":"pharyngeal_teeth","v":{"s":"Pharyngeal Teeth"}},{"k":"teeth_in_the_throat_not_the_mouth_crus","v":{"s":"Teeth in the throat (not the mouth) crush food. Goldfish are omnivorous bottom-feeders that naturally root through substrate for insect larvae."}},{"k":"lateral_line_3","v":{"s":"Lateral Line"}},{"k":"pressure_sensing_canal_line_goldfish_h","v":{"s":"Pressure-sensing canal line. Goldfish have excellent senses — they can distinguish individual humans and learn to respond to feeding cues within days."}},{"k":"operculum","v":{"s":"Operculum"}},{"k":"bony_gill_cover_pumps_water_over_the_g","v":{"s":"Bony gill cover pumps water over the gills. Goldfish are cold-water fish with a remarkable temperature range (2-30°C) and can survive brief oxygen deprivation."}},{"k":"billfish_xiphiidae","v":{"s":"Billfish (Xiphiidae)"}},{"k":"bill_rostrum","v":{"s":"Bill / Rostrum"}},{"k":"elongated_upper_jaw_forms_a_flat_sword","v":{"s":"Elongated upper jaw forms a flat, sword-like bill. Used to slash through schools of fish, stunning prey. Can reach speeds of 100 km/h — one of the fastest fish."}},{"k":"streamlined_torpedo","v":{"s":"Streamlined Torpedo"}},{"k":"supremely_hydrodynamic_body_with_minim","v":{"s":"Supremely hydrodynamic body with minimal drag coefficient. Skin secretes an oil that further reduces friction. Built for sustained high-speed pursuit."}},{"k":"crescent_tail","v":{"s":"Crescent Tail"}},{"k":"deeply_forked_crescent_shaped_lunate_c","v":{"s":"Deeply forked, crescent-shaped (lunate) caudal fin is the hallmark of high-speed pelagic fish. Generates maximum thrust with minimal turbulence."}},{"k":"tall_dorsal","v":{"s":"Tall Dorsal"}},{"k":"large_sail_like_first_dorsal_fin_folds","v":{"s":"Large, sail-like first dorsal fin folds into a groove for speed. When raised, it stabilizes turns and can be used to herd prey fish."}},{"k":"lateral_keel","v":{"s":"Lateral Keel"}},{"k":"bony_ridge_on_the_caudal_peduncle_redu","v":{"s":"Bony ridge on the caudal peduncle reduces drag during tail beats. Combined with counter-current heat exchangers, allows warm-blooded muscle operation."}},{"k":"large_eye","v":{"s":"Large Eye"}},{"k":"enormous_eyes_with_specialized_heating","v":{"s":"Enormous eyes with specialized heating organs keep them warm. Heated eyes process visual information faster — critical for high-speed pursuit in cold deep water."}},{"k":"corydoras_catfish_callichthyidae","v":{"s":"Corydoras Catfish (Callichthyidae)"}},{"k":"barbels_3_pairs","v":{"s":"Barbels (3 pairs)"}},{"k":"sensitive_whisker_like_organs_around_t","v":{"s":"Sensitive whisker-like organs around the mouth packed with taste buds. Used to probe substrate for buried worms, larvae, and detritus in murky Amazonian streams."}},{"k":"bony_scute_armor","v":{"s":"Bony Scute Armor"}},{"k":"two_rows_of_overlapping_bony_plates_sc","v":{"s":"Two rows of overlapping bony plates (scutes) instead of scales. Provides excellent armor — most predators avoid them. Plates are visible as ridged lines along the flanks."}},{"k":"dorsal_spine","v":{"s":"Dorsal Spine"}},{"k":"sharp_lockable_dorsal_spine_that_can_p","v":{"s":"Sharp, lockable dorsal spine that can pierce predator mouths. Some species secrete a mild venom. The spine locks rigid with a ratchet mechanism."}},{"k":"flat_belly","v":{"s":"Flat Belly"}},{"k":"ventrally_flattened_body_profile_for_b","v":{"s":"Ventrally flattened body profile for bottom-dwelling. Corydoras spend most of their time rooting through substrate — they are the cleanup crew of freshwater tanks."}},{"k":"intestinal_breathing_2","v":{"s":"Intestinal Breathing"}},{"k":"can_gulp_air_at_the_surface_and_absorb","v":{"s":"Can gulp air at the surface and absorb oxygen through a modified intestine. This adaptation allows survival in warm, stagnant Amazonian pools with near-zero dissolved oxygen."}},{"k":"adipose_fin_2","v":{"s":"Adipose Fin"}},{"k":"a_small_fleshy_fin_between_dorsal_and__2","v":{"s":"A small, fleshy fin between dorsal and tail — a telltale sign shared with tetras, catfish, and salmon. Its function remains debated among ichthyologists."}},{"k":"freshwater_community","v":{"s":"🐠 Freshwater Community"}},{"k":"classic_beginner_setup_with_tetras_gup","v":{"s":"Classic beginner setup with tetras, guppies, and corydoras."}},{"k":"planted_tropical","v":{"s":"🌿 Planted Tropical"}},{"k":"lush_aquascape_with_live_plants_and_sm","v":{"s":"Lush aquascape with live plants and small schooling fish."}},{"k":"saltwater_reef","v":{"s":"🐡 Saltwater Reef"}},{"k":"vibrant_coral_reef_with_clownfish_and_","v":{"s":"Vibrant coral reef with clownfish and anemones."}},{"k":"predator_tank","v":{"s":"🦈 Predator Tank"}},{"k":"oscars_pike_cichlids_and_other_large_p","v":{"s":"Oscars, pike cichlids, and other large predatory fish."}},{"k":"turtle_reptile","v":{"s":"🐢 Turtle & Reptile"}},{"k":"basking_dock_uvb_lighting_and_hardy_co","v":{"s":"Basking dock, UVB lighting, and hardy companion fish."}},{"k":"invertebrate_reef","v":{"s":"🦐 Invertebrate Reef"}},{"k":"shrimp_crabs_urchins_and_delicate_cora","v":{"s":"Shrimp, crabs, urchins, and delicate corals."}},{"k":"cold_water_marine","v":{"s":"🐧 Cold Water Marine"}},{"k":"kelp_forest_ecosystem_with_rockfish_an","v":{"s":"Kelp forest ecosystem with rockfish and sea stars."}},{"k":"brackish_estuary","v":{"s":"🔬 Brackish Estuary"}},{"k":"where_river_meets_sea_archerfish_puffe","v":{"s":"Where river meets sea — archerfish, puffers, mudskippers."}},{"k":"neon_tetra","v":{"s":"Neon Tetra"}},{"k":"their_iridescent_stripe_is_made_of_gua","v":{"s":"Their iridescent stripe is made of guanine crystals."}},{"k":"guppy","v":{"s":"Guppy"}},{"k":"males_display_vibrant_colors_to_attrac","v":{"s":"Males display vibrant colors to attract females."}},{"k":"corydoras","v":{"s":"Corydoras"}},{"k":"they_breathe_air_by_darting_to_the_sur","v":{"s":"They breathe air by darting to the surface!"}},{"k":"angelfish","v":{"s":"Angelfish"}},{"k":"angelfish_are_cichlids_they_guard_thei","v":{"s":"Angelfish are cichlids — they guard their eggs fiercely."}},{"k":"platy","v":{"s":"Platy"}},{"k":"platys_are_livebearers_they_give_birth","v":{"s":"Platys are livebearers — they give birth to free-swimming fry."}},{"k":"molly","v":{"s":"Molly"}},{"k":"mollies_can_survive_in_both_fresh_and_","v":{"s":"Mollies can survive in both fresh and saltwater!"}},{"k":"cardinal_tetra","v":{"s":"Cardinal Tetra"}},{"k":"cardinals_have_a_deeper_red_stripe_tha","v":{"s":"Cardinals have a deeper red stripe than neons."}},{"k":"rummynose_tetra","v":{"s":"Rummynose Tetra"}},{"k":"their_red_nose_fades_when_stressed_a_l","v":{"s":"Their red nose fades when stressed — a living water quality indicator!"}},{"k":"otocinclus","v":{"s":"Otocinclus"}},{"k":"these_tiny_catfish_are_the_best_algae_","v":{"s":"These tiny catfish are the best algae cleaners in the hobby."}},{"k":"cherry_shrimp","v":{"s":"Cherry Shrimp"}},{"k":"a_colony_can_double_in_size_every_2_3_","v":{"s":"A colony can double in size every 2-3 months."}},{"k":"betta","v":{"s":"Betta"}},{"k":"bettas_build_bubble_nests_at_the_surfa","v":{"s":"Bettas build bubble nests at the surface for their eggs."}},{"k":"clownfish","v":{"s":"Clownfish"}},{"k":"all_clownfish_are_born_male_the_domina_2","v":{"s":"All clownfish are born male — the dominant one becomes female!"}},{"k":"blue_tang","v":{"s":"Blue Tang"}},{"k":"blue_tangs_can_play_dead_when_stressed","v":{"s":"Blue tangs can \"play dead\" when stressed, lying on their side."}},{"k":"watchman_goby","v":{"s":"Watchman Goby"}},{"k":"gobies_form_symbiotic_partnerships_wit","v":{"s":"Gobies form symbiotic partnerships with pistol shrimp."}},{"k":"sea_anemone","v":{"s":"Sea Anemone"}},{"k":"anemones_can_live_over_100_years_in_th","v":{"s":"Anemones can live over 100 years in the right conditions."}},{"k":"oscar","v":{"s":"Oscar"}},{"k":"oscars_recognize_their_owners_and_can_","v":{"s":"Oscars recognize their owners and can learn tricks."}},{"k":"pike_cichlid","v":{"s":"Pike Cichlid"}},{"k":"pike_cichlids_are_ambush_predators_tha","v":{"s":"Pike cichlids are ambush predators that strike in milliseconds."}},{"k":"plecostomus","v":{"s":"Plecostomus"}},{"k":"some_plecos_can_grow_over_2_feet_long","v":{"s":"Some plecos can grow over 2 feet long!"}},{"k":"red_eared_slider","v":{"s":"Red-Eared Slider"}},{"k":"they_can_hold_their_breath_for_over_30","v":{"s":"They can hold their breath for over 30 minutes!"}},{"k":"feeder_goldfish","v":{"s":"Feeder Goldfish"}},{"k":"goldfish_can_live_20_years_with_proper","v":{"s":"Goldfish can live 20+ years with proper care."}},{"k":"cleaner_shrimp","v":{"s":"Cleaner Shrimp"}},{"k":"they_set_up_cleaning_stations_where_fi","v":{"s":"They set up cleaning stations where fish line up to be groomed!"}},{"k":"sea_urchin","v":{"s":"Sea Urchin"}},{"k":"urchin_spines_are_actually_modified_te","v":{"s":"Urchin spines are actually modified teeth."}},{"k":"hermit_crab","v":{"s":"Hermit Crab"}},{"k":"hermit_crabs_form_vacancy_chains_swapp","v":{"s":"Hermit crabs form \"vacancy chains\" — swapping shells in order of size!"}},{"k":"sea_star","v":{"s":"Sea Star"}},{"k":"sea_stars_can_regenerate_lost_arms_and","v":{"s":"Sea stars can regenerate lost arms — and sometimes an entire body from one arm."}},{"k":"rockfish","v":{"s":"Rockfish"}},{"k":"some_rockfish_live_over_200_years","v":{"s":"Some rockfish live over 200 years!"}},{"k":"sunflower_star","v":{"s":"Sunflower Star"}},{"k":"sunflower_stars_have_up_to_24_arms_and","v":{"s":"Sunflower stars have up to 24 arms and can move 1 meter per minute."}},{"k":"giant_kelp","v":{"s":"Giant Kelp"}},{"k":"giant_kelp_can_grow_up_to_2_feet_per_d","v":{"s":"Giant kelp can grow up to 2 feet per day!"}},{"k":"archerfish","v":{"s":"Archerfish"}},{"k":"archerfish_shoot_jets_of_water_to_knoc","v":{"s":"Archerfish shoot jets of water to knock insects off branches!"}},{"k":"figure_8_puffer","v":{"s":"Figure-8 Puffer"}},{"k":"puffers_need_to_crunch_hard_shelled_fo","v":{"s":"Puffers need to crunch hard-shelled food to keep their beaks trimmed."}},{"k":"mudskipper","v":{"s":"Mudskipper"}},{"k":"mudskippers_are_fish_that_can_walk_on_","v":{"s":"Mudskippers are fish that can walk on land and breathe air!"}},{"k":"java_fern","v":{"s":"Java Fern"}},{"k":"hardy_epiphyte_attaches_to_rocks_and_d","v":{"s":"Hardy epiphyte — attaches to rocks and driftwood. Thrives in low light. Absorbs nutrients through leaves, not roots."}},{"k":"java_fern_reproduces_by_growing_tiny_p","v":{"s":"Java Fern reproduces by growing tiny plantlets on its leaves!"}},{"k":"amazon_sword","v":{"s":"Amazon Sword"}},{"k":"large_rosette_plant_with_broad_leaves_","v":{"s":"Large rosette plant with broad leaves. Heavy root feeder — needs nutrient-rich substrate. Excellent nitrate absorber."}},{"k":"a_single_amazon_sword_can_grow_over_20","v":{"s":"A single Amazon Sword can grow over 20 inches tall and consume enormous amounts of nitrate."}},{"k":"java_moss","v":{"s":"Java Moss"}},{"k":"versatile_moss_that_carpets_surfaces_p","v":{"s":"Versatile moss that carpets surfaces. Provides hiding spots for fry and shrimp. Nearly indestructible."}},{"k":"java_moss_can_survive_in_almost_any_wa","v":{"s":"Java Moss can survive in almost any water conditions and even grow emersed above water."}},{"k":"hornwort","v":{"s":"Hornwort"}},{"k":"fast_growing_floating_anchored_stem_pl","v":{"s":"Fast-growing floating/anchored stem plant. Champion nitrate absorber and oxygenator. Can grow 1-5 inches per week."}},{"k":"hornwort_releases_allelopathic_chemica","v":{"s":"Hornwort releases allelopathic chemicals that actively inhibit algae growth!"}},{"k":"anubias","v":{"s":"Anubias"}},{"k":"extremely_slow_growing_but_nearly_unki","v":{"s":"Extremely slow-growing but nearly unkillable. Thick, waxy leaves resist algae and herbivorous fish."}},{"k":"anubias_grows_so_slowly_that_algae_oft","v":{"s":"Anubias grows so slowly that algae often colonizes its leaves before new ones emerge."}},{"k":"water_wisteria","v":{"s":"Water Wisteria"}},{"k":"fast_growing_stem_plant_with_finely_di","v":{"s":"Fast-growing stem plant with finely divided leaves. Excellent for absorbing excess nutrients and preventing algae."}},{"k":"water_wisteria_leaf_shape_changes_dram","v":{"s":"Water Wisteria leaf shape changes dramatically based on whether it grows submerged or above water."}},{"k":"duckweed","v":{"s":"Duckweed"}},{"k":"tiny_floating_plant_that_doubles_in_ma","v":{"s":"Tiny floating plant that doubles in mass every 2-3 days. Absorbs nitrate voraciously but blocks light to plants below."}},{"k":"duckweed_is_the_fastest_growing_flower","v":{"s":"Duckweed is the fastest-growing flowering plant on Earth — used in wastewater treatment worldwide."}},{"k":"dwarf_hairgrass","v":{"s":"Dwarf Hairgrass"}},{"k":"carpet_forming_grass_that_creates_lush","v":{"s":"Carpet-forming grass that creates lush green lawns. Requires high CO2 and bright light to thrive."}},{"k":"dwarf_hairgrass_sends_out_runners_unde","v":{"s":"Dwarf Hairgrass sends out runners underground, forming a dense carpet over weeks."}},{"k":"red_root_floater","v":{"s":"Red Root Floater"}},{"k":"floating_plant_with_red_purple_roots_t","v":{"s":"Floating plant with red-purple roots that dangle into the water. Roots absorb nutrients directly from the water column."}},{"k":"the_roots_turn_deep_red_under_intense_","v":{"s":"The roots turn deep red under intense light — a sign of anthocyanin pigment production."}},{"k":"rotala_rotundifolia","v":{"s":"Rotala Rotundifolia"}},{"k":"colorful_stem_plant_that_turns_pink_re","v":{"s":"Colorful stem plant that turns pink-red under high light and CO2. One of the most popular aquascaping plants."}},{"k":"rotala_can_grow_completely_red_when_ir","v":{"s":"Rotala can grow completely red when iron levels are high, creating stunning underwater landscapes."}},{"k":"monte_carlo","v":{"s":"Monte Carlo"}},{"k":"low_growing_carpet_plant_with_small_ro","v":{"s":"Low-growing carpet plant with small round leaves. Creates dense ground cover. Needs CO2 injection."}},{"k":"monte_carlo_was_discovered_in_argentin","v":{"s":"Monte Carlo was discovered in Argentina and named after Monte Carlo, the famous Mediterranean city."}},{"k":"java_fern_2","v":{"s":"Java Fern"}},{"k":"hardy_epiphyte_attaches_to_rocks_and_d_2","v":{"s":"Hardy epiphyte — attaches to rocks and driftwood. Thrives in low light."}},{"k":"java_fern_reproduces_by_growing_tiny_p_2","v":{"s":"Java Fern reproduces by growing tiny plantlets on its leaves!"}},{"k":"hornwort_2","v":{"s":"Hornwort"}},{"k":"champion_oxygenator_and_nitrate_absorb","v":{"s":"Champion oxygenator and nitrate absorber. Grows fast and releases algae-inhibiting chemicals."}},{"k":"hornwort_allelopathy_actively_suppress","v":{"s":"Hornwort allelopathy actively suppresses algae growth in the water column."}},{"k":"water_wisteria_2","v":{"s":"Water Wisteria"}},{"k":"fast_growing_nutrient_sponge_with_beau","v":{"s":"Fast-growing nutrient sponge with beautiful lacey leaves."}},{"k":"water_wisteria_can_be_propagated_from_","v":{"s":"Water Wisteria can be propagated from just a single stem cutting."}},{"k":"chaetomorpha","v":{"s":"Chaetomorpha"}},{"k":"green_macroalgae_grown_in_refugiums_th","v":{"s":"Green macroalgae grown in refugiums. The ultimate nitrate and phosphate remover for saltwater tanks."}},{"k":"chaeto_is_so_effective_at_nutrient_exp","v":{"s":"Chaeto is so effective at nutrient export that reefers harvest and discard overgrown portions regularly."}},{"k":"mangrove_seedling","v":{"s":"Mangrove Seedling"}},{"k":"grows_roots_in_saltwater_while_leaves_","v":{"s":"Grows roots in saltwater while leaves emerge above. Excellent natural denitrifier and provides habitat structure."}},{"k":"mangrove_forests_protect_coastlines_fr","v":{"s":"Mangrove forests protect coastlines from storms and serve as nurseries for 75% of commercially caught fish species."}},{"k":"caulerpa","v":{"s":"Caulerpa"}},{"k":"fast_growing_marine_macroalgae_can_bec","v":{"s":"Fast-growing marine macroalgae. Can become invasive if not pruned — known to \"go sexual\" and release spores in a toxic crash."}},{"k":"caulerpa_is_a_single_celled_organism_o","v":{"s":"Caulerpa is a single-celled organism — one of the largest single cells on Earth, up to 3 meters long!"}},{"k":"mangrove_seedling_2","v":{"s":"Mangrove Seedling"}},{"k":"grows_roots_in_brackish_water_while_le","v":{"s":"Grows roots in brackish water while leaves emerge above. Natural denitrifier."}},{"k":"mangroves_can_filter_salt_from_seawate","v":{"s":"Mangroves can filter salt from seawater — their roots excrete salt crystals."}},{"k":"java_fern_3","v":{"s":"Java Fern"}},{"k":"tolerates_mild_brackish_conditions_har","v":{"s":"Tolerates mild brackish conditions. Hardy and low-maintenance."}},{"k":"java_fern_is_one_of_the_few_plants_tha","v":{"s":"Java Fern is one of the few plants that can tolerate slight salinity."}},{"k":"males_display_vibrant_color_patterns_t","v":{"s":"Males display vibrant color patterns to attract females. Females store sperm and can produce multiple broods."}},{"k":"prolific_livebearers_that_give_birth_t","v":{"s":"Prolific livebearers that give birth to free-swimming fry every 4-6 weeks."}},{"k":"mollies_prefer_slightly_brackish_condi","v":{"s":"Mollies prefer slightly brackish conditions for breeding. Fry are large and independent at birth."}},{"k":"angelfish_carefully_clean_a_flat_surfa","v":{"s":"Angelfish carefully clean a flat surface before laying hundreds of eggs. Both parents fan and guard the clutch."}},{"k":"all_clownfish_are_born_male_the_domina_3","v":{"s":"All clownfish are born male. The dominant fish becomes female — if she dies, the next male transitions."}},{"k":"corydoras_perform_a_unique_t_position_","v":{"s":"Corydoras perform a unique \"T-position\" mating dance. Females carry eggs in their pelvic fins before depositing them on glass or leaves."}},{"k":"males_blow_mucus_coated_bubbles_to_bui","v":{"s":"Males blow mucus-coated bubbles to build a floating nest. After spawning, the male guards eggs and returns fallen fry to the nest."}},{"k":"females_carry_fertilized_eggs_under_th","v":{"s":"Females carry fertilized eggs under their abdomen (\"berried\"). Shrimplets are miniature adults at birth."}},{"k":"scatter_tiny_adhesive_eggs_among_fine_","v":{"s":"Scatter tiny adhesive eggs among fine-leaved plants at dawn. Eggs are light-sensitive and hatch in 24 hours."}},{"k":"prefer_very_soft_acidic_water_for_spaw","v":{"s":"Prefer very soft, acidic water for spawning. Eggs and fry are extremely small and fragile."}},{"k":"spawn_in_tight_schools_at_first_light_","v":{"s":"Spawn in tight schools at first light. Red nose coloration intensifies during courtship."}},{"k":"filter","v":{"s":"Filter"}},{"k":"sponge_filter","v":{"s":"Sponge Filter"}},{"k":"basic_mechanical_biological_filtration","v":{"s":"Basic mechanical & biological filtration."}},{"k":"hob_filter","v":{"s":"HOB Filter"}},{"k":"hang_on_back_with_activated_carbon_bet","v":{"s":"Hang-on-back with activated carbon. Better flow."}},{"k":"canister_filter","v":{"s":"Canister Filter"}},{"k":"multi_stage_mechanical_chemical_biolog","v":{"s":"Multi-stage: mechanical, chemical, biological."}},{"k":"sump_system","v":{"s":"Sump System"}},{"k":"professional_grade_massive_biological_","v":{"s":"Professional-grade. Massive biological capacity."}},{"k":"heater","v":{"s":"Heater"}},{"k":"no_heater","v":{"s":"No Heater"}},{"k":"ro