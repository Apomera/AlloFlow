    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/18913.png",
      "text": "እቶም ዝጠመዩ ደማሙ “ኣበይ ኣለው እዞም ኩሎም ኣናፁ?” በሉ።",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=21105#page=6",
