rtant; color: rgb(255, 255, 255) !important; }\n.diss-reference-context { padding: 0.8rem; margin: 0.65rem 0px; border-width: 1px 1px 1px 4px; border-style: solid; border-color: rgb(182, 203, 220) rgb(182, 203, 220) rgb(182, 203, 220) rgb(8, 127, 120); border-image: initial; border-radius: 0.65rem; background: rgb(240, 253, 250); color: rgb(23, 61, 72); }\n.diss-reference-context p, .diss-comparison-card p { margin: 0.4rem 0px; font-size: 0.83rem; line-height: 1.6; }\n.diss-reference-context a { display: inline-block; padding-block: 0.5rem; color: rgb(22, 78, 135); text-decoration: underline; text-underline-offset: 0.18em; font-size: 0.8rem; }\n.diss-reference-label { display: block; color: rgb(66, 96, 121); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }\n.diss-comparison { padding: 1rem; border: 1px solid rgb(182, 203, 220); border-radius: 1rem; background: rgb(244, 248, 252); color: rgb(16, 35, 63); }\n.diss-comparison h3 { margin: 0px; font-size: 1.15rem; font-weight: 850; }\n.diss-comparison > p { margin: 0.5rem 0px 0.85rem; font-size: 0.85rem; line-height: 1.55; }\n.diss-comparison-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 0.65rem; }\n.diss-comparison-card { min-width: 0px; padding: 0.9rem; border: 1px solid rgb(188, 205, 221); border-radius: 0.75rem; background: rgb(255, 255, 255); }\n.diss-comparison-card[data-current=\"true\"] { border: 2px solid rgb(8, 127, 120); background: rgb(240, 253, 250); }\n.diss-comparison-card h4 { margin: 0.3rem 0px; font-size: 0.95rem; font-weight: 800; }\n.diss-pump-diagram { margin: 0.75rem 0px; padding: 0.65rem; border: 1px solid rgb(199, 213, 224); border-radius: 0.6rem; background: rgb(248, 250, 252); color: rgb(34, 59, 80); }\n.diss-pump-diagram svg { display: block; width: 100%; height: auto; max-height: 180px; overflow: visible; }\n.diss-pump-diagram text { font: 700 16px system-ui, sans-serif; fill: rgb(32, 57, 77); }\n.d