  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/8864.png",
      "text": "Ntate Noko o lula motseng oa haeso. Ntate Noko o na le katse ent'so e ts'oeu e bitsoang Safi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=1",
      "sourceDigest": "sha256:e81800c053947011a14109edec7b819eedf2954488883273fcad1d13157e0f04"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/8865.png",
      "text": "Ha Ntate Noko a ea mosebetsing, o sia lemati le butsoe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=2",
      "sourceDigest": "sha256:6bd334d18e65e5e30b802aee731f7103f10e3323dd2c486193de335ba8f0c40b"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/8866.png",
      "text": "Safi o sala a lutse monyako oa lemati a kata ntlo ea Ntate Noko.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=3",
      "sourceDigest": "sha256:06ffb47138833c4ce94a77894fb44dd1082116772a78fc49d2e7d96051c2f6c8"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/8867.png",
      "text": "Ha ntja ea mohaisane e tla, Safi o nts'a linala tsa have ho bonts'a ntoa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=4",
      "sourceDigest": "sha256:01617c74e2938069eac905f32fdc81b3be951c2f0d207719542195a44984f045"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/8868.png",
      "text": "Ntja ea baleha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=5",
      "sourceDigest": "sha256:128a35163f0c872975cd2520d9d2d988c53a8b510b135198d49bcded74ef476a"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/8870.png",
      "text": "Ha moahisane a e tla, Safi a itukisetsa ho mongoapa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=6",
      "sourceDigest": "sha256:acb72dea36033faee9412368896967d78bd4b3d12fba1b643a5283ae0da4b5b9"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/8873.png",
      "text": "Moahisane le ena a tjekela morao a baleha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=7",
      "sourceDigest": "sha256:ac03f55f3a52181799eccd723c9482e80028d4c2fb2ae9008f477086707b64d9"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/8871.png",
      "text": "Ha Safi a lapile, o suthumetsa lemati ka maoto a pele, e be o oa le koala.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=8",
      "sourceDigest": "sha256:2cae90340d53285c4a7aa0909d301d55ccf391ac3d5dceedd1f97b73deac95ac"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/8872.png",
      "text": "O kena ka hare e be o ja lijo tsa hae.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=9",
      "sourceDigest": "sha256:6492f531a6bc7e64b6e7e867bc2b88bc5d5f7f17d1f7735f528180830551c9b0"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/8874.png",
      "text": "Ha Safi a khotsofetse, o qothomela sofeng e be o oa robala. E be joale u utloa lehonotho la ho khona hoa katse.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=10",
      "sourceDigest": "sha256:d4f4586d7942c8dd2499e861de731881f7ea4b4c7414f0ec9a0fb21e66f86713"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/8876.png",
      "text": "Ha Ntate Noko a fihla, Safi o aa thaba, o oa ikotlolla eaba o oa mo amohela.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=11",
      "sourceDigest": "sha256:f71cd4fa513b29a4da0de209669af8583e62490f8bfdfef2439f061b5bc31caa"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/8875.png",
      "text": "Eaba joale Ntate Noko le Safi ba lula 'moho pela mollo ba bala likoranta.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=10622#page=12",
      "sourceDigest": "sha256:9a243fbca42350d8dbda985f1fd8d2923be9c01d119e142fe3e69393451529dd"
    }
  ],
