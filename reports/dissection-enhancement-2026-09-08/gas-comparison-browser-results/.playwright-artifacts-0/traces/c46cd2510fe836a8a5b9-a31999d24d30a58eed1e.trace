 1px solid rgb(153, 199, 190); border-radius: 0.7rem; background: rgb(255, 255, 255); color: rgb(49, 91, 88); }\n.diss-active-tool__icon { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 999px; background: rgb(204, 251, 241); color: rgb(15, 118, 110); font-size: 1rem; font-weight: 900; }\n.diss-active-tool strong, .diss-active-tool span { display: block; }\n.diss-active-tool strong { color: rgb(19, 78, 74); font-size: 0.72rem; }\n.diss-active-tool span { margin-top: 0.1rem; color: rgb(73, 105, 102); font-size: 0.64rem; line-height: 1.35; }\n.diss-active-tool__badge { padding: 0.25rem 0.42rem; border-radius: 999px; background: rgb(254, 243, 199); color: rgb(146, 64, 14); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.045em; text-transform: uppercase; white-space: nowrap; }\n.diss-active-tool[data-readiness=\"ready\"] .diss-active-tool__badge { background: rgb(209, 250, 229); color: rgb(6, 95, 70); }\n.diss-active-tool[data-readiness=\"complete\"] .diss-active-tool__badge { background: rgb(219, 234, 254); color: rgb(29, 78, 216); }\n.diss-readiness { display: grid; gap: 0.45rem; margin-top: 0.5rem; padding: 0.58rem 0.65rem; border: 1px solid rgb(148, 163, 184); border-radius: 0.7rem; background: rgb(248, 250, 252); color: rgb(51, 65, 85); }\n.diss-readiness[data-tone=\"ready\"], .diss-readiness[data-tone=\"complete\"] { border-color: rgb(5, 150, 105); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-readiness[data-tone=\"caution\"] { border-color: rgb(217, 119, 6); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-readiness[data-tone=\"restricted\"] { border-color: rgb(185, 28, 28); background: rgb(255, 241, 242); color: rgb(136, 19, 55); }\n.diss-readiness__header { display: flex; min-width: 0px; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.35rem; }\n.diss-readiness__header strong { font-size: 0.72rem; }\n.diss-readiness__score { font-variant-numeric: tabular-nums; font-size: 0.66rem; font-weight: 900; }\n.diss-readiness__meter { overflow: hidden; height: 0.55rem; border: 1px solid; border-radius: 999px; background: rgba(255, 255, 255, 0.82); }\n.diss-readiness__meter > span { display: block; height: 100%; border-radius: inherit; background: currentcolor; transition: width 0.2s; }\n[data-dissection-root][data-reduced-motion=\"true\"] .diss-readiness__meter > span { transition: none; }\n.diss-readiness__checks { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 0.3rem; }\n.diss-readiness__check { display: flex; min-width: 0px; align-items: center; gap: 0.25rem; padding: 0.3rem 0.35rem; border: 1px solid; border-radius: 0.45rem; background: rgba(255, 255, 255, 0.72); font-size: 0.6rem; font-weight: 800; }\n.diss-readiness__check span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.diss-readiness__cue { margin: 0px; font-size: 0.65rem; line-height: 1.4; }\n@media (max-width: 520px) {\n  .diss-readiness__checks { grid-template-columns: repeat(2, minmax(0px, 1fr)); }\n}\n.diss-procedure__steps { display: grid; grid-template-columns: repeat(6, minmax(0px, 1fr)); gap: 0.28rem; margin-top: 0.6rem; }\n.diss-procedure__step { min-width: 0px; padding: 0.3rem 0.2rem; border-radius: 0.45rem; background: rgb(223, 234, 233); color: rgb(63, 95, 92); font-size: 0.61rem; font-weight: 800; text-align: center; }\n.diss-procedure__step[data-complete=\"true\"] { background: rgb(204, 251, 241); color: rgb(15, 118, 110); }\n.diss-procedure__step[data-current=\"true\"] { box-shadow: rgb(245, 158, 11) 0px 0px 0px 2px inset; background: rgb(255, 251, 235); color: rgb(146, 64, 14); }\n.diss-procedure__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin-top: 0.65rem; }\n.diss-procedure__controls button { padding: 0.5rem 0.7rem; border: 1px solid rgb(157, 186, 182); border-radius: 0.65rem; background: rgb(255, 255, 255); color: rgb(49, 91, 88); font-size: 0.7rem; font-weight: 850; cursor: pointer; min-height: 2.4rem !important; }\n.diss-procedure__controls .diss-procedure__next { border-color: rgb(15, 118, 110); background: rgb(15, 118, 110); color: rgb(255, 255, 255); }\n.diss-procedure__controls button:disabled { cursor: not-allowed; opacity: 0.55; }\n.diss-calibration { display: grid; grid-template-columns: minmax(7rem, auto) minmax(9rem, 1fr) auto; align-items: center; gap: 0.42rem 0.65rem; margin-top: 0.65rem; padding: 0.62rem 0.68rem; border: 1px solid rgb(159, 202, 194); border-radius: 0.72rem; background: linear-gradient(135deg, rgba(240, 253, 250, 0.96), rgba(255, 255, 255, 0.94)); }\n.diss-calibration[data-tone=\"adjust\"] { border-color: rgb(245, 158, 11); background: linear-gradient(135deg, rgb(255, 251, 235), rgb(255, 255, 255)); }\n.diss-calibration[data-tone=\"caution\"] { border-color: rgb(251, 113, 133); background: linear-gradient(135deg, rgb(255, 241, 242), rgb(255, 255, 255)); }\n.diss-calibration__title { min-width: 0px; }\n.diss-calibration__title strong, .diss-calibration__title span { display: block; }\n.diss-calibration__title strong { color: rgb(19, 78, 74); font-size: 0.69rem; }\n.diss-calibration__title span { margin-top: 0.12rem; color: rgb(82, 107, 104); font-size: 0.58rem; line-height: 1.35; }\n.diss-calibration input[type=\"range\"] { width: 100%; min-height: 2rem; accent-color: rgb(15, 118, 110); cursor: pointer; }\n.diss-calibration output { min-width: 3.15rem; padding: 0.3rem 0.42rem; border-radius: 0.48rem; background: rgb(15, 118, 110); color: rgb(255, 255, 255); font-size: 0.7rem; font-weight: 900; text-align: center; }\n.diss-calibration[data-tone=\"adjust\"] output { background: rgb(180, 83, 9); }\n.diss-calibration[data-tone=\"caution\"] output { background: rgb(190, 18, 60); }\n.diss-calibration__status { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.38rem; margin: 0px; color: rgb(49, 91, 88); font-size: 0.62rem; line-height: 1.4; }\n.diss-calibration__status b { padding: 0.17rem 0.3