  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/9393.png",
      "text": "Igihe kimwe, harumwigeme yitwa Kabizi. Kabizi yar'umwigeme yavuga menshi. Naho nyina yamubujije kuvuga cane, Kabizi ntiyumvirije.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=1",
      "sourceDigest": "sha256:53d03f2855fdde9cc364f31a95626f8c41a3a89e6f6b74969dac80e8564d92b3"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/9392.png",
      "text": "Inasenge wa Kabizi yaba impande y'umugezi hakurya impande y'umusozi Kabizi abako. Umunsi umwe aragwara. Ntamuntu yarafise amugwaza.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=2",
      "sourceDigest": "sha256:f37f17c3cdd098ad32979752785f8debdad5994cff8a3e09f25e9acc91c383aa"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/9394.png",
      "text": "Nyina wa Kabizi yarafatiriwe cane. Bwari bwije mwijoro igihe yaha Kabizi impfungurwa ashire inasenge agwaye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=3",
      "sourceDigest": "sha256:ee4fbf41971503740542422313ed7a4c57eb9c9f1607f3deb523c343a3ff40e2"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/9395.png",
      "text": "Kabizi ahura munzira na Domi. Domi yari imfyisi yihinduye umuntu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=4",
      "sourceDigest": "sha256:e4aab95c0675c8a576e3193c4d70ae600322152d7eaa6946d4c2ec65eec42b0d"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/9448.png",
      "text": "Domi arabaza Kabizi, \"Nibiki wikoreye?\" Kabizi arishura, \"Nikoreye inyama, amagi n'amata.\" Nyina wa Kabizi yari yamubujije kuvuga ivyo yikoreye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=5",
      "sourceDigest": "sha256:35a6062b792b8444f6528be2bba6e6c7f19bf39808067f00779f962ca7ef2ff1"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/9449.png",
      "text": "Kabizi aravuga kandi, \"Nshiriye imfungurwa masenge.\" Domi yifyeta iminwa yiyumvira inyama Kabizi yikoreye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=6",
      "sourceDigest": "sha256:365dcfb45d8d8d86ce116d0cf2baaabd85efcc7fe2b8bf6b2ec4e27b3ba257f3"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/9450.png",
      "text": "Domi aritanganiza yiruka gushika kwa inasenge wa Kabizi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=7",
      "sourceDigest": "sha256:856f12a96469354edb63644a6ed723b558c0d748b56802552d709925333f29ce"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/9445.png",
      "text": "Domi amira inasenge wa Kabizi hama acayifuka uburengeti bwiwe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=8",
      "sourceDigest": "sha256:354fe0fc8bfacc9c96a8585feb11fcd14d8bdbc5b4e29ef792d33a84714217e9"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/9447.png",
      "text": "Kabizi ashitse, haragacerere mu nzu. Arinjira indani ahamagara, \"Senge, uri hehe?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=9",
      "sourceDigest": "sha256:519041681cde9f0b14c5ad1e8b6d56aaeb15f52cdd0fcaed1443a83ebc4fb500"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/9446.png",
      "text": "Kabizi ntiyigeze yumva ijwi rya inasenge. Acagenda mu cumba ca inasenge. Aca atangara kubona umuntu yifutse uburengeti bunini.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=10",
      "sourceDigest": "sha256:2c88bad059a615eb6bf590dcfea86597c038d887d33ef1ce4ff38cdf65e3f898"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/9451.png",
      "text": "Kabizi arabaza, \"Senge, kuberiki wagize amatwi manini uno munsi?\" Domi arishura ari muburengeti, \"Kugira ndakwumve neza.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=11",
      "sourceDigest": "sha256:f8b2d96bddd9c93d8742775e64eabe5189f66d627ce6dc1384e86b9717ab90a2"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/9452.png",
      "text": "Kabizi arabaza kandi, \"Senge, kuberiki wagize amaso manini uno munsi?\" Domi arishura, \"Kugira ndakubone neza.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=12",
      "sourceDigest": "sha256:96ff09739446c21fd6a3976a5e627d75eada8a7e191dcc858dd8870cb5bec8a5"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/9453.png",
      "text": "Kabizi aheza abaza, \"Senge,kuberiki wagize umunwa munini uno munsi?\" Domi arishura, \"Kugira ndakurye!\" Arataruka ava kuburiri acamira Kabizi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=13",
      "sourceDigest": "sha256:710c7e9dc8c1fc6d408e1be21df5d957264fd905c8459409909de349a57e406f"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/9522.png",
      "text": "Kabizi yabandanije avuga nigihe yari munda kwa Domi. Abaza ibibazo vyinshi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=14",
      "sourceDigest": "sha256:519db7851369b2d2098c940c740d2e033e89f2c265357e5f8b3e66cd694bf3fd"
    },
    {
      "n": 15,
      "img": "https://www.africanstorybook.org/illustrations/pages/9523.png",
      "text": "Birangira Domi arushe nibibazo vyinshi Kabizi yamubaza hama ahitamwo kumudahwa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=15",
      "sourceDigest": "sha256:8b1be3ed39a7c7cdd3376c31a10452327ec01a18e3e72fc1302e4e480cdd565b"
    },
    {
      "n": 16,
      "img": "https://www.africanstorybook.org/illustrations/pages/9455.png",
      "text": "Kabizi na inasenge batabawe nababanyi. Kuva ico gihe, Kabizi ntiyasubiye kuvuga menshi kubanyamahanga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47402#page=16",
      "sourceDigest": "sha256:ac6cc377565411940bab52ac6ab41e8ef558a521b8f2c061c410fa5b388bc367"
    }
  ],
