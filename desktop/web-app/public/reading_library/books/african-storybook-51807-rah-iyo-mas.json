  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/18783.png",
      "text": "Rah iyo Mas ayaa saaxiibay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=1",
      "sourceDigest": "sha256:e0a6efa135d013ad1e36892b96cbbac004b6846d80a2fc5f96c1b53c8b7efed3"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/18784.png",
      "text": "Rahi baa yiri, \"I soo raac si aan hooyaday u soo booqanno.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=2",
      "sourceDigest": "sha256:adc9b749ba5dc38cfccdeca436cc819408c026c104f596c08d035190d33a1326"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25000.png",
      "text": "\"Mahadsanid,\" ayuu yiri Maskii. \"Yaa ilaalinaaya guryaheena?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=3",
      "sourceDigest": "sha256:035712ede93962ec21acbf3de8fac0e2295a8614b3efec1fc9ea803fad8528d5"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25001.png",
      "text": "\"Anigaa ilaalindoona guryahiina,\" ayaa Daayeer yiri.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=4",
      "sourceDigest": "sha256:a7ee9c6eaf82c25a59bb7990671574bb45ed24ec95191c25432ba3a02ec1ce25"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25002.png",
      "text": "Rahii aboor ayuu hooyadiis boorso ugu ridey.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=5",
      "sourceDigest": "sha256:1370e857e093e41ba6e563dd925cc04e26e8eaddf924b7df4da29d2033c48af1"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25003.png",
      "text": "Rahii iyo Maskii waxay baxeen goor waaberiya. Waxay gaadheen kayn.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=6",
      "sourceDigest": "sha256:3e68ceb7057f2e74a94b3a90f719fbb7ce2f15e013570854011624cd54875de3"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25004.png",
      "text": "Waxay la kulmeen koox dabagaalayaala. Maskii wuu ka cabsaday.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=7",
      "sourceDigest": "sha256:b088ccc8f341f13057f2058b8f056c64c6bfdf2e39a37aa03ff325fe5fbdbb2f"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25005.png",
      "text": "Rahii baa badbaadiyey saaxiibkiis.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=8",
      "sourceDigest": "sha256:c405d35f784c845bced61507c70d8b998880ef15f797ecb6c653f7a62ae2d458"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/25006.png",
      "text": "Way gaajoonayeen markay gaadheen guriga hooyada.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=9",
      "sourceDigest": "sha256:a9d6d373369e0290eb54b7c659211d09605db1cd35a827ba15b849efe2f36b1b"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/25007.png",
      "text": "Way qubaysteen, waxayna u diyaar garoobeen inay wax cunaan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=10",
      "sourceDigest": "sha256:71d510402c8084aa271411f3db239d390261578b8037c066df1da236bc11026a"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/25008.png",
      "text": "\"Maskow, fadlan si toosan u fadhiiso,\" ayuu yiri Rahii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=11",
      "sourceDigest": "sha256:a798745b84bb5b41b0ad86b7cdc0fba105ad92a67f7f8509d97f03972108623d"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/25009.png",
      "text": "Maskii wuu isku deyey inuu si toosan u fadhiisto, laakiin ma aha Rah.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=12",
      "sourceDigest": "sha256:832a72ccf4c30b9dc0fc7dca196eb80e351333610edf65ed73507fb14e70941e"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/25010.png",
      "text": "\"Annigu uma fadhiisankaro sida rah,\" ayuu yiri Maskii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=13",
      "sourceDigest": "sha256:f037f0a49d9c06784e8ef5de9e3700bcc34c4f1919d3a8f8627cd1e5f4fe9daf"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/25011.png",
      "text": "Rahii wuu dhegaysan waayey.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=14",
      "sourceDigest": "sha256:0f1c8c25b5ff7f843ac013baa99e53f39e4588cde4b999828f988543c1fde5fd"
    },
    {
      "n": 15,
      "img": "https://www.africanstorybook.org/illustrations/pages/25012.png",
      "text": "\"Waad i fahmi weydey. Gurigaygii baan iska tegin.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=15",
      "sourceDigest": "sha256:266e350acdc66c659101978e6494d6acc8d6fe4f743a88df93d63732e9796ad2"
    },
    {
      "n": 16,
      "img": "https://www.africanstorybook.org/illustrations/pages/25013.png",
      "text": "Maskii isaga oo ka xun buu yiri. \"Waxaan moodey in Rahu yahay saaxiibkay.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51807#page=16",
      "sourceDigest": "sha256:1aac411bcf40e01931cc473c046f31d9d47ab57fcfc90bcd942b139e6b714fe7"
    }
  ],
