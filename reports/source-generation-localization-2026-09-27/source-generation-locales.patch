+import { beforeAll, afterEach, describe, it, expect } from 'vitest';
+import { fixtures, english, BODY, hostTranslator, setupEngine, sourceHarness, finish, cleanupEngine } from './helpers/source_generation_locale_harness.js';
+const errorKey = 'input.error_no_source_content', partialKey = 'input.source_partial_generation';
+const lookup = key => key.split('.').reduce((object, part) => object[part], english);
+const readable = text => { expect(typeof text).toBe('string'); expect(text.trim()).not.toBe(''); expect(text).not.toMatch(/input\.(?:error_no_source_content|source_partial_generation)|\{(?:failed|total)\}/); };
+beforeAll(setupEngine);
+afterEach(cleanupEngine);
+describe('source-generation notices use real locale packs and host interpolation', () => {
+  for (const fixture of fixtures) {
+    it(fixture.id + ': empty generation explains preservation in the interface language', async () => {
+      const h = sourceHarness(fixture); await finish(h);
+      expect(h.state.error).toBe(hostTranslator(fixture.locale)(errorKey)); readable(h.state.error);
+      expect(h.callGemini.mock.calls[0][0]).toContain(fixture.uiLanguage);
+      expect(h.state.inputText).toBe(fixture.oldInput); expect(h.state.generatedContent).toBe(h.priorReading); expect(h.state.activeView).toBe('output');
+      expect(h.state.recordSourceProvenance).not.toHaveBeenCalled(); expect(h.state.setInputText).not.toHaveBeenCalled();
+      expect(h.state.showSourceGen).toBe(true); expect(h.state.isGeneratingSource).toBe(false); expect(h.unexpected).toEqual([]);
+    });
+    it(fixture.id + ': partial generation interpolates the exact missing/total counts', async () => {
+      const h = sourceHarness(fixture, { partial: true }); await finish(h);
+      const warnings = h.addToast.mock.calls.filter(([, level]) => level === 'warning');
+      expect(warnings).toHaveLength(1);
+      expect(warnings[0][0]).toBe(hostTranslator(fixture.locale)(partialKey, { failed: 2, total: 3 })); readable(warnings[0][0]);
+      expect(h.state.inputText).toContain(BODY); expect(h.state.inputText).not.toContain('## Evaporation'); expect(h.state.inputText).not.toContain('## Rain');
+      expect(h.state.setInputText).toHaveBeenCalledTimes(1); expect(h.state.recordSourceProvenance).toHaveBeenCalledTimes(1); expect(h.state.error).toBeNull(); expect(h.unexpected).toEqual([]);
+    });
+    it(fixture.id + ': respects translator placeholder order and numeric zero', () => {
+      const t = hostTranslator(fixture.locale), message = t(partialKey, { failed: 0, total: 12 });
+      expect(message).toContain('0'); expect(message).toContain('12'); readable(message);
+      if (fixture.locale === 'chinese_simplified') expect(message.indexOf('12')).toBeLessThan(message.indexOf('0'));
+    });
+  }
+  for (const mode of ['missing','echoed','blank','throwing','non-string']) it(mode + ': the owned messages retain readable English fallback for both outcomes', async () => {
+    const faulty = mode === 'missing' ? () => undefined : mode === 'echoed' ? key => key : mode === 'blank' ? () => '  ' : mode === 'non-string' ? () => ({ value: 'bad catalog' }) : () => { throw Error('Catalog unavailable'); };
+    const base = hostTranslator('arabic'), translate = (key, values) => [errorKey,partialKey].includes(key) ? faulty(key, values) : base(key, values);
+    const failed = sourceHarness(fixtures.find(f => f.locale === 'arabic'), { translate }); await finish(failed);
+    expect(failed.state.error).toBe(lookup(errorKey)); readable(failed.state.error);
+    expect(failed.state.inputText).toBe(fixtures.find(f => f.locale === 'arabic').oldInput);
+    const partial = sourceHarness(fixtures.find(f => f.locale === 'arabic'), { translate, partial: true }); await finish(partial);
+    const message = partial.addToast.mock.calls.find(([, level]) => level === 'warning')[0];
+    expect(message).toBe(lookup(partialKey).replace('{failed}', '2').replace('{total}', '3')); readable(message);
+  });
+  it('a missing Arabic pack entry uses the registered English catalog while preserving the Arabic reading', async () => {
+    const fixture = fixtures.find(f => f.locale === 'arabic'), translate = hostTranslator(fixture.locale, {});
+    const h = sourceHarness(fixture, { translate }); await finish(h);
+    expect(h.state.error).toBe(lookup(errorKey)); expect(h.state.generatedContent.config.language).toBe('ar'); expect(h.state.inputText).toBe(fixture.oldInput);
+  });
+});
