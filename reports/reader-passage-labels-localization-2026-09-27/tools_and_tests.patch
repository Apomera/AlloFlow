diff --git a/tests/helpers/reader_passage_label_harness.js b/tests/helpers/reader_passage_label_harness.js
new file mode 100644
--- /dev/null
+++ b/tests/helpers/reader_passage_label_harness.js
@@ -0,0 +1,65 @@
+import { createRequire } from 'node:module';
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { vi } from 'vitest';
+import { loadAlloModule } from '../setup.js';
+const require = createRequire(import.meta.url);
+export const React = require(resolve('desktop/web-app/node_modules/react'));
+const { createRoot } = require(resolve('desktop/web-app/node_modules/react-dom/client'));
+export const act = React.act;
+export const fixtures = JSON.parse(readFileSync('tests/fixtures/reader_passage_label_locales.json', 'utf8'));
+export const payload = JSON.parse(readFileSync('translations/reader-passage-label-locales.json', 'utf8'));
+export const english = JSON.parse(readFileSync('ui_strings.js', 'utf8'));
+const packs = new Map(fixtures.map(f => [f.locale, f.locale === 'English' ? {} : JSON.parse(readFileSync('lang/' + f.locale + '.js', 'utf8'))]));
+const hostSource = readFileSync(process.env.ALLO_PASSAGE_HOST_SOURCE || 'AlloFlowANTI.txt', 'utf8');
+const callbacks = [...hostSource.matchAll(/const t = useCallback\((\(keyString, params = \{\}\) => \{[\s\S]+?\}), \[languagePack\]\);/g)];
+if (callbacks.length !== 1) throw Error('Host translator extraction needs review.');
+const translate = new Function('languagePack', 'UI_STRINGS', 'WORD_SOUNDS_STRINGS', 'return (' + callbacks[0][1] + ');');
+export function translator(fixture, overrides = {}) {
+  const pack = packs.get(fixture.locale);
+  return translate({ ...pack, simplified: { ...pack.simplified, ...overrides } }, english, {});
+}
+export function copy(fixture, leaf) { return (payload.locales[fixture.locale] || payload.english)['simplified.' + leaf]; }
+let View, contract, root, host;
+export function setupDraftReader() {
+  globalThis.React = window.React = React; globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+  window.AlloIcons = new Proxy({}, { get: () => () => null });
+  for (const file of ['instructional_context_module.js','alt_text_module.js','pure_helpers_module.js','phase_n_misc_helpers_module.js','view_simplified_module.js']) loadAlloModule(file);
+  contract = window.AlloModules.InstructionalContext;
+  const files = ['reader_place_store.js','reader_support_drafts.js',process.env.ALLO_PASSAGE_LABEL_SOURCE || 'view_simplified_source.jsx'];
+  const compiled = require('@babel/core').transformSync(files.map(f => readFileSync(f, 'utf8')).join('\n'), { plugins: ['@babel/plugin-transform-react-jsx'], babelrc: false, configFile: false, parserOpts: { sourceType: 'script', plugins: ['jsx'] } }).code;
+  View = new Function('React', 'Fragment', compiled + '\nreturn SimplifiedView;')(React, React.Fragment);
+}
+export function cleanupDraftReader() { if (root) act(() => root.unmount()); root = null; host?.remove(); host = null; delete window.__alloT; vi.restoreAllMocks(); }
+export const click = async node => { if (!node) throw Error('Missing control'); await act(async () => node.click()); };
+export const type = (node, value) => act(() => { Object.getOwnPropertyDescriptor(node.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype, 'value').set.call(node, value); node.dispatchEvent(new Event('input', { bubbles: true })); });
+export function mountDraft(fixture, { adapted = true, translate: t = translator(fixture), outcome = 'complete', pending } = {}) {
+  window.__alloT = t;
+  const id = fixture.id + (adapted ? '-adapted' : '-original');
+  const makeItem = text => adapted ? { id, _artifactInstanceId: id, type: 'simplified', data: text, config: { language: fixture.tag }, instructionalText: { form: 'adapted', role: 'supplemental' } } : contract.createSupportedReading(contract.createSourceSnapshot(text, { language: fixture.tag }), { id });
+  let item = makeItem(fixture.passage), supports, stale = false;
+  const upsert = (owner, existing, annotation) => adapted ? contract.upsertAdaptedReadingSupport(owner, existing, annotation) : contract.upsertReadingSupport(owner, existing, annotation);
+  const annotationFor = text => { const start = text.indexOf(fixture.word); return { id: 'word-' + start, start, end: start + fixture.word.length, quote: fixture.word, text: 'Prepared explanation.', origin: 'educator', kind: 'gloss', priority: 'essential' }; };
+  supports = upsert(item, undefined, annotationFor(fixture.passage));
+  if (supports?.annotations?.length !== 1) throw Error('Fixture support rejected: ' + fixture.id);
+  const session = window.AlloModules.ReaderSupportDrafts.createSession();
+  const onUpdate = vi.fn(async (owner, action) => {
+    if (pending) await pending;
+    if (outcome === 'reject') throw Error('Fixture pin save failed.');
+    const saved = action.type === 'pin' ? contract.setReadingSupportPinned(owner, supports, action.id, action.pinned === true) : upsert(owner, supports, action.annotation);
+    supports = saved; render(); return saved;
+  });
+  host = document.createElement('div'); host.dir = fixture.direction; host.lang = fixture.tag; document.body.append(host); root = createRoot(host);
+  function render() { root.render(React.createElement(View.ReadingGlossEditor, { item, supports, onUpdate, adapted, snapshot: adapted ? contract.createSourceSnapshot(item.data, { language: fixture.tag }) : undefined, embedded: true, disabled: false, supportsStale: stale, draftSession: session })); }
+  act(render);
+  const button = text => [...host.querySelectorAll('button')].find(n => n.textContent.trim() === text);
+  const input = () => host.querySelector('[data-gloss-draft] textarea');
+  return { host, onUpdate, session, button, input, t,
+    edit: async value => { await click([...host.querySelectorAll('button')].find(n => n.getAttribute('aria-label')?.startsWith('Edit gloss for'))); type(input(), value); },
+    change: (unreviewed = false) => act(() => { item = makeItem(fixture.changed); stale = unreviewed; if (!unreviewed) supports = upsert(item, undefined, annotationFor(fixture.changed)); render(); }),
+    saved: () => supports,
+    current: () => item,
+    saveButton: () => button(t('simplified.gloss_save_word_support')),
+    requestAdd: async () => click(button(t('simplified.gloss_add_a_word_or_phrase'))),
+  };
+}
