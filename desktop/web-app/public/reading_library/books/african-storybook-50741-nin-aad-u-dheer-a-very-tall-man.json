    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/309.png",
      "text": "Yaambadiisu aad bay u gaabnayd. His hoe was too short.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=1",
      "sourceDigest": "sha256:6a3d761267808b1bc5fc4b6afe4ce358f39709f1fa1de7e4be8455d9cc7f2aca"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/310.png",
      "text": "Furitaanka albaabkiisu aad bay u hooseeysay. His doorway was too low.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=2",
      "sourceDigest": "sha256:ff8e0a1ba4f365ae773188a458f566ff714c3c41ea1883966b7f14127cf8ffb0"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/311.png",
      "text": "Sariirtiisu aad bay u gaabanayd. His bed was too short.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=3",
      "sourceDigest": "sha256:063122515197a9741910b2802fe9eb75f00ce11e4b74922bbdac117cae680fa8"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/314.png",
      "text": "Baaskiilkiisu aad buu u gaabnaa. His bicycle was too short.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=4",
      "sourceDigest": "sha256:7e22c45d617b39fc83a6e18169fa181194badd3f68c78209e28ce8cf0d67a658"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/313.png",
      "text": "Ninkani si xad dhaaf ah ayuu u dheeraa! This man was too tall!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=5",
      "sourceDigest": "sha256:fb1a76028080073d0f8e3dfa8ba66fa7a99866de4f5b5784c3b660ae9247740f"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/316.png",
      "text": "Wuxuu sameeyay yaambo daab aad u dheer leh. He made a very long hoe handle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=6",
      "sourceDigest": "sha256:52e16cf9c1b8cbff5ac959e97f7c889b621cd17038f749bc03b21cf26d49b22f"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/315.png",
      "text": "Wuxuu sameeyay albaab irrid aad u dheer leh. He made very high door frames.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=7",
      "sourceDigest": "sha256:6415974911046b8c32bfd77523b51e69dbcca6c738c00c48373d031e8683a790"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/317.png",
      "text": "Wuxuu sameeyay sariir aad u dheer. He made a very long bed.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=8",
      "sourceDigest": "sha256:09fe1c6eedc8d30b99de1928e0c8a5d7eedcc4d0fef6672217829425a8534871"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/318.png",
      "text": "Wuxuu iibsaday baaskiil aad kor ugu dheer. He bought a very high bicycle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=9",
      "sourceDigest": "sha256:8f88b8a35efd4ba015168a4e1fc3bb4ba5b8e67e567b96cba4320c941504bf58"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/319.png",
      "text": "Wuxuu ku fariistay kursi aad u dheer. Wuxuu wax ku cunay fargeeto aad u dheer. He sat on a very high chair. He ate with a very long fork.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=10",
      "sourceDigest": "sha256:91108d1e7536ba406c951c1be98d7e02578a21b05cefec02eddc29d6ae9beb70"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/320.png",
      "text": "Wuu kka tagay gurigiissii oo wuxuu ku noolaa keyn wayn. Sannadyo badan ayuu noolaa. He left his house and lived in a big forest. He lived for many years.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=50741#page=11",
      "sourceDigest": "sha256:1f843579acca525be9078e1fe097d32d9fdc18f7d0b1796ba4aa99988c8e4974"
    }
  ],
