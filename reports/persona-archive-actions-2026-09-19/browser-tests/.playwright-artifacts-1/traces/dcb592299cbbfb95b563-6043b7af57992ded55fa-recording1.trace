ue_to_the_next_check","v":{"s":"Base pairing confirmed. Continue to the next checkpoint."}},{"k":"sr_dna_evidence_summary_saved","v":{"s":"DNA evidence summary saved."}},{"k":"sr_dna_replication_complete_two_identical_copies_cre","v":{"s":"DNA replication complete! Two identical copies created."}},{"k":"sr_new_dna_prediction_ready_the_current_sequence_wil","v":{"s":"New DNA prediction ready. The current sequence will be used."}},{"k":"sr_choose_a_prediction_before_running_the_scenario","v":{"s":"Choose a prediction before running the scenario."}},{"k":"sr_the_dna_changed_review_the_new_planned_edit_and_c","v":{"s":"The DNA changed. Review the new planned edit and choose a new prediction."}},{"k":"sr_prediction_locked_and_scenario_complete_inspect_t","v":{"s":"Prediction locked and scenario complete. Inspect the actual mutation effect."}},{"k":"sr_cas9_scanning_dna_for_target_sequence","v":{"s":"Cas9 scanning DNA for target sequence..."}},{"k":"sr_cas9_found_target_pam_site_located_ready_to_cut","v":{"s":"Cas9 found target! PAM site located. Ready to cut."}},{"k":"sr_opening_the_punnett_square_lab","v":{"s":"Opening the Punnett Square Lab."}},{"k":"sr_returned_to_tool_grid","v":{"s":"Returned to tool grid"}},{"k":"sr_random_sequence","v":{"s":"Random sequence"}},{"k":"a11y_mutation_trail_color_legend","v":{"s":"Mutation trail color legend"}},{"k":"a11y_nucleotide_alignment_legend","v":{"s":"Nucleotide alignment legend"}},{"k":"a11y_dna_to_protein_evidence_stages","v":{"s":"DNA to protein evidence stages"}},{"k":"a11y_impact_map_legend","v":{"s":"Impact map legend"}},{"k":"a11y_changed_codon_footprint","v":{"s":"Changed codon footprint"}},{"k":"a11y_open_student_dna_lab_report","v":{"s":"Open student DNA lab report"}},{"k":"a11y_dna_lab_view_mode","v":{"s":"DNA Lab view mode"}},{"k":"a11y_explanation_reading_level","v":{"s":"Explanation reading level"}},{"k":"a11y_dna_lab_tools","v":{"s":"DNA Lab tools"}},{"k":"a11y_live_sequence_summary","v":{"s":"Live sequence summary"}},{"k":"a11y_dna_learning_paths","v":{"s":"DNA learning paths"}},{"k":"a11y_core_dna_workflow","v":{"s":"Core DNA workflow"}},{"k":"a11y_scenario_inquiry_progress","v":{"s":"Scenario inquiry progress"}},{"k":"a11y_choose_a_dna_scenario","v":{"s":"Choose a DNA scenario"}},{"k":"a11y_predict_the_mutation_effect","v":{"s":"Predict the mutation effect"}},{"k":"a11y_how_the_dna_evidence_affected_your_thinking","v":{"s":"How the DNA evidence affected your thinking"}},{"k":"a11y_dna_lab_report_reflection_or_claim","v":{"s":"DNA lab report reflection or claim"}},{"k":"a11y_choose_an_evidence_based_claim","v":{"s":"Choose an evidence-based claim"}},{"k":"a11y_choose_evidence_to_cite","v":{"s":"Choose evidence to cite"}},{"k":"a11y_explain_how_the_evidence_supports_the_claim","v":{"s":"Explain how the evidence supports the claim"}},{"k":"a11y_choose_dna_strand_view","v":{"s":"Choose DNA strand view"}},{"k":"a11y_load_an_example_dna_sequence","v":{"s":"Load an example DNA sequence"}},{"k":"a11y_choose_a_forward_mrna_reading_frame","v":{"s":"Choose a forward mRNA reading frame"}},{"k":"a11y_reading_frame_color_legend","v":{"s":"Reading frame color legend"}},{"k":"a11y_before_and_after_codon_comparison","v":{"s":"Before and after codon comparison"}},{"k":"a11y_experiment_checkpoint_legend","v":{"s":"Experiment checkpoint legend"}},{"k":"a11y_saved_dna_experiment_checkpoints_swipe_horizont","v":{"s":"Saved DNA experiment checkpoints. Swipe horizontally or use arrow keys to inspect each card."}},{"k":"a11y_comparison_slots","v":{"s":"Comparison slots"}},{"k":"a11y_choose_first_saved_experiment","v":{"s":"Choose first saved experiment"}},{"k":"a11y_choose_second_saved_experiment","v":{"s":"Choose second saved experiment"}},{"k":"a11y_saved_experiment_codon_comparison","v":{"s":"Saved experiment codon comparison"}},{"k":"a11y_saved_experiment_comparison_reflection","v":{"s":"Saved experiment comparison reflection"}},{"k":"a11y_crispr_editing_progress","v":{"s":"CRISPR editing progress"}},{"k":"a11y_crispr_scan_speed","v":{"s":"CRISPR scan speed"}},{"k":"a11y_choose_the_donor_template_base_for_the_hdr_mode","v":{"s":"Choose the donor-template base for the HDR model"}},{"k":"a11y_choose_the_comparison_sample","v":{"s":"Choose the comparison sample"}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"dna_genetics_lab","v":{"s":"🧬 DNA / Genetics Lab"}},{"k":"build_replicate_transcribe_translate_m","v":{"s":"Build • Replicate • Transcribe • Translate • Mutate • CRISPR • Forensics"}},{"k":"snapshot","v":{"s":"Save DNA snapshot"}},{"k":"grade","v":{"s":"🎓 Grade:"}},{"k":"build_the_double_helix_from_4_letters","v":{"s":"Build - the double helix from 4 letters"}},{"k":"a_pairs_with_t_2_bonds_g_with_c_3_wats","v":{"s":"A pairs with T (2 bonds), G with C (3). Watson + Crick + Franklin (1953) cracked the structure from X-ray crystallography. The shape itself encodes how DNA copies and reads."}},{"k":"replicate_unzip_copy_rezip","v":{"s":"Replicate - unzip, copy, rezip"}},{"k":"helicase_splits_the_strands_dna_polyme","v":{"s":"Helicase splits the strands; DNA polymerase synthesizes complements. Semi-conservative: each new helix has one old strand + one new. Meselson & Stahl proved it 1958."}},{"k":"transcribe_dna_mrna_in_the_nucleus","v":{"s":"Transcribe - DNA → mRNA in the nucleus"}},{"k":"rna_polymerase_reads_one_dna_strand_3_","v":{"s":"RNA polymerase reads one DNA strand 3′→5′ and builds RNA 5′→3′. Same letters except T becomes U. mRNA carries the recipe out to the ribosomes - the central dogma’s first arrow."}},{"k":"translate_mrna_protein_at_the_ribosome","v":{"s":"Translate - mRNA → protein at the ribosome"}},{"k":"64_codons_20_amino_acids_the_genetic_c","v":{"s":"64 codons → 20 amino acids (the genetic code is redundant). AUG starts; UAA/UAG/UGA stop. tRNA reads codons, charges them with the right amino acid, peptide bond forms."}},{"k":"mutate_substitution_insertion_deletion","v":{"s":"Mutate - substitution, insertion, deletion"}},{"k":"point_mutation_one_letter_swapped_inse","v":{"s":"Point mutation: one letter swapped. Insertion/deletion: frameshift, the entire downstream protein is garbled. Sickle-cell is a single A→T - one letter, lifelong consequence."}},{"k":"crispr_the_precision_edit","v":{"s":"CRISPR - the precision edit"}},{"k":"bacterial_immune_system_repurposed_cas","v":{"s":"Bacterial immune system, repurposed. Cas9 enzyme + guide RNA = molecular scissors. Doudna + Charpentier won the 2020 Nobel. First CRISPR therapy (sickle-cell) FDA-approved Dec 2023."}},{"k":"protein_fold_function_malfunction","v":{"s":"Protein - fold, function, malfunction"}},{"k":"sequence_determines_structure_determin","v":{"s":"Sequence determines structure determines function. Hemoglobin carries O₂, antibodies recognize, enzymes catalyze. AlphaFold (2020) predicted ~200M structures - a problem that took 50 years, cracked in 18 months."}},{"k":"forensics_str_profiling_dna_evidence","v":{"s":"Forensics - STR profiling + DNA evidence"}},{"k":"codis_uses_20_short_tandem_repeat_str_","v":{"s":"CODIS uses 20 short tandem repeat (STR) loci. Match probability is one-in-quadrillions when all loci agree. Innocence Project: 245+ wrongful convictions overturned by post-conviction DNA testing."}},{"k":"challenge_graded_problems","v":{"s":"Challenge - graded problems"}},{"k":"practice_transcription_translation_mut","v":{"s":"Practice transcription, translation, mutation classification. AP Bio Big Idea 3.A.1: DNA, sometimes RNA, is the primary source of heritable information. NGSS HS-LS3-1."}},{"k":"battle_head_to_head_retrieval","v":{"s":"Battle - head-to-head retrieval"}},{"k":"retrieval_practice_gamified_speed_buil","v":{"s":"Retrieval-practice gamified. Speed builds automaticity - once codon-table lookups are automatic, your working memory is free for higher-order thinking like predicting mutation impact."}},{"k":"learn_the_central_dogma_history","v":{"s":"Learn - the central dogma + history"}},{"k":"dna_rna_protein_with_retroviruses_hiv_","v":{"s":"DNA → RNA → protein - with retroviruses (HIV) running it backward via reverse transcriptase. Crick coined “dogma” in 1957; he later said he meant it as a hypothesis, not scripture."}},{"k":"build_a_dna_strand","v":{"s":"Build a DNA strand"}},{"k":"pick_a_sequence_the_complementary_stra","v":{"s":"Pick a sequence - the complementary strand fills in via base pairing (A-T, G-C). Real DNA is built like this constantly."}},{"k":"dna_replication","v":{"s":"DNA replication"}},{"k":"helicase_unwinds_the_helix_dna_polymer","v":{"s":"Helicase unwinds the helix; DNA polymerase reads each template strand and lays down its complement. Semiconservative - each daughter has one old + one new strand."}},{"k":"transcription_dna_mrna","v":{"s":"Transcription - DNA → mRNA"}},{"k":"rna_polymerase_reads_the_template_stra","v":{"s":"This lab displays the coding strand, so its mRNA readout matches that strand with U replacing T. In cells, RNA polymerase reads the antiparallel template strand to synthesize RNA 5′→3′."}},{"k":"translation_mrna_protein","v":{"s":"Translation - mRNA → protein"}},{"k":"ribosome_reads_codons_3_bases_at_a_tim","v":{"s":"Ribosome reads codons (3 bases at a time). Each codon → one amino acid. The genetic code is read in non-overlapping triplets, no commas."}},{"k":"mutations","v":{"s":"Mutations"}},{"k":"point_mutations_silent_no_protein_chan","v":{"s":"Substitutions may be synonymous, missense, or nonsense. A coding-region insertion or deletion shifts the frame only when its length is not divisible by three; effects depend on position and biological context."}},{"k":"crispr_cas9_editing","v":{"s":"CRISPR-Cas9 editing"}},{"k":"guide_rna_points_cas9_to_a_20_base_tar","v":{"s":"Real SpCas9 usually uses a 20-nt spacer beside an NGG PAM and cuts about three bases upstream. This compact schematic shows a six-base guide window and simplified repair outcomes."}},{"k":"protein_structure","v":{"s":"Protein structure"}},{"k":"primary_sequence_secondary_helix_sheet","v":{"s":"Primary (sequence) → secondary (α-helix, β-sheet) → tertiary (3D fold) → quaternary (multi-subunit). One amino acid swap can break the fold."}},{"k":"dna_forensics","v":{"s":"DNA forensics"}},{"k":"str_profiling_13_20_short_tandem_repea","v":{"s":"Forensic STR profiles compare many loci. Analysts evaluate data quality and calculate statistical weight using relevant population data; a matching profile alone does not identify how or when DNA was deposited."}},{"k":"daily_challenge","v":{"s":"Daily challenge"}},{"k":"a_new_dna_puzzle_every_session_transla","v":{"s":"A new DNA puzzle every session. Translate, identify the mutation, find the ORF, or solve a forensic case. Streak counter tracks daily wins."}},{"k":"codon_battle","v":{"s":"Codon battle"}},{"k":"speed_translation_duel_decode_codons_f","v":{"s":"Speed-translation duel. Decode codons fast against a timer. Tests whether the genetic code is in your head, not just your reference card."}},{"k":"reference_glossary","v":{"s":"Reference + glossary"}},{"k":"codon_table_base_pairing_rules_key_ter","v":{"s":"Codon table, base-pairing rules, key terms (ORF, intron, exon, promoter, repressor) - the cheat sheet you keep coming back to."}},{"k":"dna_helix_visualization","v":{"s":"DNA helix visualization"}},{"k":"coding_strand_5_3","v":{"s":"Coding Strand (5'→3')"}},{"k":"random","v":{"s":"🎲 Random"}},{"k":"dna_replication_fork_visualization","v":{"s":"DNA replication fork visualization"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"helicase","v":{"s":"Helicase"}},{"k":"dna_pol_iii","v":{"s":"DNA Pol III"}},{"k":"leading_continuous","v":{"s":"Leading (continuous)"}},{"k":"lagging_okazaki","v":{"s":"Lagging (Okazaki)"}},{"k":"reset_2","v":{"s":"↺ Reset"}},{"k":"mrna_is_a_copy_of_the_coding_strand_wi","v":{"s":"💡 mRNA is a copy of the coding strand with U in place of T. (RNA Polymerase actually reads the complementary template strand 3'→5', which yields the same sequence as the coding strand.)"}},{"k":"ribosome_translation","v":{"s":"🔬 Ribosome Translation"}},{"k":"press_start_to_begin","v":{"s":"Press Start to begin..."}},{"k":"ribosome_translation_simulator","v":{"s":"Ribosome Translation Simulator"}},{"k":"reset_3","v":{"s":"↺ Reset"}},{"k":"mutation_simulator","v":{"s":"Mutation Simulator"}},{"k":"substitution","v":{"s":"🔄 Substitution"}},{"k":"insertion","v":{"s":"➕ Insertion"}},{"k":"deletion","v":{"s":"➖ Deletion"}},{"k":"reset_4","v":{"s":"↺ Reset"}},{"k":"mutation_log","v":{"s":"📋 Mutation Log:"}},{"k":"ai_analysis","v":{"s":"🧠 AI Analysis"}},{"k":"crispr_cas9_gene_editing_simulation","v":{"s":"CRISPR-Cas9 gene editing simulation"}},{"k":"crispr_cas9_gene_editor","v":{"s":"CRISPR-Cas9 Gene Editor"}},{"k":"step_1_select_pam_target_site","v":{"s":"Step 1: Select PAM Target Site"}},{"k":"no_pam_sites_ngg_found_try_a_different","v":{"s":"⚠️ No forward-strand NGG sites with enough upstream sequence were found. Try a longer preset from Build."}},{"k":"deploy_cas9","v":{"s":"🚀 Deploy Cas9"}},{"k":"double_strand_break_created_choose_rep","v":{"s":"✂️ Double-strand break created! Choose repair pathway:"}},{"k":"nhej","v":{"s":"🔧 NHEJ"}},{"k":"non_homologous_end_joining","v":{"s":"Non-Homologous End Joining"}},{"k":"hdr","v":{"s":"🧬 HDR"}},{"k":"homology_directed_repair","v":{"s":"Homology-Directed Repair"}},{"k":"new_edit","v":{"s":"↺ New Edit"}},{"k":"crispr_edit_history","v":{"s":"📋 CRISPR Edit History:"}},{"k":"crispr_quick_reference","v":{"s":"📚 CRISPR Quick Reference"}},{"k":"what_is_crispr","v":{"s":"What is CRISPR?"}},{"k":"crispr_clustered_regularly_interspaced","v":{"s":"CRISPR (Clustered Regularly Interspaced Short Palindromic Repeats) is a gene editing technology adapted from bacteria's immune defense."}},{"k":"key_components","v":{"s":"Key Components:"}},{"k":"the_molecular_scissors_endonuclease","v":{"s":" - The molecular scissors (endonuclease)"}},{"k":"guide_rna","v":{"s":"Guide RNA"}},{"k":"a_20nt_rna_that_directs_cas9_to_the_ta","v":{"s":" - A ~20nt RNA that directs Cas9 to the target"}},{"k":"protospacer_adjacent_motif_ngg_require","v":{"s":" - Protospacer Adjacent Motif (NGG). Required for binding."}},{"k":"gene_therapy_sickle_cell_casgevy_cance","v":{"s":"Gene therapy (sickle cell → CASGEVY™), cancer immunotherapy, crop engineering, disease models."}},{"k":"nonpolar_hydrophobic","v":{"s":"Nonpolar (Hydrophobic)"}},{"k":"ala_val_leu_ile_pro_phe_trp_met_gly","v":{"s":"Ala, Val, Leu, Ile, Pro, Phe, Trp, Met, Gly"}},{"k":"polar_hydrophilic","v":{"s":"Polar (Hydrophilic)"}},{"k":"ser_thr_cys_tyr_asn_gln","v":{"s":"Ser, Thr, Cys, Tyr, Asn, Gln"}},{"k":"positively_charged","v":{"s":"Positively Charged"}},{"k":"arg_lys_his","v":{"s":"Arg, Lys, His"}},{"k":"negatively_charged","v":{"s":"Negatively Charged"}},{"k":"asp_glu","v":{"s":"Asp, Glu"}},{"k":"protein_analysis","v":{"s":"🧠 Protein Analysis"}},{"k":"run_transcription_and_translation_firs","v":{"s":"Run Transcription and Translation first!"}},{"k":"genetic_disorders_reference","v":{"s":"🦠 Genetic Disorders Reference"}},{"k":"silent","v":{"s":"Silent"}},{"k":"missense","v":{"s":"Missense"}},{"k":"nonsense","v":{"s":"Nonsense"}},{"k":"frameshift","v":{"s":"Frameshift"}},{"k":"in_frame_indel","v":{"s":"In-frame indel"}},{"k":"mutation_effect_sleuth","v":{"s":"Mutation Effect Sleuth"}},{"k":"predict_the_effect_type_from_5_options","v":{"s":"Predict the effect type from 5 options."}},{"k":"10_mutation_vignettes_each_shows_a_sho","v":{"s":"10 mutation vignettes. Each shows a short before/after DNA sequence with the change highlighted. Pick the effect type - silent, missense, nonsense, frameshift, or in-frame indel. Coaching after each pick names what makes this effect more likely than the others."}},{"k":"start_mutation_effect_sleuth","v":{"s":"Start Mutation Effect Sleuth"}},{"k":"start_vignette_1_of_10","v":{"s":"🕵️ Start - vignette 1 of 10"}},{"k":"vignette","v":{"s":"Vignette "}},{"k":"score","v":{"s":"Score "}},{"k":"accuracy","v":{"s":"Accuracy "}},{"k":"streak","v":{"s":"Streak "}},{"k":"best","v":{"s":"Best "}},{"k":"aa_before","v":{"s":"AA before: "}},{"k":"aa_after","v":{"s":"AA after:  "}},{"k":"pick_the_mutation_effect_type","v":{"s":"Pick the mutation effect type"}},{"k":"all_10_vignettes_complete","v":{"s":"🏆 All 10 vignettes complete"}},{"k":"restart","v":{"s":"🔄 Restart"}},{"k":"next_vignette","v":{"s":"➡️ Next vignette"}},{"k":"dna_forensics_gel_electrophoresis","v":{"s":"DNA Forensics - Gel Electrophoresis"}},{"k":"run_gel_electrophoresis","v":{"s":"⚡ Run Gel Electrophoresis"}},{"k":"gel_electrophoresis_results","v":{"s":"Gel electrophoresis results"}},{"k":"submit_answer","v":{"s":"✓ Submit Answer"}},{"k":"next_case","v":{"s":"↻ Next Case"}},{"k":"forensic_analysis","v":{"s":"🧠 Forensic Analysis"}},{"k":"dna_challenge","v":{"s":"🎯 DNA Challenge"}},{"k":"test_your_genetics_knowledge","v":{"s":"Test your genetics knowledge!"}},{"k":"start_challenge","v":{"s":"🎯 Start Challenge"}},{"k":"ai_generated","v":{"s":"🧠 AI-GENERATED"}},{"k":"type_your_answer","v":{"s":"Type your answer..."}},{"k":"answer","v":{"s":"Answer"}},{"k":"check","v":{"s":"✓ Check"}},{"k":"hint","v":{"s":"💡 Hint"}},{"k":"next","v":{"s":"↻ Next"}},{"k":"codon_reference_table","v":{"s":"📖 Codon Reference Table"}},{"k":"gene_defense_battle","v":{"s":"Gene Defense Battle"}},{"k":"you","v":{"s":"🛡️ You"}},{"k":"virus","v":{"s":"🦠 Virus"}},{"k":"start_battle","v":{"s":"⚔️ Start Battle"}},{"k":"ai_battle","v":{"s":"✨ AI Battle"}},{"k":"play_again","v":{"s":"↺ Play Again"}},{"k":"ai_rematch","v":{"s":"✨ AI Rematch"}},{"k":"ai_generating_question","v":{"s":"AI generating question..."}},{"k":"ai_generated_2","v":{"s":"🧠 AI-GENERATED"}},{"k":"type_your_answer_2","v":{"s":"Type your answer..."}},{"k":"battle_answer","v":{"s":"Battle answer"}},{"k":"attack","v":{"s":"⚔️ Attack!"}},{"k":"hint_2","v":{"s":"💡 Hint"}},{"k":"learn_genetics_concepts","v":{"s":"📚 Learn - Genetics Concepts"}},{"k":"try_it","v":{"s":"🔬 Try It"}},{"k":"read_aloud","v":{"s":"🔊 Read Aloud"}},{"k":"methionine","v":{"s":"Methionine"}},{"k":"start_codon","v":{"s":"START codon"}},{"k":"opal_sometimes_selenocysteine","v":{"s":"opal (sometimes selenocysteine)"}},{"k":"phenylalanine","v":{"s":"Phenylalanine"}},{"k":"aromatic_hydrophobic","v":{"s":"Aromatic, hydrophobic"}},{"k":"leucine","v":{"s":"Leucine"}},{"k":"6_codons_branched_hydrophobic","v":{"s":"6 codons. Branched, hydrophobic."}},{"k":"isoleucine","v":{"s":"Isoleucine"}},{"k":"branched_hydrophobic","v":{"s":"Branched, hydrophobic"}},{"k":"valine","v":{"s":"Valine"}},{"k":"branched_hydrophobic_2","v":{"s":"Branched, hydrophobic"}},{"k":"serine","v":{"s":"Serine"}},{"k":"polar_hydroxyl_side_chain_often_phosph","v":{"s":"Polar, hydroxyl side chain. Often phosphorylated."}},{"k":"threonine","v":{"s":"Threonine"}},{"k":"polar_hydroxyl_often_phosphorylated","v":{"s":"Polar, hydroxyl. Often phosphorylated."}},{"k":"tyrosine","v":{"s":"Tyrosine"}},{"k":"aromatic_polar","v":{"s":"Aromatic, polar"}},{"k":"cysteine","v":{"s":"Cysteine"}},{"k":"forms_disulfide_bonds_s_s_critical_for","v":{"s":"Forms disulfide bonds (S-S). Critical for protein folding."}},{"k":"tryptophan","v":{"s":"Tryptophan"}},{"k":"aromatic_hydrophobic_largest_amino_aci","v":{"s":"Aromatic, hydrophobic. Largest amino acid."}},{"k":"proline","v":{"s":"Proline"}},{"k":"rigid_ring_disrupts_helices","v":{"s":"Rigid (ring). Disrupts α-helices."}},{"k":"histidine","v":{"s":"Histidine"}},{"k":"basic_side_chain_active_site_of_many_e","v":{"s":"Basic side chain. Active site of many enzymes (pKa near 7)."}},{"k":"glutamine","v":{"s":"Glutamine"}},{"k":"polar_amide_often_surface_exposed","v":{"s":"Polar amide. Often surface-exposed."}},{"k":"asparagine","v":{"s":"Asparagine"}},{"k":"polar_amide_common_n_glycosylation_sit","v":{"s":"Polar amide. Common N-glycosylation site."}},{"k":"lysine","v":{"s":"Lysine"}},{"k":"basic_long_side_chain_often_acetylated","v":{"s":"Basic, long side chain. Often acetylated/methylated."}},{"k":"arginine","v":{"s":"Arginine"}},{"k":"basic_guanidinium_group_6_codons_most_","v":{"s":"Basic, guanidinium group. 6 codons — most degenerate."}},{"k":"aspartate","v":{"s":"Aspartate"}},{"k":"acidic_often_active_site_nucleophile","v":{"s":"Acidic. Often active-site nucleophile."}},{"k":"glutamate","v":{"s":"Glutamate"}},{"k":"acidic_most_abundant_in_proteins","v":{"s":"Acidic. Most abundant in proteins."}},{"k":"glycine","v":{"s":"Glycine"}},{"k":"smallest_no_side_chain_high_flexibilit","v":{"s":"Smallest. No side chain — high flexibility."}},{"k":"alanine","v":{"s":"Alanine"}},{"k":"small_hydrophobic_generic_residue","v":{"s":"Small, hydrophobic. \"Generic\" residue."}},{"k":"initiation","v":{"s":"Initiation"}},{"k":"helicase_unwinds_the_double_helix_at_o","v":{"s":"Helicase unwinds the double helix at origins of replication. Single-strand binding proteins prevent re-annealing. Topoisomerase relieves the supercoiling tension ahead of the fork."}},{"k":"primer_synthesis","v":{"s":"Primer synthesis"}},{"k":"primase_lays_down_short_10_nt_rna_prim","v":{"s":"Primase lays down short (~10 nt) RNA primers — DNA polymerase needs a 3'-OH to extend from, so it cannot start a new strand alone."}},{"k":"leading_strand","v":{"s":"Leading strand"}},{"k":"synthesized_continuously_5_3_in_the_sa","v":{"s":"Synthesized continuously 5'→3' in the same direction as the replication fork moves. One primer per origin."}},{"k":"lagging_strand_okazaki_fragments","v":{"s":"Lagging strand (Okazaki fragments)"}},{"k":"synthesized_in_short_100_1000_nt_fragm","v":{"s":"Synthesized in short 100–1000 nt fragments (Okazaki fragments) because polymerase can only extend 5'→3'. Each fragment needs its own primer."}},{"k":"primer_removal_gap_filling","v":{"s":"Primer removal + gap filling"}},{"k":"rna_primers_are_excised_and_replaced_w","v":{"s":"RNA primers are excised and replaced with DNA nucleotides."}},{"k":"ligation","v":{"s":"Ligation"}},{"k":"joins_okazaki_fragments_by_forming_the","v":{"s":"Joins Okazaki fragments by forming the final phosphodiester bond."}},{"k":"proofreading","v":{"s":"Proofreading"}},{"k":"polymerase_checks_each_base_mismatches","v":{"s":"Polymerase checks each base; mismatches removed and replaced. Lowers error rate from ~10⁻⁵ to ~10⁻⁷."}},{"k":"mismatch_repair","v":{"s":"Mismatch repair"}},{"k":"catches_the_few_mismatches_that_escape","v":{"s":"Catches the few mismatches that escape proofreading. Final error rate: ~10⁻¹⁰ per base pair."}},{"k":"initiation_2","v":{"s":"Initiation"}},{"k":"rna_polymerase_binds_the_promoter_e_g_","v":{"s":"RNA polymerase binds the promoter (e.g., TATA box ~25 bp upstream of transcription start). Helps melt the DNA double helix."}},{"k":"elongation","v":{"s":"Elongation"}},{"k":"polymerase_reads_template_strand_3_5_s","v":{"s":"Polymerase reads template strand 3'→5', synthesizing mRNA 5'→3'. Adds ~30 nucleotides per second in bacteria; ~10-50 in eukaryotes."}},{"k":"termination","v":{"s":"Termination"}},{"k":"bacteria_rho_dependent_or_intrinsic_te","v":{"s":"Bacteria: rho-dependent or intrinsic termination (hairpin loop). Eukaryotes: cleavage and polyadenylation signals."}},{"k":"5_capping_eukaryotes","v":{"s":"5' capping (eukaryotes)"}},{"k":"7_methylguanosine_cap_added_to_5_end_h","v":{"s":"7-methylguanosine cap added to 5' end. Helps ribosome recognize mRNA + protects from degradation."}},{"k":"splicing_eukaryotes","v":{"s":"Splicing (eukaryotes)"}},{"k":"introns_removed_exons_joined_by_the_sp","v":{"s":"Introns removed, exons joined by the spliceosome. Alternative splicing → multiple proteins from one gene."}},{"k":"polyadenylation_eukaryotes","v":{"s":"Polyadenylation (eukaryotes)"}},{"k":"100_250_adenine_nucleotides_added_to_3","v":{"s":"~100-250 adenine nucleotides added to 3' end. Stabilizes mRNA + signals export."}},{"k":"nuclear_export_eukaryotes","v":{"s":"Nuclear export (eukaryotes)"}},{"k":"mature_mrna_exits_through_nuclear_pore","v":{"s":"Mature mRNA exits through nuclear pore complexes to the cytoplasm."}},{"k":"initiation_3","v":{"s":"Initiation"}},{"k":"small_ribosomal_subunit_binds_mrna_ini","v":{"s":"Small ribosomal subunit binds mRNA. Initiator tRNA (carrying Met) binds AUG start codon. Large subunit joins."}},{"k":"elongation_2","v":{"s":"Elongation"}},{"k":"each_cycle_aminoacyl_trna_enters_a_sit","v":{"s":"Each cycle: aminoacyl-tRNA enters A site → peptide bond forms (catalyzed by 23S rRNA, a ribozyme) → ribosome translocates one codon → tRNA shifts A→P→E."}},{"k":"termination_2","v":{"s":"Termination"}},{"k":"stop_codon_uaa_uag_uga_recognized_by_r","v":{"s":"Stop codon (UAA/UAG/UGA) recognized by release factors. Peptide released, ribosome dissociates."}},{"k":"folding_modification","v":{"s":"Folding + modification"}},{"k":"chaperones_hsp70_groel_help_proteins_f","v":{"s":"Chaperones (Hsp70, GroEL) help proteins fold correctly. Post-translational modifications: phosphorylation, glycosylation, cleavage, disulfide bonds."}},{"k":"codon_changes_but_amino_acid_is_the_sa","v":{"s":"Codon changes but amino acid is the same (genetic code redundancy). No effect."}},{"k":"codon_changes_different_amino_acid_eff","v":{"s":"Codon changes → different amino acid. Effect ranges from none (conservative substitution) to severe (sickle cell: Glu→Val)."}},{"k":"codon_changes_stop_codon_truncated_pro","v":{"s":"Codon changes → STOP codon. Truncated protein, usually non-functional."}},{"k":"adds_nucleotide_s_if_not_a_multiple_of","v":{"s":"Adds nucleotide(s). If not a multiple of 3, shifts reading frame → all downstream codons changed. Usually severe."}},{"k":"removes_nucleotide_s_same_frameshift_c","v":{"s":"Removes nucleotide(s). Same frameshift consequence as insertion."}},{"k":"extra_copies_of_a_gene_or_region_can_l","v":{"s":"Extra copies of a gene or region. Can lead to dosage effects (Down syndrome = extra chrom 21)."}},{"k":"segment_of_chromosome_flipped_may_disr","v":{"s":"Segment of chromosome flipped. May disrupt genes at breakpoints."}},{"k":"segment_moves_to_a_different_chromosom","v":{"s":"Segment moves to a different chromosome. Famous: Philadelphia chromosome (CML; BCR-ABL fusion)."}},{"k":"repeating_unit_e_g_cag_expands_across_","v":{"s":"Repeating unit (e.g., CAG) expands across generations. Huntington's (CAG repeats in HTT), fragile X (CGG in FMR1), myotonic dystrophy."}},{"k":"human_autosomes","v":{"s":"Human autosomes"}},{"k":"pairs_1_22_numbered_roughly_by_size_wi","v":{"s":"Pairs 1-22 (numbered roughly by size, with exceptions: chr 21 is smaller than chr 22)."}},{"k":"sex_chromosomes","v":{"s":"Sex chromosomes"}},{"k":"xx_female_or_xy_male_y_is_much_smaller","v":{"s":"XX (female) or XY (male). Y is much smaller, carries few genes (~70) vs X (~800)."}},{"k":"total_human_chromosomes","v":{"s":"Total human chromosomes"}},{"k":"23_pairs_diploid_in_somatic_cells_game","v":{"s":"23 pairs (diploid in somatic cells). Gametes are haploid (23 chromosomes, no pairs)."}},{"k":"total_human_genes","v":{"s":"Total human genes"}},{"k":"surprisingly_few_many_genes_produce_mu","v":{"s":"Surprisingly few — many genes produce multiple proteins via alternative splicing. Much of the genome is regulatory or non-coding."}},{"k":"total_base_pairs_haploid","v":{"s":"Total base pairs (haploid)"}},{"k":"if_stretched_out_1_8_m_of_dna_per_cell","v":{"s":"If stretched out, ~1.8 m of DNA per cell. Packed into a nucleus ~10 µm across via histones + supercoiling."}},{"k":"mitochondrial_dna","v":{"s":"Mitochondrial DNA"}},{"k":"maternally_inherited_codes_for_37_gene","v":{"s":"Maternally inherited. Codes for 37 genes (13 proteins, 22 tRNAs, 2 rRNAs). Multiple copies per mitochondrion."}},{"k":"pcr_polymerase_chain_reaction","v":{"s":"PCR (Polymerase Chain Reaction)"}},{"k":"amplifies_a_specific_dna_segment_by_2_","v":{"s":"Amplifies a specific DNA segment by 2ⁿ (n cycles). Uses heat-stable Taq polymerase. Foundation of modern molecular biology."}},{"k":"sanger_sequencing","v":{"s":"Sanger sequencing"}},{"k":"reads_dna_sequence_using_chain_termina","v":{"s":"Reads DNA sequence using chain-terminating dideoxynucleotides. Read length ~800-1000 bp. Now largely replaced by next-gen sequencing."}},{"k":"next_gen_sequencing_ngs","v":{"s":"Next-gen sequencing (NGS)"}},{"k":"massively_parallel_sequences_millions_","v":{"s":"Massively parallel — sequences millions of fragments simultaneously. Illumina dominates. ~100-300 bp reads, billions per run."}},{"k":"programmable_gene_editing_guide_rna_ta","v":{"s":"Programmable gene editing. Guide RNA targets Cas9 nuclease to specific DNA. Cuts allow gene knockout or HDR-mediated insertion. Nobel 2020."}},{"k":"crispr_base_editing","v":{"s":"CRISPR base editing"}},{"k":"edits_a_single_base_without_double_str","v":{"s":"Edits a single base without double-strand break. Lower off-target effects than Cas9."}},{"k":"restriction_enzymes","v":{"s":"Restriction enzymes"}},{"k":"bacterial_proteins_that_cut_dna_at_spe","v":{"s":"Bacterial proteins that cut DNA at specific 4-8 bp sequences. Enabled recombinant DNA technology. Nobel 1978."}},{"k":"dna_ligase","v":{"s":"DNA ligase"}},{"k":"joins_dna_fragments_via_phosphodiester","v":{"s":"Joins DNA fragments via phosphodiester bonds. T4 DNA ligase is the workhorse for cloning."}},{"k":"gel_electrophoresis","v":{"s":"Gel electrophoresis"}},{"k":"separates_dna_fragments_by_size_in_an_","v":{"s":"Separates DNA fragments by size in an electric field. Smaller fragments migrate faster through gel matrix."}},{"k":"microarrays","v":{"s":"Microarrays"}},{"k":"thousands_of_dna_probes_on_a_chip_meas","v":{"s":"Thousands of DNA probes on a chip. Measure gene expression or detect SNPs in parallel."}},{"k":"single_cell_rna_seq","v":{"s":"Single-cell RNA-seq"}},{"k":"sequences_mrna_from_individual_cells_r","v":{"s":"Sequences mRNA from individual cells. Reveals cell-type heterogeneity that bulk RNA-seq misses."}},{"k":"cryo_em_for_nucleic_acids","v":{"s":"Cryo-EM for nucleic acids"}},{"k":"near_atomic_structures_of_rna_dna_comp","v":{"s":"Near-atomic structures of RNA/DNA complexes without crystallization. Particularly powerful for ribosomes, spliceosomes, replisomes."}},{"k":"long_read_sequencing_pacbio_nanopore","v":{"s":"Long-read sequencing (PacBio, Nanopore)"}},{"k":"read_lengths_up_to_100kb_vs_illumina_s","v":{"s":"Read lengths up to 100kb+ (vs Illumina's ~300bp). Better for structural variants, repeats, full-length transcripts."}},{"k":"differential_reproduction_based_on_her","v":{"s":"Differential reproduction based on heritable variation. Genes that improve survival/reproduction become more common over generations."}},{"k":"random_source_of_new_genetic_variation","v":{"s":"Random source of new genetic variation. Most are neutral or harmful; rarely beneficial. Substrate for selection."}},{"k":"random_changes_in_allele_frequency_esp","v":{"s":"Random changes in allele frequency, especially in small populations. Founder effect + bottlenecks are extreme cases."}},{"k":"movement_of_alleles_between_population","v":{"s":"Movement of alleles between populations via migration. Reduces between-population differences; increases within-population diversity."}},{"k":"formation_of_new_species_usually_via_r","v":{"s":"Formation of new species, usually via reproductive isolation. Allopatric (geographic separation) most common."}},{"k":"unrelated_organisms_evolve_similar_tra","v":{"s":"Unrelated organisms evolve similar traits independently (wings in birds + bats + insects; eyes in vertebrates + cephalopods)."}},{"k":"all_life_shares_a_common_ancestor_luca","v":{"s":"All life shares a common ancestor (LUCA). Evidence: shared genetic code, ribosomes, ATP, glycolysis, basic biochemistry."}},{"k":"diagram_showing_evolutionary_relations","v":{"s":"Diagram showing evolutionary relationships. Increasingly built from DNA sequence comparisons rather than morphology."}},{"k":"allele_frequencies_stay_constant_under","v":{"s":"Allele frequencies stay constant under no-evolution assumptions: large pop, random mating, no selection/mutation/migration/drift. p² + 2pq + q² = 1."}},{"k":"genetics_reference_library","v":{"s":"🧬 Genetics Reference Library"}},{"k":"interactive_references_pick_a_topic_be","v":{"s":"Interactive references — pick a topic below to explore."}},{"k":"close_section","v":{"s":"✕ Close section"}},{"k":"dna_basics","v":{"s":"DNA Basics"}},{"k":"base_pairs","v":{"s":"Base pairs"}},{"k":"genetic_code","v":{"s":"Genetic code"}},{"k":"dna_replication_2","v":{"s":"DNA replication"}},{"k":"transcription","v":{"s":"Transcription"}},{"k":"translation","v":{"s":"Translation"}},{"k":"dna_vs_rna","v":{"s":"DNA vs RNA"}},{"k":"mutations_2","v":{"s":"Mutations"}},{"k":"amino_acids","v":{"s":"Amino acids"}},{"k":"mutation_inquiry","v":{"s":"Mutation Inquiry"}},{"k":"cell_organelles","v":{"s":"Cell & Organelles"}},{"k":"cell_organelles_2","v":{"s":"Cell organelles"}},{"k":"cell_types","v":{"s":"Cell types"}},{"k":"cell_pathways","v":{"s":"Cell pathways"}},{"k":"bio_elements","v":{"s":"Bio elements"}},{"k":"embryology","v":{"s":"Embryology"}},{"k":"genetics_inheritance","v":{"s":"Genetics & Inheritance"}},{"k":"chromosomes","v":{"s":"Chromosomes"}},{"k":"meiosis_vs_mitosis","v":{"s":"Meiosis vs mitosis"}},{"k":"mendelian_genetics","v":{"s":"Mendelian genetics"}},{"k":"epigenetics","v":{"s":"Epigenetics"}},{"k":"genome_sizes","v":{"s":"Genome sizes"}},{"k":"famous_genes","v":{"s":"Famous genes"}},{"k":"biotech_lab","v":{"s":"Biotech & Lab"}},{"k":"biotech_tools","v":{"s":"Biotech tools"}},{"k":"biotech_apps","v":{"s":"Biotech apps"}},{"k":"pcr_lab","v":{"s":"PCR + lab"}},{"k":"crispr_detail","v":{"s":"CRISPR detail"}},{"k":"sequencing_tech","v":{"s":"Sequencing tech"}},{"k":"model_organisms","v":{"s":"Model organisms"}},{"k":"bioethics","v":{"s":"Bioethics"}},{"k":"disease_health","v":{"s":"Disease & Health"}},{"k":"disease_genes","v":{"s":"Disease genes"}},{"k":"cancer_biology","v":{"s":"Cancer biology"}},{"k":"immune_system","v":{"s":"Immune system"}},{"k":"virus_families","v":{"s":"Virus families"}},{"k":"microbiome","v":{"s":"Microbiome"}},{"k":"organ_systems","v":{"s":"Organ systems"}},{"k":"hormones","v":{"s":"Hormones"}},{"k":"vitamins","v":{"s":"Vitamins"}},{"k":"neuroscience","v":{"s":"Neuroscience"}},{"k":"life_on_earth","v":{"s":"Life on Earth"}},{"k":"evolution","v":{"s":"Evolution"}},{"k":"tree_of_life","v":{"s":"Tree of life"}},{"k":"ecology","v":{"s":"Ecology"}},{"k":"animal_facts","v":{"s":"Animal facts"}},{"k":"animal_groups","v":{"s":"Animal groups"}},{"k":"wild_dog_dna","v":{"s":"Wild + dog DNA"}},{"k":"plant_biology","v":{"s":"Plant biology"}},{"k":"extinct_species","v":{"s":"Extinct species"}},{"k":"reference","v":{"s":"Reference"}},{"k":"history","v":{"s":"History"}},{"k":"glossary","v":{"s":"Glossary"}},{"k":"trace_trait","v":{"s":"Trace trait"}},{"k":"dna_rna_bases","v":{"s":"🅰🅣 DNA + RNA bases"}},{"k":"five_nitrogenous_bases_make_up_dna_rna","v":{"s":"Five nitrogenous bases make up DNA + RNA: A, T, G, C (DNA); A, U, G, C (RNA). Purines (A, G) are 2-ringed; pyrimidines (T, U, C) are 1-ringed. Pairing follows specific H-bond patterns."}},{"k":"pairs_with","v":{"s":"Pairs with: "}},{"k":"genetic_code_codon_table","v":{"s":"🔡 Genetic code — codon table"}},{"k":"64_codons_4_encode_20_amino_acids_3_st","v":{"s":"64 codons (4³) encode 20 amino acids + 3 stop signals. Code is redundant (degenerate) — most amino acids have multiple codons, usually differing in the 3rd position (\"wobble\"). Universal across nearly all life."}},{"k":"wobble","v":{"s":"💡 Wobble: "}},{"k":"third_codon_position_pairs_less_strict","v":{"s":"Third codon position pairs less strictly — a single tRNA can recognize multiple codons. Reduces the number of tRNAs needed (cells have ~30-40, not 64)."}},{"k":"dna_replication_3","v":{"s":"🔄 DNA replication"}},{"k":"semi_conservative_each_new_helix_has_o","v":{"s":"Semi-conservative — each new helix has one parent + one newly-synthesized strand. Proven by Meselson-Stahl 1958. ~50 bp/sec in bacteria, ~50 bp/sec per fork in eukaryotes (but thousands of forks in parallel)."}},{"k":"transcription_dna_rna","v":{"s":"✍ Transcription (DNA → RNA)"}},{"k":"rna_polymerase_reads_dna_template_3_5_","v":{"s":"RNA polymerase reads DNA template (3'→5') and synthesizes mRNA (5'→3'). In eukaryotes, the primary transcript is heavily processed before export."}},{"k":"translation_mrna_protein_2","v":{"s":"🏭 Translation (mRNA → protein)"}},{"k":"ribosome_reads_mrna_in_3_base_codons_a","v":{"s":"Ribosome reads mRNA in 3-base codons and builds protein. ~10-20 amino acids per second in bacteria; ~3-5 in eukaryotes. Multiple ribosomes can translate the same mRNA (polyribosome)."}},{"k":"mutation_types","v":{"s":"⚠ Mutation types"}},{"k":"mutations_range_from_invisible_silent_","v":{"s":"Mutations range from invisible (silent) to lethal. Their effect depends on what changes, where, and in which cell type (germline vs somatic)."}},{"k":"human_chromosomes_genome","v":{"s":"🧬 Human chromosomes + genome"}},{"k":"dna_vs_rna_2","v":{"s":"⇌ DNA vs RNA"}},{"k":"biotech_tools_2","v":{"s":"🔬 Biotech tools"}},{"k":"disease_causing_genes_examples","v":{"s":"🏥 Disease-causing genes (examples)"}},{"k":"a_sampling_of_well_characterized_genet","v":{"s":"A sampling of well-characterized genetic disorders. Genetic counseling resources and current treatments evolve — verify with current literature for clinical decisions."}},{"k":"evolution_concepts","v":{"s":"🌳 Evolution concepts"}},{"k":"family_a_three_generations_blue_eyes","v":{"s":"Family A — three generations, blue eyes"}},{"k":"two_unaffected_parents_gen_i_have_one_","v":{"s":"Two unaffected parents (gen I) have one affected child + one unaffected (gen II). The affected child + unaffected partner have one affected + one unaffected (gen III). Trait appears in roughly 25% of offspring of unaffected x unaffected matings."}},{"k":"trait_skips_generations_unaffected_par","v":{"s":"Trait skips generations (unaffected parents → affected child)."}},{"k":"parents_must_be_heterozygous_carriers_","v":{"s":"Parents must be heterozygous carriers passing one recessive allele each."}},{"k":"affected_individuals_appear_in_both_se","v":{"s":"Affected individuals appear in both sexes at roughly equal frequency."}},{"k":"affected_aa_homozygous_carriers_aa_are","v":{"s":"Affected = aa homozygous; carriers (Aa) are phenotypically unaffected."}},{"k":"family_b_color_blindness_across_three_","v":{"s":"Family B — color blindness across three generations"}},{"k":"affected_grandfather_gen_i_has_unaffec","v":{"s":"Affected grandfather (gen I) has unaffected daughter (gen II) and affected grandson via that daughter (gen III). No affected sons of unaffected fathers. Trait far more common in males."}},{"k":"trait_shows_strong_male_bias_hemizygou","v":{"s":"Trait shows strong male bias (hemizygous males express; females need two copies)."}},{"k":"unaffected_daughter_of_affected_grandf","v":{"s":"Unaffected daughter of affected grandfather is an obligate carrier."}},{"k":"trait_skips_generation_through_carrier","v":{"s":"Trait skips generation through carrier daughters, then reappears in grandsons."}},{"k":"no_father_to_son_transmission_sons_inh","v":{"s":"No father-to-son transmission (sons inherit Y from father, not X)."}},{"k":"family_c_huntington_like_late_onset_tr","v":{"s":"Family C — Huntington-like late-onset trait"}},{"k":"every_affected_individual_has_at_least","v":{"s":"Every affected individual has at least one affected parent. Trait appears in every generation. ~50% of children of affected parents are affected. Equal in males + females."}},{"k":"trait_appears_in_every_generation_no_s","v":{"s":"Trait appears in every generation (no skipping)."}},{"k":"every_affected_individual_has_at_least_2","v":{"s":"Every affected individual has at least one affected parent."}},{"k":"roughly_50_of_children_of_an_affected_","v":{"s":"Roughly 50% of children of an affected heterozygote are affected."}},{"k":"equal_frequency_in_males_females_autos","v":{"s":"Equal frequency in males + females — autosomal, not sex-linked."}},{"k":"autosomal_dominant","v":{"s":"Autosomal dominant"}},{"k":"autosomal_recessive","v":{"s":"Autosomal recessive"}},{"k":"x_linked_dominant","v":{"s":"X-linked dominant"}},{"k":"x_linked_recessive","v":{"s":"X-linked recessive"}},{"k":"mitochondrial","v":{"s":"Mitochondrial"}},{"k":"trace_the_trait","v":{"s":"🧬 Trace the trait"}},{"k":"inheritance_pattern_reasoning_ranking_","v":{"s":"Inheritance pattern + reasoning ranking — both must be committed before reveal. The reveal grades your ranking position-by-position, not just your final answer. Real inquiry requires you to know WHY, not just WHAT."}},{"k":"1_inheritance_pattern","v":{"s":"1. Inheritance pattern:"}},{"k":"2_rank_these_explanations_most_least_s","v":{"s":"2. Rank these explanations (most → least supporting):"}},{"k":"move_up","v":{"s":"Move up"}},{"k":"move_down","v":{"s":"Move down"}},{"k":"notice_the_ranking_grade_is_independen","v":{"s":"Notice: the ranking grade is independent of the pattern grade — you can identify the WHAT correctly but rank the WHY out of order."}},{"k":"genetics_glossary","v":{"s":"📖 Genetics glossary"}},{"k":"law_of_segregation","v":{"s":"Law of Segregation"}},{"k":"during_gamete_formation_the_two_allele","v":{"s":"During gamete formation, the two alleles for each gene separate so each gamete carries only one allele."}},{"k":"law_of_independent_assortment","v":{"s":"Law of Independent Assortment"}},{"k":"alleles_for_different_genes_assort_ind","v":{"s":"Alleles for different genes assort independently of one another during gamete formation (genes on different chromosomes)."}},{"k":"law_of_dominance","v":{"s":"Law of Dominance"}},{"k":"when_two_different_alleles_are_present","v":{"s":"When two different alleles are present, one (dominant) is expressed while the other (recessive) is masked."}},{"k":"methyl_group_ch_added_to_cytosines_esp","v":{"s":"Methyl group (–CH₃) added to cytosines, especially at CpG islands. Generally silences gene expression."}},{"k":"acetylation_methylation_phosphorylatio","v":{"s":"Acetylation, methylation, phosphorylation of histone tails. Changes chromatin packing."}},{"k":"atp_dependent_complexes_slide_or_eject","v":{"s":"ATP-dependent complexes slide or eject nucleosomes to expose DNA."}},{"k":"mirna_lncrna_regulate_gene_expression_","v":{"s":"miRNA, lncRNA regulate gene expression post-transcriptionally."}},{"k":"some_genes_expressed_only_from_materna","v":{"s":"Some genes expressed only from maternal or paternal allele. Methylation marks."}},{"k":"some_epigenetic_marks_survive_gametoge","v":{"s":"Some epigenetic marks survive gametogenesis and pass to offspring."}},{"k":"alanine_2","v":{"s":"Alanine"}},{"k":"arginine_2","v":{"s":"Arginine"}},{"k":"asparagine_2","v":{"s":"Asparagine"}},{"k":"aspartate_2","v":{"s":"Aspartate"}},{"k":"cysteine_2","v":{"s":"Cysteine"}},{"k":"glutamate_2","v":{"s":"Glutamate"}},{"k":"glutamine_2","v":{"s":"Glutamine"}},{"k":"glycine_2","v":{"s":"Glycine"}},{"k":"histidine_2","v":{"s":"Histidine"}},{"k":"isoleucine_2","v":{"s":"Isoleucine"}},{"k":"leucine_2","v":{"s":"Leucine"}},{"k":"lysine_2","v":{"s":"Lysine"}},{"k":"methionine_2","v":{"s":"Methionine"}},{"k":"phenylalanine_2","v":{"s":"Phenylalanine"}},{"k":"proline_2","v":{"s":"Proline"}},{"k":"serine_2","v":{"s":"Serine"}},{"k":"threonine_2","v":{"s":"Threonine"}},{"k":"tryptophan_2","v":{"s":"Tryptophan"}},{"k":"tyrosine_2","v":{"s":"Tyrosine"}},{"k":"valine_2","v":{"s":"Valine"}},{"k":"nucleus","v":{"s":"Nucleus"}},{"k":"nucleolus","v":{"s":"Nucleolus"}},{"k":"mitochondrion","v":{"s":"Mitochondrion"}},{"k":"chloroplast_plants","v":{"s":"Chloroplast (plants)"}},{"k":"endoplasmic_reticulum_rough","v":{"s":"Endoplasmic reticulum (rough)"}},{"k":"endoplasmic_reticulum_smooth","v":{"s":"Endoplasmic reticulum (smooth)"}},{"k":"golgi_apparatus","v":{"s":"Golgi apparatus"}},{"k":"lysosome","v":{"s":"Lysosome"}},{"k":"peroxisome","v":{"s":"Peroxisome"}},{"k":"vacuole_plant_central","v":{"s":"Vacuole (plant central)"}},{"k":"cytoskeleton","v":{"s":"Cytoskeleton"}},{"k":"ribosome","v":{"s":"Ribosome"}},{"k":"cell_membrane","v":{"s":"Cell membrane"}},{"k":"cell_wall_plants_fungi_bacteria","v":{"s":"Cell wall (plants, fungi, bacteria)"}},{"k":"sanger_sequencing_2","v":{"s":"Sanger sequencing"}},{"k":"illumina_short_read_ngs","v":{"s":"Illumina (short-read NGS)"}},{"k":"ion_torrent","v":{"s":"Ion Torrent"}},{"k":"pacbio_smrt","v":{"s":"PacBio (SMRT)"}},{"k":"oxford_nanopore","v":{"s":"Oxford Nanopore"}},{"k":"hi_c_chromosome_conformation_capture","v":{"s":"Hi-C / chromosome conformation capture"}},{"k":"who_can_access_your_genome_gina_2008_u","v":{"s":"Who can access your genome? GINA (2008, US) prohibits genetic discrimination in employment + health insurance, NOT life insurance."}},{"k":"23andme_ancestrydna_reveal_ancestry_he","v":{"s":"23andMe, AncestryDNA reveal ancestry + health risk. Concerns: incidental findings, accuracy, third-party data sharing."}},{"k":"in_2018_he_jiankui_edited_embryos_for_","v":{"s":"In 2018, He Jiankui edited embryos for HIV resistance → twin births. Widely condemned. Most countries ban germline editing."}},{"k":"hypothetical_selection_or_editing_of_e","v":{"s":"Hypothetical selection or editing of embryos for non-medical traits (height, IQ). Currently technically limited; ethically contested."}},{"k":"engineered_to_spread_through_wild_popu","v":{"s":"Engineered to spread through wild populations (e.g., mosquito malaria-resistance). Potential ecological irreversibility."}},{"k":"should_we_test_for_untreatable_disease","v":{"s":"Should we test for untreatable diseases (Huntington)? Some people choose not to know."}},{"k":"familial_dna_searches_solved_cold_case","v":{"s":"Familial DNA searches solved cold cases (Golden State Killer, 2018) but raise privacy issues for relatives who never consented."}},{"k":"us_supreme_court_2013_ruled_that_natur","v":{"s":"US Supreme Court (2013) ruled that naturally-occurring DNA cannot be patented, but synthetic cDNA can."}},{"k":"reference_genomes_historically_eurocen","v":{"s":"Reference genomes historically Eurocentric. Improving reference diversity is ongoing (e.g., human pangenome project)."}},{"k":"genome_sizes_across_life","v":{"s":"📏 Genome sizes across life"}},{"k":"genome_size_does_not_correlate_with_or","v":{"s":"Genome size does not correlate with organism complexity (C-value paradox). Humans have similar gene counts to roundworms — much of \"extra\" DNA in larger genomes is non-coding."}},{"k":"meiosis_vs_mitosis_2","v":{"s":"⊞ Meiosis vs Mitosis"}},{"k":"mendelian_genetics_2","v":{"s":"🫛 Mendelian genetics"}},{"k":"mendel_s_laws_1865","v":{"s":"Mendel's Laws (1865)"}},{"k":"common_cross_outcomes","v":{"s":"Common cross outcomes"}},{"k":"epigenetics_beyond_the_sequence","v":{"s":"✎ Epigenetics — beyond the sequence"}},{"k":"heritable_changes_in_gene_expression_t","v":{"s":"Heritable changes in gene expression that don't involve changes to DNA sequence. Influenced by environment, diet, stress."}},{"k":"the_20_standard_amino_acids","v":{"s":"⚕ The 20 standard amino acids"}},{"k":"building_blocks_of_proteins_9_are_esse","v":{"s":"Building blocks of proteins. 9 are \"essential\" (can't be synthesized — must come from diet): His, Ile, Leu, Lys, Met, Phe, Thr, Trp, Val."}},{"k":"cell_organelles_3","v":{"s":"🔬 Cell organelles"}},{"k":"cell_types_2","v":{"s":"🧫 Cell types"}},{"k":"dna_sequencing_technologies","v":{"s":"📊 DNA sequencing technologies"}},{"k":"bioethics_in_genetics","v":{"s":"⚖ Bioethics in genetics"}},{"k":"history_of_genetics","v":{"s":"🕰 History of genetics"}},{"k":"static","v":{"s":"Static"}},{"k":"essentially_no_beneficial_fixation_exp","v":{"s":"Essentially no beneficial fixation expected. Population is in mutation-selection balance or drift-only."}},{"k":"drift_dominates_few_expected_fixations","v":{"s":"Drift dominates: few expected fixations even though mutations occur. Common in small populations."}},{"k":"slow_evolution","v":{"s":"Slow evolution"}},{"k":"a_handful_of_beneficial_mutations_expe","v":{"s":"A handful of beneficial mutations expected to fix. Standard for most natural populations."}},{"k":"fast_evolution","v":{"s":"Fast evolution"}},{"k":"many_fixations_expected_strong_selecti","v":{"s":"Many fixations expected — strong selection, large population, or both. E.g., bacterial antibiotic resistance."}},{"k":"runaway_adaptation","v":{"s":"Runaway adaptation"}},{"k":"extreme_regime_viruses_cancer_cell_lin","v":{"s":"Extreme regime: viruses, cancer cell lines, asexual lab populations. Many simultaneous adaptive sweeps."}},{"k":"mutation_inquiry_drift_selection_fixat","v":{"s":"🔬 Mutation Inquiry — Drift, Selection, Fixation"}},{"k":"set_per_base_mutation_rate_population_","v":{"s":"Set mutation rate, population size, generations, and selection coefficient, then observe how the fixation estimate changes. The result updates live; record a hypothesis or pattern you notice."}},{"k":"total_mutations","v":{"s":"Total mutations"}},{"k":"fix_prob_kimura","v":{"s":"Fix prob (Kimura)"}},{"k":"human_drift","v":{"s":"human (drift)"}},{"k":"log_n_vs_log_circles_typical_regimes","v":{"s":"log₁₀(N) vs log₁₀(μ) — circles = typical regimes"}},{"k":"mutation_rate_log","v":{"s":"Mutation rate μ (log)"}},{"k":"population_size_n_log","v":{"s":"Population size N (log)"}},{"k":"generations","v":{"s":"Generations"}},{"k":"selection_coef_s","v":{"s":"Selection coef s"}},{"k":"log_this_evolutionary_regime","v":{"s":"📋 Log this evolutionary regime"}},{"k":"reset_5","v":{"s":"Reset"}},{"k":"your_hypothesis_which_slider_has_the_b","v":{"s":"Your hypothesis (which slider has the biggest leverage on fixation rate? Why?)"}},{"k":"e_g_selection_has_more_leverage_than_o","v":{"s":"e.g., selection has more leverage than μ once N is large enough..."}},{"k":"i_m_stuck_show_open_questions","v":{"s":"🤔 I'm stuck — show open questions"}},{"k":"open_questions_no_answer_key","v":{"s":"Open questions (no answer key)"}},{"k":"when_does_the_regime_move_from_drift_d","v":{"s":"When does the regime move from drift-dominated to selection-dominated? What does N·s tell you?"}},{"k":"why_are_antibiotic_resistance_and_vira","v":{"s":"Why are antibiotic resistance and viral evolution so fast — which sliders are at their extreme?"}},{"k":"a_neutral_mutation_s_0_has_fixation_pr","v":{"s":"A neutral mutation (s = 0) has fixation probability 1/(2N). What does that mean for large populations?"}},{"k":"could_the_same_population_size_be_drif","v":{"s":"Could the same population size be \"drift-dominated\" for weak mutations and \"selection-dominated\" for strong ones simultaneously?"}},{"k":"i_can_explain_why_this_n_g_s_combinati","v":{"s":"I can explain why this μ × N × g × s combination yields this regime."}},{"k":"explain_in_your_own_words","v":{"s":"Explain in your own words..."}},{"k":"inquiry_widget_no_score_no_reveal_no_a","v":{"s":"Inquiry widget — no score, no reveal, no answer dump. Uses the full Kimura (1962) diploid fixation formula (1−e^(−2s))/(1−e^(−4Ns)), which interpolates between Haldane's ~2s in the strong-selection limit (Ns≫1) and the neutral 1/(2N) in the drift limit (Ns≪1 or s=0)."}},{"k":"octopus_has_33_000_genes","v":{"s":"Octopus has 33,000 genes"}},{"k":"more_than_humans_20_000_many_novel_gen","v":{"s":"More than humans (~20,000). Many novel genes for sensing + cognition."}},{"k":"tardigrade_dna_repair","v":{"s":"Tardigrade DNA repair"}},{"k":"special_protein_dsup_wraps_dna_protect","v":{"s":"Special protein (Dsup) wraps DNA + protects against X-ray damage. Studied for radiation therapy applications."}},{"k":"naked_mole_rat_cancer_resistance","v":{"s":"Naked mole rat cancer resistance"}},{"k":"hypersensitive_contact_inhibition_high","v":{"s":"Hypersensitive contact inhibition + high-molecular-weight hyaluronan. Cancer extremely rare."}},{"k":"elephant_tp53_redundancy","v":{"s":"Elephant TP53 redundancy"}},{"k":"elephants_have_20_copies_of_tumor_supp","v":{"s":"Elephants have ~20 copies of tumor suppressor TP53 (humans have 1). Possible explanation for low cancer rates despite huge cell number."}},{"k":"salamander_regeneration","v":{"s":"Salamander regeneration"}},{"k":"axolotl_can_regrow_limbs_spinal_cord_h","v":{"s":"Axolotl can regrow limbs, spinal cord, heart, even portions of brain. Studied for regenerative medicine."}},{"k":"camel_hump","v":{"s":"Camel hump"}},{"k":"stores_fat_not_water_myth_allows_survi","v":{"s":"Stores fat, not water (myth). Allows survival without food for weeks. Water comes from drinking + metabolic byproduct."}},{"k":"cheetah_inbreeding","v":{"s":"Cheetah inbreeding"}},{"k":"population_crashed_12_000_years_ago_ge","v":{"s":"Population crashed ~12,000 years ago. Genetic bottleneck → very low diversity. All cheetahs basically twins genetically."}},{"k":"whale_evolution","v":{"s":"Whale evolution"}},{"k":"modern_whales_descended_from_land_mamm","v":{"s":"Modern whales descended from land mammals (~50 mya). Closest living relatives: hippos. Vestigial pelvis bones remain."}},{"k":"plant_chromosome_counts","v":{"s":"Plant chromosome counts"}},{"k":"wide_variation_adder_s_tongue_fern_720","v":{"s":"Wide variation. Adder's tongue fern: ~720 pairs (most ever). Rice: 12 pairs. Humans: 23 pairs."}},{"k":"bdelloid_rotifers","v":{"s":"Bdelloid rotifers"}},{"k":"all_female_asexual_for_80_million_year","v":{"s":"All-female, asexual for ~80 million years. Acquire genes from other species (HGT) instead of mixing via sex."}},{"k":"coelacanth","v":{"s":"Coelacanth"}},{"k":"lobe_finned_fish_thought_extinct_since","v":{"s":"Lobe-finned fish thought extinct since dinosaur age. Living specimens found 1938. Lineage ~400 million years old."}},{"k":"horseshoe_crab_blood","v":{"s":"Horseshoe crab blood"}},{"k":"blue_copper_based_hemocyanin_detects_b","v":{"s":"Blue (copper-based hemocyanin). Detects bacterial endotoxins — used to test vaccines + medical devices."}},{"k":"polar_bear_evolution","v":{"s":"Polar bear evolution"}},{"k":"diverged_from_brown_bears_150_000_500_","v":{"s":"Diverged from brown bears ~150,000-500,000 years ago. Some grizzly-polar hybrids (\"pizzly\" or \"grolar\") confirmed in wild."}},{"k":"dog_breed_genetics_wild_dna_facts","v":{"s":"🐕 Dog breed genetics + wild DNA facts"}},{"k":"dog_breed_genetics","v":{"s":"Dog breed genetics"}},{"k":"wild_dna_biology_trivia","v":{"s":"Wild DNA + biology trivia"}},{"k":"animal_classification","v":{"s":"🦁 Animal classification"}},{"k":"major_animal_phyla","v":{"s":"Major animal phyla"}},{"k":"vertebrate_classes_subset_of_chordata","v":{"s":"Vertebrate classes (subset of Chordata)"}},{"k":"vitamins_minerals","v":{"s":"💊 Vitamins + minerals"}},{"k":"the_13_essential_vitamins","v":{"s":"The 13 essential vitamins"}},{"k":"essential_dietary_minerals","v":{"s":"Essential dietary minerals"}},{"k":"human_organ_systems","v":{"s":"🫀 Human organ systems"}},{"k":"major_hormones","v":{"s":"⚛ Major hormones"}},{"k":"hormones_travel_through_the_bloodstrea","v":{"s":"Hormones travel through the bloodstream to act on distant target tissues. They orchestrate metabolism, growth, reproduction, stress response, and homeostasis."}},{"k":"elements_of_life","v":{"s":"⌬ Elements of life"}},{"k":"approximate_elemental_composition_of_t","v":{"s":"Approximate elemental composition of the human body by mass. Just 11 elements account for >99%. CHNOPS (C, H, N, O, P, S) make up almost all organic molecules."}},{"k":"major_cell_pathways","v":{"s":"⇄ Major cell pathways"}},{"k":"extinct_species_2","v":{"s":"🦕 Extinct species"}},{"k":"recent_extinctions_mostly_human_caused","v":{"s":"Recent extinctions (mostly human-caused) + notable prehistoric extinctions. Earth has had 5 mass extinctions — many argue we're in a 6th now."}},{"k":"6co_6h_o_light_c_h_o_6o_powered_by_chl","v":{"s":"6CO₂ + 6H₂O + light → C₆H₁₂O₆ + 6O₂. Powered by chlorophyll. Source of most atmospheric oxygen."}},{"k":"c3_most_plants_c4_corn_sugarcane_effic","v":{"s":"C3 (most plants), C4 (corn, sugarcane — efficient at high T), CAM (cacti, succulents — open stomata at night to save water)."}},{"k":"tiny_pores_on_leaves_let_co_in_o_water","v":{"s":"Tiny pores on leaves. Let CO₂ in + O₂/water out. Open/close in response to light, water, CO₂."}},{"k":"carries_water_minerals_up_from_roots_d","v":{"s":"Carries water + minerals UP from roots. Dead cells. Drives transpiration pull."}},{"k":"carries_sugars_from_leaves_to_rest_of_","v":{"s":"Carries sugars from leaves to rest of plant. Living cells. Bidirectional."}},{"k":"plant_hormone_phototropism_growing_tow","v":{"s":"Plant hormone. Phototropism (growing toward light). Concentration on dark side → cells elongate → bends toward light."}},{"k":"gas_hormone_ripens_fruit_why_ripe_bana","v":{"s":"Gas hormone. Ripens fruit. Why ripe bananas ripen others. Stress signaling."}},{"k":"promotes_stem_elongation_seed_germinat","v":{"s":"Promotes stem elongation, seed germination, flowering."}},{"k":"promotes_cell_division_delays_leaf_sen","v":{"s":"Promotes cell division. Delays leaf senescence."}},{"k":"stress_hormone_closes_stomata_when_wat","v":{"s":"Stress hormone. Closes stomata when water-stressed. Promotes seed dormancy."}},{"k":"angiosperm_unique_one_sperm_fertilizes","v":{"s":"Angiosperm unique: one sperm fertilizes egg (embryo), one fertilizes polar nuclei (endosperm — food for seed)."}},{"k":"flower_shape_color_scent_match_pollina","v":{"s":"Flower shape + color + scent match pollinator preferences. Some highly specialized (orchid + specific moth)."}},{"k":"evolved_in_nutrient_poor_soils_venus_f","v":{"s":"Evolved in nutrient-poor soils. Venus flytrap (snap), pitcher plants (pitfall), sundew (sticky)."}},{"k":"symbiosis_with_fungi_fungi_extend_root","v":{"s":"Symbiosis with fungi. Fungi extend root reach; plants supply sugars. ~85% of plant species."}},{"k":"rhizobium_bacteria_in_root_nodules_con","v":{"s":"Rhizobium bacteria in root nodules convert N₂ → NH₃. Why beans + peas are protein-rich + soil-improving."}},{"k":"domestication_selected_larger_seeds_wh","v":{"s":"Domestication selected larger seeds (wheat), non-shattering (rice), sweeter fruit (apples). Recent: hybrid corn, GM, marker-assisted selection."}},{"k":"common_in_plants_rare_in_animals_wheat","v":{"s":"Common in plants (rare in animals). Wheat is hexaploid (6 sets), strawberry is octoploid. Often increases vigor + crop yield."}},{"k":"stiffening_compound_in_cell_walls_of_w","v":{"s":"Stiffening compound in cell walls of wood. Why wood is stiff + slow to decompose."}},{"k":"individuals_of_one_species_in_an_area","v":{"s":"Individuals of one species in an area."}},{"k":"all_populations_interacting_in_an_area","v":{"s":"All populations interacting in an area."}},{"k":"community_abiotic_environment_soil_wat","v":{"s":"Community + abiotic environment (soil, water, weather)."}},{"k":"all_ecosystems_on_earth_the_zone_of_li","v":{"s":"All ecosystems on Earth. The zone of life."}},{"k":"role_of_a_species_in_its_ecosystem_two","v":{"s":"Role of a species in its ecosystem. Two species can't occupy exactly the same niche (competitive exclusion)."}},{"k":"physical_place_where_an_organism_lives","v":{"s":"Physical place where an organism lives."}},{"k":"network_of_who_eats_whom_trophic_level","v":{"s":"Network of who eats whom. Trophic levels: producers → primary consumers → secondary → etc."}},{"k":"make_own_food_plants_algae_some_bacter","v":{"s":"Make own food. Plants, algae, some bacteria. Foundation of food chains."}},{"k":"get_food_by_eating_others_herbivores_c","v":{"s":"Get food by eating others. Herbivores, carnivores, omnivores."}},{"k":"break_down_dead_matter_fungi_bacteria_","v":{"s":"Break down dead matter. Fungi, bacteria, detritivores. Recycle nutrients."}},{"k":"close_interaction_between_species_mutu","v":{"s":"Close interaction between species. Mutualism (+/+), commensalism (+/0), parasitism (+/−)."}},{"k":"disproportionate_effect_on_ecosystem_d","v":{"s":"Disproportionate effect on ecosystem despite low abundance. Sea otters control urchins, which control kelp."}},{"k":"maximum_population_size_environment_ca","v":{"s":"Maximum population size environment can sustain. Resources, predation, disease limit K."}},{"k":"population_grows_at_constant_rate_dn_d","v":{"s":"Population grows at constant rate. dN/dt = rN. Cannot continue forever."}},{"k":"growth_slows_as_n_approaches_k_dn_dt_r","v":{"s":"Growth slows as N approaches K. dN/dt = rN(K-N)/K. S-shaped curve."}},{"k":"many_offspring_little_parental_care_sh","v":{"s":"Many offspring, little parental care, short-lived. Insects, weeds. Boom-and-bust."}},{"k":"few_offspring_lots_of_care_long_lived_","v":{"s":"Few offspring, lots of care, long-lived. Whales, humans, oaks."}},{"k":"predictable_changes_in_community_over_","v":{"s":"Predictable changes in community over time. Primary (bare rock) vs secondary (after disturbance)."}},{"k":"variety_of_life_species_richness_count","v":{"s":"Variety of life. Species richness (count) + evenness (distribution). High biodiversity → ecosystem resilience."}},{"k":"background_rate_1_species_per_million_","v":{"s":"Background rate ~1 species per million per year. Current rate 100-1000× background due to humans."}},{"k":"major_life_zone_defined_by_climate_veg","v":{"s":"Major life zone defined by climate + vegetation. Tropical rainforest, desert, tundra, savanna, etc."}},{"k":"n_nh_fixation_no_no_nitrification_orga","v":{"s":"N₂ → NH₃ (fixation) → NO₂⁻ → NO₃⁻ (nitrification) → organic N → back to N₂ (denitrification)."}},{"k":"co_photosynthesis_organic_c_respiratio","v":{"s":"CO₂ ↔ photosynthesis ↔ organic C ↔ respiration. Fossil fuels move long-buried C back to atmosphere."}},{"k":"evaporation_condensation_precipitation","v":{"s":"Evaporation → condensation → precipitation → runoff/groundwater → back to ocean."}},{"k":"movement_of_elements_c_n_p_s_through_b","v":{"s":"Movement of elements (C, N, P, S) through biotic + abiotic compartments."}},{"k":"notable_animals","v":{"s":"🐾 Notable animals"}},{"k":"plant_biology_2","v":{"s":"🌿 Plant biology"}},{"k":"famous_human_genes","v":{"s":"⌬ Famous human genes"}},{"k":"model_organisms_in_research","v":{"s":"🧫 Model organisms in research"}},{"k":"each_chosen_for_properties_that_make_b","v":{"s":"Each chosen for properties that make biology tractable: small size, fast life cycle, ease of culture, genetic tools."}},{"k":"ecology_concepts","v":{"s":"🌍 Ecology concepts"}},{"k":"heat_separates_double_stranded_dna_int","v":{"s":"Heat separates double-stranded DNA into single strands. Hydrogen bonds break."}},{"k":"primers_short_dna_sequences_bind_to_co","v":{"s":"Primers (short DNA sequences) bind to complementary regions on each template strand."}},{"k":"dna_polymerase_taq_from_thermus_aquati","v":{"s":"DNA polymerase (Taq, from Thermus aquaticus) extends primers, synthesizing new DNA."}},{"k":"amplification","v":{"s":"Amplification"}},{"k":"each_cycle_doubles_target_dna_30_cycle","v":{"s":"Each cycle doubles target DNA. 30 cycles → ~10⁹-fold amplification."}},{"k":"inventor","v":{"s":"Inventor"}},{"k":"kary_mullis_invented_pcr_1983_won_nobe","v":{"s":"Kary Mullis invented PCR (1983); won Nobel Prize 1993."}},{"k":"taq_polymerase","v":{"s":"Taq polymerase"}},{"k":"from_thermophilic_bacterium_in_hot_spr","v":{"s":"From thermophilic bacterium in hot springs. Survives 95°C denaturation step."}},{"k":"qpcr_real_time","v":{"s":"qPCR (real-time)"}},{"k":"fluorescent_dyes_report_on_amplificati","v":{"s":"Fluorescent dyes report on amplification in real time. Used for COVID tests, gene expression."}},{"k":"reverse_transcription_pcr_converts_rna","v":{"s":"Reverse Transcription PCR. Converts RNA to cDNA first. Used for RNA viruses (COVID, HIV, flu)."}},{"k":"digital_pcr_dpcr","v":{"s":"Digital PCR (dPCR)"}},{"k":"partitions_sample_into_thousands_of_dr","v":{"s":"Partitions sample into thousands of droplets. Counts presence/absence — highly accurate quantification."}},{"k":"applications","v":{"s":"Applications"}},{"k":"diagnostics_forensics_gene_cloning_anc","v":{"s":"Diagnostics, forensics, gene cloning, ancient DNA (Jurassic Park-style; real life, mostly < 1 million years)."}},{"k":"first_crispr_therapy_fda_approved_dec_","v":{"s":"First CRISPR therapy FDA-approved (Dec 2023). Edits patient's stem cells ex vivo."}},{"k":"crispr_engineers_t_cells_to_attack_can","v":{"s":"CRISPR engineers T cells to attack cancer. Several Phase I/II trials."}},{"k":"crispr_knockout_libraries_reveal_which","v":{"s":"CRISPR knockout libraries reveal which genes are essential for disease."}},{"k":"faster_than_traditional_knockout_mice_","v":{"s":"Faster than traditional knockout mice. Used widely in research."}},{"k":"disease_resistant_rice_mushrooms_that_","v":{"s":"Disease-resistant rice, mushrooms that don't brown, gluten-free wheat (still mostly research)."}},{"k":"spread_sterility_or_malaria_resistance","v":{"s":"Spread sterility or malaria-resistance through wild populations. Field trials being debated."}},{"k":"he_jiankui_2018_edited_human_embryos_m","v":{"s":"He Jiankui (2018) edited human embryos → moral + scientific outcry. Currently banned in most countries."}},{"k":"human_body_has_10_human_cells_10_10_mi","v":{"s":"Human body has ~10¹³ human cells + ~10¹³-10¹⁴ microbial cells. Roughly equal in number."}},{"k":"500_1_000_bacterial_species_in_healthy","v":{"s":"500-1,000+ bacterial species in healthy adult gut. Plus archaea, fungi, viruses."}},{"k":"microbiome_carries_100_more_genes_than","v":{"s":"Microbiome carries ~100× more genes than human genome. Adds many metabolic capabilities."}},{"k":"gut_microbes_communicate_with_brain_vi","v":{"s":"Gut microbes communicate with brain via vagus nerve, immune signals, metabolites. Linked to mood, behavior — though many specific claims overstated."}},{"k":"broad_spectrum_antibiotics_wipe_out_co","v":{"s":"Broad-spectrum antibiotics wipe out commensals → may take months/years to recover. Some shifts persistent."}},{"k":"fecal_microbiota_transplant_fmt_cures_","v":{"s":"Fecal microbiota transplant (FMT) cures recurrent C. difficile infection ~90% of time. Other applications still experimental."}},{"k":"varies_by_body_site_forehead_oily_domi","v":{"s":"Varies by body site: forehead (oily, dominated by Cutibacterium acnes), gut (anaerobes), armpit (apocrine sweat + bacteria → body odor)."}},{"k":"healthy_lactobacillus_dominant_low_ph_","v":{"s":"Healthy: Lactobacillus dominant, low pH. Imbalance → bacterial vaginosis (BV)."}},{"k":"700_species_affects_cavities_gum_disea","v":{"s":"~700 species. Affects cavities, gum disease. Linked to cardiovascular risk."}},{"k":"vaginal_birth_seeds_infant_with_matern","v":{"s":"Vaginal birth seeds infant with maternal vaginal microbes; C-section seeds with skin microbes. Long-term effects studied (some contested)."}},{"k":"contains_live_bacteria_prebiotics_hmos","v":{"s":"Contains live bacteria + prebiotics (HMOs) that feed specific gut microbes (B. infantis)."}},{"k":"sperm_egg_fuse_diploid_zygote_forms","v":{"s":"Sperm + egg fuse. Diploid zygote forms."}},{"k":"rapid_cell_divisions_without_growth_2_","v":{"s":"Rapid cell divisions without growth. 2 → 4 → 8 → 16 cell stage."}},{"k":"solid_ball_of_16_32_cells","v":{"s":"Solid ball of ~16-32 cells."}},{"k":"hollow_ball_with_inner_cell_mass_futur","v":{"s":"Hollow ball with inner cell mass (future embryo) + trophoblast (future placenta)."}},{"k":"blastocyst_attaches_to_uterine_wall","v":{"s":"Blastocyst attaches to uterine wall."}},{"k":"cell_movements_form_3_germ_layers_ecto","v":{"s":"Cell movements form 3 germ layers: ectoderm, mesoderm, endoderm."}},{"k":"neural_tube_forms_from_ectoderm_future","v":{"s":"Neural tube forms from ectoderm. Future brain + spinal cord."}},{"k":"all_major_organs_begin_forming_heart_s","v":{"s":"All major organs begin forming. Heart starts beating ~week 4-5."}},{"k":"growth_maturation_major_structures_alr","v":{"s":"Growth + maturation. Major structures already formed."}},{"k":"cancer_cells_produce_their_own_growth_","v":{"s":"Cancer cells produce their own growth signals or activate receptors constitutively."}},{"k":"tumor_suppressors_p53_rb_inactivated_c","v":{"s":"Tumor suppressors (p53, Rb) inactivated → cells divide despite stop signals."}},{"k":"apoptosis_pathways_disabled_damaged_ce","v":{"s":"Apoptosis pathways disabled. Damaged cells survive when they should die."}},{"k":"reactivate_telomerase_telomeres_mainta","v":{"s":"Reactivate telomerase → telomeres maintained → unlimited divisions."}},{"k":"tumors_recruit_blood_vessels_to_feed_g","v":{"s":"Tumors recruit blood vessels to feed growing mass."}},{"k":"cells_lose_adhesion_migrate_colonize_d","v":{"s":"Cells lose adhesion, migrate, colonize distant tissues."}},{"k":"warburg_effect_tumors_use_glycolysis_e","v":{"s":"Warburg effect: tumors use glycolysis even in oxygen presence."}},{"k":"tumors_hide_from_or_suppress_immune_su","v":{"s":"Tumors hide from or suppress immune surveillance (PD-L1 expression)."}},{"k":"chronic_inflammation_creates_a_permiss","v":{"s":"Chronic inflammation creates a permissive environment."}},{"k":"accumulating_mutations_chromosomal_rea","v":{"s":"Accumulating mutations + chromosomal rearrangements drive evolution."}},{"k":"fast_non_specific_skin_mucus_complemen","v":{"s":"Fast, non-specific. Skin, mucus, complement, neutrophils, NK cells, macrophages."}},{"k":"slower_days_highly_specific_has_memory","v":{"s":"Slower (days), highly specific, has memory. B cells (antibodies) + T cells."}},{"k":"produce_antibodies_each_b_cell_makes_o","v":{"s":"Produce antibodies. Each B cell makes one specificity. Activated B cells become plasma cells."}},{"k":"coordinate_immune_response_hiv_target_","v":{"s":"Coordinate immune response. HIV target. Tipped from naive to specialized subsets (Th1, Th2, Th17, Treg)."}},{"k":"kill_infected_or_cancerous_cells_via_p","v":{"s":"Kill infected or cancerous cells via perforin + granzyme."}},{"k":"y_shaped_proteins_5_classes_igg_most_a","v":{"s":"Y-shaped proteins. 5 classes: IgG (most abundant), IgA (mucosal), IgM (initial), IgE (allergies + parasites), IgD (B-cell surface)."}},{"k":"cell_surface_molecules_that_present_an","v":{"s":"Cell-surface molecules that present antigens to T cells. MHC I (all cells, viral peptides). MHC II (immune cells, extracellular peptides)."}},{"k":"plasma_proteins_that_punch_holes_in_pa","v":{"s":"Plasma proteins that punch holes in pathogens + recruit phagocytes."}},{"k":"signaling_molecules_of_immune_system_i","v":{"s":"Signaling molecules of immune system. Interferons (anti-viral), interleukins (coordinate), TNF (inflammation)."}},{"k":"long_lived_b_t_cells_from_prior_exposu","v":{"s":"Long-lived B + T cells from prior exposure. Basis of vaccines + lifelong immunity."}},{"k":"train_adaptive_immunity_without_diseas","v":{"s":"Train adaptive immunity without disease. mRNA (COVID), protein subunit, attenuated live, inactivated."}},{"k":"immune_system_attacks_self_type_1_diab","v":{"s":"Immune system attacks self. Type 1 diabetes, RA, MS, lupus, Hashimoto's."}},{"k":"ige_mediated_hypersensitivity_mast_cel","v":{"s":"IgE-mediated hypersensitivity. Mast cells release histamine."}},{"k":"dendrites_receive_soma_cell_body_axon_","v":{"s":"Dendrites (receive), soma (cell body), axon (transmit), terminals (release neurotransmitter)."}},{"k":"all_or_none_electrical_signal_sodium_i","v":{"s":"All-or-none electrical signal. Sodium in → depolarize → potassium out → repolarize. ~1 ms. Traveling speed: ~1 m/s (unmyelinated) to ~100 m/s (myelinated)."}},{"k":"fatty_insulation_made_by_glia_oligoden","v":{"s":"Fatty insulation made by glia (oligodendrocytes in CNS, Schwann cells in PNS). Speeds conduction. Destroyed in MS."}},{"k":"junction_between_neurons_electrical_or","v":{"s":"Junction between neurons. Electrical or chemical (most). ~0.02 μm gap."}},{"k":"chemical_messengers_across_synapse_exc","v":{"s":"Chemical messengers across synapse. Excitatory (glutamate), inhibitory (GABA), modulatory (serotonin, dopamine)."}},{"k":"reward_motivation_motor_control_low_in","v":{"s":"Reward, motivation, motor control. Low in Parkinson's; dysregulated in schizophrenia."}},{"k":"mood_sleep_appetite_ssris_target_reupt","v":{"s":"Mood, sleep, appetite. SSRIs target reuptake."}},{"k":"neuromuscular_junction_memory_attentio","v":{"s":"Neuromuscular junction. Memory + attention. Low in Alzheimer's."}},{"k":"astrocytes_support_bbb_oligodendrocyte","v":{"s":"Astrocytes (support, BBB), oligodendrocytes (myelin in CNS), microglia (immune), ependymal cells (CSF)."}},{"k":"cerebrum_cortex_thinking_perception_ce","v":{"s":"Cerebrum (cortex — thinking, perception), cerebellum (motor coordination), brainstem (autonomic), limbic system (emotion + memory)."}},{"k":"brain_reorganizes_itself_strongest_in_","v":{"s":"Brain reorganizes itself — strongest in childhood but ongoing throughout life. Basis of learning."}},{"k":"tight_junctions_between_brain_capillar","v":{"s":"Tight junctions between brain capillary cells keep most molecules out. Major challenge for CNS drug delivery."}},{"k":"20_of_body_s_energy_at_rest_despite_be","v":{"s":"~20% of body's energy at rest despite being ~2% of mass. Mostly Na+/K+ pumps maintaining ion gradients."}},{"k":"first_mass_produced_human_protein_made","v":{"s":"First mass-produced human protein. Made in E. coli (1982). Replaced pig + cow insulin."}},{"k":"single_target_therapies_humira_autoimm","v":{"s":"Single-target therapies. Humira (autoimmune), Herceptin (HER2+ breast cancer), Keytruda (immunotherapy)."}},{"k":"covid_19_vaccines_pfizer_moderna_self_","v":{"s":"COVID-19 vaccines (Pfizer, Moderna). Self-amplifying versions + non-COVID applications in development."}},{"k":"replace_defective_genes_luxturna_inher","v":{"s":"Replace defective genes. Luxturna (inherited blindness, FDA 2017). Zolgensma (SMA, 2019)."}},{"k":"engineered_immune_cells_yescarta_kymri","v":{"s":"Engineered immune cells. Yescarta + Kymriah for blood cancers. ~$400K per dose."}},{"k":"bone_marrow_transplants_standard_for_d","v":{"s":"Bone marrow transplants standard for decades. Newer iPSC + ESC approaches in trials."}},{"k":"print_tissue_with_living_cells_scaffol","v":{"s":"Print tissue with living cells + scaffolds. Skin, cartilage, bladder. Whole organs still distant."}},{"k":"engineer_biological_systems_bacteria_t","v":{"s":"Engineer biological systems. Bacteria that produce drugs, yeast that brews opioids, algae biofuels."}},{"k":"bt_corn_insect_resistance_roundup_read","v":{"s":"Bt corn (insect resistance), Roundup Ready (herbicide), Golden Rice (vitamin A)."}},{"k":"str_profiling_mtdna_degraded_samples_y","v":{"s":"STR profiling, mtDNA (degraded samples), Y-chromosome (paternal lineage). Database matching."}},{"k":"snp_arrays_23andme_ancestrydna_reveals","v":{"s":"SNP arrays (23andMe, AncestryDNA). Reveals biogeographic ancestry + DNA relatives."}},{"k":"detect_cancer_dna_in_blood_earlier_dia","v":{"s":"Detect cancer DNA in blood. Earlier diagnosis, treatment monitoring."}},{"k":"treat_solid_tumors_til_therapy_iovance","v":{"s":"Treat solid tumors. TIL therapy (Iovance, melanoma) FDA approved 2024."}},{"k":"engineered_microbes_clean_up_oil_spill","v":{"s":"Engineered microbes clean up oil spills, plastic pollution, heavy metals."}},{"k":"pcr_polymerase_chain_reaction_2","v":{"s":"🧪 PCR (polymerase chain reaction)"}},{"k":"amplifies_specific_dna_sequences_a_bil","v":{"s":"Amplifies specific DNA sequences a billion-fold. Workhorse of molecular biology, diagnostics, and forensics."}},{"k":"the_3_steps_repeated_30","v":{"s":"The 3 steps (repeated ~30×)"}},{"k":"key_facts","v":{"s":"Key facts"}},{"k":"crispr_cas9","v":{"s":"✂ CRISPR-Cas9"}},{"k":"originally_a_bacterial_immune_system_n","v":{"s":"Originally a bacterial immune system; now a programmable gene-editing tool. Doudna + Charpentier shared 2020 Nobel Prize."}},{"k":"components_concepts","v":{"s":"Components + concepts"}},{"k":"real_applications","v":{"s":"Real applications"}},{"k":"virus_families_2","v":{"s":"🦠 Virus families"}},{"k":"viruses_are_non_living_infectious_agen","v":{"s":"Viruses are non-living infectious agents — they need a host cell to replicate. Classified by genome type (Baltimore classification), envelope, shape."}},{"k":"human_microbiome","v":{"s":"🦠 Human microbiome"}},{"k":"note","v":{"s":"⚠ Note: "}},{"k":"microbiome_science_is_advancing_fast_m","v":{"s":"Microbiome science is advancing fast. Many popular claims (specific probiotic strains \"curing\" specific conditions) outrun the evidence. Stick to robustly replicated findings."}},{"k":"embryonic_development","v":{"s":"🥚 Embryonic development"}},{"k":"stages_human_approximate","v":{"s":"Stages (human, approximate)"}},{"k":"germ_layers_what_each_forms","v":{"s":"Germ layers — what each forms"}},{"k":"hallmarks_of_cancer","v":{"s":"⚕ Hallmarks of cancer"}},{"k":"defined_by_hanahan_weinberg_2000_updat","v":{"s":"Defined by Hanahan + Weinberg (2000, updated 2011). Most cancers acquire most of these hallmarks. Therapy increasingly targets specific hallmarks."}},{"k":"the_immune_system","v":{"s":"🛡 The immune system"}},{"k":"neuroscience_basics","v":{"s":"🧠 Neuroscience basics"}},{"k":"tree_of_life_2","v":{"s":"🌳 Tree of life"}},{"k":"three_domains_woese_1990","v":{"s":"Three domains (Woese, 1990)"}},{"k":"traditional_eukaryote_kingdoms","v":{"s":"Traditional eukaryote kingdoms"}},{"k":"biotechnology_applications","v":{"s":"💉 Biotechnology applications"}},{"k":"export_evidence","v":{"s":"Export DNA evidence summary"}},{"k":"population_mutation_chart","v":{"s":"Population size and mutation rate chart comparing genetic drift and selection regimes."}},{"k":"hypothesis_input","v":{"s":"Evolutionary fixation hypothesis"}},{"k":"explanation_input","v":{"s":"Evolutionary fixation explanation"}},{"k":"protein_chain","v":{"s":"Protein chain"}}],"id":515}},{"k":"echolocation","v":{"o":[{"k":"a11y_energy","v":{"s":"Energy: {value1}%"}},{"k":"a11y_sound_wave_visualization_showing_a_sine_wave_at","v":{"s":"Sound wave visualization showing a sine wave at {value1} hertz with wavelength {value2} meters"}},{"k":"a11y_frequency_slider_hertz","v":{"s":"Frequency slider, {value1} hertz"}},{"k":"a11y_amplitude_slider_percent","v":{"s":"Amplitude slider, {value1} percent"}},{"k":"a11y_play_tone_at_hertz","v":{"s":"Play tone at {value1} hertz"}},{"k":"a11y_distance_to_object_meters","v":{"s":"Distance to object, {value1} meters"}},{"k":"a11y_sound_reflection_visualization_showing_incident","v":{"s":"Sound reflection visualization showing incident and reflected waves off {value1} wall"}},{"k":"a11y_human_noise_level_percent","v":{"s":"Human noise level, {value1} percent"}},{"k":"a11y_play_sound","v":{"s":"Play {value1} sound"}},{"k":"a11y_cricket_chirps_per_14_seconds","v":{"s":"Cricket chirps per 14 seconds: {value1}"}},{"k":"sr_object_discovered_at_distance_pixels","v":{"s":"Object discovered: {value1} at distance {value2} pixels"}},{"k":"sr_selected","v":{"s":"Selected: {value1}"}},{"k":"sr_sonar_pulse_emitted","v":{"s":"Sonar pulse emitted"}},{"k":"sr_cave_mapped_quest_complete","v":{"s":"Cave mapped! Quest complete!"}},{"k":"sr_soundscape_description_generated","v":{"s":"Soundscape description generated"}},{"k":"a11y_echolocation_sonar_scene_and_flight_controls","v":{"s":"Echolocation sonar scene and flight controls"}},{"k":"sonar_vision","v":{"s":"Sonar Vision"}},{"k":"3d_cave","v":{"s":"3D Cave"}},{"k":"sound_waves","v":{"s":"Sound Waves"}},{"k":"doppler_effect","v":{"s":"Doppler Effect"}},{"k":"bat_biology","v":{"s":"Bat Biology"}},{"k":"acoustic_ecology","v":{"s":"Acoustic Ecology"}},{"k":"sweep_discovery","v":{"s":"Sweep Discovery"}},{"k":"custom","v":{"s":"Custom"}},{"k":"place_your_own_objects_and_explore","v":{"s":"Place your own objects and explore."}},{"k":"choose_your_bat_species","v":{"s":"Choose Your Bat Species"}},{"k":"each_species_has_unique_echolocation_a","v":{"s":"Each species has unique echolocation abilities and hunting strategies. Your choice changes how the sonar simulator works."}},{"k":"select_bat_species","v":{"s":"Select bat species"}},{"k":"science_note","v":{"s":"🧬 Science Note"}},{"k":"species_selected_the_sonar_simulator_b","v":{"s":"Species selected! The sonar simulator below is now configured for your bat."}},{"k":"you_can_change_species_anytime_using_t","v":{"s":"You can change species anytime using the toggle in the game HUD."}},{"k":"luna_moth","v":{"s":"Luna Moth"}},{"k":"moth","v":{"s":"Moth"}},{"k":"luna_moth_2","v":{"s":"Luna Moth"}},{"k":"mosquito_swarm","v":{"s":"Mosquito Swarm"}},{"k":"beetle","v":{"s":"Beetle"}},{"k":"3d_cave_echolocation","v":{"s":"🔦 3D Cave Echolocation"}},{"k":"survive_in_the_dark_using_sonar_catch_","v":{"s":"Survive in the dark using sonar. Catch as many insects as you can before energy runs out. Press E to pulse. WASD to fly."}},{"k":"how_this_works_click_to_toggle","v":{"s":"📜 How this works (click to toggle)"}},{"k":"goal","v":{"s":"🎯 Goal"}},{"k":"catch_glowing_insects_to_refill_energy","v":{"s":"Catch glowing insects to refill energy. Stay airborne as long as you can. There is no \"win\" screen; the score is your survival time and the insects you caught. Try to beat your high score."}},{"k":"controls","v":{"s":"🕹 Controls"}},{"k":"what_you_re_learning","v":{"s":"🧠 What you're learning"}},{"k":"sonar_reveals_geometry_that_vision_can","v":{"s":"Sonar reveals geometry that vision cannot. The cave only \"exists\" at the moments you pulse."}},{"k":"echo_return_time_tells_distance_the_hu","v":{"s":"Echo-return time tells distance: the HUD shows d = v×t / 2 each pulse."}},{"k":"pulsing_costs_energy_real_bats_balance","v":{"s":"Pulsing costs energy. Real bats balance pulse rate against the prey density they're chasing."}},{"k":"difficulty_scales_with_survival_time_i","v":{"s":"Difficulty scales with survival time. Insects appear less often the longer you live."}},{"k":"loading_3d_engine_three_js_required","v":{"s":"Loading 3D engine... (Three.js required)"}},{"k":"three_js_loads_automatically_when_you_","v":{"s":"Three.js loads automatically when you open any 3D tool."}},{"k":"3d_echolocation_cave_failed_to_initial","v":{"s":"3D Echolocation Cave failed to initialize"}},{"k":"webgl_is_required_to_render_the_3d_cav","v":{"s":"WebGL is required to render the 3D cave environment. Please check your browser settings or hardware acceleration and try again."}},{"k":"retry","v":{"s":"Retry"}},{"k":"toggle_fullscreen_for_the_3d_cave","v":{"s":"Toggle fullscreen for the 3D cave"}},{"k":"fullscreen","v":{"s":"Fullscreen"}},{"k":"3d_echolocation_cave","v":{"s":"🦇 3D Echolocation Cave"}},{"k":"wasd_fly_e_sonar_p_perch_r_restart","v":{"s":"WASD=fly • E=sonar • P=perch • R=restart"}},{"k":"energy","v":{"s":"⚡ Energy"}},{"k":"perching_resting","v":{"s":"🦇 Perching (resting...)"}},{"k":"echo_return","v":{"s":"📏 Echo Return:"}},{"k":"how_to_echolocate","v":{"s":"🦇 How to Echolocate:"}},{"k":"out_of_energy","v":{"s":"Out of Energy!"}},{"k":"press_r_to_restart","v":{"s":"Press R to restart"}},{"k":"sonar","v":{"s":"🔦 Sonar"}},{"k":"perch","v":{"s":"🦇 Perch"}},{"k":"up","v":{"s":"⬆️ Up"}},{"k":"restart","v":{"s":"🔄 Restart"}},{"k":"e_sonar_pulse","v":{"s":"E = Sonar Pulse"}},{"k":"reveals_cave_walls_moths","v":{"s":"Reveals cave walls & moths"}},{"k":"wasd_fly","v":{"s":"WASD = Fly"}},{"k":"navigate_the_dark_cave","v":{"s":"Navigate the dark cave"}},{"k":"find_5_moths","v":{"s":"Find 5 Moths"}},{"k":"hidden_in_the_darkness","v":{"s":"Hidden in the darkness"}},{"k":"how_real_echolocation_works","v":{"s":"🧠 How Real Echolocation Works: "}},{"k":"bats_emit_ultrasonic_pulses_20_200_khz","v":{"s":"Bats emit ultrasonic pulses (20-200 kHz) from their mouths or noses. These sound waves bounce off objects and return to the bat’s ears. The time delay tells the bat how far away objects are, and the frequency shift (Doppler effect) tells it whether objects are moving toward or away. In this 3D simulation, each sonar pulse you emit travels outward and illuminates cave walls and moths as it passes them — just like a real bat’s sonar cone!"}},{"k":"echolocation_visualization","v":{"s":"Echolocation visualization"}},{"k":"sonar_vision_simulator_use_arrow_keys_","v":{"s":"Sonar vision simulator. Use arrow keys or WASD to move the bat. Press Space to emit a sonar pulse. Objects illuminate briefly when hit by sound waves."}},{"k":"change_species","v":{"s":"Change Species"}},{"k":"energy_2","v":{"s":"⚡ Energy"}},{"k":"add_object_to_custom_scene","v":{"s":"Add object to custom scene"}},{"k":"add_object","v":{"s":"+ Add Object"}},{"k":"a_d_steer","v":{"s":"⬅️➡️ A/D: Steer"}},{"k":"w_flap_wings_thrust_up","v":{"s":"⬆️ W: Flap wings (thrust up)"}},{"k":"s_dive","v":{"s":"⬇️ S: Dive"}},{"k":"space_emit_sonar_pulse","v":{"s":"SPACE: Emit sonar"}},{"k":"touch_ceiling_wall_perch_rest","v":{"s":"Perch: touch wall or ceiling"}},{"k":"emit_sonar_pulse","v":{"s":"Emit sonar pulse"}},{"k":"emit_pulse","v":{"s":"🦇 Emit Pulse"}},{"k":"toggle_fullscreen_for_the_sonar_canvas","v":{"s":"Toggle fullscreen for the sonar scene and flight controls"}},{"k":"fullscreen_2","v":{"s":"Fullscreen"}},{"k":"tiger_moth_jamming_your_sonar_these_mo","v":{"s":"🔇 Tiger moth jamming your sonar! These moths produce ultrasonic clicks that interfere with bat echolocation — a real anti-predator defense!"}},{"k":"how_sonar_vision_works","v":{"s":"💡 How Sonar Vision Works"}},{"k":"what_you_re_seeing","v":{"s":"What you're seeing:"}},{"k":"this_simulator_shows_what_a_bat_sees_t","v":{"s":"This simulator shows what a bat \"sees\" through sound. The world is almost completely dark — objects only become visible for a brief moment when hit by a sonar pulse."}},{"k":"brighter_echoes_closer_objects_or_hard","v":{"s":"Brighter echoes = closer objects or harder materials. Faint flickering echoes = soft-bodied insects (moths). The glow fades over 1-2 seconds, simulating how the bat's \"mental image\" decays between pulses."}},{"k":"tips_for_each_scene","v":{"s":"Tips for each scene:"}},{"k":"use_rapid_pulses_near_walls_to_build_u","v":{"s":"Use rapid pulses near walls to build up a detailed image. Find the exit (barely visible — it's open air with almost no echo). Watch for hidden passages!"}},{"k":"trees_give_strong_woody_echoes_water_p","v":{"s":"Trees give strong woody echoes. Water pools reflect dimly. Moths flit erratically — they're hard to track!"}},{"k":"buildings_give_rock_hard_echoes_street","v":{"s":"Buildings give rock-hard echoes. Streetlights create confusing bright spots. Moths cluster around lights."}},{"k":"fruit_glows_faintly_in_night_vision_tr","v":{"s":"Fruit glows faintly in night vision. Trees are large obstacles. Watch for vines!"}},{"k":"place_your_own_objects_and_try_to_iden","v":{"s":"Place your own objects and try to identify them by echo alone."}},{"k":"flight_tips","v":{"s":"Flight tips: "}},{"k":"press_w_to_flap_gravity_pulls_you_down","v":{"s":"Press W to flap — gravity pulls you down! Perch on surfaces to rest and recharge energy. Catching prey restores +15 energy."}},{"k":"fun_fact_real_bats_process_all_this_in","v":{"s":"Fun fact: Real bats process all this information in milliseconds using a brain the size of a peanut. They can catch 10-14 insects per minute in total darkness!"}},{"k":"species_comparison_insectivore_vs_frug","v":{"s":"🦇 Species Comparison — Insectivore vs Frugivore"}},{"k":"species_comparison_table","v":{"s":"Species comparison table"}},{"k":"both_strategies_are_real_insectivorous","v":{"s":"Both strategies are real! Insectivorous bats evolved high-powered laryngeal echolocation for active hunting. Most fruit bats rely on vision and smell, but Egyptian fruit bats are the exception — they developed tongue-click echolocation independently."}},{"k":"flight_energy_mechanics","v":{"s":"🎮 Flight & Energy Mechanics"}},{"k":"flight_physics","v":{"s":"🦇 Flight Physics"}},{"k":"gravity_pulls_the_bat_downward_constan","v":{"s":"Gravity pulls the bat downward constantly"}},{"k":"press_w_up_to_flap_wings_upward_thrust","v":{"s":"Press W/Up to flap wings (upward thrust impulse)"}},{"k":"momentum_builds_gradually_no_instant_s","v":{"s":"Momentum builds gradually — no instant stops"}},{"k":"air_friction_slows_you_down_over_time","v":{"s":"Air friction slows you down over time"}},{"k":"terminal_velocity_limits_fall_speed","v":{"s":"Terminal velocity limits fall speed"}},{"k":"energy_system","v":{"s":"⚡ Energy System"}},{"k":"energy_starts_at_100_and_drains_while_","v":{"s":"Energy starts at 100% and drains while flying"}},{"k":"catching_prey_fruit_restores_15_energy","v":{"s":"Catching prey/fruit restores +15 energy"}},{"k":"perching_on_surfaces_regenerates_energ","v":{"s":"Perching on surfaces regenerates energy slowly"}},{"k":"at_0_energy_you_can_only_glide_downwar","v":{"s":"At 0% energy, you can only glide downward"}},{"k":"frugivores_drain_energy_slower_efficie","v":{"s":"Frugivores drain energy slower (efficient gliders)"}},{"k":"moth_behavior","v":{"s":"🦋 Moth Behavior"}},{"k":"moths_move_erratically_sinusoidal_rand","v":{"s":"Moths move erratically (sinusoidal + random)"}},{"k":"40_chance_to_evade_when_sonar_hits_the","v":{"s":"40% chance to evade when sonar hits them"}},{"k":"tiger_moths_jam_your_sonar_with_ultras","v":{"s":"Tiger moths JAM your sonar with ultrasonic clicks!"}},{"k":"luna_moths_are_bigger_slower_worth_mor","v":{"s":"Luna moths are bigger, slower, worth more energy"}},{"k":"mosquito_swarms_are_tiny_and_fast","v":{"s":"Mosquito swarms are tiny and fast"}},{"k":"cave_secrets","v":{"s":"🗺️ Cave Secrets"}},{"k":"stalactites_drip_water_watch_for_rippl","v":{"s":"Stalactites drip water — watch for ripples"}},{"k":"a_bat_colony_hangs_on_the_ceiling","v":{"s":"A bat colony hangs on the ceiling"}},{"k":"find_the_hidden_passage_to_a_secret_ch","v":{"s":"Find the hidden passage to a secret chamber"}},{"k":"spider_webs_are_nearly_invisible_to_so","v":{"s":"Spider webs are nearly invisible to sonar"}},{"k":"a_rare_luna_moth_hides_in_the_hidden_c","v":{"s":"A rare Luna Moth hides in the hidden chamber"}},{"k":"echo_materials_guide","v":{"s":"🧱 Echo Materials Guide"}},{"k":"bright_sharp_echoes","v":{"s":"Bright, sharp echoes"}},{"k":"moderate_diffuse_echoes","v":{"s":"Moderate, diffuse echoes"}},{"k":"dim_rippling_echoes","v":{"s":"Dim, rippling echoes"}},{"k":"faint_flickering_echoes","v":{"s":"Faint flickering echoes"}},{"k":"moderate_soft_echoes_warm_glow_for_fru","v":{"s":"Moderate soft echoes, warm glow for fruit bats"}},{"k":"nearly_invisible_very_faint_thin_lines","v":{"s":"Nearly invisible! Very faint thin lines"}},{"k":"almost_invisible_no_echo","v":{"s":"Almost invisible (no echo)"}},{"k":"wave_visualizer","v":{"s":"Wave Visualizer"}},{"k":"echolocation_visualization_2","v":{"s":"Echolocation visualization"}},{"k":"20_hz","v":{"s":"20 Hz"}},{"k":"audible","v":{"s":"← Audible →"}},{"k":"bat_range","v":{"s":"← Bat range →"}},{"k":"200_khz","v":{"s":"200 kHz"}},{"k":"wavelength","v":{"s":"Wavelength"}},{"k":"period","v":{"s":"Period"}},{"k":"speed_of_sound_calculator","v":{"s":"Speed of Sound Calculator"}},{"k":"medium","v":{"s":"Medium"}},{"k":"emit_pulse_to_calculate_round_trip_tim","v":{"s":"Emit pulse to calculate round trip time"}},{"k":"emit_pulse_2","v":{"s":"🔊 Emit Pulse"}},{"k":"distance_speed_time_2","v":{"s":"distance = (speed × time) / 2"}},{"k":"reflection_vs_absorption","v":{"s":"Reflection vs Absorption"}},{"k":"echolocation_visualization_3","v":{"s":"Echolocation visualization"}},{"k":"inverse_square_law","v":{"s":"Inverse Square Law"}},{"k":"echolocation_visualization_4","v":{"s":"Echolocation visualization"}},{"k":"inverse_square_law_visualization_showi","v":{"s":"Inverse square law visualization showing sound intensity decreasing with distance. Intensity equals 1 over distance squared."}},{"k":"intensity_1_r","v":{"s":"Intensity ∝ 1 / r²"}},{"k":"this_is_why_bats_must_fly_close_to_obj","v":{"s":"This is why bats must fly close to objects — the echo gets 4x weaker when distance doubles!"}},{"k":"how_echolocation_works_step_by_step","v":{"s":"How Echolocation Works — Step by Step"}},{"k":"emit","v":{"s":"Emit"}},{"k":"the_bat_contracts_its_laryngeal_muscle","v":{"s":"The bat contracts its laryngeal muscles to produce an ultrasonic pulse (20-200 kHz). Some species call through their mouth; others through elaborate nose structures that focus the beam. Each pulse lasts only 1-5 milliseconds."}},{"k":"propagate","v":{"s":"Propagate"}},{"k":"the_sound_wave_travels_outward_at_343_","v":{"s":"The sound wave travels outward at 343 m/s (in air). At 50 kHz, the wavelength is only 6.9 mm — small enough to reflect off tiny insects. Higher frequencies give better resolution but shorter range."}},{"k":"reflect","v":{"s":"Reflect"}},{"k":"when_the_pulse_hits_an_object_some_ene","v":{"s":"When the pulse hits an object, some energy bounces back as an echo. Hard surfaces (rock, chitin) reflect strongly. Soft surfaces (fur, carpet) absorb most energy. The object's shape affects the echo pattern."}},{"k":"receive","v":{"s":"Receive"}},{"k":"the_bat_s_oversized_ears_collect_the_f","v":{"s":"The bat's oversized ears collect the faint echo. The tragus (inner ear flap) helps determine vertical direction. The time delay between the two ears (interaural time difference) provides horizontal direction."}},{"k":"process","v":{"s":"Process"}},{"k":"the_bat_s_auditory_cortex_extracts_inf","v":{"s":"The bat's auditory cortex extracts information from the echo in milliseconds: distance (from delay), size (from echo strength), shape (from echo pattern), texture (from frequency content), and speed (from Doppler shift)."}},{"k":"update","v":{"s":"Update"}},{"k":"the_bat_adjusts_its_next_pulse_based_o","v":{"s":"The bat adjusts its next pulse based on what it learned. Approaching prey? Increase pulse rate (buzz phase: up to 200/sec). Open space? Lower rate to conserve energy. This adaptive behavior is called \"acoustic gaze control.\""}},{"k":"key_formulas_sound_physics_reference","v":{"s":"Key Formulas — Sound Physics Reference"}},{"k":"wave_speed","v":{"s":"Wave Speed"}},{"k":"speed_frequency_times_wavelength_in_ai","v":{"s":"Speed = frequency times wavelength. In air at 20°C, v = 343 m/s."}},{"k":"echolocation_distance","v":{"s":"Echolocation Distance"}},{"k":"distance_to_object_speed_of_sound_time","v":{"s":"Distance to object = speed of sound times round-trip time, divided by 2 (sound travels there AND back)."}},{"k":"doppler_shift","v":{"s":"Doppler Shift"}},{"k":"observed_frequency_changes_when_source","v":{"s":"Observed frequency changes when source or receiver moves. Approaching = higher pitch, receding = lower pitch."}},{"k":"inverse_square_law_2","v":{"s":"Inverse Square Law"}},{"k":"sound_intensity_decreases_with_the_squ","v":{"s":"Sound intensity decreases with the square of distance. Double the distance = quarter the intensity."}},{"k":"wavelength_2","v":{"s":"Wavelength"}},{"k":"wavelength_determines_resolution_a_50_","v":{"s":"Wavelength determines resolution. A 50 kHz bat call in air has λ = 6.9 mm — perfect for detecting insects."}},{"k":"interaural_time_diff","v":{"s":"Interaural Time Diff"}},{"k":"time_difference_between_ears_for_a_bat","v":{"s":"Time difference between ears. For a bat with 2 cm ear spacing, max Δt ≈ 58 microseconds."}},{"k":"sound_in_the_real_world_technology_ins","v":{"s":"Sound in the Real World — Technology Inspired by Nature"}},{"k":"naval_sonar","v":{"s":"Naval SONAR"}},{"k":"submarines_use_active_sonar_emit_a_pin","v":{"s":"Submarines use active sonar (emit a \"ping\" and listen for echoes) exactly like bats. Passive sonar just listens for engine noise. SONAR stands for Sound Navigation And Ranging."}},{"k":"medical_ultrasound","v":{"s":"Medical Ultrasound"}},{"k":"ultrasound_imaging_sends_1_20_mhz_puls","v":{"s":"Ultrasound imaging sends 1-20 MHz pulses into the body and builds images from echoes. The same physics as echolocation, just at higher frequencies and through tissue instead of air."}},{"k":"parking_sensors","v":{"s":"Parking Sensors"}},{"k":"cars_use_ultrasonic_sensors_40_khz_to_","v":{"s":"Cars use ultrasonic sensors (40 kHz) to detect obstacles — a direct application of bat echolocation principles. The \"beeping\" speeds up as you get closer, mimicking a bat's buzz phase!"}},{"k":"autonomous_robots","v":{"s":"Autonomous Robots"}},{"k":"robot_vacuum_cleaners_and_drones_use_u","v":{"s":"Robot vacuum cleaners and drones use ultrasonic rangefinders to navigate. Engineers study bat flight algorithms to improve autonomous navigation in cluttered environments."}},{"k":"non_destructive_testing","v":{"s":"Non-Destructive Testing"}},{"k":"engineers_send_ultrasonic_pulses_throu","v":{"s":"Engineers send ultrasonic pulses through metal bridges, airplane wings, and pipelines to detect internal cracks. The echo pattern reveals hidden flaws before catastrophic failure."}},{"k":"assistive_technology","v":{"s":"Assistive Technology"}},{"k":"ultrasonic_canes_and_wearable_devices_","v":{"s":"Ultrasonic canes and wearable devices help blind individuals navigate by converting sonar echoes into vibrations or audio tones — giving humans a form of echolocation."}},{"k":"nature_invented_sonar_52_million_years","v":{"s":"Nature invented sonar 52 million years before humans. Nearly every sonar technology we've built was inspired by — or directly copied from — biological echolocation."}},{"k":"human_echolocation_yes_people_can_do_t","v":{"s":"Human Echolocation — Yes, People Can Do This!"}},{"k":"some_blind_individuals_have_learned_to","v":{"s":"Some blind individuals have learned to echolocate by making tongue clicks and listening to the echoes. Daniel Kish, known as \"the real-life Batman,\" can ride a bicycle through traffic using only tongue-click echolocation. Brain scans show that human echolocators process echo information in the VISUAL cortex — their brains literally \"see\" with sound, repurposing the visual processing centers."}},{"k":"research_shows_that_anyone_can_learn_b","v":{"s":"Research shows that anyone can learn basic echolocation with practice. The key is producing consistent clicks and learning to interpret the subtle differences in echo timing, loudness, and frequency that indicate object size, distance, and material."}},{"k":"how_the_doppler_effect_works","v":{"s":"How the Doppler effect works"}},{"k":"when_a_sound_source_and_a_listener_mov","v":{"s":"When a sound source and a listener move relative to each other, the listener hears a different frequency than what was emitted. Same physics that makes a passing ambulance siren drop in pitch as it goes by, and the same trick a bat uses to read whether prey is approaching or fleeing."}},{"k":"approaching","v":{"s":"Approaching"}},{"k":"receding","v":{"s":"Receding"}},{"k":"stationary","v":{"s":"Stationary"}},{"k":"try_it","v":{"s":"Try it: "}},{"k":"slide_the_moth_speed_below_watch_how_t","v":{"s":"slide the moth speed below. Watch how the wave spacing on the canvas changes, and how the \"Received\" frequency readout moves up (toward) or down (away) from the \"Emitted\" frequency."}},{"k":"doppler_effect_simulator","v":{"s":"Doppler Effect Simulator"}},{"k":"echolocation_visualization_5","v":{"s":"Echolocation visualization"}},{"k":"moth_speed_slider","v":{"s":"Moth speed slider"}},{"k":"emitted_frequency_slider","v":{"s":"Emitted frequency slider"}},{"k":"emitted","v":{"s":"Emitted"}},{"k":"received","v":{"s":"Received"}},{"k":"shift","v":{"s":"Shift"}},{"k":"play_doppler_shifted_tone_at_audible_f","v":{"s":"Play Doppler shifted tone at audible frequency"}},{"k":"hear_it_scaled_to_audible","v":{"s":"🔊 Hear It (scaled to audible)"}},{"k":"doppler_challenge","v":{"s":"Doppler Challenge"}},{"k":"start_doppler_challenge_quiz","v":{"s":"Start Doppler challenge quiz"}},{"k":"new_challenge","v":{"s":"🦇 New Challenge"}},{"k":"a_moth_is_moving_based_on_the_wave_pat","v":{"s":"A moth is moving. Based on the wave pattern, which direction is it going?"}},{"k":"try_another_doppler_challenge","v":{"s":"Try another Doppler challenge"}},{"k":"next_challenge","v":{"s":"Next Challenge →"}},{"k":"real_world_doppler","v":{"s":"🌍 Real-World Doppler"}},{"k":"ambulance_siren","v":{"s":"Ambulance Siren"}},{"k":"the_classic_example_the_siren_sounds_h","v":{"s":"The classic example: the siren sounds higher-pitched as it approaches and lower as it moves away. The sound waves literally compress and stretch."}},{"k":"doppler_weather_radar","v":{"s":"Doppler Weather Radar"}},{"k":"radar_stations_send_microwave_pulses_a","v":{"s":"Radar stations send microwave pulses at clouds. The frequency shift of the reflected signal tells meteorologists the speed and direction of wind and precipitation."}},{"k":"bat_hunting_buzz_phase","v":{"s":"Bat Hunting: Buzz Phase"}},{"k":"as_a_bat_closes_in_on_prey_it_increase","v":{"s":"As a bat closes in on prey, it increases pulse rate from ~10/sec to 200/sec. The Doppler shift of each echo tells the bat exactly how fast the moth is moving."}},{"k":"medical_ultrasound_2","v":{"s":"Medical Ultrasound"}},{"k":"doctors_use_doppler_ultrasound_to_meas","v":{"s":"Doctors use Doppler ultrasound to measure blood flow velocity. The frequency shift of echoes from moving blood cells reveals the speed and direction of blood flow."}},{"k":"bat_hunting_strategy_the_three_phases","v":{"s":"Bat Hunting Strategy — The Three Phases"}},{"k":"a_bat_s_echolocation_strategy_changes_","v":{"s":"A bat's echolocation strategy changes dramatically during a hunt. Scientists divide the attack into three phases based on pulse rate:"}},{"k":"the_bat_cruises_through_its_territory_","v":{"s":"The bat cruises through its territory, emitting slow, long-range pulses. Each call is wide-beam to scan a large area. Calls are long (10-20 ms) and spaced far apart to avoid overlap between outgoing pulse and returning echo. The bat is listening for any hint of prey."}},{"k":"prey_detected_the_bat_narrows_its_sona","v":{"s":"Prey detected! The bat narrows its sonar beam toward the target and increases pulse rate. Calls get shorter (5-10 ms) and higher frequency for better resolution. The bat is now tracking the moth's evasive maneuvers, adjusting its flight path with each echo."}},{"k":"the_final_attack_pulse_rate_skyrockets","v":{"s":"The final attack! Pulse rate skyrockets to 200/sec — the fastest muscle contractions in any mammal. Calls are now ultra-short (0.5-1 ms). The bat gets a near-continuous stream of position updates, like switching from photographs to live video. Catch rate: ~40-50% of attempts succeed."}},{"k":"moth_counter_strategies_some_moths_hav","v":{"s":"Moth counter-strategies: Some moths have ears that detect bat sonar and trigger evasive dives. Others (tiger moths) emit their own ultrasonic clicks that \"jam\" bat sonar — acoustic warfare in the night sky!"}},{"k":"moth_types_anti_predator_adaptations","v":{"s":"Moth Types & Anti-Predator Adaptations"}},{"k":"the_evolutionary_arms_race_between_bat","v":{"s":"The evolutionary arms race between bats and moths has produced remarkable adaptations on both sides. In the simulator, you encounter four moth types, each based on real species:"}},{"k":"standard_moths_with_basic_flight_patte","v":{"s":"Standard moths with basic flight patterns. Some have evolved tympanic organs (ears) on their thorax that detect bat ultrasound, triggering evasive dives and loops."}},{"k":"tiger_moths_produce_their_own_ultrason","v":{"s":"Tiger moths produce their own ultrasonic clicks that JAM bat sonar! They emit rapid trains of clicks that interfere with the bat's ability to process echoes — like a biological radar jammer. Some species also use these clicks to warn bats that they taste bad (aposematism)."}},{"k":"luna_moths_are_large_beautiful_moths_w","v":{"s":"Luna moths are large, beautiful moths with long tail streamers. Research shows these tails confuse bat sonar by creating echo signatures that misdirect the bat's attack — the bat strikes the tail instead of the body. They are worth more energy when caught."}},{"k":"tiny_fast_moving_targets_that_cluster_","v":{"s":"Tiny, fast-moving targets that cluster together. While individual mosquitoes are hard to echolocate due to their small size, bats use a rapid-fire \"buzz phase\" approach to track them. Little brown bats can catch 1,000 mosquitoes per hour!"}},{"k":"evolutionary_arms_race","v":{"s":"🧬 Evolutionary Arms Race"}},{"k":"this_bat_moth_conflict_has_been_raging","v":{"s":"This bat-moth conflict has been raging for 65+ million years. As bats evolved better sonar, moths evolved ears. As moths evolved ears, some bats evolved \"stealth\" echolocation (quieter calls). As some bats went quiet, tiger moths evolved sonar jamming. The arms race continues! This is a textbook example of co-evolution driven by predator-prey dynamics."}},{"k":"fruit_bat_foraging_a_different_strateg","v":{"s":"Fruit Bat Foraging — A Different Strategy"}},{"k":"while_insectivorous_bats_are_aerial_hu","v":{"s":"While insectivorous bats are aerial hunters, fruit bats use a completely different foraging strategy. In the simulator's frugivore mode, you experience how Egyptian fruit bats navigate:"}},{"k":"night_vision","v":{"s":"👁️ Night Vision"}},{"k":"fruit_bats_have_large_eyes_with_a_high","v":{"s":"Fruit bats have large eyes with a high density of rod cells, giving them excellent low-light vision. In the simulator, ripe fruit glows faintly even without sonar pulses — simulating this visual advantage."}},{"k":"smell","v":{"s":"👃 Smell"}},{"k":"in_reality_fruit_bats_locate_ripe_frui","v":{"s":"In reality, fruit bats locate ripe fruit primarily through smell. Ripe mangoes, figs, and guavas emit strong volatile compounds that bats can detect from hundreds of meters away."}},{"k":"tongue_clicks","v":{"s":"🔊 Tongue Clicks"}},{"k":"egyptian_fruit_bats_produce_echolocati","v":{"s":"Egyptian fruit bats produce echolocation clicks with their tongue, not their larynx. These clicks are lower intensity and broader beam than insectivore sonar — good for obstacle avoidance but not precise enough for catching insects."}},{"k":"seed_dispersal","v":{"s":"🌱 Seed Dispersal"}},{"k":"fruit_bats_are_critical_for_tropical_e","v":{"s":"Fruit bats are critical for tropical ecosystems. They eat fruit and deposit seeds far from the parent tree. A single fruit bat can disperse thousands of seeds per night, making them essential for forest regeneration."}},{"k":"over_500_plant_species_depend_on_bat_p","v":{"s":"Over 500 plant species depend on bat pollination or seed dispersal, including mangoes, bananas, agave (tequila!), and durian. Without fruit bats, many tropical foods would not exist."}},{"k":"the_math_behind_the_doppler_effect","v":{"s":"The Math Behind the Doppler Effect"}},{"k":"f_f_v_v_receiver_v_v_source","v":{"s":"f' = f × (v + v_receiver) / (v + v_source)"}},{"k":"f_emitted_frequency_v_speed_of_sound_3","v":{"s":"f = emitted frequency, v = speed of sound (343 m/s), v_r = receiver velocity, v_s = source velocity"}},{"k":"for_a_bat_hunting_a_moth","v":{"s":"For a bat hunting a moth: "}},{"k":"the_bat_is_both_the_source_emitting_an","v":{"s":"The bat is both the source (emitting) and receiver (listening to echoes). If the moth is flying toward the bat at 5 m/s:"}},{"k":"outgoing_f_50_000_343_5_343_50_729_hz","v":{"s":"Outgoing: f' = 50,000 × (343 + 5) / 343 = 50,729 Hz"}},{"k":"reflected_f_50_729_343_343_5_51_479_hz","v":{"s":"Reflected: f'' = 50,729 × (343) / (343 - 5) = 51,479 Hz"}},{"k":"total_doppler_shift_1_479_hz_2_96","v":{"s":"Total Doppler shift: +1,479 Hz (+2.96%)"}},{"k":"the_bat_detects_this_1_479_hz_shift_an","v":{"s":"The bat detects this +1,479 Hz shift and knows the moth is approaching. The larger the shift, the faster the moth is moving. Sideways motion produces no Doppler shift — only the radial component matters."}},{"k":"biology_sections","v":{"s":"Biology sections"}},{"k":"anatomy","v":{"s":"Anatomy"}},{"k":"species_gallery","v":{"s":"Species Gallery"}},{"k":"conservation","v":{"s":"Conservation"}},{"k":"bat_anatomy_click_a_part_to_learn_more","v":{"s":"🦠 Bat Anatomy — Click a part to learn more"}},{"k":"echolocation_visualization_6","v":{"s":"Echolocation visualization"}},{"k":"interactive_bat_anatomy_diagram_click_","v":{"s":"Interactive bat anatomy diagram. Click or use keyboard to select wing, ear, nose, thumb claw, tail membrane, or larynx."}},{"k":"fun_fact","v":{"s":"🤓 Fun Fact"}},{"k":"physics","v":{"s":"⚙️ Physics"}},{"k":"click_or_tap_a_part_of_the_bat_to_expl","v":{"s":"Click or tap a part of the bat to explore it. Use arrow keys for keyboard navigation."}},{"k":"vs_bat_wings_vs_bird_wings","v":{"s":"🦇 vs 🐦 Bat Wings vs Bird Wings"}},{"k":"both_bats_and_birds_fly_but_their_wing","v":{"s":"Both bats and birds fly, but their wings evolved completely independently. The differences reveal how evolution solves the same problem in different ways:"}},{"k":"bat_wing","v":{"s":"Bat Wing"}},{"k":"membrane_stretched_between_elongated_f","v":{"s":"• Membrane stretched between elongated FINGER bones"}},{"k":"can_change_wing_shape_dramatically_hig","v":{"s":"• Can change wing shape dramatically (high maneuverability)"}},{"k":"thinner_more_flexible_generates_less_l","v":{"s":"• Thinner, more flexible — generates less lift per area"}},{"k":"cannot_fold_flat_bats_must_hang_upside","v":{"s":"• Cannot fold flat — bats must hang upside down to rest"}},{"k":"excellent_for_slow_agile_flight_and_ho","v":{"s":"• Excellent for slow, agile flight and hovering"}},{"k":"wing_loading_5_15_n_m_very_light","v":{"s":"• Wing loading: 5-15 N/m² (very light)"}},{"k":"can_make_tighter_turns_than_any_bird","v":{"s":"• Can make tighter turns than any bird"}},{"k":"bird_wing","v":{"s":"Bird Wing"}},{"k":"feathers_attached_to_fused_arm_bones","v":{"s":"• Feathers attached to fused ARM bones"}},{"k":"more_rigid_shape_better_for_sustained_","v":{"s":"• More rigid shape — better for sustained flight"}},{"k":"thicker_airfoil_generates_more_lift_pe","v":{"s":"• Thicker airfoil — generates more lift per area"}},{"k":"can_fold_flat_against_body_birds_can_p","v":{"s":"• Can fold flat against body — birds can perch and walk"}},{"k":"excellent_for_fast_efficient_long_dist","v":{"s":"• Excellent for fast, efficient long-distance flight"}},{"k":"wing_loading_10_200_n_m_varies_by_spec","v":{"s":"• Wing loading: 10-200 N/m² (varies by species)"}},{"k":"better_at_soaring_and_gliding","v":{"s":"• Better at soaring and gliding"}},{"k":"key_insight_bat_wings_are_essentially_","v":{"s":"Key insight: Bat wings are essentially hands with webbing. Each \"finger\" can be controlled independently, giving bats unparalleled maneuverability — essential for catching insects in mid-air using echolocation."}},{"k":"beyond_echolocation_bat_superpowers","v":{"s":"👀 Beyond Echolocation — Bat Superpowers"}},{"k":"vision","v":{"s":"Vision"}},{"k":"despite_the_myth_all_bats_can_see_frui","v":{"s":"Despite the myth, all bats can see. Fruit bats have large eyes with excellent night vision. Even echolocating bats use vision for long-range navigation — they use landmarks and the sunset glow to orient during migration."}},{"k":"magnetic_sense","v":{"s":"Magnetic Sense"}},{"k":"some_bat_species_can_detect_earth_s_ma","v":{"s":"Some bat species can detect Earth's magnetic field and use it as an internal compass. Scientists discovered this by putting tiny magnets on bats' heads — the bats became disoriented!"}},{"k":"heat_detection","v":{"s":"Heat Detection"}},{"k":"vampire_bats_have_infrared_sensing_pit","v":{"s":"Vampire bats have infrared-sensing pits on their nose that detect blood vessels under skin from inches away. This is convergent evolution with pit vipers!"}},{"k":"smell_2","v":{"s":"Smell"}},{"k":"fruit_bats_locate_ripe_fruit_using_an_","v":{"s":"Fruit bats locate ripe fruit using an acute sense of smell. Some flower-visiting bats can smell the difference between flowers that still have nectar and those already depleted by other bats."}},{"k":"bat_diet_diversity_not_just_bugs_and_f","v":{"s":"🍽️ Bat Diet Diversity — Not Just Bugs and Fruit!"}},{"k":"with_over_1_400_species_bats_have_evol","v":{"s":"With over 1,400 species, bats have evolved an incredible range of diets. The two playable species in the simulator represent the two largest dietary groups, but bats eat much more:"}},{"k":"most_bat_species_eat_insects_a_single_","v":{"s":"Most bat species eat insects. A single colony can consume tons of agricultural pests nightly."}},{"k":"fruit_bats_disperse_seeds_and_pollinat","v":{"s":"Fruit bats disperse seeds and pollinate hundreds of plant species across tropical regions."}},{"k":"nectar_feeding_bats_have_long_tongues_","v":{"s":"Nectar-feeding bats have long tongues and pollinate night-blooming flowers including agave and cactus."}},{"k":"fishing_bats_skim_water_surfaces_using","v":{"s":"Fishing bats skim water surfaces using echolocation to detect fish fins breaking the surface."}},{"k":"some_large_bats_prey_on_frogs_lizards_","v":{"s":"Some large bats prey on frogs, lizards, birds, and even other bats! The false vampire bat is an apex predator."}},{"k":"only_3_species_of_vampire_bats_exist_t","v":{"s":"Only 3 species of vampire bats exist. They lap blood from cattle/birds using anticoagulant saliva."}},{"k":"the_diversity_of_bat_diets_reflects_th","v":{"s":"The diversity of bat diets reflects their evolutionary success. Bats make up ~25% of all mammal species — second only to rodents. Every continent except Antarctica has bats."}},{"k":"evolution_of_echolocation_timeline","v":{"s":"⏰ Evolution of Echolocation — Timeline"}},{"k":"key_debate_did_bats_evolve_flight_firs","v":{"s":"Key debate: Did bats evolve flight first, then echolocation? Or echolocation first, then flight? The Onychonycteris fossil suggests flight came first — but the question remains open."}},{"k":"bat_species_gallery","v":{"s":"🦇 Bat Species Gallery"}},{"k":"fun_fact_2","v":{"s":"🤓 Fun Fact"}},{"k":"conservation_2","v":{"s":"⚠️ Conservation"}},{"k":"white_nose_syndrome","v":{"s":"White-Nose Syndrome"}},{"k":"white_nose_syndrome_wns_is_caused_by_t","v":{"s":"White-nose syndrome (WNS) is caused by the fungus Pseudogymnoascus destructans. It grows on the skin of hibernating bats, irritating them and causing them to wake up repeatedly during winter. Each arousal burns precious fat reserves. By spring, infected bats have starved to death."}},{"k":"first_detected_in_ny","v":{"s":"First detected in NY"}},{"k":"population_decline_in_some_species","v":{"s":"Population decline in some species"}},{"k":"us_states_affected","v":{"s":"US states affected"}},{"k":"wind_turbine_barotrauma","v":{"s":"Wind Turbine Barotrauma"}},{"k":"bats_are_killed_by_wind_turbines_not_j","v":{"s":"Bats are killed by wind turbines not just from blade strikes, but from barotrauma — the rapid pressure drop near spinning blades causes their lungs to expand and blood vessels to burst. Migratory species like the hoary bat are most at risk. Solutions include curtailing turbines during peak migration and low-wind nights when bats are most active."}},{"k":"what_you_can_do","v":{"s":"What YOU Can Do"}},{"k":"build_a_bat_box","v":{"s":"Build a bat box"}},{"k":"provide_roosting_habitat_place_bat_hou","v":{"s":"Provide roosting habitat. Place bat houses 10-15 feet high on a south-facing wall."}},{"k":"reduce_light_pollution","v":{"s":"Reduce light pollution"}},{"k":"turn_off_unnecessary_outdoor_lights_li","v":{"s":"Turn off unnecessary outdoor lights. Light pollution disrupts bat foraging and insect availability."}},{"k":"avoid_disturbing_caves","v":{"s":"Avoid disturbing caves"}},{"k":"never_enter_caves_where_bats_hibernate","v":{"s":"Never enter caves where bats hibernate. Human visits during winter can be fatal to hibernating bats."}},{"k":"support_conservation","v":{"s":"Support conservation"}},{"k":"donate_to_bat_conservation_internation","v":{"s":"Donate to Bat Conservation International (BCI) or your state wildlife agency's bat programs."}},{"k":"habitat_loss","v":{"s":"Habitat Loss"}},{"k":"deforestation_cave_commercialization_b","v":{"s":"Deforestation, cave commercialization, building demolition, and land development destroy bat roosting sites. Many bat species need specific conditions: caves with stable temperatures for hibernation, dead trees with loose bark for summer roosting, and dark areas near water for foraging. When we remove these, bats have nowhere to go."}},{"k":"bat_species_worldwide","v":{"s":"bat species worldwide"}},{"k":"threatened_or_endangered","v":{"s":"threatened or endangered"}},{"k":"annual_value_of_pest_control","v":{"s":"annual value of pest control"}},{"k":"bat_myths_busted","v":{"s":"Bat Myths — Busted!"}},{"k":"why_bats_matter_ecosystem_services","v":{"s":"Why Bats Matter — Ecosystem Services"}},{"k":"pest_control","v":{"s":"Pest Control"}},{"k":"a_single_colony_of_150_big_brown_bats_","v":{"s":"A single colony of 150 big brown bats eats enough cucumber beetles to prevent 33 million rootworm larvae per summer. US bats save farmers $23 billion annually in avoided pesticide costs."}},{"k":"pollination","v":{"s":"Pollination"}},{"k":"over_500_plant_species_depend_on_bat_p_2","v":{"s":"Over 500 plant species depend on bat pollination, including agave (tequila!), bananas, mangoes, and durian. Without bats, many tropical ecosystems would collapse."}},{"k":"seed_dispersal_2","v":{"s":"Seed Dispersal"}},{"k":"fruit_bats_spread_seeds_across_tropica","v":{"s":"Fruit bats spread seeds across tropical forests, regenerating cleared land. A single fruit bat can disperse thousands of seeds per night, making them critical for reforestation."}},{"k":"medical_research","v":{"s":"Medical Research"}},{"k":"bat_saliva_anticoagulants_inspired_str","v":{"s":"Bat saliva anticoagulants inspired stroke medications. Bat immune systems fight viruses without getting sick, teaching us about disease resistance. Bat sonar inspires technology for blind navigation devices."}},{"k":"maine_bat_facts","v":{"s":"🇺🇸 Maine Bat Facts"}},{"k":"maine_has_8_bat_species_the_little_bro","v":{"s":"Maine has 8 bat species. The little brown bat, once our most common species, has declined 90% due to white-nose syndrome. Big brown bats and hoary bats can still be spotted in Maine. If you see a bat flying at dusk, count yourself lucky — and know that single bat might eat 1,000 mosquitoes tonight!"}},{"k":"maine_s_8_bat_species","v":{"s":"Maine's 8 bat species: "}},{"k":"little_brown_bat_big_brown_bat_norther","v":{"s":"Little brown bat, Big brown bat, Northern long-eared bat (endangered), Eastern small-footed bat, Tri-colored bat, Silver-haired bat, Hoary bat, Red bat. The cave-hibernating species (first 4) are most affected by white-nose syndrome."}},{"k":"stem_project_build_a_bat_box","v":{"s":"STEM Project: Build a Bat Box!"}},{"k":"help_local_bat_populations_by_building","v":{"s":"Help local bat populations by building a roosting box. This is a great hands-on project that combines woodworking, biology, and environmental science."}},{"k":"untreated_plywood_or_cedar_never_press","v":{"s":"Untreated plywood or cedar (never pressure-treated — toxic to bats), wood screws, exterior caulk, dark exterior paint or stain"}},{"k":"at_least_24_tall_x_14_wide_x_3_5_deep_","v":{"s":"At least 24\" tall x 14\" wide x 3.5\" deep. Internal chambers with 3/4\" spacing. Rough or grooved interior surfaces so bats can grip."}},{"k":"mount_10_15_feet_high_on_a_south_facin","v":{"s":"Mount 10-15 feet high on a south-facing wall or pole. Full sun exposure is critical — bats need warmth. Near water is ideal."}},{"k":"install_by_early_spring_march_april_in","v":{"s":"Install by early spring (March-April in Maine). Bats may take 1-2 years to discover and colonize a new box. Be patient!"}},{"k":"a_single_bat_box_can_house_50_200_bats","v":{"s":"A single bat box can house 50-200 bats. Those bats will eat millions of insects each summer, naturally reducing mosquitoes and crop pests in your area. Science + engineering + conservation = win!"}},{"k":"ecology_sections","v":{"s":"Ecology sections"}},{"k":"soundscape","v":{"s":"Soundscape"}},{"k":"bioacoustics","v":{"s":"Bioacoustics"}},{"k":"sound_map","v":{"s":"Sound Map"}},{"k":"night_soundscape_toggle_animals_to_hea","v":{"s":"Night Soundscape — Toggle animals to hear how they share the frequency space"}},{"k":"echolocation_visualization_7","v":{"s":"Echolocation visualization"}},{"k":"acoustic_niche_hypothesis","v":{"s":"🎵 Acoustic Niche Hypothesis"}},{"k":"animals_evolved_to_call_at_different_f","v":{"s":"Animals evolved to call at different frequencies so they don't interfere with each other — like radio stations on different channels. Insects use high frequencies, frogs use mid-range, owls use low frequencies, and bats use ultrasonic frequencies above human hearing. This frequency partitioning allows multiple species to communicate simultaneously without \"jamming\" each other's signals."}},{"k":"how_soundscapes_change_with_seasons","v":{"s":"🍃 How Soundscapes Change with Seasons"}},{"k":"acoustic_ecologists_record_soundscapes","v":{"s":"Acoustic ecologists record soundscapes year-round at fixed locations. By comparing recordings over years, they can detect biodiversity changes — a \"quieter\" spring chorus may indicate declining bird populations."}},{"k":"the_decibel_scale_how_loud_is_loud","v":{"s":"📊 The Decibel Scale — How Loud Is Loud?"}},{"k":"threshold_of_hearing","v":{"s":"Threshold of hearing"}},{"k":"rustling_leaves_whisper","v":{"s":"Rustling leaves, whisper"}},{"k":"quiet_library","v":{"s":"Quiet library"}},{"k":"normal_conversation","v":{"s":"Normal conversation"}},{"k":"vacuum_cleaner_city_traffic","v":{"s":"Vacuum cleaner, city traffic"}},{"k":"chainsaw_bat_echolocation_call","v":{"s":"Chainsaw, bat echolocation call!"}},{"k":"jet_engine_at_100m_pain_threshold","v":{"s":"Jet engine at 100m, pain threshold"}},{"k":"bat_echolocation_at_source_up_to_140_d","v":{"s":"Bat echolocation at source (up to 140 dB!)"}},{"k":"blue_whale_call_loudest_animal","v":{"s":"Blue whale call (loudest animal)"}},{"k":"decibels_are_logarithmic_every_10_db_i","v":{"s":"Decibels are logarithmic: every +10 dB is perceived as roughly twice as loud. A bat's echolocation call at the source (140 dB) would be painfully loud to humans — but we can't hear it because it's ultrasonic!"}},{"k":"bioacoustics_explorer","v":{"s":"🔊 Bioacoustics Explorer"}},{"k":"play","v":{"s":"🔊 Play"}},{"k":"convergent_evolution","v":{"s":"🧬 Convergent Evolution"}},{"k":"both_bats_and_dolphins_evolved_echoloc","v":{"s":"Both bats and dolphins evolved echolocation independently — a textbook case of convergent evolution! Despite being separated by 80 million years of evolution, they use remarkably similar strategies: emit high-frequency pulses, listen for echoes, and build a \"sound picture\" of their environment. Even the neural circuits that process echoes are similar, suggesting evolution has found an optimal solution to the sonar problem."}},{"k":"cricket_thermometer_dolbear_s_law","v":{"s":"Cricket Thermometer — Dolbear's Law"}},{"k":"crickets_are_cold_blooded_so_their_chi","v":{"s":"Crickets are cold-blooded, so their chirp rate changes with temperature. Amos Dolbear discovered this relationship in 1897. Count the number of chirps in 14 seconds and add 40 to get the approximate temperature in °F!"}},{"k":"t_f_n_40","v":{"s":"T(°F) = N₁₄ + 40"}},{"k":"where_n_number_of_chirps_in_14_seconds","v":{"s":"where N₁₄ = number of chirps in 14 seconds"}},{"k":"fahrenheit","v":{"s":"Fahrenheit"}},{"k":"celsius","v":{"s":"Celsius"}},{"k":"the_physics_cricket_muscles_contract_f","v":{"s":"The physics: cricket muscles contract faster in warm temperatures because chemical reactions speed up. This is the same reason reptiles are sluggish in cold weather — enzymes work slower at lower temperatures (Arrhenius equation)."}},{"k":"echolocation_across_species","v":{"s":"🔍 Echolocation Across Species"}},{"k":"multiple_animals_have_evolved_the_abil","v":{"s":"Multiple animals have evolved the ability to \"see\" with sound. Compare their sonar systems:"}},{"k":"comparison_of_echolocation_across_spec","v":{"s":"Comparison of echolocation across species"}},{"k":"note_sound_travels_4_3x_faster_in_wate","v":{"s":"Note: Sound travels ~4.3x faster in water than air, so dolphin sonar has much greater range than bat sonar at similar frequencies."}},{"k":"speed_of_sound_in_different_media","v":{"s":"⚡ Speed of Sound in Different Media"}},{"k":"sound_moves_slowly_through_air_because","v":{"s":"Sound moves slowly through air because air molecules are far apart. Speed increases ~0.6 m/s per °C rise in temperature."}},{"k":"water_molecules_are_closer_together_tr","v":{"s":"Water molecules are closer together, transmitting vibrations much faster. This is why dolphin sonar works at much greater distances than bat sonar."}},{"k":"rigid_solids_transmit_sound_fastest_be","v":{"s":"Rigid solids transmit sound fastest because atoms are tightly packed and bonded. You can hear a train coming by putting your ear to the rail long before you hear it through air!"}},{"k":"nature_vs_technology_sonar_showdown","v":{"s":"🤖 Nature vs Technology: Sonar Showdown"}},{"k":"bat_echolocation","v":{"s":"Bat Echolocation"}},{"k":"naval_sonar_2","v":{"s":"Naval SONAR"}},{"k":"pound_for_pound_bat_echolocation_is_th","v":{"s":"Pound for pound, bat echolocation is the most sophisticated sonar system on Earth. Engineers study bats to improve robot navigation and autonomous vehicles."}},{"k":"ai_sound_map_generator","v":{"s":"AI Sound Map Generator"}},{"k":"choose_an_environment_and_time_of_day_","v":{"s":"Choose an environment and time of day. The AI will describe the soundscape — what animals you'd hear, their frequencies, and how they share the acoustic space."}},{"k":"environment","v":{"s":"Environment"}},{"k":"select_environment","v":{"s":"Select environment"}},{"k":"temperate_forest","v":{"s":"Temperate Forest"}},{"k":"tropical_rainforest","v":{"s":"Tropical Rainforest"}},{"k":"desert","v":{"s":"Desert"}},{"k":"ocean_coast","v":{"s":"Ocean Coast"}},{"k":"cave","v":{"s":"Cave"}},{"k":"freshwater_pond","v":{"s":"Freshwater Pond"}},{"k":"arctic_tundra","v":{"s":"Arctic Tundra"}},{"k":"coral_reef_underwater","v":{"s":"Coral Reef (underwater)"}},{"k":"time_of_day","v":{"s":"Time of Day"}},{"k":"select_time_of_day","v":{"s":"Select time of day"}},{"k":"dawn_5_7am","v":{"s":"Dawn (5-7am)"}},{"k":"midday_12_2pm","v":{"s":"Midday (12-2pm)"}},{"k":"dusk_7_9pm","v":{"s":"Dusk (7-9pm)"}},{"k":"midnight_12_2am","v":{"s":"Midnight (12-2am)"}},{"k":"generate_soundscape_description","v":{"s":"Generate soundscape description"}},{"k":"did_you_know_amazing_sound_facts","v":{"s":"💡 Did You Know? — Amazing Sound Facts"}},{"k":"the_pistol_shrimp_produces_a_sound_of_","v":{"s":"The pistol shrimp produces a sound of 218 decibels by snapping its claw — louder than a gunshot. The snap creates a cavitation bubble that reaches 4,700°C (as hot as the sun's surface) for a fraction of a second."}},{"k":"elephants_communicate_using_infrasonic","v":{"s":"Elephants communicate using infrasonic rumbles as low as 14 Hz, below human hearing. These calls can travel 10+ km through the ground. Other elephants \"hear\" them through vibrations in their feet!"}},{"k":"the_greater_wax_moth_has_the_highest_f","v":{"s":"The Greater Wax Moth has the highest frequency hearing of any animal: up to 300 kHz (humans max out at ~20 kHz). Scientists think this evolved as a defense against bat echolocation."}},{"k":"in_space_no_one_can_hear_you_scream_li","v":{"s":"In space, no one can hear you scream — literally. Sound requires a medium (air, water, solid) to travel through. The vacuum of space is perfectly silent."}},{"k":"the_brown_headed_cowbird_learns_its_sp","v":{"s":"The brown-headed cowbird learns its species-specific song even when raised by a different species. The password? A specific wingbeat pattern that unlocks the song-learning circuit in the brain."}},{"k":"submarine_crews_can_hear_the_biologica","v":{"s":"Submarine crews can hear the \"biological dawn chorus\" — thousands of marine animals singing at sunrise, creating a wall of sound that can interfere with naval sonar. The ocean is incredibly noisy!"}},{"k":"trees_may_communicate_through_sound_st","v":{"s":"Trees may communicate through sound: studies show plant roots produce clicking sounds at 220 Hz, and neighboring roots grow toward these sounds. \"Talking trees\" may be more than a metaphor."}},{"k":"the_loudest_animal_relative_to_body_si","v":{"s":"The loudest animal relative to body size is the water boatman (Micronecta scholtzi), a tiny aquatic insect. It produces 99 dB by rubbing its body parts together — while being only 2mm long!"}},{"k":"the_growing_problem_of_noise_pollution","v":{"s":"The Growing Problem of Noise Pollution"}},{"k":"human_generated_noise_has_doubled_in_m","v":{"s":"Human-generated noise has doubled in many natural areas over the past 50 years. This acoustic pollution has measurable effects on wildlife:"}},{"k":"reduction_in_bird_breeding_success_nea","v":{"s":"Reduction in bird breeding success near roads"}},{"k":"of_us_protected_areas_have_noise_doubl","v":{"s":"Of US protected areas have noise doubling"}},{"k":"of_us_parks_exceed_natural_sound_level","v":{"s":"Of US parks exceed natural sound levels"}},{"k":"stress_hormones_in_birds_near_airports","v":{"s":"Stress hormones in birds near airports"}},{"k":"how_you_can_help","v":{"s":"How you can help: "}},{"k":"support_quiet_zone_designations_in_nat","v":{"s":"Support quiet zone designations in natural areas. Advocate for electric vehicles and quieter construction equipment. Even small actions like turning off leaf blowers and reducing nighttime lighting make a difference for nocturnal animals like bats."}},{"k":"20_hz_2","v":{"s":"20 Hz"}},{"k":"200_hz","v":{"s":"200 Hz"}},{"k":"2_khz","v":{"s":"2 kHz"}},{"k":"20_khz","v":{"s":"20 kHz"}},{"k":"200_khz_2","v":{"s":"200 kHz"}},{"k":"back_to_stem_lab_menu","v":{"s":"Back to STEAM Lab menu"}},{"k":"echolocation_lab","v":{"s":"Echolocation Lab"}},{"k":"see_the_world_through_sound_bat_sonar_","v":{"s":"See the world through sound — bat sonar vision, sound wave physics, Doppler effect & acoustic ecology"}},{"k":"echolocation_lab_sections","v":{"s":"Echolocation Lab sections"}},{"k":"sonar_vision_hearing_as_imaging","v":{"s":"Sonar Vision — hearing as imaging"}},{"k":"bats_emit_ultrasonic_clicks_20_120_khz","v":{"s":"Bats emit ultrasonic clicks (20–120 kHz, above human hearing) and read echo delay + frequency shift to build a 3D scene at 100+ targets per second. Donald Griffin coined “echolocation” in 1944."}},{"k":"3d_cave_map_by_sound","v":{"s":"3D Cave — map by sound"}},{"k":"each_click_bounces_off_cave_walls_diff","v":{"s":"Each click bounces off cave walls; differential delay between ear canals plus interaural intensity differences locate a surface to ~1 cm. The bat’s brain solves this geometry in real time on a peanut-sized chip."}},{"k":"sound_waves_wavelength_meets_target_si","v":{"s":"Sound Waves — wavelength meets target size"}},{"k":"c_f_at_60_khz_in_air_5_7_mm_fine_enoug","v":{"s":"λ = c / f. At 60 kHz in air, λ ≈ 5.7 mm — fine enough to resolve a moth’s wing. Lower frequencies travel further but resolve coarser; higher = sharper but absorbed quickly. Trade-off baked in."}},{"k":"doppler_effect_the_moving_prey_signatu","v":{"s":"Doppler Effect — the moving-prey signature"}},{"k":"moths_fluttering_toward_the_bat_compre","v":{"s":"Moths fluttering toward the bat compress echo frequency; moving away stretches it. Horseshoe bats compensate by lowering their call to KEEP echoes in their auditory sweet spot — a biological phase-locked loop."}},{"k":"bat_biology_the_auditory_specialist","v":{"s":"Bat Biology — the auditory specialist"}},{"k":"larynx_fires_clicks_outer_ear_pinnae_s","v":{"s":"Larynx fires clicks; outer ear pinnae shape reception; massive auditory cortex parses returns. Bats hear over 8 octaves where humans manage ~10. Tongue-clicking humans (Daniel Kish) use the same trick crudely."}},{"k":"acoustic_ecology_a_soundscape_we_can_t","v":{"s":"Acoustic Ecology — a soundscape we can’t hear"}},{"k":"tropical_rainforests_are_loud_in_the_u","v":{"s":"Tropical rainforests are loud in the ultrasonic. White-nose syndrome has killed 6+ million North American bats since 2006; insect populations downstream are visibly affected. A frequency band we never knew about."}},{"k":"sweep_discovery_tune_the_chirp","v":{"s":"Sweep Discovery — tune the chirp"}},{"k":"adjust_call_frequency_duration_and_ban","v":{"s":"Adjust call frequency, duration, and bandwidth and watch how detection range trades off against resolution. An open exploration — no score, no single right answer."}},{"k":"cf_constant_frequency","v":{"s":"🎵 CF (constant-frequency)"}},{"k":"long_narrow_band_call_horseshoe_bat_st","v":{"s":"Long narrow-band call. Horseshoe-bat style. Detects fluttering prey."}},{"k":"fm_chirp_sweep","v":{"s":"〽️ FM (chirp/sweep)"}},{"k":"short_broadband_sweep_most_microbats_e","v":{"s":"Short broadband sweep. Most microbats. Excellent range/distance."}},{"k":"mixed_cf_fm","v":{"s":"🎶 Mixed CF-FM"}},{"k":"long_tailed_bat_style_long_cf_terminal","v":{"s":"Long-tailed bat style. Long CF + terminal FM chirp."}},{"k":"narrow_short_tone","v":{"s":"🔉 Narrow short tone"}},{"k":"limited_band_less_useful_for_echolocat","v":{"s":"Limited band. Less useful for echolocation."}},{"k":"sonar_sweep_discovery","v":{"s":"🎵 Sonar sweep discovery"}},{"k":"adjust_min_max_frequency_and_sweep_dur","v":{"s":"Adjust min/max frequency and sweep duration. Widget classifies call type into 4 discrete categories used by real bats. No score, no reveal."}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_when_does_the_call_become_f","v":{"s":"Hypothesis: When does the call become FM vs CF?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"bats_use_cf_for_cluttered_environments","v":{"s":"Bats use CF for cluttered environments, FM for open. Investigate why."}},{"k":"find_two_settings_producing_the_same_c","v":{"s":"Find two settings producing the same category."}},{"k":"i_understand_explain_in_own_words","v":{"s":"I understand — explain in own words"}},{"k":"explain_why_call_shape_bandwidth_durat","v":{"s":"Explain why call shape (bandwidth + duration) determines suitability for different prey."}},{"k":"design_note_discrete_4_category_sonar_","v":{"s":"Design note: discrete 4-category sonar marker; no detection-rate score; no reveal — by design."}},{"k":"insectivore_subtitle","v":{"s":"Insect Hunter"}},{"k":"insectivore_desc","v":{"s":"A tiny insectivorous bat that uses rapid-fire echolocation to hunt moths and mosquitoes in the dark. Your sonar is powerful and precise."}},{"k":"frugivore_subtitle","v":{"s":"Fruit Forager"}},{"k":"frugivore_desc","v":{"s":"A larger fruit bat that uses tongue-click echolocation and excellent night vision. Your sonar is weaker but you can see ripe fruit glowing faintly."}},{"k":"cricket_desc","v":{"s":"Male crickets chirp by rubbing their wings together (stridulation). Count chirps in 14 seconds and add 40 to estimate temperature in °F!"}},{"k":"frog_desc","v":{"s":"Male frogs call to attract mates. Each species has a unique call frequency so females find the right species even in a noisy chorus."}},{"k":"owl_desc","v":{"s":"Owls hoot at low frequencies that travel far through forests. Their asymmetric ears let them pinpoint prey by sound alone in total darkness."}},{"k":"bat_desc","v":{"s":"Bat calls are ultrasonic — above human hearing. Shown here scaled down. In reality you would hear nothing!"}},{"k":"whale_desc","v":{"s":"Whale songs can travel thousands of miles underwater. At 188 decibels, blue whale calls are the loudest sound made by any animal."}},{"k":"dolphin_desc","v":{"s":"Dolphins evolved echolocation independently from bats — convergent evolution! They use clicks focused through the melon (forehead) and receive echoes through their jaw."}},{"k":"listening","v":{"s":"listening"}},{"k":"collect_fruit_route","v":{"s":"Collect fruit route"}},{"k":"track_prey_route","v":{"s":"Track prey route"}},{"k":"goal_complete_try_a_harder_scene","v":{"s":"Goal complete. Try a harder scene or map the cave."}},{"k":"perch_to_refill_energy_then_pulse_again","v":{"s":"Perch to refill energy, then pulse again."}},{"k":"send_a_pulse_then_chase_the_bright_echoes","v":{"s":"Send a pulse, then chase the bright echoes."}},{"k":"follow_the_last_echo_while_the_pulse_recharges","v":{"s":"Follow the last echo while the pulse recharges."}},{"k":"sonar_run_focus","v":{"s":"Sonar run focus"}},{"k":"pulse_ready","v":{"s":"Pulse ready"}},{"k":"pulse_recharging","v":{"s":"Pulse recharging"}},{"k":"current_run_progress","v":{"s":"Current run progress"}},{"k":"energy_3","v":{"s":"Energy"}},{"k":"rest_on_a_surface","v":{"s":"Rest on a surface"}},{"k":"enough_for_flight","v":{"s":"Enough for flight"}},{"k":"fruit","v":{"s":"Fruit"}},{"k":"prey","v":{"s":"Prey"}},{"k":"route_complete","v":{"s":"Route complete"}},{"k":"goal_target","v":{"s":"Goal target"}},{"k":"nearest_echo","v":{"s":"Nearest echo"}},{"k":"listen_then_commit","v":{"s":"Listen, then commit"}},{"k":"emit_sonar_pulse_now","v":{"s":"Emit sonar pulse"}},{"k":"wait_for_pulse_recharge","v":{"s":"Wait for pulse recharge"}},{"k":"live_sonar_field","v":{"s":"Live sonar field"}},{"k":"cave_3d_visualization","v":{"s":"3D echolocation cave visualization. Use the camera controls and sonar pulse button to explore."}},{"k":"hypothesis_input","v":{"s":"Sonar call-type hypothesis"}},{"k":"explanation_input","v":{"s":"Sonar call-type explanation"}},{"k":"retry_loading_3d_engine","v":{"s":"Retry loading 3D engine"}},{"k":"three_js_failed_to_load","v":{"s":"The 3D engine could not be loaded."}}],"id":516}},{"k":"echotrainer","v":{"o":[{"k":"back_to_stem_lab","v":{"s":"Back to STEAM Lab"}},{"k":"stem_lab","v":{"s":" STEAM Lab"}},{"k":"echo_navigator","v":{"s":"🎧 Echo Navigator"}},{"k":"navigate_by_sound_alone","v":{"s":"Navigate by sound alone"}},{"k":"important_safety_notice","v":{"s":"Important Safety Notice"}},{"k":"this_simulation_is_an_educational_tool","v":{"s":"This simulation is an educational tool for learning about echolocation and spatial audio. It does NOT replace training with a qualified Orientation & Mobility (O&M) specialist. "}},{"k":"do_not_attempt_to_navigate_real_world_","v":{"s":"Do not attempt to navigate real-world environments using echolocation skills developed in this simulation. Virtual environments are simplified and do not include the complexity, hazards, or unpredictability of real spaces. Success here does not indicate readiness for real-world navigation."}},{"k":"research_thaler_et_al_2011_2021_demons","v":{"s":"Research: Thaler et al. (2011, 2021) demonstrated that both blind and sighted individuals can develop echolocation skills through training. This tool is inspired by the work of Daniel Kish and World Access for the Blind."}},{"k":"acknowledge_safety_disclaimer","v":{"s":"Acknowledge safety disclaimer"}},{"k":"i_understand","v":{"s":"I Understand"}},{"k":"who_is_this_for_research_background","v":{"s":"🧠 Who Is This For? (Research Background)"}},{"k":"students_with_visual_impairments","v":{"s":"Students with visual impairments: "}},{"k":"practice_spatial_awareness_and_echo_in","v":{"s":"Practice spatial awareness and echo interpretation in a safe, controlled environment before real-world training with an O&M instructor."}},{"k":"all_students","v":{"s":"All students: "}},{"k":"research_shows_sighted_people_can_lear","v":{"s":"Research shows sighted people CAN learn echolocation (Thaler et al., 2021 — Durham University). Participants improved significantly over 10 weeks. Children learn faster than adults, making K-12 the ideal time."}},{"k":"accessibility_awareness","v":{"s":"Accessibility awareness: "}},{"k":"experience_what_it_s_like_to_navigate_","v":{"s":"Experience what it’s like to navigate without sight. Builds empathy and understanding of sensory diversity."}},{"k":"stem_learning","v":{"s":"STEM learning: "}},{"k":"teaches_acoustics_speed_of_sound_refle","v":{"s":"Teaches acoustics (speed of sound, reflection coefficients, material absorption), spatial reasoning, and the physics of echolocation used by bats and dolphins."}},{"k":"daniel_kish_who_is_blind_navigates_by_","v":{"s":"🐝 Daniel Kish, who is blind, navigates by bicycle using tongue clicks. He has taught echolocation to thousands of people worldwide through World Access for the Blind."}},{"k":"how_echolocation_works","v":{"s":"📚 How Echolocation Works"}},{"k":"diagram_showing_how_echolocation_works","v":{"s":"Diagram showing how echolocation works: a click travels to a wall, bounces back, and the time delay tells you the distance"}},{"k":"wall","v":{"s":"Wall"}},{"k":"click","v":{"s":"Click →"}},{"k":"echo","v":{"s":"← Echo"}},{"k":"delay_distance_2_343_m_s","v":{"s":"Delay = Distance × 2 ÷ 343 m/s"}},{"k":"click_2","v":{"s":"Click"}},{"k":"press_space_to_emit_a_tongue_click_sou","v":{"s":"Press Space to emit a tongue click sound"}},{"k":"listen","v":{"s":"Listen"}},{"k":"echoes_return_from_different_direction","v":{"s":"Echoes return from different directions via headphones"}},{"k":"navigate","v":{"s":"Navigate"}},{"k":"build_a_mental_map_from_echo_timing_di","v":{"s":"Build a mental map from echo timing + direction"}},{"k":"why_headphones_are_essential","v":{"s":"🎧 Why Headphones Are Essential"}},{"k":"this_tool_uses_hrtf_head_related_trans","v":{"s":"This tool uses HRTF (Head-Related Transfer Function) — the same technique your brain uses to locate sounds in 3D space. Each echo is processed through a virtual model of how sound reaches your left and right ears differently based on direction."}},{"k":"a_wall_to_your_left_will_return_an_ech","v":{"s":"A wall to your LEFT will return an echo that arrives at your left ear a fraction of a millisecond sooner and slightly louder. Your brain detects this automatically — if you're wearing headphones. Speakers cannot reproduce this effect."}},{"k":"in_3d_mode_you_also_perceive_height_di","v":{"s":"In 3D mode, you also perceive HEIGHT differences. A bat flying overhead sounds different from a car at ground level. The 3D scene positions every echo and every moving entity's sound in true 3D space around your head."}},{"k":"rock","v":{"s":"Rock"}},{"k":"bright_echo","v":{"s":"Bright echo"}},{"k":"metal","v":{"s":"Metal"}},{"k":"sharp_ring","v":{"s":"Sharp ring"}},{"k":"wood","v":{"s":"Wood"}},{"k":"muffled","v":{"s":"Muffled"}},{"k":"glass","v":{"s":"Glass"}},{"k":"faint","v":{"s":"Faint"}},{"k":"goal","v":{"s":"Goal ⭐"}},{"k":"click_space","v":{"s":"🔊 Click (Space)"}},{"k":"start_a_distance_estimation_challenge","v":{"s":"Start a distance estimation challenge"}},{"k":"distance_quiz","v":{"s":"📏 Distance Quiz"}},{"k":"start_a_material_identification_quiz","v":{"s":"Start a material identification quiz"}},{"k":"material_quiz","v":{"s":"🧊 Material Quiz"}},{"k":"generate_new_random_layout","v":{"s":"Generate new random layout"}},{"k":"new_layout","v":{"s":"🎲 New Layout"}},{"k":"total_runs","v":{"s":"Total Runs"}},{"k":"total_xp","v":{"s":"Total XP"}},{"k":"best_time","v":{"s":"Best Time"}},{"k":"fewest_bumps","v":{"s":"Fewest Bumps"}},{"k":"complete_a_run_to_see_your_stats_here","v":{"s":"Complete a run to see your stats here."}},{"k":"mode","v":{"s":"Mode"}},{"k":"time","v":{"s":"Time"}},{"k":"clicks","v":{"s":"Clicks"}},{"k":"bumps","v":{"s":"Bumps"}},{"k":"distance_estimation_challenge","v":{"s":"Distance estimation challenge"}},{"k":"distance_challenge","v":{"s":"📏 Distance Challenge"}},{"k":"dismiss","v":{"s":"Dismiss"}},{"k":"material_identification_quiz","v":{"s":"Material identification quiz"}},{"k":"material_quiz_2","v":{"s":"🧊 Material Quiz"}},{"k":"listen_to_the_echo_ahead_what_material","v":{"s":"Listen to the echo ahead. What material did you just hear?"}},{"k":"dismiss_2","v":{"s":"Dismiss"}},{"k":"echo_navigator_3d_mode_unresolved","v":{"s":"⚠️ Echo Navigator 3D Mode Unresolved"}},{"k":"webgl_failed_to_initialize_your_device","v":{"s":"WebGL failed to initialize. Your device or browser may not support 3D hardware acceleration. The tool has automatically fallen back to 2D Audio/Tactile mode, but you can retry 3D Mode below."}},{"k":"retry_3d_mode","v":{"s":"Retry 3D Mode"}},{"k":"echo_navigation_3d_viewport_click_to_l","v":{"s":"Echo navigation 3D viewport. Click to lock mouse, then click to emit sonar. WASD to move, mouse to look, Q/E to strafe. Shift to sprint, C to crouch."}},{"k":"click_to_lock_mouse_click_again_to_son","v":{"s":"🖱 Click to lock mouse, click again to sonar"}},{"k":"space_click","v":{"s":"Space: Click"}},{"k":"headphones_required","v":{"s":"🎧 Headphones required"}},{"k":"find_the_goal_using_echoes","v":{"s":"⭐ Find the goal using echoes"}},{"k":"shift_sprint_c_crouch","v":{"s":"Shift: Sprint | C: Crouch"}},{"k":"how_materials_sound","v":{"s":"📖 How Materials Sound"}},{"k":"bright_echo_reflects_90_of_sound_energ","v":{"s":"Bright echo (reflects ~90% of sound energy)"}},{"k":"sharp_ringing_echo_reflects_95_highest","v":{"s":"Sharp, ringing echo (reflects ~95% — highest reflectivity)"}},{"k":"muffled_echo_absorbs_high_frequencies_","v":{"s":"Muffled echo (absorbs high frequencies, reflects ~50%)"}},{"k":"faint_high_pitched_echo_mostly_transpa","v":{"s":"Faint, high-pitched echo (mostly transparent to sound)"}},{"k":"nearly_silent_absorbs_most_sound_hard_","v":{"s":"Nearly silent (absorbs most sound — hard to detect)"}},{"k":"locker_shopping_cart_metal","v":{"s":"Locker/Shopping Cart (Metal):"}},{"k":"sharp_ring_highest_reflectivity_easy_t","v":{"s":"Sharp ring, highest reflectivity — easy to locate"}},{"k":"trophy_case_freezer_glass","v":{"s":"Trophy Case/Freezer (Glass):"}},{"k":"faint_echo_deceptively_quiet_easy_to_w","v":{"s":"Faint echo — deceptively quiet, easy to walk into"}},{"k":"soft_echo_faint_glow_triangle_wave_ton","v":{"s":"Soft echo, faint glow, triangle-wave tone at 200Hz"}},{"k":"strong_echo_sawtooth_engine_rumble_at_","v":{"s":"Strong echo, sawtooth engine rumble at 55Hz — AVOID!"}},{"k":"faint_ultrasonic_chirp_at_3200hz_tiny_","v":{"s":"Faint, ultrasonic chirp at 3200Hz — tiny targets"}},{"k":"low_80hz_thud_large_slow_moving_body","v":{"s":"Low 80Hz thud — large, slow-moving body"}},{"k":"high_2400_3200hz_chirp_tiny_fast_movin","v":{"s":"High 2400-3200Hz chirp — tiny, fast-moving"}},{"k":"rhythmic_180hz_footsteps_fast_small_ta","v":{"s":"Rhythmic 180Hz footsteps — fast, small target"}},{"k":"low_90hz_wheel_hum_very_fast_watch_out","v":{"s":"Low 90Hz wheel hum — very fast, watch out!"}},{"k":"goal_2","v":{"s":"Goal ⭐:"}},{"k":"distinctive_bright_echo_with_a_unique_","v":{"s":"Distinctive bright echo with a unique tonal quality"}},{"k":"real_bats_use_frequencies_of_20_200_kh","v":{"s":"🦇 Real bats use frequencies of 20-200 kHz (ultrasonic). Humans echolocate best with tongue clicks at 2-4 kHz. The key cue is the time delay between click and echo — at 343 m/s, a wall 1.7m away returns an echo in 10ms."}},{"k":"ghost_outlines_after_sonar_pulses_hit_","v":{"s":"👻 Ghost outlines: After sonar pulses hit surfaces, a faint persistent glow remains to help you build a mental map. Higher difficulties reduce or eliminate ghost outlines."}},{"k":"this_is_an_educational_simulation_do_n","v":{"s":"⚠️ This is an educational simulation. Do not rely on simulation experience for real-world navigation. Consult a qualified O&M specialist for echolocation training."}},{"k":"too_fast_no_echo_detect","v":{"s":"⚡ Too fast (no echo detect)"}},{"k":"surface_too_close_brain_merges_echo_wi","v":{"s":"Surface too close. Brain merges echo with click."}},{"k":"crisp_echo","v":{"s":"🟢 Crisp echo"}},{"k":"optimal_range_brain_can_localize_surfa","v":{"s":"Optimal range. Brain can localize surface."}},{"k":"distinct_delay","v":{"s":"🟡 Distinct delay"}},{"k":"surface_noticeable_but_distant","v":{"s":"Surface noticeable but distant."}},{"k":"reverberant","v":{"s":"🔊 Reverberant"}},{"k":"far_surface_multiple_bounces","v":{"s":"Far surface, multiple bounces."}},{"k":"echo_timing_discovery","v":{"s":"🎵 Echo timing discovery"}},{"k":"sliders_for_distance_speed_surface_dis","v":{"s":"Sliders for distance, speed, surface. Discrete 4-state echo. No score, no reveal."}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_at_what_distance_does_echo_","v":{"s":"Hypothesis: At what distance does echo become detectable?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"sound_in_air_343_m_s_investigate_the_f","v":{"s":"Sound in air = 343 m/s. Investigate the formula."}},{"k":"why_do_bats_use_high_frequency_clicks","v":{"s":"Why do bats use high-frequency clicks?"}},{"k":"i_understand_explain_in_own_words","v":{"s":"I understand — explain in own words"}},{"k":"explain_echo_physics","v":{"s":"Explain echo physics."}},{"k":"design_note_discrete_4_state_echo_mark","v":{"s":"Design note: discrete 4-state echo marker; no detection score; no reveal — by design."}},{"k":"echo_vision","v":{"s":"Echo Vision"}},{"k":"audio_only","v":{"s":"Audio Only"}},{"k":"reveal_mode","v":{"s":"Reveal Mode"}},{"k":"goals_found","v":{"s":"Goals Found"}},{"k":"audio_wins","v":{"s":"Audio Wins"}},{"k":"mapped","v":{"s":"Mapped"}},{"k":"best_run","v":{"s":"Best Run"}},{"k":"none_yet","v":{"s":"New"}},{"k":"sonar_briefing","v":{"s":"Sonar Briefing"}},{"k":"sonar_briefing_title","v":{"s":"Build a map from echoes"}},{"k":"sonar_briefing_copy","v":{"s":"Emit a click, listen for timing and direction, then move slowly toward the goal while the map appears one pulse at a time."}},{"k":"emit_sonar","v":{"s":"Emit Sonar"}},{"k":"goal_echo","v":{"s":"Goal echo"}},{"k":"hypothesis_input","v":{"s":"Echo distance hypothesis"}},{"k":"explanation_input","v":{"s":"Echo physics explanation"}},{"k":"aria_map_visible","v"