":"padding: 8px 12px; border-radius: 8px; background: rgb(15, 23, 42); border: 1px solid rgb(51, 65, 85); color: rgb(203, 213, 225); font-size: 12px; font-weight: 700; cursor: pointer; text-align: left;"},["DIV",{},"Pratt"],["DIV",{"style":"font-size: 10px; opacity: 0.95; font-weight: 500; margin-top: 2px;"},"verticals + inward diagonals (in tension)"]],["BUTTON",{"type":"button","aria-pressed":"false","style":"padding: 8px 12px; border-radius: 8px; background: rgb(15, 23, 42); border: 1px solid rgb(51, 65, 85); color: rgb(203, 213, 225); font-size: 12px; font-weight: 700; cursor: pointer; text-align: left;"},["DIV",{},"Howe"],["DIV",{"style":"font-size: 10px; opacity: 0.95; font-weight: 500; margin-top: 2px;"},"verticals + outward diagonals (in compression)"]],["BUTTON",{"type":"button","aria-pressed":"false","style":"padding: 8px 12px; border-radius: 8px; background: rgb(15, 23, 42); border: 1px solid rgb(51, 65, 85); color: rgb(203, 213, 225); font-size: 12px; font-weight: 700; cursor: pointer; text-align: left;"},["DIV",{},"K-truss"],["DIV",{"style":"font-size: 10px; opacity: 0.95; font-weight: 500; margin-top: 2px;"},"K-shaped pattern, shorter diagonals"]]],["DIV",{"style":"font-size: 11px; color: var(--allo-stem-text-soft, #94a3b8); line-height: 1.6; font-style: italic;"},"Warren trusses (1848, James Warren) use equilateral triangles with no verticals. Alternating diagonals carry shear in alternating tension/compression. Efficient and elegant; common in shorter spans."]]],["SECTION",{"style":"padding: 14px; border-radius: 12px; background: var(--allo-stem-panel, #1e293b); border-top: 1px solid var(--allo-stem-border, #334155); border-right: 1px solid var(--allo-stem-border, #334155); border-bottom: 1px solid var(--allo-stem-border, #334155); border-left: 3px solid rgb(245, 158, 11); margin-bottom: 12px;"},["H3",{"style":"margin-top: 0px; font-size: 14px; font-weight: 800; color: var(--allo-stem-text, #e2e8f0); margin-bottom: 8px;"},"Material"],["DIV",{"style":