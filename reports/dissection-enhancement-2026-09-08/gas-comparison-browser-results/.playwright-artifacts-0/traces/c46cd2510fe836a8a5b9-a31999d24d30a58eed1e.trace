swatch[data-style=\"saved\"] { border-top-style: dashed; border-top-color: rgb(236, 72, 153); }\n.diss-attempt-comparison__swatch[data-style=\"caution\"] { width: 0.7rem; height: 0.7rem; border: 2px solid rgb(245, 158, 11); border-radius: 50%; transform: rotate(45deg); }\n.diss-attempt-comparison__scrub { display: grid; grid-template-columns: auto minmax(0px, 1fr) auto auto auto; align-items: center; gap: 0.35rem 0.5rem; margin-top: 0.55rem; padding-top: 0.45rem; border-top: 1px solid rgb(221, 214, 254); color: rgb(76, 29, 149); }\n.diss-attempt-comparison__scrub label { font-size: 0.62rem; font-weight: 900; white-space: nowrap; }\n.diss-attempt-comparison__scrub input[type=\"range\"] { width: 100%; min-width: 8rem; accent-color: rgb(124, 58, 237); cursor: pointer; }\n.diss-attempt-comparison__scrub output { min-width: 4.2rem; color: rgb(76, 29, 149); font-size: 0.62rem; font-variant-numeric: tabular-nums; font-weight: 900; text-align: right; }\n.diss-attempt-comparison__scrub button { min-height: 2.2rem; margin: 0px; padding: 0.3rem 0.5rem; border: 1px solid rgb(139, 92, 246); border-radius: 0.45rem; background: rgb(255, 255, 255); color: rgb(91, 33, 182); font-size: 0.62rem; font-weight: 900; cursor: pointer; }\n.diss-attempt-comparison__scrub button:hover { background: rgb(245, 243, 255); }\n@media (max-width: 620px) {\n  .diss-attempt-comparison__scrub { grid-template-columns: minmax(0px, 1fr) auto; }\n  .diss-attempt-comparison__scrub label { grid-column: 1 / -1; }\n  .diss-attempt-comparison__scrub input[type=\"range\"] { min-width: 0px; }\n}\n.diss-debrief { margin-top: 0.55rem; padding: 0.6rem; border: 1px solid rgb(147, 197, 253); border-radius: 0.65rem; background: rgb(239, 246, 255); color: rgb(36, 72, 110); font-size: 0.69rem; line-height: 1.45; }\n.diss-debrief strong { color: rgb(18, 59, 103); }\n.diss-instructor { margin-top: 0.55rem; border-top: 1px solid rgb(185, 216, 210); padding-top: 0.45rem; }\n.diss-instructor summary { cursor: pointer; color: 