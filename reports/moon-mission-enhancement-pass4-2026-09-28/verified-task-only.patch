+      const felt = Math.hypot(row.thrust * Math.cos(row.pitch) + dragR, row.thrust * Math.sin(row.pitch) + dragT) / (row.mass * C.g0);
+      expect(row.loadG).toBeCloseTo(felt, 8);
+      if (i) {
