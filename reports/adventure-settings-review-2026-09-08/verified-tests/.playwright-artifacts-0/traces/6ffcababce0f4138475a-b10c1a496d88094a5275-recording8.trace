leStartAdventure: () => {},\n        safeSetItem: () => {}\n      };\n      for (const key of Object.keys(settings)) props['set' + key[0].toUpperCase() + key.slice(1)] = value => setSettings(previous => ({\n        ...previous,\n        [key]: value\n      }));\n      w.__setup = {\n        ...settings,\n        state\n      };\n      return R.createElement(surface === 'sidebar' ? w.AlloModules.AdventurePanel : w.AlloModules.AdventureSetupFields, props);\n    }\n    w.ReactDOM.createRoot(document.querySelector('#root')).render(R.createElement(Fixture));\n  }","isFunction":true,"arg":{"value":{"o":[{"k":"surface","v":{"s":"sidebar"}},{"k":"teacher","v":{"b":false}},{"k":"permissions","v":{"o":[{"k":"allowLanguageSwitch","v":{"b":true}},{"k":"allowModeSwitch","v":{"b":false}},{"k":"allowDifficultySwitch","v":{"b":false}},{"k":"allowCustomInstructions","v":{"b":false}},{"k":"allowVisualsToggle","v":{"b":false}},{"k":"allowCloudImageStorage","v":{"b":true}}],"id":2}},{"k":"mode","v":{"s":"choice"}},{"k":"theme","v":{"s":"light"}}],"id":1},"handles":[]}},"stepId":"pw:api@32","pageId":"page@0c5f3025a1f2b9725626e2abf31f3a35","beforeSnapshot":"before@call@456"}
