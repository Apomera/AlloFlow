    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/1096.png",
      "text": "እዛ ኻብ ጭቃ ዝተሰርሐት ጓል ህይወት ዘርአት። እታ ሰበይቲ ነዛ ጓል ኣካቶፐ ኽትብል ሰየመታ።",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51337#page=3",
      "sourceDigest": "sha256:dcf5605d00d32ca74d8609ce2d08bf04185bf4de739df5ce12fd93f9f28b627b"
    },
    {
