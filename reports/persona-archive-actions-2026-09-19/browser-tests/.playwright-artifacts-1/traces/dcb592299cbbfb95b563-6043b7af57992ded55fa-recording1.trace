,"v":{"s":"No climate journeys have been pinned yet."}},{"k":"pilot_notebook_report_comparison_row","v":{"s":"**{scenario}:** {form} at {altitude} m; {stages} of {total} stages; optics {optics} of 4; model cloud base {cloud} m at {rh}% starting humidity; freezing {freezing}."}},{"k":"pilot_notebook_report_rainbow","v":{"s":"Double-rainbow evidence"}},{"k":"pilot_notebook_report_rainbow_primary","v":{"s":"Primary bow observed: {value}"}},{"k":"pilot_notebook_report_rainbow_secondary","v":{"s":"Secondary bow created: {value}"}},{"k":"pilot_notebook_report_rainbow_alignment","v":{"s":"Best antisolar alignment: {value}%"}},{"k":"pilot_notebook_report_rainbow_sun","v":{"s":"Sun altitude at best alignment: {value}°"}},{"k":"pilot_notebook_report_rainbow_science","v":{"s":"Science note: the primary bow is near 42° after one internal reflection; the fainter secondary is near 51° after two reflections, with reversed colors and a darker band between."}},{"k":"pilot_notebook_yes","v":{"s":"Yes"}},{"k":"pilot_notebook_not_yet","v":{"s":"Not yet"}},{"k":"pilot_notebook_report_reflection","v":{"s":"Learner reflection"}},{"k":"pilot_notebook_reflection_empty","v":{"s":"No reflection has been added yet."}},{"k":"pilot_notebook_report_model_note","v":{"s":"Model boundary"}},{"k":"pilot_notebook_report_model_copy","v":{"s":"This is a qualitative teaching simulation. Residence times are compressed, and pathway shares are not measured water volumes."}},{"k":"pilot_follow_flow","v":{"s":"Follow flow"}},{"k":"pilot_follow_flow_aria","v":{"s":"Follow the highlighted water pathway faster. Also F."}},{"k":"pilot_follow_view","v":{"s":"Follow view"}},{"k":"pilot_follow_view_selected","v":{"s":"Follow view selected. The camera now shows the parcel and each change of form."}},{"k":"pilot_gravity_pores","v":{"s":"Gravity + pores"}},{"k":"pilot_gravity_slope","v":{"s":"Gravity + slope"}},{"k":"pilot_gravity_steer_pathway","v":{"s":"Gravity is pulling you down — steer toward a pathway"}},{"k":"pilot_groundwater_driver","v":{"s":"A hydraulic gradient moves pore water slowly."}},{"k":"pilot_help_short","v":{"s":"Help"}},{"k":"pilot_hours_years","v":{"s":"Hours–years"}},{"k":"pilot_hydraulic_gradient","v":{"s":"Hydraulic gradient"}},{"k":"pilot_landing_choice","v":{"s":"Landing pathway"}},{"k":"pilot_landing_pathway_aria","v":{"s":"Current landing target: {surface}. {outcome}"}},{"k":"pilot_launch_intro","v":{"s":"Explore freely, but follow real science: heat, humidity, altitude, particles, gravity, and the surface below you determine what happens next."}},{"k":"pilot_launch_look","v":{"s":"Drag the world to look around. Scroll or pinch to zoom in Follow view."}},{"k":"pilot_launch_move","v":{"s":"Use Rise, Sink, arrows, Forward, and Back - or the matching keyboard controls."}},{"k":"pilot_launch_notice","v":{"s":"Watch Next goal, the phase badge, and the meters explain every transformation."}},{"k":"pilot_launch_science","v":{"s":"Your goal is not to win quickly. Compare pathways, notice cause and effect, and complete all six water-cycle stages across repeated journeys."}},{"k":"pilot_launch_step_1","v":{"s":"1 - Look"}},{"k":"pilot_launch_step_2","v":{"s":"2 - Move"}},{"k":"pilot_launch_step_3","v":{"s":"3 - Notice"}},{"k":"pilot_minutes_hours","v":{"s":"Minutes–hours"}},{"k":"pilot_natural_time","v":{"s":"Natural time"}},{"k":"pilot_open_flight_guide","v":{"s":"Open the flight guide"}},{"k":"pilot_over_surface","v":{"s":"Over {surface}"}},{"k":"pilot_percolate_faster","v":{"s":"Percolate faster"}},{"k":"pilot_percolate_faster_aria","v":{"s":"Move downward through soil pores faster. Also Shift or S."}},{"k":"pilot_percolation","v":{"s":"Percolation"}},{"k":"pilot_plant_cutaway","v":{"s":"Plant pathway"}},{"k":"pilot_plant_driver","v":{"s":"Transpiration pull lifts a continuous water column."}},{"k":"pilot_receipt_air_evidence","v":{"s":"{temp}°C · {alt} m"}},{"k":"pilot_receipt_cloud_formation","v":{"s":"Cloud formation"}},{"k":"pilot_receipt_cloud_formation_cause","v":{"s":"Enough suspended droplets gathered to cross this model's teaching-scale visibility threshold and become a cloud."}},{"k":"pilot_receipt_coalescence","v":{"s":"Collision-coalescence"}},{"k":"pilot_receipt_coalescence_cause","v":{"s":"Collisions raised the droplet's teaching-scale mass until gravity overcame the supporting air and it began to fall as rain."}},{"k":"pilot_receipt_collection","v":{"s":"Collection"}},{"k":"pilot_receipt_collection_cause","v":{"s":"Gravity returned the rain to open water, where it joined a stream, lake, or the ocean and began another surface-water pathway."}},{"k":"pilot_receipt_condensation","v":{"s":"Condensation"}},{"k":"pilot_receipt_condensation_cause","v":{"s":"At the cloud base the parcel reached saturation, and a condensation nucleus gave water molecules a surface on which to gather."}},{"k":"pilot_receipt_deposition","v":{"s":"Deposition"}},{"k":"pilot_receipt_deposition_cause","v":{"s":"Saturated water vapour met a nucleus in subfreezing air and formed ice directly instead of first becoming liquid."}},{"k":"pilot_receipt_droplet_evidence","v":{"s":"{n} droplets gathered"}},{"k":"pilot_receipt_energy_evidence","v":{"s":"Energy threshold · {pct}%"}},{"k":"pilot_receipt_evaporation","v":{"s":"Evaporation"}},{"k":"pilot_receipt_evaporation_cause","v":{"s":"Solar energy reached the evaporation threshold, allowing surface water molecules to escape into the air as invisible water vapour."}},{"k":"pilot_receipt_freezing","v":{"s":"Freezing"}},{"k":"pilot_receipt_freezing_cause","v":{"s":"The liquid droplet crossed into subfreezing air, so its water changed from liquid to solid ice."}},{"k":"pilot_receipt_freezing_precipitation","v":{"s":"Freezing precipitation"}},{"k":"pilot_receipt_freezing_precipitation_cause","v":{"s":"The falling water entered subfreezing air and changed from liquid rain to solid snow."}},{"k":"pilot_receipt_groundwater_discharge","v":{"s":"Groundwater discharge"}},{"k":"pilot_receipt_groundwater_discharge_cause","v":{"s":"The slow pore-water pathway intersected the surface at a spring or stream and returned the water to open flow."}},{"k":"pilot_receipt_ice_growth","v":{"s":"Ice-crystal growth"}},{"k":"pilot_receipt_ice_growth_cause","v":{"s":"The ice crystal gathered enough mass in subfreezing air for gravity to overcome the updraft."}},{"k":"pilot_receipt_infiltration","v":{"s":"Infiltration"}},{"k":"pilot_receipt_infiltration_cause","v":{"s":"Permeable ground had connected pore spaces, so the rain soaked below the surface instead of running off."}},{"k":"pilot_receipt_mass_evidence","v":{"s":"Mass {mass} · threshold {threshold}"}},{"k":"pilot_receipt_melting","v":{"s":"Melting"}},{"k":"pilot_receipt_melting_ice_cause","v":{"s":"The ice fell below the freezing level into warmer air and changed back to a liquid droplet."}},{"k":"pilot_receipt_melting_snow","v":{"s":"Melting"}},{"k":"pilot_receipt_melting_snow_cause","v":{"s":"The snow crossed below the freezing level, where warmer air melted it into rain before it reached the surface."}},{"k":"pilot_receipt_pathway_change","v":{"s":"Water pathway change"}},{"k":"pilot_receipt_pathway_change_cause","v":{"s":"The model's measured thresholds changed your form or pathway under the conditions you encountered."}},{"k":"pilot_receipt_percolation","v":{"s":"Percolation"}},{"k":"pilot_receipt_percolation_cause","v":{"s":"Water moved downward through connected soil and rock pores until it reached the saturated zone below the water table."}},{"k":"pilot_receipt_plant_uptake","v":{"s":"Plant uptake"}},{"k":"pilot_receipt_plant_uptake_cause","v":{"s":"Vegetation intercepted the rain and routed water into plant storage, where it can later leave through transpiration."}},{"k":"pilot_receipt_rain_formation","v":{"s":"Rain formation"}},{"k":"pilot_receipt_rain_formation_cause","v":{"s":"Cloud droplets collided and merged until their teaching-scale mass made gravity stronger than the updraft."}},{"k":"pilot_receipt_reevaporation","v":{"s":"Re-evaporation"}},{"k":"pilot_receipt_reevaporation_cause","v":{"s":"The droplet sank below cloud base into unsaturated air, so it evaporated back into invisible water vapour."}},{"k":"pilot_receipt_residence_evidence","v":{"s":"Path complete · residence time compressed"}},{"k":"pilot_receipt_runoff","v":{"s":"Runoff"}},{"k":"pilot_receipt_runoff_cause","v":{"s":"Hard ground could not absorb the rain fast enough, so gravity moved it downslope toward streams and larger water bodies."}},{"k":"pilot_receipt_saturation_evidence","v":{"s":"{rh}% RH · nucleus captured"}},{"k":"pilot_receipt_snow_collection","v":{"s":"Collection"}},{"k":"pilot_receipt_snow_collection_cause","v":{"s":"The precipitation reached open water and entered surface storage, ready to move through the cycle again."}},{"k":"pilot_receipt_snow_formation","v":{"s":"Snow formation"}},{"k":"pilot_receipt_snow_formation_cause","v":{"s":"Ice crystals grew in subfreezing cloud air until gravity overcame the updraft and they began to fall as snow."}},{"k":"pilot_receipt_snow_infiltration","v":{"s":"Infiltration"}},{"k":"pilot_receipt_snow_infiltration_cause","v":{"s":"Water from the landed snow entered connected pores in permeable soil and moved into subsurface storage."}},{"k":"pilot_receipt_snow_plant_uptake","v":{"s":"Plant uptake"}},{"k":"pilot_receipt_snow_plant_uptake_cause","v":{"s":"Vegetation intercepted the precipitation and routed its water into plant storage."}},{"k":"pilot_receipt_snow_runoff","v":{"s":"Runoff"}},{"k":"pilot_receipt_snow_runoff_cause","v":{"s":"The hard surface blocked infiltration, so water from the landed snow was routed downslope as runoff."}},{"k":"pilot_receipt_stream_collection","v":{"s":"Surface-water collection"}},{"k":"pilot_receipt_stream_collection_cause","v":{"s":"Gravity and slope carried the runoff into connected open water, where it joined the stream-to-ocean network."}},{"k":"pilot_receipt_surface_evidence","v":{"s":"{surface} · surface pathway"}},{"k":"pilot_receipt_transpiration","v":{"s":"Transpiration"}},{"k":"pilot_receipt_transpiration_cause","v":{"s":"Water moved through the plant and leaf stomata released it to the air as invisible water vapour."}},{"k":"pilot_receipt_xylem_transport","v":{"s":"Xylem transport"}},{"k":"pilot_receipt_xylem_transport_cause","v":{"s":"Tension from evaporation at the leaves pulled a continuous column of water upward from the roots through xylem tissue."}},{"k":"pilot_residence_time_note","v":{"s":"Pathway in motion: natural residence time is compressed, not skipped."}},{"k":"pilot_ride_xylem","v":{"s":"Ride xylem"}},{"k":"pilot_ride_xylem_aria","v":{"s":"Move upward through xylem faster. Also Space or W."}},{"k":"pilot_root_to_leaf","v":{"s":"Root → xylem → leaf"}},{"k":"pilot_runoff_driver","v":{"s":"Gravity and slope move water downhill."}},{"k":"pilot_runoff_to_stream","v":{"s":"Runoff → stream"}},{"k":"pilot_saturated_rock","v":{"s":"Saturated rock"}},{"k":"pilot_soil_driver","v":{"s":"Gravity moves water through connected pores."}},{"k":"pilot_soil_to_water_table","v":{"s":"Soil → water table"}},{"k":"pilot_storage","v":{"s":"Storage"}},{"k":"pilot_subsurface_cutaway","v":{"s":"Subsurface cutaway"}},{"k":"pilot_surface_flow","v":{"s":"Surface flow"}},{"k":"pilot_surface_hard","v":{"s":"Hard ground"}},{"k":"pilot_surface_hard_outcome","v":{"s":"Runoff - flow downhill toward a stream"}},{"k":"pilot_surface_journey","v":{"s":"Surface journey"}},{"k":"pilot_surface_plant","v":{"s":"Forest canopy"}},{"k":"pilot_surface_plant_outcome","v":{"s":"Plant uptake - travel through roots and xylem"}},{"k":"pilot_surface_soil","v":{"s":"Permeable soil"}},{"k":"pilot_surface_soil_outcome","v":{"s":"Infiltration - enter pores in soil and rock"}},{"k":"pilot_surface_water","v":{"s":"Open water"}},{"k":"pilot_surface_water_outcome","v":{"s":"Collection - join a stream, lake, or the ocean"}},{"k":"pilot_target_forest","v":{"s":"FOREST - PLANT UPTAKE"}},{"k":"pilot_target_hardpan","v":{"s":"HARDPAN - RUNOFF"}},{"k":"pilot_target_lake","v":{"s":"LAKE - COLLECTION"}},{"k":"pilot_target_soil","v":{"s":"SOIL - INFILTRATION"}},{"k":"pilot_target_stream","v":{"s":"STREAM - COLLECTION"}},{"k":"pilot_to_leaf","v":{"s":"To leaf"}},{"k":"pilot_to_spring","v":{"s":"To spring"}},{"k":"pilot_to_stream","v":{"s":"To stream"}},{"k":"pilot_transpiration_pull","v":{"s":"Transpiration pull"}},{"k":"pilot_unsaturated_soil","v":{"s":"Unsaturated soil"}},{"k":"pilot_water_view","v":{"s":"Water view"}},{"k":"pilot_water_view_selected","v":{"s":"Water view selected. You are now looking from the parcel. The form badge still identifies what you are."}},{"k":"pilot_why_you_changed","v":{"s":"Why you changed"}},{"k":"pilot_wind_inland","v":{"s":"Wind {speed} m/s → inland"}},{"k":"pilot_xylem","v":{"s":"Xylem"}},{"k":"pilot_years_millennia","v":{"s":"Years–millennia"}},{"k":"pilot_alt_coastal_landscape","v":{"s":"A forested mountain catchment drains through a visible stream and lake to the ocean."}},{"k":"pilot_alt_desert_landscape","v":{"s":"A dry mountain basin has no standing lake or visible stream; water reaching land can enter soil or move as runoff."}},{"k":"pilot_alt_winter_landscape","v":{"s":"A snow-covered mountain catchment stores water above a connected stream, lake, and ocean."}},{"k":"pilot_alt_molecular_lens","v":{"s":"The molecular lens is schematic and not to scale: every particle remains H2O; {arrangement}."}},{"k":"pilot_molecular_gas","v":{"s":"Gas - far apart, moving freely"}},{"k":"pilot_molecular_gas_alt","v":{"s":"the molecules are far apart and move freely"}},{"k":"pilot_molecular_lens_label","v":{"s":"Molecular lens - schematic H2O"}},{"k":"pilot_molecular_liquid","v":{"s":"Liquid - close together, sliding"}},{"k":"pilot_molecular_liquid_alt","v":{"s":"the molecules stay close together but slide past one another"}},{"k":"pilot_molecular_solid","v":{"s":"Solid - open lattice, vibrating"}},{"k":"pilot_molecular_solid_alt","v":{"s":"the molecules hold an open lattice and vibrate in place"}},{"k":"pilot_energy_into_water","v":{"s":"Energy absorbed by water"}},{"k":"pilot_energy_to_air","v":{"s":"Energy released to surrounding air"}},{"k":"pilot_no_latent_energy","v":{"s":"No phase change - no latent heat transfer in this step"}},{"k":"pilot_days_millennia","v":{"s":"Days–millennia"}},{"k":"pilot_hours_millennia","v":{"s":"Hours–millennia"}},{"k":"pilot_landing_comparison","v":{"s":"Landing pathway comparison"}},{"k":"pilot_pathway_changed","v":{"s":"Your water pathway changed."}},{"k":"pilot_receipt_dry_air_evidence","v":{"s":"Dry-air exposure · {pct}%"}},{"k":"pilot_receipt_virga","v":{"s":"Virga - rain re-evaporation"}},{"k":"pilot_receipt_virga_cause","v":{"s":"The falling raindrop spent enough time in very dry air below cloud base to evaporate completely before reaching the surface."}},{"k":"pilot_routes_tried","v":{"s":"Landing pathways tried"}},{"k":"pilot_transition_announce","v":{"s":"Water changed from {from} to {to}: {process}."}},{"k":"pilot_try_next_route","v":{"s":"Try next: land on {surface}."}},{"k":"pilot_virga_progress","v":{"s":"Unsaturated air is evaporating the drop · {pct}%"}},{"k":"pilot_virga_risk","v":{"s":"Dry-air exposure"}}],"id":595}},{"k":"wave","v":{"o":[{"k":"u26a0_audio_not_supported_in","v":{"s":"⚠ Audio not supported in this browser"}},{"k":"ud83cudfaf_match_the_yellow_dashed","v":{"s":"🎯 Match the yellow dashed wave!"}},{"k":"loading","v":{"s":"Loading Wave Simulator…"}},{"k":"mode_free_label","v":{"s":"Free wave"}},{"k":"mode_free_chip","v":{"s":"Waveform lab"}},{"k":"mode_standing_label","v":{"s":"Standing"}},{"k":"mode_standing_chip","v":{"s":"Nodes + antinodes"}},{"k":"mode_ripple_label","v":{"s":"Ripple tank"}},{"k":"mode_ripple_chip","v":{"s":"Interference field"}},{"k":"mode_reflection_label","v":{"s":"Reflection"}},{"k":"mode_reflection_chip","v":{"s":"Boundary lab"}},{"k":"mode_longitudinal_label","v":{"s":"Longitudinal"}},{"k":"mode_longitudinal_chip","v":{"s":"Compression map"}},{"k":"mode_doppler_label","v":{"s":"Doppler"}},{"k":"mode_doppler_chip","v":{"s":"Motion shift"}},{"k":"mode_spectrum_label","v":{"s":"Spectrum"}},{"k":"mode_spectrum_chip","v":{"s":"Frequency analyzer"}},{"k":"interference_full_constructive","v":{"s":"Full constructive"}},{"k":"interference_partial_constructive","v":{"s":"Partial constructive"}},{"k":"interference_full_destructive","v":{"s":"Full destructive"}},{"k":"interference_partial_destructive","v":{"s":"Partial destructive"}},{"k":"interference_partial","v":{"s":"Partial"}},{"k":"interference_beats","v":{"s":"Beats — pulses at"}},{"k":"interference_complex","v":{"s":"Complex"}},{"k":"timbre_sine","v":{"s":"Pure sine — ONE frequency, no harmonics"}},{"k":"timbre_square","v":{"s":"Square — odd harmonics (1f, 3f, 5f…), ~1/n"}},{"k":"timbre_triangle","v":{"s":"Triangle — odd harmonics fading fast (~1/n²)"}},{"k":"timbre_sawtooth","v":{"s":"Sawtooth — ALL harmonics (1f, 2f, 3f…), ~1/n"}},{"k":"narrate_init_first","v":{"s":"Wave Simulator loaded. An underwater ocean scene shows animated waves. Adjust amplitude and frequency with sliders. Switch between Free Wave, Standing, Ripple Tank, Longitudinal, Doppler, and Spectrum modes."}},{"k":"narrate_ready","v":{"s":"Wave Simulator ready."}},{"k":"xp_matched_wave","v":{"s":"Matched a wave exactly!"}},{"k":"aria_wave_amplitude","v":{"s":"Wave amplitude"}},{"k":"aria_amp_valuetext","v":{"s":"amplitude sets the wave height (loudness and energy)"}},{"k":"aria_wave_frequency","v":{"s":"Wave frequency"}},{"k":"aria_freq_vt_a","v":{"s":" hertz, period "}},{"k":"aria_freq_vt_b","v":{"s":" seconds — frequency sets the pitch"}},{"k":"quiz1_q","v":{"s":"What happens to pitch when frequency increases?"}},{"k":"quiz1_fb_goes_down","v":{"s":"Backwards — MORE vibrations per second means HIGHER pitch. Slide frequency up with Play Sound on and listen to it climb."}},{"k":"quiz1_fb_stays_same","v":{"s":"Pitch IS your ear’s perception of frequency — change one and you have changed the other."}},{"k":"quiz1_fb_disappears","v":{"s":"Sound only disappears when AMPLITUDE reaches zero. Frequency changes the pitch, not whether it exists."}},{"k":"quiz2_q","v":{"s":"What does amplitude control?"}},{"k":"quiz2_fb_speed","v":{"s":"Wave speed is set by the MEDIUM (air, water, string tension) — a louder shout does not arrive any sooner."}},{"k":"quiz2_fb_color","v":{"s":"For light, FREQUENCY sets the color. Amplitude sets brightness — and for sound, loudness."}},{"k":"quiz2_fb_direction","v":{"s":"Direction comes from the source and reflections. Amplitude is the wave’s height — how much energy it carries."}},{"k":"quiz3_q","v":{"s":"What is superposition?"}},{"k":"quiz3_fb_canceling","v":{"s":"Canceling is only ONE special case (destructive). Superposition is the general rule: overlapping waves ADD their displacements — sometimes bigger, sometimes smaller."}},{"k":"quiz3_fb_reflecting","v":{"s":"Reflection is a wave bouncing off a boundary. Superposition is what happens when two waves OVERLAP — try the Ripple Tank."}},{"k":"quiz3_fb_stopping","v":{"s":"Waves pass straight through each other and continue unchanged — they never stop each other."}},{"k":"quiz4_q","v":{"s":"Destructive interference occurs when..."}},{"k":"quiz4_fb_peaks","v":{"s":"Peak-on-peak is CONSTRUCTIVE interference — the wave gets bigger. Destruction needs opposites: peak + trough = flat."}},{"k":"quiz4_fb_stop","v":{"s":"The waves keep traveling — they only cancel at the spots where they overlap out of phase. Watch the dark bands in the Ripple Tank."}},{"k":"quiz4_fb_doubles","v":{"s":"Doubling is constructive interference. Destructive SUBTRACTS — a peak fills a trough."}},{"k":"quiz5_q","v":{"s":"Sound is what type of wave?"}},{"k":"quiz5_fb_transverse","v":{"s":"Transverse waves wiggle PERPENDICULAR to travel (light, a guitar string). Air molecules push and pull ALONG the direction of travel — switch to Longitudinal mode and watch the compressions."}},{"k":"quiz5_fb_circular","v":{"s":"Water ripples spread in circles, but that describes the pattern on the surface, not the wave type."}},{"k":"quiz5_fb_standing","v":{"s":"Standing waves are trapped between boundaries. Traveling sound is free — it only forms standing waves inside pipes and rooms."}},{"k":"quiz6_q","v":{"s":"At a node of a standing wave, the displacement is:"}},{"k":"quiz6_fb_maximum","v":{"s":"Maximum displacement is the ANTInode. Nodes are the still points — in Standing mode, watch the spots where the string never moves."}},{"k":"quiz6_fb_half","v":{"s":"Nodes are perfectly still — zero, not half. Points BETWEEN node and antinode oscillate at partial amplitude."}},{"k":"quiz6_fb_random","v":{"s":"Standing waves are perfectly ordered — the nodes stay locked in place. That is exactly why they are called STANDING."}},{"k":"quiz7_q","v":{"s":"The speed of a wave equals:"}},{"k":"quiz7_fb_amp_freq","v":{"s":"Amplitude carries ENERGY, not speed. v = f × λ: waves per second × length of each wave = distance per second."}},{"k":"quiz7_fb_period_amp","v":{"s":"Period is just 1/frequency and amplitude is height — multiplying them gives nothing physical. v = f × λ."}},{"k":"quiz7_fb_none","v":{"s":"One of them IS right: v = f × λ — how many waves pass per second times how long each one is."}},{"k":"tour_step1","v":{"s":"Welcome! Drag the Amplitude and Frequency sliders to shape your wave — or focus the wave itself and use the arrow keys. Space pauses."}},{"k":"tour_step2","v":{"s":"Switch modes above: Standing, Ripple Tank, Reflection, Longitudinal, Doppler, and Spectrum each show a different piece of wave physics."}},{"k":"tour_step3","v":{"s":"Turn on the Second Wave to see superposition — two waves adding into one. Try the 🎵 Beats preset, then Play Sound to hear it."}},{"k":"tour_region_label","v":{"s":"Getting started tips"}},{"k":"tour_done","v":{"s":"Done"}},{"k":"tour_next","v":{"s":"Next"}},{"k":"tour_skip_label","v":{"s":"Skip the tour"}},{"k":"tour_skip","v":{"s":"Skip"}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"title","v":{"s":"Wave Simulator"}},{"k":"badge_animated","v":{"s":"ANIMATED"}},{"k":"tab_free","v":{"s":"Free Wave"}},{"k":"tab_ripple","v":{"s":"Ripple Tank"}},{"k":"aria_switch_to","v":{"s":"Switch to "}},{"k":"aria_mode_suffix","v":{"s":" mode"}},{"k":"narrate_free","v":{"s":"Free wave mode. Observe sine, square, triangle, and sawtooth waveforms."}},{"k":"narrate_standing","v":{"s":"Standing wave mode. See nodes and antinodes form on a vibrating string."}},{"k":"narrate_ripple","v":{"s":"Ripple tank mode. Drag two point sources to explore interference patterns."}},{"k":"narrate_reflection","v":{"s":"Reflection mode. A wave hits a wall — drag the wall to see fixed vs free end behavior."}},{"k":"narrate_longitudinal","v":{"s":"Longitudinal wave mode. See compression and rarefaction in a spring."}},{"k":"narrate_doppler","v":{"s":"Doppler effect mode. A moving source shifts the observed frequency."}},{"k":"narrate_spectrum","v":{"s":"Spectrum analysis mode. See the frequency components of your wave."}},{"k":"narrate_switched_to","v":{"s":"Switched to "}},{"k":"narrate_mode_active","v":{"s":" mode active."}},{"k":"aria_play_animation","v":{"s":"Play animation"}},{"k":"aria_pause_animation","v":{"s":"Pause animation (or press Space on the wave)"}},{"k":"btn_play","v":{"s":"Play"}},{"k":"btn_pause","v":{"s":"Pause"}},{"k":"aria_step_frame","v":{"s":"Step the animation forward one frame"}},{"k":"btn_step","v":{"s":"Step"}},{"k":"aria_toggle_sound","v":{"s":"Toggle Sound"}},{"k":"btn_stop_sound","v":{"s":"Stop Sound"}},{"k":"btn_play_sound","v":{"s":"Play Sound"}},{"k":"hero_free_title","v":{"s":"Free Wave — sine, square, triangle, sawtooth"}},{"k":"hero_free_hint","v":{"s":"Pure sine = single frequency; square / triangle / sawtooth are sine sums (Fourier 1822). Each waveform sounds different at the same pitch — timbre IS the harmonic content."}},{"k":"hero_standing_title","v":{"s":"Standing — nodes + antinodes on a string"}},{"k":"hero_standing_hint","v":{"s":"Two waves traveling opposite directions interfere into a stationary pattern. Guitar / violin strings vibrate at fundamental + integer harmonics. Length, tension, density set the pitch."}},{"k":"hero_ripple_title","v":{"s":"Ripple Tank — two sources, interference"}},{"k":"hero_ripple_hint","v":{"s":"Where crests meet crests → bright (constructive); crests meet troughs → dark (destructive). Young’s 1801 double-slit experiment proved light is a wave; same physics here."}},{"k":"hero_longitudinal_title","v":{"s":"Longitudinal — compression + rarefaction"}},{"k":"hero_longitudinal_hint","v":{"s":"Sound is longitudinal: air molecules push and pull along the direction of travel, not perpendicular. P-waves in earthquakes are longitudinal too — they arrive first, hence the P (primary)."}},{"k":"hero_doppler_title","v":{"s":"Doppler — the moving siren effect"}},{"k":"hero_doppler_hint","v":{"s":"Source approaching = compressed wavelengths = higher pitch. Moving away = stretched wavelengths = lower pitch. Christian Doppler 1842; redshift in cosmology is the same idea, with light."}},{"k":"hero_spectrum_title","v":{"s":"Spectrum — FFT decomposition"}},{"k":"hero_spectrum_hint","v":{"s":"Any periodic signal = sum of sines (Fourier transform). Music DAWs, JPEG, MRI, MP3 — all rest on this. Cooley + Tukey 1965 FFT made it computationally cheap; modern signal processing was born."}},{"k":"aria_canvas","v":{"s":"Wave simulator — arrow up/down adjusts amplitude, arrow left/right adjusts frequency, +/- adjusts speed, space pauses or resumes the animation"}},{"k":"narrate_amplitude","v":{"s":"Amplitude"}},{"k":"narrate_frequency","v":{"s":"Frequency"}},{"k":"narrate_hertz","v":{"s":" hertz"}},{"k":"narrate_speed","v":{"s":"Speed"}},{"k":"narrate_paused","v":{"s":"Animation paused"}},{"k":"narrate_playing","v":{"s":"Animation playing"}},{"k":"overlay_live_wave","v":{"s":"Live wave"}},{"k":"overlay_type","v":{"s":"Type"}},{"k":"overlay_medium","v":{"s":"Medium"}},{"k":"readout_wavelength","v":{"s":"Wavelength"}},{"k":"readout_speed","v":{"s":"Speed"}},{"k":"readout_energy","v":{"s":"Energy"}},{"k":"overlay_timbre_harmonics","v":{"s":"Timbre = harmonics"}},{"k":"overlay_gold_tracer","v":{"s":"Gold tracer"}},{"k":"overlay_jiggles","v":{"s":"Jiggles in place — the wave travels, the matter does not"}},{"k":"overlay_warm_compression","v":{"s":"Warm = compression"}},{"k":"overlay_blue_rarefaction","v":{"s":"Blue = rarefaction"}},{"k":"standing_harmonic_label","v":{"s":"Harmonic:"}},{"k":"standing_wave_title","v":{"s":"Standing Wave — Harmonic #"}},{"k":"standing_nodes_prefix","v":{"s":"Nodes (🔴 N): Points of zero displacement — "}},{"k":"standing_nodes_suffix","v":{"s":" total (including endpoints)"}},{"k":"standing_antinodes_prefix","v":{"s":"Antinodes (🟢 A): Points of maximum displacement — "}},{"k":"standing_antinodes_suffix","v":{"s":" total"}},{"k":"standing_wavelength_label","v":{"s":"Wavelength:"}},{"k":"standing_wavelength_note","v":{"s":" (L = string length)"}},{"k":"standing_frequency_label","v":{"s":"Frequency:"}},{"k":"ctrl_amplitude","v":{"s":"Amplitude"}},{"k":"ctrl_frequency","v":{"s":"Frequency"}},{"k":"ctrl_frequency_aria","v":{"s":"Frequency in hertz"}},{"k":"ctrl_speed","v":{"s":"Speed"}},{"k":"ctrl_speed_aria","v":{"s":"Animation speed multiplier"}},{"k":"ctrl_medium","v":{"s":"Medium v (m/s)"}},{"k":"ctrl_medium_aria","v":{"s":"Medium wave speed in meters per second"}},{"k":"vt_freq_a","v":{"s":" hertz — wavelength "}},{"k":"vt_freq_b","v":{"s":" meters, period "}},{"k":"vt_freq_c","v":{"s":" seconds"}},{"k":"vt_amplitude","v":{"s":" — wave height; energy grows as amplitude squared"}},{"k":"vt_speed","v":{"s":" times animation speed"}},{"k":"vt_medium","v":{"s":" meters per second through the medium"}},{"k":"narrate_wavelength_suffix","v":{"s":". Wavelength: "}},{"k":"aria_show_second","v":{"s":"Show second wave"}},{"k":"show_second_wave","v":{"s":"Show Second Wave (Interference)"}},{"k":"aria_second_amplitude","v":{"s":"Second wave amplitude"}},{"k":"aria_second_frequency","v":{"s":"Second wave frequency"}},{"k":"aria_second_phase","v":{"s":"Second wave phase"}},{"k":"toast_beats","v":{"s":"Beats: 4 Hz + 4.5 Hz — watch (and hear) the slow 0.5 Hz pulse"}},{"k":"aria_beats_preset","v":{"s":"Beats preset — two waves at 4 and 4.5 hertz so the beat envelope is visible"}},{"k":"btn_beats","v":{"s":"Beats"}},{"k":"aria_enable_damping","v":{"s":"Enable damping"}},{"k":"damping_label","v":{"s":"Damping (Exponential Decay)"}},{"k":"aria_damping_coeff","v":{"s":"Damping coefficient"}},{"k":"ripple_source_separation","v":{"s":"Source Separation:"}},{"k":"aria_slit_separation","v":{"s":"Slit separation"}},{"k":"ripple_medium_damping","v":{"s":"Medium Damping:"}},{"k":"aria_damping_interference","v":{"s":"Damping coefficient for interference"}},{"k":"toast_sources_reset","v":{"s":"Sources reset to defaults"}},{"k":"aria_reset_sources","v":{"s":"Reset source positions to defaults"}},{"k":"btn_reset_sources","v":{"s":"Reset sources"}},{"k":"ripple_bright","v":{"s":"Bright"}},{"k":"ripple_constructive","v":{"s":" = constructive · "}},{"k":"ripple_dark","v":{"s":"dark"}},{"k":"ripple_destructive_hint","v":{"s":" = destructive · 💡 drag the red sources"}},{"k":"refl_end_type","v":{"s":"End Type:"}},{"k":"aria_fixed_end","v":{"s":"Fixed end (string tied down — phase inverts on reflection)"}},{"k":"aria_free_end","v":{"s":"Free end (string free to move — phase preserved on reflection)"}},{"k":"btn_fixed","v":{"s":"Fixed"}},{"k":"btn_free","v":{"s":"Free"}},{"k":"refl_wall_position","v":{"s":"Wall Position:"}},{"k":"aria_wall_position","v":{"s":"Wall position across the tank (keyboard equivalent of dragging the gold wall)"}},{"k":"refl_reflectivity","v":{"s":"Reflectivity:"}},{"k":"aria_reflectivity","v":{"s":"Wall reflectivity 0 to 1"}},{"k":"toast_wall_reset","v":{"s":"Wall reset to 75% across"}},{"k":"aria_reset_wall","v":{"s":"Reset wall position"}},{"k":"btn_reset_wall","v":{"s":"Reset wall"}},{"k":"refl_solid","v":{"s":"solid"}},{"k":"refl_solid_desc","v":{"s":": incident + reflected · "}},{"k":"refl_dashed","v":{"s":"dashed"}},{"k":"refl_dashed_desc","v":{"s":": reflected alone · 💡 drag the gold wall or use the slider"}},{"k":"doppler_source_speed","v":{"s":"Source Speed"}},{"k":"aria_source_speed","v":{"s":"Source speed as fraction of wave speed"}},{"k":"doppler_mach","v":{"s":"of sound speed (Mach number)"}},{"k":"doppler_approaching","v":{"s":"approaching"}},{"k":"doppler_receding","v":{"s":"receding"}},{"k":"doppler_tone_bends","v":{"s":"the tone bends as the source passes the observer"}},{"k":"doppler_press_play","v":{"s":"press Play Sound to HEAR the shift"}},{"k":"wave_equation_heading","v":{"s":"Wave Equation"}},{"k":"general_formula","v":{"s":"General Formula"}},{"k":"target_equation","v":{"s":"Target Equation:"}},{"k":"your_equation","v":{"s":"Your Equation:"}},{"k":"current_equation","v":{"s":"Current Equation:"}},{"k":"pct_match","v":{"s":"% match"}},{"k":"eq_standing_note","v":{"s":"Standing wave — superposition of two traveling waves. A = Amplitude, n = Harmonic"}},{"k":"card_wavelength","v":{"s":"Wavelength"}},{"k":"card_period","v":{"s":"Period"}},{"k":"card_wave_speed","v":{"s":"Wave Speed"}},{"k":"card_energy","v":{"s":"Energy"}},{"k":"investigate_intro","v":{"s":"Ready to think like a physicist? Two open-ended investigations — no answer dumps, just you and the data."}},{"k":"toast_opened_below","v":{"s":"Opened below — scroll down to the Reference Library"}},{"k":"btn_discover","v":{"s":"Discover"}},{"k":"btn_standing_hunt","v":{"s":"Standing-wave hunt"}},{"k":"myth1_myth","v":{"s":"Waves carry water (or air) along with them."}},{"k":"myth1_truth","v":{"s":"Waves carry ENERGY, not matter. Each bit of the medium oscillates around its home spot and hands the motion on to its neighbor."}},{"k":"myth1_btn","v":{"s":"Watch the gold tracer"}},{"k":"myth2_myth","v":{"s":"A bigger (louder) wave travels faster."}},{"k":"myth2_truth","v":{"s":"Speed is set by the MEDIUM — tension, density, temperature. Cranking amplitude adds energy, not speed: the crests arrive no sooner."}},{"k":"myth2_btn","v":{"s":"Crank amplitude, watch the speed"}},{"k":"myth3_myth","v":{"s":"Sound can travel through empty space."}},{"k":"myth3_truth","v":{"s":"Sound is matter compressing matter. In a vacuum there is nothing to push, so space is silent. Light is different — EM waves need no medium."}},{"k":"myth3_btn","v":{"s":"See what sound really is"}},{"k":"myth4_myth","v":{"s":"When waves cancel, their energy is destroyed."}},{"k":"myth4_truth","v":{"s":"Energy is never destroyed — it redistributes. The dark bands in the ripple tank sit right next to extra-bright ones; the total stays constant."}},{"k":"myth4_btn","v":{"s":"Find the dark bands"}},{"k":"myths_header","v":{"s":"Wave myths — test your intuition"}},{"k":"hide","v":{"s":"Hide"}},{"k":"show","v":{"s":"Show"}},{"k":"myth_prefix","v":{"s":"Myth: "}},{"k":"btn_next_question","v":{"s":"Next Question"}},{"k":"btn_quiz_mode","v":{"s":"Quiz Mode"}},{"k":"btn_new_target","v":{"s":"New Target"}},{"k":"btn_match_waveform","v":{"s":"Match Waveform"}},{"k":"toast_match_equation","v":{"s":"Match the mathematical equation!"}},{"k":"btn_new_equation","v":{"s":"New Equation"}},{"k":"btn_match_equation","v":{"s":"Match Equation"}},{"k":"btn_clear","v":{"s":"Clear"}},{"k":"quiz_correct_suffix","v":{"s":" correct"}},{"k":"aria_reset_all","v":{"s":"Reset all wave controls to their defaults"}},{"k":"toast_controls_reset","v":{"s":"Controls reset to defaults"}},{"k":"btn_reset_controls","v":{"s":"Reset controls"}},{"k":"aria_select_answer","v":{"s":"Select answer: "}},{"k":"quiz_answer_is","v":{"s":"The answer is "}},{"k":"xp_wave_quiz","v":{"s":"Wave quiz: "}},{"k":"announce_not_quite","v":{"s":"Not quite. "}},{"k":"toast_correct","v":{"s":"Correct!"}},{"k":"toast_not_quite_below","v":{"s":"Not quite — see why below"}},{"k":"feedback_answer_prefix","v":{"s":"Not quite — the answer is"}},{"k":"toast_sim_setup","v":{"s":"Sim set up to demonstrate this — watch the wave"}},{"k":"btn_show_in_sim","v":{"s":"Show me in the sim"}},{"k":"snapshot","v":{"s":"Snapshot"}},{"k":"toast_snapshot_saved","v":{"s":"Snapshot saved!"}},{"k":"ai_level_plain","v":{"s":"Plain"}},{"k":"ai_level_grade5","v":{"s":"Grade 5"}},{"k":"ai_level_hs","v":{"s":"High School"}},{"k":"ai_not_available","v":{"s":"AI tutor not available."}},{"k":"announce_explanation_ready","v":{"s":"Explanation ready."}},{"k":"ai_unreachable","v":{"s":"Could not reach AI tutor. Try again in a moment."}},{"k":"ai_explain_heading","v":{"s":"Explain at my level"}},{"k":"aria_reading_level_group","v":{"s":"Reading level"}},{"k":"aria_reading_level","v":{"s":"Reading level: "}},{"k":"aria_selected","v":{"s":" (selected)"}},{"k":"aria_generate_at","v":{"s":"Generate AI explanation at "}},{"k":"aria_level_suffix","v":{"s":" level"}},{"k":"ai_thinking","v":{"s":"Thinking..."}},{"k":"ai_reexplain","v":{"s":"Re-explain"}},{"k":"ai_explain","v":{"s":"Explain"}},{"k":"ai_placeholder","v":{"s":"Click “Explain” for the AI tutor to describe the current wave at your chosen reading level."}},{"k":"wt_transverse_name","v":{"s":"Transverse"}},{"k":"wt_transverse_desc","v":{"s":"Particle motion perpendicular to wave direction. Crests + troughs."}},{"k":"wt_transverse_ex1","v":{"s":"Light + all EM waves"}},{"k":"wt_transverse_ex2","v":{"s":"String wave"}},{"k":"wt_transverse_ex3","v":{"s":"Surface water waves (mostly)"}},{"k":"wt_transverse_ex4","v":{"s":"S-waves in earthquakes"}},{"k":"wt_transverse_speed","v":{"s":"Varies by medium"}},{"k":"wt_longitudinal_name","v":{"s":"Longitudinal (compressional)"}},{"k":"wt_longitudinal_desc","v":{"s":"Particle motion parallel to wave direction. Compressions + rarefactions."}},{"k":"wt_longitudinal_ex1","v":{"s":"Sound waves in air"}},{"k":"wt_longitudinal_ex2","v":{"s":"Slinky push-pull"}},{"k":"wt_longitudinal_ex3","v":{"s":"P-waves in earthquakes"}},{"k":"wt_longitudinal_ex4","v":{"s":"Ultrasound"}},{"k":"wt_longitudinal_speed","v":{"s":"~343 m/s sound in air at 20°C"}},{"k":"wt_surface_name","v":{"s":"Surface (Rayleigh)"}},{"k":"wt_surface_desc","v":{"s":"Particles trace elliptical paths. Combines transverse + longitudinal."}},{"k":"wt_surface_ex1","v":{"s":"Ocean surface waves"}},{"k":"wt_surface_ex2","v":{"s":"Rayleigh waves in earthquakes"}},{"k":"wt_surface_speed","v":{"s":"Depends on water depth + λ"}},{"k":"wt_em_name","v":{"s":"Electromagnetic"}},{"k":"wt_em_desc","v":{"s":"Oscillating electric + magnetic fields. No medium needed (travel through vacuum)."}},{"k":"wt_em_ex1","v":{"s":"Visible light"}},{"k":"wt_em_ex2","v":{"s":"Radio"}},{"k":"wt_em_ex3","v":{"s":"X-rays"}},{"k":"wt_em_ex4","v":{"s":"Microwaves"}},{"k":"wt_em_ex5","v":{"s":"IR / UV"}},{"k":"wt_em_speed","v":{"s":"c = 3.0 × 10⁸ m/s in vacuum"}},{"k":"wt_matter_name","v":{"s":"Matter waves (de Broglie)"}},{"k":"wt_matter_desc","v":{"s":"All matter has wave properties. λ = h/p. Observable for electrons + atoms."}},{"k":"wt_matter_ex1","v":{"s":"Electron diffraction"}},{"k":"wt_matter_ex2","v":{"s":"Neutron scattering"}},{"k":"wt_matter_ex3","v":{"s":"Atom interferometry"}},{"k":"wt_matter_speed","v":{"s":"Particle velocity (not wave)"}},{"k":"wt_gravitational_name","v":{"s":"Gravitational waves"}},{"k":"wt_gravitational_desc","v":{"s":"Ripples in spacetime from accelerating masses. First detected 2015 (LIGO)."}},{"k":"wt_gravitational_ex1","v":{"s":"Black hole + neutron star mergers"}},{"k":"wt_gravitational_ex2","v":{"s":"Predicted by Einstein 1915"}},{"k":"wt_gravitational_speed","v":{"s":"c (speed of light)"}},{"k":"wq_wavelength_name","v":{"s":"Wavelength"}},{"k":"wq_wavelength_units","v":{"s":"m (meters)"}},{"k":"wq_wavelength_def","v":{"s":"Distance between two successive crests (or troughs). Crest-to-crest."}},{"k":"wq_frequency_name","v":{"s":"Frequency"}},{"k":"wq_frequency_units","v":{"s":"Hz (1/s)"}},{"k":"wq_frequency_def","v":{"s":"Cycles per second. How many wave peaks pass a point per second."}},{"k":"wq_period_name","v":{"s":"Period"}},{"k":"wq_period_units","v":{"s":"s (seconds)"}},{"k":"wq_period_def","v":{"s":"Time for one complete cycle. T = 1/f."}},{"k":"wq_amplitude_name","v":{"s":"Amplitude"}},{"k":"wq_amplitude_units","v":{"s":"m (or whatever the wave displaces)"}},{"k":"wq_amplitude_def","v":{"s":"Maximum displacement from equilibrium. Carries energy; intensity ∝ A²."}},{"k":"wq_wavespeed_name","v":{"s":"Wave speed"}},{"k":"wq_wavespeed_def","v":{"s":"How fast the wave moves through the medium. v = fλ."}},{"k":"wq_wavenumber_name","v":{"s":"Wave number"}},{"k":"wq_wavenumber_units","v":{"s":"1/m (or rad/m)"}},{"k":"wq_wavenumber_def","v":{"s":"k = 2π/λ. Spatial frequency. Useful in y = A·sin(kx − ωt)."}},{"k":"wq_angfreq_name","v":{"s":"Angular frequency"}},{"k":"wq_angfreq_def","v":{"s":"ω = 2πf. Used in trigonometric wave equations."}},{"k":"wq_phase_name","v":{"s":"Phase"}},{"k":"wq_phase_units","v":{"s":"rad (or degrees)"}},{"k":"wq_phase_def","v":{"s":"Position within a cycle. Two waves in phase: peaks align (constructive); out of phase by π: peaks meet troughs (destructive)."}},{"k":"ip_constructive_type","v":{"s":"Constructive"}},{"k":"ip_constructive_result","v":{"s":"Amplitudes ADD. Bright fringe (light), loud point (sound), large displacement."}},{"k":"ip_destructive_type","v":{"s":"Destructive"}},{"k":"ip_destructive_result","v":{"s":"Amplitudes CANCEL. Dark fringe, quiet point, no displacement."}},{"k":"ip_partial_type","v":{"s":"Partial"}},{"k":"ip_partial_result","v":{"s":"Partial reinforcement or cancellation. Wave appears with intermediate amplitude."}},{"k":"dc_toward_case","v":{"s":"Source moving toward you"}},{"k":"dc_obs_higher","v":{"s":"f observed > f emitted"}},{"k":"dc_toward_detail","v":{"s":"Wavefronts bunch up in front. Higher pitch (sound) / blueshift (light)."}},{"k":"dc_away_case","v":{"s":"Source moving away"}},{"k":"dc_obs_lower","v":{"s":"f observed < f emitted"}},{"k":"dc_away_detail","v":{"s":"Wavefronts spread out behind. Lower pitch / redshift."}},{"k":"dc_obs_toward_case","v":{"s":"Observer moving toward source"}},{"k":"dc_obs_toward_detail","v":{"s":"You meet wavefronts faster. Higher apparent frequency."}},{"k":"dc_obs_away_case","v":{"s":"Observer moving away"}},{"k":"dc_obs_away_detail","v":{"s":"Wavefronts catch up to you slower."}},{"k":"dc_both_case","v":{"s":"Both moving same direction, same speed"}},{"k":"dc_no_shift","v":{"s":"No Doppler shift"}},{"k":"dc_both_detail","v":{"s":"Relative velocity zero between source + observer."}},{"k":"dc_barrier_case","v":{"s":"Source at sound barrier (v_source ≥ v_sound)"}},{"k":"dc_sonic_boom","v":{"s":"Sonic boom (Mach cone)"}},{"k":"dc_barrier_detail","v":{"s":"Wavefronts stack on top of each other. Cone of compression follows the source."}},{"k":"em_radio_name","v":{"s":"Radio"}},{"k":"em_radio_energy","v":{"s":"Very low"}},{"k":"em_radio_uses","v":{"s":"Broadcasting, communication, MRI"}},{"k":"em_microwave_name","v":{"s":"Microwave"}},{"k":"em_microwave_energy","v":{"s":"Low"}},{"k":"em_microwave_uses","v":{"s":"Cooking (water rotation), radar, WiFi, satellite"}},{"k":"em_ir_name","v":{"s":"Infrared (IR)"}},{"k":"em_ir_energy","v":{"s":"Low-mid"}},{"k":"em_ir_uses","v":{"s":"Thermal imaging, TV remotes, fiber optics"}},{"k":"em_visible_name","v":{"s":"Visible light"}},{"k":"em_visible_energy","v":{"s":"Mid"}},{"k":"em_visible_uses","v":{"s":"Vision, photosynthesis, photography"}},{"k":"em_uv_name","v":{"s":"Ultraviolet (UV)"}},{"k":"em_uv_energy","v":{"s":"High"}},{"k":"em_uv_uses","v":{"s":"Sterilization, fluorescence, Vit D synthesis"}},{"k":"em_xray_name","v":{"s":"X-ray"}},{"k":"em_xray_energy","v":{"s":"Very high"}},{"k":"em_xray_uses","v":{"s":"Medical imaging, crystallography, security scanners"}},{"k":"em_gamma_name","v":{"s":"Gamma ray"}},{"k":"em_gamma_energy","v":{"s":"Extreme"}},{"k":"em_gamma_uses","v":{"s":"Cancer treatment, sterilization, astronomy (most energetic photons)"}},{"k":"vc_violet","v":{"s":"Violet"}},{"k":"vc_violet_notes","v":{"s":"Highest-energy visible. Just below UV."}},{"k":"vc_blue","v":{"s":"Blue"}},{"k":"vc_blue_notes","v":{"s":"Sky color (Rayleigh scattering favors short λ)."}},{"k":"vc_cyan","v":{"s":"Cyan"}},{"k":"vc_cyan_notes","v":{"s":"Bright in shallow water."}},{"k":"vc_green","v":{"s":"Green"}},{"k":"vc_green_notes","v":{"s":"Peak photopic eye sensitivity (~555 nm)."}},{"k":"vc_yellow","v":{"s":"Yellow"}},{"k":"vc_yellow_notes","v":{"s":"Sodium lamp emission (589 nm doublet)."}},{"k":"vc_orange","v":{"s":"Orange"}},{"k":"vc_orange_notes","v":{"s":"Sunset enhances reds + oranges via scattering."}},{"k":"vc_red","v":{"s":"Red"}},{"k":"vc_red_notes","v":{"s":"Lowest-energy visible. Just above IR."}},{"k":"harm_fundamental_mode","v":{"s":"Fundamental (1st)"}},{"k":"harm_fundamental_desc","v":{"s":"Lowest mode. One antinode in the middle."}},{"k":"harm_2nd_mode","v":{"s":"2nd harmonic"}},{"k":"harm_2nd_desc","v":{"s":"One full wavelength fits in the string length."}},{"k":"harm_3rd_mode","v":{"s":"3rd harmonic"}},{"k":"harm_3rd_desc","v":{"s":"Three half-wavelengths fit. Common in plucked strings."}},{"k":"harm_4th_mode","v":{"s":"4th harmonic"}},{"k":"harm_4th_desc","v":{"s":"Even integer; less common in stringed instruments tuned to fundamental."}},{"k":"harm_nth_mode","v":{"s":"nth harmonic"}},{"k":"harm_nth_desc","v":{"s":"General formula. Higher harmonics give timbre / character to a note."}},{"k":"wf_speed","v":{"s":"Wave speed from frequency + wavelength"}},{"k":"wf_period","v":{"s":"Period and frequency are reciprocals"}},{"k":"wf_sinusoidal","v":{"s":"Standard sinusoidal traveling wave"}},{"k":"wf_wavenumber","v":{"s":"Wave number ↔ wavelength"}},{"k":"wf_angfreq","v":{"s":"Angular frequency ↔ frequency"}},{"k":"wf_intensity","v":{"s":"Energy/area carried by wave grows as square of amplitude"}},{"k":"wf_snell","v":{"s":"Snell's law — refraction at interface"}},{"k":"wf_grating","v":{"s":"Diffraction grating maxima (m = order)"}},{"k":"wf_doppler","v":{"s":"Doppler shift (general; signs depend on directions)"}},{"k":"wf_photon","v":{"s":"Photon energy (h = Planck constant)"}},{"k":"swi_guitar_name","v":{"s":"Guitar string"}},{"k":"swi_guitar_boundary","v":{"s":"Both ends fixed"}},{"k":"swi_all_integers","v":{"s":"All integers (1,2,3,4...)"}},{"k":"swi_guitar_note","v":{"s":"Pluck position selects which harmonics dominate. Near center → odd harmonics."}},{"k":"swi_openpipe_name","v":{"s":"Open organ pipe"}},{"k":"swi_openpipe_boundary","v":{"s":"Both ends open (antinodes)"}},{"k":"swi_openpipe_note","v":{"s":"Same formula as string. Wave equation symmetric."}},{"k":"swi_closedpipe_name","v":{"s":"Closed organ pipe"}},{"k":"swi_closedpipe_boundary","v":{"s":"One closed end"}},{"k":"swi_odd_only","v":{"s":"Odd only (1,3,5,7...)"}},{"k":"swi_closedpipe_note","v":{"s":"Only odd harmonics. Octave + 5th, not octave alone."}},{"k":"swi_drum_name","v":{"s":"Drum head"}},{"k":"swi_drum_boundary","v":{"s":"Circular fixed edge"}},{"k":"swi_drum_harmonics","v":{"s":"Bessel function modes"}},{"k":"swi_drum_formula","v":{"s":"Complex 2D"}},{"k":"swi_drum_note","v":{"s":"Inharmonic — doesn't sound like a clear pitch. Tympani tuned to approximate one."}},{"k":"swi_marimba_name","v":{"s":"Marimba bar"}},{"k":"swi_marimba_boundary","v":{"s":"Bar supported at nodes"}},{"k":"swi_marimba_harmonics","v":{"s":"Tunable with bar shape"}},{"k":"swi_marimba_formula","v":{"s":"Depends on cross-section"}},{"k":"swi_marimba_note","v":{"s":"Undercut shapes the second partial to be a perfect octave above the fundamental."}},{"k":"si_threshold_src","v":{"s":"Threshold of hearing"}},{"k":"si_threshold_notes","v":{"s":"Reference: 10⁻¹² W/m²"}},{"k":"si_breathing_src","v":{"s":"Breathing"}},{"k":"si_breathing_notes","v":{"s":"Quietest noticeable sound"}},{"k":"si_whisper_src","v":{"s":"Whisper"}},{"k":"si_whisper_notes","v":{"s":"Library quiet"}},{"k":"si_conversation_src","v":{"s":"Conversation"}},{"k":"si_conversation_notes","v":{"s":"Office background"}},{"k":"si_vacuum_src","v":{"s":"Vacuum cleaner"}},{"k":"si_vacuum_notes","v":{"s":"Annoying at length"}},{"k":"si_traffic_src","v":{"s":"Heavy traffic"}},{"k":"si_traffic_notes","v":{"s":"Hearing damage above this with extended exposure"}},{"k":"si_motorcycle_src","v":{"s":"Motorcycle / blender"}},{"k":"si_motorcycle_notes","v":{"s":"Damage in 15 min"}},{"k":"si_concert_src","v":{"s":"Rock concert"}},{"k":"si_concert_notes","v":{"s":"Damage in seconds to minutes"}},{"k":"si_jet_src","v":{"s":"Jet engine at 100 m"}},{"k":"si_jet_notes","v":{"s":"Threshold of pain"}},{"k":"si_gunshot_src","v":{"s":"Gunshot at ear"}},{"k":"si_gunshot_notes","v":{"s":"Instant damage"}},{"k":"si_max_src","v":{"s":"Theoretical max in air"}},{"k":"si_max_notes","v":{"s":"Pressure variation = atmospheric pressure (can't go louder without becoming shock wave)"}},{"k":"gl_crest_term","v":{"s":"Crest"}},{"k":"gl_crest_def","v":{"s":"Highest point of a transverse wave. Maximum positive displacement."}},{"k":"gl_trough_term","v":{"s":"Trough"}},{"k":"gl_trough_def","v":{"s":"Lowest point of a transverse wave. Maximum negative displacement."}},{"k":"gl_compression_term","v":{"s":"Compression"}},{"k":"gl_compression_def","v":{"s":"Region of high pressure in a longitudinal wave (sound)."}},{"k":"gl_rarefaction_term","v":{"s":"Rarefaction"}},{"k":"gl_rarefaction_def","v":{"s":"Region of low pressure in a longitudinal wave."}},{"k":"gl_node_term","v":{"s":"Node"}},{"k":"gl_node_def","v":{"s":"Point of zero displacement on a standing wave."}},{"k":"gl_antinode_term","v":{"s":"Antinode"}},{"k":"gl_antinode_def","v":{"s":"Point of maximum displacement on a standing wave."}},{"k":"gl_reflection_term","v":{"s":"Reflection"}},{"k":"gl_reflection_def","v":{"s":"Wave bouncing off a boundary. Phase flips if going from less to more dense (hard boundary)."}},{"k":"gl_refraction_term","v":{"s":"Refraction"}},{"k":"gl_refraction_def","v":{"s":"Wave bending as it crosses a boundary where speed changes. Snell's law."}},{"k":"gl_diffraction_term","v":{"s":"Diffraction"}},{"k":"gl_diffraction_def","v":{"s":"Wave bending around obstacles or through apertures. Effect strong when aperture ~ λ."}},{"k":"gl_interference_term","v":{"s":"Interference"}},{"k":"gl_interference_def","v":{"s":"Two waves overlapping. Constructive (in phase) or destructive (out of phase)."}},{"k":"gl_standingwave_term","v":{"s":"Standing wave"}},{"k":"gl_standingwave_def","v":{"s":"Pattern from two identical waves traveling opposite directions. Nodes + antinodes fixed in space."}},{"k":"gl_resonance_term","v":{"s":"Resonance"}},{"k":"gl_resonance_def","v":{"s":"Large amplitude when driving frequency matches natural frequency. Tacoma Narrows bridge collapse classic example (with caveats)."}},{"k":"gl_damping_term","v":{"s":"Damping"}},{"k":"gl_damping_def","v":{"s":"Loss of amplitude over time due to friction or radiation. Critical damping = fastest decay without overshoot."}},{"k":"gl_coherence_term","v":{"s":"Coherence"}},{"k":"gl_coherence_def","v":{"s":"Constant phase relationship between waves. Required for stable interference patterns. Lasers are highly coherent."}},{"k":"gl_polarization_term","v":{"s":"Polarization"}},{"k":"gl_polarization_def","v":{"s":"Direction of oscillation in a transverse wave. Light from sun is unpolarized; passing through a polarizer selects one direction."}},{"k":"gl_photon_term","v":{"s":"Photon"}},{"k":"gl_photon_def","v":{"s":"Quantum of EM radiation. Energy E = hf. Each photon carries momentum p = h/λ."}},{"k":"exp_library_title","v":{"s":"Wave Reference Library"}},{"k":"exp_library_subtitle","v":{"s":"Interactive references — pick a topic below to explore."}},{"k":"exp_close_section","v":{"s":"Close section"}},{"k":"grp_basics","v":{"s":"Wave Basics"}},{"k":"tab_types","v":{"s":"Wave types"}},{"k":"tab_quantities","v":{"s":"Wave quantities"}},{"k":"tab_formulas","v":{"s":"Key formulas"}},{"k":"tab_units","v":{"s":"Wave units"}},{"k":"tab_wavespeeds","v":{"s":"Wave speeds"}},{"k":"tab_detailedspeeds","v":{"s":"Detailed speeds"}},{"k":"tab_interference","v":{"s":"Interference"}},{"k":"tab_diffraction","v":{"s":"Diffraction"}},{"k":"tab_polarization","v":{"s":"Polarization"}},{"k":"tab_doppler","v":{"s":"Doppler effect"}},{"k":"tab_shockwaves","v":{"s":"Shock waves"}},{"k":"tab_discover","v":{"s":"Discover f·λ=v"}},{"k":"grp_sound","v":{"s":"Sound & Music"}},{"k":"tab_harmonics","v":{"s":"Harmonics"}},{"k":"tab_standingwaves","v":{"s":"Standing waves"}},{"k":"tab_instrumentfreqs","v":{"s":"Instrument freqs"}},{"k":"tab_music","v":{"s":"Music + acoustics"}},{"k":"tab_soundintensity","v":{"s":"Sound intensity"}},{"k":"tab_noise","v":{"s":"Noise sources"}},{"k":"tab_hearing","v":{"s":"Hearing + ear"}},{"k":"tab_audioformats","v":{"s":"Audio formats"}},{"k":"grp_optics","v":{"s":"Light & Optics"}},{"k":"tab_optics","v":{"s":"Optics & lenses"}},{"k":"tab_refraction","v":{"s":"Refraction index"}},{"k":"tab_visiblelight","v":{"s":"Visible light"}},{"k":"tab_colormodels","v":{"s":"Color models"}},{"k":"tab_namedcolors","v":{"s":"Named colors"}},{"k":"tab_lasers","v":{"s":"Lasers"}},{"k":"tab_cameras","v":{"s":"Camera lenses"}},{"k":"tab_perception","v":{"s":"Perception & illusions"}},{"k":"grp_spectrum","v":{"s":"EM Spectrum"}},{"k":"tab_emspectrum","v":{"s":"EM spectrum"}},{"k":"tab_radiobands","v":{"s":"Radio bands"}},{"k":"tab_tvscreen","v":{"s":"TV + screen"}},{"k":"tab_quantum","v":{"s":"Quantum waves"}},{"k":"grp_comm","v":{"s":"Communications"}},{"k":"tab_antennas","v":{"s":"Antennas"}},{"k":"tab_radarsonar","v":{"s":"Radar/sonar"}},{"k":"tab_commprotocols","v":{"s":"Comm protocols"}},{"k":"tab_fiberoptics","v":{"s":"Fiber optics"}},{"k":"tab_gpssatellites","v":{"s":"GPS + satellites"}},{"k":"tab_medicalimaging","v":{"s":"Medical imaging"}},{"k":"grp_natural","v":{"s":"Natural & Cosmic"}},{"k":"tab_oceanwaves","v":{"s":"Ocean waves"}},{"k":"tab_seismicwaves","v":{"s":"Seismic waves"}},{"k":"tab_animalsenses","v":{"s":"Animal senses"}},{"k":"tab_stars","v":{"s":"Stars + spectra"}},{"k":"tab_gravwaves","v":{"s":"Gravitational waves"}},{"k":"grp_reference","v":{"s":"Reference"}},{"k":"tab_careers","v":{"s":"Wave careers"}},{"k":"tab_history","v":{"s":"History"}},{"k":"tab_glossary","v":{"s":"Glossary"}},{"k":"count_topics","v":{"s":" topics "}},{"k":"aria_topics_suffix","v":{"s":" topics"}},{"k":"sec_types_intro","v":{"s":"Waves are categorized by particle motion relative to propagation, and by whether they need a medium. All carry energy but no matter from one place to another."}},{"k":"label_examples","v":{"s":"Examples: "}},{"k":"sec_quantities_intro","v":{"s":"The full vocabulary needed to describe any wave. Most quantities are related — once you know two, you can derive the rest."}},{"k":"sec_formulas_title","v":{"s":"Key wave equations"}},{"k":"sec_interference_title","v":{"s":"Interference + superposition"}},{"k":"sec_interference_intro","v":{"s":"When two waves meet, their displacements add (principle of superposition). After passing through each other, each wave continues unchanged."}},{"k":"sec_beats_label","v":{"s":"Beats: "}},{"k":"sec_beats_text","v":{"s":"Two waves of slightly different frequency interfere alternately constructively + destructively. Beat frequency = |f₁ − f₂|. Musicians use this to tune by ear."}},{"k":"sec_doppler_intro","v":{"s":"Frequency observed changes when source and/or observer move relative to each other. The ambulance siren that drops pitch as it passes you = sound Doppler. Galaxy redshift = light Doppler."}},{"k":"sec_applications","v":{"s":"Applications"}},{"k":"doppler_app_radar","v":{"s":"Police radar: bounces microwaves off your car; Doppler shift = your speed. "}},{"k":"doppler_app_ultrasound","v":{"s":"Doppler ultrasound: measures blood flow direction + speed. "}},{"k":"doppler_app_hubble","v":{"s":"Hubble's discovery: distant galaxies are redshifted → universe expanding. "}},{"k":"doppler_app_cmb","v":{"s":"Cosmic microwave background: small Doppler shifts reveal early-universe structure."}},{"k":"sec_spectrum_title","v":{"s":"Electromagnetic spectrum"}},{"k":"sec_spectrum_intro","v":{"s":"All EM waves travel at c in vacuum. The full spectrum spans 18+ orders of magnitude in frequency. We see only a narrow sliver (visible light). Energy per photon: E = hf — higher frequency = more energetic."}},{"k":"label_energy_suffix","v":{"s":" energy"}},{"k":"label_uses","v":{"s":"Uses: "}},{"k":"sec_colors_title","v":{"s":"Visible light spectrum"}},{"k":"sec_colors_intro","v":{"s":"Human vision spans ~380-700 nm. Each color corresponds to a specific range of wavelengths. White light = mix of all visible wavelengths."}},{"k":"sec_harmonics_title","v":{"s":"Harmonics — modes of vibration"}},{"k":"sec_harmonics_intro","v":{"s":"A vibrating string supports an infinite series of modes called harmonics. Each has a specific number of nodes (zero-amplitude points) + antinodes (max-amplitude points). The mix of harmonics = timbre."}},{"k":"label_nodes_f","v":{"s":" nodes · f = "}},{"k":"harm_callout_label","v":{"s":"Why instruments sound different: "}},{"k":"harm_callout_text","v":{"s":"A note at 440 Hz on a violin and a flute both have fundamental at 440 Hz. The MIX of higher harmonics (the spectrum) is different — that's timbre. Pure sine = boring; rich harmonic content = recognizable instrument."}},{"k":"sec_instruments_title","v":{"s":"Standing waves in instruments"}},{"k":"sec_instruments_intro","v":{"s":"Instruments make tones by setting up standing waves. The boundary conditions (open/closed/fixed ends) determine which harmonics are allowed."}},{"k":"label_boundary","v":{"s":"Boundary: "}},{"k":"sec_decibels_title","v":{"s":"Sound intensity (decibels)"}},{"k":"sec_decibels_intro","v":{"s":"Decibels are a logarithmic scale. +10 dB ≈ 10× intensity, perceived as ~2× as loud. dB SPL (sound pressure level) is referenced to threshold of human hearing."}},{"k":"db_callout_label","v":{"s":"Permanent hearing loss: "}},{"k":"db_callout_text","v":{"s":"OSHA: 85 dB for 8 hours, 90 dB for 4 hours, etc. (each +5 dB halves safe exposure time). Wear ear protection at concerts, with power tools, at firing ranges."}},{"k":"sec_discover_title","v":{"s":"Discover the wave equation"}},{"k":"sec_discover_intro","v":{"s":"A string is fixed at both ends. Wiggle the controls. Watch what changes and what stays the same. Log a few observations, then try to spot the pattern. Hit \"I see it\" when you think you have the law — no peeking."}},{"k":"aria_standing_string","v":{"s":"Standing wave on a string"}},{"k":"svg_length_2m","v":{"s":"Length L = 2.0 m (fixed)"}},{"k":"label_wavespeed","v":{"s":"Wave speed"}},{"k":"disc_freq_label","v":{"s":"Frequency f: "}},{"k":"disc_tension_label","v":{"s":"String tension T: "}},{"k":"aria_tension_newtons","v":{"s":"Tension in newtons"}},{"k":"disc_mu_note","v":{"s":"(string mass density μ fixed at 0.01 kg/m)"}},{"k":"btn_log_observation","v":{"s":"Log observation"}},{"k":"btn_revealed","v":{"s":"Revealed"}},{"k":"btn_i_see_it","v":{"s":"I see it"}},{"k":"btn_reset","v":{"s":"Reset"}},{"k":"disc_your_observations","v":{"s":"Your observations"}},{"k":"disc_hypothesis_label","v":{"s":"Hypothesis time: "}},{"k":"disc_hypothesis_text","v":{"s":"Compare your f × λ column. Is it constant for different f values at the same tension? What about when you change tension? Form a hypothesis before clicking \"I see it\"."}},{"k":"disc_equation_label","v":{"s":"The wave equation: "}},{"k":"disc_reveal_text","v":{"s":"For a wave on a string, the speed v depends ONLY on the string's tension and mass density (v = √(T/μ)). The product f·λ always equals v. Change frequency → wavelength compensates so f·λ stays constant. Increase tension → wave speed jumps → f·λ jumps with it. Frequency × wavelength is one of the deepest constancies in physics: it shows up identically for light, sound, water waves, and quantum matter waves."}},{"k":"disc_reveal_hertz","v":{"s":"You just discovered it the way Hertz did — by watching what stays constant when you change one variable at a time."}},{"k":"sec_standinghunt_intro","v":{"s":"A string fixed at both ends. You control the tension and the driving frequency. There is no \"right answer\" — and no answer dump. Sweep the sliders. Look for the rare frequencies where the string locks into a clean standing pattern. Type what you discover in your own words."}},{"k":"standing_wave_snapshot","v":{"s":"Standing wave snapshot showing nodes and antinodes for the selected frequency and tension."}},{"k":"sh_standing_pattern","v":{"s":"Standing pattern — n = "}},{"k":"sh_half_wavelengths","v":{"s":" half-wavelengths)"}},{"k":"sh_off_resonance","v":{"s":"Off-resonance — pattern unstable"}},{"k":"sh_tension_label","v":{"s":"Tension: "}},{"k":"sh_frequency_label","v":{"s":"Frequency: "}},{"k":"aria_driving_freq","v":{"s":"Driving frequency in hertz"}},{"k":"sh_log_observation","v":{"s":"Log this observation"}},{"k":"sh_obs_logged","v":{"s":" observation(s) logged"}},{"k":"sh_col_locked","v":{"s":"locked"}},{"k":"sh_hypothesis_label","v":{"s":"Your hypothesis (free text — no right answer):"}},{"k":"sh_hypothesis_placeholder","v":{"s":"What pattern do you notice in the values where the string locks into a clean standing wave? Type your own theory."}},{"k":"sh_stuck_btn","v":{"s":"I'm stuck — show me some questions to think about (no answers)"}},{"k":"sh_open_questions","v":{"s":"Open questions (no answers — investigate by manipulating):"}},{"k":"sh_q1","v":{"s":"Try f = 5 Hz at T = 100 N, then T = 25 N. Does the locked state happen at the same f? Why might that be?"}},{"k":"sh_q2","v":{"s":"Sweep frequency slowly from 1 → 20 Hz at fixed T. How many locked states do you find? Are they evenly spaced or pattern-spaced?"}},{"k":"sh_q3","v":{"s":"When you triple the tension, does the f of the first locked state triple, or change by some other factor? Predict before you check."}},{"k":"sh_q4","v":{"s":"Log 4-5 locked observations. Look at the n column — what value do they share? Is that a coincidence or a constraint?"}},{"k":"sh_q5","v":{"s":"What relationship between f, T, and L would have to be true for an integer number of half-wavelengths to fit on the string?"}},{"k":"sh_no_answers","v":{"s":"No answers will be revealed here. The point is to push your thinking, not to hand you a result."}},{"k":"sh_understood_label","v":{"s":"I think I understand the pattern now — let me explain it in my own words"}},{"k":"explanation_input","v":{"s":"Standing-wave explanation"}},{"k":"sh_explanation_placeholder","v":{"s":"Explain in your own words: what determines when a standing wave forms? What role does tension play? What role does frequency play? What is \"n\"?"}},{"k":"sh_saved_note","v":{"s":"Saved. Notice — nobody checked your answer. The point of inquiry is the thinking that produced it, not external validation."}},{"k":"sh_design_note","v":{"s":"Design note: this widget has no score, no chips, no reveal button, and no right-answer check. Everything you discover comes from manipulation and observation. That is what \"inquiry\" looks like when the answer-dump is removed."}},{"k":"sec_glossary_title","v":{"s":"Wave glossary"}},{"k":"oel1_name","v":{"s":"Converging (convex) lens"}},{"k":"oel1_behavior","v":{"s":"Bends parallel rays toward focal point"}},{"k":"oel1_use","v":{"s":"Magnifying glass, eyeglasses for farsightedness, camera lenses, microscope objectives."}},{"k":"oel2_name","v":{"s":"Diverging (concave) lens"}},{"k":"oel2_behavior","v":{"s":"Spreads parallel rays as if from focal point"}},{"k":"oel2_use","v":{"s":"Eyeglasses for nearsightedness, peephole viewers."}},{"k":"oel3_name","v":{"s":"Concave (converging) mirror"}},{"k":"oel3_behavior","v":{"s":"Reflects parallel rays through focal point"}},{"k":"oel3_use","v":{"s":"Reflecting telescopes, satellite dishes, makeup mirrors (magnification)."}},{"k":"oel4_name","v":{"s":"Convex (diverging) mirror"}},{"k":"oel4_behavior","v":{"s":"Reflects parallel rays as if from focal point"}},{"k":"oel4_use","v":{"s":"Car side mirrors (\"objects in mirror are closer than they appear\"), store security mirrors."}},{"k":"oel5_name","v":{"s":"Plane mirror"}},{"k":"oel5_behavior","v":{"s":"Flat reflection — image distance = object distance"}},{"k":"oel5_use","v":{"s":"Everyday mirrors. Image is virtual, upright, same-size, laterally inverted."}},{"k":"oel6_name","v":{"s":"Prism (triangular)"}},{"k":"oel6_behavior","v":{"s":"Separates white light into spectrum by refraction"}},{"k":"oel6_use","v":{"s":"Spectroscopy, rainbow demos. Different wavelengths refract by different amounts (dispersion)."}},{"k":"oel7_name","v":{"s":"Diffraction grating"}},{"k":"oel7_behavior","v":{"s":"Separates light by many parallel slits"}},{"k":"oel7_use","v":{"s":"Higher resolution than prism. Used in modern spectrometers."}},{"k":"oel8_name","v":{"s":"Beam splitter"}},{"k":"oel8_behavior","v":{"s":"Transmits part of beam, reflects rest"}},{"k":"oel8_use","v":{"s":"Interferometers, LIGO, projectors, optical instruments."}},{"k":"oel9_name","v":{"s":"Polarizing filter"}},{"k":"oel9_behavior","v":{"s":"Transmits only one polarization direction"}},{"k":"oel9_use","v":{"s":"Sunglasses (cut glare from water/road), LCD displays, photography filters."}},{"k":"oel10_name","v":{"s":"Optical fiber"}},{"k":"oel10_behavior","v":{"s":"Total internal reflection guides light along the core"}},{"k":"oel10_use","v":{"s":"Internet backbone, endoscopes, fiber-optic Christmas trees."}},{"k":"oel11_name","v":{"s":"Half-silvered mirror"}},{"k":"oel11_behavior","v":{"s":"~50% transmitted, ~50% reflected"}},{"k":"oel11_use","v":{"s":"One-way windows (only works with brightness asymmetry), Michelson interferometer."}},{"k":"oel12_name","v":{"s":"Retroreflector (corner cube)"}},{"k":"oel12_behavior","v":{"s":"Returns light to source regardless of angle"}},{"k":"oel12_use","v":{"s":"Bike reflectors, road signs, Apollo lunar laser ranging."}},{"k":"ri_vacuum","v":{"s":"Vacuum"}},{"k":"ri_vacuum_notes","v":{"s":"Reference. Light travels at c = 299,792,458 m/s."}},{"k":"ri_air","v":{"s":"Air (STP)"}},{"k":"ri_air_notes","v":{"s":"Essentially same as vacuum for most purposes."}},{"k":"ri_water","v":{"s":"Water (20°C)"}},{"k":"ri_water_notes","v":{"s":"Bends light noticeably. Critical angle (water→air) ≈ 48.6°."}},{"k":"ri_ethanol","v":{"s":"Ethanol"}},{"k":"ri_ethanol_notes","v":{"s":"Slightly more refractive than water."}},{"k":"ri_glycerin","v":{"s":"Glycerin"}},{"k":"ri_glycerin_notes","v":{"s":"Submerged glass nearly invisible in glycerin (similar n)."}},{"k":"ri_quartz","v":{"s":"Quartz"}},{"k":"ri_quartz_notes","v":{"s":"Common in optics. Some birefringence."}},{"k":"ri_crown","v":{"s":"Crown glass"}},{"k":"ri_crown_notes","v":{"s":"Standard eyeglass + lens material."}},{"k":"ri_flint","v":{"s":"Flint glass"}},{"k":"ri_flint_notes","v":{"s":"Higher dispersion than crown — used in achromatic doublets."}},{"k":"ri_sapphire","v":{"s":"Sapphire"}},{"k":"ri_sapphire_notes","v":{"s":"Watch crystals, smartphone camera lenses."}},{"k":"ri_cz","v":{"s":"Cubic zirconia"}},{"k":"ri_cz_notes","v":{"s":"Higher than glass — used as diamond simulant."}},{"k":"ri_diamond","v":{"s":"Diamond"}},{"k":"ri_diamond_notes","v":{"s":"Very high. Critical angle just 24.4° → \"fire\" via total internal reflection."}},{"k":"ri_silicon","v":{"s":"Silicon (visible)"}},{"k":"ri_silicon_notes","v":{"s":"Opaque to visible but transparent in IR. Used in IR optics."}},{"k":"ri_meta","v":{"s":"Negative-index metamaterials"}},{"k":"ri_meta_notes","v":{"s":"Engineered structures bend light backward. Cloaking research."}},{"k":"df_singleslit","v":{"s":"Single-slit diffraction"}},{"k":"df_singleslit_notes","v":{"s":"a = slit width. Central bright fringe is twice as wide as side fringes."}},{"k":"df_doubleslit","v":{"s":"Double-slit interference"}},{"k":"df_doubleslit_notes","v":{"s":"d = slit separation. Demonstrates wave nature of light (Young, 1801)."}},{"k":"df_grating","v":{"s":"Diffraction grating"}},{"k":"df_grating_notes","v":{"s":"Many slits, very sharp peaks. Resolution improves with more slits."}},{"k":"df_rayleigh","v":{"s":"Rayleigh criterion"}},{"k":"df_rayleigh_notes","v":{"s":"Smallest angle resolvable by circular aperture of diameter D. Limits telescope/microscope resolution."}},{"k":"df_bragg","v":{"s":"Bragg's law (X-ray crystallography)"}},{"k":"df_bragg_notes","v":{"s":"X-rays diffract from crystal planes. Used to determine atomic positions."}},{"k":"df_spotsize","v":{"s":"Diffraction-limited spot size"}},{"k":"df_spotsize_notes","v":{"s":"NA = numerical aperture. Visible light limit ~200 nm — why electron microscopes have higher resolution."}},{"k":"pol_whatis","v":{"s":"What it is"}},{"k":"pol_whatis_detail","v":{"s":"Direction of oscillation of the electric field in EM waves. Sound (longitudinal) cannot be polarized."}},{"k":"pol_linear","v":{"s":"Linear polarization"}},{"k":"pol_linear_detail","v":{"s":"E-field oscillates in single plane. Most \"polarized\" light is linear."}},{"k":"pol_circular","v":{"s":"Circular polarization"}},{"k":"pol_circular_detail","v":{"s":"E-field rotates in circle. Right vs left circular. Used in 3D movies."}},{"k":"pol_malus","v":{"s":"Malus's law"}},{"k":"pol_malus_detail","v":{"s":"I = I₀·cos²θ. Light through two polarizers: angle between them controls intensity."}},{"k":"pol_brewster","v":{"s":"Brewster's angle"}},{"k":"pol_brewster_detail","v":{"s":"tan θ_B = n₂/n₁. Reflected light is fully polarized at this angle of incidence."}},{"k":"pol_birefringence","v":{"s":"Birefringence"}},{"k":"pol_birefringence_detail","v":{"s":"Some crystals (calcite, quartz) split unpolarized light into two polarized rays."}},{"k":"pol_glare","v":{"s":"Real-world: glare"}},{"k":"pol_glare_detail","v":{"s":"Reflection off horizontal surfaces (water, road) polarizes horizontally. Polarized sunglasses block this."}},{"k":"pol_lcds","v":{"s":"Real-world: LCDs"}},{"k":"pol_lcds_detail","v":{"s":"Two crossed polarizers + liquid crystals → controllable transmission per pixel."}},{"k":"pol_stress","v":{"s":"Real-world: stress analysis"}},{"k":"pol_stress_detail","v":{"s":"Polarized light through plastic models shows stress patterns as color bands."}},{"k":"pol_3d","v":{"s":"Real-world: 3D movies"}},{"k":"pol_3d_detail","v":{"s":"Circular polarization (RealD) or linear at 45°/135° (older systems) separates left/right images."}},{"k":"qw_debroglie","v":{"s":"de Broglie wavelength"}},{"k":"qw_debroglie_detail","v":{"s":"λ = h/p. Every massive particle has a wave nature. For an electron at 100 eV, λ ≈ 0.12 nm."}},{"k":"qw_duality","v":{"s":"Wave-particle duality"}},{"k":"qw_duality_detail","v":{"s":"Photons + electrons show both wave + particle behavior. Single-photon double-slit experiments confirm interference even with one photon at a time."}},{"k":"qw_schrodinger","v":{"s":"Schrödinger equation"}},{"k":"qw_schrodinger_detail","v":{"s":"Wave equation for matter waves. Solutions ψ give probability amplitude. |ψ|² = probability density."}},{"k":"qw_heisenberg","v":{"s":"Heisenberg uncertainty"}},{"k":"qw_heisenberg_detail","v":{"s":"Δx · Δp ≥ ℏ/2. Position + momentum can't both be measured precisely. Fundamental, not measurement error."}},{"k":"qw_quantized","v":{"s":"Quantized energy"}},{"k":"qw_quantized_detail","v":{"s":"Bound systems (atoms, harmonic oscillators) only allow specific energy levels. Like standing waves on a string."}},{"k":"qw_tunneling","v":{"s":"Tunneling"}},{"k":"qw_tunneling_detail","v":{"s":"Wave nature lets particles \"tunnel\" through energy barriers classically forbidden. Basis of STM, alpha decay, flash memory."}},{"k":"qw_photon","v":{"s":"Photon energy"}},{"k":"qw_photon_detail","v":{"s":"E = hf = hc/λ. Higher frequency → higher-energy photon. UV photons can ionize; IR cannot."}},{"k":"qw_compton","v":{"s":"Compton scattering"}},{"k":"qw_compton_detail","v":{"s":"Photon-electron collision shifts photon wavelength. Confirms photons carry momentum p = h/λ."}},{"k":"qw_pauli","v":{"s":"Pauli exclusion"}},{"k":"qw_pauli_detail","v":{"s":"Identical fermions cannot occupy same quantum state. Why electrons fill shells; why matter has structure."}},{"k":"qw_coherence","v":{"s":"Coherence length"}},{"k":"qw_coherence_detail","v":{"s":"Distance over which wave maintains phase. Laser: kilometers. Sunlight: micrometers. Needed for interference."}},{"k":"sw_p","v":{"s":"P-wave (primary)"}},{"k":"sw_p_type","v":{"s":"Body wave / longitudinal"}},{"k":"sw_p_speed","v":{"s":"~5–8 km/s in crust"}},{"k":"sw_p_notes","v":{"s":"Fastest. Compression/rarefaction along travel direction. Travels through solids AND liquids — passes through Earth's outer core."}},{"k":"sw_s","v":{"s":"S-wave (secondary/shear)"}},{"k":"sw_s_type","v":{"s":"Body wave / transverse"}},{"k":"sw_s_speed","v":{"s":"~3–4.5 km/s in crust"}},{"k":"sw_s_notes","v":{"s":"Slower than P. Side-to-side shaking. Cannot travel through liquids → outer core blocks S-waves (key evidence it's liquid)."}},{"k":"sw_love","v":{"s":"Love wave"}},{"k":"sw_surface_type","v":{"s":"Surface wave"}},{"k":"sw_love_speed","v":{"s":"~3–4.5 km/s"}},{"k":"sw_love_notes","v":{"s":"Horizontal transverse motion at surface. More damaging to buildings than P/S."}},{"k":"sw_rayleigh","v":{"s":"Rayleigh wave"}},{"k":"sw_rayleigh_speed","v":{"s":"~2–4 km/s"}},{"k":"sw_rayleigh_notes","v":{"s":"Rolling motion (like ocean waves). Largest amplitude. Felt as the rolling shake of an earthquake."}},{"k":"sf_richter","v":{"s":"Richter magnitude"}},{"k":"sf_richter_detail","v":{"s":"Logarithmic. Each +1 magnitude = ~10× amplitude, ~32× energy. M7 releases ~1000× energy of M5."}},{"k":"sf_moment","v":{"s":"Moment magnitude (Mw)"}},{"k":"sf_moment_detail","v":{"s":"Used for modern measurements, especially large quakes. Replaced Richter for M > ~6.5."}},{"k":"sf_mercalli","v":{"s":"Mercalli intensity"}},{"k":"sf_mercalli_detail","v":{"s":"Felt-effects scale (I-XII). What people experienced, not energy released. Same quake = different intensity at different distances."}},{"k":"sf_epicenter","v":{"s":"Locating an epicenter"}},{"k":"sf_epicenter_detail","v":{"s":"3 stations measure P-S arrival-time difference → distance to each → triangulate epicenter."}},{"k":"sf_structure","v":{"s":"Earth's structure (from seismology)"}},{"k":"sf_structure_detail","v":{"s":"P/S wave behavior revealed liquid outer core, solid inner core, mantle, crust. Discontinuities mapped."}},{"k":"sf_tsunami","v":{"s":"Tsunami warning"}},{"k":"sf_tsunami_detail","v":{"s":"Underwater quake → ocean displacement → long-wavelength wave traveling ~700 km/h in deep water. P-wave arrival gives ~minutes warning before tsunami."}},{"k":"sf_largest","v":{"s":"Largest recorded"}},{"k":"sf_largest_detail","v":{"s":"Chile 1960: M9.5 (~32× energy of biggest US quake — 1964 Alaska M9.2). Tsunami crossed Pacific."}},{"k":"ow_wind","v":{"s":"Wind wave (sea)"}},{"k":"ow_wind_notes","v":{"s":"Local wind generated. Variable height + direction."}},{"k":"ow_swell","v":{"s":"Swell"}},{"k":"ow_swell_notes","v":{"s":"Wind waves that have traveled far. Sorted into regular sets."}},{"k":"ow_tsunami","v":{"s":"Tsunami"}},{"k":"ow_tsunami_notes","v":{"s":"Tiny height in deep ocean (<1 m) but VERY long wavelength. Pile up at shore."}},{"k":"ow_tide","v":{"s":"Tide"}},{"k":"ow_tide_notes","v":{"s":"Gravitational pull of Moon + Sun. Bulges in ocean rotate as Earth turns."}},{"k":"ow_seiche","v":{"s":"Seiche"}},{"k":"ow_seiche_notes","v":{"s":"Standing wave in enclosed/semi-enclosed water (lakes, harbors). Triggered by wind, pressure, quakes."}},{"k":"ow_rogue","v":{"s":"Rogue wave"}},{"k":"ow_rogue_notes","v":{"s":"Unusually large (>2× average). Once thought myth, now confirmed; constructive interference of swells."}},{"k":"of_deep","v":{"s":"Deep water"}},{"k":"of_deep_detail","v":{"s":"Depth > λ/2. Wave speed depends only on λ: v = √(gλ/2π)."}},{"k":"of_shallow","v":{"s":"Shallow water"}},{"k":"of_shallow_detail","v":{"s":"Depth < λ/20. Wave speed depends only on depth: v = √(gd). Tsunamis are always shallow-water waves (huge λ)."}},{"k":"of_breaking","v":{"s":"Wave breaking"}},{"k":"of_breaking_detail","v":{"s":"Waves break when amplitude/wavelength > ~1/7. Crest moves faster than trough → tips over."}},{"k":"of_sigheight","v":{"s":"Significant wave height"}},{"k":"of_sigheight_detail","v":{"s":"Average height of tallest 1/3 of waves — better matches what a sailor would call \"the wave height\"."}},{"k":"of_tides","v":{"s":"Spring vs neap tides"}},{"k":"of_tides_detail","v":{"s":"Spring (extreme): Sun + Moon aligned (new/full moon). Neap (mild): Sun + Moon at 90° (quarter moons)."}},{"k":"ant_dipole","v":{"s":"Dipole"}},{"k":"ant_dipole_use","v":{"s":"Simplest resonant antenna. FM radio dipole is ~1.5 m."}},{"k":"ant_yagi","v":{"s":"Yagi-Uda"}},{"k":"ant_yagi_size","v":{"s":"multi-element"}},{"k":"ant_yagi_use","v":{"s":"Directional. Old rooftop TV antennas, ham radio."}},{"k":"ant_dish","v":{"s":"Parabolic dish"}},{"k":"ant_dish_size","v":{"s":"> 10λ for efficient gain"}},{"k":"ant_dish_use","v":{"s":"Satellite TV, radio astronomy, deep-space comm."}},{"k":"ant_patch","v":{"s":"Patch (microstrip)"}},{"k":"ant_patch_use","v":{"s":"GPS, Wi-Fi, phones. Flat, easy to mass-manufacture."}},{"k":"ant_helical","v":{"s":"Helical"}},{"k":"ant_helical_size","v":{"s":"~λ circumference per turn"}},{"k":"ant_helical_use","v":{"s":"Circularly polarized. Satellite uplinks."}},{"k":"ant_loop","v":{"s":"Loop"}},{"k":"ant_loop_size","v":{"s":"fraction of λ"}},{"k":"ant_loop_use","v":{"s":"AM radio receivers, RFID tags."}},{"k":"ant_horn","v":{"s":"Horn"}},{"k":"ant_horn_use","v":{"s":"Radar feeds, microwave links. Broadband."}},{"k":"ant_phased","v":{"s":"Phased array"}},{"k":"ant_phased_size","v":{"s":"matrix of elements"}},{"k":"ant_phased_use","v":{"s":"Steer beam electronically. Modern radar, 5G mmWave, Starlink user terminals."}},{"k":"rs_primary","v":{"s":"Primary radar"}},{"k":"rs_primary_use","v":{"s":"Aircraft detection. Pulse sent → echo measured. Range = c·Δt/2."}},{"k":"rs_doppler","v":{"s":"Doppler radar"}},{"k":"rs_doppler_use","v":{"s":"Weather (rain motion → wind), police speed guns. Frequency shift → velocity."}},{"k":"rs_sar","v":{"s":"Synthetic aperture radar (SAR)"}},{"k":"rs_sar_use","v":{"s":"Moving platform creates effective large aperture. Earth imaging from satellites; works through clouds + at night."}},{"k":"rs_phased","v":{"s":"Phased array radar"}},{"k":"rs_phased_use","v":{"s":"Steerable beam without moving the dish. AEGIS, modern fighters."}},{"k":"rs_active","v":{"s":"Active sonar"}},{"k":"rs_active_use","v":{"s":"Send pulse, listen for echo. Submarine detection, fish-finding. Limited range due to sound absorption."}},{"k":"rs_passive","v":{"s":"Passive sonar"}},{"k":"rs_passive_use","v":{"s":"Listen for sounds from targets. Submarines use this when avoiding detection (no emissions)."}},{"k":"rs_echo","v":{"s":"Echolocation (biological)"}},{"k":"rs_echo_use","v":{"s":"Bats, dolphins. Frequencies up to ~200 kHz (bats); chirps adapted for prey."}},{"k":"rs_ultrasound","v":{"s":"Ultrasound (medical)"}},{"k":"rs_ultrasound_use","v":{"s":"1–20 MHz pulses image internal tissues. Doppler mode shows blood flow."}},{"k":"rs_lidar","v":{"s":"LIDAR"}},{"k":"rs_lidar_use","v":{"s":"Laser pulses → 3D point clouds. Self-driving cars, archaeology (forest-floor mapping)."}},{"k":"shk_mach","v":{"s":"Mach number"}},{"k":"shk_mach_detail","v":{"s":"M = v/v_sound. M<1 subsonic, M=1 transonic, M>1 supersonic, M>5 hypersonic."}},{"k":"shk_boom","v":{"s":"Sonic boom"}},{"k":"shk_boom_detail","v":{"s":"Cone of compressed air trailing supersonic objects. Heard as boom when cone passes you."}},{"k":"shk_cone","v":{"s":"Mach cone angle"}},{"k":"shk_cone_detail","v":{"s":"sin α = 1/M. Faster object → narrower cone."}},{"k":"shk_thickness","v":{"s":"Shock wave thickness"}},{"k":"shk_thickness_detail","v":{"s":"Just a few mean free paths (~micrometers in atmosphere). Steep pressure jump."}},{"k":"shk_speed","v":{"s":"Sound of speed (air, 20°C)"}},{"k":"shk_speed_detail","v":{"s":"343 m/s = 1235 km/h = 767 mph. Increases with temperature: v ≈ 331 + 0.6·T(°C) m/s."}},{"k":"shk_media","v":{"s":"Other media"}},{"k":"shk_media_detail","v":{"s":"Water: ~1480 m/s. Steel: ~5000 m/s. Hotter, denser, stiffer → faster sound."}},{"k":"shk_whip","v":{"s":"Bullwhip crack"}},{"k":"shk_whip_detail","v":{"s":"Tip of whip exceeds Mach 1 → mini sonic boom."}},{"k":"shk_explosion","v":{"s":"Explosion shock wave"}},{"k":"shk_explosion_detail","v":{"s":"Initial pressure jump (overpressure) travels faster than sound, slowing to sound speed with distance."}},{"k":"hist_1665","v":{"s":"First observed diffraction."}},{"k":"hist_1690","v":{"s":"Wave theory of light. Huygens' principle (every point on wavefront is source of secondary wavelets)."}},{"k":"hist_1801","v":{"s":"Double-slit experiment. Established wave nature of light through interference."}},{"k":"hist_1818","v":{"s":"Mathematical theory of diffraction. Predicted (correctly) the \"Poisson spot\" — bright dot in center of circular shadow."}},{"k":"hist_1842","v":{"s":"Doppler effect for sound and light."}},{"k":"hist_1864","v":{"s":"Maxwell's equations — light is electromagnetic wave. Predicted speed = c."}},{"k":"hist_1887","v":{"s":"Produced + detected radio waves in lab. Confirmed Maxwell's prediction."}},{"k":"hist_1900","v":{"s":"E = hf — energy is quantized. Birth of quantum theory."}},{"k":"hist_1905","v":{"s":"Photoelectric effect — light comes in quanta (photons). Nobel 1921."}},{"k":"hist_1924","v":{"s":"Matter waves: λ = h/p. Even electrons are waves."}},{"k":"hist_1927","v":{"s":"Confirmed electron diffraction — proved matter waves."}},{"k":"hist_1960","v":{"s":"First working laser (ruby)."}},{"k":"hist_2015","v":{"s":"First direct detection of gravitational waves (binary black hole merger)."}},{"k":"sec_optics_title","v":{"s":"Optics — lenses, mirrors, and elements"}},{"k":"sec_refraction_title","v":{"s":"Refractive indices"}},{"k":"sec_refraction_intro","v":{"s":"Snell's law: n₁ sin θ₁ = n₂ sin θ₂. Light slows by factor n in material; n is wavelength-dependent (dispersion)."}},{"k":"col_material","v":{"s":"Material"}},{"k":"col_notes","v":{"s":"Notes"}},{"k":"sec_diffraction_intro","v":{"s":"Diffraction = bending of waves around obstacles or through openings. Most noticeable when feature size ≈ wavelength."}},{"k":"sec_quantum_intro","v":{"s":"In quantum mechanics, every particle has wave properties. The \"wave function\" ψ gives probability amplitude."}},{"k":"sec_seismology_essentials","v":{"s":"Seismology essentials"}},{"k":"sec_ocean_wave_types","v":{"s":"Ocean wave types"}},{"k":"sec_wave_physics_water","v":{"s":"Wave physics in water"}},{"k":"sec_antennas_title","v":{"s":"Antenna types"}},{"k":"sec_antennas_intro","v":{"s":"Antenna size typically tied to wavelength. Lower frequency = longer wavelength = bigger antenna."}},{"k":"sec_radar_title","v":{"s":"Radar, sonar, and active ranging"}},{"k":"sec_history_title","v":{"s":"History of wave science"}},{"k":"af_comp_none","v":{"s":"None (lossless)"}},{"k":"af_wav_notes","v":{"s":"Raw uncompressed audio. ~10 MB/min at CD quality. Standard for editing."}},{"k":"af_comp_lossless","v":{"s":"Lossless"}},{"k":"af_flac_notes","v":{"s":"Free Lossless Audio Codec. ~5 MB/min CD quality. Bit-perfect — when decoded, identical to original."}},{"k":"af_alac_notes","v":{"s":"Apple Lossless Audio Codec. Similar to FLAC but Apple-developed."}},{"k":"af_comp_lossy","v":{"s":"Lossy"}},{"k":"af_mp3_notes","v":{"s":"Most common lossy format. 128 kbps = compact but audible artifacts. 320 kbps near-transparent."}},{"k":"af_aac_notes","v":{"s":"Better quality than MP3 at same bitrate. iTunes, YouTube use it."}},{"k":"af_ogg_notes","v":{"s":"Open-source alternative to MP3. Often used in games (Minecraft, Spotify)."}},{"k":"af_opus_notes","v":{"s":"Modern open codec. Excellent at low bitrates (6-510 kbps). Used in WebRTC, Discord, YouTube."}},{"k":"af_comp_lossy_or_lossless","v":{"s":"Lossy or lossless"}},{"k":"af_wma_notes","v":{"s":"Microsoft's codec. Largely abandoned."}},{"k":"af_aiff_notes","v":{"s":"Apple's uncompressed format. Similar to WAV."}},{"k":"af_comp_midi","v":{"s":"Not audio — instructions"}},{"k":"af_midi_notes","v":{"s":"Stores notes + timing, not sound. Player synthesizes. Tiny files."}},{"k":"af_comp_dsd","v":{"s":"PDM (different from PCM)"}},{"k":"af_dsd_notes","v":{"s":"Used for Super Audio CD. 1-bit, very high sample rate (2.8+ MHz)."}},{"k":"ab_phone","v":{"s":"Phone call (G.711)"}},{"k":"ab_phone_notes","v":{"s":"8 kHz sample, narrow band."}},{"k":"ab_opus","v":{"s":"Opus low quality"}},{"k":"ab_opus_notes","v":{"s":"Voice still intelligible."}},{"k":"ab_am","v":{"s":"AM radio quality"}},{"k":"ab_am_notes","v":{"s":"5 kHz bandwidth approximately."}},{"k":"ab_fm","v":{"s":"FM radio quality"}},{"k":"ab_fm_notes","v":{"s":"15 kHz bandwidth approximately."}},{"k":"ab_mp3","v":{"s":"MP3 (web typical)"}},{"k":"ab_mp3_notes","v":{"s":"Acceptable for casual listening. Audible artifacts."}},{"k":"ab_aac","v":{"s":"AAC (Apple Music)"}},{"k":"ab_aac_notes","v":{"s":"Apple Music standard. Better than 128 kbps MP3."}},{"k":"ab_spotify","v":{"s":"Spotify (high)"}},{"k":"ab_spotify_notes","v":{"s":"High-quality lossy. Near-transparent for most."}},{"k":"ab_cd","v":{"s":"CD quality (16-bit/44.1 kHz PCM)"}},{"k":"ab_cd_notes","v":{"s":"Lossless. ~10 MB/min stereo."}},{"k":"ab_dvd","v":{"s":"DVD-Audio (24-bit/96 kHz)"}},{"k":"ab_dvd_notes","v":{"s":"High-resolution audio. Debated whether audible improvement."}},{"k":"ab_studio","v":{"s":"Studio masters (24-bit/192 kHz)"}},{"k":"ab_studio_notes","v":{"s":"Recording standard. Down-converted for distribution."}},{"k":"sec_recordings_title","v":{"s":"Audio formats + quality"}},{"k":"sec_common_formats","v":{"s":"Common audio file formats"}},{"k":"col_format","v":{"s":"Format"}},{"k":"col_extension","v":{"s":"Extension"}},{"k":"col_compression","v":{"s":"Compression"}},{"k":"sec_common_bitrates","v":{"s":"Common bitrates"}},{"k":"col_quality_level","v":{"s":"Quality level"}},{"k":"col_bitrate","v":{"s":"Bitrate"}},{"k":"oi1_name","v":{"s":"Müller-Lyer"}},{"k":"oi1_desc","v":{"s":"Two equal lines with arrowheads — one outward, one inward — appear different lengths."}},{"k":"oi1_expl","v":{"s":"Brain interprets arrows as depth cues. May be culturally-influenced (less effect in some non-Western cultures)."}},{"k":"oi2_name","v":{"s":"Necker cube"}},{"k":"oi2_desc","v":{"s":"Wireframe cube spontaneously \"flips\" which face is in front."}},{"k":"oi2_expl","v":{"s":"Ambiguous projection — brain alternates interpretations. Bistable perception."}},{"k":"oi3_name","v":{"s":"Hermann grid"}},{"k":"oi3_desc","v":{"s":"Black squares on white grid show ghostly gray dots at intersections."}},{"k":"oi3_expl","v":{"s":"Lateral inhibition in retinal cells. Each cell's response depends on neighbors."}},{"k":"oi4_name","v":{"s":"Checker shadow"}},{"k":"oi4_desc","v":{"s":"Two checkerboard squares appear different shades but are identical."}},{"k":"oi4_expl","v":{"s":"Adelson's classic. Brain corrects for perceived shadow → \"constancy\" overrides actual luminance."}},{"k":"oi5_name","v":{"s":"Ponzo illusion"}},{"k":"oi5_desc","v":{"s":"Two identical lines, one near converging rails, appear different lengths."}},{"k":"oi5_expl","v":{"s":"Brain treats converging lines as depth — \"farther\" object must be bigger to project same size on retina."}},{"k":"oi6_name","v":{"s":"Café wall"}},{"k":"oi6_desc","v":{"s":"Parallel rows of alternating black/white tiles appear sloped."}},{"k":"oi6_expl","v":{"s":"Offset between rows creates perceived tilt. Studied at café walls in Bristol."}},{"k":"oi7_name","v":{"s":"Rotating snakes (Kitaoka)"}},{"k":"oi7_desc","v":{"s":"Static image of circles appears to rotate."}},{"k":"oi7_expl","v":{"s":"Motion-sensitive cells respond differently to varying luminance, creating illusory motion in peripheral vision."}},{"k":"oi8_name","v":{"s":"Spinning dancer (silhouette)"}},{"k":"oi8_desc","v":{"s":"Dancer appears to spin clockwise or counterclockwise."}},{"k":"oi8_expl","v":{"s":"Ambiguous silhouette has no depth cues. Brain locks in an interpretation — can sometimes be switched."}},{"k":"oi9_name","v":{"s":"The dress (2015 viral)"}},{"k":"oi9_desc","v":{"s":"Photo of dress appeared blue/black to some, white/gold to others."}},{"k":"oi9_expl","v":{"s":"Different brains assume different illumination (daylight vs incandescent) → \"color constancy\" leads to different perceptions."}},{"k":"oi10_name","v":{"s":"Mach bands"}},{"k":"oi10_desc","v":{"s":"Sharp luminance edges appear to have over/undershoot bands."}},{"k":"oi10_expl","v":{"s":"Lateral inhibition in retina enhances edges. Helps with object recognition but creates artifact at edges."}},{"k":"oi11_name","v":{"s":"Stroboscopic effect"}},{"k":"oi11_desc","v":{"s":"Wheels appear to spin backward in movies."}},{"k":"oi11_expl","v":{"s":"Frame rate samples motion — when wheel completes nearly full rotation per frame, looks like slight reverse motion."}},{"k":"oi12_name","v":{"s":"Phantom limb"}},{"k":"oi12_desc","v":{"s":"Amputees feel sensations from missing limb."}},{"k":"oi12_expl","v":{"s":"Brain map of body remains. Mirror therapy (Ramachandran) sometimes helps."}},{"k":"oi13_name","v":{"s":"Persistence of vision"}},{"k":"oi13_desc","v":{"s":"Why movies (24+ fps) appear as continuous motion."}},{"k":"oi13_expl","v":{"s":"Retinal afterimage + brain interpolation. Below ~16 fps flicker is visible."}},{"k":"oi14_name","v":{"s":"Color afterimage"}},{"k":"oi14_desc","v":{"s":"Stare at red for 30s → look at white → see green afterimage."}},{"k":"oi14_expl","v":{"s":"Cone receptors fatigue; complementary color signal dominates briefly when you look away."}},{"k":"oi15_name","v":{"s":"Blind spot"}},{"k":"oi15_desc","v":{"s":"Each eye has a small region where you don't see."}},{"k":"oi15_expl","v":{"s":"Where optic nerve leaves retina — no photoreceptors. Brain fills in. Both eyes together compensate."}},{"k":"oi16_name","v":{"s":"Anaglyph (red/cyan 3D)"}},{"k":"oi16_desc","v":{"s":"Glasses with red + cyan lenses create 3D from flat image."}},{"k":"oi16_expl","v":{"s":"Each eye sees different-colored image → brain fuses into 3D."}},{"k":"oi17_name","v":{"s":"Magic Eye / autostereogram"}},{"k":"oi17_desc","v":{"s":"Cross-eye to see hidden 3D image."}},{"k":"oi17_expl","v":{"s":"Repeating pattern, each row offset slightly. Brain matches wrong elements → perceived depth."}},{"k":"oi18_name","v":{"s":"Doppler shift in sound"}},{"k":"oi18_desc","v":{"s":"Siren of approaching vehicle sounds higher than receding."}},{"k":"oi18_expl","v":{"s":"Compressed waves coming, stretched waves going. f' = f × (v_sound ± v_observer) / (v_sound ∓ v_source)."}},{"k":"oi19_name","v":{"s":"Sonic boom"}},{"k":"oi19_desc","v":{"s":"Loud bang when supersonic object passes."}},{"k":"oi19_expl","v":{"s":"Pressure cone of compressed air. Boom not heard until cone reaches you."}},{"k":"oi20_name","v":{"s":"Mirage (highway shimmer)"}},{"k":"oi20_desc","v":{"s":"Distant road appears wet on hot day."}},{"k":"oi20_expl","v":{"s":"Hot air near road has lower n than cooler air above → refracts sky light to your eye. Same physics for desert mirages."}},{"k":"oi21_name","v":{"s":"Rainbow"}},{"k":"oi21_desc","v":{"s":"42° arc from anti-solar point."}},{"k":"oi21_expl","v":{"s":"Sunlight refracts entering water droplet, reflects off back, refracts again leaving. Different λ at different angles."}},{"k":"oi22_name","v":{"s":"Double rainbow"}},{"k":"oi22_desc","v":{"s":"Second, dimmer rainbow with reversed colors at ~51°."}},{"k":"oi22_expl","v":{"s":"Two internal reflections in droplets. Less light → dimmer. Reverse order."}},{"k":"oi23_name","v":{"s":"Halo around moon/sun"}},{"k":"oi23_desc","v":{"s":"22° halo around sun or moon."}},{"k":"oi23_expl","v":{"s":"Ice crystals in high cirrus refract light. Often precedes weather change."}},{"k":"oi24_name","v":{"s":"Green flash at sunset"}},{"k":"oi24_desc","v":{"s":"Brief green flash as sun dips below horizon."}},{"k":"oi24_expl","v":{"s":"Atmospheric refraction separates colors at moment of sunset. Best seen over ocean."}},{"k":"sec_optical_facts_title","v":{"s":"Optical illusions + perception phenomena"}},{"k":"sec_optical_facts_intro","v":{"s":"Visual perception is active — brain interprets, fills in gaps, makes guesses. Illusions reveal the underlying processes."}},{"k":"ds_light_vacuum","v":{"s":"Speed of light (vacuum)"}},{"k":"ds_light_vacuum_notes","v":{"s":"Universal speed limit. Defined exact."}},{"k":"ds_light_air","v":{"s":"Speed of light (air)"}},{"k":"ds_light_air_notes","v":{"s":"Air refractive index ~1.0003."}},{"k":"ds_light_water","v":{"s":"Speed of light (water)"}},{"k":"ds_light_glass","v":{"s":"Speed of light (glass)"}},{"k":"ds_light_diamond","v":{"s":"Speed of light (diamond)"}},{"k":"ds_light_diamond_notes","v":{"s":"n = 2.42 — highest of common materials."}},{"k":"ds_cherenkov","v":{"s":"Cherenkov radiation threshold (water)"}},{"k":"ds_cherenkov_notes","v":{"s":"Particles faster than light-in-medium emit blue glow (Cherenkov)."}},{"k":"ds_sound_air0","v":{"s":"Sound in air at 0°C"}},{"k":"ds_sound_air0_notes","v":{"s":"Cold air, dry, sea level."}},{"k":"ds_sound_air20","v":{"s":"Sound in air at 20°C"}},{"k":"ds_sound_air20_notes","v":{"s":"Reference room temp."}},{"k":"ds_sound_air40","v":{"s":"Sound in air at 40°C"}},{"k":"ds_sound_air40_notes","v":{"s":"Hot day."}},{"k":"ds_sound_helium","v":{"s":"Sound in helium (RT)"}},{"k":"ds_sound_helium_notes","v":{"s":"~3× air → voice an octave higher."}},{"k":"ds_sound_co2","v":{"s":"Sound in CO₂ (RT)"}},{"k":"ds_sound_co2_notes","v":{"s":"Slower than air → voice lower."}},{"k":"ds_sound_water","v":{"s":"Sound in water (RT)"}},{"k":"ds_sound_water_notes","v":{"s":"Whales use long-distance communication."}},{"k":"ds_sound_seawater","v":{"s":"Sound in seawater"}},{"k":"ds_sound_seawater_notes","v":{"s":"Slightly different due to salts."}},{"k":"ds_sound_ice","v":{"s":"Sound in ice"}},{"k":"ds_sound_ice_notes","v":{"s":"Stiff solid."}},{"k":"ds_sound_granite","v":{"s":"Sound in granite"}},{"k":"ds_sound_granite_notes","v":{"s":"Hard rock."}},{"k":"ds_sound_steel","v":{"s":"Sound in steel"}},{"k":"ds_sound_steel_notes","v":{"s":"Train tracks carry sound far before train arrives."}},{"k":"ds_sound_aluminum","v":{"s":"Sound in aluminum"}},{"k":"ds_sound_aluminum_notes","v":{"s":"Light + stiff."}},{"k":"ds_sound_diamond","v":{"s":"Sound in diamond"}},{"k":"ds_sound_diamond_notes","v":{"s":"Fastest in common materials."}},{"k":"ds_sound_beryllium","v":{"s":"Sound in beryllium"}},{"k":"ds_sound_beryllium_notes","v":{"s":"Fastest in pure elements at standard conditions."}},{"k":"ds_pwave","v":{"s":"P-wave in upper mantle"}},{"k":"ds_pwave_notes","v":{"s":"Earthquake primary waves."}},{"k":"ds_swave","v":{"s":"S-wave in upper mantle"}},{"k":"ds_swave_notes","v":{"s":"Earthquake secondary waves."}},{"k":"ds_tsunami_deep","v":{"s":"Tsunami in deep ocean"}},{"k":"ds_tsunami_deep_notes","v":{"s":"Long wavelength shallow-water wave."}},{"k":"ds_tsunami_shore","v":{"s":"Tsunami in shore approach"}},{"k":"ds_tsunami_shore_notes","v":{"s":"Slows + grows as depth decreases."}},{"k":"ds_ripple","v":{"s":"Surface ripple on water"}},{"k":"ds_ripple_speed","v":{"s":"depends on λ"}},{"k":"ds_ripple_notes","v":{"s":"Short wavelengths controlled by surface tension; long by gravity."}},{"k":"ds_body","v":{"s":"Sound in human body (avg tissue)"}},{"k":"ds_body_notes","v":{"s":"Used for medical ultrasound timing."}},{"k":"ds_bone","v":{"s":"Sound in bone"}},{"k":"ds_bone_notes","v":{"s":"Faster than soft tissue."}},{"k":"ds_lung","v":{"s":"Sound in lung tissue"}},{"k":"ds_lung_notes","v":{"s":"Air pockets slow it. Why lungs poorly imaged by ultrasound."}},{"k":"ds_thunder","v":{"s":"Lightning thunder rule of thumb"}},{"k":"ds_thunder_speed","v":{"s":"5 sec per mile / 3 sec per km"}},{"k":"ds_thunder_notes","v":{"s":"Count seconds between flash + thunder."}},{"k":"cl_8mm","v":{"s":"8mm fisheye"}},{"k":"cl_8mm_use","v":{"s":"Hemispheric panoramas, sky time-lapse, security cameras."}},{"k":"cl_14mm","v":{"s":"14mm ultrawide"}},{"k":"cl_14mm_use","v":{"s":"Tight indoor architecture, dramatic landscape."}},{"k":"cl_20mm","v":{"s":"20mm ultrawide"}},{"k":"cl_20mm_use","v":{"s":"Astrophotography, group photos in tight space."}},{"k":"cl_24mm","v":{"s":"24mm wide-angle"}},{"k":"cl_24mm_use","v":{"s":"Landscape, real estate, environmental portraits."}},{"k":"cl_28mm","v":{"s":"28mm wide"}},{"k":"cl_28mm_use","v":{"s":"Street photography, photojournalism."}},{"k":"cl_35mm","v":{"s":"35mm wide"}},{"k":"cl_35mm_use","v":{"s":"Documentary, candid. \"Storyteller's lens\"."}},{"k":"cl_50mm","v":{"s":"50mm normal"}},{"k":"cl_50mm_use","v":{"s":"Closest to human eye perspective. \"Nifty fifty\". Portraits."}},{"k":"cl_85mm","v":{"s":"85mm short telephoto"}},{"k":"cl_85mm_use","v":{"s":"Portraits. Pleasing background compression."}},{"k":"cl_105mm","v":{"s":"105mm portrait"}},{"k":"cl_105mm_use","v":{"s":"Tight portraits. Macro variants for close-up."}},{"k":"cl_135mm","v":{"s":"135mm"}},{"k":"cl_135mm_use","v":{"s":"Outdoor portraits, candids from distance."}},{"k":"cl_200mm","v":{"s":"200mm telephoto"}},{"k":"cl_200mm_use","v":{"s":"Sports, wildlife, distant subjects."}},{"k":"cl_300mm","v":{"s":"300mm telephoto"}},{"k":"cl_300mm_use","v":{"s":"Sports field-side, bird photography."}},{"k":"cl_400mm","v":{"s":"400mm super-tele"}},{"k":"cl_400mm_use","v":{"s":"Wildlife, sports. Heavy + expensive."}},{"k":"cl_600mm","v":{"s":"600mm super-tele"}},{"k":"cl_600mm_use","v":{"s":"Distant wildlife, moon. Requires tripod."}},{"k":"cl_800mm","v":{"s":"800mm super-tele"}},{"k":"cl_800mm_use","v":{"s":"Specialized wildlife + astronomy."}},{"k":"cl_1200mm","v":{"s":"1200mm + teleconverter"}},{"k":"cl_1200mm_use","v":{"s":"Extreme reach. Solar eclipse details."}},{"k":"cl_macro","v":{"s":"Macro 100mm"}},{"k":"cl_macro_use","v":{"s":"Insects, flowers, product. 1:1 magnification."}},{"k":"cl_tiltshift","v":{"s":"Tilt-shift 24mm"}},{"k":"cl_tiltshift_fov","v":{"s":"~84° normal, controllable"}},{"k":"cl_tiltshift_use","v":{"s":"Architecture (keep verticals straight), miniature faking."}},{"k":"cl_anamorphic","v":{"s":"Cinema anamorphic 50mm"}},{"k":"cl_anamorphic_fov","v":{"s":"wider horizontally than spherical"}},{"k":"cl_anamorphic_use","v":{"s":"Cinematic look. Oval bokeh, lens flares."}},{"k":"cf_crop","v":{"s":"Crop factor"}},{"k":"cf_crop_detail","v":{"s":"Smaller sensors crop image. APS-C ~1.5×, Micro 4/3 ~2×, smartphone ~5-7×."}},{"k":"cf_efl","v":{"s":"Effective focal length"}},{"k":"cf_efl_detail","v":{"s":"50mm lens on APS-C looks like 75mm on full frame. Doesn't change actual focal length, just FOV."}},{"k":"cf_fstop","v":{"s":"f-stop"}},{"k":"cf_fstop_detail","v":{"s":"Ratio of focal length to aperture diameter. f/1.4, f/2, f/2.8, f/4, f/5.6, f/8 (each step halves light)."}},{"k":"cf_dof","v":{"s":"Depth of field"}},{"k":"cf_dof_detail","v":{"s":"Wider aperture (smaller f number) → shallower DOF. Why portraits use f/1.8-f/2.8 for soft backgrounds."}},{"k":"cf_shutter","v":{"s":"Shutter speed for handheld"}},{"k":"cf_shutter_detail","v":{"s":"Rule: at least 1/focal-length sec. 50mm → 1/50 or faster. Stabilization helps."}},{"k":"cf_sensors","v":{"s":"Sensor sizes"}},{"k":"cf_sensors_detail","v":{"s":"Full frame (36×24mm) > APS-H > APS-C > Micro 4/3 > 1\" > phone sensors (~1/2\" - 1/3\")."}},{"k":"cf_megapixels","v":{"s":"Megapixels"}},{"k":"cf_megapixels_detail","v":{"s":"More pixels = more detail (with good lens). Diminishing returns past ~24-50 MP for most uses."}},{"k":"cf_iso","v":{"s":"ISO"}},{"k":"cf_iso_detail","v":{"s":"Sensor sensitivity. Higher ISO = brighter image but more noise. Base ISO (lowest noise) typically 100-200."}},{"k":"sec_speeds2_title","v":{"s":"Wave speeds in detail"}},{"k":"col_wave_medium","v":{"s":"Wave + medium"}},{"k":"col_speed","v":{"s":"Speed"}},{"k":"sec_cameras_title","v":{"s":"Camera lenses + photography"}},{"k":"sec_lens_focal_lengths","v":{"s":"Lens focal lengths (35mm full-frame)"}},{"k":"col_lens","v":{"s":"Lens"}},{"k":"col_fov","v":{"s":"Field of view"}},{"k":"col_use","v":{"s":"Use"}},{"k":"sec_photography_essentials","v":{"s":"Photography essentials"}},{"k":"star_sun","v":{"s":"Sun"}},{"k":"star_sun_type","v":{"s":"G2V (yellow dwarf)"}},{"k":"star_sun_notes","v":{"s":"Our nearest star. Apparent peak ~480 nm (blue-green) but we see it yellow due to atmospheric scattering."}},{"k":"star_proxima","v":{"s":"Proxima Centauri"}},{"k":"star_proxima_type","v":{"s":"M5.5 (red dwarf)"}},{"k":"star_proxima_notes","v":{"s":"Nearest known star. Has planets including Proxima b in habitable zone."}},{"k":"star_sirius","v":{"s":"Sirius A"}},{"k":"star_sirius_type","v":{"s":"A1V (white)"}},{"k":"star_sirius_notes","v":{"s":"Brightest in night sky. Binary with white-dwarf Sirius B."}},{"k":"star_betelgeuse","v":{"s":"Betelgeuse"}},{"k":"star_betelgeuse_type","v":{"s":"M1-2 (red supergiant)"}},{"k":"star_betelgeuse_notes","v":{"s":"Orion's shoulder. Variable. Could go supernova \"soon\" (anytime in next ~100,000 yr)."}},{"k":"star_rigel","v":{"s":"Rigel"}},{"k":"star_rigel_type","v":{"s":"B8I (blue supergiant)"}},{"k":"star_rigel_notes","v":{"s":"Orion's foot. Triple star system."}},{"k":"star_vega","v":{"s":"Vega"}},{"k":"star_vega_type","v":{"s":"A0V (white)"}},{"k":"star_vega_notes","v":{"s":"Was once \"the\" North Star. Will be again in ~13,727 CE (precession of equinoxes)."}},{"k":"star_polaris","v":{"s":"Polaris"}},{"k":"star_polaris_type","v":{"s":"F7Ib (yellow supergiant)"}},{"k":"star_polaris_notes","v":{"s":"Current North Star. Within ~0.5° of celestial north."}},{"k":"star_aldebaran","v":{"s":"Aldebaran"}},{"k":"star_aldebaran_type","v":{"s":"K5III (orange giant)"}},{"k":"star_aldebaran_notes","v":{"s":"Eye of Taurus. Reddish-orange."}},{"k":"star_antares","v":{"s":"Antares"}},{"k":"star_antares_type","v":{"s":"M1.5Iab (red supergiant)"}},{"k":"star_antares_notes","v":{"s":"Heart of Scorpius. Diameter ~700× Sun."}},{"k":"star_procyon","v":{"s":"Procyon"}},{"k":"star_procyon_type","v":{"s":"F5IV (yellow-white)"}},{"k":"star_procyon_notes","v":{"s":"Eighth brightest star. Binary."}},{"k":"star_capella","v":{"s":"Capella"}},{"k":"star_capella_type","v":{"s":"G3III + G0III (yellow giants)"}},{"k":"star_capella_notes","v":{"s":"Sixth brightest. Two pairs (4 stars)."}},{"k":"star_spica","v":{"s":"Spica"}},{"k":"star_spica_type","v":{"s":"B1III-IV (blue giant)"}},{"k":"star_spica_notes","v":{"s":"Brightest in Virgo. Binary."}},{"k":"star_eta","v":{"s":"Eta Carinae"}},{"k":"star_eta_type","v":{"s":"LBV (luminous blue variable)"}},{"k":"star_eta_notes","v":{"s":"Massive (90 M☉ + companion). Erupted dramatically in 1840s. Likely future supernova/hypernova."}},{"k":"star_uy","v":{"s":"UY Scuti"}},{"k":"star_uy_type","v":{"s":"M4Ia (red hypergiant)"}},{"k":"star_uy_notes","v":{"s":"Among largest known stars. Diameter ~1700× Sun."}},{"k":"scr_crt","v":{"s":"CRT (cathode ray tube)"}},{"k":"scr_crt_notes","v":{"s":"Electron beam scans phosphors. Largely obsolete since ~2010."}},{"k":"scr_lcd","v":{"s":"LCD (liquid crystal display)"}},{"k":"scr_lcd_notes","v":{"s":"LCs modulate backlight. Energy-efficient. Limited viewing angles."}},{"k":"scr_oled","v":{"s":"OLED (organic LED)"}},{"k":"scr_oled_notes","v":{"s":"Each pixel emits own light. True blacks. Premium phones, TVs."}},{"k":"scr_microled","v":{"s":"micro-LED"}},{"k":"scr_microled_notes","v":{"s":"Like OLED but inorganic LEDs. Brighter, longer-lived. Expensive (~2025)."}},{"k":"scr_plasma","v":{"s":"Plasma"}},{"k":"scr_plasma_refresh","v":{"s":"60 Hz typical"}},{"k":"scr_plasma_notes","v":{"s":"Excited gas emits UV → phosphors. Discontinued ~2014."}},{"k":"scr_eink","v":{"s":"E-ink"}},{"k":"scr_eink_refresh","v":{"s":"on update"}},{"k":"scr_eink_notes","v":{"s":"Microcapsules with charged particles. No backlight needed. E-readers."}},{"k":"scr_dlp","v":{"s":"Projector (DLP)"}},{"k":"scr_varies","v":{"s":"varies"}},{"k":"scr_dlp_notes","v":{"s":"Micromirror array. Color via spinning wheel or 3 chips."}},{"k":"scr_lcdproj","v":{"s":"Projector (LCD)"}},{"k":"scr_lcdproj_notes","v":{"s":"3 LCD panels (RGB). Common in classrooms."}},{"k":"scr_laser","v":{"s":"Laser projector"}},{"k":"scr_laser_notes","v":{"s":"RGB lasers, no lamp replacement. Wide color gamut."}},{"k":"res_480_notes","v":{"s":"Standard definition."}},{"k":"res_720_notes","v":{"s":"Cable TV, older laptops."}},{"k":"res_1080_notes","v":{"s":"Most TVs + phones for a decade."}},{"k":"res_2k_notes","v":{"s":"High-end monitors."}},{"k":"res_4k_notes","v":{"s":"Now standard for new TVs."}},{"k":"res_5k_notes","v":{"s":"Apple iMac 5K, pro monitors."}},{"k":"res_8k_notes","v":{"s":"Premium TVs. Limited content."}},{"k":"res_dci4k_notes","v":{"s":"Cinema standard."}},{"k":"res_16k_notes","v":{"s":"Not commercially available."}},{"k":"nl_threshold","v":{"s":"Threshold of hearing"}},{"k":"nl_threshold_notes","v":{"s":"Quietest sound a young healthy ear can detect."}},{"k":"nl_whisper","v":{"s":"Whisper at 1 m"}},{"k":"nl_whisper_notes","v":{"s":"Library."}},{"k":"nl_quiet","v":{"s":"Quiet room"}},{"k":"nl_quiet_notes","v":{"s":"Empty house at night."}},{"k":"nl_conversation","v":{"s":"Normal conversation"}},{"k":"nl_conversation_notes","v":{"s":"At 1 m."}},{"k":"nl_vacuum","v":{"s":"Vacuum cleaner"}},{"k":"nl_vacuum_notes","v":{"s":"Most household appliances."}},{"k":"nl_traffic","v":{"s":"Heavy traffic"}},{"k":"nl_traffic_notes","v":{"s":"Long exposure can cause hearing damage."}},{"k":"nl_mower","v":{"s":"Lawn mower"}},{"k":"nl_mower_notes","v":{"s":"85 dB = OSHA action level (hearing conservation required)."}},{"k":"nl_subway","v":{"s":"Subway train"}},{"k":"nl_subway_notes","v":{"s":"Pain threshold for prolonged exposure."}},{"k":"nl_powertools","v":{"s":"Power tools (chainsaw)"}},{"k":"nl_powertools_notes","v":{"s":"Hearing protection essential."}},{"k":"nl_concert","v":{"s":"Rock concert / club"}},{"k":"nl_concert_notes","v":{"s":"Permanent damage in minutes."}},{"k":"nl_pain","v":{"s":"Threshold of pain"}},{"k":"nl_pain_notes","v":{"s":"Physically painful."}},{"k":"nl_jet","v":{"s":"Jet engine at 30 m"}},{"k":"nl_jet_notes","v":{"s":"Instant hearing damage."}},{"k":"nl_gunshot","v":{"s":"Gunshot"}},{"k":"nl_gunshot_notes","v":{"s":"Permanent damage possible from single exposure."}},{"k":"nl_rocket","v":{"s":"Rocket launch at 100 m"}},{"k":"nl_rocket_notes","v":{"s":"Causes hearing damage + can damage equipment."}},{"k":"nl_krakatoa","v":{"s":"Krakatoa eruption (1883)"}},{"k":"nl_krakatoa_notes","v":{"s":"Possibly loudest sound in modern history. Heard 3000 miles away."}},{"k":"sec_stars_title","v":{"s":"Notable stars (visible spectra)"}},{"k":"sec_stars_intro","v":{"s":"Star color reflects surface temperature: red coolest (~3,000 K) → orange → yellow → white → blue hottest (~30,000+ K). Spectral types O-B-A-F-G-K-M."}},{"k":"sec_tvfreq_title","v":{"s":"Display technologies + resolutions"}},{"k":"sec_display_types","v":{"s":"Display types"}},{"k":"sec_standard_resolutions","v":{"s":"Standard resolutions"}},{"k":"sec_noise_title","v":{"s":"Sound levels (dB SPL)"}},{"k":"sec_noise_intro","v":{"s":"Decibels are logarithmic: +10 dB ≈ 10× sound intensity but ~2× perceived loudness. Sustained exposure >85 dB damages hearing."}},{"k":"col_source","v":{"s":"Source"}},{"k":"col_level","v":{"s":"Level"}},{"k":"ah_human_young","v":{"s":"Human (young)"}},{"k":"ah_human_young_notes","v":{"s":"Upper limit drops with age; adults often only ~14-16 kHz."}},{"k":"ah_human_elderly","v":{"s":"Human (elderly)"}},{"k":"ah_human_elderly_notes","v":{"s":"Presbycusis — gradual high-frequency loss after age ~50."}},{"k":"ah_dog","v":{"s":"Dog"}},{"k":"ah_dog_notes","v":{"s":"Dog whistles at 20-25 kHz inaudible to humans."}},{"k":"ah_cat","v":{"s":"Cat"}},{"k":"ah_cat_notes","v":{"s":"Wide range. Sensitive to mouse squeaks."}},{"k":"ah_bat","v":{"s":"Bat (echolocation)"}},{"k":"ah_bat_notes","v":{"s":"Chirp out + listen. Some species at 100+ kHz."}},{"k":"ah_dolphin","v":{"s":"Dolphin"}},{"k":"ah_dolphin_notes","v":{"s":"Echolocate underwater; clicks up to 200 kHz."}},{"k":"ah_whale","v":{"s":"Whale (baleen)"}},{"k":"ah_whale_notes","v":{"s":"Use infrasound (low freq) for very long-distance communication."}},{"k":"ah_elephant","v":{"s":"Elephant"}},{"k":"ah_elephant_notes","v":{"s":"Infrasonic rumbles travel miles. Use for long-range communication."}},{"k":"ah_mouse","v":{"s":"Mouse"}},{"k":"ah_mouse_notes","v":{"s":"Ultrasonic vocalizations."}},{"k":"ah_bird","v":{"s":"Bird (chicken)"}},{"k":"ah_bird_notes","v":{"s":"Narrower range than mammals. Used in cock crow."}},{"k":"ah_owl","v":{"s":"Owl"}},{"k":"ah_owl_notes","v":{"s":"Asymmetric ears for precise location of prey rustles."}},{"k":"ah_moth","v":{"s":"Moth"}},{"k":"ah_moth_notes","v":{"s":"Hear bat echolocation — drop to evade."}},{"k":"ah_fish","v":{"s":"Fish (most)"}},{"k":"ah_fish_notes","v":{"s":"Use lateral line for water vibrations + ears for sound."}},{"k":"ah_cricket","v":{"s":"Cricket"}},{"k":"ah_cricket_notes","v":{"s":"Ears on legs! Tympanic organs near \"knee\"."}},{"k":"if_piano","v":{"s":"Piano"}},{"k":"if_piano_notes","v":{"s":"Widest range of standard orchestral instruments."}},{"k":"if_violin","v":{"s":"Violin"}},{"k":"if_violin_notes","v":{"s":"Highest pitch of orchestral strings."}},{"k":"if_viola","v":{"s":"Viola"}},{"k":"if_viola_notes","v":{"s":"Pitched fifth below violin."}},{"k":"if_cello","v":{"s":"Cello"}},{"k":"if_cello_notes","v":{"s":"Pitched octave below viola."}},{"k":"if_bass","v":{"s":"Double bass"}},{"k":"if_bass_notes","v":{"s":"Lowest of standard orchestral strings."}},{"k":"if_guitar","v":{"s":"Guitar (standard tuning)"}},{"k":"if_guitar_notes","v":{"s":"EADGBE strings. Range varies with frets."}},{"k":"if_bassguitar","v":{"s":"Bass guitar"}},{"k":"if_bassguitar_notes","v":{"s":"Octave below standard guitar (4-string)."}},{"k":"if_flute","v":{"s":"Flute"}},{"k":"if_flute_notes","v":{"s":"Highest standard woodwind."}},{"k":"if_clarinet","v":{"s":"Clarinet (Bb)"}},{"k":"if_clarinet_notes","v":{"s":"Wide range. Distinctive timbre via odd harmonics."}},{"k":"if_oboe","v":{"s":"Oboe"}},{"k":"if_oboe_notes","v":{"s":"Reedy tone. Tunes the orchestra (its A is hardest to adjust)."}},{"k":"if_bassoon","v":{"s":"Bassoon"}},{"k":"if_bassoon_notes","v":{"s":"Lowest standard woodwind."}},{"k":"if_trumpet","v":{"s":"Trumpet"}},{"k":"if_trumpet_notes","v":{"s":"Highest standard brass."}},{"k":"if_trombone","v":{"s":"Trombone"}},{"k":"if_trombone_notes","v":{"s":"Slide changes pitch — continuous glissando possible."}},{"k":"if_frenchhorn","v":{"s":"French horn"}},{"k":"if_frenchhorn_notes","v":{"s":"Wide tonal range; difficult to control."}},{"k":"if_tuba","v":{"s":"Tuba"}},{"k":"if_tuba_notes","v":{"s":"Lowest brass."}},{"k":"if_soprano","v":{"s":"Voice (soprano)"}},{"k":"if_soprano_notes","v":{"s":"Highest female voice type."}},{"k":"if_alto","v":{"s":"Voice (alto)"}},{"k":"if_alto_notes","v":{"s":"Lower female voice."}},{"k":"if_tenor","v":{"s":"Voice (tenor)"}},{"k":"if_tenor_notes","v":{"s":"Highest male voice."}},{"k":"if_baritone","v":{"s":"Voice (baritone)"}},{"k":"if_baritone_notes","v":{"s":"Most common male voice."}},{"k":"if_bassvoice","v":{"s":"Voice (bass)"}},{"k":"if_bassvoice_notes","v":{"s":"Lowest standard voice."}},{"k":"if_kick","v":{"s":"Drum kit (kick)"}},{"k":"if_kick_fund","v":{"s":"low rumble"}},{"k":"if_kick_notes","v":{"s":"Felt as much as heard."}},{"k":"if_snare","v":{"s":"Drum kit (snare)"}},{"k":"if_snare_fund","v":{"s":"sharp attack"}},{"k":"if_snare_notes","v":{"s":"Wires (snares) add high-frequency rattle."}},{"k":"if_cymbal","v":{"s":"Cymbal (crash)"}},{"k":"if_cymbal_fund","v":{"s":"inharmonic"}},{"k":"if_cymbal_notes","v":{"s":"Not tonally pitched — many frequencies together."}},{"k":"rb_elf","v":{"s":"ELF (extremely low)"}},{"k":"rb_elf_use","v":{"s":"Submarine communication (penetrates water)."}},{"k":"rb_slf","v":{"s":"SLF (super low)"}},{"k":"rb_slf_use","v":{"s":"Submarines, AC power harmonics."}},{"k":"rb_ulf","v":{"s":"ULF (ultra low)"}},{"k":"rb_ulf_use","v":{"s":"Mine communication, geophysics."}},{"k":"rb_vlf","v":{"s":"VLF (very low)"}},{"k":"rb_vlf_use","v":{"s":"Submarine comms, navigation beacons."}},{"k":"rb_lf","v":{"s":"LF (low)"}},{"k":"rb_lf_use","v":{"s":"AM longwave radio (Europe), time signals (WWVB), aircraft navigation."}},{"k":"rb_mf","v":{"s":"MF (medium)"}},{"k":"rb_mf_use","v":{"s":"AM broadcast radio (525-1705 kHz)."}},{"k":"rb_hf","v":{"s":"HF (high)"}},{"k":"rb_hf_use","v":{"s":"Shortwave radio, ham radio. Reflects off ionosphere → global propagation."}},{"k":"rb_vhf","v":{"s":"VHF (very high)"}},{"k":"rb_vhf_use","v":{"s":"FM radio (88-108 MHz), TV channels 2-13, air traffic, weather radio."}},{"k":"rb_uhf","v":{"s":"UHF (ultra high)"}},{"k":"rb_uhf_use","v":{"s":"TV channels 14+, cellular (700 MHz - 2.6 GHz), Wi-Fi 2.4 GHz, microwave ovens."}},{"k":"rb_shf","v":{"s":"SHF (super high)"}},{"k":"rb_shf_use","v":{"s":"Wi-Fi 5/6 GHz, satellite TV, radar."}},{"k":"rb_ehf","v":{"s":"EHF (extremely high)"}},{"k":"rb_ehf_use","v":{"s":"5G mmWave, automotive radar, radio astronomy."}},{"k":"rb_thf","v":{"s":"THF (terahertz)"}},{"k":"rb_thf_use","v":{"s":"Research band. Some imaging applications (terahertz cameras)."}},{"k":"nc_black","v":{"s":"Black"}},{"k":"nc_black_notes","v":{"s":"Absence of light. Truest black possible."}},{"k":"nc_white","v":{"s":"White"}},{"k":"nc_all_visible","v":{"s":"all visible"}},{"k":"nc_white_notes","v":{"s":"All wavelengths reflected equally."}},{"k":"nc_red","v":{"s":"Red"}},{"k":"nc_red_notes","v":{"s":"Lowest energy visible."}},{"k":"nc_orange","v":{"s":"Orange"}},{"k":"nc_orange_notes","v":{"s":"Between red + yellow."}},{"k":"nc_yellow","v":{"s":"Yellow"}},{"k":"nc_yellow_notes","v":{"s":"Brightest perceived color (peak human sensitivity)."}},{"k":"nc_green","v":{"s":"Green"}},{"k":"nc_green_notes","v":{"s":"Most abundant in nature (chlorophyll reflects)."}},{"k":"nc_cyan","v":{"s":"Cyan"}},{"k":"nc_cyan_notes","v":{"s":"Halfway between blue + green."}},{"k":"nc_blue","v":{"s":"Blue"}},{"k":"nc_blue_notes","v":{"s":"Scattered most by atmosphere → blue sky."}},{"k":"nc_magenta","v":{"s":"Magenta"}},{"k":"nc_not_single","v":{"s":"not a single λ"}},{"k":"nc_magenta_notes","v":{"s":"Brain perceives red+blue without green. Has no monochromatic wavelength."}},{"k":"nc_violet","v":{"s":"Violet"}},{"k":"nc_violet_notes","v":{"s":"Highest energy visible. Beyond is UV."}},{"k":"nc_pink","v":{"s":"Pink"}},{"k":"nc_pink_notes","v":{"s":"Tint of red. Lots of cultural meaning."}},{"k":"nc_brown","v":{"s":"Brown"}},{"k":"nc_brown_notes","v":{"s":"Dark orange/red. No \"brown\" wavelength exists — perceptual color only."}},{"k":"nc_gray","v":{"s":"Gray"}},{"k":"nc_gray_notes","v":{"s":"Achromatic. Equal RGB at any intensity."}},{"k":"nc_silver","v":{"s":"Silver"}},{"k":"nc_silver_notes","v":{"s":"Light gray, often with metallic sheen."}},{"k":"nc_gold","v":{"s":"Gold"}},{"k":"nc_gold_notes","v":{"s":"Yellow with brownish tint. Metallic sheen in physical samples."}},{"k":"nc_maroon","v":{"s":"Maroon"}},{"k":"nc_maroon_notes","v":{"s":"Dark red."}},{"k":"nc_navy","v":{"s":"Navy"}},{"k":"nc_navy_notes","v":{"s":"Dark blue. Original navy uniforms."}},{"k":"nc_teal","v":{"s":"Teal"}},{"k":"nc_teal_notes","v":{"s":"Dark cyan. Named after teal duck's head color."}},{"k":"nc_olive","v":{"s":"Olive"}},{"k":"nc_olive_notes","v":{"s":"Dark yellow-green."}},{"k":"nc_purple","v":{"s":"Purple"}},{"k":"nc_purple_notes","v":{"s":"Dark magenta. Royal purple historically rare + expensive (Tyrian dye)."}},{"k":"nc_indigo","v":{"s":"Indigo"}},{"k":"nc_indigo_notes","v":{"s":"Between blue + violet. Newton's color of the spectrum."}},{"k":"nc_lime","v":{"s":"Lime"}},{"k":"nc_lime_notes","v":{"s":"Web \"lime\" = pure green RGB."}},{"k":"nc_aqua","v":{"s":"Aqua"}},{"k":"nc_aqua_notes","v":{"s":"Same as cyan in web colors."}},{"k":"nc_fuchsia","v":{"s":"Fuchsia"}},{"k":"nc_fuchsia_notes","v":{"s":"Same as magenta in web colors."}},{"k":"nc_coral","v":{"s":"Coral"}},{"k":"nc_coral_notes","v":{"s":"Orange-pink, named after coral reefs."}},{"k":"nc_tomato","v":{"s":"Tomato"}},{"k":"nc_tomato_notes","v":{"s":"Bright red-orange."}},{"k":"nc_salmon","v":{"s":"Salmon"}},{"k":"nc_salmon_notes","v":{"s":"Pinkish orange, like salmon flesh."}},{"k":"nc_khaki","v":{"s":"Khaki"}},{"k":"nc_khaki_notes","v":{"s":"Light yellow-brown. Military uniforms."}},{"k":"nc_crimson","v":{"s":"Crimson"}},{"k":"nc_crimson_notes","v":{"s":"Deep red."}},{"k":"nc_lavender","v":{"s":"Lavender"}},{"k":"nc_lavender_notes","v":{"s":"Light purple, named after the flower."}},{"k":"nc_turquoise","v":{"s":"Turquoise"}},{"k":"nc_turquoise_notes","v":{"s":"Greenish blue, named after the gemstone."}},{"k":"nc_beige","v":{"s":"Beige"}},{"k":"nc_beige_notes","v":{"s":"Pale yellow-brown. Common neutral."}},{"k":"ws_vacuum","v":{"s":"Vacuum"}},{"k":"ws_vacuum_notes","v":{"s":"Defined exactly. Maximum possible speed of any information."}},{"k":"ws_air0","v":{"s":"Air at 0°C"}},{"k":"ws_air0_notes","v":{"s":"Speed of sound increases with temperature."}},{"k":"ws_air20","v":{"s":"Air at 20°C"}},{"k":"ws_air20_notes","v":{"s":"Standard reference. ~1235 km/h, 767 mph."}},{"k":"ws_helium","v":{"s":"Helium at 20°C"}},{"k":"ws_helium_notes","v":{"s":"Faster — lighter molecules. Why helium makes voice high-pitched."}},{"k":"ws_water20","v":{"s":"Water at 20°C"}},{"k":"ws_water20_notes","v":{"s":"Sound travels ~4× faster in water than air."}},{"k":"ws_steel","v":{"s":"Steel"}},{"k":"ws_steel_notes","v":{"s":"Sound very fast in stiff solids."}},{"k":"ws_diamond","v":{"s":"Diamond"}},{"k":"ws_diamond_notes","v":{"s":"Fastest sound speed of common materials."}},{"k":"ws_glass","v":{"s":"Glass (typical)"}},{"k":"ws_glass_notes","v":{"s":"About 2/3 c. Refractive index n = c/v ≈ 1.5."}},{"k":"ws_water","v":{"s":"Water"}},{"k":"ws_water_notes","v":{"s":"About 3/4 c. n ≈ 1.33."}},{"k":"ws_crust_p","v":{"s":"Crust (P-waves)"}},{"k":"ws_crust_p_notes","v":{"s":"Earthquake P-waves move at this speed in upper crust."}},{"k":"ws_crust_s","v":{"s":"Crust (S-waves)"}},{"k":"ws_crust_s_notes","v":{"s":"Slower than P-waves."}},{"k":"ws_tsunami","v":{"s":"Tsunami (deep ocean)"}},{"k":"ws_tsunami_notes","v":{"s":"Long-wavelength shallow-water wave. Slows + grows at shore."}},{"k":"ws_coax","v":{"s":"Light in coaxial cable"}},{"k":"ws_coax_notes","v":{"s":"Slower than vacuum — limits internet latency to/from data centers."}},{"k":"ws_tissue","v":{"s":"Sound in body tissue"}},{"k":"ws_tissue_notes","v":{"s":"Similar to water. Why ultrasound works for medical imaging."}},{"k":"ws_rope","v":{"s":"Compressional wave in rope"}},{"k":"ws_rope_notes","v":{"s":"T = tension, μ = linear density. Tighter rope → faster waves."}},{"k":"sec_animals_title","v":{"s":"Animal hearing ranges"}},{"k":"col_animal","v":{"s":"Animal"}},{"k":"col_hearing_range","v":{"s":"Hearing range"}},{"k":"sec_instrumentfreq_title","v":{"s":"Musical instrument frequencies"}},{"k":"col_instrument","v":{"s":"Instrument"}},{"k":"col_range","v":{"s":"Range"}},{"k":"col_notes_notation","v":{"s":"Notes (notation)"}},{"k":"sec_radio_bands_title","v":{"s":"Radio frequency bands (ITU)"}},{"k":"sec_radio_bands_intro","v":{"s":"EM waves below visible light, classified by frequency. Lower bands penetrate further; higher bands carry more data."}},{"k":"col_band","v":{"s":"Band"}},{"k":"col_frequency","v":{"s":"Frequency"}},{"k":"col_wavelength","v":{"s":"Wavelength"}},{"k":"sec_colorhex_title","v":{"s":"Named colors + their wavelengths"}},{"k":"col_color","v":{"s":"Color"}},{"k":"col_hex","v":{"s":"Hex"}},{"k":"sec_wavespeed_title","v":{"s":"Wave speeds in different media"}},{"k":"cm_rgb","v":{"s":"RGB (additive)"}},{"k":"cm_rgb_use","v":{"s":"Screens, displays"}},{"k":"cm_rgb_notes","v":{"s":"Red + Green + Blue. All three at max = white. Used because screens emit light."}},{"k":"cm_cmyk","v":{"s":"CMYK (subtractive)"}},{"k":"cm_cmyk_use","v":{"s":"Printing"}},{"k":"cm_cmyk_notes","v":{"s":"Cyan, Magenta, Yellow + Key (black). Inks absorb colors; all four = black. Used because paper reflects light."}},{"k":"cm_hsl","v":{"s":"HSL / HSV"}},{"k":"cm_hsl_use","v":{"s":"Color pickers, design"}},{"k":"cm_hsl_notes","v":{"s":"Hue (angle 0-360°), Saturation (%), Lightness/Value (%). More intuitive than RGB for humans."}},{"k":"cm_lab","v":{"s":"LAB (CIELAB)"}},{"k":"cm_lab_use","v":{"s":"Color science, calibration"}},{"k":"cm_lab_notes","v":{"s":"L = lightness, a = green-red, b = blue-yellow. Perceptually uniform."}},{"k":"cm_xyz","v":{"s":"XYZ (CIE 1931)"}},{"k":"cm_xyz_use","v":{"s":"Reference for all other models"}},{"k":"cm_xyz_notes","v":{"s":"Based on human cone responses. Foundation of modern colorimetry."}},{"k":"cm_srgb","v":{"s":"sRGB"}},{"k":"cm_srgb_use","v":{"s":"Standard web + most displays"}},{"k":"cm_srgb_notes","v":{"s":"Limited color gamut. Defines specific RGB primaries + gamma curve."}},{"k":"cm_adobe","v":{"s":"Adobe RGB"}},{"k":"cm_adobe_use","v":{"s":"Print prep + pro photography"}},{"k":"cm_adobe_notes","v":{"s":"Wider gamut than sRGB, especially in greens."}},{"k":"cm_p3","v":{"s":"Display P3"}},{"k":"cm_p3_use","v":{"s":"Apple devices, modern smartphones"}},{"k":"cm_p3_notes","v":{"s":"Wider gamut than sRGB, esp. reds. Standard for HDR."}},{"k":"cm_rec2020","v":{"s":"Rec. 2020"}},{"k":"cm_rec2020_use","v":{"s":"UHD TV / 4K + 8K video"}},{"k":"cm_rec2020_notes","v":{"s":"Very wide gamut. Few displays can reproduce it fully."}},{"k":"lt_hene","v":{"s":"Helium-Neon (HeNe)"}},{"k":"lt_hene_use","v":{"s":"Alignment, barcode scanners (old). One of the first practical lasers."}},{"k":"lt_co2","v":{"s":"CO₂"}},{"k":"lt_co2_use","v":{"s":"Cutting metal + acrylic, surgery, marking."}},{"k":"lt_ndyag","v":{"s":"Nd:YAG"}},{"k":"lt_ndyag_use","v":{"s":"Industrial cutting + welding, medical (skin treatment, tattoo removal)."}},{"k":"lt_argon","v":{"s":"Argon ion"}},{"k":"lt_argon_use","v":{"s":"Eye surgery (retinal), flow cytometry, light shows."}},{"k":"lt_excimer","v":{"s":"Excimer (ArF, KrF)"}},{"k":"lt_excimer_use","v":{"s":"LASIK eye surgery, microchip photolithography."}},{"k":"lt_semiconductor","v":{"s":"Semiconductor (laser diode)"}},{"k":"lt_semiconductor_use","v":{"s":"CD/DVD/Blu-ray, laser pointers, fiber-optic comm."}},{"k":"lt_fiber","v":{"s":"Fiber laser"}},{"k":"lt_fiber_use","v":{"s":"Industrial cutting/welding. Higher efficiency than older lasers."}},{"k":"lt_dye","v":{"s":"Dye laser"}},{"k":"lt_dye_wl","v":{"s":"tunable across visible"}},{"k":"lt_dye_use","v":{"s":"Spectroscopy, research. Largely replaced by tunable solid-state."}},{"k":"lt_fel","v":{"s":"Free-electron laser (FEL)"}},{"k":"lt_fel_wl","v":{"s":"tunable, microwave to X-ray"}},{"k":"lt_fel_power","v":{"s":"high"}},{"k":"lt_fel_use","v":{"s":"Research — accelerator-based. Atomic-scale imaging."}},{"k":"lt_tisapphire","v":{"s":"Ti:Sapphire"}},{"k":"lt_tisapphire_use","v":{"s":"Ultrafast science. Femtosecond pulses. Two-photon microscopy."}},{"k":"lf_acronym","v":{"s":"LASER acronym"}},{"k":"lf_acronym_detail","v":{"s":"Light Amplification by Stimulated Emission of Radiation."}},{"k":"lf_stimulated","v":{"s":"Stimulated emission"}},{"k":"lf_stimulated_detail","v":{"s":"A photon causes an excited atom to emit a SECOND identical photon. Cascade of identical photons = laser beam."}},{"k":"lf_inversion","v":{"s":"Population inversion"}},{"k":"lf_inversion_detail","v":{"s":"More atoms in excited state than ground. Required for net amplification. Achieved via \"pumping\" (light, current, or chemical)."}},{"k":"lf_coherence","v":{"s":"Coherence"}},{"k":"lf_coherence_detail","v":{"s":"Laser photons all in phase. Allows interference effects + tight focusing."}},{"k":"lf_monochromatic","v":{"s":"Monochromatic"}},{"k":"lf_monochromatic_detail","v":{"s":"Single wavelength. Real lasers have very narrow line width (kHz to GHz)."}},{"k":"lf_divergence","v":{"s":"Beam divergence"}},{"k":"lf_divergence_detail","v":{"s":"Laser beams spread VERY slowly. Apollo laser ranging spread <2 km over 384,400 km to Moon."}},{"k":"lf_eyesafety","v":{"s":"Eye safety"}},{"k":"lf_eyesafety_detail","v":{"s":"Even low-power lasers can blind. Focused on retina, mW = sun-level brightness on photoreceptors."}},{"k":"lf_classes","v":{"s":"Classes"}},{"k":"lf_classes_detail","v":{"s":"Class 1 (safe), Class 2 (eye blink protects), Class 3R/3B (potentially hazardous), Class 4 (skin burns + fire risk)."}},{"k":"fo_howwork","v":{"s":"How they work"}},{"k":"fo_howwork_detail","v":{"s":"Total internal reflection traps light in core (higher n) surrounded by cladding (lower n). Light bounces along the fiber."}},{"k":"fo_smf","v":{"s":"Single-mode fiber (SMF)"}},{"k":"fo_smf_detail","v":{"s":"Core ~9 μm. Only one mode propagates. Long distances (>100 km). Used in telecom backbones."}},{"k":"fo_mmf","v":{"s":"Multi-mode fiber (MMF)"}},{"k":"fo_mmf_detail","v":{"s":"Core ~50-62.5 μm. Many modes — limits bandwidth-distance product. Short runs (<2 km)."}},{"k":"fo_attenuation","v":{"s":"Attenuation"}},{"k":"fo_attenuation_detail","v":{"s":"Modern fibers: ~0.2 dB/km at 1550 nm. Signal halves every ~15 km without amplification."}},{"k":"fo_dispersion","v":{"s":"Dispersion"}},{"k":"fo_dispersion_detail","v":{"s":"Different wavelengths or modes travel at slightly different speeds → pulse spreading. Limits data rate."}},{"k":"fo_edfa","v":{"s":"EDFA (erbium-doped fiber amp)"}},{"k":"fo_edfa_detail","v":{"s":"Amplifies optical signal directly without electrical conversion. Revolutionized long-haul fiber."}},{"k":"fo_wdm","v":{"s":"WDM (wavelength division multiplexing)"}},{"k":"fo_wdm_detail","v":{"s":"Multiple wavelengths on one fiber. DWDM can fit 100+ channels — Tb/s per fiber."}},{"k":"fo_bdp","v":{"s":"Bandwidth-distance product"}},{"k":"fo_bdp_detail","v":{"s":"Single-mode fiber: petabit-per-second times km. Vastly more than copper."}},{"k":"fo_backbones","v":{"s":"Real-world: internet backbones"}},{"k":"fo_backbones_detail","v":{"s":"99% of intercontinental data traffic goes over fiber-optic submarine cables."}},{"k":"fo_endoscopes","v":{"s":"Real-world: medical endoscopes"}},{"k":"fo_endoscopes_detail","v":{"s":"Coherent fiber bundles transmit images. Used to inspect inside body."}},{"k":"fo_sensors","v":{"s":"Real-world: sensors"}},{"k":"fo_sensors_detail","v":{"s":"Fiber Bragg gratings detect strain, temperature. Used in bridges, oil wells, aerospace."}},{"k":"cp_wifi6_notes","v":{"s":"Up to ~10 Gbps. OFDMA for many simultaneous users."}},{"k":"cp_wifi7_notes","v":{"s":"Up to ~46 Gbps theoretical. Wider channels (320 MHz)."}},{"k":"cp_bt_classic","v":{"s":"Bluetooth Classic"}},{"k":"cp_bt_classic_notes","v":{"s":"~1-3 Mbps. Pairing for headphones, controllers."}},{"k":"cp_bt_le","v":{"s":"Bluetooth LE (low energy)"}},{"k":"cp_bt_le_notes","v":{"s":"~1-2 Mbps. Beacons, sensors, wearables. Years of coin-cell battery life."}},{"k":"cp_zigbee_notes","v":{"s":"~250 kbps. Mesh networking. Smart-home devices."}},{"k":"cp_4g_notes","v":{"s":"~50-150 Mbps typical."}},{"k":"cp_5g_sub6_notes","v":{"s":"~100 Mbps - 1 Gbps. Wider coverage than mmWave."}},{"k":"cp_5g_mmwave_notes","v":{"s":"Multi-Gbps in clear LOS. Heavily blocked by walls, body, rain."}},{"k":"cp_nfc_notes","v":{"s":"cm range. Contactless payment, pairing."}},{"k":"cp_rfid_notes","v":{"s":"Inventory, tags. Reads at distance without battery in tag."}},{"k":"cp_am","v":{"s":"AM radio"}},{"k":"cp_am_notes","v":{"s":"Amplitude-modulated. Long range, low fidelity. Susceptible to noise."}},{"k":"cp_fm","v":{"s":"FM radio"}},{"k":"cp_fm_notes","v":{"s":"Frequency-modulated. Better noise immunity than AM, higher fidelity."}},{"k":"cp_gps_notes","v":{"s":"Civilian band. ~30 satellites."}},{"k":"cp_sattv","v":{"s":"Satellite TV (Ku band)"}},{"k":"cp_sattv_notes","v":{"s":"Most consumer satellite TV."}},{"k":"cp_microwave","v":{"s":"Microwave oven"}},{"k":"cp_microwave_notes","v":{"s":"Same band as Wi-Fi! Why microwaves can disrupt Wi-Fi when door seal is bad."}},{"k":"ma_pitch","v":{"s":"Pitch"}},{"k":"ma_pitch_detail","v":{"s":"Perception of frequency. A4 = 440 Hz standard concert pitch (some orchestras use 442 Hz)."}},{"k":"ma_octave","v":{"s":"Octave"}},{"k":"ma_octave_detail","v":{"s":"Doubling of frequency. A4 = 440 Hz, A5 = 880 Hz, A3 = 220 Hz."}},{"k":"ma_equaltemp","v":{"s":"Equal temperament"}},{"k":"ma_equaltemp_detail","v":{"s":"12 semitones per octave, each ratio 2^(1/12) ≈ 1.05946. Allows transposing."}},{"k":"ma_justint","v":{"s":"Just intonation"}},{"k":"ma_justint_detail","v":{"s":"Uses simple integer ratios (3:2 = perfect fifth, 5:4 = major third). Sounds more \"pure\" but not transposable."}},{"k":"ma_harmonics","v":{"s":"Harmonics"}},{"k":"ma_harmonics_detail","v":{"s":"Integer multiples of fundamental. Determine timbre. Different instruments emphasize different harmonics."}},{"k":"ma_formants","v":{"s":"Formants"}},{"k":"ma_formants_detail","v":{"s":"Resonant peaks in vocal/instrument spectrum. Distinguish vowels + instruments."}},{"k":"ma_beats","v":{"s":"Beats"}},{"k":"ma_beats_detail","v":{"s":"Two close frequencies interfere → audible amplitude oscillation at difference frequency. Used to tune instruments."}},{"k":"ma_resonance","v":{"s":"Resonance (instruments)"}},{"k":"ma_resonance_detail","v":{"s":"Air column or string vibrates at characteristic frequencies. Length + tension determine pitch."}},{"k":"ma_string","v":{"s":"String frequency"}},{"k":"ma_string_detail","v":{"s":"f = (1/2L)·√(T/μ). Higher tension or shorter string → higher pitch."}},{"k":"ma_openpipe","v":{"s":"Open pipe resonance"}},{"k":"ma_openpipe_detail","v":{"s":"f = nv/(2L). Both ends open. Even harmonics present (flute)."}},{"k":"ma_closedpipe","v":{"s":"Closed pipe resonance"}},{"k":"ma_closedpipe_detail","v":{"s":"f = (2n-1)v/(4L). One end closed. Only odd harmonics (clarinet)."}},{"k":"ma_stereo","v":{"s":"Stereo + spatial audio"}},{"k":"ma_stereo_detail","v":{"s":"Two ears → interaural time + level differences locate sound. Spatial audio reproduces this with head tracking."}},{"k":"ma_reverb","v":{"s":"Reverb time (RT60)"}},{"k":"ma_reverb_detail","v":{"s":"Time for sound to decay by 60 dB. Concert hall ~1.5-2 s; cathedral ~5-10 s; recording studio <0.3 s."}},{"k":"ma_decibels","v":{"s":"Decibels (sound)"}},{"k":"ma_decibels_detail","v":{"s":"0 dB SPL = threshold of hearing. Conversation ~60 dB. Rock concert ~110 dB. Pain ~130 dB. Hearing damage >85 dB long exposure."}},{"k":"ear_pinna","v":{"s":"Pinna (outer ear)"}},{"k":"ear_pinna_fn","v":{"s":"Funnels sound to canal; helps localize sound"}},{"k":"ear_pinna_notes","v":{"s":"Shape filters frequencies → vertical localization cues."}},{"k":"ear_canal","v":{"s":"Ear canal"}},{"k":"ear_canal_fn","v":{"s":"Channels sound to eardrum"}},{"k":"ear_canal_notes","v":{"s":"Resonates at ~3 kHz → enhanced sensitivity to speech frequencies."}},{"k":"ear_eardrum","v":{"s":"Eardrum (tympanic membrane)"}},{"k":"ear_eardrum_fn","v":{"s":"Vibrates with sound waves"}},{"k":"ear_eardrum_notes","v":{"s":"~0.1 mm thick. Connected to ossicles."}},{"k":"ear_ossicles","v":{"s":"Ossicles (hammer, anvil, stirrup)"}},{"k":"ear_ossicles_fn","v":{"s":"Amplify + transmit vibrations to cochlea"}},{"k":"ear_ossicles_notes","v":{"s":"Smallest bones in body. Lever action + area mismatch amplifies ~20×."}},{"k":"ear_oval","v":{"s":"Oval window"}},{"k":"ear_oval_fn","v":{"s":"Membrane connecting middle to inner ear"}},{"k":"ear_oval_notes","v":{"s":"Stirrup pushes against it, transferring vibration to cochlear fluid."}},{"k":"ear_cochlea","v":{"s":"Cochlea"}},{"k":"ear_cochlea_fn","v":{"s":"Frequency analysis — different positions respond to different frequencies"}},{"k":"ear_cochlea_notes","v":{"s":"Snail-shaped. ~3.5 turns. ~16,000 hair cells per ear."}},{"k":"ear_basilar","v":{"s":"Basilar membrane"}},{"k":"ear_basilar_fn","v":{"s":"Mechanical frequency analysis"}},{"k":"ear_basilar_notes","v":{"s":"Stiff near oval window (high freq), floppy at apex (low freq)."}},{"k":"ear_haircells","v":{"s":"Hair cells"}},{"k":"ear_haircells_fn","v":{"s":"Convert mechanical vibration to neural signal"}},{"k":"ear_haircells_notes","v":{"s":"Outer hair cells amplify; inner hair cells transmit. Damage = permanent hearing loss."}},{"k":"ear_nerve","v":{"s":"Auditory nerve"}},{"k":"ear_nerve_fn","v":{"s":"Carries signal to brain"}},{"k":"ear_nerve_notes","v":{"s":"About 30,000 fibers per ear."}},{"k":"ear_semicircular","v":{"s":"Semicircular canals"}},{"k":"ear_semicircular_fn","v":{"s":"Balance + head rotation"}},{"k":"ear_semicircular_notes","v":{"s":"3 fluid-filled rings in 3 perpendicular planes. Detect angular acceleration."}},{"k":"ear_otolith","v":{"s":"Otolith organs"}},{"k":"ear_otolith_fn","v":{"s":"Detect linear acceleration + gravity"}},{"k":"ear_otolith_notes","v":{"s":"Crystals on hair cells move with motion. Source of \"elevator stomach\" feeling."}},{"k":"mi_xray_rad","v":{"s":"X-rays"}},{"k":"mi_xray_use","v":{"s":"Bones, dense tissue. Quick, cheap, ubiquitous."}},{"k":"mi_xray_notes","v":{"s":"Ionizing radiation. Bone absorbs more than soft tissue → contrast."}},{"k":"mi_ct","v":{"s":"CT scan"}},{"k":"mi_ct_rad","v":{"s":"X-rays (many angles)"}},{"k":"mi_ct_use","v":{"s":"3D reconstruction. Trauma, tumors, internal injury."}},{"k":"mi_ct_notes","v":{"s":"Higher dose than single X-ray. Excellent anatomical detail."}},{"k":"mi_mri_rad","v":{"s":"Radio (in strong B field)"}},{"k":"mi_mri_use","v":{"s":"Soft tissue, brain, joints, tumors."}},{"k":"mi_mri_notes","v":{"s":"No ionizing radiation. Long scans. T1 vs T2 highlights different features."}},{"k":"mi_fmri_use","v":{"s":"Brain activity via blood oxygenation"}},{"k":"mi_fmri_notes","v":{"s":"BOLD signal. Indirect — neural activity → blood flow change → MRI signal."}},{"k":"mi_ultrasound","v":{"s":"Ultrasound"}},{"k":"mi_ultrasound_rad","v":{"s":"High-frequency sound"}},{"k":"mi_ultrasound_use","v":{"s":"Pregnancy, heart, abdominal organs"}},{"k":"mi_ultrasound_notes","v":{"s":"No radiation. Real-time. Doppler mode shows blood flow."}},{"k":"mi_pet","v":{"s":"PET scan"}},{"k":"mi_pet_rad","v":{"s":"Positron emission (radiotracer)"}},{"k":"mi_pet_use","v":{"s":"Metabolic activity, cancer staging, brain disease"}},{"k":"mi_pet_notes","v":{"s":"Radioactive glucose (FDG) concentrates in active tissue."}},{"k":"mi_spect_rad","v":{"s":"Gamma (radiotracer)"}},{"k":"mi_spect_use","v":{"s":"Blood flow, heart, brain"}},{"k":"mi_spect_notes","v":{"s":"Like PET but uses single-photon emitters; lower resolution but cheaper."}},{"k":"mi_mammography","v":{"s":"Mammography"}},{"k":"mi_mammography_rad","v":{"s":"Low-energy X-rays"}},{"k":"mi_mammography_use","v":{"s":"Breast tissue screening"}},{"k":"mi_mammography_notes","v":{"s":"Compression spreads tissue for clearer image."}},{"k":"mi_dexa","v":{"s":"Bone densitometry (DEXA)"}},{"k":"mi_dexa_rad","v":{"s":"Dual-energy X-ray"}},{"k":"mi_dexa_use","v":{"s":"Bone density (osteoporosis)"}},{"k":"mi_dexa_notes","v":{"s":"Two energies subtract to isolate bone density."}},{"k":"mi_oct","v":{"s":"OCT (optical coherence tomography)"}},{"k":"mi_oct_rad","v":{"s":"Near-infrared light"}},{"k":"mi_oct_use","v":{"s":"Retina + cornea imaging"}},{"k":"mi_oct_notes","v":{"s":"Like ultrasound but with light. μm resolution. No radiation."}},{"k":"sat_altitude","v":{"s":"GPS orbital altitude"}},{"k":"sat_altitude_detail","v":{"s":"~20,200 km. Medium Earth orbit. Period ~12 hours (2 orbits per sidereal day)."}},{"k":"sat_constellation","v":{"s":"GPS constellation"}},{"k":"sat_constellation_detail","v":{"s":"24+ satellites; need ≥4 in view for 3D fix + time."}},{"k":"sat_receiver","v":{"s":"Receiver position"}},{"k":"sat_receiver_detail","v":{"s":"Triangulation by time-of-flight from satellites to receiver. Needs 4 satellites (3 for position + 1 for clock sync)."}},{"k":"sat_accuracy","v":{"s":"Accuracy"}},{"k":"sat_accuracy_detail","v":{"s":"Civilian GPS: ~3-10 m. With augmentation (DGPS, RTK): cm. Selective Availability ended in 2000."}},{"k":"sat_galileo_detail","v":{"s":"EU GNSS. ~30 satellites. Open service ~1 m accuracy."}},{"k":"sat_glonass_detail","v":{"s":"Russian GNSS. ~24 satellites."}},{"k":"sat_beidou_detail","v":{"s":"Chinese GNSS. 35 satellites. Global service since 2020."}},{"k":"sat_geo","v":{"s":"Geostationary orbit (GEO)"}},{"k":"sat_geo_detail","v":{"s":"35,786 km altitude. Period = 24 hours → fixed over equator point. Used for TV, weather."}},{"k":"sat_leo","v":{"s":"Low Earth orbit (LEO)"}},{"k":"sat_leo_detail","v":{"s":"200-2000 km. Period ~90 min. ISS at ~400 km. Starlink at ~550 km. Lower latency."}},{"k":"sat_clocks","v":{"s":"Atomic clocks on GPS"}},{"k":"sat_clocks_detail","v":{"s":"Cesium + rubidium clocks. Stability ~10⁻¹³. Even small relativistic effects matter — must correct for both special + general relativity."}},{"k":"sat_lighttime","v":{"s":"Light travel time"}},{"k":"sat_lighttime_detail","v":{"s":"GPS satellite → receiver: ~70 ms. Geo satellite → receiver: ~250 ms (perceptible delay in geo satellite calls)."}},{"k":"gw_whatare","v":{"s":"What they are"}},{"k":"gw_whatare_detail","v":{"s":"Ripples in spacetime predicted by Einstein (1916). Travel at speed of light."}},{"k":"gw_sources","v":{"s":"Sources"}},{"k":"gw_sources_detail","v":{"s":"Massive accelerating objects: merging black holes + neutron stars, supernovae, pulsars, Big Bang."}},{"k":"gw_ligo_detail","v":{"s":"Laser Interferometer Gravitational-wave Observatory. Two L-shaped detectors (Hanford WA, Livingston LA), 4 km arms."}},{"k":"gw_firstdetect","v":{"s":"First detection"}},{"k":"gw_firstdetect_detail","v":{"s":"14 September 2015. Two ~30 M☉ black holes merged ~1.3 billion years ago. Signal lasted ~0.2 sec. Nobel Prize 2017."}},{"k":"gw_sensitivity","v":{"s":"Sensitivity"}},{"k":"gw_sensitivity_detail","v":{"s":"LIGO detects length changes ~10⁻¹⁸ m — 1/10000 the size of a proton."}},{"k":"gw_multimessenger","v":{"s":"Multi-messenger astronomy"}},{"k":"gw_multimessenger_detail","v":{"s":"17 August 2017: GW + gamma rays + visible light from neutron-star merger (GW170817). Confirmed kilonovae produce heavy elements."}},{"k":"gw_virgo_detail","v":{"s":"European GW detector in Italy. 3 km arms."}},{"k":"gw_kagra_detail","v":{"s":"Japanese GW detector. Underground, cryogenic mirrors."}},{"k":"gw_lisa","v":{"s":"LISA (planned)"}},{"k":"gw_lisa_detail","v":{"s":"Space-based detector. 3 satellites in 2.5 million km triangle. Launch ~2035. Sensitive to lower frequencies (supermassive black holes)."}},{"k":"gw_pta","v":{"s":"Pulsar timing arrays"}},{"k":"gw_pta_detail","v":{"s":"Use millisecond pulsars as natural clocks. Detect very low-frequency GWs from supermassive black hole binaries. NANOGrav announced detection 2023."}},{"k":"wu_frequency","v":{"s":"Frequency"}},{"k":"wu_frequency_unit","v":{"s":"hertz (Hz)"}},{"k":"wu_frequency_notes","v":{"s":"Cycles per second. kHz, MHz, GHz, THz common in modern tech."}},{"k":"wu_period","v":{"s":"Period"}},{"k":"wu_period_unit","v":{"s":"second (s)"}},{"k":"wu_period_notes","v":{"s":"Time per cycle. T = 1/f. Heart: ~1 s; mains: 16.7 ms; visible light: ~2 fs."}},{"k":"wu_wavelength","v":{"s":"Wavelength"}},{"k":"wu_wavelength_unit","v":{"s":"meter (m)"}},{"k":"wu_wavelength_notes","v":{"s":"Distance per cycle. Sub-mm (UHF radio) to thousands of km (extremely low freq)."}},{"k":"wu_wavenumber","v":{"s":"Wavenumber"}},{"k":"wu_wavenumber_notes","v":{"s":"k = 2π/λ. Used in waveform math."}},{"k":"wu_angfreq","v":{"s":"Angular frequency"}},{"k":"wu_angfreq_notes","v":{"s":"ω = 2πf. Common in oscillation + wave equations."}},{"k":"wu_speed","v":{"s":"Speed"}},{"k":"wu_speed_notes","v":{"s":"v = fλ. Light in vacuum: c = 299,792,458 m/s (exact)."}},{"k":"wu_amplitude","v":{"s":"Amplitude"}},{"k":"wu_amplitude_unit","v":{"s":"meters (mech), V/m (EM)"}},{"k":"wu_amplitude_notes","v":{"s":"Maximum displacement from equilibrium."}},{"k":"wu_intensity","v":{"s":"Intensity"}},{"k":"wu_intensity_notes","v":{"s":"Power per area. Solar irradiance at Earth: ~1361 W/m²."}},{"k":"wu_spl","v":{"s":"Sound pressure level (SPL)"}},{"k":"wu_spl_notes","v":{"s":"20·log₁₀(p/p_ref). Reference: 20 μPa."}},{"k":"wu_photon","v":{"s":"Photon energy"}},{"k":"wu_photon_unit","v":{"s":"joule (J) or eV"}},{"k":"wu_photon_notes","v":{"s":"E = hf = hc/λ. Visible photons: ~2 eV."}},{"k":"wc_audio","v":{"s":"Audio engineer"}},{"k":"wc_audio_use","v":{"s":"Mixing music, recording. Understand EQ, reverb, frequency response."}},{"k":"wc_acoustic","v":{"s":"Acoustic consultant"}},{"k":"wc_acoustic_use","v":{"s":"Design concert halls, recording studios, noise control for buildings + machinery."}},{"k":"wc_audiologist","v":{"s":"Audiologist"}},{"k":"wc_audiologist_use","v":{"s":"Test + treat hearing loss. Fit hearing aids and cochlear implants."}},{"k":"wc_slp","v":{"s":"Speech-language pathologist"}},{"k":"wc_slp_use","v":{"s":"Analyze speech sounds (acoustic phonetics). Treat voice + articulation disorders."}},{"k":"wc_rf","v":{"s":"RF engineer"}},{"k":"wc_rf_use","v":{"s":"Design antennas, wireless systems, radar."}},{"k":"wc_optical","v":{"s":"Optical engineer"}},{"k":"wc_optical_use","v":{"s":"Design cameras, microscopes, telescopes, fiber-optic links."}},{"k":"wc_seismologist","v":{"s":"Seismologist"}},{"k":"wc_seismologist_use","v":{"s":"Analyze earthquake waves, locate epicenters, monitor for nuclear tests."}},{"k":"wc_oceanographer","v":{"s":"Oceanographer"}},{"k":"wc_oceanographer_use","v":{"s":"Study tides, currents, ocean wave dynamics."}},{"k":"wc_meteorologist","v":{"s":"Meteorologist"}},{"k":"wc_meteorologist_use","v":{"s":"Doppler radar analysis. Wave physics in atmosphere (Rossby waves)."}},{"k":"wc_sonographer","v":{"s":"Sonographer (medical)"}},{"k":"wc_sonographer_use","v":{"s":"Operate ultrasound for diagnostic imaging."}},{"k":"wc_astronomer","v":{"s":"Astronomer"}},{"k":"wc_astronomer_use","v":{"s":"Analyze light + radio waves from celestial objects."}},{"k":"wc_producer","v":{"s":"Music producer"}},{"k":"wc_producer_use","v":{"s":"Shape recorded sound. Synthesize tones. Mix tracks."}},{"k":"wc_lighting","v":{"s":"Lighting designer"}},{"k":"wc_lighting_use","v":{"s":"Theater, film. Color temperature, beam angles, intensity."}},{"k":"wc_telecom","v":{"s":"Telecom engineer"}},{"k":"wc_telecom_use","v":{"s":"Cellular networks, fiber backbones, satellite links."}},{"k":"wc_radar","v":{"s":"Radar technician"}},{"k":"wc_radar_use","v":{"s":"Maintain + operate weather, air-traffic, military radar."}},{"k":"sec_colors2_intro","v":{"s":"Different ways to describe color numerically. Each is suited to a specific medium or application."}},{"k":"sec_common_laser_types","v":{"s":"Common laser types"}},{"k":"sec_laser_physics","v":{"s":"Laser physics essentials"}},{"k":"sec_protocols_title","v":{"s":"Wireless communication protocols"}},{"k":"col_standard","v":{"s":"Standard"}},{"k":"col_freq_band","v":{"s":"Frequency band"}},{"k":"sec_music_title","v":{"s":"Music & acoustics"}},{"k":"sec_hearing_title","v":{"s":"The ear & hearing"}},{"k":"sec_medical_title","v":{"s":"Medical imaging (wave-based)"}},{"k":"label_use_colon","v":{"s":"Use: "}},{"k":"sec_satellites_title","v":{"s":"GPS & satellite communications"}},{"k":"sec_units_title","v":{"s":"Wave units & symbols"}},{"k":"col_quantity","v":{"s":"Quantity"}},{"k":"col_symbol","v":{"s":"Symbol"}},{"k":"col_unit","v":{"s":"Unit"}},{"k":"sec_careers_title","v":{"s":"Careers using wave science"}},{"k":"aria_live_measurements","v":{"s":"Live wave measurements"}},{"k":"live_amplitude","v":{"s":"Amplitude"}},{"k":"live_frequency","v":{"s":"Frequency"}},{"k":"live_measurements_label","v":{"s":"Live measurements"}},{"k":"live_medium_speed","v":{"s":"Medium speed"}},{"k":"live_paused","v":{"s":"Paused"}},{"k":"live_period","v":{"s":"Period"}},{"k":"live_running","v":{"s":"Running"}},{"k":"live_waveform","v":{"s":"Waveform"}},{"k":"live_wavelength","v":{"s":"Wavelength"}}],"id":596}},{"k":"weathersystems","v":{"o":[{"k":"sr_shared_immersive_weather_session_restored","v":{"s":"Shared immersive weather session restored."}},{"k":"sr_immersive_workspace_restored_from_this_device","v":{"s":"Immersive workspace restored from this device."}},{"k":"sr_local_autosave_turned_off_and_saved_device_copy_c","v":{"s":"Local autosave turned off and saved device copy cleared."}},{"k":"sr_local_autosave_enabled_for_this_device","v":{"s":"Local autosave enabled for this device."}},{"k":"sr_saved_device_copy_cleared_and_local_autosave_turn","v":{"s":"Saved device copy cleared and local autosave turned off."}},{"k":"sr_immersive_evidence_captures_cleared","v":{"s":"Immersive evidence captures cleared."}},{"k":"sr_weather_systems_session_imported","v":{"s":"Weather Systems session imported."}},{"k":"sr_3d_comparison_opened_for_the_selected_captures","v":{"s":"3D comparison opened for the selected captures."}},{"k":"sr_enter_a_preset_name_before_saving","v":{"s":"Enter a preset name before saving."}},{"k":"sr_lesson_preset_removed","v":{"s":"Lesson preset removed."}},{"k":"sr_enter_at_least_two_characters_for_a_location_sear","v":{"s":"Enter at least two characters for a location search."}},{"k":"sr_the_immersive_weather_scene_is_still_loading","v":{"s":"The immersive weather scene is still loading."}},{"k":"sr_vr_weather_immersion_started","v":{"s":"VR weather immersion started."}},{"k":"sr_vr_weather_immersion_ended","v":{"s":"VR weather immersion ended."}},{"k":"sr_immersive_orientation_reset_to_the_guided_view","v":{"s":"Immersive orientation reset to the guided view."}},{"k":"sr_terrain_emphasis_is_unavailable_because_the_terra","v":{"s":"Terrain emphasis is unavailable because the terrain layer did not load."}},{"k":"sr_terrain_evidence_is_still_being_prepared","v":{"s":"Terrain evidence is still being prepared."}},{"k":"sr_forecast_mission_opened_with_terrain_evidence_and","v":{"s":"Forecast Mission opened with terrain evidence and the mapped evidence note carried forward."}},{"k":"sr_wind_aligned_terrain_profile_added_to_forecast_ev","v":{"s":"Wind-aligned terrain profile added to forecast evidence."}},{"k":"sr_real_3d_buildings_are_unavailable_in_the_current","v":{"s":"Real 3D buildings are unavailable in the current map style."}},{"k":"sr_weather_timeline_returned_to_the_current_observat","v":{"s":"Weather timeline returned to the current observation."}},{"k":"sr_automatic_playback_is_unavailable_with_reduced_mo","v":{"s":"Automatic playback is unavailable with reduced motion. Use step controls."}},{"k":"sr_a_future_forecast_hour_is_required_to_save_a_veri","v":{"s":"A future forecast hour is required to save a verification checkpoint."}},{"k":"sr_forecast_checkpoint_removed","v":{"s":"Forecast checkpoint removed."}},{"k":"sr_regional_weather_fields_require_a_selected_live_w","v":{"s":"Regional weather fields require a selected live weather hour."}},{"k":"sr_terrain_comparison_point_cleared","v":{"s":"Terrain comparison point cleared."}},{"k":"sr_feature_comparison_cleared","v":{"s":"Feature comparison cleared."}},{"k":"sr_choose_a_station_pair_before_checking_the_boundar","v":{"s":"Choose a station pair before checking the boundary."}},{"k":"sr_forecast_verification_paused_because_the_selected","v":{"s":"Forecast verification paused because the selected terrain evidence does not match the active live observation."}},{"k":"sr_forecast_incomplete_complete_precipitation_timing","v":{"s":"Forecast incomplete. Complete precipitation, timing, hazard, school action, confidence, and the reasoning note."}},{"k":"sr_choose_whether_precipitation_potential_will_incre","v":{"s":"Choose whether precipitation potential will increase, decrease, or stay close."}},{"k":"sr_terrain_elevation_is_not_available_at_that_map_po","v":{"s":"Terrain elevation is not available at that map point yet."}},{"k":"sr_select_at_least_one_evidence_card_before_opening","v":{"s":"Select at least one evidence card before opening the Forecast Mission."}},{"k":"sr_cause_and_effect_lab_opened_for_a_one_variable_co","v":{"s":"Cause and Effect Lab opened for a one-variable controlled test."}},{"k":"sr_map_lab_opened_with_your_evidence_cards_still_sel","v":{"s":"Map Lab opened with your evidence cards still selected."}},{"k":"sr_geographic_3d_terrain_evidence_reopened","v":{"s":"Geographic 3D terrain evidence reopened."}},{"k":"sr_peer_review_saved_for_the_teacher_handoff_brief","v":{"s":"Peer review saved for the Teacher Handoff Brief."}},{"k":"sr_reflection_and_exit_ticket_saved_for_the_teacher","v":{"s":"Reflection and exit ticket saved for the teacher handoff."}},{"k":"sr_teacher_conference_ratings_and_note_cleared","v":{"s":"Teacher conference ratings and note cleared."}},{"k":"a11y_meteorologist_badges_earned","v":{"s":"Meteorologist badges earned"}},{"k":"a11y_meteorologist_achievement_badges","v":{"s":"Meteorologist achievement badges"}},{"k":"a11y_weather_investigation_pathway_progress","v":{"s":"Weather investigation pathway progress"}},{"k":"a11y_weather_investigation_stages","v":{"s":"Weather investigation stages"}},{"k":"a11y_back_to_stem_tools","v":{"s":"Back to STEM tools"}},{"k":"a11y_weather_lab_sections","v":{"s":"Weather lab sections"}},{"k":"a11y_jump_to_a_model_hour_chapter","v":{"s":"Jump to a model-hour chapter"}},{"k":"a11y_weather_map_visual_presets","v":{"s":"Weather map visual presets"}},{"k":"a11y_moisture_closeness_to_saturation","v":{"s":"Moisture closeness to saturation"}},{"k":"a11y_evidence_carried_from_the_map","v":{"s":"Evidence carried from the map"}},{"k":"a11y_claim_evidence_reasoning_completeness","v":{