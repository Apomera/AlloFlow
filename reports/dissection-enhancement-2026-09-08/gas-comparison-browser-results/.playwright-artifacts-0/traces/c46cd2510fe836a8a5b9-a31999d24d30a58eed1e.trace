rkspace-mode=\"essentials\"] #diss-view-tools button[aria-label^=\"Lab light\"], [data-dissection-root][data-workspace-mode=\"essentials\"] #diss-view-tools button[aria-label^=\"Laboratory light direction\"], [data-dissection-root][data-workspace-mode=\"essentials\"] #diss-view-tools button[aria-label^=\"Generate another deterministic\"], [data-dissection-root][data-workspace-mode=\"essentials\"] #diss-view-tools button[aria-label^=\"Toggle before and after\"], [data-dissection-root][data-workspace-mode=\"essentials\"] #diss-view-tools button[aria-label^=\"Animation speed\"] { display: none !important; }\n.diss-objective-list { display: grid; gap: 0.5rem; margin: 0px; padding: 0px; list-style: none; }\n.diss-objective-item { padding: 0.6rem 0.65rem; border: 1px solid rgb(167, 243, 208); border-radius: 0.75rem; background: rgba(255, 255, 255, 0.78); }\n.diss-objective-item[data-objective-status=\"demonstrated\"] { border-color: rgb(52, 211, 153); background: rgb(236, 253, 245); }\n.diss-objective-item__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.65rem; }\n.diss-objective-item__head strong { color: rgb(37, 75, 69); font-size: 0.72rem; line-height: 1.45; }\n.diss-objective-item__status { flex: 0 0 auto; color: rgb(71, 99, 95); font-size: 0.62rem; font-weight: 900; }\n.diss-objective-item[data-objective-status=\"demonstrated\"] .diss-objective-item__status { color: rgb(4, 120, 87); }\n.diss-objective-item__meter { overflow: hidden; height: 0.4rem; margin-top: 0.45rem; border-radius: 999px; background: rgb(209, 250, 229); }\n.diss-objective-item__meter span { display: block; height: 100%; border-radius: inherit; background: rgb(15, 143, 134); }\n.diss-objective-item p { margin: 0.38rem 0px 0px; color: rgb(71, 99, 95); font-size: 0.65rem; line-height: 1.45; }\n.diss-picker, .diss-layer-stepper { padding: 0.75rem; border: 1px solid var(--diss-line); border-radius: 1rem; background: rgb(255, 255, 255); box-shadow: rgba(15, 23, 42, 0.05) 0px 8px 24px; }\n.diss-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.55rem; }\n.diss-section-heading h3 { margin: 0px; color: rgb(25, 52, 84); font-size: 0.8rem; font-weight: 900; }\n.diss-section-heading p { margin: 0px; color: var(--diss-muted); font-size: 0.68rem; }\n.diss-specimen-rail { display: flex; gap: 0.45rem; overflow-x: auto; padding: 0.15rem 0.05rem 0.35rem; overscroll-behavior-inline: contain; scroll-snap-type: x; scrollbar-width: thin; }\n.diss-specimen-tab { flex: 0 0 auto; scroll-snap-align: start; padding: 0.6rem 0.85rem; border: 1px solid rgb(198, 212, 230); border-radius: 0.8rem; background: rgb(248, 250, 252); color: rgb(67, 87, 113); font-size: 0.74rem; font-weight: 850; cursor: pointer; min-height: 2.75rem !important; }\n.diss-specimen-tab[aria-selected=\"true\"] { border-color: rgb(23, 102, 210); background: linear-gradient(135deg, rgb(23, 102, 210), rgb(11, 122, 119)); box-shadow: rgba(23, 102, 210, 0.2) 0px 7px 18px; color: rgb(255, 255, 255); }\n.diss-layer-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(7.25rem, 1fr)); gap: 0.45rem; }\n.diss-layer-button { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.45rem; padding: 0.55rem 0.65rem; border: 1px solid rgb(203, 213, 225); border-radius: 0.75rem; background: rgb(248, 250, 252); color: rgb(67, 87, 113); text-align: left; cursor: pointer; min-height: 3rem !important; }\n.diss-layer-button[data-state=\"current\"] { border-color: rgb(15, 143, 134); background: rgb(236, 253, 245); box-shadow: rgb(94, 234, 212) 0px 0px 0px 1px inset; color: rgb(17, 94, 89); }\n.diss-layer-button[data-state=\"revealed\"] { border-color: rgb(187, 213, 245); background: rgb(239, 246, 255); color: rgb(23, 77, 134); }\n.diss-layer-button:disabled { cursor: not-allowed; opacity: 0.5; }\n.diss-layer-index { display: grid; width: 1.4rem; height: 1.4rem; place-items: center; border-radius: 999px; background: rgb(226, 232, 240); color: rgb(51, 65, 85); font-size: 0.64rem; font-weight: 900; }\n.diss-layer-name { overflow: hidden; font-size: 0.7rem; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }\n.diss-layer-state { color: rgb(7, 129, 116); font-size: 0.7rem; font-weight: 900; }\n.diss-toolbar { gap: 0.45rem !important; padding: 0.5rem !important; border-radius: 1rem !important; background: rgb(248, 250, 252) !important; }\n.diss-quiz-option:hover:not(:disabled) { border-color: rgb(180, 83, 9); background: rgb(255, 251, 235); }\n.diss-quiz-option:focus-visible { outline: rgb(180, 83, 9) solid 3px; outline-offset: 2px; }\n.diss-toolbar__label { padding-left: 0.35rem; color: rgb(71, 85, 105); font-size: 0.68rem; font-weight: 900; letter-spacing: 0.09em; text-transform: uppercase; }\n.diss-toolbar > button, .diss-tool-panel > button { min-height: 2.75rem !important; }\n.diss-tool-panel { gap: 0.45rem !important; padding: 0.65rem !important; }\n.diss-light-intensity { display: grid; min-width: min(100%, 15rem); min-height: 2.75rem; grid-template-columns: minmax(0px, 1fr) auto; align-items: center; gap: 0.18rem 0.55rem; padding: 0.38rem 0.55rem; border: 1px solid rgb(191, 219, 254); border-radius: 0.55rem; background: rgb(255, 255, 255); color: rgb(30, 58, 138); font-size: 0.75rem; font-weight: 800; }\n.diss-light-intensity[data-tone=\"glare\"], .diss-light-intensity[data-tone=\"dim\"] { border-color: rgb(217, 119, 6); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-light-intensity input { grid-column: 1 / -1; width: 100%; min-height: 1.5rem; margin: 0px; accent-color: rgb(23, 102, 210); cursor: pointer; }\n.diss-light-intensity output { font-variant-numeric: tabular-nums; font-weight: 900; }\n.diss-next-action { position: sticky; z-index: 30; top: 0.5rem; display: grid; grid-template-columns: auto minmax(0px, 1fr) auto; align-items: center; gap: 0.75rem; padding: 0.72rem; border: 1px solid rgb(143, 180, 220); border-radius: 1rem; background: rgba(248, 251, 255, 0.97); box-shadow: rgba(15, 23, 42, 0.14) 0px 12px 30px; color: rgb(22, 58, 99); backdrop-filter: blur(12px); }\n.diss-next-action[data-tone=\"ready\"] { border-color: rgb(52, 166, 143); background: rgba(240, 253, 250, 0.98); color: rgb(17, 94, 89); }\n.diss-next-action[data-tone=\"caution\"] { border-color: rgb(217, 160, 59); background: rgba(255, 251, 235, 0.98); color: rgb(120, 53, 15); }\n.diss-next-action[data-tone=\"assessment\"] { border-color: rgb(192, 132, 26); background: rgba(255, 251, 235, 0.98); color: rgb(120, 53, 15); }\n.diss-next-action__step { display: grid; width: 3.45rem; height: 3.45rem; place-items: center; border: 1px solid; border-radius: 0.8rem; background: rgb(255, 255, 255); font-size: 0.72rem; font-weight: 900; line-height: 1.15; text-align: center; }\n.diss-next-action__body { min-width: 0px; }\n.diss-next-action__eyebrow { display: block; font-size: 0.68rem; font-weight: 900; letter-spacing: 0.09em; text-transform: uppercase; }\n.diss-next-action h3 { margin: 0.12rem 0px 0px; color: currentcolor; font-size: 0.95rem; font-weight: 900; line-height: 1.25; }\n.diss-next-action p { margin: 0.16rem 0px 0px; color: currentcolor; font-size: 0.76rem; line-height: 1.42; opacity: 0.88; }\n.diss-next-action__meta { display: flex; flex-wrap: wrap; gap: 0.35rem 0.7rem; margin-top: 0.3rem; color: currentcolor; font-size: 0.68rem; font-weight: 800; opacity: 0.82; }\n.diss-next-action__actions { display: grid; min-width: 10.5rem; gap: 0.35rem; }\n.diss-next-action__primary, .diss-next-action__secondary { padding: 0.55rem 0.72rem; border-radius: 0.65rem; font-size: 0.74rem; font-weight: 900; cursor: pointer; min-height: 2.75rem !important; }\n.diss-next-action__primary { border: 1px solid rgb(15, 118, 110); background: rgb(15, 118, 110); color: rgb(255, 255, 255); box-shadow: rgba(15, 118, 110, 0.18) 0px 6px 14px; }\n.diss-next-action__primary:hover:not(:disabled) { background: rgb(17, 94, 89); }\n.diss-next-action__secondary { border: 1px solid rgb(148, 163, 184); background: rgb(255, 255, 255); color: rgb(51, 65, 85); }\n.diss-next-action__primary:disabled { cursor: not-allowed; opacity: 0.56; }\n.diss-next-action__actions > :only-child { grid-column: 1 / -1; }\n.diss-learning-check { display: grid; grid-template-columns: minmax(0px, 1fr) auto; gap: 0.65rem 1rem; padding: 0.8rem 0.9rem; border: 1px solid rgb(122, 166, 207); border-radius: 1rem; background: linear-gradient(135deg, rgb(240, 249, 255), rgb(248, 251, 255) 58%, rgb(236, 253, 245)); color: rgb(22, 58, 99); box-shadow: rgba(15, 73, 120, 0.09) 0px 8px 22px; }\n.diss-learning-check[data-phase=\"reflect\"] { border-color: rgb(167, 139, 250); background: linear-gradient(135deg, rgb(245, 243, 255), rgb(250, 245, 255) 58%, rgb(240, 253, 250)); color: rgb(76, 29, 149); }\n.diss-learning-check[data-phase=\"perform\"] { border-color: rgb(52, 166, 143); background: linear-gradient(135deg, rgb(236, 253, 245), rgb(240, 253, 250)); color: rgb(17, 94, 89); }\n.diss-learning-check__head { min-width: 0px; }\n.diss-learning-check__eyebrow { margin: 0px; font-size: 0.67rem; font-weight: 900; letter-spacing: 0.09em; text-transform: uppercase; }\n.diss-learning-check h3 { margin: 0.15rem 0px 0px; color: currentcolor; font-size: 0.94rem; font-weight: 900; line-height: 1.3; }\n.diss-learning-check__prompt { margin: 0.3rem 0px 0px; max-width: 64rem; color: currentcolor; font-size: 0.79rem; line-height: 1.5; }\n.diss-learning-check__phases { display: flex; flex-wrap: wrap; align-self: start; justify-content: flex-end; gap: 0.3rem; }\n.diss-learning-check__phase { min-width: 4.7rem; padding: 0.3rem 0.42rem; border: 1px solid rgb(169, 189, 211); border-radius: 999px; background: rgb(255, 255, 255); color: rgb(64, 90, 119); font-size: 0.64rem; font-weight: 900; text-align: center; }\n.diss-learning-check__phase[data-state=\"current\"] { border-color: currentcolor; background: rgb(224, 242, 254); color: rgb(7, 89, 133); box-shadow: currentcolor 0px 0px 0px 1px inset; }\n.diss-learning-check[data-phase=\"reflect\"] .diss-learning-check__phase[data-state=\"current\"] { background: rgb(237, 233, 254); color: rgb(91, 33, 182); }\n.diss-learning-check__phase[data-state=\"complete\"] { border-color: rgb(94, 182, 157); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-learning-check__options { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 0.48rem; }\n.diss-learning-check__option { padding: 0.58rem 0.65rem; border: 1px solid rgb(139, 167, 196); border-radius: 0.68rem; background: rgb(255, 255, 255); color: rgb(23, 63, 105); font-size: 0.72rem; font-weight: 800; line-height: 1.38; text-align: left; cursor: pointer; min-height: 3.35rem !important; }\n.diss-learning-check__option:hover { border-color: rgb(23, 102, 210); background: rgb(239, 246, 255); }\n.diss-learning-check__option[aria-pressed=\"true\"] { border-color: rgb(23, 102, 210); box-shadow: rgb(23, 102, 210) 0px 0px 0px 1px inset; }\n.diss-learning-check__option[data-result=\"incorrect\"] { border-color: rgb(217, 119, 6); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-learning-check__option[data-result=\"correct\"] { border-color: rgb(15, 118, 110); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-learning-check__feedback { grid-column: 1 / -1; margin: 0px; padding: 0.48rem 0.58rem; border-left: 0.25rem solid; border-radius: 0.3rem; background: rgba(255, 255, 255, 0.72); color: currentcolor; font-size: 0.72rem; font-weight: 750; line-height: 1.45; }\n.diss-learning-check__perform { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.6rem; border: 1px solid rgb(117, 201, 174); border-radius: 0.65rem; background: rgba(255, 255, 255, 0.78); color: rgb(6, 95, 70); font-size: 0.74rem; font-weight: 800; line-height: 1.4; }\n.diss-learning-check__perform::before { content: \"2\"; display: grid; width: 1.6rem; height: 1.6rem; flex: 0 0 auto; place-items: center; border-radius: 999px; background: rgb(15, 118, 110); color: rgb(255, 255, 255); font-size: 0.7rem; font-weight: 900; }\n.diss-pointer-guide { display: flex; min-width: 0px; align-items: center; gap: 0.5rem; margin: 0px 0px 0.5rem; padding: 0.48rem 0.58rem; border: 1px solid rgb(137, 168, 200); border-radius: 0.7rem; background: rgb(239, 246, 255); color: rgb(23, 77, 134); }\n.diss-pointer-guide[data-tone=\"ready\"] { border-color: rgb(52, 166, 143); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-pointer-guide[data-tone=\"caution\"], .diss-pointer-guide[data-tone=\"blocked\"] { border-color: rgb(217, 160, 59); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-pointer-guide[data-tone=\"assessment\"] { border-color: rgb(139, 92, 246); background: rgb(245, 243, 255); color: rgb(91, 33, 182); }\n.diss-pointer-guide__cursor { display: grid; width: 1.8rem; height: 1.8rem; flex: 0 0 auto; place-items: center; border: 1px solid; border-radius: 0.48rem; background: rgb(255, 255, 255); font-size: 1rem; font-weight: 900; }\n.diss-pointer-guide__body { display: grid; min-width: 0px; gap: 0.08rem; }\n.diss-pointer-guide__body strong { color: currentcolor; font-size: 0.72rem; font-weight: 900; }\n.diss-pointer-guide__body span { color: currentcolor; font-size: 0.68rem; line-height: 1.35; opacity: 0.9; }\n.diss-workflow li[data-state=\"complete\"] { border-color: rgba(153, 246, 228, 0.55); background: rgba(13, 148, 136, 0.35); }\n.diss-workflow li[data-state=\"current\"] { border-color: rgb(253, 230, 138); background: rgb(254, 243, 199); color: rgb(66, 32, 6); box-shadow: rgba(246, 198, 91, 0.22) 0px 0px 0px 2px; }\n.diss-workflow li[data-state=\"upcoming\"] { opacity: 0.72; }\n[data-dissection-root][data-assessment-mode=\"true\"] :where(.diss-stage__handoff, .diss-field-monitor, .diss-procedure, .diss-overlay-actions) { display: none !important; }\n@media (max-width: 700px) {\n  .diss-next-action { position: static; grid-template-columns: auto minmax(0px, 1fr); }\n  .diss-next-action__actions { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; min-width: 0px; }\n  .diss-stage__telemetry-grid, .diss-field-readiness__checks { grid-template-columns: repeat(2, minmax(0px, 1fr)); }\n  .diss-learning-check { grid-template-columns: 1fr; }\n  .diss-learning-check__phases { justify-content: flex-start; }\n  .diss-learning-check__options { grid-template-columns: 1fr; }\n}\n@media (max-height: 500px) {\n  .diss-next-action { position: static; }\n}\n@media (max-width: 430px) {\n  .diss-next-action { grid-template-columns: 1fr; }\n  .diss-next-action__step { width: auto; height: auto; min-height: 2.5rem; padding: 0.35rem 0.55rem; justify-self: start; }\n  .diss-next-action__actions { grid-column: auto; grid-template-columns: 1fr; }\n}\n.diss-workspace { grid-template-columns: minmax(0px, 1fr) minmax(18rem, 21rem); align-items: start; display: grid !important; gap: 1rem !important; }\n.diss-primary-column, .diss-sidebar { min-width: 0px; }\n.diss-primary-column { display: grid; gap: 0.85rem; }\n.diss-stage { overflow: hidden; padding: 0.8rem; border: 1px solid rgb(190, 205, 224); border-radius: 1.15rem; background: linear-gradient(rgb(255, 255, 255), rgb(245, 249, 255)); box-shadow: rgba(15, 23, 42, 0.08) 0px 12px 30px; }\n.diss-stage__header { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 0.65rem; }\n.diss-stage__eyebrow { color: rgb(15, 118, 110); font-size: 0.62rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }\n.diss-stage__title { margin: 0.14rem 0px 0px; color: rgb(16, 35, 63); font-size: 0.92rem; font-weight: 900; }\n.diss-stage__status { max-width: 50%; padding: 0.42rem 0.6rem; border: 1px solid rgb(203, 220, 240); border-radius: 999px; background: rgb(238, 246, 255); color: rgb(36, 81, 127); font-size: 0.68rem; font-weight: 850; text-align: right; }\n.diss-stage__handoff { display: flex; min-width: 0px; flex-wrap: wrap; align-items: center; gap: 0.28rem 0.55rem; margin: -0.1rem 0px 0.58rem; padding: 0.48rem 0.58rem; border: 1px solid rgb(147, 180, 215); border-radius: 0.7rem; background: rgb(239, 246, 255); color: rgb(23, 77, 134); }\n.diss-stage__handoff[data-tone=\"ready\"], .diss-stage__handoff[data-tone=\"complete\"] { border-color: rgb(5, 150, 105); background: rgb(236, 253, 245); color: rgb(6, 95, 70); }\n.diss-stage__handoff[data-tone=\"caution\"] { border-color: rgb(217, 119, 6); background: rgb(255, 251, 235); color: rgb(120, 53, 15); }\n.diss-stage__handoff[data-tone=\"restricted\"] { border-color: rgb(185, 28, 28); background: rgb(255, 241, 242); color: rgb(136, 19, 55); }\n.diss-stage__handoff-glyph { display: inline-grid; width: 1.35rem; height: 1.35rem; flex: 0 0 auto; place-items: center; border: 1px solid; border-radius: 999px; font-size: 0.72rem; font-weight: 900; }\n.diss-stage__handoff strong { min-width: 0px; font-size: 0.72rem; }\n.diss-stage__handoff-tool { color: inherit; font-size: 0.66rem; font-weight: 800; opacity: 0.9; }\n.diss-stage__handoff-progress { margin-left: auto; font-size: 0.64rem; font-weight: 900; white-space: nowrap; }\n.diss-stage__telemetry { display: grid; gap: 0.46rem; margin: -0.04rem 0px 0.65rem; padding: 0.58rem 0.64rem; border: 1px solid rgb(159, 197, 216); border-radius: 0.82rem; background: linear-gradient(110deg, rgb(240, 249, 255) 0%, rgb(248, 251, 255) 54%, rgb(236, 254, 255) 100%); box-shadow: rgba(255, 255, 255, 0.9) 0px 1px 0px inset, rgba(14, 116, 144, 0.08) 0px 5px 14px; color: rgb(22, 78, 99); }\n.diss-stage__telemetry[data-tone=\"caution\"] { border-color: rgb(214, 163, 75); background: linear-gradient(110deg, rgb(255, 251, 235), rgb(255, 247, 237)); color: rgb(120, 53, 15); }\n.diss-stage__telemetry[data-tone=\"danger\"] { border-color: rgb(224, 139, 139); background: linear-gradient(110deg, rgb(255, 241, 242), rgb(255, 247, 237)); color: rgb(136, 19, 55); }\n.diss-stage__telemetry-head { display: flex; min-width: 0px; align-items: center; justify-content: space-between; gap: 0.65rem; }\n.diss-stage__telemetry-head > div { display: grid; min-width: 0px; gap: 0.08rem; }\n.diss-stage__telemetry-kicker { color: currentcolor; font-size: 0.56rem; font-weight: 900; letter-spacing: 0.1em; opacity: 0.72; text-transform: uppercase; }\n.diss-stage__telemetry-head strong { overflow: hidden; color: currentcolor; font-size: 0.75rem; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }\n.diss-stage__telemetry-phase { flex: 0 1 auto; max-width: 48%; overflow: hidden; color: currentcolor; font-size: 0.62rem; font-weight: 850; text-align: right; text-overflow: ellipsis; white-space: nowrap; }\n.diss-stage__telemetry-grid { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 0.38rem; }\n.diss-stage__telemetry-metric { min-width: 0px; padding: 0.34rem 0.42rem; border: 1px solid rgba(125, 174, 194, 0.64); border-radius: 0.55rem; background: rgba(255, 255, 255, 0.72); }\n.diss-stage__telemetry-metric[data-risk=\"true\"] { border-color: rgb(214, 163, 75); background: rgba(255, 251, 235, 0.9); color: rgb(120, 53, 15); }\n.diss-stage__telemetry-metric-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.3rem; }\n.diss-stage__telemetry-metric-head span { overflow: hidden; color: currentcolor; font-size: 0.57rem; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }\n.diss-stage__telemetry-metric-head b { color: currentcolor; font-size: 0.64rem; font-variant-numeric: tabular-nums; }\n.diss-stage__telemetry-metric progress { display: block; width: 100%; height: 0.32rem; margin: 0.24rem 0px 0.2rem; accent-color: rgb(15, 118, 110); }\n.diss-stage__telemetry-metric[data-risk=\"true\"] progress { accent-color: rgb(217, 119, 6); }\n.diss-stage__telemetry-metric-note { display: block; overflow: hidden; color: currentcolor; font-size: 0.53rem; font-weight: 750; opacity: 0.78; text-overflow: ellipsis; white-space: nowrap; }\n.diss-