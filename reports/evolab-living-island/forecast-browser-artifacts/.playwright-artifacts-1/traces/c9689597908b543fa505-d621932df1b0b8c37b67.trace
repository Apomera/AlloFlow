-mutated { border: 2px dashed canvastext; }\n}\n@media print {\n  .ei-commandbar, .ei-desk, .ei-workspace > .ei-main { position: static; }\n  .ei-workspace > .ei-main, .ei-desk-body { max-height: none; overflow: visible; }\n  .ei-desk [hidden] { display: block !important; }\n  .ei-desk-tabs { display: none; }\n  .ei-workspace { display: block; }\n}\n.ei-repeat-evidence { grid-template-columns: minmax(0px, 1fr); background: linear-gradient(125deg, rgb(255, 254, 247), rgb(240, 244, 231)); border-color: rgb(184, 203, 170); }\n.ei-repeat-evidence > .ei-row > div { min-width: 0px; }\n.ei-repeat-evidence h2 { margin-top: 5px; }\n.ei-repeat-outcome { padding: 12px 14px; border: 1px solid rgb(198, 215, 185); border-radius: 12px; background: rgb(229, 237, 218); font-size: 13px; }\n.ei-repeat-outcome p { margin-top: 4px; }\n.ei-repeat-chart { max-width: 620px; width: 100%; margin: auto; background: rgb(255, 254, 249); border: 1px solid rgb(215, 223, 207); border-radius: 12px; padding: 10px; }\n.ei-repeat-chart svg { width: 100%; height: auto; display: block; }\n.ei-repeat-chart text { font-size: 10px; fill: rgb(52, 81, 70); }\n.ei-repeat-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n.ei-repeat-stats > div { padding: 12px; border: 1px solid rgb(211, 222, 199); border-radius: 10px; background: rgb(255, 254, 249); }\n.ei-repeat-stats strong { display: block; font-size: 25px; font-variant-numeric: tabular-nums; margin: 4px 0px; }\n.ei-repeat-stats small { display: block; }\n.ei-repeat-evidence > details { min-width: 0px; }\n.ei-repeat-evidence .ei-table-wrap { max-width: 100%; }\n.ei-repeat-evidence .ei-table-wrap:focus-visible { outline: rgb(174, 89, 29) solid 3px; outline-offset: 3px; }\n.ei-repeat-evidence caption { text-align: left; white-space: normal; }\n.ei-repeat-evidence td small { display: block; }\n.ei-repeat-evidence .ei-kicker { color: rgb(64, 93, 69); }\n.ei-desk .ei-repeat-stats { grid-template-columns: 1fr; }\n.ei-desk .ei-repeat-evidence > 