rtical_evacuation","v":{"s":"Vertical evacuation"}},{"k":"some_pacific_nw_towns_building_dedicat","v":{"s":"Some Pacific NW towns building dedicated tsunami refuges."}},{"k":"ocosta_elementary_westport_wa_2014_was","v":{"s":"Ocosta Elementary, Westport WA (2014) was first US tsunami vertical evacuation school."}},{"k":"reinforced_concrete_platforms_above_pr","v":{"s":"Reinforced concrete platforms above predicted maximum tsunami inundation."}},{"k":"several_more_refuges_built_or_planned_","v":{"s":"Several more refuges built or planned in Long Beach + Westport + Aberdeen."}},{"k":"coastal_subsidence","v":{"s":"Coastal subsidence"}},{"k":"1700_event_subsidence_1_2m_of_coastal_","v":{"s":"1700 event subsidence: 1-2m of coastal land lowered."}},{"k":"ghost_forests_preserve_the_event_cedar","v":{"s":"Ghost forests preserve the event - cedars died when their roots got salted."}},{"k":"same_subsidence_expected_in_next_event","v":{"s":"Same subsidence expected in next event - coast will move inland permanently."}},{"k":"documented_at_copalis_willapa_bay_coos","v":{"s":"Documented at Copalis, Willapa Bay, Coos Bay, and elsewhere."}},{"k":"native_oral_history","v":{"s":"Native oral history"}},{"k":"quileute_makah_hoh_quinault_oral_histo","v":{"s":"Quileute, Makah, Hoh, Quinault oral histories preserved the 1700 event."}},{"k":"stories_of_thunderbird_whale_battle_in","v":{"s":"Stories of Thunderbird + Whale battle interpreted as quake + tsunami metaphor."}},{"k":"native_communities_understood_the_haza","v":{"s":"Native communities understood the hazard before science confirmed it."}},{"k":"modern_tsunami_evacuation_routes_follo","v":{"s":"Modern tsunami evacuation routes follow ancestral safety paths."}},{"k":"famous_outcrops_type_localities","v":{"s":"Famous Outcrops + Type Localities"}},{"k":"30_famous_outcrops_where_major_geologi","v":{"s":"30 famous outcrops where major geological discoveries were made or that preserve unique records of Earth history. Many are accessible 