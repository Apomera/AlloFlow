ue_ready","v":{"s":"Presenter cue ready"}},{"k":"presenter_cues","v":{"s":"Private presenter cues"}},{"k":"presenter_cues_privacy","v":{"s":"Teacher-only on this browser. These cues are not added to the resource or sent to students."}},{"k":"presenter_cues_session_only","v":{"s":"Saved locally on this browser."}},{"k":"presenter_look_for","v":{"s":"Look / listen for"}},{"k":"presenter_look_for_placeholder","v":{"s":"Evidence of understanding, likely misconception, or access need…"}},{"k":"presenter_next_move","v":{"s":"Next move"}},{"k":"presenter_next_move_placeholder","v":{"s":"Transition, checkpoint, or differentiated follow-up…"}},{"k":"presenter_say_ask","v":{"s":"Say / ask"}},{"k":"presenter_say_ask_placeholder","v":{"s":"Opening question, explanation, or discussion prompt…"}},{"k":"previous","v":{"s":"Select previous lesson step"}},{"k":"recent_activity","v":{"s":"Recent activity"}},{"k":"release_opened_supports","v":{"s":"Release opened supports"}},{"k":"remove_checkpoint","v":{"s":"Remove"}},{"k":"return_lesson_path","v":{"s":"Lesson path"}},{"k":"review_launch_checkpoint","v":{"s":"Review and launch"}},{"k":"review_next_step","v":{"s":"Review next step"}},{"k":"revised","v":{"s":"revised"}},{"k":"saved_for_session","v":{"s":"Saved for live session"}},{"k":"select_activity_cohort","v":{"s":"Select an activity cohort for follow-up"}},{"k":"selected_step","v":{"s":"selected step"}},{"k":"send_follow_up","v":{"s":"Send selected follow-up"}},{"k":"send_group","v":{"s":"Send to group"}},{"k":"send_selected_resource","v":{"s":"Send selected resource"}},{"k":"send_selected_step","v":{"s":"Send step"}},{"k":"send_student","v":{"s":"Send to student"}},{"k":"steps","v":{"s":"steps"}},{"k":"student_paced_hint","v":{"s":"Student-paced: opening changes your view while students keep navigation control."}},{"k":"students_needing_attention","v":{"s":"Students needing attention"}},{"k":"submitted","v":{"s":"submitted"}},{"k":"success_criterion","v":{"s":"Success criterion"}