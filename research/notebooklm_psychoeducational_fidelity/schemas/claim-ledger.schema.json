{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/notebooklm-psychoed/claim-ledger.schema.json",
  "title": "Synthetic Case Gold-Standard Claim Ledger",
  "type": "object",
  "required": ["case_id", "ledger_version", "entries", "ledger_validation"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9_-]+$"},
    "ledger_version": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ledger_id",
          "entry_type",
          "canonical_statement",
          "applicable_sections",
          "source_locators",
          "must_mention",
          "severity_if_wrong"
        ],
        "properties": {
          "ledger_id": {"type": "string"},
          "entry_type": {
            "enum": [
              "fact",
              "number",
              "attribution",
              "temporal_fact",
              "allowed_interpretation",
              "prohibited_inference",
              "deliberate_missingness",
              "deliberate_conflict",
              "eligibility_rule",
              "expected_eligibility_conclusion",
              "recommendation_anchor",
              "required_qualification"
            ]
          },
          "canonical_statement": {"type": "string"},
          "acceptable_paraphrases_or_bounds": {
            "type": "array",
            "items": {"type": "string"}
          },
          "prohibited_expansions": {
            "type": "array",
            "items": {"type": "string"}
          },
          "applicable_sections": {
            "type": "array",
            "items": {"type": "string"}
          },
          "source_locators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string"},
                "support_role": {
                  "enum": ["primary", "corroborating", "conflicting", "rule"]
                }
              },
              "additionalProperties": false
            }
          },
          "must_mention": {"type": "boolean"},
          "required_when": {"type": "string"},
          "severity_if_wrong": {"type": "integer", "minimum": 0, "maximum": 4},
          "severity_if_omitted": {"type": "integer", "minimum": 0, "maximum": 4},
          "notes_for_raters": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "ledger_validation": {
      "type": "object",
      "required": ["review_status"],
      "properties": {
        "review_status": {
          "enum": ["not_reviewed", "needs_revision", "approved"]
        },
        "reviewer_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "adjudication_notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

