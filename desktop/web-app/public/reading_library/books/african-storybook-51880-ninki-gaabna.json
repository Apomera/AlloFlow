  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840302.png",
      "text": "ITuulo la dhaho Kalum, waxaa degganaa nin la dhahoMuha, in kastoo aanay jirin cid garanaysa. Reer tuuladi majecleen waayo wuu yara.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=1",
      "sourceDigest": "sha256:3020fbae84278fd15b2e73b5ca9d17aa696d8d86e3d38a8c4d676caa2b5b3866"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840303.png",
      "text": "Waxay u bixiyeen 'ninkii gaaban.' Taasi waxay murugo ku abuurtay Muha. Wuxuu hoos friistaa geed canbe ah asaga oo layaabaan waxa aynan dadku saaxiibtinimo u la heyn.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=2",
      "sourceDigest": "sha256:78e029769b458bce28e1b9fad500e5e6e0101fb58219ecce31ffce44b3f8b6b2"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840304.png",
      "text": "Maalin ayaa dugsigii tuuladii waxaa ka kacay dab. Qof kasta wuu cabsaday wana la walwalay. Muha wuu deganaa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=3",
      "sourceDigest": "sha256:74543e763993a6b804c1040d4e3dcfde65408e84f0981804bb4a7234889affc6"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840305.png",
      "text": "Si deg-deg ah ayuu orday si uu guriga u galo. Wuxu so qaatay baaldi way oo biyo ah. Dib buu u orday oo biyo wuxuu ku shubay dubki.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=4",
      "sourceDigest": "sha256:f7b2c5d47695c2f8225e7090aa25834aead48545f203489eaf5145fb97088d0f"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840306.png",
      "text": "Muha inta uu hor iyo dib u ordayay, dadki kale ee tuulada ayaa raacay tusaalahi. Dabka ayaa burba damay. Reer tuuladi faraxsana, waxay kor uqaaden Muha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=5",
      "sourceDigest": "sha256:98aafe15621c87a5ea64735a334afed9f8c6faa7fced5e34c37bec9bf23c6f34"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840307.png",
      "text": "Dadku waxay bilaabeen inay dheelaan. Markii ay dheelayeen ayaa nin weydiiyey, \"Ninka gaaban magacii?\" Muha ayaa ugu jawaabay, \"Magacaygu waa Muha.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=6",
      "sourceDigest": "sha256:ce50fbc2c58c15a536cc6a42987483bdbf74feeec5c85d50c4e995228d6e4008"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840308.png",
      "text": "Dadkii tuulada degganaa waxay bilaabeen inay ammaanaan, \"Muha, Muha, Muha.\" Laga bilaabo maalintas qofna ma oran ninki gaabna.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=7",
      "sourceDigest": "sha256:834549443de43328138ff03752230f0dc5d419be2705dda24766685acd93db76"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/64840309.png",
      "text": "Dadki tuulada waxay u dhiseen Muha guri cusub. Wuxu ka gursaday tuulada gabar la dhaho Michine. Farxad bay wada noolayan wixi inta ka dandeyey.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=51880#page=8",
      "sourceDigest": "sha256:ba8bbf930d207db048e21c4e6be4ce873ddb1eddb430d1dde171d32c3ab21a3b"
    }
  ],
