{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alloflow.org/schemas/portable-remediation-plan-v1.json",
  "title": "AlloFlow portable remediation plan",
  "$comment": "Runtime validation additionally enforces page-count bounds, unique source pages, safe link schemes, exactly one h1, no skipped heading levels, blocked document types, aggregate image/text budgets, and — for the optional block `id` — uniqueness, non-reserved names (not `main-content`, no `alloflow-` prefix), and that every `#target` href resolves to a declared id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "blocks",
    "review_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "source_page_count",
        "source_sha256",
        "document_type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "source_page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 returned by the packaged source-info command for the exact source PDF."
        },
        "document_type": {
          "enum": [
            "handout",
            "report",
            "article",
            "booklet",
            "other",
            "form",
            "signed-record",
            "legal-record"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 1000
        },
        "variant": {
          "enum": [
            "original",
            "translated",
            "simplified"
          ],
          "description": "Marks a plan that deliberately transforms the source: 'translated' (document.language differs from the source language) or 'simplified' (plain-language rewrite). Both require a review_notes entry describing the transformation. Default: original."
        }
      }
    },
    "source_pages": {
      "type": "array",
      "description": "Host-extracted page text used for plan-internal completeness checks; it is not independently extracted or verified by the packaged scripts.",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "text"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "level",
              "text",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "heading"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "paragraph"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "runs": {
                "$ref": "#/$defs/runs"
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "blockquote"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "cite": {
                "type": "string",
                "maxLength": 2000
              },
              "runs": {
                "$ref": "#/$defs/runs"
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ordered",
              "items",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "list"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "item_runs": {
                "type": "array",
                "maxItems": 1000,
                "description": "Optional inline styling, one entry per list item, in the same order.",
                "items": {
                  "$ref": "#/$defs/runs"
                }
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "caption",
              "columns",
              "rows",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5000,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "maxLength": 20000
                  }
                }
              },
              "row_headers": {
                "type": "boolean"
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              },
              "cell_runs": {
                "type": "array",
                "maxItems": 5000,
                "description": "Optional inline styling/links for data cells: one entry per row (null to skip a row), each an array with one entry per cell (null to skip a cell).",
                "items": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "$ref": "#/$defs/runs"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "alt",
              "decorative",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "alt": {
                "type": "string",
                "maxLength": 4000
              },
              "decorative": {
                "type": "boolean"
              },
              "path": {
                "type": "string",
                "maxLength": 1000
              },
              "caption": {
                "type": "string",
                "maxLength": 4000
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "decorative"
                  ],
                  "properties": {
                    "decorative": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "alt": {
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text",
              "url",
              "source_page"
            ],
            "properties": {
              "type": {
                "const": "link"
              },
              "id": {
                "$ref": "#/$defs/block_id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "^(?:#|https?:|mailto:|tel:)"
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "page"
            ],
            "properties": {
              "type": {
                "const": "page_break"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        ]
      }
    },
    "review_notes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    }
  },
  "$defs": {
    "block_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "Optional stable anchor id for this block, so runs can carry working in-document '#id' links (e.g. footnote markers to footnotes). Must be unique across the plan; 'main-content' and the 'alloflow-' prefix are reserved. Runtime validation rejects any '#target' href with no matching declared id."
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "Inline styling and links overlay. Strictly additive: concatenating every run's text MUST reproduce the block's text exactly, so styling and links can never add, drop, or alter content. A run with href renders as a hyperlink (safe schemes only); style and href may combine. Runtime validation rejects a mismatch.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "style": {
            "enum": [
              "normal",
              "emphasis",
              "strong"
            ],
            "default": "normal"
          },
          "href": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?:#|https?:|mailto:|tel:)",
            "description": "Optional link target for this run. Same safe-scheme rule as the link block."
          }
        }
      }
    }
  }
}
