r_all_animation_keyframes_cleared","v":{"s":"All animation keyframes cleared."}},{"k":"sr_no_static_depth_map_is_available_return_to_stati","v":{"s":"No static depth map is available. Return to Static mode and draw one first."}},{"k":"sr_rendering_animated_stereogram","v":{"s":"Rendering animated stereogram."}},{"k":"sr_ai_motion_animation_rendered","v":{"s":"AI motion animation rendered."}},{"k":"sr_animation_rendered","v":{"s":"Animation rendered."}},{"k":"sr_stereogram_animation_reset","v":{"s":"Stereogram animation reset."}},{"k":"sr_animated_stereogram_paused","v":{"s":"Animated stereogram paused."}},{"k":"sr_animated_stereogram_playing","v":{"s":"Animated stereogram playing."}},{"k":"contrast_pass","v":{"s":"Pass"}},{"k":"contrast_fail","v":{"s":"Fail"}},{"k":"contrast_badge_aa_large","v":{"s":"AA Large"}},{"k":"contrast_badge_aa_normal","v":{"s":"AA Normal"}},{"k":"contrast_badge_aaa_normal","v":{"s":"AAA Normal"}},{"k":"contrast_sample_sizes","v":{"s":"The bold line above is 24-pixel large text. The smaller line is 14-pixel normal text. That is why the checks below use two different targets."}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"art_design_studio","v":{"s":"🎨 Art & Design Studio"}},{"k":"launch_3d_architecture_studio","v":{"s":"Launch 3D Architecture Studio"}},{"k":"3d_builder","v":{"s":"🏗️ 3D Builder →"}},{"k":"toggle_studio_tour","v":{"s":"Toggle studio tour"}},{"k":"welcome_to_the_art_design_studio","v":{"s":"🎨 Welcome to the Art & Design Studio!"}},{"k":"explore_15_interactive_tools_that_teac","v":{"s":"Explore 15 interactive tools that teach color theory, mathematical art, generative design, and visual accessibility. Each tab is a different creative canvas. Here’s what you can create:"}},{"k":"color_wheel","v":{"s":"Color Wheel"}},{"k":"explore_hsl_color_space_interactively","v":{"s":"Explore HSL color space interactively"}},{"k":"color_mixer","v":{"s":"Color Mixer"}},{"k":"mix_paints_with_subtractive_color_theo","v":{"s":"Mix paints with subtractive color theory"}},{"k":"pixel_art","v":{"s":"Pixel Art"}},{"k":"create_pixel_art_on_a_grid_canvas","v":{"s":"Create pixel art on a grid canvas"}},{"k":"symmetry","v":{"s":"Symmetry"}},{"k":"draw_with_rotational_reflective_symmet","v":{"s":"Draw with rotational & reflective symmetry"}},{"k":"spirograph","v":{"s":"Spirograph"}},{"k":"mathematical_spiral_patterns_hypotroch","v":{"s":"Mathematical spiral patterns (hypotrochoids)"}},{"k":"generative","v":{"s":"Generative"}},{"k":"flow_fields_particles_starfields_auror","v":{"s":"Flow fields, particles, starfields, aurora"}},{"k":"spin_art","v":{"s":"Spin Art"}},{"k":"virtual_spin_painting_with_physics","v":{"s":"Virtual spin painting with physics"}},{"k":"string_art","v":{"s":"String Art"}},{"k":"geometric_string_patterns_on_pegs","v":{"s":"Geometric string patterns on pegs"}},{"k":"op_art","v":{"s":"Op Art"}},{"k":"optical_illusions_and_visual_tricks","v":{"s":"Optical illusions and visual tricks"}},{"k":"tessellation","v":{"s":"Tessellation"}},{"k":"repeating_tile_patterns_like_m_c_esche","v":{"s":"Repeating tile patterns like M.C. Escher"}},{"k":"fractals","v":{"s":"Fractals"}},{"k":"mandelbrot_julia_sets_sierpinski_trian","v":{"s":"Mandelbrot, Julia sets, Sierpinski triangle"}},{"k":"gradient","v":{"s":"Gradient"}},{"k":"design_and_export_css_gradient_pattern","v":{"s":"Design and export CSS gradient patterns"}},{"k":"stereogram","v":{"s":"Stereogram"}},{"k":"hidden_3d_images_magic_eye_style","v":{"s":"Hidden 3D images (Magic Eye style)"}},{"k":"game_of_life","v":{"s":"Game of Life"}},{"k":"conway_s_cellular_automaton_emergent_c","v":{"s":"Conway’s cellular automaton — emergent complexity"}},{"k":"contrast","v":{"s":"Contrast"}},{"k":"wcag_contrast_checker_for_accessibilit","v":{"s":"WCAG contrast checker for accessibility"}},{"k":"educational_concepts","v":{"s":"💡 Educational Concepts"}},{"k":"color_theory_additive_vs_subtractive_m","v":{"s":"Color theory (additive vs subtractive mixing, complementary colors, HSL/RGB), mathematical curves (hypotrochoids, Lissajous), fractals & self-similarity, cellular automata & emergence, tessellation geometry, op art visual perception, WCAG accessibility standards, and computational art. Every tool teaches the math behind the beauty."}},{"k":"got_it_let_s_create","v":{"s":"Got it — let’s create! 🎨"}},{"k":"art_studio_sections","v":{"s":"Art Studio sections"}},{"k":"color_wheel_2","v":{"s":"Color Wheel"}},{"k":"color_mixer_2","v":{"s":"Color Mixer"}},{"k":"pixel_art_2","v":{"s":"Pixel Art"}},{"k":"symmetry_2","v":{"s":"Symmetry"}},{"k":"spirograph_2","v":{"s":"Spirograph"}},{"k":"generative_2","v":{"s":"Generative"}},{"k":"spin_art_2","v":{"s":"Spin Art"}},{"k":"string_art_2","v":{"s":"String Art"}},{"k":"op_art_2","v":{"s":"Op Art"}},{"k":"tessellation_2","v":{"s":"Tessellation"}},{"k":"fractals_2","v":{"s":"Fractals"}},{"k":"gradient_2","v":{"s":"Gradient"}},{"k":"stereogram_2","v":{"s":"Stereogram"}},{"k":"game_of_life_2","v":{"s":"Game of Life"}},{"k":"contrast_2","v":{"s":"Contrast"}},{"k":"harmony","v":{"s":"Harmony"}},{"k":"color_wheel_hsl_hsv_complementary_pair","v":{"s":"Color Wheel — HSL/HSV + complementary pairs"}},{"k":"hue_0_360_around_the_wheel_saturation_","v":{"s":"Hue (0-360 around the wheel), saturation (purity), lightness (brightness). Complementary across, analogous adjacent, triadic 120° apart. Newton put the spectrum on a wheel in 1666."}},{"k":"color_mixer_subtractive_vs_additive","v":{"s":"Color Mixer — subtractive vs additive"}},{"k":"paint_and_print_subtractive_cmy_mixes_","v":{"s":"Paint and print = subtractive (CMY mixes to dark); light and screens = additive (RGB mixes to white). Same world, completely different math — a printer thinks in K plates, a TV thinks in Hz."}},{"k":"pixel_art_bitmap_craft_at_8_8_to_32_32","v":{"s":"Pixel Art — bitmap craft at 8×8 to 32×32"}},{"k":"each_pixel_is_a_deliberate_decision_ne","v":{"s":"Each pixel is a deliberate decision. NES sprites famously fit a hero into 16×16 with a 4-color palette. Bresenham’s line algorithm draws diagonals without floats."}},{"k":"symmetry_reflection_rotation_glide","v":{"s":"Symmetry — reflection, rotation, glide"}},{"k":"bilateral_mirror_rotational_n_fold_poi","v":{"s":"Bilateral (mirror), rotational (n-fold), point. The 17 wallpaper groups classify every possible repeating 2D pattern — Escher’s entire body of work."}},{"k":"spirograph_hypotrochoid_roulettes","v":{"s":"Spirograph — hypotrochoid roulettes"}},{"k":"a_small_circle_rolls_inside_a_big_one_","v":{"s":"A small circle rolls inside a big one, pen offset from center. Ratio of radii determines petal count; offset sets thickness. Toy patented 1965, math from 1700s."}},{"k":"generative_algorithm_randomness_as_art","v":{"s":"Generative — algorithm + randomness as artist"}},{"k":"sol_lewitt_wrote_instructions_the_wall","v":{"s":"Sol LeWitt wrote instructions; the wall installer was the executor. Today: Processing, p5.js, Cinder. “The artist is the rule, not the result.”"}},{"k":"spin_art_centripetal_physics_in_paint","v":{"s":"Spin Art — centripetal physics in paint"}},{"k":"drop_paint_spin_watch_it_fling_outward","v":{"s":"Drop paint, spin, watch it fling outward in spirals. Damien Hirst made millions selling spin paintings. Same physics as a salad spinner; F = mω²r."}},{"k":"string_art_curves_from_straight_lines","v":{"s":"String Art — curves from straight lines"}},{"k":"connect_every_n_th_nail_an_envelope_cu","v":{"s":"Connect every n-th nail; an envelope curve emerges. Mary Everest Boole introduced this as classroom math c. 1900. The straight-line cardioid is still hypnotic."}},{"k":"op_art_fooling_the_visual_system","v":{"s":"Op Art — fooling the visual system"}},{"k":"bridget_riley_s_moir_fields_vasarely_s","v":{"s":"Bridget Riley’s moiré fields, Vasarely’s grids. The brain’s motion-detection edge cells over-fire on rapidly alternating contrast — the page appears to *vibrate*."}},{"k":"tessellation_the_17_wallpaper_groups","v":{"s":"Tessellation — the 17 wallpaper groups"}},{"k":"every_periodic_2d_tiling_fits_one_of_1","v":{"s":"Every periodic 2D tiling fits one of 17 symmetry groups. Escher figured this out by visiting the Alhambra in 1936; he then spent 30 years exhausting the catalogue."}},{"k":"fractal_self_similar_at_every_scale","v":{"s":"Fractal — self-similar at every scale"}},{"k":"mandelbrot_1975_cauliflower_coastlines","v":{"s":"Mandelbrot 1975. Cauliflower, coastlines, blood vessels, lightning, lung alveoli — all fractal. “Clouds are not spheres, mountains are not cones, bark is not smooth.”"}},{"k":"gradient_smooth_color_transitions","v":{"s":"Gradient — smooth color transitions"}},{"k":"css_gives_you_linear_radial_and_conic_","v":{"s":"CSS gives you linear, radial, and conic gradients. Real rainbows have continuous spectra (no discrete bands) — the 7 “colors of the rainbow” were Newton’s arbitrary choice for musical reasons."}},{"k":"stereogram_3d_from_a_flat_page","v":{"s":"Stereogram — 3D from a flat page"}},{"k":"90s_magic_eye_craze_each_eye_sees_a_sl","v":{"s":"90s Magic Eye craze. Each eye sees a slightly shifted version; if you cross or diverge correctly, the brain fuses them into depth. ~5% of people genuinely can’t — not their fault."}},{"k":"game_of_life_4_rules_infinite_emergenc","v":{"s":"Game of Life — 4 rules, infinite emergence"}},{"k":"conway_1970_born_3_survive_2_3_else_di","v":{"s":"Conway, 1970. Born=3, survive=2-3, else die. Gliders glide, oscillators oscillate, glider guns shoot. Conway proved Life is Turing-complete — you can build a CPU in cells."}},{"k":"contrast_wcag_4_5_1_3_1_apca","v":{"s":"Contrast — WCAG 4.5:1 / 3:1 / APCA"}},{"k":"wcag_2_1_normal_text_4_5_1_large_3_1_w","v":{"s":"WCAG 2.1: normal text 4.5:1, large 3:1. Why low contrast hurts low-vision readers, even if you can read it. APCA (the WCAG 3.0 successor) uses perceptual lightness, not raw luminance ratio."}},{"k":"interactive_color_wheel","v":{"s":"Interactive color wheel"}},{"k":"selected_color","v":{"s":"🎯 Selected Color"}},{"k":"click_the_wheel_to_pick_a_hue","v":{"s":"Click the wheel to pick a hue"}},{"k":"saturation","v":{"s":"Saturation %"}},{"k":"lightness","v":{"s":"Lightness %"}},{"k":"color_harmony","v":{"s":"🔗 Color Harmony"}},{"k":"color_a","v":{"s":"Color A"}},{"k":"result","v":{"s":"🎯 Result"}},{"k":"color_mix_ratio","v":{"s":"Color mix ratio"}},{"k":"color_b","v":{"s":"Color B"}},{"k":"current_color","v":{"s":"Current color"}},{"k":"brush","v":{"s":"Brush"}},{"k":"eraser","v":{"s":"Eraser"}},{"k":"fill","v":{"s":"Fill"}},{"k":"clear","v":{"s":"Clear"}},{"k":"clear_2","v":{"s":"🗑 Clear"}},{"k":"export_png","v":{"s":"📥 Export PNG"}},{"k":"grid_size","v":{"s":"Grid size"}},{"k":"palettes","v":{"s":"🎨 Palettes"}},{"k":"retro","v":{"s":"🕹 Retro"}},{"k":"nature","v":{"s":"🌿 Nature"}},{"k":"warm","v":{"s":"🔥 Warm"}},{"k":"cool","v":{"s":"❄ Cool"}},{"k":"neon","v":{"s":"💥 Neon"}},{"k":"pixel_art_canvas","v":{"s":"Pixel art canvas"}},{"k":"folds","v":{"s":"✨ Folds:"}},{"k":"brush_size","v":{"s":"Brush size"}},{"k":"solid","v":{"s":"🖌 Solid"}},{"k":"rainbow","v":{"s":"🌈 Rainbow"}},{"k":"clear_3","v":{"s":"🗑 Clear"}},{"k":"export_png_2","v":{"s":"📥 Export PNG"}},{"k":"fullscreen","v":{"s":"Fullscreen"}},{"k":"fullscreen_2","v":{"s":"🔍 Fullscreen"}},{"k":"palettes_2","v":{"s":"🎨 Palettes"}},{"k":"retro_2","v":{"s":"🕹 Retro"}},{"k":"nature_2","v":{"s":"🌿 Nature"}},{"k":"warm_2","v":{"s":"🔥 Warm"}},{"k":"cool_2","v":{"s":"❄ Cool"}},{"k":"neon_2","v":{"s":"💥 Neon"}},{"k":"symmetry_drawing_canvas","v":{"s":"Symmetry drawing canvas"}},{"k":"learn_about_symmetry","v":{"s":"🔮 Learn About Symmetry"}},{"k":"radial_symmetry","v":{"s":"Radial symmetry"}},{"k":"repeats_a_pattern_around_a_central_poi","v":{"s":" repeats a pattern around a central point. In "}},{"k":"starfish_5_fold_snowflakes_6_fold_and_","v":{"s":", starfish (5-fold), snowflakes (6-fold), and flowers show this everywhere."}},{"k":"tile_patterns_quilts_floor_mosaics","v":{"s":" Tile patterns, quilts, floor mosaics. "}},{"k":"snowflakes_honeycombs_islamic_star_pat","v":{"s":" Snowflakes, honeycombs, Islamic star patterns. "}},{"k":"mandala_art_rose_windows_in_cathedrals","v":{"s":" Mandala art, rose windows in cathedrals."}},{"k":"cultural_connections","v":{"s":"Cultural connections:"}},{"k":"islamic_geometric_art_uses_radial_symm","v":{"s":" Islamic geometric art uses radial symmetry extensively. Celtic knots, Navajo textiles, and Japanese family crests (“mon”) all rely on rotational symmetry."}},{"k":"mirror_mode","v":{"s":"Mirror mode"}},{"k":"uses_bilateral_reflection_symmetry_the","v":{"s":" uses bilateral (reflection) symmetry — the kind found in faces, butterflies, and leaves. It’s the most common symmetry in the animal kingdom."}},{"k":"rainbow_brush","v":{"s":"Rainbow brush"}},{"k":"cycles_through_the_color_spectrum_as_y","v":{"s":" cycles through the color spectrum as you draw, creating gradient-like mandala effects automatically."}},{"k":"foreground_text","v":{"s":"Foreground (Text)"}},{"k":"light","v":{"s":"Light"}},{"k":"background","v":{"s":"Background"}},{"k":"light_2","v":{"s":"Light"}},{"k":"sample_text","v":{"s":"Sample Text"}},{"k":"the_quick_brown_fox_jumps_over_the_laz","v":{"s":"The quick brown fox jumps over the lazy dog"}},{"k":"complementary_2_opposites","v":{"s":"⚫⚪ Complementary (2 opposites)"}},{"k":"maximum_contrast_pop_art_brand_accents","v":{"s":"Maximum contrast. Pop art, brand accents."}},{"k":"triadic_3_equidistant","v":{"s":"🔺 Triadic (3 equidistant)"}},{"k":"vibrant_but_balanced_childrens_books_c","v":{"s":"Vibrant but balanced. Childrens books, cartoons."}},{"k":"tetradic_4_corners","v":{"s":"◇ Tetradic (4 corners)"}},{"k":"rich_palette_with_two_opposing_pairs","v":{"s":"Rich palette with two opposing pairs."}},{"k":"analogous_low_saturation_neighbors","v":{"s":"🌅 Analogous (low saturation neighbors)"}},{"k":"calm_harmonious_landscape_painting","v":{"s":"Calm, harmonious — landscape painting."}},{"k":"rainbow_many_vivid_hues","v":{"s":"🌈 Rainbow (many vivid hues)"}},{"k":"energetic_playful_childrens_design","v":{"s":"Energetic, playful — childrens design."}},{"k":"color_harmony_discovery","v":{"s":"🎶 Color harmony discovery"}},{"k":"adjust_base_hue_saturation_lightness_v","v":{"s":"Adjust base hue, saturation, lightness variation, rotation, and palette size. Widget renders a live harmony palette and classifies it into one of 5 discrete harmony types. No score, no reveal — sweep and notice which combinations produce which harmonies."}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_free_text_no_right_answer_w","v":{"s":"Hypothesis (free text — no right answer): What makes a palette feel harmonious vs jarring?"}},{"k":"stuck_show_open_prompts_no_answers","v":{"s":"🤔 Stuck — show open prompts (no answers)"}},{"k":"open_prompts_investigate_by_manipulati","v":{"s":"Open prompts — investigate by manipulating:"}},{"k":"find_the_smallest_palette_that_still_f","v":{"s":"Find the smallest palette that still feels \"complete\" to you."}},{"k":"real_impressionists_used_analogous_pal","v":{"s":"Real impressionists used analogous palettes. Why might that be?"}},{"k":"some_color_schemes_have_proper_names_c","v":{"s":"Some color schemes have proper names (complementary, split-complementary, triadic). Look those up and try to reproduce them."}},{"k":"high_saturation_many_colors_busy_try_d","v":{"s":"High saturation + many colors = busy. Try desaturating with the blend slider — what happens to \"harmony\"?"}},{"k":"i_think_i_understand_color_harmony_now","v":{"s":"I think I understand color harmony now — let me explain it in my own words"}},{"k":"explain_in_your_own_words_how_do_hue_s","v":{"s":"Explain in your own words: how do hue spacing, saturation, and palette size determine \"harmony\"?"}},{"k":"design_note_discrete_5_state_harmony_m","v":{"s":"Design note: discrete 5-state harmony marker; SVG wheel shows palette positions; no \"good palette\" score — by design."}},{"k":"spirograph_controls","v":{"s":"🌀 Spirograph Controls"}},{"k":"outer_radius","v":{"s":"Outer Radius"}},{"k":"inner_radius","v":{"s":"Inner Radius"}},{"k":"pen_offset","v":{"s":"Pen Offset"}},{"k":"draw_speed","v":{"s":"Draw Speed"}},{"k":"clear_4","v":{"s":"🗑 Clear"}},{"k":"export_png_3","v":{"s":"📥 Export PNG"}},{"k":"star","v":{"s":"Star"}},{"k":"flower","v":{"s":"Flower"}},{"k":"lace","v":{"s":"Lace"}},{"k":"atom","v":{"s":"Atom"}},{"k":"spiral","v":{"s":"Spiral"}},{"k":"math_connection","v":{"s":"📚 Math Connection"}},{"k":"spirographs_draw","v":{"s":"Spirographs draw "}},{"k":"hypotrochoid_curves","v":{"s":"hypotrochoid curves"}},{"k":"the_path_traced_by_a_point_on_a_small_","v":{"s":" — the path traced by a point on a small circle rolling inside a larger one. The pattern depends on the "}},{"k":"greatest_common_divisor_of_the_two_rad","v":{"s":" (greatest common divisor) of the two radii. When R/r is a simple fraction, you get fewer petals; complex ratios create intricate, never-repeating paths."}},{"k":"spirograph_canvas","v":{"s":"Spirograph canvas"}},{"k":"style","v":{"s":"🎆 Style:"}},{"k":"flow_field","v":{"s":"Flow Field"}},{"k":"particle_rain","v":{"s":"Particle Rain"}},{"k":"starfield","v":{"s":"Starfield"}},{"k":"aurora","v":{"s":"Aurora"}},{"k":"clear_5","v":{"s":"Clear"}},{"k":"clear_6","v":{"s":"🗑 Clear"}},{"k":"export_png_4","v":{"s":"Export PNG"}},{"k":"export_png_5","v":{"s":"📥 Export PNG"}},{"k":"particle_density","v":{"s":"Particle density"}},{"k":"generative_art_canvas","v":{"s":"Generative art canvas"}},{"k":"click_or_drag_on_the_canvas_to_create_","v":{"s":"👆 Click or drag on the canvas to create particle bursts"}},{"k":"rpm","v":{"s":"🌀 RPM:"}},{"k":"spin_speed_rpm","v":{"s":"Spin speed RPM"}},{"k":"spin_brush_size","v":{"s":"Spin brush size"}},{"k":"clear_7","v":{"s":"🗑 Clear"}},{"k":"export_png_6","v":{"s":"Export PNG"}},{"k":"export_png_7","v":{"s":"📥 Export PNG"}},{"k":"palettes_3","v":{"s":"🎨 Palettes"}},{"k":"retro_3","v":{"s":"🕹 Retro"}},{"k":"nature_3","v":{"s":"🌿 Nature"}},{"k":"warm_3","v":{"s":"🔥 Warm"}},{"k":"cool_3","v":{"s":"❄ Cool"}},{"k":"neon_3","v":{"s":"💥 Neon"}},{"k":"spin_art_canvas","v":{"s":"Spin art canvas"}},{"k":"click_and_drag_to_drip_paint_on_the_sp","v":{"s":"👆 Click and drag to drip paint on the spinning canvas"}},{"k":"physics_of_spin_art","v":{"s":"🌀 Physics of Spin Art"}},{"k":"centrifugal_effect","v":{"s":"Centrifugal effect:"}},{"k":"in_a_spinning_reference_frame_objects_","v":{"s":" In a spinning reference frame, objects experience an outward pseudo-force proportional to their distance from the center and the square of angular velocity (ω²r)."}},{"k":"paint_behavior","v":{"s":"Paint behavior:"}},{"k":"real_spin_art_uses_centripetal_acceler","v":{"s":" Real spin art uses centripetal acceleration to spread paint. Thinner paint flies outward faster; thicker paint creates shorter, more controlled trails."}},{"k":"why_it_s_beautiful","v":{"s":"Why it’s beautiful:"}},{"k":"the_combination_of_rotational_motion_a","v":{"s":" The combination of rotational motion and paint viscosity creates natural spirals and interference patterns. No two spin paintings are ever alike — it’s a form of "}},{"k":"chaotic_art","v":{"s":"chaotic art"}},{"k":"string_art_controls","v":{"s":"🕸 String Art Controls"}},{"k":"shape","v":{"s":"Shape"}},{"k":"circle","v":{"s":"○ Circle"}},{"k":"square","v":{"s":"□ Square"}},{"k":"triangle","v":{"s":"△ Triangle"}},{"k":"star_2","v":{"s":"☆ Star"}},{"k":"nail_count","v":{"s":"Nail Count"}},{"k":"multiplier","v":{"s":"Multiplier"}},{"k":"thread_opacity","v":{"s":"Thread Opacity %"}},{"k":"clear_8","v":{"s":"🗑 Clear"}},{"k":"export_png_8","v":{"s":"📥 Export PNG"}},{"k":"cardioid","v":{"s":"Cardioid"}},{"k":"nephroid","v":{"s":"Nephroid"}},{"k":"star_burst","v":{"s":"Star Burst"}},{"k":"lace_2","v":{"s":"Lace"}},{"k":"weave","v":{"s":"Weave"}},{"k":"math_connection_2","v":{"s":"📚 Math Connection"}},{"k":"string_art_creates","v":{"s":"String art creates "}},{"k":"envelope_curves","v":{"s":"envelope curves"}},{"k":"from_straight_lines_with_a_circle_and_","v":{"s":" from straight lines. With a circle and multiplier of 2, you get a "}},{"k":"the_heart_shaped_curve_seen_in_coffee_","v":{"s":" — the heart-shaped curve seen in coffee cups. Multiplier 3 makes a "}},{"k":"higher_multipliers_create_intricate_pa","v":{"s":". Higher multipliers create intricate patterns governed by "}},{"k":"modular_arithmetic","v":{"s":"modular arithmetic"}},{"k":"nail_n_connects_to_nail_n_m_mod_total","v":{"s":": nail N connects to nail (N × M) mod total."}},{"k":"string_art_canvas","v":{"s":"String art canvas"}},{"k":"op_art_controls","v":{"s":"👁 Op Art Controls"}},{"k":"style_2","v":{"s":"Style"}},{"k":"rings","v":{"s":"◎ Rings"}},{"k":"checker","v":{"s":"▓ Checker"}},{"k":"moir","v":{"s":"≡ Moiré"}},{"k":"vibrate","v":{"s":"≈ Vibrate"}},{"k":"speed","v":{"s":"Speed"}},{"k":"density","v":{"s":"Density"}},{"k":"color_a_hue","v":{"s":"Color A Hue"}},{"k":"color_b_hue","v":{"s":"Color B Hue"}},{"k":"export_png_9","v":{"s":"Export PNG"}},{"k":"export_png_10","v":{"s":"📥 Export PNG"}},{"k":"classic_b_w","v":{"s":"Classic B&W"}},{"k":"neon_pulse","v":{"s":"Neon Pulse"}},{"k":"spiral_vortex","v":{"s":"Spiral Vortex"}},{"k":"wave_grid","v":{"s":"Wave Grid"}},{"k":"the_science_of_op_art","v":{"s":"🧠 The Science of Op Art"}},{"k":"op_art_3","v":{"s":"Op Art"}},{"k":"optical_art_emerged_in_the_1960s_pione","v":{"s":" (Optical Art) emerged in the 1960s, pioneered by "}},{"k":"bridget_riley","v":{"s":"Bridget Riley"}},{"k":"victor_vasarely","v":{"s":"Victor Vasarely"}},{"k":"it_exploits_the_mechanics_of_human_vis","v":{"s":". It exploits the mechanics of human vision to create illusions of movement, vibration, and depth on flat surfaces."}},{"k":"moir_patterns","v":{"s":"Moiré patterns"}},{"k":"appear_when_two_regular_grids_overlap_","v":{"s":" appear when two regular grids overlap at slight angles. Your brain can’t resolve the conflicting patterns, creating phantom curves and waves. This same effect causes the “screen door” shimmer on some fabrics."}},{"k":"vibrating_colors","v":{"s":"Vibrating colors"}},{"k":"occur_when_highly_saturated_complement","v":{"s":" occur when highly saturated complementary colors sit side by side. Your eye’s color receptors compete, creating a buzzing, unstable edge—this is called "}},{"k":"chromatic_vibration","v":{"s":"chromatic vibration"}},{"k":"persistence_of_vision","v":{"s":"Persistence of vision"}},{"k":"lateral_inhibition","v":{"s":"lateral inhibition"}},{"k":"in_the_retina_are_the_main_perceptual_","v":{"s":" in the retina are the main perceptual mechanisms. Concentric ring patterns trigger involuntary eye saccades, making the artwork seem to breathe and pulse."}},{"k":"op_art_canvas","v":{"s":"Op art canvas"}},{"k":"tessellation_controls","v":{"s":"🔷 Tessellation Controls"}},{"k":"base_shape","v":{"s":"Base Shape"}},{"k":"triangle_2","v":{"s":"△ Triangle"}},{"k":"square_2","v":{"s":"□ Square"}},{"k":"hexagon","v":{"s":"⬡ Hexagon"}},{"k":"grid_size_2","v":{"s":"Grid Size"}},{"k":"rotation","v":{"s":"Rotation °"}},{"k":"escher_warp","v":{"s":"Escher Warp"}},{"k":"color_scheme","v":{"s":"Color Scheme"}},{"k":"rainbow_2","v":{"s":"🌈 Rainbow"}},{"k":"warm_4","v":{"s":"🔥 Warm"}},{"k":"cool_4","v":{"s":"❄ Cool"}},{"k":"mono","v":{"s":"▫ Mono"}},{"k":"custom","v":{"s":"🎨 Custom"}},{"k":"clear_colors","v":{"s":"🗑 Clear Colors"}},{"k":"export_png_11","v":{"s":"Export PNG"}},{"k":"export_png_12","v":{"s":"📥 Export PNG"}},{"k":"honeycomb","v":{"s":"Honeycomb"}},{"k":"pinwheel","v":{"s":"Pinwheel"}},{"k":"islamic_star","v":{"s":"Islamic Star"}},{"k":"escher_fish","v":{"s":"Escher Fish"}},{"k":"the_math_of_tessellations","v":{"s":"📏 The Math of Tessellations"}},{"k":"a","v":{"s":"🔷 A "}},{"k":"or_tiling_covers_a_plane_with_shapes_t","v":{"s":" (or tiling) covers a plane with shapes that fit together without gaps or overlaps. Only three regular polygons tile by themselves: "}},{"k":"equilateral_triangles","v":{"s":"equilateral triangles"}},{"k":"60_6_360","v":{"s":" (60° × 6 = 360°), "}},{"k":"90_4_360_and","v":{"s":" (90° × 4 = 360°), and "}},{"k":"regular_hexagons","v":{"s":"regular hexagons"}},{"k":"120_3_360","v":{"s":" (120° × 3 = 360°)."}},{"k":"m_c_escher","v":{"s":"M.C. Escher"}},{"k":"1898_1972_transformed_simple_tilings_i","v":{"s":" (1898–1972) transformed simple tilings into art by warping tile edges. His technique: deform one side of a shape and copy the deformation to the opposite side, so tiles still fit together perfectly. This is the basis of the "}},{"k":"escher_warp_2","v":{"s":"Escher Warp"}},{"k":"islamic_geometric_art","v":{"s":"Islamic geometric art"}},{"k":"uses_tessellations_extensively_combini","v":{"s":" uses tessellations extensively—combining stars, hexagons, and interlocking patterns seen in mosques like the Alhambra. These patterns follow strict mathematical rules while creating breathtaking visual complexity."}},{"k":"tessellations_use_three_key_operations","v":{"s":" Tessellations use three key operations—"}},{"k":"turn_and","v":{"s":" (turn), and "}},{"k":"flip_every_tessellation_can_be_classif","v":{"s":" (flip). Every tessellation can be classified by which of these 17 'wallpaper groups' it belongs to."}},{"k":"click_tiles_to_cycle_their_colors","v":{"s":"👆 Click tiles to cycle their colors"}},{"k":"tessellation_canvas","v":{"s":"Tessellation canvas"}},{"k":"fractal_explorer","v":{"s":"🔮 Fractal Explorer"}},{"k":"fractal_type","v":{"s":"Fractal Type"}},{"k":"mandelbrot","v":{"s":"🌀 Mandelbrot"}},{"k":"julia","v":{"s":"✨ Julia"}},{"k":"burning_ship","v":{"s":"🔥 Burning Ship"}},{"k":"sierpinski","v":{"s":"△ Sierpinski"}},{"k":"max_iterations","v":{"s":"Max Iterations"}},{"k":"zoom","v":{"s":"Zoom"}},{"k":"julia_constant_c","v":{"s":"Julia Constant (c)"}},{"k":"c_real","v":{"s":"c real"}},{"k":"c_imaginary","v":{"s":"c imaginary"}},{"k":"color_scheme_2","v":{"s":"Color Scheme"}},{"k":"classic","v":{"s":"🌈 Classic"}},{"k":"fire","v":{"s":"🔥 Fire"}},{"k":"ocean","v":{"s":"🌊 Ocean"}},{"k":"psychedelic","v":{"s":"💜 Psychedelic"}},{"k":"grayscale","v":{"s":"▫ Grayscale"}},{"k":"reset_view","v":{"s":"↺ Reset View"}},{"k":"export_png_13","v":{"s":"Export PNG"}},{"k":"export_png_14","v":{"s":"📥 Export PNG"}},{"k":"seahorse_valley","v":{"s":"Seahorse Valley"}},{"k":"elephant_valley","v":{"s":"Elephant Valley"}},{"k":"lightning","v":{"s":"Lightning"}},{"k":"spiral_arm","v":{"s":"Spiral Arm"}},{"k":"the_math_of_fractals","v":{"s":"🔬 The Math of Fractals"}},{"k":"the_mandelbrot_set","v":{"s":"The Mandelbrot set"}},{"k":"is_generated_by_iterating_z_z_c_for_ev","v":{"s":" is generated by iterating z = z² + c for every point c in the complex plane. Points where |z| stays bounded (never exceeds 2) are 'in' the set. The boundary reveals "}},{"k":"infinite_complexity","v":{"s":"infinite complexity"}},{"k":"at_every_scale","v":{"s":" at every scale."}},{"k":"julia_sets","v":{"s":"Julia sets"}},{"k":"use_the_same_formula_but_fix_c_and_var","v":{"s":" use the same formula but fix c and vary the starting z. Each Mandelbrot point generates a unique Julia set — points inside the Mandelbrot produce connected Julias; outside points produce dust-like 'Fatou sets'."}},{"k":"the","v":{"s":"🔥 The "}},{"k":"burning_ship_2","v":{"s":"Burning Ship"}},{"k":"fractal_modifies_the_iteration_to_z_re","v":{"s":" fractal modifies the iteration to z = (|Re(z)| + i|Im(z)|)² + c, creating an asymmetric shape resembling a flaming vessel. It was discovered by Michael Michelitsch and Otto Rössler in 1992."}},{"k":"the_2","v":{"s":"△ The "}},{"k":"sierpinski_triangle","v":{"s":"Sierpinski Triangle"}},{"k":"is_built_by_the_chaos_game_pick_a_rand","v":{"s":" is built by the 'chaos game': pick a random point, then repeatedly jump halfway toward a randomly chosen vertex. Remarkably, this random process produces a perfectly self-similar fractal."}},{"k":"benoit_mandelbrot","v":{"s":"Benoit Mandelbrot"}},{"k":"1924_2010_coined_the_word_fractal_from","v":{"s":" (1924–2010) coined the word 'fractal' from Latin 'fractus' (broken). He showed that coastlines, mountains, blood vessels, and stock markets all exhibit fractal geometry — "}},{"k":"nature_is_fractal","v":{"s":"nature is fractal"}},{"k":"fractal_art_canvas","v":{"s":"Fractal art canvas"}},{"k":"double_click_to_zoom_in_scroll_wheel_t","v":{"s":"👆 Double-click to zoom in • Scroll-wheel to zoom in/out"}},{"k":"gradient_lab","v":{"s":"🌈 Gradient Lab"}},{"k":"gradient_type","v":{"s":"Gradient Type"}},{"k":"linear","v":{"s":"↔ Linear"}},{"k":"radial","v":{"s":"◎ Radial"}},{"k":"conic","v":{"s":"🌀 Conic"}},{"k":"gradient_angle","v":{"s":"Gradient angle"}},{"k":"blend_mode","v":{"s":"Blend Mode"}},{"k":"smooth","v":{"s":"Smooth"}},{"k":"hard_edge","v":{"s":"Hard Edge"}},{"k":"color_stops","v":{"s":"Color Stops"}},{"k":"add_stop","v":{"s":"+ Add Stop"}},{"k":"add_stop_2","v":{"s":"+ Add Stop"}},{"k":"export_png_15","v":{"s":"Export PNG"}},{"k":"export_png_16","v":{"s":"📥 Export PNG"}},{"k":"sunset","v":{"s":"Sunset"}},{"k":"northern_lights","v":{"s":"Northern Lights"}},{"k":"vaporwave","v":{"s":"Vaporwave"}},{"k":"golden_hour","v":{"s":"Golden Hour"}},{"k":"deep_space","v":{"s":"Deep Space"}},{"k":"css_output","v":{"s":"📋 CSS Output"}},{"k":"copy","v":{"s":"Copy"}},{"k":"copy_2","v":{"s":"📋 Copy"}},{"k":"the_science_of_gradients","v":{"s":"🎨 The Science of Gradients"}},{"k":"screens_create_gradients_by_mixing","v":{"s":"🌈 Screens create gradients by mixing "}},{"k":"rgb_sub_pixels","v":{"s":"RGB sub-pixels"}},{"k":"each_pixel_blends_red_green_and_blue_l","v":{"s":". Each pixel blends red, green, and blue light at different intensities. A gradient smoothly interpolates these values across space."}},{"k":"hsl_interpolation","v":{"s":"HSL interpolation"}},{"k":"produces_more_perceptually_uniform_gra","v":{"s":" produces more perceptually uniform gradients than RGB. Going from red to blue in RGB passes through muddy grays; in HSL, it sweeps through vivid purples — the way a painter would mix."}},{"k":"real_world_gradients","v":{"s":"Real-world gradients"}},{"k":"are_everywhere_sunsets_rayleigh_scatte","v":{"s":" are everywhere: sunsets (Rayleigh scattering separates wavelengths), rainbows (refraction sorts light by frequency), and ocean depths (water absorbs red first, leaving deep blue)."}},{"k":"conic_gradients","v":{"s":"Conic gradients"}},{"k":"sweep_color_around_a_center_point_like","v":{"s":" sweep color around a center point like a color wheel. They’re used in pie charts, loading spinners, and data visualizations. CSS only added conic-gradient support in 2020!"}},{"k":"designers","v":{"s":"Designers"}},{"k":"use_gradients_to_create_depth_direct_a","v":{"s":" use gradients to create depth, direct attention, and evoke emotion. Warm-to-cool gradients suggest depth (atmospheric perspective); light-to-dark suggests volume (chiaroscuro)."}},{"k":"gradient_designer_canvas","v":{"s":"Gradient designer canvas"}},{"k":"static","v":{"s":"📸 Static"}},{"k":"animate","v":{"s":"Animate"}},{"k":"animate_2","v":{"s":"🎬 Animate"}},{"k":"stereogram_generator","v":{"s":"👓 Stereogram Generator"}},{"k":"depth_brush","v":{"s":"Depth Brush"}},{"k":"near","v":{"s":"⬜ Near"}},{"k":"mid","v":{"s":"🔘 Mid"}},{"k":"far","v":{"s":"⬛ Far"}},{"k":"erase","v":{"s":"🧽 Erase"}},{"k":"stereogram_brush_size","v":{"s":"Stereogram brush size"}},{"k":"pattern_type","v":{"s":"Pattern Type"}},{"k":"b_w","v":{"s":"⚫ B&W"}},{"k":"color","v":{"s":"🎨 Color"}},{"k":"noise","v":{"s":"📺 Noise"}},{"k":"ai","v":{"s":"✨ AI"}},{"k":"depth_strength","v":{"s":"Depth Strength"}},{"k":"pattern_width","v":{"s":"Pattern Width"}},{"k":"ai_stereogram_creator","v":{"s":"✨ AI Stereogram Creator"}},{"k":"describe_an_object_for_a_depth_map_or_","v":{"s":"Describe an object for a depth map or a texture for a pattern..."}},{"k":"generate_ai_depth_map","v":{"s":"Generate AI Depth Map"}},{"k":"generate_depth_map","v":{"s":"⬜ Generate Depth Map"}},{"k":"generate_ai_pattern_tile","v":{"s":"Generate AI Pattern Tile"}},{"k":"generate_ai_base_tile","v":{"s":"🎨 Generate AI Base Tile"}},{"k":"render_stereogram","v":{"s":"👓 Render Stereogram"}},{"k":"clear_9","v":{"s":"Clear"}},{"k":"clear_10","v":{"s":"🗑 Clear"}},{"k":"sphere","v":{"s":"Sphere"}},{"k":"pyramid","v":{"s":"Pyramid"}},{"k":"heart","v":{"s":"Heart"}},{"k":"hi_text","v":{"s":"HI Text"}},{"k":"rings_2","v":{"s":"Rings"}},{"k":"export_stereogram","v":{"s":"Export Stereogram"}},{"k":"export_stereogram_2","v":{"s":"Export Stereogram"}},{"k":"export_stereogram_3","v":{"s":"📥 Export Stereogram"}},{"k":"depth_map_canvas","v":{"s":"🎨 Depth Map Canvas"}},{"k":"white_pops_out_gray_middle_black_far","v":{"s":"White = pops out • Gray = middle • Black = far"}},{"k":"save_depth_map_png","v":{"s":"Save Depth Map PNG"}},{"k":"save_depth_map_png_2","v":{"s":"⬇️ Save Depth Map PNG"}},{"k":"the_science_of_stereograms","v":{"s":"🧠 The Science of Stereograms"}},{"k":"your_eyes_are_6_cm_apart","v":{"s":"Your eyes are ~6 cm apart"}},{"k":"so_each_sees_the_world_from_a_slightly","v":{"s":", so each sees the world from a slightly different angle. Your brain fuses these two views to perceive "}},{"k":"this_is_called","v":{"s":" — this is called "}},{"k":"autostereograms","v":{"s":"Autostereograms"}},{"k":"magic_eye_images_hide_3d_shapes_in_a_r","v":{"s":" (Magic Eye™ images) hide 3D shapes in a repeating pattern. The trick: where the hidden object is ‘close,’ the pattern repeats with a "}},{"k":"shorter_period","v":{"s":"shorter period"}},{"k":"where_it_s_far_the_period_is_longer_yo","v":{"s":"; where it’s ‘far,’ the period is longer. Your brain decodes these period differences as depth."}},{"k":"magic_eye_books","v":{"s":"Magic Eye books"}},{"k":"1993_94_by_tom_baccei_and_cheri_smith_","v":{"s":" (1993–94) by Tom Baccei and Cheri Smith sold over 25 million copies worldwide. The underlying autostereogram technique was pioneered by Dr. Christopher Tyler in 1979."}},{"k":"to_see_the_image_hold_your_face_close_","v":{"s":"🧠 To see the image: hold your face close to the screen, relax your eyes as if looking ‘through’ the image at a distant wall, then slowly pull back. The 3D shape will ‘pop’ into view. This is called "}},{"k":"wall_eyed_parallel_viewing","v":{"s":"wall-eyed (parallel) viewing"}},{"k":"about","v":{"s":"⚠ About "}},{"k":"5_10_of_people","v":{"s":"5–10% of people"}},{"k":"have_difficulty_seeing_stereograms_due","v":{"s":" have difficulty seeing stereograms due to conditions like amblyopia (lazy eye), strabismus (crossed eyes), or other binocular vision differences. This is completely normal!"}},{"k":"stereogram_output","v":{"s":"👓 Stereogram Output"}},{"k":"relax_your_eyes_and_look_through_the_i","v":{"s":"Relax your eyes and look ‘through’ the image to see 3D"}},{"k":"how_to_view","v":{"s":"💡 How to View"}},{"k":"hold_your_face_close_to_the_screen","v":{"s":"Hold your face close to the screen"}},{"k":"relax_your_eyes_try_to_look_through_th","v":{"s":"Relax your eyes — try to look ‘through’ the image at a wall behind it"}},{"k":"slowly_move_back_a_3d_shape_will_emerg","v":{"s":"Slowly move back. A 3D shape will emerge!"}},{"k":"tip_the_two_guide_dots_above_should_ap","v":{"s":"Tip: the two guide dots above should appear as three when your eyes are set correctly"}},{"k":"animated_stereogram_studio","v":{"s":"🎬 Animated Stereogram Studio"}},{"k":"create_animated_3d_stereograms_from_pr","v":{"s":"Create animated 3D stereograms from presets, custom drawings, uploaded images, transforms, or AI-generated depth maps!"}},{"k":"animation_source","v":{"s":"📡 Animation Source"}},{"k":"preset","v":{"s":"Preset"}},{"k":"draw","v":{"s":"Draw"}},{"k":"upload","v":{"s":"Upload"}},{"k":"transform","v":{"s":"Transform"}},{"k":"ai_depth","v":{"s":"AI Depth"}},{"k":"animation_presets","v":{"s":"✨ Animation Presets"}},{"k":"pulse","v":{"s":"Pulse"}},{"k":"spin_cube","v":{"s":"Spin Cube"}},{"k":"wave","v":{"s":"Wave"}},{"k":"heart_2","v":{"s":"Heart"}},{"k":"3d_text","v":{"