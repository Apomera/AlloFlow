    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/2012.png",
      "text": "Pele, ke tlameha ho khutsa tu. E le hore ke mamele 'mele oa ka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=4",
      "sourceDigest": "sha256:817518e5959d28dccb4800d825d3fed4c97cf3092e731d2710223f7f0914618b"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/2013.png",
      "text": "E, joale ke khona ho ikutloa ha ke hema. Ke hemela ka hare le ka ntle, ka hare le ka ntle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=5",
      "sourceDigest": "sha256:9554da76867089381b0b6c889514900c40dd214fe6fa85cbbba400af4c8f66c5"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/2014.png",
      "text": "Ke khona ho hemela holimo. Hhhhhhhhhhh! Le tlase. Mmmmmmm.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=6",
      "sourceDigest": "sha256:c88444ef21171f48f23665d77dc36e272aeed82c59f6144cde2ecdbbc20bd6bf"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/2016.png",
      "text": "Ke khona ho utloa ha pelo ea ka e otla! Thuthuthuuu, thu thuuuu, thuu thuuuuu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=7",
      "sourceDigest": "sha256:938ecff258d2f5fd52adf1325c3e38457b26fc506808a0af9603a5205c4322d6"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/2017.png",
      "text": "Na nka etsa hore pelo ea ka e otle kapele kapa e otlele holimo haholo? E, ka ho qhomela holimo le tlase ka makhetlo a mashome a mabeli.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=8",
      "sourceDigest": "sha256:676fb4e79eb3b08089b3eb0b36de624f9548e2b2203e712e399dce27657dd05f"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/2018.png",
      "text": "Utloa, joale pelo ea ka e otla kapele.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=9",
      "sourceDigest": "sha256:769556ca1bc46917407348488173b87170d4612b65dcd1134b63d8e9f90e4489"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/2019.png",
      "text": "Ha nka beha menoana ea ka methapong ea letsoho, ke utloa ho otla ha pelo ea ka!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=10",
      "sourceDigest": "sha256:3fa196a44fbe9755b7b10ce7b6caa08bf5589f12d11145eff41726e15301cec9"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/2020.png",
      "text": "Ke khona ho ikutloa ha ke ts'eha. Haha, haha, haaah, haaa!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=11",
      "sourceDigest": "sha256:329ff656f7b89b4b8f1fcbf45efe7b8d316bef6596673427d4efcb3d8e369ec5"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/2021.png",
      "text": "Ke khona ho ikutloa ha ke lla. Hii hii hiii!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=12",
      "sourceDigest": "sha256:22fd39667d599102501a87c1fd1bdb84c5fd9c7fe32ab995122fd57f9c3b6a61"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/2022.png",
      "text": "Ke khona ho ikutloa ha ke opa liatla. Pha, pha, pha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=13",
      "sourceDigest": "sha256:8d313382154e9220f5206f447815533bec42cb1c7350641b9c4e926d14e310bd"
    },
    {
