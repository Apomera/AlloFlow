eline","v":{"s":"Suicide & Crisis Lifeline"}},{"k":"crisis_text_line_text_home","v":{"s":"Crisis Text Line — text HOME"}},{"k":"poison_control","v":{"s":"Poison Control"}},{"k":"nami_helpline_mental_health_support","v":{"s":"NAMI HelpLine (mental health support)"}},{"k":"trans_lifeline","v":{"s":"Trans Lifeline"}},{"k":"childhelp_national_child_abuse_hotline","v":{"s":"Childhelp National Child Abuse Hotline"}},{"k":"on_a_phone_tap_a_number_to_call_save_t","v":{"s":"On a phone, tap a number to call. Save the ones you might need ahead of time."}},{"k":"what_to_say_to_the_911_dispatcher","v":{"s":"📞 What to say to the 911 dispatcher"}},{"k":"say_it_in_this_order_location_first_so","v":{"s":"Say it in this order. Location FIRST so help can roll even if your call drops."}},{"k":"text_to_911_maine","v":{"s":"💬 Text-to-911 (Maine)"}},{"k":"use_text_to_911_if_you_re_deaf_hoh_can","v":{"s":"Use text-to-911 if you’re deaf/HoH, can’t speak safely, or have a speech disability. Maine supports it statewide; check coverage at "}},{"k":"mark_call_module_complete","v":{"s":"Mark Call module complete"}},{"k":"i_ve_practiced_the_script","v":{"s":"✓ I’ve practiced the script"}},{"k":"call_module_sections","v":{"s":"Call module sections"}},{"k":"hands_only_cpr","v":{"s":"❤️ Hands-only CPR"}},{"k":"for_untrained_bystanders","v":{"s":"For untrained bystanders"}},{"k":"hands_only_cpr_no_breaths_is_what_aha_","v":{"s":": hands-only CPR (no breaths) is what AHA recommends for adults who collapse suddenly. It works."}},{"k":"check","v":{"s":"Check"}},{"k":"shake_shout_no_response_not_breathing_","v":{"s":" — shake & shout. No response? Not breathing normally?"}},{"k":"call_911_2","v":{"s":"Call 911"}},{"k":"or_have_someone_else_call_send_another","v":{"s":" (or have someone else call). Send another person for an AED."}},{"k":"push_hard_push_fast","v":{"s":"Push hard, push fast"}},{"k":"center_of_chest","v":{"s":" — center of chest, "}},{"k":"2_inches_deep","v":{"s":"2 inches deep"}},{"k":"at","v":{"s":", at "}},{"k":"100_120_bpm","v":{"s":"100–120 bpm"}},{"k":"don_t_stop","v":{"s":"Don’t stop"}},{"k":"until_ems_takes_over_aed_tells_you_to_","v":{"s":" until EMS takes over, AED tells you to clear, or person starts breathing."}},{"k":"use_the_aed","v":{"s":"Use the AED"}},{"k":"as_soon_as_it_arrives_it_talks_you_thr","v":{"s":" as soon as it arrives — it talks you through it."}},{"k":"depth_2_in_5_cm_adult_1_5_in_4_cm_chil","v":{"s":"Depth: 2 in (5 cm) adult, ~1.5 in (4 cm) child, ~1.5 in (4 cm) infant. Source: AHA 2020 Guidelines for CPR & ECC."}},{"k":"aed_in_one_paragraph","v":{"s":"⚡ AED in one paragraph"}},{"k":"aeds_are_designed_for_untrained_people","v":{"s":"AEDs are designed for untrained people. Turn it on. "}},{"k":"it_will_talk_you_through_every_step","v":{"s":"It will talk you through every step."}},{"k":"it_will_not_shock_someone_who_doesn_t_","v":{"s":" It will not shock someone who doesn’t need it — it analyzes the heart rhythm first. "}},{"k":"use_it","v":{"s":"Use it."}},{"k":"many_aeds_also_show_visual_prompts_on_","v":{"s":" Many AEDs also show visual prompts on a screen for deaf and hard-of-hearing rescuers."}},{"k":"open_cpr_rhythm_metronome","v":{"s":"Open CPR rhythm metronome"}},{"k":"metronome_100_120_bpm","v":{"s":"🥁 Metronome (100–120 bpm)"}},{"k":"practice_cpr_rhythm_30_second_window","v":{"s":"Practice CPR rhythm — 30 second window"}},{"k":"practice_30_sec","v":{"s":"⏱️ Practice (30 sec)"}},{"k":"walk_through_using_an_aed","v":{"s":"Walk through using an AED"}},{"k":"aed_walkthrough","v":{"s":"⚡ AED walkthrough"}},{"k":"beats_counted","v":{"s":"Beats counted: "}},{"k":"reset_bpm_to_110","v":{"s":"Reset bpm to 110"}},{"k":"reset_to_110","v":{"s":"Reset to 110"}},{"k":"stayin_alive","v":{"s":"Stayin’ Alive"}},{"k":"is_104_bpm","v":{"s":" is ~104 bpm. "}},{"k":"baby_shark","v":{"s":"Baby Shark"}},{"k":"is_115_bpm","v":{"s":" is ~115 bpm. "}},{"k":"mr_brightside","v":{"s":"Mr. Brightside"}},{"k":"is_148_bpm_too_fast_audio_is_off_by_de","v":{"s":" is ~148 bpm — too fast. Audio is OFF by default; enable if it helps you keep time."}},{"k":"practice_30_second_window","v":{"s":"⏱️ Practice (30-second window)"}},{"k":"tap_the_big_button_in_rhythm_like_you_","v":{"s":"Tap the big button in rhythm — like you would push on someone’s chest. Aim for "}},{"k":"100_120_bpm_2","v":{"s":"100–120 bpm"}},{"k":"the_metronome_above_gives_you_the_targ","v":{"s":". The metronome above gives you the target sound/visual."}},{"k":"s_30s_taps","v":{"s":"s / 30s • taps: "}},{"k":"start_30_second_practice","v":{"s":"Start 30 second practice"}},{"k":"start_30s","v":{"s":"▶ Start 30s"}},{"k":"stop_practice_early","v":{"s":"Stop practice early"}},{"k":"stop","v":{"s":"■ Stop"}},{"k":"you_re_practicing_rhythm_only_depth_2_","v":{"s":"You’re practicing rhythm only — depth (2 inches on an adult) and chest recoil also matter, and you can’t practice those on a screen. Get hands-on at "}},{"k":"step_1_turn_it_on","v":{"s":"Step 1 — Turn it on"}},{"k":"open_the_case_press_the_green_power_bu","v":{"s":"Open the case. Press the green/power button. The AED starts giving voice prompts immediately. Visual prompts on the screen mirror them for deaf/HoH rescuers."}},{"k":"step_2_expose_the_chest","v":{"s":"Step 2 — Expose the chest"}},{"k":"cut_or_tear_off_the_shirt_if_chest_is_","v":{"s":"Cut or tear off the shirt. If chest is wet — wipe dry. If hairy — most AEDs include a razor in the case. Remove medication patches. The pads go skin-to-skin."}},{"k":"step_3_place_the_pads","v":{"s":"Step 3 — Place the pads"}},{"k":"the_pads_have_a_picture_showing_where_","v":{"s":"The pads have a picture showing where they go. Adult: upper-right + lower-left ribs. Child <8 or <55 lbs: use child pads if available, or place one on chest and one on the back."}},{"k":"step_4_stand_clear","v":{"s":"Step 4 — Stand clear"}},{"k":"loudly_say_clear_so_no_one_is_touching","v":{"s":"Loudly say \"CLEAR!\" so no one is touching the person. The AED is reading the heart rhythm. Takes 5–15 seconds."}},{"k":"step_5_shock_or_no_shock","v":{"s":"Step 5 — Shock or no shock"}},{"k":"pick_a_branch_below_to_see_what_happen","v":{"s":"Pick a branch below to see what happens for each."}},{"k":"step_6_continue_compressions","v":{"s":"Step 6 — Continue compressions"}},{"k":"whether_shock_or_no_shock_the_aed_will","v":{"s":"Whether shock or no shock — the AED will tell you to do CPR for 2 minutes, then it re-analyzes. Do not remove the pads. Keep going until EMS arrives."}},{"k":"shock_advised","v":{"s":"⚡ \"Shock advised\""}},{"k":"no_shock_advised","v":{"s":"🚫 \"No shock advised\""}},{"k":"step","v":{"s":"Step "}},{"k":"previous_step","v":{"s":"Previous step"}},{"k":"back","v":{"s":"← Back"}},{"k":"reset_to_first_step","v":{"s":"Reset to first step"}},{"k":"reset","v":{"s":"Reset"}},{"k":"cpr_aed_sections","v":{"s":"CPR + AED sections"}},{"k":"direct_pressure_2","v":{"s":"Direct pressure"}},{"k":"wound_packing","v":{"s":"Wound packing"}},{"k":"tourniquet","v":{"s":"Tourniquet"}},{"k":"limbs_only_never_on_neck_head_torso_gr","v":{"s":"Limbs ONLY. NEVER on neck, head, torso, groin, or armpit."}},{"k":"life_threatening_bleeding","v":{"s":"🩸 Life-threatening bleeding"}},{"k":"recognize_it","v":{"s":"Recognize it: "}},{"k":"spurting_blood_blood_pooling_on_the_gr","v":{"s":"spurting blood, blood pooling on the ground, blood that won’t stop after 5+ minutes of pressure, soaks through cloth fast. A person can bleed to death from a limb wound in "}},{"k":"as_little_as_3_5_minutes","v":{"s":"as little as 3–5 minutes"}},{"k":"the_protocol","v":{"s":"The protocol: "}},{"k":"pressure_if_needed_packing_if_needed_t","v":{"s":"Pressure → (if needed) Packing → (if needed) Tourniquet. Always start at step 1. Escalate only if the previous step isn’t working."}},{"k":"see_detailed_protocol_with_step_by_ste","v":{"s":"See detailed protocol with step-by-step instructions"}},{"k":"see_detailed_protocol","v":{"s":"📋 See detailed protocol"}},{"k":"see_where_you_can_and_cannot_put_a_tou","v":{"s":"See where you can and cannot put a tourniquet"}},{"k":"tourniquet_placement","v":{"s":"🩹 Tourniquet placement"}},{"k":"each_step_in_detail","v":{"s":"Each step in detail. "}},{"k":"always_start_at_step_1","v":{"s":"Always start at step 1."}},{"k":"escalate_only_when_the_previous_step_i","v":{"s":" Escalate only when the previous step isn’t working."}},{"k":"use_when","v":{"s":"Use when: "}},{"k":"maine_reality","v":{"s":"🌲 Maine reality: "}},{"k":"that_distance_is_why_a_tourniquet_may_","v":{"s":" That distance is why a tourniquet may be life-saving here where pressure alone might be enough in a city — EMS is closer there."}},{"k":"mark_stop_the_bleed_module_complete","v":{"s":"Mark Stop the Bleed module complete"}},{"k":"i_ve_learned_the_protocol","v":{"s":"✓ I’ve learned the protocol"}},{"k":"take_a_free_course_stopthebleed_org","v":{"s":"Take a free course → stopthebleed.org"}},{"k":"2_3_above_wound_between_wound_and_shou","v":{"s":"2–3\" above wound, between wound and shoulder."}},{"k":"above_the_elbow_if_wound_is_at_near_el","v":{"s":"Above the elbow if wound is at/near elbow."}},{"k":"2_3_above_wound_between_wound_and_hip","v":{"s":"2–3\" above wound, between wound and hip."}},{"k":"above_the_knee_if_wound_is_at_near_kne","v":{"s":"Above the knee if wound is at/near knee."}},{"k":"never_pack_the_wound_and_apply_pressur","v":{"s":"NEVER. Pack the wound and apply pressure."}},{"k":"never_direct_pressure_only","v":{"s":"NEVER. Direct pressure only."}},{"k":"never_pack_if_you_can_pressure_911_fas","v":{"s":"NEVER. Pack if you can; pressure; 911 fast."}},{"k":"junctional_can_t_tourniquet_pack_with_","v":{"s":"Junctional — can’t tourniquet. Pack with gauze and apply pressure."}},{"k":"junctional_can_t_tourniquet_pack_with__2","v":{"s":"Junctional — can’t tourniquet. Pack with gauze and apply pressure with bodyweight."}},{"k":"where_can_a_tourniquet_go","v":{"s":"🩹 Where can a tourniquet go?"}},{"k":"limbs_only","v":{"s":"Limbs only."}},{"k":"junctional_wounds_neck_armpit_groin_an","v":{"s":" Junctional wounds (neck, armpit, groin) and torso wounds need "}},{"k":"wound_packing_2","v":{"s":"wound packing"}},{"k":"instead_gauze_deep_into_the_wound_then","v":{"s":" instead — gauze deep into the wound, then heavy pressure."}},{"k":"improvised_tourniquet_no_real_one_avai","v":{"s":"Improvised tourniquet (no real one available): "}},{"k":"a_belt_won_t_tighten_enough_on_its_own","v":{"s":"a belt won’t tighten enough on its own — you need a windlass. Triangular bandage or a torn shirt strip wrapped around the limb, with a stick or pen as a windlass to twist tighter, then secure. Real tourniquets (CAT, SOFT-T) work better and are widely available — many schools and Stop the Bleed kits stock them."}},{"k":"stop_the_bleed_sections","v":{"s":"Stop the Bleed sections"}},{"k":"adult_or_child_1_year","v":{"s":"Adult or child (1+ year)"}},{"k":"small_child_1_8","v":{"s":"Small child (1–8)"}},{"k":"infant_under_1_year","v":{"s":"Infant (under 1 year)"}},{"k":"pregnant_person","v":{"s":"Pregnant person"}},{"k":"you_alone_choking","v":{"s":"You — alone, choking"}},{"k":"adult_or_child_1_year_2","v":{"s":"Adult or child (1+ year)"}},{"k":"5_back_blows","v":{"s":"5 back blows "}},{"k":"5_abdominal_thrusts_heimlich","v":{"s":"5 abdominal thrusts (Heimlich): "}},{"k":"if_they_go_unconscious","v":{"s":"If they go unconscious: "}},{"k":"small_child_1_8_2","v":{"s":"Small child (1–8)"}},{"k":"5_back_blows_2","v":{"s":"5 back blows "}},{"k":"5_abdominal_thrusts","v":{"s":"5 abdominal thrusts: "}},{"k":"infant_under_1_year_2","v":{"s":"Infant (under 1 year)"}},{"k":"never_use_abdominal_thrusts_on_an_infa","v":{"s":"NEVER use abdominal thrusts on an infant."}},{"k":"5_back_blows_3","v":{"s":"5 back blows "}},{"k":"5_chest_thrusts","v":{"s":"5 chest thrusts: "}},{"k":"pregnant_person_2","v":{"s":"Pregnant person"}},{"k":"use_chest_thrusts_not_abdominal_thrust","v":{"s":"Use chest thrusts, NOT abdominal thrusts."}},{"k":"5_chest_thrusts_2","v":{"s":"5 chest thrusts: "}},{"k":"you_alone_choking_2","v":{"s":"You — alone, choking"}},{"k":"self_abdominal_thrusts","v":{"s":"Self abdominal thrusts. "}},{"k":"or_use_a_chair_back_counter_railing","v":{"s":"OR use a chair back / counter / railing: "}},{"k":"who_is_choking","v":{"s":"😬 Who is choking?"}},{"k":"the_right_technique_depends_on_who_pic","v":{"s":"The right technique depends on who. Pick one to see the protocol."}},{"k":"if_the_person_is_coughing_forcefully","v":{"s":"if the person is coughing forcefully, "}},{"k":"don_t_intervene","v":{"s":"don’t intervene"}},{"k":"let_them_cough_step_in_only_when_they","v":{"s":" — let them cough. Step in only when they "}},{"k":"cough_can_t_speak_or_can_t_breathe","v":{"s":" cough, can’t speak, or can’t breathe."}},{"k":"pick_a_different_person","v":{"s":"Pick a different person"}},{"k":"pick_someone_else","v":{"s":"← Pick someone else"}},{"k":"mark_choking_module_complete","v":{"s":"Mark choking module complete"}},{"k":"got_it","v":{"s":"✓ Got it"}},{"k":"choking_module_sections","v":{"s":"Choking module sections"}},{"k":"why_this_module_exists","v":{"s":"♾️ Why this module exists"}},{"k":"most_first_aid_courses_don_t_cover_thi","v":{"s":"Most first-aid courses don’t cover this: how disability shapes both "}},{"k":"a_peer_s_seizure_isn_t_weird_behavior_","v":{"s":" (a peer’s seizure isn’t \"weird behavior\" — it’s a medical event) and "}},{"k":"you_can_t_shout_instructions_to_a_deaf","v":{"s":" (you can’t shout instructions to a Deaf patient)."}},{"k":"this_module_pulls_from_community_led_o","v":{"s":"This module pulls from community-led orgs — "}},{"k":"epilepsy_foundation","v":{"s":"Epilepsy Foundation"}},{"k":"where_community_preference_is_mixed_e_","v":{"s":". Where community preference is mixed (e.g. person-first vs identity-first language), this module follows the most common preference and notes it."}},{"k":"pick_a_section_above_each_section_is_s","v":{"s":"Pick a section above. Each section is short — these are the things most adults don’t know either."}},{"k":"get_their_attention_visually","v":{"s":"Get their attention visually: "}},{"k":"wave_in_their_line_of_sight_tap_their_","v":{"s":"wave in their line of sight, tap their shoulder. Don’t grab. Don’t shout — louder doesn’t help."}},{"k":"face_them_directly","v":{"s":"Face them directly"}},{"k":"so_they_can_see_your_mouth_and_express","v":{"s":" so they can see your mouth and expressions. Good lighting on your face. Don’t cover your mouth."}},{"k":"use_the_phone_s_notes_app","v":{"s":"Use the phone’s notes app"}},{"k":"to_type_questions_most_teens_already_d","v":{"s":" to type questions. Most teens already do this."}},{"k":"text_to_911_is_the_right_call","v":{"s":"Text-to-911 is the right call"}},{"k":"maine_has_it_don_t_call_for_them_on_a_","v":{"s":" — Maine has it. Don’t call FOR them on a voice line if they want to text themselves."}},{"k":"don_t_assume_asl","v":{"s":"Don’t assume ASL"}},{"k":"many_late_deafened_or_hoh_people_don_t","v":{"s":" — many late-deafened or HoH people don’t sign. Ask their preferred way to communicate."}},{"k":"in_a_real_emergency","v":{"s":"In a real emergency"}},{"k":"simple_gestures_writing_key_words_ambu","v":{"s":", simple gestures + writing key words (\"AMBULANCE COMING\", \"WHERE HURT?\") often work faster than typing full sentences."}},{"k":"aeds_talk_show","v":{"s":"AEDs talk + show"}},{"k":"modern_aeds_display_visual_prompts_on_","v":{"s":" — modern AEDs display visual prompts on a screen for the rescuer. Use one even if no one in the room can hear the voice prompts."}},{"k":"lower_the_sensory_load","v":{"s":"Lower the sensory load: "}},{"k":"lights_down_if_you_can_fewer_voices_fe","v":{"s":"lights down if you can, fewer voices, fewer hands. A crowd of helpers can make a meltdown worse."}},{"k":"predictable_verbal_warnings","v":{"s":"Predictable verbal warnings: "}},{"k":"i_m_going_to_touch_your_wrist_now_befo","v":{"s":"\"I’m going to touch your wrist now\" before you do. Touch without warning can escalate panic."}},{"k":"short_literal_sentences","v":{"s":"Short, literal sentences. "}},{"k":"avoid_figures_of_speech_sit_down_is_cl","v":{"s":"Avoid figures of speech. \"Sit down\" is clearer than \"take a load off.\""}},{"k":"allow_stims","v":{"s":"Allow stims"}},{"k":"rocking_hand_flapping_repeating_words_","v":{"s":" (rocking, hand-flapping, repeating words) — they’re self-regulation, NOT a symptom of the emergency."}},{"k":"meltdown_tantrum","v":{"s":"Meltdown ≠ tantrum."}},{"k":"a_meltdown_is_involuntary_nervous_syst","v":{"s":" A meltdown is involuntary nervous-system overload. Don’t threaten consequences. Reduce input and wait."}},{"k":"look_for_a_comm_card_aac_device_script","v":{"s":"Look for a comm card / AAC device / scripted phrases"}},{"k":"the_person_may_use_many_autistic_peopl","v":{"s":" the person may use. Many autistic people carry a card explaining their communication needs."}},{"k":"don_t_mistake_autism_for_the_medical_e","v":{"s":"Don’t mistake autism for the medical emergency. "}},{"k":"a_non_speaking_autistic_peer_may_be_ha","v":{"s":"A non-speaking autistic peer may be having a seizure or a panic attack — recognize THAT separately."}},{"k":"this_module_uses_identity_first_langua","v":{"s":"this module uses identity-first language (\"autistic person\") because that is the majority preference in autistic-led communities. Some people and families prefer \"person with autism.\" If you know someone’s preference, use it."}},{"k":"a_peer_having_a_seizure_is_having_a_me","v":{"s":"A peer having a seizure is having a medical event"}},{"k":"not_acting_weird_recognizing_it_as_epi","v":{"s":" — not \"acting weird.\" Recognizing it as epilepsy (or another seizure cause) is the first thing."}},{"k":"time_the_seizure","v":{"s":"TIME the seizure"}},{"k":"from_when_it_starts_most_last_under_2_","v":{"s":" from when it starts. Most last under 2 minutes."}},{"k":"move_sharp_things_away","v":{"s":"Move sharp things AWAY"}},{"k":"chairs_desks_glasses_don_t_move_the_pe","v":{"s":" — chairs, desks, glasses. Don’t move the person unless they’re in immediate danger (water, road, fire)."}},{"k":"cushion_the_head","v":{"s":"Cushion the head "}},{"k":"jacket_backpack_loosen_anything_around","v":{"s":"(jacket, backpack). Loosen anything around the neck."}},{"k":"do_not_restrain","v":{"s":"DO NOT restrain"}},{"k":"never_hold_them_down_or_try_to_stop_th","v":{"s":" — never hold them down or try to stop the movements."}},{"k":"do_not_put_anything_in_their_mouth","v":{"s":"DO NOT put anything in their mouth"}},{"k":"old_myth_they_cannot_swallow_their_ton","v":{"s":" — old myth. They cannot swallow their tongue."}},{"k":"after_recovery_position","v":{"s":"After: recovery position"}},{"k":"on_their_side_so_saliva_can_drain_they","v":{"s":" (on their side) so saliva can drain. They may be confused for several minutes — that’s normal. Stay with them."}},{"k":"call_911_if","v":{"s":"Call 911 if: "}},{"k":"seizure_is_over_5_minutes_repeats_with","v":{"s":"seizure is over 5 minutes, repeats without recovery in between, first-ever, in water, follows a head injury, or person is pregnant/diabetic/not breathing after."}},{"k":"privacy_after","v":{"s":"Privacy after: "}},{"k":"a_post_ictal_person_may_be_embarrassed","v":{"s":"a post-ictal person may be embarrassed. Clear gawkers. They get to choose what to share with classmates."}},{"k":"low_blood_sugar_hypoglycemia","v":{"s":"Low blood sugar (hypoglycemia) "}},{"k":"in_a_teen_often_looks_like","v":{"s":"in a teen often looks like "}},{"k":"behavior_change","v":{"s":"behavior change"}},{"k":"irritable_confused_off_shaky_sweaty_su","v":{"s":" — irritable, confused, \"off,\" shaky, sweaty, suddenly clumsy. Easy to mistake for being drunk or having an attitude."}},{"k":"if_they_can_swallow_safely","v":{"s":"If they CAN swallow safely: "}},{"k":"15g_fast_carb_juice_box_regular_soda_g","v":{"s":"15g fast carb — juice box, regular soda, glucose tab, a tablespoon of honey. Recheck in 15 minutes. Repeat if still low."}},{"k":"if_they_cannot_swallow_safely_slurring","v":{"s":"If they CANNOT swallow safely (slurring, confused, semi-conscious): "}},{"k":"do_not_give_food_or_liquid_choking_ris","v":{"s":"do NOT give food or liquid — choking risk. Glucagon if available. Call 911. Recovery position."}},{"k":"if_unconscious","v":{"s":"If unconscious: "}},{"k":"911_immediately_recovery_position_neve","v":{"s":"911 immediately. Recovery position. NEVER pour juice into the mouth of an unconscious person."}},{"k":"high_blood_sugar_hyperglycemia_dka","v":{"s":"High blood sugar (hyperglycemia / DKA) "}},{"k":"in_a_peer_with_diabetes_extreme_thirst","v":{"s":"in a peer with diabetes: extreme thirst, peeing constantly, fruity-acetone breath, deep rapid breathing, nausea/vomiting, confusion. "}},{"k":"this_is_also_a_911_emergency","v":{"s":"This is also a 911 emergency."}},{"k":"don_t_give_insulin_unless_they_are_man","v":{"s":" Don’t give insulin unless they are managing it themselves and you’re just supporting."}},{"k":"behavior_changes_in_a_peer_you_know_ha","v":{"s":"Behavior changes in a peer you know has diabetes "}},{"k":"assume_blood_sugar_first_attitude_seco","v":{"s":"— assume blood sugar first, attitude second. Ask \"Have you checked? Can I get you juice?\""}},{"k":"you_can_t_see_most_disabilities","v":{"s":"You can’t see most disabilities"}},{"k":"chronic_illness_cardiac_conditions_epi","v":{"s":" — chronic illness, cardiac conditions, epilepsy, allergies, mental health, autism, ADHD, learning differences. A peer who looks \"fine\" may have a condition that matters in an emergency."}},{"k":"look_for_medical_id_jewelry","v":{"s":"Look for medical ID jewelry"}},{"k":"bracelet_necklace_dog_tag_watch_sticke","v":{"s":" (bracelet, necklace, dog tag, watch sticker, card in wallet). It often lists condition + emergency contact + critical med."}},{"k":"phone_medical_id","v":{"s":"Phone medical ID: "}},{"k":"iphones_and_androids_both_have_a_medic","v":{"s":"iPhones and Androids both have a medical ID screen accessible from the lock screen — emergency responders can view condition + meds + emergency contacts without unlocking the phone. Look for \"Emergency\" or \"SOS\" on the lock screen."}},{"k":"disclosure_is_their_choice","v":{"s":"Disclosure is THEIR choice. "}},{"k":"don_t_tell_other_classmates_teachers_r","v":{"s":"Don’t tell other classmates / teachers / random adults a peer has a condition unless it’s necessary to keep them safe RIGHT NOW. To EMS, yes. To the lunchroom, no."}},{"k":"ask_don_t_assume","v":{"s":"Ask, don’t assume: "}},{"k":"is_there_anything_i_should_know_to_hel","v":{"s":"\"Is there anything I should know to help you?\" gives them the chance to tell you if they want to. \"Are you OK? You look weird\" doesn’t."}},{"k":"service_dogs_are_working","v":{"s":"Service dogs are working: "}},{"k":"don_t_pet_distract_or_call_to_them_the","v":{"s":"don’t pet, distract, or call to them. The handler is the only person who interacts with them in an emergency."}},{"k":"you_can_do_cpr_with_a_limb_difference","v":{"s":"You can do CPR with a limb difference"}},{"k":"depth_and_rate_matter_most_you_can_use","v":{"s":" — depth and rate matter most. You can use your hand differently, use your forearm, or partner up so someone else does compressions while you coach (you know the rate)."}},{"k":"you_can_do_cpr_with_low_muscle_tone_or","v":{"s":"You can do CPR with low muscle tone or fatigue: "}},{"k":"partner_up_switch_every_2_minutes_anyw","v":{"s":"partner up. Switch every 2 minutes anyway — even adults without disabilities tire fast. The AHA recommends compressors swap every 2 minutes."}},{"k":"you_can_call_911_if_you_can_t_speak","v":{"s":"You can call 911 if you can’t speak: "}},{"k":"use_text_to_911_maine_has_it_you_can_l","v":{"s":"use text-to-911 (Maine has it). You can leave a voice line open even silent — dispatchers can locate the call."}},{"k":"you_can_lead","v":{"s":"You can lead"}},{"k":"even_if_you_can_t_do_compressions_assi","v":{"s":" even if you can’t do compressions: assign tasks (\"YOU call 911. YOU run for the AED in the gym. YOU clear people back.\"). Calm direction is real first aid."}},{"k":"sensory_overload_during_the_emergency","v":{"s":"Sensory overload during the emergency? "}},{"k":"step_back_hands_over_ears_find_a_quiet","v":{"s":"Step back, hands over ears, find a quieter spot. You don’t have to be the closest helper to be a helpful one. Coaching others through the protocol is a real role."}},{"k":"practice_ahead","v":{"s":"Practice ahead. "}},{"k":"knowing_what_you_would_do_your_specifi","v":{"s":"Knowing what you would do — your specific role, given what your body does — turns a freeze into a plan. That’s what this lab is for."}},{"k":"disability_aware_sections","v":{"s":"Disability-aware sections"}},{"k":"mark_disability_aware_module_complete","v":{"s":"Mark disability-aware module complete"}},{"k":"i_ve_read_this_module","v":{"s":"✓ I’ve read this module"}},{"k":"cafeteria_collapse","v":{"s":"Cafeteria collapse"}},{"k":"shake_their_shoulder_firmly_and_shout_","v":{"s":"Shake their shoulder firmly and shout \"Are you OK?\""}},{"k":"right_check_responsiveness_before_anyt","v":{"s":"Right. Check responsiveness before anything else. They might just have fainted and be coming around."}},{"k":"start_chest_compressions_immediately","v":{"s":"Start chest compressions immediately."}},{"k":"compressions_on_someone_whose_heart_is","v":{"s":"Compressions on someone whose heart is still beating can cause real injury. Always check first."}},{"k":"run_to_get_a_teacher","v":{"s":"Run to get a teacher."}},{"k":"a_teacher_is_needed_soon_but_leaving_t","v":{"s":"A teacher is needed soon, but leaving the patient alone wastes the most critical seconds. Send someone else."}},{"k":"yell_you_call_911_you_go_to_the_front_","v":{"s":"Yell \"YOU — call 911. YOU — go to the front office for the AED. NOW.\""}},{"k":"pointing_at_specific_people_works_diff","v":{"s":"Pointing at specific people works — diffuse responsibility freezes a crowd. Now you can focus on the patient."}},{"k":"yell_someone_call_911_and_start_cpr","v":{"s":"Yell \"Someone call 911!\" and start CPR."}},{"k":"better_than_nothing_but_someone_often_","v":{"s":"Better than nothing, but \"someone\" often means no one. Pointing at a specific person fixes that."}},{"k":"pull_out_your_phone_and_call_911_yours","v":{"s":"Pull out your phone and call 911 yourself while standing up."}},{"k":"100_120_compressions_per_minute_about_","v":{"s":"100–120 compressions per minute, about the pace of \"Stayin’ Alive.\""}},{"k":"exactly_right_push_hard_2_inches_deep_","v":{"s":"Exactly right. Push hard (2 inches deep on an adult), let the chest fully recoil between pushes."}},{"k":"as_fast_as_you_can_speed_saves_lives","v":{"s":"As fast as you can — speed saves lives."}},{"k":"too_fast_120_bpm_means_shallow_compres","v":{"s":"Too fast (>120 bpm) means shallow compressions and not enough time for the heart to refill between pushes. Aim for 100–120."}},{"k":"slow_and_steady_about_60_per_minute","v":{"s":"Slow and steady, about 60 per minute."}},{"k":"too_slow_the_heart_needs_100_120_pushe","v":{"s":"Too slow. The heart needs ~100–120 pushes per minute to circulate blood enough to keep the brain alive."}},{"k":"turn_it_on_it_will_talk_you_through_it","v":{"s":"\"Turn it on. It will talk you through it. Listen and do exactly what it says.\""}},{"k":"aeds_are_designed_for_untrained_users_","v":{"s":"AEDs are designed for untrained users. Voice prompts (and visual prompts on most models) lead you through every step."}},{"k":"wait_until_i_m_done_with_compressions_","v":{"s":"\"Wait until I’m done with compressions, then I’ll do it.\""}},{"k":"every_second_without_an_aed_on_a_shock","v":{"s":"Every second without an AED on a shockable rhythm reduces survival. Have them set it up while you keep compressing."}},{"k":"forget_it_just_keep_doing_cpr","v":{"s":"\"Forget it, just keep doing CPR.\""}},{"k":"cpr_alone_has_much_lower_survival_than","v":{"s":"CPR alone has much lower survival than CPR + AED. Even an untrained person can run an AED — it talks them through it."}},{"k":"hallway_choking","v":{"s":"Hallway choking"}},{"k":"ask_are_you_choking_watch_for_a_nod_or","v":{"s":"Ask: \"Are you choking?\" Watch for a nod or thumbs-up."}},{"k":"the_universal_sign_is_hands_at_the_thr","v":{"s":"The universal sign is hands at the throat with no sound. Confirming gives them a chance to cough first if they still can."}},{"k":"slap_them_hard_on_the_back_right_away","v":{"s":"Slap them hard on the back right away."}},{"k":"back_blows_are_part_of_the_protocol_bu","v":{"s":"Back blows ARE part of the protocol, but confirm they can’t cough first. If they’re coughing forcefully, let them cough."}},{"k":"get_them_to_drink_water_immediately","v":{"s":"Get them to drink water immediately."}},{"k":"don_t_give_a_choking_person_water_it_c","v":{"s":"Don’t give a choking person water — it can go down the wrong way too. Don’t give anything by mouth."}},{"k":"5_back_blows_between_the_shoulder_blad","v":{"s":"5 back blows between the shoulder blades, then 5 abdominal thrusts. Repeat."}},{"k":"correct_sequence_lean_them_forward_hee","v":{"s":"Correct sequence. Lean them forward, heel of your hand between the shoulder blades."}},{"k":"5_abdominal_thrusts_only","v":{"s":"5 abdominal thrusts only."}},{"k":"abdominal_thrusts_work_but_pairing_the","v":{"s":"Abdominal thrusts work but pairing them with back blows is more effective. The current Red Cross protocol is 5 back blows + 5 thrusts."}},{"k":"have_them_lie_down_on_their_back_so_yo","v":{"s":"Have them lie down on their back so you can do CPR."}},{"k":"cpr_is_for_unconscious_patients_while_","v":{"s":"CPR is for unconscious patients. While they’re still conscious, do back blows + thrusts."}},{"k":"lower_them_safely_call_911_start_cpr_l","v":{"s":"Lower them safely, call 911, start CPR. Look in the mouth before each set of breaths."}},{"k":"right_once_unconscious_cpr_can_dislodg","v":{"s":"Right. Once unconscious, CPR can dislodge the object on its own. Look in the mouth before breaths and remove anything you see — no blind finger sweeps."}},{"k":"do_a_blind_finger_sweep_down_their_thr","v":{"s":"Do a blind finger sweep down their throat."}},{"k":"never_you_can_push_the_object_deeper_l","v":{"s":"Never — you can push the object deeper. Look first, only remove what you can see."}},{"k":"keep_doing_abdominal_thrusts_on_them_w","v":{"s":"Keep doing abdominal thrusts on them while they’re on the floor."}},{"k":"once_unconscious_switch_to_cpr_compres","v":{"s":"Once unconscious, switch to CPR. Compressions can also help dislodge the object."}},{"k":"sports_field_severe_bleeding","v":{"s":"Sports field — severe bleeding"}},{"k":"press_both_hands_hard_directly_on_the_","v":{"s":"Press both hands hard directly on the wound. Lean in with bodyweight."}},{"k":"direct_pressure_stops_most_bleeding_yo","v":{"s":"Direct pressure stops most bleeding. Your bodyweight gets the depth a hand alone can’t."}},{"k":"run_to_find_the_coach_to_grab_the_firs","v":{"s":"Run to find the coach to grab the first-aid kit."}},{"k":"every_second_matters_with_arterial_ble","v":{"s":"Every second matters with arterial bleeding. Apply pressure NOW; have someone else run for the kit."}},{"k":"lift_the_leg_up_to_drain_the_wound_and","v":{"s":"Lift the leg up to \"drain\" the wound and check it."}},{"k":"don_t_lift_to_peek_you_break_the_clot_","v":{"s":"Don’t lift to peek. You break the clot you’re trying to form. Press and hold."}},{"k":"place_the_tourniquet_2_3_above_the_wou","v":{"s":"Place the tourniquet 2–3\" ABOVE the wound on the thigh. Tighten until bleeding stops. Note the time."}},{"k":"limbs_are_the_right_place_for_a_tourni","v":{"s":"Limbs are the right place for a tourniquet. Above the wound, between wound and heart, not on a joint. Always note the time it was applied."}},{"k":"place_the_tourniquet_on_the_wound","v":{"s":"Place the tourniquet ON the wound."}},{"k":"tourniquets_go_above_the_wound_between","v":{"s":"Tourniquets go above the wound, between the wound and the heart. Putting it on the wound itself can damage tissue and won’t cut off the artery."}},{"k":"don_t_use_the_tourniquet_just_keep_pre","v":{"s":"Don’t use the tourniquet — just keep pressing harder."}},{"k":"pressure_that_isn_t_controlling_spurti","v":{"s":"Pressure that isn’t controlling spurting bleeding from a limb is the textbook indication for a tourniquet. Use it."}},{"k":"stay_with_them_keep_them_lying_down_wa","v":{"s":"Stay with them. Keep them lying down, warm. Tell EMS the time the tourniquet went on."}},{"k":"right_don_t_loosen_the_tourniquet_don_","v":{"s":"Right. Don’t loosen the tourniquet. Don’t let bystanders give them water. Time on tourniquet is the single most important fact for the ER."}},{"k":"loosen_the_tourniquet_every_couple_min","v":{"s":"Loosen the tourniquet every couple minutes \"to let blood flow.\""}},{"k":"never_once_it_s_on_it_stays_on_until_e","v":{"s":"Never — once it’s on, it stays on until EMS or the ER takes over. Loosening can cause re-bleeding."}},{"k":"give_them_water_and_sit_them_up","v":{"s":"Give them water and sit them up."}},{"k":"don_t_give_anything_by_mouth_they_may_","v":{"s":"Don’t give anything by mouth (they may need surgery). Keep them lying flat to maintain blood pressure to the brain."}},{"k":"classroom_seizure","v":{"s":"Classroom seizure"}},{"k":"move_sharp_objects_chair_legs_desk_cor","v":{"s":"Move sharp objects (chair legs, desk corners) away. Note the time it started."}},{"k":"right_make_the_area_safe_and_time_the_","v":{"s":"Right. Make the area safe and TIME the seizure. Most last under 2 minutes; over 5 is a 911 emergency."}},{"k":"hold_their_arms_and_legs_down_so_they_","v":{"s":"Hold their arms and legs down so they don’t hurt themselves."}},{"k":"never_restrain_someone_having_a_seizur","v":{"s":"Never restrain someone having a seizure. You can cause serious injury. Move hazards away from THEM, not the other way."}},{"k":"try_to_put_a_pen_in_their_mouth_so_the","v":{"s":"Try to put a pen in their mouth so they don’t bite their tongue."}},{"k":"old_myth_never_put_anything_in_someone","v":{"s":"Old myth. Never put anything in someone’s mouth during a seizure. They cannot swallow their tongue. You can break their teeth or get bitten."}},{"k":"tell_them_firmly_to_put_the_phones_awa","v":{"s":"Tell them firmly to put the phones away — this is not for the internet."}},{"k":"right_your_classmate_did_not_consent_t","v":{"s":"Right. Your classmate did not consent to being filmed during a medical event. Protect their dignity."}},{"k":"ignore_them_focus_on_the_seizure","v":{"s":"Ignore them — focus on the seizure."}},{"k":"focus_on_the_seizure_first_but_ask_som","v":{"s":"Focus on the seizure first, but ask someone else to clear cameras. Their privacy matters too."}},{"k":"take_a_video_yourself_for_the_doctor","v":{"s":"Take a video yourself \"for the doctor.\""}},{"k":"their_family_or_doctor_can_request_spe","v":{"s":"Their family or doctor can request specific recordings if helpful — that’s their decision, not yours. Don’t add to the camera count."}},{"k":"roll_them_gently_onto_their_side_recov","v":{"s":"Roll them gently onto their side (recovery position). Stay with them. Speak calmly."}},{"k":"right_recovery_position_lets_saliva_dr","v":{"s":"Right. Recovery position lets saliva drain. The post-ictal phase can last 5–30 minutes — confusion is normal."}},{"k":"wake_them_up_by_splashing_water_on_the","v":{"s":"Wake them up by splashing water on their face."}},{"k":"don_t_they_re_recovering_stay_calm_tal","v":{"s":"Don’t. They’re recovering. Stay calm, talk softly, give them time."}},{"k":"walk_away_the_seizure_is_over","v":{"s":"Walk away — the seizure is over."}},{"k":"they_need_someone_with_them_through_th","v":{"s":"They need someone with them through the post-ictal phase. They may also need to know what just happened — they often don’t remember."}},{"k":"bus_stop_diabetic_emergency","v":{"s":"Bus stop — diabetic emergency"}},{"k":"low_blood_sugar_hypoglycemia_check_if_","v":{"s":"Low blood sugar (hypoglycemia). Check if they have juice or glucose tabs."}},{"k":"in_a_peer_with_diabetes_behavior_chang","v":{"s":"In a peer with diabetes, behavior change + sweaty + shaky = low blood sugar until proven otherwise. They may not know how impaired they are."}},{"k":"they_re_drunk_ignore_them","v":{"s":"They’re drunk. Ignore them."}},{"k":"hypoglycemia_in_diabetics_often_looks_","v":{"s":"Hypoglycemia in diabetics often LOOKS like being drunk. Mistaking it can be fatal. Always treat first when you’re not sure."}},{"k":"call_their_parent_first","v":{"s":"Call their parent first."}},{"k":"a_parent_can_help_but_treating_the_low","v":{"s":"A parent can help, but treating the low NOW matters more. Sugar first, phone call second."}},{"k":"open_it_and_help_them_sip_it_stay_with","v":{"s":"Open it and help them sip it. Stay with them and recheck in 15 minutes."}},{"k":"15_15_rule_15g_fast_carb_a_juice_box_i","v":{"s":"15-15 rule: 15g fast carb (a juice box is ~15g), wait 15 min, recheck. Stay with them — they can crash again."}},{"k":"make_them_eat_a_sandwich_first_protein","v":{"s":"Make them eat a sandwich first — protein is better."}},{"k":"when_blood_sugar_is_low_you_need_fast_","v":{"s":"When blood sugar is low, you need FAST carbs (juice, glucose tab, regular soda). Protein takes too long."}},{"k":"give_them_their_insulin_pen","v":{"s":"Give them their insulin pen."}},{"k":"never_insulin_lowers_blood_sugar_they_","v":{"s":"Never — insulin LOWERS blood sugar. They need sugar, not insulin."}},{"k":"call_911_recovery_position_don_t_put_a","v":{"s":"Call 911. Recovery position. Don’t put anything else in their mouth."}},{"k":"right_choking_risk_is_real_if_they_can","v":{"s":"Right. Choking risk is real if they can’t swallow safely. 911. They may need IV glucose or glucagon."}},{"k":"pour_more_juice_into_their_mouth_more_","v":{"s":"Pour more juice into their mouth — more sugar will help."}},{"k":"aspiration_risk_never_pour_liquid_into","v":{"s":"Aspiration risk. Never pour liquid into the mouth of a barely-conscious person. 911."}},{"k":"wait_it_out_give_it_more_time","v":{"s":"Wait it out — give it more time."}},{"k":"severe_hypoglycemia_can_lead_to_seizur","v":{"s":"Severe hypoglycemia can lead to seizures, coma, brain damage. Don’t wait when they’re past the 15-minute mark and still impaired."}},{"k":"mental_health_peer_in_crisis","v":{"s":"Mental health — peer in crisis"}},{"k":"text_back_right_now_i_m_here_i_hear_yo","v":{"s":"Text back right now: \"I’m here. I hear you. Tell me more.\""}},{"k":"showing_up_matters_don_t_lecture_don_t","v":{"s":"Showing up matters. Don’t lecture, don’t fix yet — just be present and listen. You can’t make someone more suicidal by asking."}},{"k":"don_t_respond_you_don_t_know_what_to_s","v":{"s":"Don’t respond — you don’t know what to say and you’re scared."}},{"k":"silence_in_this_moment_is_the_most_dan","v":{"s":"Silence in this moment is the most dangerous thing. Even \"I see you. I’m here.\" is a lifeline. You don’t need the right words."}},{"k":"screenshot_it_and_post_it_to_tiktok_as","v":{"s":"Screenshot it and post it to TikTok asking what to do."}},{"k":"no_this_is_private_posting_it_betrays_","v":{"s":"No. This is private. Posting it betrays trust and can escalate. Take the message to a trusted adult, not the internet."}},{"k":"tell_them_you_re_glad_they_trusted_you","v":{"s":"Tell them you’re glad they trusted you. Ask if you can call 988 with them or if you can tell their parent / a trusted adult so they’re not alone tonight."}},{"k":"a_specific_plan_high_risk_looping_in_a","v":{"s":"A specific plan = high risk. Looping in an adult or 988 isn’t a betrayal — it’s the move. Ask their preference but make sure SOMEONE who can be physically present knows."}},{"k":"promise_you_won_t_tell_anyone_ever_no_","v":{"s":"Promise you won’t tell anyone, ever, no matter what."}},{"k":"don_t_promise_this_some_things_you_can","v":{"s":"Don’t promise this. Some things you can’t keep secret — a friend’s safety is one. You can promise to be there. You can’t promise silence."}},{"k":"tell_them_to_just_hang_in_there_and_go","v":{"s":"Tell them to \"just hang in there\" and go to sleep."}},{"k":"this_dismisses_the_crisis_they_told_yo","v":{"s":"This dismisses the crisis. They told you because they need help RIGHT NOW. Stay engaged."}},{"k":"tell_them_i_know_it_feels_that_way_the","v":{"s":"Tell them: \"I know it feels that way. The grown-ups who matter will be relieved you said something. Want me to call with you, or call 988 first?\""}},{"k":"acknowledge_the_fear_offer_to_share_th","v":{"s":"Acknowledge the fear. Offer to share the load. 988 counselors can help them figure out next steps and what to say to a parent."}},{"k":"tell_them_their_parents_won_t_care","v":{"s":"Tell them their parents won’t care."}},{"k":"you_don_t_know_that_even_if_a_relation","v":{"s":"You don’t know that. Even if a relationship is hard, a crisis adult can step in (counselor, coach, aunt, neighbor). 988 helps figure out who."}},{"k":"wait_until_tomorrow_to_tell_anyone_it_","v":{"s":"Wait until tomorrow to tell anyone — it’s late."}},{"k":"a_specific_plan_is_a_now_problem_not_a","v":{"s":"A specific plan is a now problem, not a tomorrow problem. 988 is open 24/7. So is 911 if there’s immediate life threat."}},{"k":"stay_on_the_phone_or_text_with_them_te","v":{"s":"Stay on the phone or text with them. Tell a trusted adult in your life what just happened — you need support too."}},{"k":"right_don_t_carry_this_alone_hearing_t","v":{"s":"Right. Don’t carry this alone. Hearing this from a friend is heavy — your own adult / counselor / parent can help you process. NAMI HelpLine: 1-800-950-NAMI."}},{"k":"hang_up_and_put_your_phone_away_you_ha","v":{"s":"Hang up and put your phone away — you handled it."}},{"k":"you_did_show_up_that_matters_but_stayi","v":{"s":"You did show up — that matters. But staying connected and getting your own support afterward both matter. This is the kind of thing that lingers."}},{"k":"tell_everyone_at_school_tomorrow_what_","v":{"s":"Tell everyone at school tomorrow what happened."}},{"k":"no_their_story_is_theirs_you_can_tell_","v":{"s":"No. Their story is theirs. You can tell trusted adults who can help; you can’t tell the lunch table."}},{"k":"each_scenario_is_multiple_steps_at_eac","v":{"s":"Each scenario is multiple steps. At each step, pick what you’d do — you’ll see whether it "}},{"k":"was","v":{"s":", was "}},{"k":"or","v":{"s":", or "}},{"k":"and_why_sources_cited_per_choice","v":{"s":", and why. Sources cited per choice."}},{"k":"content_warning","v":{"s":"⚠️ content warning"}},{"k":"content_warning_before_mental_health_s","v":{"s":"Content warning before mental health scenario"}},{"k":"content_warning_2","v":{"s":"⚠️ Content warning"}},{"k":"i_understand_start_the_scenario","v":{"s":"I understand. Start the scenario."}},{"k":"i_understand_start","v":{"s":"I understand — start"}},{"k":"skip_this_scenario_pick_a_different_on","v":{"s":"Skip this scenario; pick a different one."}},{"k":"skip_pick_different","v":{"s":"Skip — pick different"}},{"k":"scenario_complete","v":{"s":"Scenario complete: "}},{"k":"retry","v":{"s":"↺ Retry"}},{"k":"pick_another_scenario","v":{"s":"→ Pick another scenario"}},{"k":"step_2","v":{"s":"Step "}},{"k":"choices","v":{"s":"Choices"}},{"k":"leave_scenario","v":{"s":"Leave scenario"}},{"k":"leave","v":{"s":"← Leave"}},{"k":"next_step","v":{"s":"Next step"}},{"k":"in_study_hall_a_peer_drops_his_soda_an","v":{"s":"In study hall, a peer drops his soda and slumps face-first onto his desk. He does not respond when you say his name. You can see his chest is not moving normally."}},{"k":"on_the_school_bus_a_1st_grader_starts_","v":{"s":"On the school bus, a 1st-grader starts crying loudly that his throat itches and his lip looks swollen. He just shared a granola bar with another kid and his backpack has a \"PEANUT ALLERGY\" tag on it."}},{"k":"your_aunt_is_over_for_dinner_mid_conve","v":{"s":"Your aunt is over for dinner. Mid-conversation she suddenly can’t lift her right arm to take a glass of water. Her smile is uneven on one side and she keeps trying to say \"I’m fine\" but it comes out garbled. Time is 7:14 PM."}},{"k":"at_the_skate_park_a_kid_wipes_out_and_","v":{"s":"At the skate park, a kid wipes out and lies on the ground bleeding heavily from a deep gash on her thigh. Blood is pooling on the concrete. The nearest hospital is 25 minutes away."}},{"k":"you_walk_into_a_friend_s_house_unannou","v":{"s":"You walk into a friend’s house unannounced. He’s on the bathroom floor, lips blue, breathing slowly and shallowly. There’s a small empty pill bottle and a vape pen near him. His phone is buzzing on the counter."}},{"k":"at_lunch_a_classmate_who_is_deaf_taps_","v":{"s":"At lunch, a classmate who is Deaf taps you and points at another student across the cafeteria who is alone, eyes wide, hands gripping the edge of the table, breathing fast and shallow. You don’t know if they’re having a heart attack or a panic attack."}},{"k":"how_ai_practice_works","v":{"s":"🤖 How AI Practice works"}},{"k":"pick_a_difficulty_generate_a_novel_sce","v":{"s":"Pick a difficulty. Generate a novel scene."}},{"k":"write_your_response_in_2_3_sentences_w","v":{"s":"Write your response in 2–3 sentences: what you’d do, in what order."}},{"k":"get_critique_the_ai_grades_your_reason","v":{"s":"Get critique. The AI grades your reasoning against the protocols hardcoded in this tool."}},{"k":"the_ai_never_gives_clinical_decisions","v":{"s":"The AI never gives clinical decisions"}},{"k":"it_only_checks_your_reasoning_for_shou","v":{"s":" — it only checks your reasoning. For \"should I give X\" questions, the answer is always \"follow what’s prescribed + call 911.\""}},{"k":"without_an_ai_key","v":{"s":"Without an AI key: "}},{"k":"the_module_still_works_pre_written_sce","v":{"s":"the module still works — pre-written scenes are bundled, and a local keyword check stands in for AI critique."}},{"k":"basic_single_emergency_clear_cues","v":{"s":"Basic — single emergency, clear cues"}},{"k":"intermediate_needs_recognition_decisio","v":{"s":"Intermediate — needs recognition + decision"}},{"k":"advanced_ambiguity_multiple_issues","v":{"s":"Advanced — ambiguity / multiple issues"}},{"k":"pick_difficulty","v":{"s":"⚙️ Pick difficulty"}},{"k":"difficulty","v":{"s":"Difficulty"}},{"k":"the_scene","v":{"s":"📖 The scene"}},{"k":"bundled_scene_no_ai_used","v":{"s":"Bundled scene (no AI used)."}},{"k":"your_response_2_3_sentences","v":{"s":"✏️ Your response (2–3 sentences)"}},{"k":"what_do_you_do_and_in_what_order_be_sp","v":{"s":"What do you do, and in what order? Be specific (call 911? CPR? AED? EpiPen? recovery position?)."}},{"k":"your_emergency_response_2_to_3_sentenc","v":{"s":"Your emergency response, 2 to 3 sentences"}},{"k":"characters_aim_for_150_400","v":{"s":" characters. Aim for ~150–400."}},{"k":"critique","v":{"s":"🎓 Critique"}},{"k":"ai_practice_sections","v":{"s":"AI Practice sections"}},{"k":"every_org_cited_in_this_tool_on_a_phon","v":{"s":"Every org cited in this tool. On a phone, tap a phone number to call. "}},{"k":"maine_note","v":{"s":"Maine note: "}},{"k":"maine_reality_2","v":{"s":"🌲 Maine reality"}},{"k":"call_911_3","v":{"s":"Call 911"}},{"k":"start_cpr_2","v":{"s":"Start CPR"}},{"k":"apply_aed_2","v":{"s":"Apply AED"}},{"k":"direct_pressure_3","v":{"s":"Direct pressure"}},{"k":"abdominal_thrusts_2","v":{"s":"Abdominal thrusts"}},{"k":"recovery_position_2","v":{"s":"Recovery position"}},{"k":"pick_the_first_action_10_vignettes","v":{"s":"🎯 Pick the FIRST action — 10 vignettes"}},{"k":"you_will_see_10_brief_emergency_vignet","v":{"s":"You will see 10 brief emergency vignettes. For each, pick the first action from six options. After you pick, a coaching block names why this is the first action and what NOT to do first (the most-common confusion). This is decision-reflex practice — it does not substitute for hands-on certification."}},{"k":"in_a_real_emergency_call_911_in_maine_","v":{"s":"In a real emergency, call 911. In Maine, you can text 911 if you cannot speak."}},{"k":"the_six_first_actions","v":{"s":"The six first actions"}},{"k":"start_vignette_1_of_10","v":{"s":"🎯 Start — vignette 1 of 10"}},{"k":"vignette","v":{"s":"Vignette "}},{"k":"score","v":{"s":"Score "}},{"k":"accuracy","v":{"s":"Accuracy "}},{"k":"streak","v":{"s":"Streak "}},{"k":"best","v":{"s":"Best "}},{"k":"pick_the_first_action","v":{"s":"Pick the first action"}},{"k":"all_10_vignettes_complete","v":{"s":"🏆 All 10 vignettes complete"}},{"k":"restart","v":{"s":"🔄 Restart"}},{"k":"next_vignette","v":{"s":"➡️ Next vignette"}},{"k":"scenarios_mastered","v":{"s":"Scenarios mastered"}},{"k":"responder_mastery_2","v":{"s":"Responder Mastery"}},{"k":"every_first_action_sleuth_scenario_you","v":{"s":"Every First Action Sleuth scenario you answer correctly at least once locks in here. Per-attempt streak resets between sessions; mastery sticks. Build coverage across all 10 scenarios — and across all 6 first actions — before you trust your reflex."}},{"k":"first_action_coverage","v":{"s":"First-action coverage"}},{"k":"scenarios","v":{"s":"Scenarios"}},{"k":"first_action_locked_in","v":{"s":"First action locked in"}},{"k":"novice_responder","v":{"s":"🌱 Novice responder"}},{"k":"build_foundational_recognition_first","v":{"s":"Build foundational recognition first."}},{"k":"developing","v":{"s":"🟡 Developing"}},{"k":"practice_scenarios_build_automaticity","v":{"s":"Practice scenarios; build automaticity."}},{"k":"competent","v":{"s":"🟢 Competent"}},{"k":"reliable_in_familiar_situations","v":{"s":"Reliable in familiar situations."}},{"k":"expert","v":{"s":"🌟 Expert"}},{"k":"calibrated_across_diverse_vignettes","v":{"s":"Calibrated across diverse vignettes."}},{"k":"hypothesis_which_capability_matters_mo","v":{"s":"Hypothesis: which capability matters most for first-aid response?"}},{"k":"explain_readiness_composition","v":{"s":"Explain readiness composition."}},{"k":"body_position_3d","v":{"s":"Body position (3D)"}},{"k":"readiness_label","v":{"s":"Emergency response readiness"}},{"k":"readiness_blurb","v":{"s":"Build the decision sequence: recognize the emergency, activate help, then choose the appropriate first action."}},{"k":"education_status","v":{"s":"Educational only - real emergencies: call 911"}},{"k":"progress_label","v":{"s":"First Response progress"}},{"k":"core_readiness","v":{"s":"Core readiness"}},{"k":"modules_explored","v":{"s":"Modules explored"}},{"k":"scenario_mastery","v":{"s":"Scenario mastery"}},{"k":"badges","v":{"s":"Badges"}},{"k":"continue_core","v":{"s":"Continue core response path"}},{"k":"continue_practice","v":{"s":"Continue practice"}},{"k":"review","v":{"s":"Review mastery"}},{"k":"core_path","v":{"s":"Recognize - Call - Act"}},{"k":"core_path_blurb","v":{"s":"Start with recognition and emergency activation, then learn the core response modules."}},{"k":"more_practice","v":{"s":"More practice, accessibility, mastery, and resources"}},{"k":"depth_adult_child_infant","v":{"s":"Depth: at least 2 in (5 cm) and no more than about 2.4 in (6 cm) for an adult; about 2 in (5 cm) for a child; about 1.5 in (4 cm) for an infant — in each case roughly one third of the depth of the chest. Source: AHA 2020 Guidelines for CPR & ECC."}},{"k":"b3d_back","v":{"s":"← Menu"}},{"k":"b3d_title","v":{"s":"Body position in 3D"}},{"k":"b3d_intro","v":{"s":"The rhythm trainer teaches you how FAST. This teaches you WHERE — where your hands go on a real chest, where the AED pads go, and what the recovery position actually looks like from every side. Those are the things a flat diagram teaches worst."}},{"k":"b3d_scope_lead","v":{"s":"Scope: "}},{"k":"b3d_scope","v":{"s":"lay rescuer, compression-focused, covering adult, child and infant. This is orientation and practice, not certification — it cannot tell you whether your depth is real, which is exactly what an instructor with a manikin can. Take a hands-on course. In a real emergency, call 911 first or send someone to."}},{"k":"b3d_tab_gate","v":{"s":"1 · Which one do they need?"}},{"k":"b3d_tab_place","v":{"s":"2 · Hand placement"}},{"k":"b3d_tab_depth","v":{"s":"3 · Depth + recoil"}},{"k":"b3d_tab_aed","v":{"s":"4 · AED pads"}},{"k":"b3d_tab_recovery","v":{"s":"5 · Recovery position"}},{"k":"b3d_tab_call","v":{"s":"6 · Run the call"}},{"k":"b3d_age","v":{"s":"Who is it?"}},{"k":"b3d_viewer_label","v":{"s":"Body diagram, 3D. Interactive. Arrow keys rotate, plus and minus zoom, zero resets. Every target here is also a button below."}},{"k":"b3d_failed","v":{"s":"3D view unavailable on this device or network. Every target and every step is a button below — nothing here needs the picture."}},{"k":"b3d_loading","v":{"s":"Loading the body diagram…"}},{"k":"b3d_hint","v":{"s":"Schematic on purpose — a diagram you can walk around, not an anatomical model. Drag or arrow keys to spin."}},{"k":"b3d_gate_h","v":{"s":"Before anything else: are they breathing normally?"}},{"k":"b3d_gate_p","v":{"s":"This single question decides everything that follows. Getting it backwards is the most consequential mistake in this whole module."}},{"k":"b3d_gate_cpr","v":{"s":"→ Compressions"}},{"k":"b3d_gate_rec","v":{"s":"→ Recovery position"}},{"k":"b3d_never","v":{"s":"Never correct"}},{"k":"b3d_place_h","v":{"s":"Where do your hands go?"}},{"k":"b3d_place_p","v":{"s":"Tap a spot on the chest in the 3D view, or pick from the list. Both do the same thing."}},{"k":"b3d_aed_h","v":{"s":"Where do the AED pads go?"}},{"k":"b3d_aed_p","v":{"s":"The pads carry a picture showing this, and the AED talks you through it. Knowing the shape in advance means the picture makes sense when you are under pressure. Two pads, diagonally opposite, so the heart sits between them."}},{"k":"b3d_aed_rules","v":{"s":"Before you press the button"}},{"k":"b3d_depth_h","v":{"s":"How hard, and what happens between pushes"}},{"k":"b3d_depth_for","v":{"s":" — depth for this age"}},{"k":"b3d_breaths","v":{"s":"Do breaths matter here?"}},{"k":"b3d_rate","v":{"s":"And the rate"}},{"k":"b3d_rate_body","v":{"s":"100 to 120 compressions a minute for every age, which is faster than most people expect. The CPR + AED module has a rhythm trainer for exactly this. Keep interruptions as short as you can, and if an AED arrives, turn it on and do what it says."}},{"k":"b3d_call_h","v":{"s":"Run the call"}},{"k":"b3d_call_p","v":{"s":"The other tabs each teach one piece. Here you have to put them together the way a real call makes you — assess, choose a technique for the person in front of you, place your hands, and adapt when an AED turns up."}},{"k":"b3d_call_back","v":{"s":"← Scenarios"}},{"k":"b3d_call_step","v":{"s":"Step "}},{"k":"b3d_call_unsafe","v":{"s":"Unsafe. "}},{"k":"b3d_call_finish","v":{"s":"See how you did →"}},{"k":"b3d_call_next","v":{"s":"Next →"}},{"k":"b3d_call_grade","v":{"s":"Grade: "}},{"k":"b3d_call_wrongs","v":{"s":" wrong · "}},{"k":"b3d_call_unsafes","v":{"s":" unsafe"}},{"k":"b3d_call_unsafe_h","v":{"s":"The unsafe choices matter more than the grade"}},{"k":"b3d_call_unsafe_b","v":{"s":"Every unsafe option in this scenario is one people really choose, usually while trying to help. Run it again and notice what made it look reasonable at the time."}},{"k":"b3d_call_debrief","v":{"s":"What this call teaches"}},{"k":"b3d_call_again","v":{"s":"↺ Run it again"}},{"k":"b3d_call_next_case","v":{"s":"Another scenario →"}},{"k":"b3d_rec_h","v":{"s":"Recovery position, in order"}},{"k":"b3d_rec_p","v":{"s":"Only for someone unresponsive who IS breathing normally. Work through it and watch the body turn."}},{"k":"b3d_rec_reset","v":{"s":"↺ Start again"}},{"k":"b3d_rec_done","v":{"s":"Positioned — now keep watching"}},{"k":"b3d_rec_done_body","v":{"s":"The recovery position buys a protected airway; it does not end the emergency. Stay with them, keep checking that breathing is still normal, and if it stops or turns to gasping, roll them onto their back and start compressions straight away."}},{"k":"hypothesis_input","v":{"s":"First-aid readiness hypothesis"}},{"k":"explanation_input","v":{"s":"First-aid readiness explanation"}},{"k":"body_position_3d_desc","v":{"s":"Where your hands go — adult, child, infant. Depth and recoil. AED pad placement. The recovery position. Then {count} scenarios that make you combine them."}},{"k":"b3d_age_hands","v":{"s":"{age} — what changes"}},{"k":"b3d_aed_p_infant","v":{"s":"The pads carry a picture showing this, and the AED talks you through it. On a baby the picture changes: the pads are the same size they always are, and two of them will not fit side by side on a chest that small. One goes on the front and one on the back, and the heart is still between them."}},{"k":"b3d_aed_size_child","v":{"s":"Look at the size of the pads"}},{"k":"b3d_aed_size_infant","v":{"s":"Look at the size of the pads"}},{"k":"b3d_airway","v":{"s":"If you do give breaths: open the airway first"}},{"k":"b3d_airway_cue","v":{"s":"Open the airway first: "}},{"k":"b3d_airway_cue_infant","v":{"s":"Airway — neutral, do NOT tilt back: "}},{"k":"b3d_gate_watch_agonal","v":{"s":"Watch the chest: agonal gasping"}},{"k":"b3d_gate_watch_normal","v":{"s":"Watch the chest: normal breathing"}}],"id":523}},{"k":"flightsim","v":{"o":[{"k":"hint_t_rotor_start","v":{"s":"💡 Drag UP along the right edge to spin the rotor up — you lift straight off the pad. Watch AGL on the right."}},{"k":"hint_k_rotor_start","v":{"s":"💡 Hold SHIFT to spin the rotor up — you lift straight off the pad. Watch AGL on the right."}},{"k":"hint_t_takeoff","v":{"s":"💡 Drag UP along the right edge for throttle — need ~{vr} kt before you pitch up and take off."}},{"k":"hint_k_takeoff","v":{"s":"💡 Hold SHIFT to add throttle — need ~{vr} kt before W to pitch up and take off."}},{"k":"hint_t_rotate","v":{"s":"💡 You’re fast enough! Drag UP from the middle to pitch up and take off!"}},{"k":"hint_k_rotate","v":{"s":"💡 You’re fast enough! Press W to pitch up and take off!"}},{"k":"hint_t_low","v":{"s":"⚠️ Low altitude! Drag UP on the right edge for throttle, and UP from the middle to pitch up!"}},{"k":"hint_k_low","v":{"s":"⚠️ Low altitude! Add throttle (Shift) and pitch up (W)!"}},{"k":"hint_t_stall","v":{"s":"🚨 STALL! Drag DOWN from the middle to lower the nose, then UP on the right edge for power!"}},{"k":"hint_k_stall","v":{"s":"🚨 STALL! Push S to lower nose, then add power with Shift!"}},{"k":"hint_t_extras","v":{"s":"💡 The Flight Deck panel has the quiz, the force arrows and the camera."}},{"k":"hint_k_extras","v":{"s":"💡 Press Q anytime for a geography quiz! Press F to see force arrows."}},{"k":"tk_t_rotor_1_label","v":{"s":"1. Add power: "}},{"k":"tk_t_rotor_1","v":{"s":"Drag UP along the right edge of the view. The rotor spins up and you lift straight off the pad — no runway roll."}},{"k":"tk_t_rotor_2_label","v":{"s":"2. Hover: "}},{"k":"tk_t_rotor_2","v":{"s":"Watch the AGL readout on the right. Ease the drag back down until the climb stops and you hold a height."}},{"k":"tk_t_rotor_3_label","v":{"s":"3. Move: "}},{"k":"tk_t_rotor_3","v":{"s":"Drag UP from the middle of the view to tip the nose forward and translate; drag down to slow. Drag sideways to turn."}},{"k":"tk_t_rotor_4_label","v":{"s":"4. Land: "}},{"k":"tk_t_rotor_4_drone","v":{"s":"Ease the right-edge drag down and settle at under 200 fpm. Part 107 caps you at 400 ft above the ground."}},{"k":"tk_t_rotor_4_heli","v":{"s":"Ease the right-edge drag down and settle at under 200 fpm. You can land anywhere flat — that is the point of a helicopter."}},{"k":"tk_t_fixed_1_label","v":{"s":"1. Add throttle: "}},{"k":"tk_t_fixed_1","v":{"s":"Drag UP along the right edge of the view to spool the engine to 100%. Watch your speed (kts) climb."}},{"k":"tk_t_fixed_2_label","v":{"s":"2. Build airspeed: "}},{"k":"tk_t_fixed_2","v":{"s":"Roll down the runway. Don't pull up yet. Wait for "}},{"k":"tk_t_fixed_2_vr","v":{"s":"the Vr mark on the airspeed tape"}},{"k":"tk_t_fixed_3_label","v":{"s":"3. Rotate: "}},{"k":"tk_t_fixed_3","v":{"s":"Drag UP from the middle of the view to pitch the nose up gently — about 10°. The plane will lift off naturally."}},{"k":"tk_t_fixed_4_label","v":{"s":"4. Climb: "}},{"k":"tk_t_fixed_4","v":{"s":"Hold the nose up ~5–10° to maintain a steady climb. Don't over-rotate or you'll stall."}},{"k":"lift_short","v":{"s":"Lift"}},{"k":"drag_short","v":{"s":"Drag"}},{"k":"thrust_short","v":{"s":"Thrust"}},{"k":"weight_short","v":{"s":"Weight"}},{"k":"bernoulli_short","v":{"s":"Bernoulli"}},{"k":"navigation_short","v":{"s":"Navigation"}},{"k":"touch_controls","v":{"s":"Touch controls"}},{"k":"touch_stick","v":{"s":"Drag the left or middle of the view — pitch and bank"}},{"k":"touch_throttle","v":{"s":"Drag along the right edge — throttle"}},{"k":"touch_deck","v":{"s":"Everything else is on the Flight Deck panel"}},{"k":"stall_discovery_intro","v":{"s":"You are flying. Adjust airspeed, altitude and angle of attack, and watch which of the three states the wing settles into. There is no score and nothing is revealed to you."}},{"k":"stall_discovery_task","v":{"s":"Sweep one slider at a time. Log what you see. Then write down what you think causes a stall."}},{"k":"debrief_learned_altitude","v":{"s":"🌌 You flew above 10,000 ft, where the air is about three quarters as dense as at sea level. Above 12,500 ft the crew needs supplemental oxygen for any stretch longer than 30 minutes, and above 14,000 ft for the whole flight (FAR 91.211)."}},{"k":"debrief_learned_airports","v":{"s":"✈️ You visited {n} airport(s). Real pilots plan routes using airways — highways in the sky defined by radio beacons."}},{"k":"debrief_learned_places","v":{"s":"📍 You discovered {n} geographic locations. Professional pilots use sectional charts that show terrain, airspace, and obstacles."}},{"k":"debrief_learned_landing","v":{"s":"🧈 Great landing at {fpm} fpm! This sim counts anything under {smooth} fpm as smooth, and under {butter} fpm as butter. The technique is called “flaring” — pitching up gently at 20 ft above the runway."}},{"k":"debrief_learned_fuel","v":{"s":"⏱️ You flew for over 5 minutes. Real pilots track fuel consumption carefully — the {ac} burns about {gph} gallons per hour."}},{"k":"debrief_learned_fuel_none","v":{"s":"⏱️ You flew for over 5 minutes — on no fuel at all. Without an engine to feed, the limit is energy: altitude and airspeed are the only fuel you have."}},{"k":"hud_atis_title","v":{"s":"{code} ATIS  INFO {letter}"}},{"k":"hud_atis_wind","v":{"s":"WIND {dir}° @ {kt}KT"}},{"k":"hud_atis_vis","v":{"s":"VIS {vis}  {sky}"}},{"k":"hud_atis_temp","v":{"s":"TEMP {t}°C  DEW {d}°C"}},{"k":"hud_atis_altimeter","v":{"s":"ALTIMETER {inhg}\""}},{"k":"hud_atis_runway","v":{"s":"RWY IN USE: {rwy}"}},{"k":"hud_gauge_n1","v":{"s":"N1 {n}%"}},{"k":"hud_gauge_torque","v":{"s":"TQ {n}%"}},{"k":"hud_gauge_rpm","v":{"s":"{n} RPM"}},{"k":"hud_survivor_aboard","v":{"s":"✅ SURVIVOR ABOARD — RTB PWM"}},{"k":"hud_distress_beacon","v":{"s":"🆘 DISTRESS BEACON · {nm} nm @ {brg}°"}},{"k":"hud_rescue_now","v":{"s":"AGL {agl} ft · GS {kts} kts · VS {fpm} fpm"}},{"k":"hud_rescue_delta","v":{"s":"Δ {ft} ft to the survivor"}},{"k":"hud_rescue_target","v":{"s":"TGT {dist}ft · {minagl}-{maxagl}ft AGL · <{kts}kts · <{fpm}fpm"}},{"k":"hud_drone_agl","v":{"s":"AGL {ft} ft / {max} max"}},{"k":"hud_drone_vlos","v":{"s":"VLOS {nm} nm / {max} max"}},{"k":"hud_drone_count","v":{"s":"{label}: {n} / {total}"}},{"k":"forces_label_lift","v":{"s":"Lift: {n} lbs"}},{"k":"forces_label_weight","v":{"s":"Weight: {n} lbs"}},{"k":"forces_label_thrust","v":{"s":"Thrust: {n} lbs"}},{"k":"forces_label_drag","v":{"s":"Drag: {n} lbs"}},{"k":"help_tip_takeoff_label","v":{"s":"Takeoff"}},{"k":"help_pitch_up","v":{"s":"Pitch up (climb)"}},{"k":"help_pitch_down","v":{"s":"Pitch down (descend)"}},{"k":"help_bank_left","v":{"s":"Bank left (turn left)"}},{"k":"help_bank_right","v":{"s":"Bank right (turn right)"}},{"k":"help_throttle_up","v":{"s":"Increase throttle"}},{"k":"help_throttle_down","v":{"s":"Decrease throttle"}},{"k":"help_flaps","v":{"s":"Retract / extend flaps one detent"}},{"k":"help_brakes","v":{"s":"Hold wheel brakes on the ground"}},{"k":"help_forces","v":{"s":"Toggle force diagram (lift/drag/thrust/weight arrows)"}},{"k":"help_geo_quiz","v":{"s":"Geography quiz — identify nearby places"}},{"k":"help_pause","v":{"s":"Pause / Resume flight"}},{"k":"help_status","v":{"s":"Read flight status (screen reader / audio summary)"}},{"k":"help_toggle_help","v":{"s":"Toggle this help screen"}},{"k":"help_exit","v":{"s":"Exit to debrief"}},{"k":"help_tip_level","v":{"s":"When altimeter stops changing, you’re level. Adjust pitch."}},{"k":"help_tip_landing","v":{"s":"Reduce throttle → descend slowly → aim for < 200 fpm at touchdown"}},{"k":"help_tip_stall","v":{"s":"If horn sounds: push nose DOWN and add power immediately"}},{"k":"help_tip_nav","v":{"s":"File a flight plan in the menu → follow the heading tape"}},{"k":"help_tip_level_label","v":{"s":"Level flight"}},{"k":"help_tip_landing_label","v":{"s":"Landing"}},{"k":"help_tip_stall_label","v":{"s":"Stall"}},{"k":"help_tip_nav_label","v":{"s":"Navigation"}},{"k":"help_tip_takeoff","v":{"s":"Full throttle → rotate at the Vr speed the takeoff hint shows → you’re flying!"}},{"k":"hud_four_forces","v":{"s":"FOUR FORCES"}},{"k":"hud_f_to_hide","v":{"s":"F to hide"}},{"k":"hud_quiz_next_hint","v":{"s":"Press Q for next question, ESC to close quiz"}},{"k":"hud_quiz_answer_hint","v":{"s":"Press 1, 2, 3, or 4 to answer"}},{"k":"hud_achievement_unlocked","v":{"s":"🏆 ACHIEVEMENT UNLOCKED"}},{"k":"hud_rescue_close","v":{"s":"CLOSE — SLOW + DESCEND TO HOVER"}},{"k":"hud_rescue_hoist","v":{"s":"HOLD POSITION — HOIST IN PROGRESS"}},{"k":"hud_survivor","v":{"s":"SURVIVOR"}},{"k":"hud_rescue_complete","v":{"s":"✅ RESCUE COMPLETE"}},{"k":"hud_survivor_delivered","v":{"s":"Survivor delivered to PWM"}},{"k":"hud_coast_guard_achievement","v":{"s":"+ Coast Guard Pilot achievement"}},{"k":"hud_sprint_complete","v":{"s":"🚀 SPRINT COMPLETE!"}},{"k":"hud_press_esc_menu","v":{"s":"Press ESC to return to menu"}},{"k":"hud_weather_briefing","v":{"s":"🌤️ WEATHER BRIEFING"}},{"k":"hud_controls_help","v":{"s":"✈️ SKYSCHOOL — CONTROLS & HELP"}},{"k":"hud_press_close_help","v":{"s":"Press ? or ESC to close"}},{"k":"hud_flare","v":{"s":"FLARE — ease back on W"}},{"k":"hud_key_legend","v":{"s":"W/S: Pitch | A/D: Bank | Shift/Ctrl: Throttle | V: View | Q: Quiz | F: Forces | Space: Pause | ?: Help"}},{"k":"hud_paused","v":{"s":"⏸ PAUSED"}},{"k":"hud_paused_hint","v":{"s":"Space to resume  ·  I for status  ·  Esc to exit"}},{"k":"hud_chart_legend","v":{"s":"solid = altitude · dashed = speed · time →"}},{"k":"hud_part107_ceiling","v":{"s":"⚠️ PART 107 CEILING — 400 ft IS A LEGAL LIMIT, NOT A LIMIT OF THE DRONE"}},{"k":"hud_stall_warning","v":{"s":"⚠️ STALL WARNING — PUSH NOSE DOWN, ADD POWER"}},{"k":"hud_geo_quiz_score","v":{"s":"🌍 GEOGRAPHY QUIZ  (Score: {n}/{total})"}},{"k":"hud_jet_stream","v":{"s":"JET STREAM +{kt} kt E"}},{"k":"hud_total_mission_time","v":{"s":"Total mission time: {sec} seconds"}},{"k":"hud_capture_hold","v":{"s":"hold {sec}s < {ft}ft AGL < {kts}kts"}},{"k":"hud_battery_remaining","v":{"s":"Battery remaining: {pct}%"}},{"k":"hud_sprint_score","v":{"s":"Score: {n}/{total}  |  🔥 Streak: {streak}"}},{"k":"hud_approaching_country","v":{"s":"📍 APPROACHING: {country}"}},{"k":"hud_best_streak","v":{"s":"Best streak: 🔥 {n}  |  Route: {route}"}},{"k":"hud_approaching_dest","v":{"s":"✈️ APPROACHING {code}"}},{"k":"hud_flight_log","v":{"s":"Flight: {time}  |  Dist: {dist} nm  |  Max Alt: {alt} ft  |  Airports: {airports}"}},{"k":"chip_flaps_deg","v":{"s":"Flaps {deg}°"}},{"k":"chip_flaps_clean","v":{"s":"Clean"}},{"k":"chip_brakes_on","v":{"s":"Brakes on"}},{"k":"chip_brakes_off","v":{"s":"Brakes off"}},{"k":"jump_to_a_section","v":{"s":"Jump to a section"}},{"k":"nav_plan","v":{"s":"Plan"}},{"k":"nav_aircraft","v":{"s":"Aircraft"}},{"k":"nav_airports","v":{"s":"Airports"}},{"k":"nav_study","v":{"s":"Study"}},{"k":"nav_lessons","v":{"s":"Lessons"}},{"k":"nav_challenges","v":{"s":"Challenges"}},{"k":"nav_sprints","v":{"s":"Sprints"}},{"k":"nav_badges","v":{"s":"Badges"}},{"k":"controls","v":{"s":"Controls"}},{"k":"key_pitch","v":{"s":"Pitch"}},{"k":"key_bank","v":{"s":"Bank"}},{"k":"key_throttle","v":{"s":"Throttle"}},{"k":"key_autopilot","v":{"s":"Autopilot"}},{"k":"key_forces","v":{"s":"Forces"}},{"k":"key_quiz","v":{"s":"Quiz"}},{"k":"key_pause","v":{"s":"Pause"}},{"k":"key_help","v":{"s":"Help"}},{"k":"key_exit","v":{"s":"Exit"}},{"k":"unpowered","v":{"s":"Unpowered"}},{"k":"learn_topics_count_desc","v":{"s":"100 topics: forces, instruments, history, careers…"}},{"k":"lesson","v":{"s":"Lesson"}},{"k":"done","v":{"s":"done"}},{"k":"aerodynamics_lessons_nav","v":{"s":"Aerodynamics lessons"}},{"k":"first_lesson","v":{"s":"First lesson"}},{"k":"back_to_menu_arrow","v":{"s":"Back to menu →"}},{"k":"you_re_on_the_pad_here_s_how_to_lift_off","v":{"s":"You're on the pad. Here's how to lift off:"}},{"k":"rotor_1_add_power","v":{"s":"1. Add power: "}},{"k":"rotor_hold","v":{"s":"Hold "}},{"k":"rotor_1_body","v":{"s":" and the rotor spins up. You lift straight off the pad — no runway roll."}},{"k":"rotor_2_hover","v":{"s":"2. Hover: "}},{"k":"rotor_2_body","v":{"s":"Watch the AGL readout on the right. Ease off "}},{"k":"rotor_2_tail","v":{"s":" until the climb stops and you hold a height."}},{"k":"rotor_3_move","v":{"s":"3. Move: "}},{"k":"rotor_3_press","v":{"s":"Press "}},{"k":"rotor_3_body","v":{"s":" to tip the nose forward and translate; "}},{"k":"rotor_3_tail","v":{"s":" slows you. A/D turn."}},{"k":"rotor_4_land","v":{"s":"4. Land: "}},{"k":"rotor_4_drone","v":{"s":"Reduce power gently and settle at under 200 fpm. Part 107 caps you at 400 ft above the ground."}},{"k":"rotor_4_heli","v":{"s":"Reduce power gently and settle at under 200 fpm. You can land anywhere flat — that is the point of a helicopter."}},{"k":"the_vr_mark_on_the_airspeed_tape","v":{"s":"the Vr mark on the airspeed tape"}},{"k":"rotation_speed","v":{"s":"rotation speed"}},{"k":"rotor_science","v":{"s":"A rotor blade is a wing that the engine spins. It makes lift the same way (½ × air density × velocity² × blade area × C"}},{"k":"rotor_science_tail","v":{"s":"), but the blade speed comes from the engine, not from rolling down a runway — so it lifts at zero ground speed. More power = faster blades = more lift than weight = climb."}},{"k":"altitude_speed_profile","v":{"s":"📈 Altitude & Speed Profile"}},{"k":"next_unchecked","v":{"s":"Next unchecked ↓"}},{"k":"fly_now","v":{"s":"✈️ Fly now"}},{"k":"caption_free_flight","v":{"s":"🛫 Free Flight from Portland, ME"}},{"k":"milestone_takeoff","v":{"s":"🛫 LIFTOFF! Lift just exceeded weight. The wing is generating enough low pressure on top to overcome gravity."}},{"k":"milestone_speed100","v":{"s":"💨 100 knots! In level flight the wing carries the aircraft’s full weight at any speed — flying faster does not make more lift, it lets the wing do the same job at a smaller angle of attack. A knot = 1 nautical mile per hour (1.15 mph)."}},{"k":"milestone_alt5000","v":{"s":"🏔️ 5,000 ft! Air density is ~86% of sea level. Your engine produces less power up here, but there’s also less drag."}},{"k":"milestone_alt10000","v":{"s":"✈️ 10,000 ft! Pilots flying unpressurized above 12,500 ft for more than 30 minutes need supplemental oxygen (FAR 91.211). Air pressure here is only ~70% of sea level."}},{"k":"milestone_alt18000","v":{"s":"🌌 Flight Level 180! Above 18,000 ft, all pilots set their altimeters to 29.92 inHg (standard pressure). Welcome to the flight levels."}},{"k":"milestone_alt30000","v":{"s":"🚀 30,000 ft — jet cruise territory! Temperature here is about -50°F, nearing the tropopause (~36,000 ft) where the stratosphere begins. Jet engines are most efficient up here."}},{"k":"milestone_stall_recovery","v":{"s":"✅ Stall recovery! You lowered the nose and added power. The wing is flying again — angle of attack is back below critical."}},{"k":"label_airport","v":{"s":"{code}, {name}, {region}, {elev} ft elevation"}},{"k":"label_airport_hub","v":{"s":"HUB airport"}},{"k":"label_airport_visited","v":{"s":"visited"}},{"k":"chip_hub","v":{"s":"HUB"}},{"k":"airport_region_elevation","v":{"s":"{region} • {elev} ft elevation"}},{"k":"label_file_route","v":{"s":"File Route: file the flight plan and depart"}},{"k":"label_lesson_n_completed","v":{"s":"Lesson {n}: {title} (completed)"}},{"k":"label_lesson_n","v":{"s":"Lesson {n}: {title}"}},{"k":"caption_resume","v":{"s":"▶ Resume"}},{"k":"caption_pause","v":{"s":"⏸ Pause"}},{"k":"caption_cockpit_view","v":{"s":"🎥 Cockpit View"}},{"k":"caption_chase_cam","v":{"s":"🎥 Chase Cam"}},{"k":"caption_forces_on","v":{"s":"⚡ Forces ON"}},{"k":"caption_forces","v":{"s":"⚡ Forces"}},{"k":"label_switch_to_chase_cam","v":{"s":"Switch to Chase Cam"}},{"k":"tip_force_vectors","v":{"s":"Force vectors on the aircraft"}},{"k":"label_aircraft_selected","v":{"s":"{name} ({category}), selected"}},{"k":"label_aircraft","v":{"s":"{name} ({category})"}},{"k":"label_lesson_completed","v":{"s":"{title} (completed)"}},{"k":"label_badge_earned","v":{"s":"{name} — earned. {desc}"}},{"k":"label_badge_locked","v":{"s":"{name} — not yet earned. {desc}"}},{"k":"label_rail_collapse","v":{"s":"Collapse the flight deck controls"}},{"k":"label_rail_expand","v":{"s":"Expand the flight deck controls"}},{"k":"label_resume_flight","v":{"s":"Resume flight"}},{"k":"label_pause_flight","v":{"s":"Pause flight"}},{"k":"label_switch_to_cockpit","v":{"s":"Switch to Cockpit View"}},{"k":"label_hide_forces","v":{"s":"Forces ON — hide force vectors"}},{"k":"label_show_forces","v":{"s":"Forces — show force vectors"}},{"k":"label_release_brakes","v":{"s":"Release wheel brakes"}},{"k":"label_set_brakes","v":{"s":"Set wheel brakes"}},{"k":"chip_brakes_set","v":{"s":"🛑 Brakes SET"}},{"k":"chip_wheel_brakes","v":{"s":"◉ Wheel Brakes"}},{"k":"chip_renderer_3d","v":{"s":"3D terrain"}},{"k":"chip_renderer_canvas","v":{"s":"Canvas"}},{"k":"chip_camera_chase","v":{"s":"Chase cam"}},{"k":"chip_camera_cockpit","v":{"s":"Cockpit"}},{"k":"tip_renderer","v":{"s":"Renderer"}},{"k":"tip_camera","v":{"s":"Camera"}},{"k":"tip_terrain","v":{"s":"Terrain"}},{"k":"tip_weather","v":{"s":"Weather"}},{"k":"tip_flaps_and_brakes","v":{"s":"Flaps and wheel brakes"}},{"k":"tip_places_discovered","v":{"s":"Places discovered this flight"}},{"k":"tip_badges_earned","v":{"s":"Badges earned"}},{"k":"toast_aerotow_release","v":{"s":"🪂 Aerotow release at {ft} ft AGL. No engine — trade altitude for speed and hunt for lift."}},{"k":"toast_survivor_recovered","v":{"s":"🚁 Survivor recovered! Return to PWM and land."}},{"k":"toast_rescue_complete","v":{"s":"✅ Rescue complete — {sec}s"}},{"k":"toast_vlos_lost","v":{"s":"⚠️ Beyond 1 nm — visual line of sight lost!"}},{"k":"toast_distress_beacon","v":{"s":"🚁 Distress beacon. Boater in Casco Bay. Lift off, fly heading 095°, recover the survivor."}},{"k":"toast_fullscreen_unavailable_here","v":{"s":"Fullscreen could not be opened here."}},{"k":"toast_data_exported","v":{"s":"📊 Flight data exported!"}},{"k":"toast_correct","v":{"s":"🎯 Correct!"}},{"k":"toast_weather","v":{"s":"{label} — Wind {kts} kts from {dir}°"}},{"k":"toast_armed_powerline","v":{"s":"🔌 Powerline inspection armed. Fly low (< 60 ft AGL) and slow (< 5 kts) along each pole."}},{"k":"toast_armed_survey","v":{"s":"🛸 Drone armed. Lift off and fly to each photo waypoint. Stay below 400 ft."}},{"k":"toast_inspection_complete","v":{"s":"✅ Inspection complete — all {n} poles documented"}},{"k":"toast_survey_complete","v":{"s":"✅ Survey complete — all {n} photos captured"}},{"k":"toast_po