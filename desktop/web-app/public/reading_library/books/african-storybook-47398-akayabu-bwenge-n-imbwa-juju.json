  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/25473.png",
      "text": "Igihe kimwe harabaye akayabu bwenge n'imbwa juju. Akayabu kaba neza mumuryango utunze. Imbwa isonzeye mw'ibarabara.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=1",
      "sourceDigest": "sha256:412f810d298af4aeeb3f901d161c78e3a0a45c4fcf604c09f1dd4b4c7bbaeeee"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/25474.png",
      "text": "Imbwa nagashavu ibaza akayabu, \"Ni gute umuryango utunze ukwemerera kuba mu nzu yabo?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=2",
      "sourceDigest": "sha256:102844f89e57a12d31b7d76b60ff04b4344b28b30ddc5820ac4b494c11c4eb80"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25475.png",
      "text": "Akayabu karishura, \"Mbana nabantu kubera mfise isuku. Nsaba indya mvuga, nyaau.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=3",
      "sourceDigest": "sha256:d18fa5a8bd137e61bcf4ec9cc9e0b25b02de4f6d612d2e808e2fb8c625844582"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25476.png",
      "text": "Imbwa ibaza, \"Nkubu ndabigizuko nanje bazonyemerera kuba mu nzu?\" Akayabu karishura, \"Ego, ukoze nkuko nakubwiye bazokwemerera. Bazoguha ivyo ufungura.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=4",
      "sourceDigest": "sha256:a79954fbd66531d25c2c45b4c094d154f8476cf459b2166488eb3205f41b9690"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25477.png",
      "text": "Imbwa iravuga, \"Unomunsi sindakubabaza.\" Akayabu kavuga kisimbira hakurya, \"Yambonye unomunsi. Sinshaka ko dusubira kubonana.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=5",
      "sourceDigest": "sha256:cbbe32a35820ebb1f88d9b282e2f94603a51654835592cb1f39bea4fdcabea62"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25478.png",
      "text": "Ifatiye kumpanuro z'akayabu, imbwa ikugira cane kumuryango w'inzu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=6",
      "sourceDigest": "sha256:b3375b3d9e8a7d1febd78ee249d75776065159b5d82bd50f18dd7979b03e1a44"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25479.png",
      "text": "Nyeninzu arayikubita n'ikibando. Imbwa ibweja ivuga, \"Kayabu kambeshe. Ndakabonye nzokarya.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=7",
      "sourceDigest": "sha256:191fc2b78ff986b212a2f6738cf1f0616eb6408be9660bebd25ea458d4a0fc59"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25480.png",
      "text": "Mugihe akayabu kariko karakinira hanze y'inzu, imbwa iragacakira. Ivuga, \"Warambeshe. Warambwiye ngo ngende gukuga kurugi rw'inzu. Beneyo barankubita. Ubu ngire nkurye.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=8",
      "sourceDigest": "sha256:3a67075f7d50afdf8f8d2356845ef2545fda120d9814c104c887fff451d7fddc"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/25481.png",
      "text": "Akayabu karishura, \"Nyumviriza gato, ushobora kundya, mugabo banza umpe akanya nkine gato. Je mukurya imbeba mbanza kuyiha akanya igakina.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=9",
      "sourceDigest": "sha256:89780a651eeddda8eb87085f82f8e2a382619c99defaa2d37ab5a20c0fcef01c"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/25482.png",
      "text": "Imbwa irabaza, \"Ni gute imbeba ikina?\" Akayabu karishura, \"Ndayireka gato ikagenda, hama nkayibwira iharure gatatu. Iriko iraharura, nkaca ndayicakira.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=10",
      "sourceDigest": "sha256:d49281ca54666d193fd61d495b48c8504eaf65923c9f2c64808c68f94a4e887e"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/25483.png",
      "text": "Imbwa irarekura akayabu kidegemvye hama irakabwira gaharure gushika kuri gatatu. Akayabu kaca kariruka gasimbira hejuru kugiti. Imbwa irasaba, \"Ururuka hama uharure gushika kuri gatatu.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=11",
      "sourceDigest": "sha256:cdaf00ce440ce7bb5335555434e106244118a8c842a802e9b70274c2f931ac36"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/25484.png",
      "text": "Akayabu karishura, \"Umviriza wa mbwa, ntusubira kumfata. Sindi ikijuju. Urashobora guharura gushika k'ijana, igihumbi, canke umuriyoni mugabo ntuzosubira kumfata kandi!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47398#page=12",
      "sourceDigest": "sha256:ed4c22390b82f159bb35ef203535cc7f4bdde0e90f943a83590a3d7cabf1604e"
    }
  ],
