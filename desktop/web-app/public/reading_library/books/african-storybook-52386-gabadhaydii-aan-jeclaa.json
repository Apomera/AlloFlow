  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/18757.png",
      "text": "Tani waa Natabo, waxaa la dhashay lix wiil.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=1",
      "sourceDigest": "sha256:627906992f7f360ff5a3db22e454a6f801acd7db36547ac71c65a9f72b8816c8"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/18758.png",
      "text": "Waalidkeed ayaa siiyay dhari yar. Way jeceshahay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=2",
      "sourceDigest": "sha256:d38089e42944eed8f3f456c0967a612d09f95276c0a6cccf4bf7bf676e4627b8"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/18759.png",
      "text": "Maalin ayay walaaladeed ka jabiyeen dharigeedii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=3",
      "sourceDigest": "sha256:b8b51c0bc39657446853c81f7f3edbbe59e8660524c0a45fd9fa87c6d6cac913"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/18760.png",
      "text": "Natabo way wayday dharigeedii. Way ooyday oo ooyday.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=4",
      "sourceDigest": "sha256:70238ae6ad4b22a5470218844ee99fc45886a1621904a86af86669d6ab2e8099"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/18761.png",
      "text": "Natabo way carartay. Waxay kortay geed dheer.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=5",
      "sourceDigest": "sha256:715a4635f003e2b8c9e238bff4f9175cb7e614379313e5b9e37bbad96fc839cd"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/18762.png",
      "text": "Waalidkeed ayaa helay. Waxay ku dheheen, \"Fadlan soo deg.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=6",
      "sourceDigest": "sha256:12fd3fab485e0f10d448fa7900c98bf1699246f68dcb4cee8d1d2092081389c3"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/18763.png",
      "text": "Walaaladeed ayaa ku heesay, \"Fadlan soo deg.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=7",
      "sourceDigest": "sha256:c6b7495e68625f3b65f45893f6034ef259ddcc5d4b6f59db50e0c5e21bb26d9f"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/18764.png",
      "text": "Natabo way ku maadsatahy heestii walaaladeed.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=8",
      "sourceDigest": "sha256:74b1ae77f54f8e1d2ea251365c56c4f0cc0694ed493004c1f51fc4124784750e"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/18765.png",
      "text": "Kadib waxaa imaatay Natabo saaxiibadeed. \"Fadlan soo deg,\" ayay ku heestay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=9",
      "sourceDigest": "sha256:b04807508c8f0cc486f6c24da9e32c13c1afbcbbbfbd9dba6ca52877ce668ef1"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/18766.png",
      "text": "Natabo saaxiibadeed heestii bay wadeen ilaa ay ka soo degtay geedkii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=10",
      "sourceDigest": "sha256:af7b12df21c60c8f01d267f5c81b75e443418a3c74fabb721f900667f1541c54"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/18767.png",
      "text": "Asxaabtii guriga ayay u lugeeyeen.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=11",
      "sourceDigest": "sha256:2ef2955800b54d09bda925017a7fc3e4d5a33298a89bef1d1ed91ff7f845f0dc"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/18768.png",
      "text": "Qofkasta wuxuu u dabaal degay in Natabo guriga timid. Natabo waxaa la siiyay dhari cusub.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52386#page=12",
      "sourceDigest": "sha256:2aebcc33a5d9c077bbc619c0efbb6e0db8d1a87ec2cf8fb26f184174bfc2871f"
    }
  ],
