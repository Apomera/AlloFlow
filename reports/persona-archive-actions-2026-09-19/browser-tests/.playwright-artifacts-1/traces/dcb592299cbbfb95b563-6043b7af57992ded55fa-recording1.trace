_state_orbital_m","v":{"s":"Design note: discrete 4-state orbital marker; no fuel-efficiency score; no reveal — by design."}},{"k":"loading_space_explorer","v":{"s":"Loading Space Explorer..."}},{"k":"mars_desc","v":{"s":"The Red Planet — our closest neighbor."}},{"k":"europa_desc","v":{"s":"Jupiter's ice moon — subsurface ocean may harbor life."}},{"k":"titan_desc","v":{"s":"Saturn's largest moon — methane lakes and thick haze."}},{"k":"enceladus_desc","v":{"s":"Geysers of water erupt from a hidden ocean beneath the ice."}},{"k":"venus_cloud_desc","v":{"s":"Floating habitats in the Venusian upper atmosphere."}},{"k":"proxima_desc","v":{"s":"The nearest exoplanet — 4.24 light-years away."}},{"k":"moon_base_desc","v":{"s":"Establish humanity's first permanent Moon base at Shackleton Crater."}},{"k":"io_desc","v":{"s":"The most volcanically active body in the solar system — 400+ active volcanoes."}},{"k":"asteroid_desc","v":{"s":"A metallic asteroid worth $10,000 quadrillion — possibly a protoplanet core."}},{"k":"solar_v2_desc","v":{"s":"+20% power generation"}},{"k":"recycler_desc","v":{"s":"-30% O₂ consumption per turn"}},{"k":"rad_shield_desc","v":{"s":"Blocks radiation events"}},{"k":"ion_drive_desc","v":{"s":"-40% fuel cost for travel"}},{"k":"ai_copilot_desc","v":{"s":"Hints on optimal event choices"}},{"k":"cryo_bay_desc","v":{"s":"Crew doesn't consume O₂ during transit"}},{"k":"isru_desc","v":{"s":"Extract resources from local environment"}},{"k":"med_bay_desc","v":{"s":"+15 morale recovery per turn"}},{"k":"back_to_mission_select","v":{"s":"Back to mission select"}},{"k":"hypothesis_input","v":{"s":"Orbit hypothesis"}},{"k":"available_upgrades","v":{"s":"Available ship upgrades"}},{"k":"back_to_destinations","v":{"s":"← Back to destinations"}},{"k":"balanced_preset","v":{"s":"Use balanced preset"}},{"k":"choose_destination","v":{"s":"Choose a destination"}},{"k":"choose_destination_help","v":{"s":"Begin with Mars or the Moon, then unlock harder expeditions."