<summary class="min-h-11 py-2 text-sm font-bold text-indigo-900">Practice with sample data</summary>
<div class="flex items-center gap-1.5 mb-2">
<span class="text-[11px]">⚙️</span>
<span class="text-[11px] font-black text-indigo-700 uppercase tracking-wider">Sandbox Config</span>
</div>
<div class="grid grid-cols-2 gap-2 mb-3">
<div>
<label class="text-[11px] font-bold text-indigo-700 block mb-0.5">📅 Period</label>
<select aria-label="Sandbox period in days" class="w-full px-2 py-1.5 border border-indigo-600 rounded-lg text-xs bg-white text-indigo-800 font-medium">
<option value="7">7 days</option>
<option value="14" selected="">14 days</option>
<option value="30">30 days</option>
<option value="60">60 days</option>
<option value="90">90 days</option>
</select>
</div>
<div>
<label class="text-[11px] font-bold text-indigo-700 block mb-0.5">📝 Entries</label>
<select aria-label="Sandbox entry count" class="w-full px-2 py-1.5 border border-indigo-600 rounded-lg text-xs bg-white text-indigo-800 font-medium">
<option value="10">10 entries</option>
<option value="15">15 entries</option>
<option value="25" selected="">25 entries</option>
<option value="40">40 entries</option>
<option value="60">60 entries</option>
</select>
</div>
</div>
<button aria-label="Load Demo Student" class="w-full py-2.5 bg-gradient-to-r from-emerald-700 to-teal-700 hover:from-emerald-800 hover:to-teal-800 text-white rounded-xl font-bold text-sm shadow outline-none focus:ring-2 focus:ring-emerald-300 transition-all flex justify-center items-center gap-2">
<span>🚀</span>
<span>Load Demo (14d / 25 entries)</span>
</button>
</details>
</div>
</div>
</div>
<details class="rounded-xl border border-slate-300 bg-white p-4">
<summary class="min-h-11 py-2 text-sm font-bold text-slate-800">Workspace files and settings</summary>
<p role="status" class="text-sm text-slate-700 my-2">Changes save automatically in this browser. Download a backup to keep a file copy.</p>
<div class="flex flex-wrap gap-2">
<button type="button" class="min-h-11 rounded-lg border border-slate-400 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-50">Download backup</button>
<button type="button" class="min-h-11 rounded-lg border border-slate-400 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-50">Load workspace from file</button>
</div>
<input type="file" accept=".json" aria-label="Load BehaviorLens workspace JSON file" class="hidden"/>
</details>
<p class="text-sm text-slate-700">Find specialist tools, learning resources, and practice scenarios in All tools.</p>
</div>
</div>
</div>"
