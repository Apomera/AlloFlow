y":"41","text-anchor":"end"},"100%"]],["STRONG",{},"52%"]]],["P",{"class":"ei-small"},"Each dot is one organism; the dark line marks the mean. ","Traits and chance both affected survival. The offspring mean can shift again through inheritance and random sampling."],["DETAILS",{},["SUMMARY",{"class":"ei-small"},"Read exact cohort means"],["DIV",{"class":"ei-table-wrap"},["TABLE",{},["CAPTION",{"class":"ei-small"},"Insulation · mean on a 0–1 teaching scale"],["THEAD",{},["TR",{},["TH",{"scope":"col"},"Cohort"],["TH",{"scope":"col"},"Population"],["TH",{"scope":"col"},"Mean"]]],["TBODY",{},["TR",{},["TH",{"scope":"row"},"Parents"],["TD",{},"60"],["TD",{},"0.5234"]],["TR",{},["TH",{"scope":"row"},"Survivors"],["TD",{},"47"],["TD",{},"0.5105"]],["TR",{},["TH",{"scope":"row"},"Offspring"],["TD",{},"60"],["TD",{},"0.5159"]]]]]]],["DIV",{"class":"ei-evidence"},["SECTION",{"class":"ei-card ei-stack"},["DIV",{"class":"ei-row ei-between"},["DIV",{},["DIV",{"class":"ei-kicker"},"The story in your data"],["H2",{},"What changed across generations?"]],["BUTTON",{"type":"button"},"Export CSV"]],["DIV",{"class":"ei-chart-legend"},["SPAN",{"style":"--trait-color: #98713b;"},"Coat lightness"],["SPAN",{"style":"--trait-color: #4e7760;"},"Insulation"],["SPAN",{"style":"--trait-color: #716aa1;"},"Leg length"]],["svg",{"viewBox":"0 0 600 190","class":"ei-chart","role":"img","aria-label":"Mean inherited traits across generations. Exact values are available in the generation table below."},["g",{},["line",{"x1":"38","x2":"583","y1":"160","y2":"160","stroke":"#dce3d3","stroke-dasharray":"3 5"}],["text",{"x":"30","y":"164","text-anchor":"end"},"0"]],["g",{},["line",{"x1":"38","x2":"583","y1":"90","y2":"90","stroke":"#dce3d3","stroke-dasharray":"3 5"}],["text",{"x":"30","y":"94","text-anchor":"end"},"50"]],["g",{},["line",{"x1":"38","x2":"583","y1":"20","y2":"20","stroke":"#dce3d3","stroke-dasharray":"3 5"}],["text",{"x":"30","y":"24","text-anchor":"end"},"100"]],["g",{},["polyline",{"points":