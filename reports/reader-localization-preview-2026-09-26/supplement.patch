+import { describe, expect, it } from 'vitest';
+import { createRequire } from 'node:module';
+import { readFileSync } from 'node:fs';
+import { translator } from './helpers/reader_locale_harness.js';
+const require = createRequire(import.meta.url);
+const { validatePayload, placeholders, lookup, run, parseArgs } = require('../dev-tools/i18n/apply_reader_contract_locales.cjs');
+const payload = JSON.parse(readFileSync('translations/reader-preview-locales.json', 'utf8'));
+const english = JSON.parse(readFileSync('ui_strings.js', 'utf8'));
+describe('frozen eight-key audio/preview locale contract', () => {
+  it('checks this batch independently and includes it in the full scoped gate', () => {
+    expect(validatePayload(payload, english, 8)).toHaveLength(8);
+    expect(run(false, 'preview')).toMatchObject({ keys: 8, locales: 5, changedFiles: 0 });
+    expect(run(false, 'all')).toMatchObject({ keys: 125, changedFiles: 0 });
+    expect(parseArgs(['--check', '--batch=preview'])).toEqual({ apply: false, batch: 'preview' });
+  });
+  it('refuses changed preview semantics, raw keys and incorrect ready/total placeholders', () => {
+    const changed = structuredClone(english); changed.simplified.layout_preview_note = 'This previews a delivered lesson.';
+    expect(() => validatePayload(payload, changed, 8)).toThrow(/English copy changed/);
+    const invalid = structuredClone(payload); invalid.locales.thai['simplified.layout_preview_title'] = 'simplified.layout_preview_title';
+    expect(() => validatePayload(invalid, english, 8)).toThrow(/Missing translation/);
+    invalid.locales.thai['simplified.layout_preview_title'] = payload.locales.thai['simplified.layout_preview_title'];
+    invalid.locales.thai['simplified.review_audio_current_detail'] = 'เสียง {saved} / {total}';
+    expect(() => validatePayload(invalid, english, 8)).toThrow(/Placeholder mismatch/);
+  });
+  for (const [locale, values] of Object.entries(payload.locales)) it(locale + ': both mirrors contain meaningful labels with exact placeholders', () => {
+    for (const prefix of ['lang', 'desktop/web-app/public/lang']) {
+      const pack = JSON.parse(readFileSync(prefix + '/' + locale + '.js', 'utf8'));
+      for (const [key, value] of Object.entries(values)) { expect(lookup(pack, key)).toBe(value); expect(placeholders(value)).toEqual(placeholders(payload.english[key])); expect(value).not.toBe(key); }
+    }
+  });
+  it('allows Chinese to put total before ready without losing zero or repeating the wrong count', () => {
+    const t = translator('chinese_simplified'), value = t('simplified.review_audio_current_detail', { ready: 0, total: 12 });
+    expect(value).toBe('12 段句子音频中有 0 段已在此设备上准备就绪，适用于当前设置。');
+    expect(value).not.toMatch(/\{(?:ready|total)\}/);
+  });
+});
