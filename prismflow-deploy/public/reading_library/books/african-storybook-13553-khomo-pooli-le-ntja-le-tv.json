    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/10567.png",
      "text": "Pooli eona ea reka kobo e ts'oeu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=3",
      "sourceDigest": "sha256:94ba0adebbe4d27ac223052591f2aab46764d1711b2346203d1f941e622a572b"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/13530.png",
      "text": "Ntja eona e ne e batla ho reka lieta tsencha, empa e ne e sena chelete. Eaba eona ha e reke letho.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=4",
      "sourceDigest": "sha256:16f98108f15300160e945c948fef2d816ab84750b75eb8ad69f5e3f1347c11af"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/13531.png",
      "text": "Khomo, Pooli, le Ntja lia hae ka tekesi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=5",
      "sourceDigest": "sha256:e5388c8659e51c815b22a5ab060efae353447c693f9b14889f09cfc0e00eb6d9"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/10568.png",
      "text": "O kanna oa bona Khomo masimong e eme, e shebela hae. E lakatsa hore e ke e kabe e le hae, e shebelletse TV ea eona e ncha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=6",
      "sourceDigest": "sha256:f42c7b45819332d5507175975e28ff04600c413f8c42f47dd1a8306f2892e72b"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/6378.png",
      "text": "O kanna oa bona Pooli e baleha, hobane ha e batle ha o ka e ts'oara. E ne e nahana hore o tloha o e hlobolisa kobo ea eona e ts'oeu, eoo e lulang e apere ka nako eohle.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=7",
      "sourceDigest": "sha256:c90eb9b1ea3b1ecd141db8ab3ac4d9d7183d4a84b09aa2e8fffcc1f78d21384a"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/6377.png",
      "text": "O kanna oa bona Ntja e mathela koloing ea tekesi. Hona joale e na le chelete. E batla hoea toropong. E lo reka lieta tse ncha tsa eona.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=8",
      "sourceDigest": "sha256:38ed00f9bf99390d3bd52f07cd6764bb8e7b30cc47fe5d4b8835b1fec8d6e949"
    }
  ],
