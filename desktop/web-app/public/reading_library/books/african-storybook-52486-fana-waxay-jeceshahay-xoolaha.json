    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/25265.png",
      "text": "Fana iyo qoyskeedu waxay ku nool yihiin magaalo mashquul badan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=1",
      "sourceDigest": "sha256:64b496f28bf154518a94ef55c744d92247709ab83410564f1fde5724fbd9f010"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/25266.png",
      "text": "Fana waxay leedahay bisad, laba digaag, ari, iyo qoolley.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=2",
      "sourceDigest": "sha256:9f4ec41efb1e712a7d1e0032d464f129182d9663ebd374f30bec720457a441f1"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25267.png",
      "text": "Maalin maalmaha ka mid ah, Fana waxay aragtay carruur dhagxaan ku tuuraya qoolleyda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=3",
      "sourceDigest": "sha256:e18d301f8b806a630aa48877656c75d192b201d73f26039d346da88c54e244b6"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25268.png",
      "text": "Fana waxay ku orodday caruurtii. Weyna ku qaylisay, \"Joojiya dhagxeynta.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=4",
      "sourceDigest": "sha256:5bd8421943f5370e82e66ba5d290b395a829f2fa1f00df71f8e714e89269c152"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25269.png",
      "text": "Fana waxay gurigeeda geysay labadi qooley si ay u daryeesho.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=5",
      "sourceDigest": "sha256:c49837444778ee83b40f9e51f0fbbb88a9eba54f1d985ec64d2528b00b519281"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25270.png",
      "text": "Waxey siisay cunto waxeyna qoyskeeda u sheegtay sida ay u badbaadisay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=6",
      "sourceDigest": "sha256:2f0136b9f44c4123c49ea7c0e957b6fa293ae3fa77e3a0b30e6570537127fb4e"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25271.png",
      "text": "Fana iyo waalidiinteed waxay qooleyda ay geeyeen xarunta dhaqtarka xoolaha",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=7",
      "sourceDigest": "sha256:78283f739c82305598ecd2a81d9e512b528189b8c2760f2777a1c116754f31bc"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25272.png",
      "text": "Fana waxay saaxiibadeed u sheegtay, \"Xayawaanku waa saaxiibadeenna. Waa inaan ilaalinaa.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52486#page=8",
      "sourceDigest": "sha256:fe5b55d65c3a84f93d3f4166b3b4dc21375389a5c9d848987d06629ed8c0a071"
    }
  ],
