:"practice_bank","v":{"s":"Practice Bank"}},{"k":"no_timer_browse_at_your_pace","v":{"s":"No timer. Browse at your pace."}},{"k":"calculator","v":{"s":"Calculator"}},{"k":"don_t_let_students_use_without_first_a","v":{"s":"Don't let students use without first attempting by hand."}},{"k":"fact_families","v":{"s":"Fact Families"}},{"k":"generate_5_10_fact_families_per_day","v":{"s":"Generate 5-10 fact families per day."}},{"k":"estimation","v":{"s":"Estimation"}},{"k":"speed_up_activity_30_seconds_per_quest","v":{"s":"Speed-up activity. 30 seconds per question."}},{"k":"vocab_quiz","v":{"s":"Vocab Quiz"}},{"k":"use_for_warm_up_routine","v":{"s":"Use for warm-up routine."}},{"k":"mastery","v":{"s":"Mastery"}},{"k":"review_weekly","v":{"s":"Review weekly."}},{"k":"exam_prep","v":{"s":"Exam Prep"}},{"k":"take_untimed_first_then_under_time_pre","v":{"s":"Take untimed first, then under time pressure."}},{"k":"daily","v":{"s":"Daily"}},{"k":"set_a_low_daily_target_5_problems_for_","v":{"s":"Set a low daily target (5 problems) for sustainability."}},{"k":"goal_setter","v":{"s":"Goal Setter"}},{"k":"realistic_ambitious","v":{"s":"Realistic > ambitious."}},{"k":"word_problems","v":{"s":"Word Problems"}},{"k":"hints_are_progressive_encourage_studen","v":{"s":"Hints are progressive — encourage students to try first."}},{"k":"games","v":{"s":"Games"}},{"k":"rotate_games_don_t_over_rely_on_one","v":{"s":"Rotate games — don't over-rely on one."}},{"k":"recipe_scaler","v":{"s":"Recipe Scaler"}},{"k":"pair_with_a_hands_on_activity_real_rec","v":{"s":"Pair with a Hands-on Activity (real recipe)."}},{"k":"don_t_do_all_in_one_sitting","v":{"s":"Don't do all in one sitting."}},{"k":"fraction_art","v":{"s":"Fraction Art"}},{"k":"print_and_frame","v":{"s":"Print and frame!"}},{"k":"probability","v":{"s":"Probability"}},{"k":"real_coin_flip_experiments","v":{"s":"Real coin flip experiments."}},{"k":"magic_tricks","v":{"s":"Magic Tricks"}},{"k":"present_as_a_trick_first_explain_after","v":{"s":"Present as a \"trick\" first; explain after."}},{"k":"real_world_tools","v":{"s":"Real-World Tools"}},{"k":"bring_in_actual_rulers_and_measuring_c","v":{"s":"Bring in actual rulers and measuring cups."}},{"k":"story_mode","v":{"s":"Story Mode"}},{"k":"read_aloud_as_a_class","v":{"s":"Read aloud as a class."}},{"k":"brain_teasers","v":{"s":"Brain Teasers"}},{"k":"don_t_reveal_hints_too_quickly","v":{"s":"Don't reveal hints too quickly."}},{"k":"levels","v":{"s":"Levels"}},{"k":"pair_with_badge_celebration","v":{"s":"Pair with badge celebration."}},{"k":"data_analysis","v":{"s":"Data Analysis"}},{"k":"collect_real_classroom_data","v":{"s":"Collect real classroom data."}},{"k":"quotes","v":{"s":"Quotes"}},{"k":"pick_one_per_week","v":{"s":"Pick one per week."}},{"k":"worksheets","v":{"s":"Worksheets"}},{"k":"mix_topics_for_retention","v":{"s":"Mix topics for retention."}},{"k":"rti_probes","v":{"s":"RTI Probes"}},{"k":"graph_results_over_time","v":{"s":"Graph results over time."}},{"k":"reports","v":{"s":"Reports"}},{"k":"download_as_txt_attach_to_docs","v":{"s":"Download as txt, attach to docs."}},{"k":"standards","v":{"s":"Standards"}},{"k":"filter_by_grade_level","v":{"s":"Filter by grade level."}},{"k":"misconceptions","v":{"s":"Misconceptions"}},{"k":"read_remediation_strategies_carefully","v":{"s":"Read remediation strategies carefully."}},{"k":"iep_goals","v":{"s":"IEP Goals"}},{"k":"adapt_language_to_your_student","v":{"s":"Adapt language to your student."}},{"k":"lessons","v":{"s":"Lessons"}},{"k":"use_as_templates_for_your_own","v":{"s":"Use as templates for your own."}},{"k":"sessions","v":{"s":"Sessions"}},{"k":"name_sessions_by_student_initials","v":{"s":"Name sessions by student initials."}},{"k":"settings","v":{"s":"Settings"}},{"k":"color_blind_palette_helps_many_student","v":{"s":"Color-blind palette helps many students with visual processing."}},{"k":"math_talks","v":{"s":"Math Talks"}},{"k":"push_for_student_explanations","v":{"s":"Push for student explanations."}},{"k":"ref_card","v":{"s":"Ref Card"}},{"k":"print_and_laminate_2","v":{"s":"Print and laminate."}},{"k":"start_unit_with_1_hands_on_activity","v":{"s":"Start unit with 1 hands-on activity."}},{"k":"multilingual","v":{"s":"Multilingual"}},{"k":"pair_home_language_and_english_explici","v":{"s":"Pair home-language and English explicitly."}},{"k":"mc_remediation","v":{"s":"Mc Remediation"}},{"k":"walk_through_one_strategy_per_session","v":{"s":"Walk through one strategy per session."}},{"k":"print_lab","v":{"s":"Print Lab"}},{"k":"print_before_the_school_day_starts","v":{"s":"Print before the school day starts."}},{"k":"differentiation","v":{"s":"Differentiation"}},{"k":"pick_the_closest_profile_not_a_perfect","v":{"s":"Pick the closest profile, not a perfect match."}},{"k":"rubric","v":{"s":"Rubric"}},{"k":"use_to_give_students_feedback_on_reaso","v":{"s":"Use to give students feedback on reasoning."}},{"k":"scope_sequence","v":{"s":"Scope & Sequence"}},{"k":"cross_reference_with_your_district_pac","v":{"s":"Cross-reference with your district pacing guide."}},{"k":"tab_guide_every_feature_explained","v":{"s":"📚 Tab guide — every feature explained"}},{"k":"each_tab_includes_its_purpose_when_to_","v":{"s":"Each tab includes its purpose, when to use it, and a pro tip. "}},{"k":"useful_for_new_teachers_substitute_tea","v":{"s":"Useful for new teachers, substitute teachers, or anyone evaluating the tool."}},{"k":"egyptian_unit_fractions_1_n_and_specia","v":{"s":"Egyptian unit fractions (1/n) and special notations for 2/3. They wrote any fraction as a sum of distinct unit fractions: 2/5 = 1/3 + 1/15."}},{"k":"babylonians_used_base_60_for_fractions","v":{"s":"Babylonians used base 60 for fractions. This is why we still have 60 minutes in an hour and 360 degrees in a circle."}},{"k":"pythagoreans_believed_all_numbers_were","v":{"s":"Pythagoreans believed all numbers were ratios of whole numbers. Hippasus reportedly proved √2 is irrational and was thrown overboard."}},{"k":"indian_mathematicians_develop_place_va","v":{"s":"Indian mathematicians develop place-value notation that will eventually enable modern decimal arithmetic."}},{"k":"comprehensive_treatment_of_fractions_i","v":{"s":"Comprehensive treatment of fractions including reduction to lowest terms."}},{"k":"systematic_treatment_of_fractions_in_h","v":{"s":"Systematic treatment of fractions in his Arithmetic — introduces algorithms for the four operations."}},{"k":"fibonacci_introduces_hindu_arabic_nume","v":{"s":"Fibonacci introduces Hindu-Arabic numerals and modern fraction notation (line between top and bottom) to Europe."}},{"k":"simon_stevin_advocates_decimal_fractio","v":{"s":"Simon Stevin advocates decimal fractions for everyday calculation. The decimal point as we know it follows."}},{"k":"napier_s_logarithms_make_fraction_arit","v":{"s":"Napier's logarithms make fraction arithmetic tractable for astronomy and navigation."}},{"k":"the_decimal_point_becomes_universal_ac","v":{"s":"The decimal point becomes universal across Western mathematics."}},{"k":"modern_american_math_curriculum_solidi","v":{"s":"Modern American math curriculum solidifies around the procedure-first model that the IES Practice Guide later critiques."}},{"k":"georges_cuisenaire_invents_colored_fra","v":{"s":"Georges Cuisenaire invents colored fraction rods. Becomes the prototype for fraction strips and the \"fraction wall\" model."}},{"k":"siegler_et_al_publish_developing_effec","v":{"s":"Siegler et al. publish \"Developing Effective Fractions Instruction K-8.\" Recommends number-line model as central."}},{"k":"ccss_math_k_8_fraction_trajectory_beco","v":{"s":"CCSS-Math K-8 fraction trajectory becomes the de facto national framework, with explicit attention to magnitude reasoning."}},{"k":"open_source_agpl_licensed_fraction_ins","v":{"s":"Open-source, AGPL-licensed fraction-instruction tool combining all major pedagogical frameworks in one platform."}},{"k":"fraction_history_timeline","v":{"s":"⏰ Fraction history timeline"}},{"k":"4_000_years_of_fraction_history_from_e","v":{"s":"4,000 years of fraction history, from Egyptian unit fractions to modern computational tools."}},{"k":"multiple_representations_udl","v":{"s":"Multiple representations (UDL)"}},{"k":"show_the_same_idea_visually_verbally_a","v":{"s":"Show the SAME idea visually, verbally, and physically (dual coding) — this helps ALL students. It does NOT mean a student is a single \"visual / auditory / kinesthetic\" type; that meshing claim is unsupported (Pashler 2008)."}},{"k":"autism_spectrum","v":{"s":"Autism spectrum"}},{"k":"predictable_routines_limit_visual_clut","v":{"s":"Predictable routines. Limit visual clutter. Allow extra processing time."}},{"k":"short_bursts_movement_breaks_embed_nov","v":{"s":"Short bursts. Movement breaks. Embed novelty."}},{"k":"dyscalculia","v":{"s":"Dyscalculia"}},{"k":"build_slowly_with_concrete_materials_u","v":{"s":"Build slowly with concrete materials. Use multiple representations."}},{"k":"english_language_learner","v":{"s":"English Language Learner"}},{"k":"show_fraction_vocabulary_in_home_langu","v":{"s":"Show fraction vocabulary in home language alongside English. The math is universal."}},{"k":"gifted_accelerated","v":{"s":"Gifted / accelerated"}},{"k":"push_depth_density_infinity_continued_","v":{"s":"Push depth: density, infinity, continued fractions. Avoid acceleration without depth."}},{"k":"differentiation_tool","v":{"s":"🎯 Differentiation tool"}},{"k":"pick_a_learning_profile_to_see_which_f","v":{"s":"Pick a learning profile to see which Fraction Lab tabs and accommodations are most helpful. "}},{"k":"these_are_suggestions_not_prescription","v":{"s":"These are suggestions, not prescriptions — every student is unique."}},{"k":"recommended_fraction_lab_features","v":{"s":"👍 Recommended Fraction Lab features"}},{"k":"avoid","v":{"s":"⚠ Avoid"}},{"k":"tip","v":{"s":"💡 Tip"}},{"k":"goal_setter_2","v":{"s":"🎯 Goal setter"}},{"k":"set_a_persona