}},{"k":"nonprofit","v":{"s":"Nonprofit"}},{"k":"key_programs","v":{"s":"Key Programs"}},{"k":"john_slatin_accessu","v":{"s":"John Slatin AccessU"}},{"k":"annual_hands_on_training_conference_hy","v":{"s":"Annual hands-on training conference (hybrid). Named after Dr. John Slatin, it teaches practical skills in coding, usability, and inclusive design. Next session: May 11–14, 2026."}},{"k":"knowbility_org_programs_accessu","v":{"s":"🔗 knowbility.org/programs/accessu"}},{"k":"accessibility_internet_rally_air","v":{"s":"Accessibility Internet Rally (AIR)"}},{"k":"an_8_week_global_online_competition_pa","v":{"s":"An 8-week global online competition pairing volunteer web professionals with nonprofits to build accessible websites. Started as a one-day hackathon and evolved into Knowbility’s signature program."}},{"k":"knowbility_org_programs_air","v":{"s":"🔗 knowbility.org/programs/air"}},{"k":"how_to_get_involved","v":{"s":"🤝 How to Get Involved"}},{"k":"volunteer_at_accessu","v":{"s":"Volunteer at AccessU"}},{"k":"help_with_registration_room_hosting_an","v":{"s":"Help with registration, room hosting, and support. Earn free conference access for a 4-8 hour shift."}},{"k":"join_an_air_team","v":{"s":"Join an AIR Team"}},{"k":"developers_designers_and_content_creat","v":{"s":"Developers, designers, and content creators build accessible websites for nonprofits."}},{"k":"learn_2","v":{"s":"Learn"}},{"k":"attend_accessu_sessions_use_free_resou","v":{"s":"Attend AccessU sessions, use free resources, and build your accessibility skills."}},{"k":"advocate","v":{"s":"Advocate"}},{"k":"use_this_tool_to_audit_and_report_acce","v":{"s":"Use THIS tool to audit and report accessibility barriers. Be a change agent in your community!"}},{"k":"visit_knowbility_volunteer_today","v":{"s":"♿ Visit Knowbility — Volunteer Today"}},{"k":"ada_title_ii_digital_accessibility","v":{"s":"⚖️ ADA Title II & Digital Accessibility"}},{"k":"accessibility_complaint_builder","v":{"s":"📝 Accessibility Complaint Builder"}},{"k":"found_accessibility_barriers_generate_","v":{"s":"Found accessibility barriers? Generate a formal complaint letter to request change. Choose your recipient:"}},{"k":"ada_coordinator","v":{"s":"🏢 ADA Coordinator"}},{"k":"dept_of_justice","v":{"s":"🏛️ Dept. of Justice"}},{"k":"entity_name_school_city_agency","v":{"s":"Entity Name (school, city, agency)"}},{"k":"e_g_portland_public_schools_city_of_au","v":{"s":"e.g. Portland Public Schools, City of Austin"}},{"k":"entity_name","v":{"s":"Entity name"}},{"k":"describe_the_impact_who_is_affected_an","v":{"s":"Describe the impact (who is affected and how)"}},{"k":"e_g_my_child_uses_a_screen_reader_and_","v":{"s":"e.g. My child uses a screen reader and cannot navigate the enrollment forms..."}},{"k":"impact_description","v":{"s":"Impact description"}},{"k":"generate_complaint_letter","v":{"s":"Generate complaint letter"}},{"k":"copy_to_clipboard_2","v":{"s":"📋 Copy to Clipboard"}},{"k":"reset_complaint","v":{"s":"Reset complaint"}},{"k":"new_letter","v":{"s":"🔄 New Letter"}},{"k":"how_to_file","v":{"s":"📋 How to File"}},{"k":"contact_the_entity_s_ada_coordinator_f","v":{"s":"Contact the entity’s ADA Coordinator first — they can often resolve issues quickly."}},{"k":"if_unresolved_file_with_the_doj_at_ada","v":{"s":"If unresolved, file with the DOJ at ada.gov/file-a-complaint/"}},{"k":"you_can_also_mail_u_s_doj_civil_rights","v":{"s":"You can also mail: U.S. DOJ, Civil Rights Division, 950 Pennsylvania Ave NW, Washington DC 20530"}},{"k":"ada_info_line_1_800_514_0301_voice_1_8","v":{"s":"ADA Info Line: 1-800-514-0301 (voice) / 1-833-610-1264 (TTY)"}},{"k":"audit_history","v":{"s":"Audit History"}},{"k":"no_audits_yet_run_your_first_audit_to_","v":{"s":"No audits yet. Run your first audit to see results here."}},{"k":"grade","v":{"s":" · Grade: "}},{"k":"badges_2","v":{"s":"Badges ("}},{"k":"1.1.1_desc","v":{"s":"All images, icons, and graphics must have text alternatives (alt text) so screen readers can describe them to blind users."}},{"k":"1.3.1_desc","v":{"s":"Content structure (headings, lists, tables) must be conveyed through proper HTML tags, not just visual formatting."}},{"k":"1.4.3_desc","v":{"s":"Text must have at least 4.5:1 contrast ratio against its background. Large text needs 3:1."}},{"k":"2.1.1_desc","v":{"s":"All functionality must work with a keyboard alone — no mouse required."}},{"k":"2.4.1_desc","v":{"s":"Pages must have a \"Skip to content\" link so keyboard users can bypass repeated navigation."}},{"k":"2.4.4_desc","v":{"s":"The purpose of each link must be clear from its text. \"Click here\" is not descriptive."}},{"k":"2.4.7_desc","v":{"s":"When an element receives keyboard focus, it must have a visible indicator (outline, ring, highlight)."}},{"k":"3.1.1_desc","v":{"s":"The page must declare its language (e.g., lang=\"en\") so screen readers pronounce words correctly."}},{"k":"3.3.2_desc","v":{"s":"Form inputs must have visible labels that are programmatically associated (not just placeholder text)."}},{"k":"4.1.2_desc","v":{"s":"All interactive elements must expose their name, role, and state to assistive technology."}},{"k":"first_audit_desc","v":{"s":"Complete your first accessibility audit"}},{"k":"five_audits_desc","v":{"s":"Complete 5 audits"}},{"k":"perfect_find_desc","v":{"s":"Find a document with score below 30"}},{"k":"advocate_desc","v":{"s":"Audit 3 different websites"}},{"k":"expert_desc","v":{"s":"Learn about all 10 core criteria"}},{"k":"reporter_desc","v":{"s":"Download an audit report"}},{"k":"change_agent_desc","v":{"s":"Generate your first accessibility complaint"}},{"k":"social_scout_desc","v":{"s":"Audit 3 social media posts"}},{"k":"title2_expert_desc","v":{"s":"Complete a government website audit"}},{"k":"knowbility_ally_desc","v":{"s":"Explore all Knowbility programs"}},{"k":"back_to_stem_tools","v":{"s":"Back to STEM tools"}},{"k":"back","v":{"s":"Back"}},{"k":"measured_checks","v":{"s":"Measured checks"}},{"k":"deterministic_badge","v":{"s":"Deterministic · not AI"}},{"k":"measured_hint","v":{"s":"Counted directly from your HTML by code (DOMParser + WCAG contrast math) — ground truth, separate from the AI passes."}},{"k":"no_measured_issues","v":{"s":"No problems in the automatically-checkable criteria."}},{"k":"measured_scope","v":{"s":"Automated checks cover only part of WCAG; the AI passes add judgement on the rest."}}],"id":469}},{"k":"ai","v":{"o":[{"k":"get_hint","v":{"s":"Get a hint"}}],"id":470}},{"k":"algebraCAS","v":{"o":[{"k":"solve","v":{"s":"🔍 Solve"}},{"k":"find_the_value_of_x","v":{"s":"Find the value of x"}},{"k":"factor","v":{"s":"🧩 Factor"}},{"k":"factor_an_expression","v":{"s":"Factor an expression"}},{"k":"simplify","v":{"s":"✨ Simplify"}},{"k":"simplify_an_expression","v":{"s":"Simplify an expression"}},{"k":"expand","v":{"s":"🔎 Expand"}},{"k":"expand_distribute","v":{"s":"Expand & distribute"}},{"k":"elementary","v":{"s":"Elementary"}},{"k":"middle_school","v":{"s":"Middle School"}},{"k":"advanced","v":{"s":"Advanced"}},{"k":"linear","v":{"s":"🔢 Linear"}},{"k":"quadratic","v":{"s":"📈 Quadratic"}},{"k":"multi_step","v":{"s":"🔣 Multi-Step"}},{"k":"fractions","v":{"s":"🍕 Fractions"}},{"k":"word_problem","v":{"s":"📖 Word Problem"}},{"k":"systems","v":{"s":"⚖ Systems"}},{"k":"random","v":{"s":"🎲 Random"}},{"k":"sorry_something_went_wrong_try_again","v":{"s":"Sorry, something went wrong. Try again!"}},{"k":"solve_2","v":{"s":"🔍 Solve"}},{"k":"practice","v":{"s":"🎯 Practice"}},{"k":"builder","v":{"s":"🧱 Builder"}},{"k":"scale","v":{"s":"⚖ Scale"}},{"k":"tutor","v":{"s":"🤖 Tutor"}},{"k":"algebra_cas_sections","v":{"s":"Algebra CAS sections"}},{"k":"algebra_expression_input","v":{"s":"Algebra expression input"}},{"k":"step_by_step_solution","v":{"s":"Step-by-Step Solution"}},{"k":"step_by_step_solution_2","v":{"s":"📋 Step-by-Step Solution"}},{"k":"difficulty","v":{"s":"Difficulty"}},{"k":"problem_type","v":{"s":"Problem Type"}},{"k":"problem_type_2","v":{"s":"Problem Type"}},{"k":"problem","v":{"s":"📋 PROBLEM"}},{"k":"your_answer","v":{"s":"Your answer..."}},{"k":"practice_answer_input","v":{"s":"Practice answer input"}},{"k":"no_solution_available","v":{"s":"No solution available."}},{"k":"no_solution_available_2","v":{"s":"No solution available."}},{"k":"new_problem","v":{"s":"New Problem"}},{"k":"new_problem_2","v":{"s":"🔄 New Problem"}},{"k":"tile_palette","v":{"s":"Tile Palette"}},{"k":"your_equation_click_tile_to_remove","v":{"s":"Your Equation (click tile to remove)"}},{"k":"click_tiles_above_to_build_an_equation","v":{"s":"Click tiles above to build an equation..."}},{"k":"solve_it","v":{"s":"🔍 Solve It"}},{"k":"clear","v":{"s":"Clear"}},{"k":"clear_2","v":{"s":"🗑 Clear"}},{"k":"numbers","v":{"s":"● Numbers "}},{"k":"variables","v":{"s":"● Variables "}},{"k":"operators","v":{"s":"● Operators "}},{"k":"special","v":{"s":"● Special"}},{"k":"enter_equation","v":{"s":"Enter Equation"}},{"k":"e_g_3x_5_14","v":{"s":"e.g. 3x + 5 = 14"}},{"k":"balance_scale_equation_input","v":{"s":"Balance scale equation input"}},{"k":"load","v":{"s":"Load"}},{"k":"load_2","v":{"s":"Load"}},{"k":"interactive_algebra_balance_scale_visu","v":{"s":"Interactive algebra balance scale visualization"}},{"k":"apply_to_both_sides","v":{"s":"Apply to Both Sides"}},{"k":"value_to_apply_to_both_sides","v":{"s":"Value to apply to both sides"}},{"k":"steps_applied","v":{"s":"Steps Applied:"}},{"k":"new_equation","v":{"s":"New Equation"}},{"k":"new_equation_2","v":{"s":"🔄 New Equation"}},{"k":"ask_the_ai_tutor_anything_about_algebr","v":{"s":"Ask the AI tutor anything about algebra!"}},{"k":"tutor_2","v":{"s":"🤖 Tutor"}},{"k":"listen","v":{"s":"Listen"}},{"k":"listen_2","v":{"s":"🔊 Listen"}},{"k":"ask_about_algebra","v":{"s":"Ask about algebra..."}},{"k":"ask_the_algebra_tutor","v":{"s":"Ask the algebra tutor"}},{"k":"ask_question","v":{"s":"Ask question"}},{"k":"algebra_cas","v":{"s":"🧮 Algebra CAS"}},{"k":"back","v":{"s":"Back"}},{"k":"back_2","v":{"s":"← Back"}},{"k":"solve_algebra_step_by_step","v":{"s":"Solve — algebra step-by-step"}},{"k":"linear_quadratic_factoring_system_simp","v":{"s":"Linear, quadratic, factoring, system, simplify. AI shows every step + names the property used (distributive, combining like terms, FOIL). Common AP / SAT / Algebra-1 problems all reduce to ~8 transformations."}},{"k":"practice_graded_drills","v":{"s":"Practice — graded drills"}},{"k":"multi_difficulty_problem_sets_the_ai_c","v":{"s":"Multi-difficulty problem sets. The AI checks your answer and walks through the full worked solution so you can see exactly where your steps diverged. Builds the habit of writing math, not just guessing."}},{"k":"builder_design_your_own_equation","v":{"s":"Builder — design your own equation"}},{"k":"pick_variables_operations_target_value","v":{"s":"Pick variables + operations + target value; system generates an algebra problem matching your design. Useful for teachers building worksheets and for students reverse-engineering \"what makes a problem hard.\""}},{"k":"scale_visual_algebra_balance","v":{"s":"Scale — visual algebra balance"}},{"k":"drag_weights_onto_a_balance_to_model_x","v":{"s":"Drag weights onto a balance to model x + 3 = 7 visually. The single most useful intuition for early algebra — equations are scales, not blanks to fill in. Whatever you do to one side, do to the other."}},{"k":"tutor_ask_ai_for_help","v":{"s":"Tutor — ask AI for help"}},{"k":"ask_the_tutor_about_any_algebra_concep","v":{"s":"Ask the tutor about any algebra concept or stuck-step. Tutor knows your grade band, recent attempts, and the active problem. Best for \"why didn't my approach work?\" questions."}},{"k":"verified_check","v":{"s":"Verified by the math engine"}},{"k":"verify_warning","v":{"s":"This answer does not check out"}},{"k":"checked_by_engine","v":{"s":"Checked by the math engine"}},{"k":"balance_nonzero","v":{"s":"Choose a nonzero value. Dividing by zero is undefined; multiplying by zero loses information about the solution."}},{"k":"balance_linear_scope","v":{"s":"Use a linear equation in x here. The Solve tab handles other equation types."}},{"k":"balance_finite_value","v":{"s":"Enter a finite number for this operation."}},{"k":"on_both_sides","v":{"s":"on both sides"}},{"k":"balance_identity","v":{"s":"Both sides are identical: every real x is a solution."}},{"k":"balance_impossible","v":{"s":"The variable terms match but the constants differ: there is no solution."}},{"k":"balance_preserved","v":{"s":"The same reversible operation was applied to both sides; the solution set stays the same."}},{"k":"balance_decimal_value","v":{"s":"Enter an ordinary whole number or decimal for this operation."}},{"k":"balance_model_meaning","v":{"s":"A solution makes both sides equal. Add or subtract a term such as 2x, or multiply or divide by a nonzero constant. Fractions stay exact."}},{"k":"balance_scalar_operation","v":{"s":"Multiply or divide by a nonzero constant. To move an x-term, add or subtract that term on both sides."}},{"k":"balance_term_value","v":{"s":"Enter a number, fraction, or linear term such as 2x for this operation."}},{"k":"scale_operation_hint","v":{"s":"Choose an operation to transform both sides. Follow equivalent equations until x is isolated, and use the worked steps to explain why the solution stays the same."}},{"k":"trial_is_solution","v":{"s":"This value is a solution of the current equation."}},{"k":"trial_not_solution","v":{"s":"This value is not a solution of the current equation."}},{"k":"trial_plot_legend","v":{"s":"Square: left side. Circle: right side. Both rows use the same number scale."}},{"k":"trial_plot_scale","v":{"s":"The scale fits these values and may change after an operation. Positions are approximate; the calculations above are exact."}},{"k":"trial_title","v":{"s":"Test a value for x"}},{"k":"trial_prompt","v":{"s":"Predict whether the sides will match, then substitute the same value for every x. You can enter an integer, decimal, or fraction such as -1/2."}},{"k":"trial_value_label","v":{"s":"Value of x"}},{"k":"trial_check","v":{"s":"Check value"}},{"k":"trial_invalid_value","v":{"s":"Enter a number or fraction with a nonzero denominator, such as 3, -0.5, or 1/3."}},{"k":"trial_invalid_equation","v":{"s":"This check supports linear equations in x. Enter one equation with an equals sign; use Solve for other equation types."}},{"k":"trial_left","v":{"s":"Left side"}},{"k":"trial_right","v":{"s":"Right side"}},{"k":"trial_difference","v":{"s":"Left side − right side: "}},{"k":"trial_zero_difference","v":{"s":"A difference of zero means the two sides match."}},{"k":"trial_plot_unavailable","v":{"s":"These exact values are outside the diagram’s numerical range. Compare the calculations above."}},{"k":"trial_identity","v":{"s":"The expressions simplify to the same x-term and constant. Every real x is a solution; this one check is an example."}},{"k":"trial_contradiction","v":{"s":"Both expressions have the same x-term but different constants. No value of x can make them equal."}},{"k":"trial_keep_x","v":{"s":"Same x, before and after the last operation"}},{"k":"trial_before","v":{"s":"Before: "}},{"k":"trial_after","v":{"s":"After: "}},{"k":"trial_stays_solution","v":{"s":"This x makes both equations true. The reversible operation preserved equality."}},{"k":"trial_stays_outside","v":{"s":"This x makes neither equation true. A reversible operation does not turn a non-solution into a solution."}},{"k":"trial_compare_check","v":{"s":"Compare whether this x makes each equation true."}},{"k":"trial_reversed","v":{"s":"The side with the larger value switched. Multiplying or dividing by a negative constant reverses this order, while preserving whether the sides are equal."}},{"k":"trial_decrease","v":{"s":"Test x − 1"}},{"k":"trial_increase","v":{"s":"Test x + 1"}},{"k":"trial_beam_meaning","v":{"s":"The level beam shows the goal: equal sides. Open Test a value for x to check whether a particular value makes them equal."}}],"id":471}},{"k":"allobotsage","v":{"o":[{"k":"sr_preset_save_cancelled","v":{"s":"Preset save cancelled."}},{"k":"sr_preset_kept","v":{"s":"Preset kept."}},{"k":"sr_rested_at_shrine_advancing","v":{"s":"Rested at shrine. Advancing."}},{"k":"sr_expedition_abandoned_returned_to_the_hub","v":{"s":"Expedition abandoned. Returned to the hub."}},{"k":"sr_expedition_continued","v":{"s":"Expedition continued."}},{"k":"sr_reflection_saved","v":{"s":"Reflection saved."}},{"k":"sr_marked_as_understood_next_question","v":{"s":"Marked as understood. Next question."}},{"k":"sr_still_tough_keeping_in_review_queue_next_question","v":{"s":"Still tough — keeping in review queue. Next question."}},{"k":"sage","v":{"s":"Sage"}},{"k":"master","v":{"s":"Master"}},{"k":"adept","v":{"s":"Adept"}},{"k":"equipped","v":{"s":"Equipped"}},{"k":"space_explorer","v":{"s":"Space Explorer"}},{"k":"math_lab","v":{"s":"Math Lab"}},{"k":"word_sounds","v":{"s":"Word Sounds"}},{"k":"immersive_reader","v":{"s":"Immersive Reader"}},{"k":"close_preview","v":{"s":"Close preview"}},{"k":"casts","v":{"s":"Casts"}},{"k":"questions","v":{"s":"Questions"}},{"k":"accuracy","v":{"s":"Accuracy"}},{"k":"ai","v":{"s":"✨ AI"}},{"k":"drill_in_study_hall","v":{"s":"📚 Drill in Study Hall"}},{"k":"close","v":{"s":"Close"}},{"k":"spellforge","v":{"s":"Spellforge"}},{"k":"allobot_starbound_sage","v":{"s":"AlloBot: Starbound Sage"}},{"k":"claim_daily_essence_bonus","v":{"s":"Claim daily essence bonus"}},{"k":"daily_bonus_ready","v":{"s":"Daily Bonus ready!"}},{"k":"essence_scales_with_how_many_source_to","v":{"s":"Essence scales with how many source tools you’ve tended."}},{"k":"welcome_future_sage","v":{"s":"Welcome, future Sage!"}},{"k":"sage_spells_unlock_when_you_make_progr","v":{"s":"Sage spells unlock when you make progress in OTHER STEAM Lab tools — Space Explorer, Math Lab, RoadReady, and more. Each spell is a retrieval-practice ability: you cast by answering a question from that tool