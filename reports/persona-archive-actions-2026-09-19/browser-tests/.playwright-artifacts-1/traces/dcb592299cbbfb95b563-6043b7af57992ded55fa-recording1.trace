= R.useState(defaults);\n      R.useEffect(() => {\n        var _current$personaScrol;\n        const node = (_current$personaScrol = current.personaScrollRef) === null || _current$personaScrol === void 0 ? void 0 : _current$personaScrol.current;\n        if (node && node.__alloStickToBottom !== false) node.scrollTop = node.scrollHeight;\n      }, [current.personaState.chatHistory]);\n      w.__update = patch => setCurrent(prev => ({\n        ...prev,\n        ...patch,\n        personaState: patch.personaState ? {\n          ...prev.personaState,\n          ...patch.personaState\n        } : prev.personaState\n      }));\n      const p = {\n        ...current,\n        setPersonaState: next => setCurrent(prev => ({\n          ...prev,\n          personaState: typeof next === 'function' ? next(prev.personaState) : next\n        })),\n        setPersonaInput: text => w.__update({\n          personaInput: text\n        }),\n        setIsPersonaFreeResponse: value => w.__update({\n          isPersonaFreeResponse: value\n        }),\n        setShowPersonaHints: value => w.__update({\n          showPersonaHints: value\n        }),\n        handleToggleShowPersonaHints: () => w.__update({\n          showPersonaHints: !current.showPersonaHints\n        }),\n        handlePersonaChatSubmit: text => w.__calls.sent.push(text || current.personaInput),\n        handlePanelChatSubmit: text => w.__calls.sent.push(text),\n        handleSelectPersona: person => w.__calls.selected.push(person.name),\n        handleStartPanelChat: () => w.__calls.started++,\n        handleListPersonaSessionArchive: async () => {\n          w.__calls.archiveLoads++;\n          if (w.__calls.archiveLoads <= (config.archiveFailures || 0)) throw new Error('Storage temporarily unavailable');\n          return {\n            sessions: archiveRows.slice(),\n            unreadable: []\n          };\n        },\n        handleDownloadPersonaSessionArchive: async (key, format) => {\n          w.__calls.archiv