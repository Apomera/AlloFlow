 & Taxonomy"}},{"k":"field_naturalist","v":{"s":"Field Naturalist"}},{"k":"pellet_id_key","v":{"s":"Pellet ID Key"}},{"k":"birding_gear_guide","v":{"s":"Birding Gear Guide"}},{"k":"careers_in_raptor_biology","v":{"s":"Careers in Raptor Biology"}},{"k":"falconry_curriculum","v":{"s":"Falconry Curriculum"}},{"k":"anatomy_atlas_svg","v":{"s":"Anatomy Atlas (SVG)"}},{"k":"prey_atlas","v":{"s":"Prey Atlas"}},{"k":"fossil_record","v":{"s":"Fossil Record"}},{"k":"population_demographics","v":{"s":"Population & Demographics"}},{"k":"habitat_atlas","v":{"s":"Habitat Atlas"}},{"k":"lesson_plan_library","v":{"s":"Lesson Plan Library"}},{"k":"id_mystery_cases","v":{"s":"ID Mystery Cases"}},{"k":"regional_field_guides","v":{"s":"Regional Field Guides"}},{"k":"world_tour","v":{"s":"World Tour"}},{"k":"records_superlatives","v":{"s":"Records & Superlatives"}},{"k":"threats_database","v":{"s":"Threats Database"}},{"k":"expert_spotlights","v":{"s":"Expert Spotlights"}},{"k":"field_scenarios","v":{"s":"Field Scenarios"}},{"k":"species_20_deep_profiles","v":{"s":"Species 20-Deep Profiles"}},{"k":"comparative_anatomy","v":{"s":"Comparative Anatomy"}},{"k":"raptor_mythbusters","v":{"s":"Raptor Mythbusters"}},{"k":"research_stations","v":{"s":"Research Stations"}},{"k":"conservation_orgs","v":{"s":"Conservation Orgs"}},{"k":"raptor_museums","v":{"s":"Raptor Museums"}},{"k":"recommended_reading","v":{"s":"Recommended Reading"}},{"k":"documentaries_films","v":{"s":"Documentaries + Films"}},{"k":"nest_build_cookbook","v":{"s":"Nest-Build Cookbook"}},{"k":"raptor_math_lab","v":{"s":"Raptor Math Lab"}},{"k":"public_engagement","v":{"s":"Public Engagement"}},{"k":"deep_glossary_b","v":{"s":"Deep Glossary B"}},{"k":"closing_reflection","v":{"s":"Closing Reflection"}},{"k":"rescue_decision_tree","v":{"s":"Rescue Decision Tree"}},{"k":"age_plumage_guide","v":{"s":"Age & Plumage Guide"}},{"k":"molt_atlas","v":{"s":"Molt Atlas"}},{"k":"wing_formula_calculator","v":{"s":"Wing Formula Calculator"}},{"k":"data_reference_tables","v":{"s":"Data Reference Tables"}},{"k":"banding_codes","v":{"s":"Banding Codes"}},{"k":"sonogram_audio_guide","v":{"s":"Sonogram + Audio Guide"}},{"k":"local_hot_spots_guide","v":{"s":"Local Hot Spots Guide"}},{"k":"backyard_feeder_hawks","v":{"s":"Backyard Feeder Hawks"}},{"k":"illustration_gallery","v":{"s":"Illustration Gallery"}},{"k":"song_scripts","v":{"s":"Song Scripts"}},{"k":"field_meditations","v":{"s":"Field Meditations"}},{"k":"habitat_restoration","v":{"s":"Habitat Restoration"}},{"k":"kids_activities","v":{"s":"Kids Activities"}},{"k":"reading_levels","v":{"s":"Reading Levels"}},{"k":"question_bank","v":{"s":"Question Bank"}},{"k":"iucn_status_atlas","v":{"s":"IUCN Status Atlas"}},{"k":"flight_dynamics","v":{"s":"Flight Dynamics"}},{"k":"social_media_guide","v":{"s":"Social Media Guide"}},{"k":"master_index","v":{"s":"Master Index"}},{"k":"open_datasets","v":{"s":"Open Datasets"}},{"k":"achievements_quests","v":{"s":"Achievements & Quests"}},{"k":"farewell_credits","v":{"s":"Farewell + Credits"}},{"k":"hero_biographies","v":{"s":"Hero Biographies"}},{"k":"curated_links","v":{"s":"Curated Links"}},{"k":"big_quotes","v":{"s":"Big Quotes"}},{"k":"final_vocabulary","v":{"s":"Final Vocabulary"}},{"k":"20k_finale","v":{"s":"20K Finale"}},{"k":"glossary","v":{"s":"Glossary"}},{"k":"field_id_quiz","v":{"s":"Field ID Quiz"}},{"k":"resources","v":{"s":"Resources"}},{"k":"species_id","v":{"s":"Species & ID"}},{"k":"identify_compare_profile_quiz","v":{"s":"Identify, compare, profile + quiz"}},{"k":"labs_physics","v":{"s":"Labs & Physics"}},{"k":"hands_on_simulations_calculations","v":{"s":"Hands-on simulations + calculations"}},{"k":"behavior_biology","v":{"s":"Behavior & Biology"}},{"k":"how_raptors_live_hunt_and_grow","v":{"s":"How raptors live, hunt, and grow"}},{"k":"conservation_2","v":{"s":"Conservation"}},{"k":"threats_recovery_and_what_to_do","v":{"s":"Threats, recovery, and what to do"}},{"k":"habitats_travel","v":{"s":"Habitats & Travel"}},{"k":"where_to_find_them_globally_locally","v":{"s":"Where to find them globally + locally"}},{"k":"history_culture","v":{"s":"History & Culture"}},{"k":"5_000_years_of_human_raptor_relationsh","v":{"s":"5,000 years of human-raptor relationship"}},{"k":"teaching_practice","v":{"s":"Teaching & Practice"}},{"k":"lessons_activities_careers","v":{"s":"Lessons, activities, careers"}},{"k":"reference_resources","v":{"s":"Reference & Resources"}},{"k":"glossaries_books_films_data","v":{"s":"Glossaries, books, films, data"}},{"k":"specialty_reflection","v":{"s":"Specialty & Reflection"}},{"k":"pellets_feeders_meditations_finale","v":{"s":"Pellets, feeders, meditations, finale"}},{"k":"raptor_hunt_predator_physics_biology","v":{"s":"Raptor Hunt: Predator Physics + Biology"}},{"k":"hunt_as_a_peregrine_at_240_mph_crush_b","v":{"s":"Hunt as a peregrine at 240 mph. Crush bones at 530 psi as a harpy. See vole urine trails in UV like a kestrel. Glide silently on owl feathers. Then study the biology that makes it all possible."}},{"k":"25_sections_20_species_6_interactive_l","v":{"s":"25 sections · 20 species · 6 interactive labs · anatomy + acuity demo · case studies · 42-term glossary · 70-question quiz"}},{"k":"not_sure_where_to_start","v":{"s":"🎲 Not sure where to start?"}},{"k":"jump_to_a_random_section","v":{"s":"Jump to a random section"}},{"k":"surprise_me_random_section","v":{"s":"🎰 Surprise me — random section"}},{"k":"launch_3d_hunt_simulator","v":{"s":"Launch 3D Hunt Simulator"}},{"k":"launch_hunt_sim","v":{"s":"Launch Hunt Sim"}},{"k":"third_person_3d_stoop_sim_wasd_to_fly_","v":{"s":"Third-person 3D stoop sim. WASD to fly, Shift to dive, Space to pull up, F to strike. Species-specific physics."}},{"k":"browse_species_roster","v":{"s":"Browse Species Roster"}},{"k":"species_roster_2","v":{"s":"Species Roster"}},{"k":"20_species_peregrine_harpy_golden_bald","v":{"s":"20 species: peregrine, harpy, golden, bald, red-tail, goshawk, owl, osprey, kestrel, Cooper's, snowy, gyrfalcon, kite. Mass, talon force, vision, hunt style."}},{"k":"talon_mechanics_2","v":{"s":"Talon Mechanics"}},{"k":"talon_mechanics_3","v":{"s":"Talon Mechanics"}},{"k":"grip_force_psi_compared_across_species","v":{"s":"Grip force PSI compared across species. Why harpy eagles crush monkey skulls while peregrines punch with clenched feet at 200+ mph."}},{"k":"deep_science_modules","v":{"s":"🧠 Deep-Science Modules"}},{"k":"vision_4_8_human_acuity","v":{"s":"Vision (4-8× human acuity)"}},{"k":"flight_physics_2","v":{"s":"Flight Physics"}},{"k":"stoop_calculator_2","v":{"s":"Stoop Calculator"}},{"k":"owl_silent_flight","v":{"s":"Owl Silent Flight"}},{"k":"day_vs_night_eyes","v":{"s":"Day vs Night Eyes"}},{"k":"ddt_recovery","v":{"s":"DDT + Recovery"}},{"k":"field_id_2","v":{"s":"Field ID"}},{"k":"resources_2","v":{"s":"Resources"}},{"k":"rank_by_talon_force","v":{"s":"Rank by talon force"}},{"k":"from_memory_order_these_5_species_by_g","v":{"s":"From memory: order these 5 species by grip force, weakest to strongest — bald eagle, harpy eagle, golden eagle, great horned owl, peregrine."}},{"k":"peregrine_230_psi_bald_eagle_400_great","v":{"s":"Peregrine (230 psi) → Bald eagle (400) → Great horned owl (500) → Harpy eagle (530) → Golden eagle (750)"}},{"k":"match_silhouette_to_family","v":{"s":"Match silhouette to family"}},{"k":"which_family_has_pointed_swept_back_wi","v":{"s":"Which family has POINTED swept-back wings + a medium tail with a tomial-tooth notch on the upper beak?"}},{"k":"falconidae_falcons_pointed_wings_the_t","v":{"s":"Falconidae — falcons. Pointed wings + the tomial tooth (used to sever the cervical vertebrae) are diagnostic."}},{"k":"stoop_physics","v":{"s":"Stoop physics"}},{"k":"estimate_a_peregrine_at_242_mph_termin","v":{"s":"Estimate: a peregrine at 242 mph terminal velocity carries roughly how much kinetic energy at impact?"}},{"k":"5_000_j_pistol_bullet_class_ke_0_95_kg","v":{"s":"~5,000 J — pistol-bullet class. KE = ½ × 0.95 kg × (108 m/s)² ≈ 5,540 J."}},{"k":"uv_vision","v":{"s":"UV vision"}},{"k":"which_family_of_raptor_can_see_ultravi","v":{"s":"Which raptor family starred in the famous (now-debated) study claiming it tracks vole urine trails in ultraviolet?"}},{"k":"falconidae_kestrels_especially_vole_ur","v":{"s":"Falconidae (kestrels especially). Vole urine reflects UV strongly; the kestrel sees \"glowing highways\" of rodent travel routes. Viitala et al 1995 Nature."}},{"k":"silent_flight_mechanism","v":{"s":"Silent flight mechanism"}},{"k":"name_the_3_owl_feather_features_that_p","v":{"s":"Name the 3 owl-feather features that produce silent flight."}},{"k":"comb_leading_edge_serrated_primaries_f","v":{"s":"Comb leading edge (serrated primaries) + fringed trailing edge + velvety dorsal surface. Shifts noise to ~16 kHz, above prey hearing range."}},{"k":"owl_3d_hearing","v":{"s":"Owl 3D hearing"}},{"k":"how_does_an_owl_tell_whether_a_sound_c","v":{"s":"How does an owl tell whether a sound came from ABOVE or BELOW its head?"}},{"k":"ear_asymmetry_left_ear_opening_sits_hi","v":{"s":"Ear asymmetry: left ear opening sits higher on the skull than the right. Sound from above hits left ear first by ~30 microseconds; from below, right first. Payne 1962."}},{"k":"where_the_rivers_meet","v":{"s":"Where the rivers meet"}},{"k":"what_is_the_world_s_largest_single_sit","v":{"s":"What is the world's largest single-site raptor migration count? About how many birds pass through each fall?"}},{"k":"veracruz_river_of_raptors_mexico_5_mil","v":{"s":"Veracruz River of Raptors (Mexico) — ~5 million birds per fall. Atlantic + Mississippi + Central flyways all converge before crossing into Central America."}},{"k":"why_eagles_are_slow_to_recover","v":{"s":"Why eagles are slow to recover"}},{"k":"in_k_selected_raptor_demographics_whic","v":{"s":"In K-selected raptor demographics, which is the highest-leverage parameter for population growth?"}},{"k":"adult_annual_survival_even_small_drops","v":{"s":"Adult annual survival. Even small drops (e.g., from lead poisoning) flip λ from growing to declining. Adult breeders are worth 5-10× juveniles demographically."}},{"k":"ddt_recovery_2","v":{"s":"DDT recovery"}},{"k":"roughly_how_many_peregrine_pairs_were_","v":{"s":"Roughly how many peregrine pairs were left in the lower 48 US at the species' nadir in 1972?"}},{"k":"fewer_than_50_the_species_was_function","v":{"s":"Fewer than 50. The species was functionally extinct east of the Rockies before the 1972 US DDT ban + The Peregrine Fund's captive-breeding program restored it to ~3,200 pairs by 2020."}},{"k":"tucker_1998","v":{"s":"Tucker 1998"}},{"k":"why_do_peregrines_fly_a_logarithmic_sp","v":{"s":"Why do peregrines fly a logarithmic spiral approach instead of a straight line?"}},{"k":"constant_retinal_angle_on_the_prey_no_","v":{"s":"Constant retinal angle on the prey — no head turn needed at terminal velocity, no drag penalty. Identical algorithm to AIM-9 Sidewinder missiles."}},{"k":"what_s_in_a_pellet","v":{"s":"What's in a pellet?"}},{"k":"a_barn_owl_pellet_is_composed_of_rough","v":{"s":"A barn owl pellet is composed of roughly what proportions of fur vs. bone vs. teeth?"}},{"k":"about_40_60_fur_matrix_20_30_bone_frag","v":{"s":"About 40-60% fur (matrix), 20-30% bone fragments, ~5% cranium, ~5% loose teeth, 5-15% feathers + bird bones, 0-10% insect chitin."}},{"k":"berkutchi","v":{"s":"Berkutchi"}},{"k":"which_species_do_mongolian_berkutchi_t","v":{"s":"Which species do Mongolian Berkutchi traditionally train, + what prey can it take?"}},{"k":"golden_eagle_aquila_chrysaetos_trained","v":{"s":"Golden eagle (Aquila chrysaetos). Trained to take wolves, foxes, hares from horseback. Tradition dating to ~2000 BCE."}},{"k":"pale_male","v":{"s":"Pale Male"}},{"k":"how_long_did_pale_male_manhattan_s_mos","v":{"s":"How long did Pale Male, Manhattan's most famous red-tailed hawk, nest at 927 Fifth Avenue?"}},{"k":"32_years_1991_2023_raised_26_offspring","v":{"s":"32 years (1991-2023). Raised 26+ offspring. The 2004 coop-board nest-removal sparked a 12-day public outcry covered by the NYT."}},{"k":"wing_loading_prediction","v":{"s":"Wing-loading prediction"}},{"k":"a_bird_with_high_wing_loading_high_asp","v":{"s":"A bird with HIGH wing loading + HIGH aspect ratio will hunt how?"}},{"k":"falcon_style_stoop_specialist_fast_lev","v":{"s":"Falcon-style stoop specialist. Fast level + lethal dive, large turning radius, bad at slow flight. (Peregrine: 8.8 kg/m² / AR 10.2)"}},{"k":"challenge_of_the_day","v":{"s":"🎲 Challenge of the Day"}},{"k":"show_answer","v":{"s":"Show answer"}},{"k":"show_answer_2","v":{"s":"👁 Show Answer"}},{"k":"jump_to_relevant_section","v":{"s":"Jump to relevant section"}},{"k":"study_the_topic","v":{"s":"↗ Study the topic"}},{"k":"answer","v":{"s":"✓ Answer"}},{"k":"jump_to_relevant_section_2","v":{"s":"Jump to relevant section"}},{"k":"read_more_in_the_relevant_section","v":{"s":"↗ Read more in the relevant section"}},{"k":"new_challenge_tomorrow","v":{"s":"New challenge tomorrow."}},{"k":"recently_viewed_this_session","v":{"s":"🕒 Recently viewed (this session)"}},{"k":"interactive_labs","v":{"s":"🎮 Interactive Labs"}},{"k":"deep_science","v":{"s":"🔬 Deep Science"}},{"k":"ecology_conservation","v":{"s":"🌍 Ecology + Conservation"}},{"k":"reference_history","v":{"s":"📚 Reference + History"}},{"k":"your_tour_progress","v":{"s":"🗺 Your Tour Progress"}},{"k":"reset_visit_history","v":{"s":"Reset visit history"}},{"k":"reset_progress","v":{"s":"Reset progress"}},{"k":"what_students_learn","v":{"s":"📖 What students learn"}},{"k":"force_mass_acceleration_kinetic_energy","v":{"s":"Force = mass × acceleration: kinetic energy of a 200 mph dive ≈ pistol bullet"}},{"k":"pressure_force_area_why_talon_length_g","v":{"s":"Pressure = force / area: why talon length × grip muscle = lethal precision"}},{"k":"fluid_dynamics_drag_coefficient_wing_l","v":{"s":"Fluid dynamics: drag coefficient + wing loading + terminal velocity"}},{"k":"frequency_domain_acoustics_how_owl_fea","v":{"s":"Frequency-domain acoustics: how owl feathers shift noise above prey hearing"}},{"k":"predator_ecology_the_ddt_story_how_sci","v":{"s":"Predator ecology + the DDT story: how science + policy reversed a near-extinction"}},{"k":"field_id_using_gestalt_wing_shape_flig","v":{"s":"Field ID using gestalt — wing shape + flight pattern over species checklist"}},{"k":"tap_a_species_card_or_row_to_make_it_t","v":{"s":"Tap a species card or row to make it the active raptor for the Hunt Sim + science modules."}},{"k":"mass_kg","v":{"s":"Mass (kg)"}},{"k":"wingspan_m","v":{"s":"Wingspan (m)"}},{"k":"wing_loading_kg_m","v":{"s":"Wing loading (kg/m²)"}},{"k":"aspect_ratio","v":{"s":"Aspect ratio"}},{"k":"max_level_speed_mph","v":{"s":"Max level speed (mph)"}},{"k":"stoop_speed_mph","v":{"s":"Stoop speed (mph)"}},{"k":"talon_grip_psi","v":{"s":"Talon grip (psi)"}},{"k":"talon_length_mm","v":{"s":"Talon length (mm)"}},{"k":"visual_acuity_human","v":{"s":"Visual acuity (× human)"}},{"k":"visual_field","v":{"s":"Visual field (°)"}},{"k":"pull_up_g_tolerance","v":{"s":"Pull-up G tolerance"}},{"k":"pick_two_species","v":{"s":"🆚 Pick Two Species"}},{"k":"species_a","v":{"s":"Species A"}},{"k":"species_b","v":{"s":"Species B"}},{"k":"head_to_head_stats","v":{"s":"📊 Head-to-head Stats"}},{"k":"stat_sheet_winner","v":{"s":"🏆 Stat-Sheet Winner"}},{"k":"note_winning_on_stats_winning_in_natur","v":{"s":"Note: \"winning\" on stats ≠ winning in nature. Each species evolved for its specific niche. A peregrine in a forest loses to a goshawk; a harpy in open desert loses to a golden eagle."}},{"k":"select_a_for_hunt_sim","v":{"s":"Select A for Hunt Sim"}},{"k":"select_b_for_hunt_sim","v":{"s":"Select B for Hunt Sim"}},{"k":"click_any_column_header_to_sort_by_tha","v":{"s":"Click any column header to sort by that field. Click any row to make that species active."}},{"k":"raptor_species_comparison_table","v":{"s":"Raptor species comparison table"}},{"k":"try_sorting_by_talon_psi_to_see_who_ha","v":{"s":"Try sorting by Talon (psi) to see who has the strongest grip (golden eagle), or by Wing loading to see who's built for speed (peregrine vs harpy)."}},{"k":"mass","v":{"s":"Mass"}},{"k":"talon","v":{"s":"Talon"}},{"k":"stoop","v":{"s":"Stoop"}},{"k":"hunt_style","v":{"s":"🦅 Hunt Style"}},{"k":"ecology","v":{"s":"🌍 Ecology"}},{"k":"weird_fact","v":{"s":"⚡ Weird fact"}},{"k":"deep_dive_breeding_hunt_strategy_histo","v":{"s":"📚 Deep dive: breeding · hunt strategy · history · ID · photography · taxonomy"}},{"k":"breeding","v":{"s":"🐣 Breeding"}},{"k":"hunt_strategy_in_depth","v":{"s":"🎯 Hunt strategy in depth"}},{"k":"population_history","v":{"s":"📊 Population history"}},{"k":"field_id_tips","v":{"s":"🔍 Field-ID tips"}},{"k":"when_where_to_see","v":{"s":"🗓 When + where to see"}},{"k":"photography_tips","v":{"s":"📷 Photography tips"}},{"k":"taxonomy_notes","v":{"s":"🧬 Taxonomy notes"}},{"k":"cultural_notes","v":{"s":"🌍 Cultural notes"}},{"k":"turkey_vulture","v":{"s":"Turkey Vulture"}},{"k":"black_vulture","v":{"s":"Black Vulture"}},{"k":"california_condor","v":{"s":"California Condor"}},{"k":"new_world_vultures_honorary_raptors","v":{"s":"🦅 New World Vultures — Honorary Raptors?"}},{"k":"cathartiformes","v":{"s":"Cathartiformes"}},{"k":"new_world_vultures_turkey_black_condor","v":{"s":"New World vultures (turkey, black, condor) hunt + soar like raptors but they're not in the raptor families Accipitriformes (hawks, eagles, kites) or Falconiformes (falcons). DNA evidence in the early 2000s placed them in their own order — "}},{"k":"cathartiformes_2","v":{"s":"Cathartiformes"}},{"k":"closer_to_storks_than_to_true_raptors_","v":{"s":" — closer to storks than to true raptors. The hooked beak + talons + soaring lifestyle are convergent evolution: they evolved the raptor body plan independently from carrion-eating ancestors."}},{"k":"the_is_it_a_raptor_debate","v":{"s":"🔬 The \"is it a raptor?\" debate: "}},{"k":"modern_usage_most_ornithologists_hawk_","v":{"s":"Modern usage: most ornithologists + Hawk Mountain count vultures as \"raptors\" in counts because they fly the same migration corridors + face the same human threats (lead poisoning, wind farms). Strict taxonomy: they're NOT raptors. This kind of \"lumper vs splitter\" disagreement is common in biology + a great teaching moment about how scientific categories work."}},{"k":"key_trait","v":{"s":"Key trait:"}},{"k":"old_world_vultures_egypt_india_africa_","v":{"s":"Old World vultures (Egypt, India, Africa) ARE in Accipitriformes — they evolved the carrion lifestyle from within the hawk/eagle family. New World vultures evolved it independently. Convergent evolution at the order level."}},{"k":"the_eagle_scream_you_hear_in_movies_is","v":{"s":"The \"eagle scream\" you hear in movies is almost always a red-tail dubbed over a bald eagle clip — Hollywood corrects the bird's actual unimpressive voice."}},{"k":"the_iconic_raptor_call_in_american_med","v":{"s":"THE iconic raptor call in American media. Dubbed in over bald eagles, golden eagles, ospreys — even owls in Hollywood films."}},{"k":"vocalizations_iconic_calls_mnemonics","v":{"s":"🎵 Vocalizations — Iconic Calls + Mnemonics"}},{"k":"most_raptor_ids_in_the_field_are_by_si","v":{"s":"Most raptor IDs in the field are by silhouette, but several species have iconic calls. The mnemonic phrases below are what serious birders memorize."}},{"k":"hear_them_yourself","v":{"s":"🦻 Hear them yourself: "}},{"k":"cornell_lab_s","v":{"s":"Cornell Lab's "}},{"k":"macaulay_library","v":{"s":"Macaulay Library"}},{"k":"has_free_audio_for_every_species_searc","v":{"s":" has free audio for every species. Search by species name. Free to use for educational + non-commercial purposes."}},{"k":"free_hunt_no_mission","v":{"s":"Free Hunt (no mission)"}},{"k":"no_constraints_hunt_for_the_joy_of_fly","v":{"s":"No constraints. Hunt for the joy of flying."}},{"k":"feed_the_chicks","v":{"s":"Feed the Chicks"}},{"k":"your_nest_holds_2_hungry_chicks_they_n","v":{"s":"Your nest holds 2 hungry chicks. They need 200 kcal each by sunset."}},{"k":"cross_the_desert","v":{"s":"Cross the Desert"}},{"k":"a_6_minute_migration_crossing_sparse_p","v":{"s":"A 6-minute migration crossing. Sparse prey, headwinds, no time to dawdle."}},{"k":"silent_strike_owl_mission","v":{"s":"Silent Strike (owl mission)"}},{"k":"night_hunt_prey_can_t_see_you_but_if_y","v":{"s":"Night hunt. Prey can't see you — but if you flap too loudly within 30m, they flee."}},{"k":"ride_the_thermal","v":{"s":"Ride the Thermal"}},{"k":"a_column_of_rising_warm_air_sits_under","v":{"s":"A column of rising warm air sits under you. Use it to gain altitude without flapping."}},{"k":"evade_the_goshawk","v":{"s":"Evade the Goshawk"}},{"k":"a_larger_raptor_is_hunting_you_survive","v":{"s":"A larger raptor is hunting YOU. Survive 4 minutes + catch your own prey while keeping distance."}},{"k":"high_stoop","v":{"s":"High Stoop"}},{"k":"drop_from_1000m_altitude_hit_a_moving_","v":{"s":"Drop from 1000m altitude. Hit a moving pigeon at terminal velocity. One strike to win."}},{"k":"mission_select","v":{"s":"🎯 Mission Select"}},{"k":"choose_a_scenario_open_mode_no_constra","v":{"s":"Choose a scenario. Open mode = no constraints. Missions teach specific concepts via gameplay."}},{"k":"objective","v":{"s":"📋 OBJECTIVE"}},{"k":"pedagogy","v":{"s":"🧠 PEDAGOGY"}},{"k":"first_time_quick_tutorial","v":{"s":"First time? Quick tutorial"}},{"k":"you_play_a","v":{"s":"You play a "}},{"k":"in_third_person_view_goal_dive_on_prey","v":{"s":" in third-person view. Goal: dive on prey + strike. Each species has different physics — peregrines stoop at terminal velocity, owls glide silently with smaller detection radius."}},{"k":"steer_yaw_pitch","v":{"s":"Steer (yaw + pitch)"}},{"k":"altitude_down_up","v":{"s":"Altitude down/up"}},{"k":"dive_accelerate","v":{"s":"DIVE (accelerate)"}},{"k":"pull_up_climb","v":{"s":"PULL UP (climb)"}},{"k":"strike_prey_in_front","v":{"s":"STRIKE prey in front"}},{"k":"tip_click_the_canvas_first_to_give_it_","v":{"s":"🦅 Tip: Click the canvas first to give it keyboard focus. Then start with a slow level glide before trying to dive. Prey flees on sight — sneak up from behind or above."}},{"k":"dismiss_tutorial","v":{"s":"Dismiss tutorial"}},{"k":"got_it","v":{"s":"✕ Got it"}},{"k":"wasd_to_fly_q_e_for_altitude_shift_to_","v":{"s":"WASD to fly · Q/E for altitude · Shift to DIVE · Space to PULL UP · F to STRIKE"}},{"k":"best_run","v":{"s":"Best run: "}},{"k":"loading_3d_engine_three_js_r128","v":{"s":"Loading 3D engine (Three.js r128)..."}},{"k":"load_three_js_engine","v":{"s":"Load Three.js engine"}},{"k":"load_3d_engine","v":{"s":"🚀 Load 3D Engine"}},{"k":"failed_to_load_three_js_from_cdn_check","v":{"s":"⚠ Failed to load Three.js from CDN. Check your internet connection or try again."}},{"k":"webgl_not_available","v":{"s":"WebGL Not Available"}},{"k":"raptor_hunt_requires_webgl_for_3d_rend","v":{"s":"Raptor Hunt requires WebGL for 3D rendering. This environment may not support it. Try opening AlloFlow directly in Chrome, Firefox, or Edge instead of within an embedded frame."}},{"k":"retry_3d_mode","v":{"s":"Retry 3D Mode"}},{"k":"3d_raptor_hunt_simulator_press_wasd_to","v":{"s":"3D raptor hunt simulator. Press WASD to steer, Q E to change altitude, Shift to dive, Space to pull up, F to strike."}},{"k":"q_down_e_up","v":{"s":"Q (down) / E (up)"}},{"k":"shift","v":{"s":"Shift"}},{"k":"pull_up","v":{"s":"Pull up: "}},{"k":"space","v":{"s":"Space"}},{"k":"first_catch","v":{"s":"First Catch"}},{"k":"catch_your_first_prey","v":{"s":"Catch your first prey"}},{"k":"ten_catches","v":{"s":"Ten Catches"}},{"k":"catch_10_prey_total","v":{"s":"Catch 10 prey total"}},{"k":"apex_predator","v":{"s":"Apex Predator"}},{"k":"catch_50_prey_total","v":{"s":"Catch 50 prey total"}},{"k":"hunter_s_century","v":{"s":"Hunter's Century"}},{"k":"catch_100_prey_total","v":{"s":"Catch 100 prey total"}},{"k":"hot_streak","v":{"s":"Hot Streak"}},{"k":"best_run_of_5_catches","v":{"s":"Best run of 5+ catches"}},{"k":"untouchable","v":{"s":"Untouchable"}},{"k":"best_run_of_10_catches","v":{"s":"Best run of 10+ catches"}},{"k":"sharp_eye","v":{"s":"Sharp Eye"}},{"k":"50_hit_rate_min_10_attempts","v":{"s":"50%+ hit rate (min 10 attempts)"}},{"k":"master_hunter","v":{"s":"Master Hunter"}},{"k":"70_hit_rate_min_20_attempts","v":{"s":"70%+ hit rate (min 20 attempts)"}},{"k":"generalist","v":{"s":"Generalist"}},{"k":"catch_with_3_different_species","v":{"s":"Catch with 3 different species"}},{"k":"versatile_falconer","v":{"s":"Versatile Falconer"}},{"k":"catch_with_5_different_species","v":{"s":"Catch with 5 different species"}},{"k":"master_of_all","v":{"s":"Master of All"}},{"k":"catch_with_all_8_species","v":{"s":"Catch with all 8 species"}},{"k":"achievements","v":{"s":"🏅 Achievements"}},{"k":"total_catches","v":{"s":"Total catches"}},{"k":"hit_rate","v":{"s":"Hit rate"}},{"k":"best_run_2","v":{"s":"Best run"}},{"k":"species_used","v":{"s":"Species used"}},{"k":"per_species_breakdown","v":{"s":"📊 Per-species breakdown"}},{"k":"grip_force_comparison_psi","v":{"s":"🔬 Grip Force Comparison (PSI)"}},{"k":"pigeon","v":{"s":"Pigeon"}},{"k":"songbird_sparrow","v":{"s":"Songbird (sparrow)"}},{"k":"duck_mallard","v":{"s":"Duck (mallard)"}},{"k":"fish_trout","v":{"s":"Fish (trout)"}},{"k":"field_mouse_rodent","v":{"s":"Field Mouse / Rodent"}},{"k":"cottontail_rabbit","v":{"s":"Cottontail Rabbit"}},{"k":"snake","v":{"s":"Snake"}},{"k":"skunk","v":{"s":"Skunk"}},{"k":"three_toed_sloth","v":{"s":"Three-toed Sloth"}},{"k":"howler_monkey","v":{"s":"Howler Monkey"}},{"k":"white_tailed_fawn","v":{"s":"White-tailed Fawn"}},{"k":"red_fox","v":{"s":"Red Fox"}},{"k":"ruffed_grouse","v":{"s":"Ruffed Grouse"}},{"k":"talon_vs_prey_can_the_grip_actually_ki","v":{"s":"🎯 Talon vs Prey: Can the Grip Actually Kill?"}},{"k":"grip_force_psi_alone_doesn_t_determine","v":{"s":"Grip force PSI alone doesn't determine lethality — it has to be matched against the specific prey's skull/spine crush threshold AND the talon has to be long enough to reach vital organs. Try different predator-prey pairings to see which combinations actually work."}},{"k":"predator","v":{"s":"🦅 Predator"}},{"k":"choose_predator","v":{"s":"Choose predator"}},{"k":"prey","v":{"s":"🐭 Prey"}},{"k":"choose_prey","v":{"s":"Choose prey"}},{"k":"grip_force","v":{"s":"Grip Force"}},{"k":"prey_crush_threshold","v":{"s":"Prey Crush Threshold"}},{"k":"talon_length","v":{"s":"Talon Length"}},{"k":"prey_vital_depth","v":{"s":"Prey Vital Depth"}},{"k":"note_real_predator_prey_relationships_","v":{"s":"Note: real predator-prey relationships are also shaped by encounter rate, prey availability, learned hunting skill, energetic balance, + group dynamics. This calculator captures one factor (mechanical kill feasibility) — not the full ecology."}},{"k":"visual_acuity_vs_human_baseline","v":{"s":"👁️ Visual Acuity vs Human Baseline"}},{"k":"kestrels_see_vole_urine_trails_in_uv_l","v":{"s":"Kestrels + UV vole trails — a famous, now-debated study"}},{"k":"american_kestrels_falco_sparverius_can","v":{"s":"A famous Nature study (Viitala, Korpimäki, Palokangas, Koivula 1995, Nature 373:425-427) reported that American kestrels (Falco sparverius) see ultraviolet light and that vole urine + dung trails reflect UV strongly — glowing rodent highways painted across the grass, with the kestrel perching near the brightest trail to ambush. Later measurements (Lind et al. 2013) found vole urine reflects little UV and kestrel eyes are only weakly UV-sensitive, so the trail-tracking story is now debated. Either way, kestrels hunt successfully from telephone wires year-round."}},{"k":"visual_field_top_down_view","v":{"s":"🎯 Visual Field — Top-Down View"}},{"k":"each_diagram_shows_the_bird_human_look","v":{"s":"Each diagram shows the bird/human looking up at the page (head viewed from above). Yellow = binocular zone (depth perception). Orange = monocular zones (peripheral, no depth). Gray = blind spot behind head."}},{"k":"human","v":{"s":"Human"}},{"k":"hawk_eagle","v":{"s":"Hawk / Eagle"}},{"k":"forward","v":{"s":"↑ forward"}},{"k":"hawk_eyes_are_set_on_the_sides_total_f","v":{"s":"Hawk eyes are set on the sides — total field 220°, but binocular zone is just 35° (narrow forward overlap). Owls have eyes on the front of the face — total field only 110° but binocular zone 70° (twice that of hawks). Humans are intermediate. Tradeoff: wide field of view (hawk) vs deep binocular depth perception (owl)."}},{"k":"wing_loading_aspect_ratio_species_map","v":{"s":"✈ Wing Loading × Aspect Ratio (species map)"}},{"k":"x_wing_loading_kg_m_high_fast_heavy_y_","v":{"s":"X: wing loading (kg/m², high = fast/heavy). Y: aspect ratio (high = soaring efficient, low = forest agile)."}},{"k":"wing_loading_kg_m_2","v":{"s":"wing loading (kg/m²) →"}},{"k":"aspect_ratio_2","v":{"s":"aspect ratio →"}},{"k":"glide_ratio_calculator","v":{"s":"🪁 Glide Ratio Calculator"}},{"k":"glide_ratio_l_d_is_the_distance_a_bird","v":{"s":"Glide ratio (L/D) is the distance a bird can cover per unit altitude lost in still air. High aspect ratio = high L/D = efficient soaring. Thermal lift extends range further (or makes flight \"free\" if lift > sink rate)."}},{"k":"species","v":{"s":"🦅 Species"}},{"k":"species_2","v":{"s":"Species"}},{"k":"start_altitude","v":{"s":"Start altitude"}},{"k":"start_altitude_2","v":{"s":"Start altitude"}},{"k":"500_m_typical_3000_m_alpine_soar","v":{"s":"500 m typical · 3000 m alpine soar"}},{"k":"thermal_lift_m_s","v":{"s":"Thermal lift (m/s)"}},{"k":"thermal_lift","v":{"s":"Thermal lift"}},{"k":"0_still_air_1_0_weak_2_5_strong","v":{"s":"0 = still air · 1.0 weak · 2.5 strong"}},{"k":"l_d_ratio","v":{"s":"L/D Ratio"}},{"k":"still_air_distance","v":{"s":"Still-air distance"}},{"k":"with_thermal","v":{"s":"With thermal"}},{"k":"net_sink","v":{"s":"Net sink"}},{"k":"after_thermal","v":{"s":"after thermal"}},{"k":"glide_ratio_visualization","v":{"s":"Glide ratio visualization"}},{"k":"horizontal_distance","v":{"s":"→ horizontal distance →"}},{"k":"bald_eagles_ar_6_5_glide_10_1_1_km_hor","v":{"s":"Bald eagles (AR 6.5) glide ~10:1 — 1 km horizontal per 100 m altitude lost. Albatross-class (AR 15) hit ~22:1. Falcons (lower AR ~10) sit around 16:1 but rarely use it — they're built for stoop, not soaring."}},{"k":"terminal_velocity_formula","v":{"s":"Terminal velocity formula"}},{"k":"interactive_stoop_calculator","v":{"s":"🧮 Interactive Stoop Calculator"}},{"k":"mass_kg_2","v":{"s":"Mass (kg)"}},{"k":"mass_in_kilograms","v":{"s":"Mass in kilograms"}},{"k":"peregrine_0_95_kg_golden_4_2_kg_harpy_","v":{"s":"Peregrine ≈ 0.95 kg · golden ≈ 4.2 kg · harpy ≈ 7.5 kg"}},{"k":"drag_coefficient_cd","v":{"s":"Drag coefficient (Cd)"}},{"k":"drag_coefficient","v":{"s":"Drag coefficient"}},{"k":"teardrop_0_04_sphere_0_47_falcon_stoop","v":{"s":"Teardrop ≈ 0.04 · sphere ≈ 0.47 · falcon stoop tuck ≈ 0.18 · human freefall ≈ 0.7"}},{"k":"frontal_area_m","v":{"s":"Frontal area (m²)"}},{"k":"frontal_cross_section_area_in_square_m","v":{"s":"Frontal cross-section area in square meters"}},{"k":"peregrine_tucked_0_018_m_golden_eagle_","v":{"s":"Peregrine tucked ≈ 0.018 m² · golden eagle tucked ≈ 0.05 m²"}},{"k":"load_active_species_presets","v":{"s":"Load active species presets"}},{"k":"terminal_velocity","v":{"s":"Terminal Velocity"}},{"k":"time_to_terminal","v":{"s":"Time to ~Terminal"}},{"k":"seconds_v_t_g","v":{"s":"seconds (v_t / g)"}},{"k":"kinetic_energy","v":{"s":"Kinetic Energy"}},{"k":"joules_at_impact","v":{"s":"joules at impact"}},{"k":"for_reference","v":{"s":"💡 For reference"}},{"k":"a_22_caliber_bullet_at_the_muzzle_150_","v":{"s":"A .22 caliber bullet at the muzzle: ~150 J of KE"}},{"k":"a_baseball_pitched_at_95_mph_120_j","v":{"s":"A baseball pitched at 95 mph: ~120 J"}},{"k":"a_peregrine_at_terminal_velocity_5_000","v":{"s":"A peregrine at terminal velocity: ~5,000 J — "}},{"k":"pistol_bullet_class","v":{"s":"pistol-bullet class"}},{"k":"a_harpy_eagle_in_dive_10_000_j","v":{"s":"A harpy eagle in dive: ~10,000+ J"}},{"k":"fall_curve_time_domain_physics","v":{"s":"📉 Fall Curve (time-domain physics)"}},{"k":"numerical_integration_of_the_drag_equa","v":{"s":"Numerical integration of the drag equation with your current slider values. Altitude (orange) plummets while velocity (red) builds toward terminal — and then plateaus when drag = weight."}},{"k":"stoop_start_altitude_m","v":{"s":"Stoop start altitude (m)"}},{"k":"altitude_m","v":{"s":"Altitude m"}},{"k":"fall_curve_plot","v":{"s":"Fall curve plot"}},{"k":"altitude_m_2","v":{"s":"Altitude (m)"}},{"k":"velocity_mph","v":{"s":"Velocity (mph)"}},{"k":"time_to_90_terminal","v":{"s":"Time to 90% terminal"}},{"k":"altitude_lost_90","v":{"s":"Altitude lost @ 90%"}},{"k":"peak_velocity","v":{"s":"Peak velocity"}},{"k":"the_exponential_approach_to_terminal_v","v":{"s":"The exponential approach to terminal velocity is the signature of drag-limited fall. Without drag, the bird would just accelerate at g forever. With drag, terminal is reached + held."}},{"k":"anatomy_of_an_owl_primary_feather_3_me","v":{"s":"🪶 Anatomy of an Owl Primary Feather (3-mechanism silencer)"}},{"k":"1_comb_edged_leading_primaries","v":{"s":"1. Comb-edged leading primaries"}},{"k":"tiny_serrated_teeth_0_5_1_mm_on_the_fr","v":{"s":"Tiny serrated teeth (0.5-1 mm) on the front edge of each primary feather break the laminar-to-turbulent flow transition. Result: high-frequency noise scattering above prey hearing range."}},{"k":"2_fringed_trailing_edge","v":{"s":"2. Fringed trailing edge"}},{"k":"soft_2_3_mm_fringe_on_the_back_edge_ab","v":{"s":"Soft 2-3 mm fringe on the back edge absorbs the trailing-edge turbulent vortex sound. This is the largest contributor — most aerodynamic noise comes from the trailing edge."}},{"k":"3_velvety_dorsal_surface","v":{"s":"3. Velvety dorsal surface"}},{"k":"tiny_velvet_like_pile_0_5_mm_on_the_up","v":{"s":"Tiny velvet-like pile (~0.5 mm) on the upper feather surface dampens feather-on-feather friction noise during wing folding/unfolding."}},{"k":"frequency_shift_the_actual_mechanism","v":{"s":"🔊 Frequency shift — the actual mechanism"}},{"k":"owl_wing_noise_peaks_at_16_khz_hawk_wi","v":{"s":"Owl wing noise peaks at ~16 kHz. Hawk wing noise peaks at ~2-4 kHz. The owl achieves silence not by reducing total noise — that's a small effect — but by shifting the dominant frequency range out of where prey ears are most sensitive. A mouse hears 2-4 kHz acutely (rustling, footsteps) but is much less sensitive at 16 kHz."}},{"k":"wing_noise_spectrum_hawk_vs_owl_vs_mou","v":{"s":"📈 Wing Noise Spectrum — Hawk vs Owl vs Mouse Hearing"}},{"k":"x_axis_frequency_khz_y_axis_relative_i","v":{"s":"X-axis: frequency (kHz). Y-axis: relative intensity / sensitivity. Hawk wing noise (red) peaks right in the mouse's most-sensitive range. Owl wing noise (violet) is shifted up out of that range. The frequency shift IS the silence mechanism."}},{"k":"frequency_spectrum_chart","v":{"s":"Frequency spectrum chart"}},{"k":"hawk_wing_peak","v":{"s":"Hawk wing peak"}},{"k":"owl_wing_peak","v":{"s":"Owl wing peak"}},{"k":"intensity_sensitivity","v":{"s":"Intensity / Sensitivity"}},{"k":"hawk_wing_noise","v":{"s":"Hawk wing noise"}},{"k":"owl_wing_noise","v":{"s":"Owl wing noise"}},{"k":"mouse_hearing","v":{"s":"Mouse hearing"}},{"k":"the_owl_s_noise_peak_at_16_khz_sits_pa","v":{"s":"The owl's noise peak at 16 kHz sits past the mouse's sharp drop-off in hearing sensitivity. The hawk's noise peak at 3 kHz sits exactly where the mouse hears best. This is what \"silent flight\" really means in physics: not zero amplitude — frequency shifted out of the prey's perceptual band."}},{"k":"eye_anatomy_cross_section_spherical_vs","v":{"s":"🔬 Eye Anatomy Cross-Section — Spherical vs Tubular"}},{"k":"both_eyes_shown_in_horizontal_cross_se","v":{"s":"Both eyes shown in horizontal cross-section, looking down through the top of the skull. Note the dramatic shape difference + the cone-vs-rod density distribution on the retina."}},{"k":"diurnal_spherical_eye","v":{"s":"☀️ Diurnal — Spherical Eye"}},{"k":"spherical_raptor_eye_cross_section","v":{"s":"Spherical raptor eye cross-section"}},{"k":"fovea_1","v":{"s":"Fovea 1"}},{"k":"fovea_2","v":{"s":"Fovea 2"}},{"k":"optic_n","v":{"s":"Optic n."}},{"k":"pecten_oculi","v":{"s":"Pecten oculi"}},{"k":"cornea","v":{"s":"Cornea"}},{"k":"pupil","v":{"s":"Pupil"}},{"k":"lens","v":{"s":"Lens"}},{"k":"80_cones_20_rods","v":{"s":"~80% cones / 20% rods"}},{"k":"spherical_shape_2_foveas_cone_dominate","v":{"s":"Spherical shape, 2 foveas, cone-dominated retina"}},{"k":"nocturnal_tubular_eye_owl","v":{"s":"🌙 Nocturnal — Tubular Eye (owl)"}},{"k":"tubular_owl_eye_cross_section","v":{"s":"Tubular owl eye cross-section"}},{"k":"fovea","v":{"s":"Fovea"}},{"k":"optic_n_2","v":{"s":"Optic n."}},{"k":"cornea_2","v":{"s":"Cornea"}},{"k":"pupil_2","v":{"s":"Pupil"}},{"k":"large_lens","v":{"s":"Large lens"}},{"k":"5_cones_95_rods","v":{"s":"~5% cones / 95% rods"}},{"k":"cannot_rotate_head_turns_instead","v":{"s":"Cannot rotate — head turns instead"}},{"k":"tubular_shape_1_fovea_rod_dominated_re","v":{"s":"Tubular shape, 1 fovea, rod-dominated retina, larger cornea + lens"}},{"k":"engineering_implication","v":{"s":"Engineering implication: "}},{"k":"diurnal_raptors_have_spherical_eyes_th","v":{"s":"Diurnal raptors have spherical eyes that capture maximum cone density across the entire retina (= peripheral acuity + 2 foveas). Owls trade peripheral acuity for raw light-gathering — the tubular shape lets them pack a huge cornea + lens + rod-rich retina in a fixed skull volume. The cost: they can't rotate the eye (head must turn). The benefit: ~100× more sensitive at low light than humans."}},{"k":"diurnal_eye_eagles_hawks_falcons","v":{"s":"Diurnal Eye (eagles, hawks, falcons)"}},{"k":"80_cones_20_rods_2","v":{"s":"~80% cones, 20% rods"}},{"k":"two_foveas_per_eye","v":{"s":"Two foveas per eye "}},{"k":"central_temporal","v":{"s":"— central + temporal"}},{"k":"4_8_human","v":{"s":" 4-8× human"}},{"k":"spherical_eye_shape","v":{"s":"Spherical eye shape"}},{"k":"uv_in_falconids","v":{"s":"UV in falconids "}},{"k":"vole_urine_trails","v":{"s":"— vole urine trails"}},{"k":"visual_field_2","v":{"s":"Visual field:"}},{"k":"full_tetrachromatic","v":{"s":" full tetrachromatic"}},{"k":"poor_worse_than_humans_at_twilight","v":{"s":" poor (worse than humans at twilight)"}},{"k":"nocturnal_eye_owls","v":{"s":"Nocturnal Eye (owls)"}},{"k":"5_cones_95_rods_2","v":{"s":"~5% cones, 95% rods"}},{"k":"one_fovea_per_eye","v":{"s":"One fovea per eye "}},{"k":"central","v":{"s":"— central"}},{"k":"2_human_moderate","v":{"s":" ~2× human (moderate)"}},{"k":"tubular_eye_shape","v":{"s":"Tubular eye shape "}},{"k":"cannot_rotate","v":{"s":"(cannot rotate)"}},{"k":"no_uv","v":{"s":"No UV; "}},{"k":"visual_field_3","v":{"s":"Visual field:"}},{"k":"110_much_narrower","v":{"s":" 110° (much narrower)"}},{"k":"100_more_sensitive_than_humans","v":{"s":" ~100× more sensitive than humans"}},{"k":"eye_5_body_mass","v":{"s":"Eye = ~5% body mass"}},{"k":"owl_ear_asymmetry_3d_sound_localizatio","v":{"s":"Owl ear asymmetry: 3D sound localization"}},{"k":"owls_have","v":{"s":"Owls have "}},{"k":"asymmetrically_placed_ear_openings","v":{"s":"asymmetrically placed ear openings"}},{"k":"the_left_opening_sits_higher_on_the_sk","v":{"s":" — the left opening sits higher on the skull than the right by ~1 cm in barn owls. Sound arriving from above hits the left ear first by ~30 microseconds; sound from below hits the right ear first. The brain reads the time difference as "}},{"k":"combined_with_the_standard_horizontal_","v":{"s":". Combined with the standard horizontal timing difference (which encodes azimuth), the owl gets full 3D acoustic localization. Roger Payne (1962) showed barn owls strike mice in total darkness using only sound, with median accuracy of ~1°."}},{"k":"american_kestrel","v":{"s":"American Kestrel"}},{"k":"peregrine_falcon","v":{"s":"Peregrine Falcon"}},{"k":"gyrfalcon","v":{"s":"Gyrfalcon"}},{"k":"cooper_s_hawk","v":{"s":"Cooper's Hawk"}},{"k":"northern_goshawk","v":{"s":"Northern Goshawk"}},{"k":"red_tailed_hawk","v":{"s":"Red-tailed Hawk"}},{"k":"bald_eagle","v":{"s":"Bald Eagle"}},{"k":"golden_eagle","v":{"s":"Golden Eagle"}},{"k":"harpy_eagle","v":{"s":"Harpy Eagle"}},{"k":"osprey","v":{"s":"Osprey"}},{"k":"snowy_owl","v":{"s":"Snowy Owl"}},{"k":"great_horned_owl","v":{"s":"Great Horned Owl"}},{"k":"mississippi_kite","v":{"s":"Mississippi Kite"}},{"k":"sexual_dimorphism_the_reverse_ssd_myst","v":{"s":"⚥ Sexual Dimorphism: The Reverse SSD Mystery"}},{"k":"raptors_are_the","v":{"s":"Raptors are the "}},{"k":"only_major_bird_group","v":{"s":"only major bird group"}},{"k":"in_which_females_are_consistently_larg","v":{"s":" in which females are consistently LARGER than males. In peacocks, deer, lions, gorillas — the male is the bigger sex. In raptors it's reversed. The phenomenon is called "}},{"k":"reverse_sexual_size_dimorphism_rsd","v":{"s":"reverse sexual size dimorphism (RSD)"}},{"k":"and_despite_a_century_of_study_biologi","v":{"s":", and despite a century of study, biologists still don't fully agree why it exists."}},{"k":"female_male_body_mass_ratio_sorted_by_","v":{"s":"📊 Female:Male body-mass ratio (sorted by magnitude)"}},{"k":"bar_length_degree_females_exceed_males","v":{"s":"Bar length = degree females exceed males in mass. Goshawks + harpies are the extremes (50% larger). Mississippi kites + falcons in general show less dimorphism."}},{"k":"1_small_male_hypothesis","v":{"s":"1. Small-male hypothesis"}},{"k":"smaller_males_may_be_more_agile_better","v":{"s":"Smaller males may be more agile + better at hunting fast-moving small prey to feed the nesting female. In accipiters + kestrels, males hunt smaller faster prey than females. Selected for male agility, not female size."}},{"k":"2_big_female_hypothesis","v":{"s":"2. Big-female hypothesis"}},{"k":"larger_females_are_more_dominant_over_","v":{"s":"Larger females are more dominant over males in food disputes + better defenders of the nest against predators + intruders. Mother-defense + clutch protection drove female size up."}},{"k":"3_niche_divergence_hypothesis","v":{"s":"3. Niche-divergence hypothesis"}},{"k":"male_female_evolve_to_hunt_different_p","v":{"s":"Male + female evolve to hunt different prey size classes, reducing competition between mates. Each gender exploits a different ecological niche during breeding when both must hunt simultaneously. The synthesis of #1 + #2."}},{"k":"current_scientific_consensus","v":{"s":"🔬 Current scientific consensus: "}},{"k":"most_biologists_now_favor_the","v":{"s":"Most biologists now favor the "}},{"k":"niche_divergence_hypothesis_3","v":{"s":"niche-divergence hypothesis (#3)"}},{"k":"observations_confirm_that_mated_pairs_","v":{"s":" — observations confirm that mated pairs hunt different prey size classes, and this niche partitioning allows the pair to harvest more total biomass than either could alone. The dimorphism is most extreme in accipiters (forest specialists) + falcons that specialize in agile prey — exactly where prey-size divergence matters most."}},{"k":"conservation_from_ddt_to_today","v":{"s":"🌍 Conservation: From DDT to today"}},{"k":"population_status_all_13_species_sorta","v":{"s":"📊 Population Status — All 13 Species (sortable)"}},{"k":"iucn_codes_lc_least_concern_nt_near_th","v":{"s":"IUCN codes: LC = Least Concern · NT = Near Threatened · VU = Vulnerable · EN = Endangered · CR = Critically Endangered. Click column headers to sort."}},{"k":"conservation_status_table","v":{"s":"Conservation status table"}},{"k":"trend_insight_kestrels_declining_50_si","v":{"s":"Trend insight: kestrels declining 50% since 1970 (cause unknown — pesticide-driven insect crash + mesopredator release suspected). Cooper's hawks + Mississippi kites are SUCCESS stories of urban adaptation. Snowy owls + harpy eagles are the conservation worries — climate change + habitat loss."}},{"k":"recovery_success_stories","v":{"s":"✅ Recovery Success Stories"}},{"k":"threat_impact_calculator_compound_popu","v":{"s":"🎛 Threat Impact Calculator — Compound Population Effect"}},{"k":"real_raptor_populations_face_multiple_","v":{"s":"Real raptor populations face multiple threats simultaneously. Each one is small but they compound. Try adjusting the threat sliders for a species — watch the 30-year population trajectory tip from growing to declining."}},{"k":"species_3","v":{"s":"🦅 Species"}},{"k":"species_4","v":{"s":"Species"}},{"k":"lead_shot_poisoning_intensity","v":{"s":"🎯 Lead-shot poisoning intensity"}},{"k":"wind_turbine_collision_rate","v":{"s":"💨 Wind turbine collision rate"}},{"k":"rodenticide_secondary_poisoning","v":{"s":"🐀 Rodenticide secondary poisoning"}},{"k":"habitat_loss","v":{"s":"🌳 Habitat loss"}},{"k":"effective","v":{"s":"Effective λ"}},{"k":"trajectory","v":{"s":"Trajectory"}},{"k":"pop_year_30","v":{"s":"Pop @ year 30"}},{"k":"30_year_population_sparkline","v":{"s":"30-year population sparkline"}},{"k":"year_0_30","v":{"s":"Year 0 → 30"}},{"k":"pedagogy_even_small_per_threat_effects","v":{"s":"Pedagogy: even small per-threat effects compound multiplicatively across 30 years. A 5% adult-survival drop from lead PLUS 3% from wind PLUS 2% from rodenticide turns a +6%/year growth into a near-zero trajectory. This is the demographic reality of multi-stressor environments."}},{"k":"active_threats_crises","v":{"s":"⚠ Active Threats + Crises"}},{"k":"what_can_you_do_student_action_tier","v":{"s":"🎯 What can YOU do? — Student Action Tier"}},{"k":"reading_about_conservation_is_half_the","v":{"s":"Reading about conservation is half the work. Doing matters. Below are real actions organized by effort level — start with 5-minute commitments, work up to multi-day projects. Every line item is a thing students have actually done that meaningfully helps raptors."}},{"k":"pick_one_this_week","v":{"s":"✦ Pick ONE this week. "}},{"k":"conservation_is_built_from_millions_of","v":{"s":"Conservation is built from millions of small actions. The 90-year Hawk Mountain dataset exists because someone showed up to count birds, every fall, for 90 years."}},{"k":"field_identification_wing_shape_flight","v":{"s":"🔍 Field Identification: Wing Shape + Flight Pattern"}},{"k":"you_almost_never_get_a_clear_close_up_","v":{"s":"You almost never get a clear close-up of a raptor in the wild. Field ID works on "}},{"k":"gestalt_silhouette_flight_pattern_beha","v":{"s":"gestalt — silhouette + flight pattern + behavior"}},{"k":"color_comes_last_learn_the_8_silhouett","v":{"s":". Color comes last. Learn the 8 silhouette groups below and you can ID 90% of North American raptors at a quarter mile."}},{"k":"silhouette_as_seen_from_below_in_fligh","v":{"s":"↑ silhouette as seen from below in flight"}},{"k":"wing_shape","v":{"s":"Wing shape: "}},{"k":"flight_pattern","v":{"s":"Flight pattern: "}},{"k":"behavior_clues_that_narrow_id_instantl","v":{"s":"🦅 Behavior Clues That Narrow ID Instantly"}},{"k":"migration_5_million_birds_5_major_flyw","v":{"s":"🧭 Migration: 5 Million Birds, 5 Major Flyways"}},{"k":"world_map_5_flyways_famous_watch_sites","v":{"s":"🗺 World Map — 5 Flyways + Famous Watch Sites"}},{"k":"hover_a_flyway_color_or_a_star_to_lear","v":{"s":"Hover a flyway color or a star to learn more. Arrows show fall migration direction (NE → SW for most North American species)."}},{"k":"world_map_showing_the_5_major_raptor_m","v":{"s":"World map showing the 5 major raptor migration flyways and famous hawk-watch site locations"}},{"k":"equator","v":{"s":"Equator"}},{"k":"hawk_mtn","v":{"s":"Hawk Mtn"}},{"k":"cape_may","v":{"s":"Cape May"}},{"k":"veracruz","v":{"s":"Veracruz"}},{"k":"eilat","v":{"s":"Eilat"}},{"k":"batumi","v":{"s":"Batumi"}},{"k":"map_equirectangular_projection_contine","v":{"s":"Map: equirectangular projection, continents simplified for clarity. Flyway paths shown as fall-migration direction. Stars mark major hawk-watch sites with documented annual counts."}},{"k":"the_5_major_flyways","v":{"s":"🌎 The 5 Major Flyways"}},{"k":"famous_hawk_watch_sites","v":{"s":"🗺 Famous Hawk-Watch Sites"}},{"k":"hawk_mountain_sanctuary","v":{"s":"Hawk Mountain Sanctuary"}},{"k":"cape_may_hawkwatch","v":{"s":"Cape May Hawkwatch"}},{"k":"quaker_ridge_hawkwatch","v":{"s":"Quaker Ridge Hawkwatch"}},{"k":"lighthouse_point_park","v":{"s":"Lighthouse Point Park"}},{"k":"conowingo_dam","v":{"s":"Conowingo Dam"}},{"k":"curry_hammock_state_park","v":{"s":"Curry Hammock State Park"}},{"k":"florida_keys_hawkwatch","v":{"s":"Florida Keys Hawkwatch"}},{"k":"hawk_ridge_bird_observatory","v":{"s":"Hawk Ridge Bird Observatory"}},{"k":"whitefish_point_bird_observatory","v":{"s":"Whitefish Point Bird Observatory"}},{"k":"illinois_beach_state_park","v":{"s":"Illinois Beach State Park"}},{"k":"smith_point_hawk_watch","v":{"s":"Smith Point Hawk Watch"}},{"k":"big_bend_national_park","v":{"s":"Big Bend National Park"}},{"k":"bonney_butte_hawkwatch","v":{"s":"Bonney Butte Hawkwatch"}},{"k":"goshute_mountains_hawkwatch","v":{"s":"Goshute Mountains Hawkwatch"}},{"k":"golden_gate_raptor_observatory","v":{"s":"Golden Gate Raptor Observatory"}},{"k":"cape_mendocino","v":{"s":"Cape Mendocino"}},{"k":"big_sur_ornithology_lab","v":{"s":"Big Sur Ornithology Lab"}},{"k":"veracruz_river_of_raptors","v":{"s":"Veracruz River of Raptors"}},{"k":"talamanca_mountains","v":{"s":"Talamanca Mountains"}},{"k":"international_birding_centre_eilat","v":{"s":"International Birding Centre Eilat"}},{"k":"batumi_raptor_count","v":{"s":"Batumi Raptor Count"}},{"k":"strait_of_gibraltar","v":{"s":"Strait of Gibraltar"}},{"k":"bosphorus_strait","v":{"s":"Bosphorus Strait"}},{"k":"bab_el_mandeb_strait","v":{"s":"Bab-el-Mandeb Strait"}},{"k":"khare_pass","v":{"s":"Khare Pass"}},{"k":"cape_sata","v":{"s":"Cape Sata"}},{"k":"hawk_mountain_australia","v":{"s":"Hawk Mountain Australia"}},{"k":"global_hawkwatch_atlas_28_sites_worldw","v":{"s":"🗺 Global Hawkwatch Atlas — 28 sites worldwide"}},{"k":"five_observed_patterns","v":{"s":"📌 Five observed patterns"}},{"k":"mechanisms_why_climate_is_reshaping_ra","v":{"s":"⚙ Mechanisms — why climate is reshaping raptor migration"}},{"k":"phenological_mismatch","v":{"s":"Phenological mismatch"}},{"k":"songbirds_insects_shift_breeding_earli","v":{"s":"Songbirds + insects shift breeding earlier with warming. If raptors don't shift at the same rate, peak prey availability happens BEFORE chicks need food. Documented in European honey buzzards (Both et al. 2009) — chicks fledge after the wasp peak passes."}},{"k":"stopover_habitat_loss","v":{"s":"Stopover habitat loss"}},{"k":"migrating_raptors_refuel_at_consistent","v":{"s":"Migrating raptors refuel at consistent stopover sites. Drought, fire, + agricultural intensification are degrading these. Veracruz wetlands face increasing water-stress; Eilat's desert oasis is shrinking."}},{"k":"headwind_frequency_shifts","v":{"s":"Headwind frequency shifts"}},{"k":"jet_stream_changes_from_arctic_warming","v":{"s":"Jet-stream changes from Arctic warming alter the wind patterns raptors depend on for soaring. Stronger headwinds = more flap-flight = higher energy cost = lower survival on migration."}},{"k":"thermal_availability","v":{"s":"Thermal availability"}},{"k":"some_regions_get_more_thermals_good_fo","v":{"s":"Some regions get MORE thermals (good for raptors), others get fewer or weaker. Mediterranean raptors crossing Sahara face stronger but shorter-duration thermal columns."}},{"k":"prey_base_disruption","v":{"s":"Prey base disruption"}},{"k":"snowy_owls_depend_on_lemming_vole_cycl","v":{"s":"Snowy owls depend on lemming + vole cycles, which are flattening in some Arctic regions due to changing snowpack. Boom years become more variable + unpredictable."}},{"k":"short_stoppers_non_migrants","v":{"s":"Short-stoppers + non-migrants"}},{"k":"several_species_turkey_vultures_red_ta","v":{"s":"Several species (turkey vultures, red-tails, bald eagles) are wintering MUCH further north than 50 years ago — a permanent range shift, not irruption. Some are skipping migration entirely."}},{"k":"regional_impacts","v":{"s":"🌍 Regional impacts"}},{"k":"projections_2050_baseline","v":{"s":"🔮 Projections (2050 baseline)"}},{"k":"birdlife_international_projects_15_30_","v":{"s":"BirdLife International projects ~15-30% of long-distance migrant raptors will face significant range shifts."}},{"k":"snowy_owl_populations_may_decline_30_5","v":{"s":"Snowy owl populations may decline 30-50% from current ~28,000 birds, primarily from Arctic prey-base disruption."}},{"k":"turkey_vulture_black_vulture_wintering","v":{"s":"Turkey vulture + black vulture wintering ranges expected to extend ~500 km further north."}},{"k":"mediterranean_species_honey_buzzard_le","v":{"s":"Mediterranean species (honey buzzard, lesser kestrel) may lose 20-40% of current European breeding range."}},{"k":"the_long_hawk_mountain_dataset_1934_no","v":{"s":"The long Hawk Mountain dataset (1934-now) will continue being the canonical evidence base for documenting these shifts."}},{"k":"sources_both_et_al_2009_j_anim_ecol_bi","v":{"s":"Sources: Both et al. 2009 J Anim Ecol; Bildstein 2017 Raptors; BirdLife International State of World's Birds 2022; Therrien et al. 2014 snowy owl winter ecology."}},{"k":"migration_calendar_when_each_species_i","v":{"s":"📅 Migration Calendar — When Each Species is Flying"}},{"k":"bars_show_migration_windows_solid_peak","v":{"s":"Bars show migration windows. Solid = peak passage. Light = shoulder weeks. Use this to plan a hawkwatch trip — broadwings = mid-Sept; peregrines = Oct; rough-legs = Nov. Green column = current month."}},{"k":"migration_calendar","v":{"s":"Migration calendar"}},{"k":"fall_peak","v":{"s":"fall peak"}},{"k":"fall_shoulder","v":{"s":"fall shoulder"}},{"k":"no_major_migrations_this_month_most_sp","v":{"s":"🟢 No major migrations this month — most species are on territory."}},{"k":"field_id_quiz_2","v":{"s":"Field ID Quiz"}},{"k":"active_retrieval_practice_across_silho","v":{"s":"Active retrieval practice across silhouettes, behavior, talon mechanics, vision, flight physics, and conservation. Each question has a detailed explanation — wrong answers are the best teachers."}},{"k":"18_questions_3_difficulty_bands_explan","v":{"s":"18 questions · 3 difficulty bands · explanations included"}},{"k":"choose_difficulty","v":{"s":"Choose difficulty"}},{"k":"easy","v":{"s":"Easy"}},{"k":"silhouettes_obvious_questions","v":{"s":"Silhouettes + obvious questions"}},{"k":"medium","v":{"s":"Medium"}},{"k":"deeper_combos","v":{"s":"Deeper combos"}},{"k":"hard","v":{"s":"Hard"}},{"k":"deep_science_nuance","v":{"s":"Deep science + nuance"}},{"k":"all_18","v":{"s":"All 18"}},{"k":"full_quiz","v":{"s":"Full quiz"}},{"k":"best_score","v":{"s":"🏆 Best score: "}},{"k":"your_accuracy_by_difficulty_cumulative","v":{"s":"📊 Your accuracy by difficulty (cumulative across all runs)"}},{"k":"question_s_flagged_as_missed_from_your","v":{"s":" question(s) flagged as missed from your last run."}},{"k":"review_missed_questions_only","v":{"s":"Review missed questions only"}},{"k":"review_only_missed","v":{"s":"🔁 Review only missed"}},{"k":"back_to_quiz_menu","v":{"s":"Back to quiz menu"}},{"k":"quiz_menu","v":{"s":"↶ Quiz Menu"}},{"k":"try_again","v":{"s":"Try again"}},{"k":"try_again_2","v":{"s":"🔁 Try Again"}},{"k":"score","v":{"s":"🏆 Score: "}},{"k":"submit_answer","v":{"s":"Submit answer"}},{"k":"submit_answer_2","v":{"s":"✔ Submit Answer"}},{"k":"owl_hearing_lab_find_the_mouse","v":{"s":"🦻 Owl Hearing Lab: Find the Mouse"}},{"k":"in_1962_roger_payne_placed_a_barn_owl_","v":{"s":"In 1962, Roger Payne placed a barn owl in a totally dark room with a mouse on a leaf-litter floor. The owl could hear the leaves rustle but see nothing. He recorded ~17 silent strikes — every one a kill, accurate to ~1° elevation + azimuth. This works because barn owls have "}},{"k":"asymmetric_ear_openings","v":{"s":"asymmetric ear openings"}},{"k":"left_higher_right_lower_plus_a_flat_fa","v":{"s":" (left higher, right lower) plus a flat facial disc that acts like a parabolic dish. Below, you are the owl. The mouse is hidden — your ears can detect it within a noisy radius that scales with your ear-asymmetry magnitude."}},{"k":"ear_asymmetry_magnitude","v":{"s":"Ear asymmetry magnitude"}},{"k":"ear_asymmetry_magnitude_2","v":{"s":"Ear asymmetry magnitude"}},{"k":"0_symmetric_like_a_hawk","v":{"s":"0% (symmetric — like a hawk)"}},{"k":"100_barn_owl_grade","v":{"s":"100% (barn-owl-grade)"}},{"k":"background_noise_wind_traffic_rustling","v":{"s":"🌬 Background noise (wind, traffic, rustling)"}},{"k":"background_noise_level","v":{"s":"Background noise level"}},{"k":"0_silent_forest","v":{"s":"0% (silent forest)"}},{"k":"50_windy_night","v":{"s":"50% (windy night)"}},{"k":"100_highway_noise","v":{"s":"100% (highway noise)"}},{"k":"effective_detection_radius","v":{"s":"Effective detection radius: "}},{"k":"of_canvas_base","v":{"s":" of canvas (base "}},{"k":"from_asymmetry","v":{"s":" from asymmetry + "}},{"k":"noise_widening_real_barn_owls_operate_","v":{"s":" noise widening). Real barn owls operate at ~1° error in pitch black silence; even moderate wind degrades that. Hawkesford 2019 measured ~3× detection-radius widening at 60 dB ambient."}},{"k":"owl_hearing_lab_click_anywhere_on_the_","v":{"s":"Owl hearing lab. Click anywhere on the dark canvas where you think the mouse is, or move the crosshair with the arrow keys and strike with Enter. Detection radius shows as a ring."}},{"k":"release_new_mouse","v":{"s":"Release new mouse"}},{"k":"release_mouse","v":{"s":"🦉 Release Mouse"}},{"k":"reset_stats","v":{"s":"Reset stats"}},{"k":"reset_stats_2","v":{"s":"↺ Reset Stats"}},{"k":"strike_rate","v":{"s":"Strike Rate"}},{"k":"attempts","v":{"s":"Attempts"}},{"k":"best_error","v":{"s":"Best Error"}},{"k":"what_you_just_modeled","v":{"s":"💡 What you just modeled"}},{"k":"slide_the_asymmetry_slider_to_100_your","v":{"s":"Slide the asymmetry slider to 100% — your detection radius is tiny + barely larger than a single pixel. Real barn owls can localize sound to ~1° error in pitch dark. Slide to 0% (a hawk's ear placement) — the radius balloons to 40% of the canvas. This is why hawks hunt by sight + owls hunt by sound."}},{"k":"the_mechanism_is_exactly_the_diagram_i","v":{"s":"The mechanism is exactly the diagram in the Day Eye vs Night Eye section: "}},{"k":"time_of_arrival_difference","v":{"s":"time-of-arrival difference"}},{"k":"between_the_two_ear_openings_encodes","v":{"s":" between the two ear openings encodes "}},{"k":"azimuth_elevation_in_3d","v":{"s":"azimuth + elevation in 3D"}},{"k":"the_asymmetric_placement_encodes_eleva","v":{"s":". The asymmetric placement encodes elevation; without asymmetry, an owl could not tell if a sound came from above or below the head — only left or right."}},{"k":"pellet_lab_the_owl_s_trash_the_scienti","v":{"s":"🥚 Pellet Lab: The Owl's Trash, the Scientist's Treasure"}},{"k":"what_s_inside_a_typical_pellet","v":{"s":"🔬 What's Inside a Typical Pellet"}},{"k":"common_prey_id_key_from_skull_teeth","v":{"s":"🦷 Common Prey ID Key — From Skull + Teeth"}},{"k":"meadow_vole","v":{"s":"Meadow Vole"}},{"k":"deer_mouse","v":{"s":"Deer Mouse"}},{"k":"short_tailed_shrew","v":{"s":"Short-tailed Shrew"}},{"k":"house_sparrow","v":{"s":"House Sparrow"}},{"k":"european_starling","v":{"s":"European Starling"}},{"k":"bog_lemming","v":{"s":"Bog Lemming"}},{"k":"little_brown_bat","v":{"s":"Little Brown Bat"}},{"k":"virtual_dissection_try_it","v":{"s":"🔬 Virtual Dissection — Try It"}},{"k":"generate_a_virtual_pellet_then_click_e","v":{"s":"Generate a virtual pellet, then click each bone to identify the prey species. Each pellet contains 1-4 prey animals from your local rodent + bird population. Use the signature clues to pick the right species."}},{"k":"generate_virtual_pellet","v":{"s":"Generate virtual pellet"}},{"k":"generate_virtual_pellet_2","v":{"s":"🦉 Generate Virtual Pellet"}},{"k":"pellet_click_bones_below_to_identify","v":{"s":"— pellet — click bones below to identify —"}},{"k":"identify_this_bone","v":{"s":"🦴 Identify this bone"}},{"k":"dissection_complete","v":{"s":"✓ Dissection complete"}},{"k":"pellet_analysis_results","v":{"s":"📊 Pellet Analysis Results"}},{"k":"prey_items","v":{"s":"Prey items"}},{"k":"species_5","v":{"s":"Species"}},{"k":"biomass","v":{"s":"Biomass"}},{"k":"real_world_equivalent_a_single_owl_roo","v":{"s":"Real-world equivalent: a single owl roost with 50 pellets like this would document "}},{"k":"across_the_local_landscape","v":{"s":" across the local landscape — "}},{"k":"without_trapping_a_single_mouse_this_i","v":{"s":" — without trapping a single mouse. This is why pellet science is a backbone of small-mammal ecology research."}},{"k":"generate_another_pellet","v":{"s":"Generate another pellet"}},{"k":"new_pellet","v":{"s":"🔁 New Pellet"}},{"k":"close_dissection","v":{"s":"Close dissection"}},{"k":"close","v":{"s":"✕ Close"}},{"k":"safety","v":{"s":"⚠ Safety: "}},{"k":"why_pellet_labs_work_in_classrooms","v":{"s":"📚 Why pellet labs work in classrooms"}},{"k":"free_interactive_dichotomous_keys","v":{"s":"🔗 Free interactive dichotomous keys"}},{"k":"kidwings_virtual_pellet_free_online_di","v":{"s":"KidWings Virtual Pellet (free online dissection)"}},{"k":"pellet_com_sterilized_supplies","v":{"s":"Pellet.com (sterilized supplies)"}},{"k":"carolina_biological","v":{"s":"Carolina Biological"}},{"k":"falconry_humans_4_000_years_of_hunting","v":{"s":"🤝 Falconry & Humans: 4,000 Years of Hunting Together"}},{"k":"bronze_age","v":{"s":"Bronze Age"}},{"k":"medieval_europe","v":{"s":"Medieval Europe"}},{"k":"decline_persecution","v":{"s":"Decline / Persecution"}},{"k":"conservation_3","v":{"s":"Conservation"}},{"k":"4_000_year_timeline_of_falconry","v":{"s":"🕰 4,000-Year Timeline of Falconry"}},{"k":"visual_sweep_from_bronze_age_mongolian","v":{"s":"Visual sweep from Bronze Age Mongolian steppe through medieval Europe to today's UNESCO-protected practice."}},{"k":"4_000_year_falconry_timeline","v":{"s":"4,000-year falconry timeline"}},{"k":"falconry_is_one_of_the_oldest_continuo","v":{"s":"Falconry is one of the oldest continuously-practiced human cultural traditions — UNESCO Intangible Cultural Heritage 2010 (now 24 nations)."}},{"k":"the_5_eras_in_detail","v":{"s":"📜 The 5 eras in detail"}},{"k":"equipment_glossary","v":{"s":"🛠 Equipment glossary"}},{"k":"if_you_find_an_injured_raptor","v":{"s":"If you find an injured raptor:"}},{"k":"notable_us_rehab_facilities","v":{"s":"Notable US rehab facilities:"}},{"k":"raptor_anatomy","v":{"s":"🦴 Raptor Anatomy"}},{"k":"identify_the_highlighted_anchor","v":{"s":"🎯 Identify the highlighted anchor →"}},{"k":"next_anatomy_question","v":{"s":"Next anatomy question"}},{"k":"next_anchor","v":{"s":"➡ Next Anchor"}},{"k":"labeled_raptor_anatomy_diagram_with_in","v":{"s":"Labeled raptor anatomy diagram with interactive hover labels"}},{"k":"hover_or_tap_any_label_above_to_see_th","v":{"s":"Hover or tap any label above to see the description here."}},{"k":"talons","v":{"s":"🪝 Talons"}},{"k":"length_grip_force_across_species","v":{"s":"Length + grip force across species"}},{"k":"wings","v":{"s":"🪶 Wings"}},{"k":"wingspan_loading_aspect_ratio","v":{"s":"Wingspan + loading + aspect ratio"}},{"k":"eyes","v":{"s":"👁 Eyes"}},{"k":"visual_acuity_field_of_view","v":{"s":"Visual acuity + field of view"}},{"k":"body_mass","v":{"s":"⚖ Body Mass"}},{"k":"body_size_weight_distribution","v":{"s":"Body size + weight distribution"}},{"k":"each_row_shows_a_species_hallux_rear_k","v":{"s":"Each row shows a species' hallux (rear killing talon) drawn to scale. The amber bar is grip force (psi)."}},{"k":"each_row_shows_wingspan_to_scale_gold_","v":{"s":"Each row shows wingspan to scale (gold bar) + wing loading (red dot — further right = faster) + aspect ratio (cyan dot — further right = more soaring-efficient)."}},{"k":"each_row_shows_eye_size_proportional_t","v":{"s":"Each row shows eye size proportional to acuity (gold circle) + visual field arc."}},{"k":"each_row_shows_body_size_to_scale_the_","v":{"s":"Each row shows body size to scale. The harpy eagle is 8× heavier than a peregrine."}},{"k":"cross_species_comparison","v":{"s":"🔬 Cross-Species Comparison"}},{"k":"compare_the_same_body_part_across_all_","v":{"s":"Compare the same body part across all 8 species. Reveals the dramatic scale differences hidden in single-species views."}},{"k":"all_anatomy_entries_read_through_view","v":{"s":"📖 All anatomy entries (read-through view)"}},{"k":"lifecycle_demographics","v":{"s":"🐣 Lifecycle & Demographics"}},{"k":"the_7_lifecycle_stages","v":{"s":"🌱 The 7 lifecycle stages"}},{"k":"lifespan_survival_across_species","v":{"s":"📊 Lifespan + survival across species"}},{"k":"species_6","v":{"s":"Species"}},{"k":"1st_yr_mort","v":{"s":"1st-yr mort"}},{"k":"adult_ann_surv","v":{"s":"Adult ann. surv"}},{"k":"mean_wild_lifespan","v":{"s":"Mean wild lifespan"}},{"k":"record_wild","v":{"s":"Record (wild)"}},{"k":"bald_eagle_2","v":{"s":"Bald Eagle"}},{"k":"peregrine","v":{"s":"Peregrine"}},{"k":"red_tailed_hawk_2","v":{"s":"Red-tailed Hawk"}},{"k":"american_kestrel_2","v":{"s":"American Kestrel"}},{"k":"survivorship_curves_raptors_are_type_i","v":{"s":"📉 Survivorship Curves — Raptors are Type I"}},{"k":"standard_ecology_visualization_of_birt","v":{"s":"Standard ecology visualization: % of birth cohort still alive at each age (log Y-scale). Type I (mammals, raptors) = high survival until late life. Type II (many songbirds) = constant mortality. Type III (fish, insects, plants) = heavy juvenile loss, few survive to adulthood."}},{"k":"survivorship_curves_comparison","v":{"s":"Survivorship curves comparison"}},{"k":"type_i_mammals_eagles","v":{"s":"Type I (mammals, eagles)"}},{"k":"type_ii_songbirds","v":{"s":"Type II (songbirds)"}},{"k":"type_iii_fish_insects","v":{"s":"Type III (fish, insects)"}},{"k":"surviving_vs_age_log_scale","v":{"s":"% surviving vs age (log scale)"}},{"k":"pedagogy_2","v":{"s":"💡 Pedagogy: "}},{"k":"raptors_fit_the_type_i_pattern_a_steep","v":{"s":"Raptors fit the Type I pattern — a steep cliff in year 1 (70% of juveniles die during their first winter), then a long plateau where most adults survive 5-10+ years. This is why protecting adult breeders is the highest-leverage conservation action. A red-tailed hawk that survives year 1 typically lives to age 6-10; a kestrel that survives year 1 lives to age 5-7. Eagle adults can live 25+ years."}},{"k":"interactive_population_simulator","v":{"s":"🧮 Interactive Population Simulator"}},{"k":"see_why_adult_survival_is_the_dominant","v":{"s":"See why adult survival is the dominant lever in raptor population trajectories."}},{"k":"adult_annual_survival","v":{"s":"Adult annual survival"}},{"k":"adult_annual_survival_rate","v":{"s":"Adult annual survival rate"}},{"k":"bald_golden_eagle_90_94_kestrel_60","v":{"s":"Bald/golden eagle ≈ 90-94% · kestrel ≈ 60%"}},{"k":"juvenile_1st_yr_survival","v":{"s":"Juvenile 1st-yr survival"}},{"k":"juvenile_first_year_survival","v":{"s":"Juvenile first-year survival"}},{"k":"typical_raptor_1st_yr_30_40","v":{"s":"Typical raptor 1st-yr ≈ 30-40%"}},{"k":"fecundity_fledged_chicks_per_female_pe","v":{"s":"Fecundity (fledged chicks per female per year)"}},{"k":"annual_fecundity","v":{"s":"Annual fecundity"}},{"k":"eagle_0_8_kestrel_2_5","v":{"s":"Eagle ≈ 0.8 · kestrel ≈ 2.5"}},{"k":"additional_adult_mortality_bump_lead_t","v":{"s":"Additional adult mortality bump (lead, turbines, etc)"}},{"k":"additional_adult_mortality","v":{"s":"Additional adult mortality"}},{"k":"add_anthropogenic_adult_mortality_lead","v":{"s":"Add anthropogenic adult mortality (lead, turbines, etc)"}},{"k":"population_trajectory_plot","v":{"s":"Population trajectory plot"}},{"k":"year_0","v":{"s":"Year 0"}},{"k":"lambda","v":{"s":"λ (lambda)"}},{"k":"trajectory_2","v":{"s":"Trajectory"}},{"k":"stoop_trajectory_visualizer","v":{"s":"🌀 Stoop Trajectory Visualizer"}},{"k":"tucker_1998_modeled_the_falcon_s_stoop","v":{"s":"Tucker (1998) modeled the falcon's stoop trajectory and showed that peregrines fly a "}},{"k":"logarithmic_spiral","v":{"s":"logarithmic spiral"}},{"k":"a_curved_approach_that_keeps_the_prey_","v":{"s":" — a curved approach that keeps the prey image at a "}},{"k":"constant_retinal_angle","v":{"s":"constant retinal angle"}},{"k":"the_bird_s_head_doesn_t_need_to_turn_a","v":{"s":" (the bird's head doesn't need to turn at terminal velocity, which would create drag). This is "}},{"k":"the_proportional_navigation_algorithm_","v":{"s":" the proportional-navigation algorithm used by air-to-air missiles. Adjust the parameters below + watch the falcon close on its prey."}},{"k":"stoop_start_altitude","v":{"s":"Stoop start altitude"}},{"k":"stoop_start_altitude_2","v":{"s":"Stoop start altitude"}},{"k":"real_peregrine_stoops_200_3_000_m","v":{"s":"Real peregrine stoops: 200-3,000 m"}},{"k":"prey_speed_m_s","v":{"s":"Prey speed (m/s)"}},{"k":"prey_forward_speed","v":{"s":"Prey forward speed"}},{"k":"pigeon_flapping_16_m_s_duck_22_m_s","v":{"s":"Pigeon flapping ≈ 16 m/s · duck ≈ 22 m/s"}},{"k":"head_tilt_angle","v":{"s":"Head tilt angle (°)"}},{"k":"head_tilt_angle_2","v":{"s":"Head tilt angle"}},{"k":"tucker_1998_measured_40","v":{"s":"Tucker 1998 measured ~40°"}},{"k":"replay_stoop","v":{"s":"Replay stoop"}},{"k":"replay","v":{"s":"▶ Replay"}},{"k":"animated_stoop_trajectory_showing_a_pe","v":{"s":"Animated stoop trajectory showing a peregrine falcon descending in a logarithmic spiral to intercept moving prey"}},{"k":"peregrine_falcon_2","v":{"s":"Peregrine Falcon"}},{"k":"golden_eagle_2","v":{"s":"Golden Eagle"}},{"k":"northern_goshawk_2","v":{"s":"Northern Goshawk"}},{"k":"multi_species_trajectory_comparison","v":{"s":"⚡ Multi-Species Trajectory Comparison"}},{"k":"compare_how_3_species_approach_the_sam","v":{"s":"Compare how 3 species approach the same prey target. Falcons + golden eagles use steep direct stoops; goshawks use a curved forest-chase trajectory."}},{"k":"multi_species_stoop_trajectory_compari","v":{"s":"Multi-species stoop trajectory comparison"}},{"k":"prey_2","v":{"s":"🐦 prey"}},{"k":"altitude_horizontal_distance_ground_im","v":{"s":"↑ altitude — →  horizontal distance — →  ground impact"}},{"k":"stoop_speed","v":{"s":"Stoop speed: "}},{"k":"tuck_cd","v":{"s":"Tuck Cd: "}},{"k":"trajectory_steepness_reflects_how_comm","v":{"s":"Trajectory steepness reflects how committed each species is to the vertical stoop. Peregrines + golden eagles dive nearly vertical from high altitude. Goshawks use a lower-altitude curve through forest canopy. The same logarithmic-spiral principle applies — each species adjusts the curve to keep the prey at a constant retinal angle."}},{"k":"why_a_spiral_not_a_straight_line","v":{"s":"🎯 Why a spiral, not a straight line?"}},{"k":"straight_line_problem","v":{"s":"Straight-line problem: "}},{"k":"if_the_falcon_flies_directly_at_the_pr","v":{"s":"If the falcon flies directly at the prey, the prey appears to move SIDEWAYS in its visual field as it travels — the bird would have to constantly rotate its head + body to track. At 200+ mph that head rotation creates drag, ruins the streamlining, AND requires the bird to angle its eye away from prey."}},{"k":"spiral_solution","v":{"s":"Spiral solution: "}},{"k":"the_logarithmic_spiral_approach_keeps_","v":{"s":"The logarithmic spiral approach keeps the prey at a CONSTANT angle to the falcon's body axis. The bird never needs to turn its head — eyes stay fixed forward through deep fovea, body stays streamlined, the prey appears motionless relative to the falcon. This is exactly the proportional-navigation algorithm used by AIM-9 Sidewinder + similar guided missiles, derived for the same reason: "}},{"k":"guidance_without_instability","v":{"s":"guidance without instability."}},{"k":"reference_tucker_v_a_1998_curved_fligh","v":{"s":"Reference: Tucker, V.A. (1998) Curved flight paths and sideways vision in peregrine falcons. Journal of Experimental Biology 201(3):403-414."}},{"k":"e_f_p","v":{"s":"E F P"}},{"k":"t_o_z","v":{"s":"T O Z"}},{"k":"l_p_e_d","v":{"s":"L P E D"}},{"k":"p_e_c_f_d","v":{"s":"P E C F D"}},{"k":"e_d_f_c_z_p","v":{"s":"E D F C Z P"}},{"k":"f_e_l_o_p_z_d","v":{"s":"F E L O P Z D"}},{"k":"d_e_f_p_o_t_e_c","v":{"s":"D E F P O T E C"}},{"k":"l_e_f_o_d_p_c_t","v":{"s":"L E F O D P C T"}},{"k":"human_2","v":{"s":"Human"}},{"k":"baseline_20_20_reads_the_bottom_line_a","v":{"s":"Baseline — 20/20 reads the bottom line at 20 ft."}},{"k":"domestic_cat","v":{"s":"Domestic Cat"}},{"k":"cats_are_40_of_human_acuity_they_re_gr","v":{"s":"Cats are ~40% of human acuity. They're great at low-light + movement, but poor at sharpness."}},{"k":"peregrine_falcon_3","v":{"s":"Peregrine Falcon"}},{"k":"peregrines_see_2_6_sharper_than_humans","v":{"s":"Peregrines see ~2.6× sharper than humans at fovea center."}},{"k":"red_tailed_hawk_3","v":{"s":"Red-tailed Hawk"}},{"k":"a_red_tail_can_read_the_bottom_line_at","v":{"s":"A red-tail can read the bottom line at 80 ft (vs human 20 ft)."}},{"k":"bald_eagle_3","v":{"s":"Bald Eagle"}},{"k":"a_bald_eagle_sees_fine_detail_at_5_hum","v":{"s":"A bald eagle sees fine detail at ~5× human acuity."}},{"k":"golden_eagle_3","v":{"s":"Golden Eagle"}},{"k":"spots_a_rabbit_at_2_miles_reads_the_bo","v":{"s":"Spots a rabbit at 2 miles. Reads the bottom Snellen line at 110 ft."}},{"k":"theoretical_max","v":{"s":"Theoretical max"}},{"k":"some_claims_of_8_acuity_in_select_rapt","v":{"s":"Some claims of 8× acuity in select raptor species. Likely overstated but plausible upper bound."}},{"k":"vision_acuity_demo_2","v":{"s":"👁️‍🗨️ Vision Acuity Demo"}},{"k":"acuity_multipliers_are_abstract_until_","v":{"s":"Acuity multipliers are abstract until you "}},{"k":"what_they_feel_like_the_snellen_style_","v":{"s":" what they feel like. The Snellen-style chart below starts at human-scale (1×). Slide the zoom or click a species to scale the text up to raptor vision. A peregrine reads the bottom line at 52 ft instead of 20. A golden eagle reads it at 110 ft. The numbers don't mean much until you watch the text grow. (One honest caveat: the big-eagle multipliers above ~3× come from photoreceptor-density estimates — direct behavioral tests on large eagles measure closer to 2-3× human.)"}},{"k":"zoom_acuity_multiplier","v":{"s":"Zoom (acuity multiplier)"}},{"k":"visual_acuity_zoom_multiplier","v":{"s":"Visual acuity zoom multiplier"}},{"k":"0_4_cat","v":{"s":"0.4× (cat)"}},{"k":"1_human","v":{"s":"1× (human)"}},{"k":"5_eagle","v":{"s":"5× (eagle)"}},{"k":"8_max","v":{"s":"8× (max)"}},{"k":"acuity_demonstration_chart","v":{"s":"— Acuity Demonstration Chart —"}},{"k":"larger_text_closer_equivalent_sharper_","v":{"s":"Larger text = closer-equivalent / sharper-equivalent vision. A bird that can see at this zoom level can read the same lines from much further away."}},{"k":"hidden_prey_meadow_can_you_spot_the_vo","v":{"s":"🌾 Hidden-Prey Meadow — Can you spot the vole?"}},{"k":"a_scaled_down_meadow_scene_200_ft_away","v":{"s":"A scaled-down meadow scene 200 ft away. A vole is hiding in the grass. At human acuity (1×) it's barely a speck. Crank the zoom up to red-tail or eagle vision and the vole becomes obvious."}},{"k":"meadow_scene_with_hidden_vole","v":{"s":"Meadow scene with hidden vole"}},{"k":"vole","v":{"s":"← vole!"}},{"k":"200_ft_from_observer","v":{"s":"200 ft from observer"}},{"k":"the_100_foot_newspaper_demonstration","v":{"s":"💡 The \"100-foot newspaper\" demonstration"}},{"k":"a_common_claim_a_red_tailed_hawk_can_r","v":{"s":"A common claim: \"a red-tailed hawk can read a newspaper headline at 100 feet.\" Where does that come from?"}},{"k":"a_20_20_human_reads_a_newspaper_headli","v":{"s":"A 20/20 human reads a newspaper headline at ~25 feet under normal lighting. A red-tail with ~4× acuity should be able to read the same headline at ~4 × 25 = "}},{"k":"100_feet","v":{"s":"100 feet"}},{"k":"a_golden_eagle_at_5_5_should_read_it_a","v":{"s":". A golden eagle at 5.5× should read it at ~140 feet. A peregrine at 2.6× should read it at ~65 feet."}},{"k":"these_are_simplifications_real_raptor_","v":{"s":"These are simplifications — real raptor vision also has 2 foveas per eye, wider visual field, UV in falconids, and head-mounting that lets the bird scan with much less head motion than a human. The acuity number is just ONE axis of \"better seeing.\""}},{"k":"try_toggling_between_human_peregrine_a","v":{"s":"Try toggling between human, peregrine, and golden eagle on the slider above. The eagle-scale chart isn't just bigger text — it's the experiential equivalent of being 5× closer than you actually are."}},{"k":"population_trajectory_plot_2","v":{"s":"Population trajectory plot"}},{"k":"population_log","v":{"s":"Population (log)"}},{"k":"recovery_case_studies_2","v":{"s":"🏆 Recovery Case Studies"}},{"k":"population_trajectory_log_scale","v":{"s":"📈 Population trajectory (log scale)"}},{"k":"key_people","v":{"s":"👤 Key People"}},{"k":"current_status","v":{"s":"📊 Current Status"}},{"k":"what_s_next","v":{"s":"🔮 What's next"}},{"k":"lesson","v":{"s":"✦ Lesson"}},{"k":"wing_loading_predictor_2","v":{"s":"🪂 Wing-Loading Predictor"}},{"k":"design","v":{"s":"🎚 Design"}},{"k":"frankenraptor","v":{"s":"🧬 Frankenraptor"}},{"k":"in_the_flight_physics_module_you_learn","v":{"s":"In the Flight Physics module you learned that wing loading + aspect ratio predict hunt style. This is the inverse: "}},{"k":"design_a_raptor_by_setting_its_body_di","v":{"s":"design a raptor by setting its body dimensions"}},{"k":"the_tool_tells_you_what_hunt_strategy_","v":{"s":" + the tool tells you what hunt strategy that bird would evolve. Compare to real species. The fingers-of-the-glove fit between body geometry + behavior is the core insight of raptor flight biology."}},{"k":"build_a_frankenraptor_mix_species_body","v":{"s":"🧬 Build a Frankenraptor — mix species body parts"}},{"k":"pick_wings_from_one_species_and_body_f","v":{"s":"Pick wings from one species and body from another. The tool computes what hunt style your hybrid would evolve toward."}},{"k":"wings_from","v":{"s":"🪶 Wings from"}},{"k":"wings_species","v":{"s":"Wings species"}},{"k":"body_mass_from","v":{"s":"🦴 Body / mass from"}},{"k":"body_species","v":{"s":"Body species"}},{"k":"synthetic_dimensions","v":{"s":"Synthetic dimensions: "}},{"k":"body_mass_2","v":{"s":"Body mass"}},{"k":"body_mass_kg","v":{"s":"Body mass kg"}},{"k":"kestrel_0_1_peregrine_0_9_golden_4_2_h","v":{"s":"Kestrel 0.1 · peregrine 0.9 · golden 4.2 · harpy 7.5"}},{"k":"wingspan","v":{"s":"Wingspan"}},{"k":"wingspan_m_2","v":{"s":"Wingspan m"}},{"k":"kestrel_0_6_peregrine_1_05_golden_2_1_","v":{"s":"Kestrel 0.6 · peregrine 1.05 · golden 2.1 · harpy 2.05"}},{"k":"wing_area","v":{"s":"Wing area"}},{"k":"wing_area_m","v":{"s":"Wing area m²"}},{"k":"kestrel_0_05_peregrine_0_11_golden_0_6","v":{"s":"Kestrel 0.05 · peregrine 0.11 · golden 0.65 · harpy 0.50"}},{"k":"wing_loading","v":{"s":"Wing Loading"}},{"k":"kg_m","v":{"s":"kg / m²"}},{"k":"aspect_ratio_3","v":{"s":"Aspect Ratio"}},{"k":"wingspan_area","v":{"s":"wingspan² / area"}},{"k":"predicted_hunt_style","v":{"s":"Predicted hunt style"}},{"k":"closest_real_species_in_loading_ar_spa","v":{"s":"🎯 Closest real species (in loading × AR space)"}},{"k":"best_match","v":{"s":"★ Best match"}},{"k":"try_a_preset","v":{"s":"⚡ Try a preset"}},{"k":"peregrine_2","v":{"s":"Peregrine"}},{"k":"red_tailed_hawk_4","v":{"s":"Red-tailed Hawk"}},{"k":"bald_eagle_4","v":{"s":"Bald Eagle"}},{"k":"goshawk","v":{"s":"Goshawk"}},{"k":"harpy_eagle_2","v":{"s":"Harpy Eagle"}},{"k":"famous_birds_cultural_symbols","v":{"s":"⭐ Famous Birds & Cultural Symbols"}},{"k":"5_000_year_timeline_cultural_symbols_f","v":{"s":"📜 5,000-Year Timeline — Cultural Symbols + Famous I