  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/1448.png",
      "text": "Tuuladayda waxaa jooga ari. Wayna ka fogtahay magaalooyinka waaweyn.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=1",
      "sourceDigest": "sha256:179b0e23e4523974758139975b7cfd0d6ce8408001f39683f346b260c8bc04b6"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/1449.png",
      "text": "Hooyo ayaa tiri, \"Elly, waxaan kuu haynaa hadiyad loogu talagalay sannad-guuradii lixaad ee maalinta dhalashadaada.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=2",
      "sourceDigest": "sha256:80d22a9006fae2af6a62220c196d090b3ace64d5d551c2a7d2a3ef72046d8d51"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/1450.png",
      "text": "Hooyo, habaryar iyo anigaba waxaan sugaynay baska.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=3",
      "sourceDigest": "sha256:c7e034dc8356a58af3ed5c2803607fc74c5ea5436cbd51cb4f9db3ee1a676289"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/1451.png",
      "text": "Waxaan ku fadhiistay hoyo dhabteeda. Waana hurday intaan sii soconay oo dhan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=4",
      "sourceDigest": "sha256:58a25d0864e495e65e95fd44c444849fcb148f623cdd994c913b2622505cd66e"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/1452.png",
      "text": "Waxaan gaarnay suuqii. Waxaan arkay diyaarad helicopter buluug ah oo qurux badan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=5",
      "sourceDigest": "sha256:891b1b1c4519f371e6cb584188911015f79f8273d61661c9e67accd81f168962"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/1453.png",
      "text": "Mid ka mid ah cooshadaha, waxay hayeen miro. Waxaan waydiiyay hooyo, \"Kuwani waa kuwee?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=6",
      "sourceDigest": "sha256:38b729ab32d6c40a37f2c91dbe028b0585795e809d1befd503d8da0408243a35"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/1454.png",
      "text": "\"Kuwani waa tufaax,\" ayay hooyo tiri. Waan baryay, \"Fadlan, hal xabo ii gad.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=7",
      "sourceDigest": "sha256:296ee4ddc4529cd0a2d8919659b7ca317c95400daa2e7e7b3761c450b6b37bd6"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/1455.png",
      "text": "Waan ilaaway gacanta hooyaday. Waxaan ka fikiraye tufaaxayga oo kaliya.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=8",
      "sourceDigest": "sha256:500b451568c1c543cc4e03422dbd4a1cd887b29c84d41f28fbd5b0ccdbae75fc"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/1456.png",
      "text": "Markan bogay cunitankii tufaaxa, kaligay ayaan ahaa. Waxaan bilaabay in aan ooyo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=9",
      "sourceDigest": "sha256:fb4757d0c0e7265b98f4ef3407cb8b7edcf5802008d5f5723e168b0c6d3d5673"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/1457.png",
      "text": "In yar ka dib, haweenay ayaa gacanta iga qabatay, waxayna igeysay meel ay carruur kale joogeen.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=10",
      "sourceDigest": "sha256:fb3bcf57506398c8890960459013bb746a8aeec66edbad70af3998d135c62e83"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/1458.png",
      "text": "Waxaan u maleeyay in ciyaalka suuqa lagu gado. Xoog ayaan u sii ooyay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=11",
      "sourceDigest": "sha256:49db8046a7962c9f44e379c5b79888e8f0d4d1f8e62e2a6d36c5d910023a7fae"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/1459.png",
      "text": "Nin ayaa waydiiya, \"Aaway Elly?\" waan iska qariyay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=12",
      "sourceDigest": "sha256:09ca2bb1e87bf3ecc17924c9e31fd408572a53eb1a4f039723f3656e69accbc9"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/1460.png",
      "text": "Codkii hooyaday ee aan aqaanay baan iigu yeeray, \"Elly!\" aad ayaan u farxay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=13",
      "sourceDigest": "sha256:3a27f0d18190c116869fcfa5bc41cb4c55d648b0421c867e67b8553f2e893853"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/1460.png",
      "text": "Habaryartay ayaa soo saartay helicopter quruxbadan. Waxayna tiri, \"Adigaa leh.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52321#page=14",
      "sourceDigest": "sha256:3dbe8997c2662cb58d9d66b209e9dd4bf72325705cc935a7a15d82d70cca8718"
    }
  ],
