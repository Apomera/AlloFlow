import {expect,test,type Page} from 'C:/Users/cabba/OneDrive/Desktop/UDL-Tool-Updated/node_modules/@playwright/test/index.js';
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {resolve} from 'node:path';
import {GlHarness} from 'C:/Users/cabba/OneDrive/Desktop/UDL-Tool-Updated/tests/e2e/helpers/stem_gl_harness';

const {cropPng}=require('./wrist-capture-png.cjs');
const work=process.env.FIRST_RESPONSE_WRISTS_WORK!,report=process.env.FIRST_RESPONSE_WRISTS_REPORT!;
const baselineOnly=process.env.FIRST_RESPONSE_WRISTS_BASELINE_ONLY==='1';
const finalSHA=process.env.FIRST_RESPONSE_WRISTS_SOURCE_SHA!,candidatePath=process.env.FIRST_RESPONSE_WRISTS_CANDIDATE!;
const baselineSHA='f6cfbcccc65323918d7ca7b209737dcd13cf57a31246da4110f2ab980907147f';
const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
const baseline=readFileSync(resolve(work,'before.js')),candidate=baselineOnly?baseline:readFileSync(candidatePath),evidence:any[]=[];
const variants=baselineOnly?['baseline'] as const:['baseline','candidate'] as const;
const allViews=[
  {id:'adult-heel-side',age:'adult',width:1280,height:1080,button:'Heel side view',contrast:false},
  {id:'child-heel-side-contrast',age:'child',width:320,height:840,button:'Heel side view',contrast:true},
] as const;
const requestedViews=(process.env.FIRST_RESPONSE_WRISTS_VIEWS||allViews.map(v=>v.id).join(',')).split(',');
if(new Set(requestedViews).size!==requestedViews.length||requestedViews.some(id=>!allViews.some(v=>v.id===id)))throw Error('Invalid wrist views');
const views=allViews.filter(v=>requestedViews.includes(v.id));
const harness=new GlHarness({toolFile:'stem_lab/stem_tool_firstresponse.js',toolId:'firstResponse',preScripts:['stem_lab/stem_lab_module.js'],width:1160,height:1080,layout:'document',appStyles:true,probes:`
  var WristMount=window.__mount;
  window.__mount=function(data){var contrast=!!data.__wristContrast,clean=Object.assign({},data);delete clean.__wristContrast;var result=WristMount(clean);window.__ctx.isContrast=contrast;return result;};
  window.__wristDraws=new WeakMap();var WristRenderer=THREE.WebGLRenderer;
  THREE.WebGLRenderer=new Proxy(WristRenderer,{construct:function(target,args,newTarget){
    var renderer=Reflect.construct(target,args,newTarget),render=renderer.render,dispose=renderer.dispose;
    var record={renderer:renderer,disposeCount:0,sequence:0};window.__wristDraws.set(renderer.domElement,record);
    renderer.dispose=function(){record.disposeCount++;return dispose.apply(this,arguments);};
    renderer.render=function(scene,camera){var result=render.apply(this,arguments);if(scene&&scene.isScene&&camera&&camera.isPerspectiveCamera&&scene.getObjectByName('fr-training-manikin')){record.scene=scene;record.camera=camera;record.sequence++;record.calls=renderer.info.render.calls;record.triangles=renderer.info.render.triangles;}return result;};return renderer;
  }});
  window.__wristProbe=function(){
    var canvas=document.querySelector('#wrap canvas'),drawn=canvas&&window.__wristDraws.get(canvas),rec=canvas&&window.__glRecorder.forCanvas(canvas);if(!drawn||!drawn.scene||!rec)return null;
    var probeStarted=performance.now(),T=THREE,scene=drawn.scene,camera=drawn.camera;scene.updateMatrixWorld(true);camera.updateMatrixWorld(true);
    function visible(o){for(var a=o;a;a=a.parent)if(!a.visible)return false;return true;}
    function digest(value){var bytes=typeof value==='string'?value:JSON.stringify(value),h=2166136261;for(var i=0;i<bytes.length;i++){h^=bytes.charCodeAt(i);h=Math.imul(h,16777619);}return {hash:(h>>>0).toString(16),bytes:bytes.length};}
    function bufferHash(a){var b=new Uint8Array(a.buffer,a.byteOffset,a.byteLength),h=2166136261;for(var i=0;i<b.length;i++)h=Math.imul(h^b[i],16777619);return {hash:(h>>>0).toString(16),bytes:b.length};}
    function material(m){if(Array.isArray(m))return m.map(material);return {type:m.type,color:m.color&&m.color.getHex(),emissive:m.emissive&&m.emissive.getHex(),side:m.side,transparent:m.transparent,opacity:m.opacity,depthWrite:m.depthWrite,depthTest:m.depthTest,roughness:m.roughness,metalness:m.metalness,shininess:m.shininess};}
    // Shape UUIDs identify constructed instances; all shape data stays in the comparison.
    function geometryParameters(value){return JSON.parse(JSON.stringify(value,function(key,item){return key==='uuid'&&this.type==='Shape'&&typeof item==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(item)?'[generated Shape UUID]':item;}));}
    function descriptor(o){var g=o.geometry,attributes={};Object.keys(g.attributes).sort().forEach(function(k){var a=g.attributes[k];attributes[k]={count:a.count,itemSize:a.itemSize,normalized:a.normalized,buffer:bufferHash(a.array)};});return {attributes:attributes,index:g.index?bufferHash(g.index.array):null,groups:g.groups,parameters:geometryParameters(g.parameters||null)};}
    function surfaces(group){var rows=[];function visit(o,key){if(o.isMesh&&o.geometry)rows.push({path:key,name:o.name,geometry:descriptor(o),material:material(o.material)});o.children.forEach(function(child,i){visit(child,key+'/'+i);});}visit(group,'part');return rows;}
    function projection(objects,predicate){var out={total:0,inFrame:0,badNormals:0,nonFinite:0,min:[Infinity,Infinity,Infinity],max:[-Infinity,-Infinity,-Infinity],worldMin:[Infinity,Infinity,Infinity],worldMax:[-Infinity,-Infinity,-Infinity]};
      objects.forEach(function(root){root.traverse(function(o){if(!visible(o)||!o.isMesh||!o.geometry||!o.geometry.attributes.position)return;var p=o.geometry.attributes.position,n=o.geometry.attributes.normal;for(var i=0;i<p.count;i++){if(predicate&&!predicate(o,p,i))continue;var w=new T.Vector3().fromBufferAttribute(p,i).applyMatrix4(o.matrixWorld),v=w.clone().project(camera),vv=v.toArray(),ww=w.toArray();out.total++;if(!vv.concat(ww).every(Number.isFinite))out.nonFinite++;if(n){var length=new T.Vector3().fromBufferAttribute(n,i).length();if(!isFinite(length)||length<.99||length>1.01)out.badNormals++;}for(var axis=0;axis<3;axis++){out.min[axis]=Math.min(out.min[axis],vv[axis]);out.max[axis]=Math.max(out.max[axis],vv[axis]);out.worldMin[axis]=Math.min(out.worldMin[axis],ww[axis]);out.worldMax[axis]=Math.max(out.worldMax[axis],ww[axis]);}if(Math.abs(v.x)<=1.001&&Math.abs(v.y)<=1.001&&v.z>=-1.001&&v.z<=1.001)out.inFrame++;}});});return out;
    }
    var joints=[],hands=[],handParts=[],heels=[],wristContext=[];
    ['lower','upper'].forEach(function(id){var hand=scene.getObjectByName('fr-rescuer-'+id);if(!hand)return;var forearm=hand.getObjectByName(hand.name+'-forearm'),index=hand.children.indexOf(forearm),joint=hand.children[index-1];
      if(!joint||joint.name!==''||!joint.isMesh||joint.parent!==hand)throw Error('Unexpected wrist identity '+id);
      var jointId={hand:hand.name,index:index-1,name:joint.name,position:joint.position.toArray(),scale:joint.scale.toArray(),quaternion:joint.quaternion.toArray()};
      joints.push({object:joint,id:jointId});
      if(!visible(hand))return;hands.push(id);
      hand.children.forEach(function(part){if(/^fr-rescuer-(lower|upper)-(palm|heel|wrist-bridge|finger-[0-3]|thumb|nail-[0-3]|thumb-nail)$/.test(part.name)){handParts.push(part);if(/-heel$/.test(part.name))heels.push(part);if(/-(heel|wrist-bridge)$/.test(part.name))wristContext.push(part);}});
      wristContext.push(joint);
    });
    var structure=[],transforms=[],materials=[],preservedGeometry=[],counts={objects:0,meshes:0};
    function visit(o,key){counts.objects++;if(o.isMesh)counts.meshes++;structure.push([key,o.name,o.type,o.visible]);transforms.push([key,o.matrix.elements]);if(o.material)materials.push([key,material(o.material)]);if(o.geometry&&!joints.some(function(j){return j.object===o;}))preservedGeometry.push([key,descriptor(o)]);o.children.forEach(function(child,index){visit(child,key+'/'+index);});}visit(scene,'scene');
    var contact=scene.getObjectByName('fr-hand-contact-focus'),bounds=scene.getObjectByName('fr-hand-contact-bounds'),marker=scene.getObjectByName('fr-depth-marker').getWorldPosition(new T.Vector3()).toArray(),heelProjection=projection(heels),b=canvas.getBoundingClientRect();
    return {camera:{position:camera.getWorldPosition(new T.Vector3()).toArray(),quaternion:camera.quaternion.toArray(),projection:camera.projectionMatrix.elements.slice(),aspect:camera.aspect},
      preserved:{structure:digest(structure),transforms:digest(transforms),materials:digest(materials),geometry:digest(preservedGeometry),counts:counts},
      joints:joints.map(function(j){return {id:j.id,geometry:descriptor(j.object),material:material(j.object.material),projection:projection([j.object]),visible:visible(j.object)};}),hands:hands,
      handParts:handParts.map(function(o){return {name:o.name,surfaces:surfaces(o),projection:projection([o])};}),handProjection:projection(handParts),heelProjection:heelProjection,wristProjection:projection(wristContext),
      marker:marker,lowerContactGap:projection([heels[0]]).worldMin[1]-marker[1],
      contact:{visible:contact.visible,inspection:contact.userData.inspection,bounds:{position:bounds.position.toArray(),scale:bounds.scale.toArray()}},
      probeElapsedMs:performance.now()-probeStarted,canvasRect:{x:b.x,y:b.y,width:b.width,height:b.height},contrast:window.__ctx.isContrast,state:window.__ctx.toolData.firstResponse,errors:window.__events.errors.slice(),
      draw:{id:rec.id,createdBy:rec.createdBy,draws:rec.draws,sequence:drawn.sequence,calls:drawn.calls,triangles:drawn.triangles,geometries:drawn.renderer.info.memory.geometries,programs:drawn.renderer.info.programs.length,disposeCount:drawn.disposeCount}};
  };
`});

test.describe.configure({retries:0,timeout:300000});
test.beforeAll(async()=>{expect(hash(baseline)).toBe(baselineSHA);expect(hash(candidate)).toBe(finalSHA);if(!baselineOnly)expect(finalSHA).not.toBe(baselineSHA);expect(hash(readFileSync('stem_lab/stem_tool_firstresponse.js'))).toBe(baselineSHA);mkdirSync(report,{recursive:true});await harness.start();});
test.afterAll(async()=>{const retained=views.flatMap(view=>{try{return JSON.parse(readFileSync(resolve(report,view.id+'-evidence.json'),'utf8')).evidence;}catch{return [];}});writeFileSync(resolve(report,'wrist-preview-metrics.json'),JSON.stringify({baselineSHA,finalSHA,baselineOnly,selectedViews:views.map(v=>v.id),evidence:retained},null,2));await harness.stop();});
test.afterEach(async({page})=>{await harness.destroy(page);});
async function settle(page:Page){await page.evaluate(()=>new Promise<void>(resolve=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve()))));await page.locator('.fr-body3d-stage').evaluate(e=>e.scrollIntoView({block:'center',behavior:'instant' as ScrollBehavior}));const sequence=await page.evaluate(()=>{const w=window as any,c=document.querySelector('#wrap canvas');return w.__wristDraws.get(c)?.sequence||0;});await page.waitForFunction(n=>{const w=window as any,c=document.querySelector('#wrap canvas'),r=w.__wristDraws.get(c);return r&&r.sequence>=n+2;},sequence,{timeout:15000});}
async function probe(page:Page){const text=await page.evaluate(()=>JSON.stringify((window as any).__wristProbe(),(key,value)=>{if(typeof value==='number'&&!Number.isFinite(value))throw Error('Non-finite '+key);return value;}));expect(text).not.toBe('null');return JSON.parse(text);}
async function control(page:Page,name:string){const b=page.getByRole('button',{name,exact:true});await expect(b).toBeEnabled();await b.click();await settle(page);}
function recordStep(view:any,variant:string,phase:string,event:string,extra:any={}){writeFileSync(resolve(report,view.id+'-steps.jsonl'),JSON.stringify({at:new Date().toISOString(),variant,phase,event,...extra})+'\n',{flag:'a'});}
async function captureFrame(page:Page,value:any,prefix:string){
  const observed=await page.evaluate(()=>{const stage=document.querySelector('.fr-body3d-stage')!.getBoundingClientRect(),canvas=document.querySelector('#wrap canvas')!.getBoundingClientRect();return {stage:{x:stage.x,y:stage.y,width:stage.width,height:stage.height},canvas:{x:canvas.x,y:canvas.y,width:canvas.width,height:canvas.height},viewport:{width:innerWidth,height:innerHeight}};});
  const s=observed.stage,b=observed.canvas,p=value.wristProjection;
  expect(b.width).toBe(value.canvasRect.width);expect(b.height).toBe(value.canvasRect.height);expect(p.inFrame).toBeGreaterThan(0);
  const x=Math.floor(s.x),y=Math.floor(s.y),width=Math.ceil(s.x+s.width)-x,height=Math.ceil(s.y+s.height)-y;
  expect(x).toBeGreaterThanOrEqual(0);expect(y).toBeGreaterThanOrEqual(0);expect(x+width).toBeLessThanOrEqual(observed.viewport.width);expect(y+height).toBeLessThanOrEqual(observed.viewport.height);
  const capture=prefix+'-stage.png',screenshotStart=Date.now(),buffer=await page.screenshot({path:resolve(report,capture),clip:{x,y,width,height},scale:'css',timeout:30000}),screenshotMs=Date.now()-screenshotStart;
  const margin=22,left=b.x+(Math.max(-1,p.min[0])+1)*b.width/2,top=b.y+(1-Math.min(1,p.max[1]))*b.height/2,right=b.x+(Math.min(1,p.max[0])+1)*b.width/2,bottom=b.y+(1-Math.max(-1,p.min[1]))*b.height/2;
  const cropX=Math.max(0,Math.floor(left-margin)-x),cropY=Math.max(0,Math.floor(top-margin)-y),cropWidth=Math.min(width-cropX,Math.ceil(right+margin)-x-cropX),cropHeight=Math.min(height-cropY,Math.ceil(bottom+margin)-y-cropY);
  expect(cropWidth).toBeGreaterThan(4);expect(cropHeight).toBeGreaterThan(4);const cropStart=Date.now(),cropped=cropPng(buffer,{x:cropX,y:cropY,width:cropWidth,height:cropHeight},{width,height}),detailFile=prefix+'-wrists.png';writeFileSync(resolve(report,detailFile),cropped.buffer);
  return {capture,detail:{file:detailFile,clip:{x:x+cropX,y:y+cropY,width:cropWidth,height:cropHeight},proof:cropped.proof},captureInfo:{stageClip:{x,y,width,height},observedCanvas:b,screenshotMs,cropMs:Date.now()-cropStart}};
}
function valid(value:any,view:any){expect(value.contrast).toBe(view.contrast);expect(value.state.b3dStatus).toBe('ready');expect(value.errors).toEqual([]);expect(value.hands).toEqual(['lower','upper']);expect(value.handParts).toHaveLength(26);expect(value.joints).toHaveLength(2);expect(value.draw.createdBy).toBe('page');expect(value.draw.calls).toBeGreaterThan(0);expect(value.draw.triangles).toBeGreaterThan(0);expect(value.draw.draws).toBeGreaterThan(0);expect(value.draw.disposeCount).toBe(0);expect(value.camera.aspect).toBeCloseTo(value.canvasRect.width/value.canvasRect.height,5);expect(Math.abs(value.lowerContactGap)).toBeLessThan(.00001);for(const part of value.handParts){expect(part.projection.total,part.name).toBeGreaterThan(0);expect(part.projection.inFrame,part.name+' complete in frame').toBe(part.projection.total);expect(part.projection.nonFinite).toBe(0);expect(part.projection.badNormals).toBe(0);}for(const joint of value.joints){expect(joint.visible).toBe(true);expect(joint.projection.total).toBeGreaterThan(0);expect(joint.projection.inFrame,'complete wrist joint').toBe(joint.projection.total);expect(joint.projection.nonFinite).toBe(0);expect(joint.projection.badNormals).toBe(0);if(view.contrast)expect(joint.material.type).toBe('MeshBasicMaterial');}for(const p of value.handParts){expect(p.surfaces.length,p.name+' rendered surfaces').toBeGreaterThan(0);if(view.contrast)for(const surface of p.surfaces)expect(surface.material.type).toBe('MeshBasicMaterial');}}
function matching(value:any,reference:any){
  // This refinement changes shading only. Keep every other wrist attribute exact.
  expect(value.wristProjection).toEqual(reference.wristProjection);
  expect(value.draw.triangles).toBe(reference.draw.triangles);
  for(let i=0;i<value.joints.length;i++){
    const joint=value.joints[i],prior=reference.joints[i];
    expect(joint.projection).toEqual(prior.projection);
    expect(joint.geometry.attributes.normal).toBeTruthy();expect(prior.geometry.attributes.normal).toBeTruthy();
    const retained=JSON.parse(JSON.stringify(joint.geometry)),expected=JSON.parse(JSON.stringify(prior.geometry));
    delete retained.attributes.normal.buffer;delete expected.attributes.normal.buffer;
    expect(retained,'only the wrist normal buffer may change').toEqual(expected);
  }
expect(value.camera).toEqual(reference.camera);expect(value.state).toEqual(reference.state);expect(value.preserved).toEqual(reference.preserved);expect(value.handParts).toEqual(reference.handParts);expect(value.handProjection).toEqual(reference.handProjection);expect(value.heelProjection).toEqual(reference.heelProjection);expect(value.contact).toEqual(reference.contact);expect(value.marker).toEqual(reference.marker);expect(value.lowerContactGap).toBe(reference.lowerContactGap);expect(value.joints.map((j:any)=>({id:j.id,material:j.material,visible:j.visible}))).toEqual(reference.joints.map((j:any)=>({id:j.id,material:j.material,visible:j.visible})));expect(value.draw.geometries).toBe(reference.draw.geometries);expect(value.draw.programs).toBe(reference.draw.programs);}

for(const view of views)test('rescuer wrist '+view.id+' release and compression in matched native views',async({page})=>{
  const errors:string[]=[];page.on('pageerror',e=>errors.push('page: '+e.message));page.on('console',m=>{if(m.type()==='error')errors.push('console: '+m.text());});await page.emulateMedia({reducedMotion:'reduce'});const attempts:any[]=[];
  try{await page.setViewportSize({width:view.width,height:view.height});const reference:Record<string,any>={};
    for(const variant of variants){const attempt:any={variant,startedAt:new Date().toISOString(),phase:'mount'};attempts.push(attempt);recordStep(view,variant,'mount','start');await page.unroute('**/stem_lab/stem_tool_firstresponse.js');const source=variant==='baseline'?baseline:candidate;await page.route('**/stem_lab/stem_tool_firstresponse.js',route=>route.fulfill({body:source,contentType:'text/javascript; charset=utf-8'}));
      await harness.mount(page,{__wristContrast:view.contrast,firstResponse:{consentAccepted:true,view:'body3d',b3dTab:'depth',b3dAge:view.age,b3dChildHands:'two',b3dPlaced:'correct',b3dDepthLab:{age:view.age,depth:5,lean:0,rate:110,motion:'inspect',phase:0,hands:true,anatomy:false,measure:false},b3dHandStudy:{},faMastery:{},modulesVisited:{},badges:{}}},'window.__ctx.toolData.firstResponse.b3dStatus === "ready"');await page.addStyleTag({content:'#wrap{width:100%!important;max-width:1160px;margin:0 auto}body{margin:0}'});await settle(page);const canvas=page.locator('#wrap canvas');await expect(canvas).toHaveCount(1);const handle=await canvas.elementHandle();expect(handle).toBeTruthy();await control(page,view.button);let released:any;
      for(const phase of ['release','compression']){attempt.phase=phase;recordStep(view,variant,phase,'control-start');await control(page,phase==='release'?'Inspect released contact':'Inspect deepest contact');recordStep(view,variant,phase,'probe-start');const value=await probe(page);attempt[phase]=value;recordStep(view,variant,phase,'probe-end',{probeElapsedMs:value.probeElapsedMs});valid(value,view);expect(value.state.b3dDepthLab.phase).toBe(phase==='release'?0:50);if(phase==='release')released=value;else{expect(value.camera).toEqual(released.camera);expect(value.marker[1]).toBeLessThan(released.marker[1]-.01);expect(value.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));expect(value.draw.geometries).toBe(released.draw.geometries);expect(value.draw.programs).toBe(released.draw.programs);}
        if(variant==='baseline')reference[phase]=value;else matching(value,reference[phase]);const prefix=view.id+'-'+variant+'-'+phase;recordStep(view,variant,phase,'capture-start');const captured=await captureFrame(page,value,prefix);recordStep(view,variant,phase,'capture-end',captured.captureInfo);evidence.push({...view,variant,phase,sourceSHA:hash(source),...captured,...value});
      }
      await control(page,view.button);const repeated=await probe(page);expect(repeated.draw.geometries).toBe(released.draw.geometries);expect(repeated.draw.programs).toBe(released.draw.programs);expect(repeated.camera).toEqual(released.camera);expect(repeated.joints.map((j:any)=>j.geometry)).toEqual(released.joints.map((j:any)=>j.geometry));expect(await harness.glContexts(page)).toHaveLength(1);expect((await harness.glContexts(page)).filter(r=>r.connected&&r.inWrap&&!r.lost)).toHaveLength(1);attempt.phase='disposal';await harness.unmount(page);expect(await harness.leakedAfterUnmount(page)).toEqual([]);expect(await handle!.evaluate((c:any)=>(window as any).__wristDraws.get(c).disposeCount)).toBe(1);await expect(page.locator('#wrap canvas')).toHaveCount(0);await handle!.dispose();expect(errors).toEqual([]);attempt.phase='complete';recordStep(view,variant,'cleanup','complete');
    }
    expect(hash(candidate)).toBe(finalSHA);expect(hash(readFileSync('stem_lab/stem_tool_firstresponse.js'))).toBe(baselineSHA);expect(evidence.filter(e=>e.id===view.id)).toHaveLength(variants.length*2);
  }finally{writeFileSync(resolve(report,view.id+'-evidence.json'),JSON.stringify({baselineSHA,finalSHA,baselineOnly,view,attempts,evidence:evidence.filter(e=>e.id===view.id)},null,2));}
});
