    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/2010.png",
      "text": "Kajeno ha ke tlo shebella TV. Ha ho na motlakase.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=2",
      "sourceDigest": "sha256:c222f9c8f1be85617c86345a8792f2d3e978abc551637e53b098d8c9d8e20ba3"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/2011.png",
      "text": "Ekaba ke tlo etsang? Kajeno ke tlo mamela 'mele oa ka!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=36350#page=3",
