llustration","v":{"s":"BACK - EDUCATIONAL ILLUSTRATION"}},{"k":"front_educational_illustration","v":{"s":"FRONT - EDUCATIONAL ILLUSTRATION"}},{"k":"great_seal_1935_fact","v":{"s":"Both sides of the Great Seal first appeared together on $1 paper money in 1935."}},{"k":"one_dollar_no_modern_features","v":{"s":"Important: the $1 note has no watermark, security thread, or color-shifting ink."}},{"k":"cash_grouping_equation","v":{"s":"Cash grouping equation"}},{"k":"cashier_calculation","v":{"s":"Cashier calculation"}},{"k":"chart_img","v":{"s":"Chart of the current data"}},{"k":"completed_receipt_items","v":{"s":"Completed receipt items"}},{"k":"current_cart_items","v":{"s":"Current cart items"}},{"k":"grocery_products","v":{"s":"Grocery products"}},{"k":"personal_finance_sections","v":{"s":"Personal finance sections"}},{"k":"compound_interest_growth_table","v":{"s":"Compound interest growth table"}},{"k":"loan_amortization_schedule","v":{"s":"Loan amortization schedule"}},{"k":"activity_overview","v":{"s":"Explore money activities and your current setup"}},{"k":"solved","v":{"s":"✓ Solved"}},{"k":"count_on_trail","v":{"s":"Count on, one coin or bill at a time"}},{"k":"trail_limit","v":{"s":"The first 30 pieces are shown. The cash breakdown includes every piece."}},{"k":"equivalent_cash_prompt","v":{"s":"Can you make the same total with a different set of coins? Explain why the value stays the same."}},{"k":"fixed_classroom_exchange_model","v":{"s":"Practice with a fixed classroom rate model. These are not live market quotes."}},{"k":"fixed_rates_units_per_usd","v":{"s":"Fixed classroom rates (units per 1 USD)"}},{"k":"exchange_model_formula","v":{"s":"Method: amount ÷ the from-currency rate × the to-currency rate. Round only the final result."}},{"k":"round_exchange_to_whole_yen","v":{"s":"Round the final answer to the nearest whole yen."}},{"k":"round_exchange_to_cents","v":{"s":"Round the final answer to the nearest cent (2 decimal places)."}},{"k":"enter_currency_amount_before_checking","v":{"s":"Enter a valid non-negative amount before checking."}},{"k":"enter_positive_loan","v":{"s":"Enter a loan amount greater than zero and a positive term to calculate payments."}},{"k":"same_value_another_way","v":{"s":"Make the same value another way"}},{"k":"keep_then_rebuild","v":{"s":"Save one set, then clear or change the counting board to build the same total with different coins or bills."}},{"k":"save_current_set","v":{"s":"Save current set"}},{"k":"remove_saved_set","v":{"s":"Remove saved set"}},{"k":"saved_set","v":{"s":"Saved set"}},{"k":"current_set","v":{"s":"Current set"}},{"k":"build_matching_set","v":{"s":"Add coins or bills to match the saved total."}},{"k":"equivalent_sets_success","v":{"s":"Same value, different pieces! Explain how both sets make the same total."}},{"k":"same_set_prompt","v":{"s":"The values match. Try using different denominations."}},{"k":"compare_sets_prompt","v":{"s":"The totals differ. Compare both sets and adjust the counting board."}},{"k":"deep_valid_amount","v":{"s":"Enter a non-negative amount using this currency’s precision before checking."}},{"k":"deep_supported","v":{"s":"Completed with support. Explain how the change and price make the amount paid."}},{"k":"deep_correct_change","v":{"s":"Correct. The price plus your change equals the amount paid."}},{"k":"deep_too_little","v":{"s":"Too little change. Count up farther from the price toward the amount paid."}},{"k":"deep_too_much","v":{"s":"Too much change. The price plus your change is greater than the amount paid."}},{"k":"deep_change_intro","v":{"s":"Find the difference between the price and the amount paid. Type an amount or build the change using coins and bills."}},{"k":"deep_invalid_problem","v":{"s":"This saved payment does not cover the price. Generate a new problem."}},{"k":"deep_build_change","v":{"s":"Build the change"}},{"k":"deep_tray_intro","v":{"s":"Add money to your tray. Different combinations can make the same change. Check your tray when it is ready."}},{"k":"deep_money_choices","v":{"s":"Money to add to the change tray"}},{"k":"deep_add","v":{"s":"Add "}},{"k":"deep_tray_total","v":{"s":"Your tray: "}},{"k":"deep_price_plus_tray","v":{"s":"Price + your tray: "}},{"k":"deep_tray_limit","v":{"s":"The tray holds 100 pieces. Undo or clear pieces to try a different combination."}},{"k":"deep_undo_piece","v":{"s":"Undo last piece"}},{"k":"deep_clear_tray","v":{"s":"Clear tray"}},{"k":"deep_check_tray","v":{"s":"Check tray"}},{"k":"deep_count_guide","v":{"s":"Count-up guide"}},{"k":"deep_support_note","v":{"s":"Use friendly amounts to find the missing difference. Opening the guide marks this problem as supported practice."}},{"k":"deep_start_guide","v":{"s":"Start count-up guide"}},{"k":"deep_previous_jump","v":{"s":"Previous jump"}},{"k":"deep_next_jump","v":{"s":"Next jump"}},{"k":"deep_show_solution","v":{"s":"Show worked solution"}},{"k":"deep_reached","v":{"s":"Reached: "}},{"k":"deep_added","v":{"s":"Added so far: "}},{"k":"deep_exact_payment","v":{"s":"The payment equals the price. No change is needed."}},{"k":"deep_check_both_ways","v":{"s":"Check both ways"}},{"k":"deep_one_cash_solution","v":{"s":"One way to return the cash:"}},{"k":"deep_cash_remainder","v":{"s":"The available cash leaves an amount that cannot be represented: "}},{"k":"deep_tip_rounding","v":{"s":"Round the tip to the currency’s smallest accounting unit first. Then add it to the bill and divide. Enter the rounded amount per person."}},{"k":"deep_discount_order","v":{"s":"Apply the percentage to the original price first, round the sale price, then subtract the coupon. The final price cannot fall below zero."}},{"k":"deep_show_percent","v":{"s":"Show percentage model (supported practice)"}},{"k":"deep_percent_of_whole","v":{"s":"Start with the whole: 100%"}},{"k":"deep_percent_round_note","v":{"s":"The bar shows the percentage of the original amount. Money labels follow the currency rounding used in this problem."}},{"k":"deep_add_tip","v":{"s":"Add the tip to the whole bill: "}},{"k":"deep_per_person","v":{"s":" per person"}},{"k":"deep_every_unit","v":{"s":"Make the actual payments add up"}},{"k":"deep_split_rounding","v":{"s":"If everyone pays the same rounded amount, the payments may miss the bill total. One exact split gives some people one smallest accounting unit more."}},{"k":"deep_people_pay","v":{"s":" people pay "}},{"k":"deep_split_accounting","v":{"s":"These are accounting amounts. Cash payments may also need adjustment to the available coins."}},{"k":"deep_keep_percent","v":{"s":"Keep the remaining percentage: "}},{"k":"deep_then_coupon","v":{"s":"Then apply the coupon: "}},{"k":"deep_coupon_limit","v":{"s":"The coupon exceeds the remaining price. This model reduces the price to zero; it does not create money back."}},{"k":"deep_discount_parts","v":{"s":"Percentage savings + applied coupon + final price = original price."}},{"k":"deep_tip_retry","v":{"s":"Recheck the tip, add it to the bill, then divide by the number of diners. Use the percentage model if you want worked support."}},{"k":"deep_discount_retry","v":{"s":"Find the percentage of the original price that remains, then subtract the coupon. Use the percentage model if you want worked support."}},{"k":"deep_check_estimate","v":{"s":"Check estimated total"}},{"k":"deep_new_change_check","v":{"s":"Generate a change-check problem"}},{"k":"deep_contributions","v":{"s":"contributions"}},{"k":"deep_no_contributions","v":{"s":"No contributions yet"}},{"k":"deep_growth_chart","v":{"s":"Modeled balance and contributions over time"}},{"k":"deep_years","v":{"s":"years"}},{"k":"deep_growth_description","v":{"s":"Both lines use the same zero-based money scale. Dashed: money contributed. Solid: modeled balance, including interest. At the final year: "}},{"k":"deep_starting_balance","v":{"s":"Starting balance"}},{"k":"deep_monthly_contribution","v":{"s":"Monthly contribution"}},{"k":"deep_scenario_log","v":{"s":"Recorded growth scenarios"}},{"k":"deep_explain_growth","v":{"s":"Explain the modeled growth"}},{"k":"deep_person_pays","v":{"s":" person pays "}},{"k":"deep_inquiry_intro","v":{"s":"Change one setting at a time, then compare the balance with the money contributed. The results update immediately. Record what you notice."}},{"k":"deep_observation_label","v":{"s":"Your prediction or observation"}},{"k":"deep_observation_example","v":{"s":"If I keep the monthly contribution fixed and increase the time, I expect…"}},{"k":"budgetplan_scale_title","v":{"s":"Allocations against one income"}},{"k":"budgetplan_one_income","v":{"s":"Each full strip represents 100% of one income: "}},{"k":"budgetplan_available_income","v":{"s":"Available income: 0–100%"}},{"k":"budgetplan_excess_strip","v":{"s":"Beyond the income: "}},{"k":"budgetplan_exact_allocation","v":{"s":"The allocations equal the income."}},{"k":"budgetplan_unallocated","v":{"s":"% is unallocated: "}},{"k":"budgetplan_overallocated","v":{"s":"% is beyond the income: "}},{"k":"budgetplan_rounding","v":{"s":"For whole cents or yen, round each share down first, then give the remaining units to the largest fractional remainders. Ties follow category order. This keeps the displayed amounts equal to the rounded allocation total."}},{"k":"budgetplan_zero_income","v":{"s":"These percentages describe a plan. With zero income, every money amount is zero."}},{"k":"budgetplan_tradeoff_title","v":{"s":"Try a budget tradeoff"}},{"k":"budgetplan_transfer_intro","v":{"s":"Move a share from one category to another. The total percentage stays the same. Five percentage points means 5% of the whole income, not 5% of the starting category."}},{"k":"budgetplan_from","v":{"s":"Move from"}},{"k":"budgetplan_to","v":{"s":"Move to"}},{"k":"budgetplan_points","v":{"s":"Percentage points to move"}},{"k":"budgetplan_transfer_help","v":{"s":"Choose two different categories and a whole number of points available in the first category. Neither category can exceed 100%."}},{"k":"budgetplan_apply","v":{"s":"Move allocation"}},{"k":"budgetplan_replace_reference","v":{"s":"Save current plan as reference"}},{"k":"budgetplan_save_reference","v":{"s":"Save plan to compare"}},{"k":"budgetplan_clear_reference","v":{"s":"Clear saved plan"}},{"k":"budgetplan_compare_title","v":{"s":"Saved and current budget plans"}},{"k":"budgetplan_saved_income","v":{"s":"Saved income: "}},{"k":"budgetplan_current_income","v":{"s":"Current income: "}},{"k":"budgetplan_changed_income","v":{"s":"The incomes differ. Money amounts can change even when the percentages stay the same."}},{"k":"budgetplan_saved","v":{"s":"Saved: "}},{"k":"budgetplan_current","v":{"s":"Current: "}},{"k":"budgetplan_point_change","v":{"s":" percentage points; "}},{"k":"budgetplan_total_allocation","v":{"s":"Total allocation: "}},{"k":"budgetplan_reflect","v":{"s":"Which category gained a share, and which gave it up? Explain what stayed the same and what changed."}},{"k":"budgetplan_allocated","v":{"s":"% allocated"}},{"k":"budgetplan_income_yen","v":{"s":"Enter a monthly income from 0 to 1,000,000 in whole yen."}},{"k":"budgetplan_income_cents","v":{"s":"Enter a monthly income from 0 to 1,000,000 with no more than two decimal places."}},{"k":"budgetplan_slider_label","v":{"s":" budget percentage"}},{"k":"budgetplan_adjust_title","v":{"s":"Adjust individual percentages"}},{"k":"budgetplan_adjust_help","v":{"s":"Each slider sets a share of the whole income. These controls change the total allocation; use them to reach 100%."}},{"k":"budgetplan_minimum_expense","v":{"s":"Increase the income to model an expense of at least one cent or yen."}},{"k":"budgetplan_zero_expense","v":{"s":"This expense rounds to zero. Increase the income before choosing a response."}},{"k":"nav_growth_explorer","v":{"s":"Explore interest growth"}},{"k":"nav_choose_activity","v":{"s":"Choose an activity"}},{"k":"nav_show_fewer","v":{"s":"Show fewer activities"}},{"k":"nav_show_all","v":{"s":"Show all activities"}},{"k":"counting_board_start","v":{"s":"Choose a coin or bill to add it to your counting board. With a keyboard, use Tab to choose an item, then Enter or Space to add it."}}],"id":550}},{"k":"moonmission","v":{"o":[{"k":"mission_briefing","v":{"s":"Mission Briefing"}},{"k":"review_your_mission_objectives_and_cre","v":{"s":"Review your mission objectives and crew assignment"}},{"k":"launch","v":{"s":"Launch"}},{"k":"countdown_and_liftoff_from_kennedy_spa","v":{"s":"Countdown and liftoff from Kennedy Space Center"}},{"k":"earth_orbit","v":{"s":"Earth Orbit"}},{"k":"reach_low_earth_orbit_and_prepare_for_","v":{"s":"Reach low Earth orbit and prepare for trans-lunar injection"}},{"k":"trans_lunar_coast","v":{"s":"Trans-Lunar Coast"}},{"k":"3_day_journey_to_the_moon_384_400_km","v":{"s":"3-day journey to the Moon — 384,400 km"}},{"k":"lunar_orbit","v":{"s":"Lunar Orbit"}},{"k":"enter_orbit_around_the_moon","v":{"s":"Enter orbit around the Moon"}},{"k":"powered_descent","v":{"s":"Powered Descent"}},{"k":"pilot_the_lunar_module_to_the_surface","v":{"s":"Pilot the Lunar Module to the surface"}},{"k":"moonwalk_eva","v":{"s":"Moonwalk EVA"}},{"k":"explore_the_lunar_surface_and_collect_","v":{"s":"Explore the lunar surface and collect samples"}},{"k":"lunar_ascent","v":{"s":"Lunar Ascent"}},{"k":"launch_from_the_moon_and_rendezvous_wi","v":{"s":"Launch from the Moon and rendezvous with Command Module"}},{"k":"trans_earth_coast","v":{"s":"Trans-Earth Coast"}},{"k":"return_journey_to_earth","v":{"s":"Return journey to Earth"}},{"k":"re_entry_splashdown","v":{"s":"Re-entry & Splashdown"}},{"k":"survive_re_entry_and_splash_down_in_th","v":{"s":"Survive re-entry and splash down in the Pacific"}},{"k":"pilots_the_lunar_module_to_the_surface","v":{"s":"Pilots the Lunar Module to the surface and leads the EVA"}},{"k":"alex","v":{"s":"Alex"}},{"k":"orbits_the_moon_alone_in_the_command_m","v":{"s":"Orbits the Moon alone in the Command Module while CDR and LMP explore"}},{"k":"jordan","v":{"s":"Jordan"}},{"k":"assists_with_descent_and_eva_operates_","v":{"s":"Assists with descent and EVA, operates scientific instruments"}},{"k":"anorthosite","v":{"s":"Anorthosite"}},{"k":"this_ancient_rock_from_the_lunar_highl","v":{"s":"This ancient rock from the lunar highlands is 4.4 billion years old — nearly as old as the Moon itself. It tells us the Moon once had a global magma ocean."}},{"k":"basalt","v":{"s":"Basalt"}},{"k":"dark_volcanic_basalt_filled_the_moon_s","v":{"s":"Dark volcanic basalt filled the Moon's giant impact basins to create the dark \"seas\" (maria) visible from Earth. These lavas erupted 3-3.5 billion years ago."}},{"k":"breccia","v":{"s":"Breccia"}},{"k":"a_jumbled_mix_of_rock_fragments_welded","v":{"s":"A jumbled mix of rock fragments welded together by meteorite impacts. The Moon's surface has been pounded for 4+ billion years."}},{"k":"regolith_core","v":{"s":"Regolith Core"}},{"k":"lunar_soil_is_ground_up_rock_from_bill","v":{"s":"Lunar soil is ground-up rock from billions of years of micrometeorite bombardment. It contains tiny glass beads and even traces of solar wind particles."}},{"k":"orange_soil","v":{"s":"Orange Soil"}},{"k":"apollo_17_found_orange_soil_tiny_glass","v":{"s":"Apollo 17 found orange soil — tiny glass beads from an ancient volcanic eruption 3.7 billion years ago. This was one of Apollo's most exciting discoveries!"}},{"k":"kreep_basalt","v":{"s":"KREEP Basalt"}},{"k":"kreep_stands_for_potassium_k_rare_eart","v":{"s":"KREEP stands for Potassium (K), Rare Earth Elements, and Phosphorus. These minerals concentrated in the last dregs of the lunar magma ocean."}},{"k":"impact_glass","v":{"s":"Impact Glass"}},{"k":"meteorite_impacts_melt_rock_into_glass","v":{"s":"Meteorite impacts melt rock into glass that flies through space and lands as tiny spheres. Some contain trapped gases from the ancient lunar atmosphere."}},{"k":"genesis_rock","v":{"s":"Genesis Rock"}},{"k":"apollo_15_found_this_4_1_billion_year_","v":{"s":"Apollo 15 found this 4.1 billion year old anorthosite, one of the oldest rocks ever collected. It helped prove the magma ocean theory of the Moon's formation."}},{"k":"the_moon_is_about_384_400_km_away_ligh","v":{"s":"The Moon is about 384,400 km away — light takes 1.3 seconds to travel there!"}},{"k":"apollo_missions_took_about_3_days_each","v":{"s":"Apollo missions took about 3 days each way, reaching ~39,000 km/h at injection, then coasting slower as it climbed away from Earth."}},{"k":"the_moon_s_gravity_is_1_6_of_earth_s_a","v":{"s":"The Moon's gravity is 1/6 of Earth's. A 70 kg person still has 70 kg of mass, but their weight feels like about 12 kg on Earth."}},{"k":"the_sunlit_side_reaches_127_c_while_th","v":{"s":"The sunlit side reaches 127°C, while the dark side drops to -173°C!"}},{"k":"12_astronauts_walked_on_the_moon_acros","v":{"s":"12 astronauts walked on the Moon across Apollo 11, 12, 14, 15, 16, and 17."}},{"k":"buzz_aldrin_said_contact_light_first_b","v":{"s":"Armstrong reported: \"Houston, Tranquility Base here. The Eagle has landed.\" Aldrin's technical \"Contact light\" call came just before touchdown."}},{"k":"the_first_stage_burned_rp_1_kerosene_w","v":{"s":"The first stage burned RP-1 kerosene with liquid oxygen — 2,000+ tons of fuel in 2.5 minutes!"}},{"k":"sound_needs_a_medium_air_water_to_trav","v":{"s":"Sound needs matter to vibrate through. With almost no atmosphere, the Moon cannot carry ordinary open-air sound, though astronauts still hear radios and vibrations through suits or equipment."}},{"k":"every_apollo_astronaut_reported_that_m","v":{"s":"Several Apollo astronauts reported that Moon dust smelled like spent gunpowder when brought inside the LM."}},{"k":"the_oldest_moon_rocks_are_4_4_billion_","v":{"s":"The oldest Moon rocks are 4.4 billion years old — nearly as old as the solar system itself!"}},{"k":"the_moon_is_about_384_400_km_away_ligh_2","v":{"s":"The Moon is about 384,400 km away — light takes 1.3 seconds to travel there!"}},{"k":"waste_management_malfunction","v":{"s":"Waste Management Malfunction"}},{"k":"rotate_spacecraft_to_expose_vent_to_su","v":{"s":"Rotate spacecraft to expose vent to sunlight"}},{"k":"reroute_cabin_heater_duct_to_warm_the_","v":{"s":"Reroute cabin heater duct to warm the pipe"}},{"k":"seal_the_vent_and_use_backup_waste_bag","v":{"s":"Seal the vent and use backup waste bags"}},{"k":"program_alarm_1202","v":{"s":"Program Alarm 1202!"}},{"k":"trust_the_computer_and_continue_go","v":{"s":"Trust the computer and continue — \"GO!\""}},{"k":"abort_the_descent_fire_ascent_engine","v":{"s":"Abort the descent — fire ascent engine"}},{"k":"switch_to_full_manual_control","v":{"s":"Switch to full manual control"}},{"k":"boulder_field_at_landing_site","v":{"s":"Boulder Field at Landing Site!"}},{"k":"take_manual_control_and_fly_past_the_b","v":{"s":"Take manual control and fly past the boulders"}},{"k":"land_where_the_computer_says","v":{"s":"Land where the computer says"}},{"k":"abort_and_try_again_next_orbit","v":{"s":"Abort and try again next orbit"}},{"k":"oxygen_tank_pressure_spike","v":{"s":"Oxygen Tank Pressure Spike"}},{"k":"immediately_isolate_tank_2_and_switch_","v":{"s":"Immediately isolate Tank 2 and switch to Tank 1"}},{"k":"vent_tank_2_to_relieve_pressure","v":{"s":"Vent Tank 2 to relieve pressure"}},{"k":"try_to_reset_the_tank_heater_circuit","v":{"s":"Try to reset the tank heater circuit"}},{"k":"space_adaptation_syndrome","v":{"s":"Space Adaptation Syndrome"}},{"k":"administer_anti_nausea_medication_and_","v":{"s":"Administer anti-nausea medication and rest period"}},{"k":"tough_it_out_keep_working_through_the_","v":{"s":"Tough it out — keep working through the nausea"}},{"k":"reduce_visual_stimulation_and_close_wi","v":{"s":"Reduce visual stimulation and close window shades"}},{"k":"tourist","v":{"s":"Tourist"}},{"k":"guided_experience_auto_landing_extende","v":{"s":"Guided experience — auto-landing, extended O₂"}},{"k":"pilot","v":{"s":"Pilot"}},{"k":"standard_apollo_parameters","v":{"s":"Standard Apollo parameters"}},{"k":"commander","v":{"s":"Commander"}},{"k":"realistic_tight_fuel_budget_faster_o_d","v":{"s":"Realistic — tight fuel budget, faster O₂ drain"}},{"k":"one_small_step","v":{"s":"One Small Step"}},{"k":"complete_your_first_eva_moonwalk","v":{"s":"Complete your first EVA moonwalk"}},{"k":"lunar_geologist","v":{"s":"Lunar Geologist"}},{"k":"collect_4_rock_samples","v":{"s":"Collect 4+ rock samples"}},{"k":"sample_return","v":{"s":"Sample Return"}},{"k":"collect_all_8_sample_types","v":{"s":"Collect all 8 sample types"}},{"k":"complete_the_full_mission","v":{"s":"Complete the full mission"}},{"k":"space_scholar","v":{"s":"Space Scholar"}},{"k":"answer_5_quiz_questions_correctly","v":{"s":"Answer 5+ quiz questions correctly"}},{"k":"right_stuff","v":{"s":"Right Stuff"}},{"k":"complete_mission_on_commander_difficul","v":{"s":"Complete mission on Commander difficulty"}},{"k":"back_to_stem_lab","v":{"s":"Back to STEAM Lab"}},{"k":"apollo_moon_mission","v":{"s":"🚀 Apollo Moon Mission"}},{"k":"full_mission_simulation_launch_to_spla","v":{"s":"Full mission simulation • Launch to splashdown"}},{"k":"what_really_happened","v":{"s":"📚 What really happened?"}},{"k":"continue_mission","v":{"s":"🚀 Continue Mission"}},{"k":"space_knowledge_check","v":{"s":"Space Knowledge Check"}},{"k":"launch_2","v":{"s":"Launch"}},{"k":"splashdown","v":{"s":"Splashdown"}},{"k":"mission_briefing_2","v":{"s":"MISSION BRIEFING"}},{"k":"apollo_style_lunar_landing_mission","v":{"s":"Apollo-style lunar landing mission"}},{"k":"mission_objectives","v":{"s":"🎯 MISSION OBJECTIVES"}},{"k":"ai_customized","v":{"s":"✨ AI-customized"}},{"k":"your_crew","v":{"s":"👨‍🚀 YOUR CREW"}},{"k":"mission_difficulty_selection","v":{"s":"Mission difficulty selection"}},{"k":"mission_difficulty","v":{"s":"🎮 MISSION DIFFICULTY"}},{"k":"begin_mission_proceed_to_launch","v":{"s":"🚀 Begin Mission — Proceed to Launch"}},{"k":"animated_saturn_v_rocket_launch_sequen","v":{"s":"Animated Saturn V rocket launch sequence. A 5-second countdown, then ascent through the atmosphere to orbit. The rocket pitches over into a gravity turn shortly after liftoff, trading vertical climb for the sideways speed that orbit actually requires, and drifts downrange as it goes. Shows altitude, velocity, pitch angle from vertical, G-force, and stage separations."}},{"k":"saturn_v_3_stages_7_5_million_lbs_thru","v":{"s":"🚀 Saturn V • 3 stages • 7.5 million lbs thrust"}},{"k":"watch_the_countdown_and_ascent_through","v":{"s":"Watch the countdown and ascent through Earth's atmosphere"}},{"k":"proceed_to_earth_orbit_phase_after_suc","v":{"s":"Proceed to Earth orbit phase after successful launch"}},{"k":"proceed_to_orbit","v":{"s":"✅ Proceed to Orbit"}},{"k":"animated_view_of_spacecraft_in_low_ear","v":{"s":"Animated view of spacecraft in low Earth orbit at 185 kilometers. CSM completes 1.5 orbits while a trans-lunar injection burn window aligns with the Moon's future position. Orbit counter, altitude, velocity, and TLI readiness displayed."}},{"k":"low_earth_orbit","v":{"s":"Low Earth Orbit"}},{"k":"altitude_185_km_speed_28_000_km_h_1_5_","v":{"s":"Altitude: 185 km • Speed: 28,000 km/h • 1.5 orbits before TLI burn"}},{"k":"trans_lunar_injection_tli","v":{"s":"🚀 TRANS-LUNAR INJECTION (TLI)"}},{"k":"the_s_ivb_third_stage_will_fire_for_5_","v":{"s":"The S-IVB third stage will fire for 5 minutes 47 seconds to accelerate from 28,000 km/h to 38,900 km/h — trans-lunar injection speed, just under escape velocity. This single burn sends you on a trajectory to the Moon, 384,400 km away."}},{"k":"execute_trans_lunar_injection_burn_to_","v":{"s":"Execute trans-lunar injection burn to begin 3-day journey to the Moon"}},{"k":"execute_tli_burn_head_to_the_moon","v":{"s":"🚀 Execute TLI Burn — Head to the Moon"}},{"k":"animated_trans_lunar_coast_earth_shrin","v":{"s":"Animated trans-lunar coast. Earth shrinks on the left, Moon grows on the right as the spacecraft travels 384,400 kilometers over 3 days. Shows distance counter and mission communications."}},{"k":"arrive_at_the_moon_and_enter_lunar_orb","v":{"s":"Arrive at the Moon and enter lunar orbit at 110 kilometer altitude"}},{"k":"arrive_at_the_moon_enter_lunar_orbit","v":{"s":"🌕 Arrive at the Moon — Enter Lunar Orbit"}},{"k":"animated_view_of_spacecraft_orbiting_t","v":{"s":"Animated view of the docked Command and Lunar Module stack orbiting the Moon at 110 kilometer altitude. The Moon shows craters and the Sea of Tranquility landing site marked in green. The spacecraft passes behind the Moon on each orbit and loses radio contact with Earth while it is there, and Earth rises above the lunar limb."}},{"k":"undock_lunar_module_eagle_from_command","v":{"s":"Undock Lunar Module Eagle from Command Module Columbia and begin powered descent to the Moon surface"}},{"k":"undock_begin_powered_descent","v":{"s":"⬇️ Undock & Begin Powered Descent"}},{"k":"powered_descent_2","v":{"s":"Powered Descent"}},{"k":"w","v":{"s":"W / ↑"}},{"k":"fire_engines_thrust_up","v":{"s":"Fire engines (thrust UP)"}},{"k":"a_d_or","v":{"s":"A/D or ←/→"}},{"k":"lateral_movement","v":{"s":"Lateral movement"}},{"k":"goal","v":{"s":"Goal"}},{"k":"v_3_m_s_h_5_m_s","v":{"s":"V < 3 m/s, H < 5 m/s"}},{"k":"tips_from_mission_control","v":{"s":"⚠️ Tips from Mission Control:"}},{"k":"start_slowing_down_early_moon_gravity_","v":{"s":"Start slowing down early — Moon gravity is gentle but relentless"}},{"k":"watch_your_fuel_gauge_you_can_t_thrust","v":{"s":"Watch your fuel gauge — you can't thrust without fuel!"}},{"k":"reduce_horizontal_speed_before_focusin","v":{"s":"Reduce horizontal speed before focusing on vertical"}},{"k":"the_real_apollo_11_landed_with_only_25","v":{"s":"The real Apollo 11 landed with only 25 seconds of fuel left!"}},{"k":"begin_powered_descent_piloting","v":{"s":"Begin powered descent piloting"}},{"k":"begin_descent_take_the_controls","v":{"s":"🚀 Begin Descent — Take the Controls!"}},{"k":"interactive_lunar_descent_piloting_gam","v":{"s":"Interactive lunar descent piloting game. Use W or Up Arrow for thrust, A and D or Left and Right arrows for lateral movement. Land with vertical speed under 3 meters per second and horizontal speed under 5 meters per second."}},{"k":"w_thrust_ad_lateral_land_gently","v":{"s":"↑/W = thrust • ←→/AD = lateral • Land gently!"}},{"k":"begin_extravehicular_activity_moonwalk","v":{"s":"Begin extravehicular activity moonwalk to explore the lunar surface and collect geological samples"}},{"k":"begin_eva","v":{"s":"👨‍🚀 Begin EVA"}},{"k":"moonwalk_eva_2","v":{"s":"Moonwalk EVA"}},{"k":"walk_forward_back_strafe","v":{"s":"Walk forward/back, strafe"}},{"k":"space","v":{"s":"Space"}},{"k":"jump_low_gravity_hop","v":{"s":"Jump (low-gravity hop)"}},{"k":"collect_rock_at_your_feet","v":{"s":"Collect rock at your feet"}},{"k":"mouse","v":{"s":"Mouse"}},{"k":"look_around_click_canvas_first","v":{"s":"Look around (click canvas first)"}},{"k":"mission_objective_apollo_facts","v":{"s":"🎯 Mission objective + Apollo facts:"}},{"k":"collect_at_least_4_unique_rock_samples","v":{"s":"Collect at least 4 unique rock samples to satisfy the geology quest hook."}},{"k":"apollo_11_brought_back_47_5_lb_of_luna","v":{"s":"Apollo 11 brought back 47.5 lb of lunar samples; Apollo 17 brought 243 lb."}},{"k":"in_one_sixth_gravity_a_hop_covers_abou","v":{"s":"In one-sixth gravity, a hop covers about six times the horizontal distance for the same effort."}},{"k":"earth_hangs_in_a_fixed_spot_in_the_lun","v":{"s":"Earth hangs in a fixed spot in the lunar sky because the Moon is tidally locked."}},{"k":"begin_eva_on_the_lunar_surface","v":{"s":"Begin EVA on the lunar surface"}},{"k":"step_onto_the_moon_begin_eva","v":{"s":"👨‍🚀 Step Onto the Moon · Begin EVA"}},{"k":"moonwalk_3d_mode_unresolved","v":{"s":"Moonwalk 3D Mode Unresolved"}},{"k":"webgl_failed_to_initialize_your_browse","v":{"s":"WebGL failed to initialize. Your browser or device might not support 3D hardware acceleration."}},{"k":"retry_3d_mode","v":{"s":"Retry 3D Mode"}},{"k":"interactive_3d_lunar_surface_eva_use_w","v":{"s":"Interactive 3D lunar surface EVA. Use WASD to walk, Q and E to turn, Space to jump in one-sixth gravity, F to collect rock samples, V to board or exit the optional lunar rover, B to toggle optional LRV drive sonification, and the mouse to look around. Collect geological samples on foot and explore the Moon surface near the Lunar Module."}},{"k":"alsep_science_station","v":{"s":"ALSEP Science Station"}},{"k":"the_apollo_lunar_surface_experiments_p","v":{"s":"The Apollo Lunar Surface Experiments Package ran for years after the astronauts left. The seismometer detected moonquakes and meteorite impacts until 1977."}},{"k":"lunar_rover_lrv","v":{"s":"Lunar Rover (LRV)"}},{"k":"the_lunar_roving_vehicle_cost_38_milli","v":{"s":"The Lunar Roving Vehicle cost $38 million. Apollo 17's rover traveled 35.7 km — still parked on the Moon with the keys in it!"}},{"k":"american_flag","v":{"s":"American Flag"}},{"k":"the_flags_on_the_moon_have_been_bleach","v":{"s":"The flags were exposed to decades of harsh sunlight and likely faded badly. Lunar Reconnaissance Orbiter images show several Apollo flag poles still casting shadows; Apollo 11's flag was probably knocked over by engine exhaust."}},{"k":"seismometer","v":{"s":"Seismometer"}},{"k":"lunar_seismometers_detected_deep_moonq","v":{"s":"Lunar seismometers detected deep moonquakes at 700-1100 km depth, caused by tidal forces from Earth. The Moon still has a partially molten core!"}},{"k":"laser_retroreflector","v":{"s":"Laser Retroreflector"}},{"k":"scientists_bounce_lasers_off_this_mirr","v":{"s":"Scientists bounce lasers off this mirror to measure the Earth-Moon distance to within 1 cm accuracy. The Moon moves 3.8 cm farther from Earth each year."}},{"k":"moonwalk_eva_3","v":{"s":"👨‍🚀 Moonwalk EVA"}},{"k":"explore_collect_samples_jump_in_1_6_gr","v":{"s":"Explore • Collect samples • Jump in 1/6 gravity!"}},{"k":"end_eva_return_to_lm","v":{"s":"⬆️ End EVA — Return to LM"}},{"k":"animated_lunar_ascent_sequence_ascent_","v":{"s":"Animated lunar ascent sequence. Ascent stage lifts off the Moon leaving the descent stage behind, climbs to lunar orbit over 60 kilometers, then rendezvous-docks with the orbiting Command Module Columbia. HUD shows altitude, phase, distance to CSM."}},{"k":"lunar_ascent_rendezvous","v":{"s":"Lunar Ascent & Rendezvous"}},{"k":"ascent_stage_launches_from_moon_docks_","v":{"s":"Ascent stage launches from Moon, docks with Columbia"}},{"k":"the_lm_s_ascent_engine_a_single_start_","v":{"s":"The LM's ascent engine — a single-start hypergolic motor with no abort option — fires to launch you off the lunar surface. The descent stage serves as the launch pad and stays behind. You rendezvous and dock with Columbia, then jettison \"Eagle\" (it eventually crashes into the Moon)."}},{"k":"fire_trans_earth_injection_burn_to_beg","v":{"s":"Fire trans-Earth injection burn to begin 3-day return journey home"}},{"k":"tei_burn_head_home","v":{"s":"🚀 TEI Burn — Head Home"}},{"k":"trans_earth_coast_2","v":{"s":"Trans-Earth Coast"}},{"k":"returning_home_384_400_km_3_days","v":{"s":"Returning home • 384,400 km • ~3 days"}},{"k":"the_service_module_engine_fires_for_th","v":{"s":"The Service Module engine fires for the Trans-Earth Injection burn. You coast for 3 days back to Earth, jettison the Service Module, and prepare the Command Module for re-entry — the most dangerous phase of the mission."}},{"k":"begin_atmospheric_re_entry_sequence_at","v":{"s":"Begin atmospheric re-entry sequence at 39,900 kilometers per hour"}},{"k":"begin_re_entry_sequence","v":{"s":"🌊 Begin Re-entry Sequence"}},{"k":"animated_re_entry_sequence_command_mod","v":{"s":"Animated re-entry sequence. Command Module enters atmosphere at 39,900 km/h with plasma heating to 2,760 degrees. Shows radio blackout, drogue chutes, main parachutes, and ocean splashdown."}},{"k":"watch_the_command_module_survive_re_en","v":{"s":"Watch the Command Module survive re-entry at 39,900 km/h through 2,760°C plasma, deploy parachutes, and splash down in the Pacific Ocean."}},{"k":"complete_the_mission_with_pacific_ocea","v":{"s":"Complete the mission with Pacific Ocean splashdown. Welcome home Commander!"}},{"k":"mission_complete_splashdown","v":{"s":"🌊 Mission Complete — SPLASHDOWN!"}},{"k":"mission_complete","v":{"s":"MISSION COMPLETE"}},{"k":"welcome_home_commander_the_world_celeb","v":{"s":"Welcome home, Commander. The world celebrates."}},{"k":"mission_debrief","v":{"s":"🏅 MISSION DEBRIEF"}},{"k":"badges_earned","v":{"s":"🏅 BADGES EARNED:"}},{"k":"these_samples_will_be_studied_by_scien","v":{"s":"These samples will be studied by scientists for decades to come."}},{"k":"decision_analysis","v":{"s":"📊 DECISION ANALYSIS"}},{"k":"historical_context","v":{"s":"Historical context"}},{"k":"reset_and_start_a_new_moon_mission_fro","v":{"s":"Reset and start a new Moon mission from the beginning"}},{"k":"fly_another_mission","v":{"s":"🔄 Fly Another Mission"}},{"k":"insufficient_suborbital","v":{"s":"🔴 Insufficient — suborbital"}},{"k":"leo_earth_orbit","v":{"s":"🟢 LEO / Earth orbit"}},{"k":"escape_velocity_lunar_beyond","v":{"s":"🚀 Escape velocity (lunar/beyond)"}},{"k":"orbital_delta_v_discovery","v":{"s":"🛰️ Orbital delta-V discovery"}},{"k":"tsiolkovsky_rocket_equation_adjust_mas","v":{"s":"Tsiolkovsky rocket equation. Adjust mass ratio, burn duration, and specific impulse (Isp). Discrete 3-state outcome shows whether your delta-V is insufficient, achieves LEO, or escapes Earth. No score, no reveal."}},{"k":"mass_ratio","v":{"s":"Mass ratio"}},{"k":"burn_dur_s","v":{"s":"Burn dur (s)"}},{"k":"isp_s","v":{"s":"Isp (s)"}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset","v":{"s":"↺ Reset"}},{"k":"hypothesis_free_text_no_right_answer_w","v":{"s":"Hypothesis (free text — no right answer): Which lever matters most?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"hold_two_sliders_steady_move_one_watch","v":{"s":"Hold two sliders steady. Move one. Watch."}},{"k":"find_two_settings_producing_the_same_o","v":{"s":"Find two settings producing the same outcome."}},{"k":"which_slider_affects_v_the_most_use_th","v":{"s":"Which slider affects Δv the most? Use the log."}},{"k":"real_spacecraft_trade_fuel_mass_agains","v":{"s":"Real spacecraft trade fuel mass against Isp. Investigate why."}},{"k":"i_think_i_understand_the_trade_offs","v":{"s":"I think I understand the trade-offs"}},{"k":"explain_in_your_own_words_how_do_mass_","v":{"s":"Explain in your own words: how do mass ratio, burn duration, and Isp interact?"}},{"k":"design_note_discrete_3_state_outcome_n","v":{"s":"Design note: discrete 3-state outcome; no score; no reveal — by design."}},{"k":"complete","v":{"s":"Complete"}},{"k":"splashdown_debrief","v":{"s":"Splashdown confirmed. Read your flight record, then fly again."}},{"k":"plan_brief","v":{"s":"Brief"}},{"k":"plan_transit","v":{"s":"Transit"}},{"k":"plan_landing","v":{"s":"Landing"}},{"k":"plan_surface","v":{"s":"Surface"}},{"k":"plan_return","v":{"s":"Return"}},{"k":"mission_control_dashboard","v":{"s":"Mission Control dashboard"}},{"k":"mission_control","v":{"s":"Mission Control"}},{"k":"next_phase_prefix","v":{"s":"Next: "}},{"k":"ready_for_debrief","v":{"s":"Ready for debrief and replay."}},{"k":"met","v":{"s":"MET"}},{"k":"mission_xp","v":{"s":"Mission XP"}},{"k":"samples","v":{"s":"Samples"}},{"k":"quiz","v":{"s":"Quiz"}},{"k":"crew_morale","v":{"s":"Crew morale"}},{"k":"badges","v":{"s":"Badges"}},{"k":"active","v":{"s":"Active"}},{"k":"upcoming","v":{"s":"Upcoming"}},{"k":"resume_mission_clock","v":{"s":"Resume mission clock"}},{"k":"pause_mission_clock","v":{"s":"Pause mission clock"}},{"k":"resume","v":{"s":"▶ Resume"}},{"k":"pause","v":{"s":"⏸ Pause"}},{"k":"mission_profile","v":{"s":"🗺️ MISSION PROFILE"}},{"k":"mission_profile_diagram","v":{"s":"Diagram of the whole mission path. From Earth: launch to low Earth orbit, then the trans-lunar injection burn sends the spacecraft on a three-day coast to the Moon. Lunar orbit insertion captures it into orbit, powered descent lands the Lunar Module, ascent returns it to the Command Module, then the trans-Earth injection burn starts the coast home, ending with atmospheric entry and splashdown."}},{"k":"execute_tli_in_window","v":{"s":"Execute trans-lunar injection burn. You are inside the burn window."}},{"k":"execute_tli_early","v":{"s":"Execute trans-lunar injection burn early, outside the burn window. This will need a mid-course correction."}},{"k":"execute_tli_go","v":{"s":"🚀 Execute TLI Burn — GO"}},{"k":"burn_the_correction","v":{"s":"Burn the mid-course correction. Costs 8 percent of the descent fuel and puts you back on the nominal trajectory."}},{"k":"burn_correction_label","v":{"s":"🛠️ Burn the correction (−8% descent fuel)"}},{"k":"press_on_uncorrected","v":{"s":"Press on without correcting. Saves fuel but you arrive off the nominal path with more horizontal speed to bleed off during landing."}},{"k":"press_on_label","v":{"s":"➡️ Press on, keep the fuel"}},{"k":"retry_the_powered_descent","v":{"s":"Retry the powered descent from the start"}},{"k":"retry_landing","v":{"s":"🔄 Retry Landing"}},{"k":"turn_left_right_no_mouse_needed","v":{"s":"Turn left/right (no mouse needed)"}},{"k":"animated_trans_earth_coast_the_moon_sh","v":{"s":"Animated trans-Earth coast. The Moon shrinks behind the spacecraft while Earth grows ahead over the 3-day return. The Command Module Pilot takes a sextant star sighting to check the trajectory, and the Service Module is jettisoned before re-entry. Shows distance to Earth, closing speed, and coast time."}},{"k":"entry_corridor","v":{"s":"🎯 SET THE ENTRY CORRIDOR"}},{"k":"entry_corridor_help","v":{"s":"The flight path angle is how steeply you meet the atmosphere. The safe corridor is about two degrees wide, and you have been aiming at it since you left the Moon."}},{"k":"skip_out","v":{"s":"4° skip out"}},{"k":"corridor","v":{"s":"corridor"}},{"k":"too_steep","v":{"s":"9° too steep"}},{"k":"flight_path_angle","v":{"s":"Flight path angle: "}},{"k":"entry_flight_path_angle","v":{"s":"Entry flight path angle in degrees"}},{"k":"hypothesis_input","v":{"s":"Mission delta-v hypothesis"}},{"k":"explanation_input","v":{"s":"Mission delta-v explanation"}},{"k":"all_phases_complete","v":{"s":"All 10 phases complete"}},{"k":"anim_toggle_hint","v":{"s":"Freezes the launch, orbit, coast and re-entry animations. The landing game and the moonwalk are not affected."}},{"k":"board_or_exit_the_rover","v":{"s":"Board / exit the rover (optional — walk up to it first)"}},{"k":"burn_ei","v":{"s":"Entry Interface: where the atmosphere begins, about 122 km up"}},{"k":"burn_loi","v":{"s":"Lunar Orbit Insertion: slowing down so the Moon captures you"}},{"k":"burn_pdi","v":{"s":"Powered Descent Initiation: the lander starts its landing burn"}},{"k":"burn_tei","v":{"s":"Trans-Earth Injection: the burn that starts the trip home"}},{"k":"burn_tli","v":{"s":"Trans-Lunar Injection: the burn that leaves Earth orbit"}},{"k":"click_to_move_toggle","v":{"s":"Click-to-move: then click the ground to walk there (no keys needed)"}},{"k":"deltav_summary","v":{"s":"🛰️ Optional lab: the rocket equation — why fuel decides everything"}},{"k":"descent_touch_hint","v":{"s":"👆 No keyboard? The same three controls sit along the bottom of the flight view — hold them with a finger or the mouse."}},{"k":"eva_goal_checklist","v":{"s":"Collect at least 4 different rocks and deploy the seismometer. The cuff checklist in the HUD ticks them off, and the 🎯 bearing arrow points to the nearest rock still on the ground."}},{"k":"eva_touch_hint","v":{"s":"👆 No keyboard? Walk, turn, jump and collect from the buttons along the bottom of the surface view."}},{"k":"flight_record","v":{"s":"📝 FLIGHT RECORD — in the order you flew it"}},{"k":"gl_burn","v":{"s":"Firing an engine for a set time. Short burns steer; long burns change orbits."}},{"k":"gl_burn_term","v":{"s":"Burn"}},{"k":"gl_corridor","v":{"s":"The narrow band of entry angles, about two degrees wide, that is neither a skip-out nor a burn-up."}},{"k":"gl_corridor_term","v":{"s":"Entry corridor"}},{"k":"gl_crew","v":{"s":"Commander, Command Module Pilot, Lunar Module Pilot. Two of them land; the CMP stays in orbit alone."}},{"k":"gl_csm","v":{"s":"Command and Service Module. The CM is the cone the crew rides home in; the SM behind it carries the engine, power and oxygen and is dropped before entry."}},{"k":"gl_deltav","v":{"s":"The change in speed a burn produces. It is rocket currency: every manoeuvre costs some, and the tank only holds so much."}},{"k":"gl_ei","v":{"s":"Entry Interface: where the atmosphere effectively begins on the way home, about 122 km up."}},{"k":"gl_g","v":{"s":"How hard deceleration presses on the crew, in multiples of Earth gravity. Apollo 11 felt about 6.5 g coming home."}},{"k":"gl_g_term","v":{"s":"g (g-force)"}},{"k":"gl_gravturn","v":{"s":"Tipping the rocket over during ascent so the climb becomes sideways speed. Orbit is mostly about going sideways very fast."}},{"k":"gl_gravturn_term","v":{"s":"Gravity turn"}},{"k":"gl_hypergolic","v":{"s":"Fuel and oxidiser that ignite on contact, no spark needed. Simple and reliable, which is why the lander used it."}},{"k":"gl_hypergolic_term","v":{"s":"Hypergolic"}},{"k":"gl_lm","v":{"s":"Lunar Module, the two-part lander. The descent stage stays on the Moon as a launch pad; the ascent stage flies back up."}},{"k":"gl_loi","v":{"s":"Lunar Orbit Insertion: slowing down at the Moon so its gravity captures you instead of flinging you past."}},{"k":"gl_los","v":{"s":"Behind the Moon there is no line of sight to Earth, so the radio goes quiet until the spacecraft comes back around."}},{"k":"gl_los_term","v":{"s":"Loss of signal (LOS)"}},{"k":"gl_mare","v":{"s":"Maria are the dark plains of ancient lava; the highlands are the bright, older, heavily cratered terrain."}},{"k":"gl_mare_term","v":{"s":"Mare / highlands"}},{"k":"gl_mcc","v":{"s":"A small burn during the coast that fixes a trajectory error before it grows. Apollo flew one on nearly every leg."}},{"k":"gl_mcc_term","v":{"s":"Mid-course correction"}},{"k":"gl_met","v":{"s":"Mission Elapsed Time: the clock since launch."}},{"k":"gl_orbit","v":{"s":"Falling around a world so fast that you keep missing it. At 185 km that takes about 28,000 km/h."}},{"k":"gl_orbit_term","v":{"s":"Orbit"}},{"k":"gl_pdi","v":{"s":"Powered Descent Initiation: the moment the lander lights its engine to drop out of orbit toward the surface."}},{"k":"gl_regolith","v":{"s":"The loose, powdery surface layer of the Moon, ground up by billions of years of impacts."}},{"k":"gl_regolith_term","v":{"s":"Regolith"}},{"k":"gl_rendezvous","v":{"s":"Two spacecraft meeting in orbit by matching speed and position, then docking."}},{"k":"gl_rendezvous_term","v":{"s":"Rendezvous"}},{"k":"gl_sivb","v":{"s":"The third stage of the Saturn V. It finishes the climb to orbit, then fires again for TLI."}},{"k":"gl_tei","v":{"s":"Trans-Earth Injection: the burn that leaves lunar orbit and starts the trip home."}},{"k":"gl_tli","v":{"s":"Trans-Lunar Injection: the burn that leaves Earth orbit and starts the three-day coast to the Moon."}},{"k":"gl_window","v":{"s":"The short stretch when the spacecraft points the right way for a burn. Miss it and you need a correction later."}},{"k":"gl_window_term","v":{"s":"Burn window"}},{"k":"glossary_title","v":{"s":"📖 Mission glossary — what the words mean"}},{"k":"guided_gentle_margins","v":{"s":"Guided — gentler gravity, extra fuel and O₂, best option hinted"}},{"k":"hint_badges","v":{"s":"Achievements unlocked on this flight. All six show in the debrief."}},{"k":"hint_met","v":{"s":"Mission Elapsed Time: the clock since launch. Pause it from the header."}},{"k":"hint_morale","v":{"s":"Rises or falls with how you handle mission events."}},{"k":"hint_quiz","v":{"s":"Space knowledge check: five questions after TLI, five after TEI."}},{"k":"hint_samples","v":{"s":"Rocks bagged during the moonwalk. Four earns the geology badge."}},{"k":"hint_xp","v":{"s":"Points from good decisions, rock samples and quiz answers."}},{"k":"how_decide","v":{"s":"Decide"}},{"k":"how_decide_desc","v":{"s":"Three timing calls are graded: the TLI burn window, the mid-course correction, and the entry angle."}},{"k":"how_fly","v":{"s":"Fly"}},{"k":"how_fly_desc","v":{"s":"You land the Lunar Module by hand. Touchdown speed and fuel left go on your record."}},{"k":"how_it_works","v":{"s":"🧭 HOW THIS MISSION WORKS"}},{"k":"how_walk","v":{"s":"Walk"}},{"k":"how_walk_desc","v":{"s":"On the surface you collect rocks and deploy an instrument. Quizzes come after TLI and TEI, and the debrief grades it all."}},{"k":"how_watch","v":{"s":"Watch"}},{"k":"how_watch_desc","v":{"s":"Launch, lunar orbit, ascent and re-entry play out on their own. The banner under each one turns green when its milestone lands."}},{"k":"mission_complete_title","v":{"s":"Mission Complete"}},{"k":"mission_log_summary","v":{"s":"Mission log"}},{"k":"mission_progress_complete","v":{"s":"Mission progress: complete, all 10 phases flown"}},{"k":"mute_mission_audio","v":{"s":"Mute all mission sound"}},{"k":"pause_animation_label","v":{"s":"⏸ Pause animation"}},{"k":"pause_animations","v":{"s":"Pause the phase animations"}},{"k":"pause_clock_label","v":{"s":"⏸ Pause clock"}},{"k":"play_animation_label","v":{"s":"▶ Play animation"}},{"k":"play_animations","v":{"s":"Play the phase animations"}},{"k":"resume_clock_label","v":{"s":"▶ Resume clock"}},{"k":"sound_off_label","v":{"s":"🔇 Sound off"}},{"k":"sound_on_label","v":{"s":"🔊 Sound on"}},{"k":"sound_toggle_hint","v":{"s":"Silences the engine rumble, radio chatter, suit breathing and every alert tone."}},{"k":"task_0","v":{"s":"Pick a difficulty, look over the mission profile, then press Begin Mission."}},{"k":"task_1","v":{"s":"Watch the Saturn V climb. When the banner turns green you are in orbit — press Proceed to Orbit."}},{"k":"task_10","v":{"s":"Read your flight record — four graded calls — then fly again and beat it."}},{"k":"task_2","v":{"s":"Timing call: wait for the green burn window, then fire TLI. Firing early is allowed, but it costs a correction later."}},{"k":"task_3","v":{"s":"Answer the knowledge check, decide on the mid-course correction if one is offered, then head for lunar orbit."}},{"k":"task_4","v":{"s":"Watch one orbit: loss of signal behind the Moon, Earthrise, then undock for the descent."}},{"k":"task_5","v":{"s":"Fly the landing: W or ↑ for thrust, A/D to slide. Touch down under 3 m/s down and 5 m/s sideways."}},{"k":"task_6","v":{"s":"Walk the surface: collect 4 rocks with F, deploy the seismometer, then End EVA."}},{"k":"task_7","v":{"s":"Watch the ascent and docking, then fire the TEI burn to head home."}},{"k":"task_8","v":{"s":"Answer the second knowledge check, set the entry angle inside the corridor, then begin re-entry."}},{"k":"task_9","v":{"s":"Watch the entry and splashdown, then complete the mission."}},{"k":"unmute_mission_audio","v":{"s":"Turn mission sound back on"}},{"k":"your_job_now","v":{"s":"Your job now: "}}],"id":551}},{"k":"mult_table","v":{"o":[{"k":"value","v":{"s":"Value..."}},{"k":"label_optional","v":{"s":"Label (optional)"}}],"id":552}},{"k":"multtable","v":{"o":[{"k":"easy","v":{"s":"Easy"}},{"k":"medium","v":{"s":"Medium"}},{"k":"hard","v":{"s":"Hard"}},{"k":"adaptive","v":{"s":"Adaptive"}},{"k":"tricky_15","v":{"s":"Tricky 15"}},{"k":"rows_a","v":{"s":"Rows (a)"}},{"k":"factor_a_rows","v":{"s":"Factor a (rows)"}},{"k":"columns_b","v":{"s":"Columns (b)"}},{"k":"factor_b_columns","v":{"s":"Factor b (columns)"}},{"k":"skip_count_overlay_column_of_running_t","v":{"s":"Skip-count overlay (column of running totals)"}},{"k":"swap_factors_commutativity","v":{"s":"Swap factors (commutativity)"}},{"k":"swap_commutativity","v":{"s":"⇄ Swap (commutativity)"}},{"k":"repeated_addition","v":{"s":"➕ Repeated addition"}},{"k":"commutativity_twin","v":{"s":"⇄ Commutativity twin"}},{"k":"same_dots_just_turned_sideways_learn_o","v":{"s":"Same dots, just turned sideways. Learn one fact, know two."}},{"k":"this_is_one_of_the_tricky_15_facts_the","v":{"s":"This is one of the Tricky 15 facts — the small set that needs real recall. Switch to Practice → \"Tricky 15\" mode to drill it."}},{"k":"fact_family_multiplication_division","v":{"s":"👨‍👩‍👧 Fact family — multiplication ↔ division"}},{"k":"same_numbers_four_faces_knowing_one_fa","v":{"s":"Same numbers, four faces. Knowing one fact gives you the others."}},{"k":"tricky_facts_to_visualize","v":{"s":"Tricky facts to visualize:"}},{"k":"5s_end_in_0_or_5","v":{"s":"5s end in 0 or 5"}},{"k":"9s_digits_sum_to_9","v":{"s":"9s digits sum to 9"}},{"k":"perfect_squares","v":{"s":"Perfect squares"}},{"k":"doubles_2","v":{"s":"Doubles (×2)"}},{"k":"10_adds_a_zero","v":{"s":"×10 adds a zero"}},{"k":"11s_repeat_the_digit_1_9","v":{"s":"11s repeat the digit (×1-9)"}},{"k":"7s_5s_2s_distributive","v":{"s":"7s = 5s + 2s (distributive)"}},{"k":"pick_a_pattern_to_highlight_the_table_","v":{"s":"🔍 Pick a pattern to highlight. The table is full of structure — once you see it, half the facts become predictable."}},{"k":"multiplication_table_with_pattern_high","v":{"s":"Multiplication table with pattern highlighting"}},{"k":"click_any_pattern_above_to_light_up_th","v":{"s":"👆 Click any pattern above to light up the cells and read the rule. Multiple patterns may overlap (e.g., 5×5 is both a \"5s multiple\" and a \"perfect square\")."}},{"k":"why_patterns_beat_brute_memorization","v":{"s":"💡 Why patterns beat brute memorization"}},{"k":"you_only_need_to_memorize_about_a_thir","v":{"s":"You only need to memorize about a third of the table. "}},{"k":"anything_in_the_1s_2s_5s_10s_11s_colum","v":{"s":"Anything in the 1s, 2s, 5s, 10s, 11s columns has an easy rule. The squares are a small set (12 facts). What remains is the \"tricky middle\" — about 15 facts — that needs real recall: 6×7, 6×8, 6×9, 7×8, 7×9, 8×9 and their twins."}},{"k":"distributive_shortcut_for_the_tricky_m","v":{"s":"Distributive shortcut for the tricky middle. "}},{"k":"forget_7_8_7_8_5_8_2_8_40_16_56_build_","v":{"s":"Forget 7×8? 7×8 = 5×8 + 2×8 = 40 + 16 = 56. Build the hard fact from two easy ones. After enough repetitions, the answer becomes automatic."}},{"k":"for_dyscalculia_specifically","v":{"s":"For dyscalculia specifically: "}},{"k":"visualizing_each_fact_as_an_area_model","v":{"s":"Visualizing each fact as an area-model rectangle (Visual tab) or a pattern (this tab) gives you a path to the answer that does not require automatic recall. Recall builds eventually, but not from drilling alone."}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"multiplication_table","v":{"s":"🔢 Multiplication Table"}},{"k":"toggle_hidden_mode_h","v":{"s":"Toggle hidden mode (H)"}},{"k":"toggle_hidden_mode_h_2","v":{"s":"Toggle hidden mode (H)"}},{"k":"view_badges_b","v":{"s":"View badges (B)"}},{"k":"view_badges_b_2","v":{"s":"View badges (B)"}},{"k":"ai_tutor","v":{"s":"AI Tutor (?)"}},{"k":"ai","v":{"s":"🧠 AI"}},{"k":"reset","v":{"s":"Reset"}},{"k":"reset_all","v":{"s":"Reset all"}},{"k":"reset_2","v":{"s":"↺ Reset"}},{"k":"multiplication_table_sections","v":{"s":"Multiplication Table sections"}},{"k":"practice","v":{"s":"Practice"}},{"k":"visual","v":{"s":"Visual"}},{"k":"patterns","v":{"s":"Patterns"}},{"k":"ai_math_tutor","v":{"s":"🧠 AI Math Tutor"}},{"k":"ask_again","v":{"s":"Ask Again"}},{"k":"ask_again_2","v":{"s":"🔄 Ask Again"}},{"k":"multiplication","v":{"s":"Multiplication"}},{"k":"division","v":{"s":"Division"}},{"k":"mixed","v":{"s":"Mixed"}},{"k":"stop","v":{"s":"Stop"}},{"k":"stop_2","v":{"s":"Stop"}},{"k":"practice_these","v":{"s":"Practice These"}},{"k":"practice_these_2","v":{"s":"🎯 Practice these"}},{"k":"try_again","v":{"s":"Try Again"}},{"k":"try_again_2","v":{"s":"🔄 Try again"}},{"k":"clear_mastery_data","v":{"s":"Clear mastery data"}},{"k":"each_cell_a_multiplication_fact_color_","v":{"s":"Each cell = a multiplication fact. Color = your mastery so far. Click any cell to drill that exact fact."}},{"k":"mastery_heatmap","v":{"s":"Mastery heatmap"}},{"k":"12_by_12_multiplication_table","v":{"s":"12 by 12 multiplication table"}},{"k":"quick_quiz","v":{"s":"Quick Quiz"}},{"k":"quick_quiz_q","v":{"s":"Quick Quiz (Q)"}},{"k":"quick_quiz_2","v":{"s":"🎯 Quick Quiz"}},{"k":"speed_run_2min","v":{"s":"Speed Run (2min)"}},{"k":"speed_run_s","v":{"s":"Speed Run (S)"}},{"k":"speed_run_2min_2","v":{"s":"⏱️ Speed Run (2min)"}},{"k":"reset_3","v":{"s":"Reset"}},{"k":"reset_4","v":{"s":"↺ Reset"}},{"k":"check","v":{"s":"Check"}},{"k":"check_2","v":{"s":"✔ Check"}},{"k":"get_a_hint_from_ai","v":{"s":"Get a hint from AI"}},{"k":"fact_family_same_numbers_four_faces","v":{"s":"👨‍👩‍👧 Fact family — same numbers, four faces"}},{"k":"next_question_coming","v":{"s":"Next question coming..."}},{"k":"skip_next","v":{"s":"Skip Next"}},{"k":"skip_next_2","v":{"s":"Skip → Next"}},{"k":"q_quiz","v":{"s":"Q Quiz"}},{"k":"s_speed","v":{"s":"S Speed"}},{"k":"h_hidden","v":{"s":"H Hidden"}},{"k":"b_badges","v":{"s":"B Badges"}},{"k":"ai_tutor_2","v":{"s":"? AI Tutor"}},{"k":"perfect_squares_2","v":{"s":" Perfect squares"}},{"k":"hover_cross","v":{"s":" Hover cross"}},{"k":"selected","v":{"s":" Selected"}},{"k":"correct_answer","v":{"s":" Correct answer"}},{"k":"struggling_60","v":{"s":"🔴 Struggling (<60%)"}},{"k":"fact_mastery_discovery","v":{"s":"🎯 Fact mastery discovery"}},{"k":"sliders_for_mastery_threshold_and_sele","v":{"s":"Sliders for mastery threshold and selected factor. Discrete 3-state outcome. No score, no reveal."}},{"k":"log","v":{"s":"📋 Log"}},{"k":"reset_5","v":{"s":"↺ Reset"}},{"k":"hypothesis_how_does_threshold_change_f","v":{"s":"Hypothesis: How does threshold change feedback for struggling learners?"}},{"k":"stuck_show_open_prompts","v":{"s":"🤔 Stuck — show open prompts"}},{"k":"what_if_mastery_100_what_gets_praised","v":{"s":"What if mastery = 100%? What gets praised?"}},{"k":"how_does_color_coding_affect_motivatio","v":{"s":"How does color-coding affect motivation?"}},{"k":"i_understand_explain_in_own_words","v":{"s":"I understand — explain in own words"}},{"k":"explain_mastery_learning_thresholds","v":{"s":"Explain mastery learning thresholds."}},{"k":"design_note_discrete_3_state_mastery_m","v":{"s":"Design note: discrete 3-state mastery marker; no raw score; no reveal — by design."}},{"k":"resume_speed_run","v":{"s":"Resume Speed Run"}},{"k":"pause_speed_run","v":{"s":"Pause Speed Run"}},{"k":"resume","v":{"s":"▶ Resume"}},{"k":"pause","v":{"s":"⏸ Pause"}},{"k":"answer","v":{"s":"Multiplication or division answer"}},{"k":"mastery_hypothesis","v":{"s":"Mastery threshold hypothesis"}},{"k":"mastery_explanation","v":{"s":"Explain mastery learning thresholds"}},{"k":"learning_steps","v":{"s":"Learning steps"}},{"k":"focus_one_fact","v":{"s":"Explore one fact"}},{"k":"focus_fact_prompt","v":{"s":"Choose two factors, then build an array and connect the related facts."}},{"k":"factor_one","v":{"s":"First factor"}},{"k":"factor_two","v":{"s":"Second factor"}},{"k":"build_fact","v":{"s":"Build this fact"}},{"k":"open_full_table","v":{"s":"Full multiplication table"}},{"k":"teacher_data_activity","v":{"s":"Teacher activity: explore a hypothetical mastery threshold"}},{"k":"simulation_notice","v":{"s":"This is simulated data, not your practice results. Use the mastery heatmap above to review answers you have actually given."}},{"k":"threshold_reflection","v":{"s":"How does changing the threshold change the support you would offer? A label alone cannot explain a learner’s understanding."}},{"k":"read_feedback_first","v":{"s":"Take time to read the feedback. Continue when you are ready."}},{"k":"next_when_ready","v":{"s":"Next question"}},{"k":"build_fact_strategy","v":{"s":"Build this fact from smaller facts"}},{"k":"division_strategy_reason","v":{"s":"Use the related multiplication fact to check the division. Each row is one equal group."}},{"k":"split_strategy_reason","v":{"s":"Split the rows into two groups. Multiply each group, then add the parts. The total number of dots stays the same."}},{"k":"choose_row_split","v":{"s":"Choose a row split"}},{"k":"rows_label","v":{"s":"rows"}},{"k":"strategy_array_scroll","v":{"s":"Scrollable strategy dot array"}},{"k":"dots_each_row","v":{"s":"in each row"}},{"k":"strategy_reflect","v":{"s":"Which smaller fact did you know already? Try another split and explain why the total stays the same."}},{"k":"nav_arrays_groups","v":{"s":"Arrays & groups"}},{"k":"hide_table_answers","v":{"s":"Hide table answers"}},{"k":"table_answers_hidden","v":{"s":"Table answers hidden"}},{"k":"table_answers_visible","v":{"s":"Table answers visible"}},{"k":"ai_tutor_button","v":{"s":"AI Tutor"}}],"id":553}},{"k":"music","v":{"o":[{"k":"a11y_mod_ratio","v":{"s":"Mod Ratio"}},{"k":"edm_lead","v":{"s":"EDM Lead"}},{"k":"big_festival_supersaw_lead","v":{"s":"Big festival supersaw lead"}},{"k":"fm_bell","v":{"s":"FM Bell"}},{"k":"metallic_fm_bell_tone","v":{"s":"Metallic FM bell tone"}},{"k":"fm_bass","v":{"s":"FM Bass"}},{"k":"punchy_fm_bass","v":{"s":"Punchy FM bass"}},{"k":"sub_bass","v":{"s":"Sub Bass"}},{"k":"deep_808_style_sub_bass","v":{"s":"Deep 808-style sub bass"}},{"k":"warm_pad","v":{"s":"Warm Pad"}},{"k":"lush_ambient_pad","v":{"s":"Lush ambient pad"}},{"k":"pluck","v":{"s":"Pluck"}},{"k":"karplus_strong_plucked_string","v":{"s":"Karplus-Strong plucked string"}},{"k":"acid","v":{"s":"Acid"}},{"k":"tb_303_acid_squelch","v":{"s":"TB-303 acid squelch"}},{"k":"trance","v":{"s":"Trance"}},{"k":"classic_trance_supersaw","v":{"s":"Classic trance supersaw"}},{"k":"dubstep","v":{"s":"Dubstep"}},{"k":"growling_dubstep_bass","v":{"s":"Growling dubstep bass"}},{"k":"warm_lo_fi_keys","v":{"s":"Warm lo-fi keys"}},{"k":"barry_harris_1929_2021_codified_bebop_","v":{"s":"Barry Harris (1929-2021) codified bebop harmony. His system uses 6th chords instead of 7ths and adds diminished passing chords between scale degrees for smooth voice leading."}},{"k":"ii_v_i_jazz","v":{"s":"ii-V-I (Jazz)"}},{"k":"12_bar_blues","v":{"s":"12-Bar Blues"}},{"k":"vi_iv_i_v_emo_alt","v":{"s":"vi-IV-I-V (Emo/Alt)"}},{"k":"1st_overtone","v":{"s":"1st Overtone"}},{"k":"2nd_overtone","v":{"s":"2nd Overtone"}},{"k":"3rd_overtone","v":{"s":"3rd Overtone"}},{"k":"4th_overtone","v":{"s":"4th Overtone"}},{"k":"5th_overtone","v":{"s":"5th Overtone"}},{"k":"6th_overtone","v":{"s":"6th Overtone"}},{"k":"7th_overtone","v":{"s":"7th Overtone"}},{"k":"attack_time_to_reach_full_volume_decay","v":{"s":"Attack: time to reach full volume. Decay: time to fall to sustain. Sustain: held volume level. Release: fade-out time after key release."}},{"k":"a_scale_is_an_ordered_set_of_pitches_m","v":{"s":"A scale is an ordered set of pitches. Modes are rotations of the scale starting on different degrees. Each creates a different emotional mood."}},{"k":"chords_are_built_by_stacking_intervals","v":{"s":"Chords are built by stacking intervals (3rds). Major uses a major 3rd + minor 3rd. Minor reverses them. Extended chords add 7ths, 9ths, and beyond."}},{"k":"kicks_use_a_sine_oscillator_with_a_pit","v":{"s":"Kicks use a sine oscillator with a pitch sweep. Snares combine noise (filtered) + tone body. Hi-hats use high-pass filtered noise bursts."}},{"k":"4_4_4_quarter_note_beats_per_bar_most_","v":{"s":"4/4 = 4 quarter-note beats per bar (most common). 3/4 = waltz feel. 6/8 = compound duple. 5/4 and 7/8 create asymmetric, exotic grooves."}},{"k":"keys_arranged_by_ascending_5ths_clockw","v":{"s":"Keys arranged by ascending 5ths clockwise. Adjacent keys share 6 of 7 notes. Moving clockwise adds sharps; counter-clockwise adds flats."}},{"k":"every_musical_sound_contains_overtones","v":{"s":"Every musical sound contains overtones above the fundamental. Their relative strengths determine timbre — why a trumpet sounds different from a flute at the same pitch."}},{"k":"an_interval_is_the_distance_between_tw","v":{"s":"An interval is the distance between two pitches, measured in semitones. The frequency ratio determines consonance (simple ratios like 3:2 sound smooth)."}},{"k":"plays_chord_notes_one_at_a_time_in_seq","v":{"s":"Plays chord notes one at a time in sequence. Up = low to high, Down = high to low. Creates flowing patterns from static chords."}},{"k":"a_filter_removes_frequencies_above_low","v":{"s":"A filter removes frequencies above (lowpass), below (highpass), or around (bandpass) a cutoff frequency. Resonance (Q) amplifies frequencies near cutoff, creating a peak."}},{"k":"tremolo_periodic_volume_changes_amplit","v":{"s":"Tremolo: periodic volume changes (amplitude modulation). Vibrato: periodic pitch changes (frequency modulation). Both controlled by an LFO (Low Frequency Oscillator)."}},{"k":"discovered_in_1983_a_noise_burst_feeds","v":{"s":"Discovered in 1983. A noise burst feeds into a very short delay line with feedback. The delay time determines pitch. A filter in the feedback loop controls brightness and decay. Naturally simulates plucked strings."}},{"k":"the_sequencer_is_a_composition_tool_ea","v":{"s":"The sequencer is a composition tool. Each step represents a beat subdivision. The melody row sets pitched notes, drums add rhythm. Musical notation shows what you create."}},{"k":"notes_on_lines_and_spaces_represent_pi","v":{"s":"Notes on lines and spaces represent pitches. Duration is shown by note shape: whole (○), half (𝅗𝅥), quarter (♩), eighth (♪). The staff uses 5 lines."}},{"k":"kick","v":{"s":"Kick"}},{"k":"snare","v":{"s":"Snare"}},{"k":"clap","v":{"s":"Clap"}},{"k":"ch_hat","v":{"s":"CH Hat"}},{"k":"oh_hat","v":{"s":"OH Hat"}},{"k":"cymbal","v":{"s":"Cymbal"}},{"k":"tom_hi","v":{"s":"Tom Hi"}},{"k":"tom_lo","v":{"s":"Tom Lo"}},{"k":"cowbell","v":{"s":"Cowbell"}},{"k":"clave","v":{"s":"Clave"}},{"k":"shaker","v":{"s":"Shaker"}},{"k":"all_notes","v":{"s":"All Notes"}},{"k":"major","v":{"s":"Major"}},{"k":"minor","v":{"s":"Minor"}},{"k":"pentatonic","v":{"s":"Pentatonic"}},{"k":"blues","v":{"s":"Blues"}},{"k":"dorian","v":{"s":"Dorian"}},{"k":"mixolydian","v":{"s":"Mixolydian"}},{"k":"rock_beat","v":{"s":"Rock Beat"}},{"k":"quarter_notes_on_the_beat","v":{"s":"Quarter notes on the beat"}},{"k":"backbeat","v":{"s":"Backbeat"}},{"k":"snare_on_2_and_4","v":{"s":"Snare on 2 and 4"}},{"k":"syncopation","v":{"s":"Syncopation"}},{"k":"off_beat_accents","v":{"s":"Off-beat accents"}},{"k":"16th_notes","v":{"s":"16th Notes"}},{"k":"every_subdivision","v":{"s":"Every subdivision"}},{"k":"swing_feel","v":{"s":"Swing Feel"}},{"k":"triplet_style_groove","v":{"s":"Triplet-style groove"}},{"k":"reggae_one_drop","v":{"s":"Reggae One-Drop"}},{"k":"accent_only_on_beat_3","v":{"s":"Accent only on beat 3"}},{"k":"try_to_match_this_pattern","v":{"s":"Try to match this pattern!"}},{"k":"breakbeat","v":{"s":"Breakbeat"}},{"k":"trap_hi_hats","v":{"s":"Trap Hi-Hats"}},{"k":"house","v":{"s":"House"}},{"k":"reggaeton","v":{"s":"Reggaeton"}},{"k":"cr_78_vintage","v":{"s":"CR-78 Vintage"}},{"k":"acoustic_kit","v":{"s":"Acoustic Kit"}},{"k":"techno_edm","v":{"s":"Techno EDM"}},{"k":"fm_synthesis","v":{"s":"FM Synthesis"}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"music_synthesizer","v":{"s":"🎹 Music Synthesizer"}},{"k":"timbre","v":{"s":"Timbre"}},{"k":"wave","v":{"s":"∿ Wave"}},{"k":"super","v":{"s":"⚡ Super"}},{"k":"fm","v":{"s":"🌟 FM"}},{"k":"sub","v":{"s":"🌊 Sub"}},{"k":"pad","v":{"s":"☁ Pad"}},{"k":"pluck_2","v":{"s":"🎸 Pluck"}},{"k":"toggle_frequency_spectrum","v":{"s":"Toggle frequency spectrum"}},{"k":"toggle_frequency_spectrum_2","v":{"s":"Toggle frequency spectrum"}},{"k":"play_piano_keys_presets","v":{"s":"Play — piano keys + presets"}},{"k":"equal_temperament_12_notes_per_octave_","v":{"s":"Equal temperament: 12 notes per octave, ratio 2^(1/12). A4 = 440 Hz; A5 = 880 Hz. Bach’s Well-Tempered Clavier (1722) sold the world on this compromise. Every note you play here lives on that grid."}},{"k":"scales_the_major_minor_modal_grammar","v":{"s":"Scales — the major + minor + modal grammar"}},{"k":"major_w_w_h_w_w_w_h_minor_w_h_w_w_h_w_","v":{"s":"Major: W-W-H-W-W-W-H. Minor: W-H-W-W-H-W-W. The 7 modes (Ionian, Dorian, Phrygian, Lydian, Mixolydian, Aeolian, Locrian) come from rotating the major-scale interval pattern."}},{"k":"chords_stacked_thirds_inversions","v":{"s":"Chords — stacked thirds + inversions"}},{"k":"triads_root_third_fifth_major_4_3_semi","v":{"s":"Triads: root + third + fifth. Major (4+3 semitones), minor (3+4), diminished (3+3), augmented (4+4). 7th chords add another third. Pop music = ~6 chords on repeat; jazz uses extensions and substitutions."}},{"k":"harmony_pad_voiced_pads_drones","v":{"s":"Harmony Pad — voiced pads + drones"}},{"k":"sustained_chord_textures_the_bed_under","v":{"s":"Sustained chord textures — the bed under almost every cinematic score. Try iv-V-i in minor, or i-VI-VII for that Hans Zimmer feel. Drones in fifths underpin Indian classical and bagpipe traditions."}},{"k":"beat_pad_sample_based_drums","v":{"s":"Beat Pad — sample-based drums"}},{"k":"most_popular_music_sits_at_4_4_90_130_","v":{"s":"Most popular music sits at 4/4, 90-130 BPM. Hip-hop ~85-95, house 120-130, drum-and-bass ~170 (half-time feel). The kick on 1+3, snare on 2+4 = backbeat — the foundation of rock + pop."}},{"k":"theory_the_math_behind_the_sound","v":{"s":"Theory — the math behind the sound"}},{"k":"pythagoras_500_bce_discovered_consonan","v":{"s":"Pythagoras (~500 BCE) discovered consonance from integer frequency ratios: octave 2:1, fifth 3:2, fourth 4:3. Helmholtz extended this in 1862. Sound = compression waves; music = patterns we agree to call beautiful."}},{"k":"apply_preset","v":{"s":"Apply Preset"}},{"k":"root","v":{"s":"Root"}},{"k":"root_note","v":{"s":"Root note"}},{"k":"musical_scale","v":{"s":"Musical scale"}},{"k":"synth","v":{"s":"∿ Synth"}},{"k":"plucked","v":{"s":"🎸 Plucked"}},{"k":"chords","v":{"s":"Chords"}},{"k":"chord_root_note","v":{"s":"Chord root note"}},{"k":"jazz_mode","v":{"s":"Jazz Mode"}},{"k":"jazz_mode_2","v":{"s":"🎷 Jazz Mode"}},{"k":"strum_chord_pad","v":{"s":"Strum & Chord Pad"}},{"k":"full_chord_grid_strum_plate_and_voice_","v":{"s":"Full chord grid, strum plate, and voice presets"}},{"k":"open_harmonypad","v":{"s":"🌟 Open HarmonyPad →"}},{"k":"strum_harp","v":{"s":"🎸 Strum Harp"}},{"k":"drag_across_strings_to_strum","v":{"s":"Drag across strings to strum!"}},{"k":"fm_synthesis_controls","v":{"s":"🌟 FM Synthesis Controls"}},{"k":"fm_synthesis_2","v":{"s":"FM Synthesis"}},{"k":"frequency_modulation_fm_synthesis_uses","v":{"s":"Frequency Modulation (FM) synthesis uses one oscillator (modulator) to rapidly change the frequency of another (carrier). The modulator:carrier ratio determines the harmonic content. Simple ratios (1:1, 2:1, 3:1) produce harmonic tones. Complex ratios produce metallic, bell-like, or inharmonic sounds. FM was popularized by the Yamaha DX7 in 1983."}},{"k":"bright","v":{"s":"Bright"}},{"k":"pure","v":{"s":"Pure"}},{"k":"metallic","v":{"s":"Metallic"}},{"k":"supersaw_controls","v":{"s":"⚡ SuperSaw Controls"}},{"k":"supersaw_unison","v":{"s":"SuperSaw / Unison"}},{"k":"supersaw_stacks_multiple_sawtooth_osci","v":{"s":"SuperSaw stacks multiple sawtooth oscillators slightly detuned from each other. This creates a huge, wide, shimmering sound — the signature of EDM, trance, and modern pop. More voices = thicker sound but uses more CPU. Detuning controls how far apart the voices are tuned — more detune = wider/more chorus-like, less = tighter/more focused."}},{"k":"thin_2","v":{"s":"Thin (2)"}},{"k":"massive_9","v":{"s":"Massive (9)"}},{"k":"tight","v":{"s":"Tight"}},{"k":"wide","v":{"s":"Wide"}},{"k":"adsr_envelope","v":{"s":"📈 ADSR Envelope"}},{"k":"effects","v":{"s":"⚙️ Effects"}},{"k":"karplus_strong","v":{"s":"🎸 Karplus-Strong"}},{"k":"volume","v":{"s":"🔊 Volume"}},{"k":"reverb","v":{"s":"🏛 Reverb"}},{"k":"filter","v":{"s":"🌊 Filter"}},{"k":"filter_type","v":{"s":"Filter type"}},{"k":"modulation","v":{"s":"✨ Modulation"}},{"k":"chord_progressions","v":{"s":"🎶 Chord Progressions"}},{"k":"play_progression","v":{"s":"Play Progression"}},{"k":"arpeggiator","v":{"s":"🌀 Arpeggiator"}},{"k":"pattern","v":{"s":"Pattern"}},{"k":"pattern_2","v":{"s":"Pattern"}},{"k":"rate","v":{"s":"Rate"}},{"k":"gate","v":{"s":"Gate"}},{"k":"an_arpeggiator_plays_the_notes_of_a_ch","v":{"s":"🔬 An arpeggiator plays the notes of a chord one at a time in sequence. \"Up\" goes low to high, creating ascending energy. \"Down\" descends for a cascading feel. Rate controls speed (lower = faster). Gate controls how long each note rings (100% = legato, 10% = staccato). Try rate=100ms + 4 octaves + up pattern for a classic trance arp!"}},{"k":"live_mic_effects_lab","v":{"s":"🎤 Live Mic Effects Lab"}},{"k":"sing_speak_or_play_an_instrument_hear_","v":{"s":"Sing, speak, or play an instrument — hear effects in real-time!"}},{"k":"monitor_hear_yourself_use_headphones","v":{"s":"🔊 Monitor (hear yourself — use headphones!)"}},{"k":"how_effects_change_sound_waves","v":{"s":"🔬 How Effects Change Sound Waves"}},{"k":"filter_cutoff","v":{"s":"Filter (Cutoff)"}},{"k":"removes_frequencies_above_lowpass_or_b","v":{"s":"Removes frequencies above (lowpass) or below (highpass) a threshold. Like cupping your hand over your mouth — it removes high frequencies, making sound \"darker.\""}},{"k":"delay","v":{"s":"Delay"}},{"k":"creates_echoes_by_copying_the_signal_a","v":{"s":"Creates echoes by copying the signal and playing it back after a short time. Feedback controls how many echoes repeat."}},{"k":"reverb_2","v":{"s":"Reverb"}},{"k":"simulates_room_acoustics_by_creating_t","v":{"s":"Simulates room acoustics by creating thousands of tiny echoes that blend together. Small room = short reverb, cathedral = long reverb."}},{"k":"distortion","v":{"s":"Distortion"}},{"k":"clips_the_waveform_peaks_turning_smoot","v":{"s":"Clips the waveform peaks, turning smooth sine waves into harsh, angular shapes. This adds new harmonics that weren't in the original sound."}},{"k":"chorus","v":{"s":"Chorus"}},{"k":"duplicates_the_signal_with_a_slight_co","v":{"s":"Duplicates the signal with a slight, continuously varying delay. This simulates multiple voices/instruments playing together slightly out of time."}},{"k":"tremolo","v":{"s":"Tremolo"}},{"k":"rapidly_varies_the_volume_up_and_down_","v":{"s":"Rapidly varies the volume up and down, creating a pulsating effect. Common in surf guitar and organ music."}},{"k":"use_headphones_when_monitoring_to_avoi","v":{"s":"Use headphones when monitoring to avoid feedback loops! The mic routes through all the effects above (filter, delay, reverb, etc.) — adjust them to hear how each one transforms your voice or instrument."}},{"k":"connect_your_microphone_to_run_your_vo","v":{"s":"Connect your microphone to run your voice or instrument through the effects chain in real-time."}},{"k":"see_your_voice_as_a_waveform_frequency","v":{"s":"See your voice as a waveform + frequency spectrum. Hear how filter, delay, reverb, distortion, and chorus physically change sound waves."}},{"k":"xy_performance_pad","v":{"s":"🎯 XY Performance Pad"}},{"k":"touch_drag_x_pitch_y_filter_effect","v":{"s":"Touch & drag — X = pitch, Y = filter/effect"}},{"k":"xy_pad_performance","v":{"s":"XY Pad Performance"}},{"k":"the_xy_pad_maps_your_finger_mouse_posi","v":{"s":"The XY pad maps your finger/mouse position to musical parameters in real-time. The X axis controls pitch (left = low, right = high). The Y axis controls the filter cutoff frequency (top = bright, bottom = dark). This is similar to instruments like the Korg Kaoss Pad, which revolutionized live electronic music performance by turning 2D gestures into sound."}},{"k":"xy_performance_pad_left_right_is_pitch","v":{"s":"XY performance pad. Left–right is pitch, up–down is filter brightness. Use the arrow keys to move and play a note; press Escape or Space to stop."}},{"k":"low","v":{"s":"← LOW"}},{"k":"high","v":{"s":"HIGH →"}},{"k":"bright_2","v":{"s":"↑ BRIGHT"}},{"k":"dark","v":{"s":"↓ DARK"}},{"k":"chromatic","v":{"s":"Chromatic"}},{"k":"major_2","v":{"s":"Major"}},{"k":"minor_2","v":{"s":"Minor"}},{"k":"pentatonic_2","v":{"s":"Pentatonic"}},{"k":"blues_2","v":{"s":"Blues"}},{"k":"production_studio","v":{"s":"Production Studio"}},{"k":"sequencer_drum_pads_notation_samples_m","v":{"s":"Sequencer, drum pads, notation, samples & more →"}},{"k":"scales_modes","v":{"s":"🎵 Scales & Modes"}},{"k":"play_ascending","v":{"s":"Play Ascending"}},{"k":"play_ascending_2","v":{"s":"▶ Play Ascending"}},{"k":"descending","v":{"s":"Descending"}},{"k":"descending_2","v":{"s":"▼ Descending"}},{"k":"tags_between_notes","v":{"s":"Tags between notes: "}},{"k":"whole_step","v":{"s":" = whole step · "}},{"k":"half_step","v":{"s":" = half step · "}},{"k":"augmented_2nd","v":{"s":" = augmented 2nd"}},{"k":"the_science","v":{"s":"🔬 The Science"}},{"k":"waveform_science","v":{"s":"∿ Waveform Science"}},{"k":"chord_explorer","v":{"s":"🎶 Chord Explorer"}},{"k":"jazz_mode_3","v":{"s":"Jazz Mode"}},{"k":"jazz_mode_4","v":{"s":"🎷 Jazz Mode"}},{"k":"inversion","v":{"s":"Inversion"}},{"k":"inversion_2","v":{"s":"Inversion"}},{"k":"strum_chord","v":{"s":"Strum chord"}},{"k":"strum_chord_2","v":{"s":"Strum chord"}},{"k":"strum","v":{"s":"🎸 Strum"}},{"k":"chord_progressions_2","v":{"s":"🎶 Chord Progressions"}},{"k":"play_progression_2","v":{"s":"Play Progression"}},{"k":"circle_of_fifths","v":{"s":"⭕ Circle of Fifths"}},{"k":"barry_harris_harmony","v":{"s":"🎷 Barry Harris Harmony"}},{"k":"major_6th_diminished_scale","v":{"s":"Major 6th Diminished Scale"}},{"k":"minor_6th_diminished_scale","v":{"s":"Minor 6th Diminished Scale"}},{"k":"minor_6th_diminished_scale_2","v":{"s":"Minor 6th Diminished Scale"}},{"k":"play_chord","v":{"s":"Play Chord"}},{"k":"production_studio_2","v":{"s":"🥁 Product