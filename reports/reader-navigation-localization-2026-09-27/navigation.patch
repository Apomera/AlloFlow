@@ -0,0 +1,25 @@
+import { readFileSync } from 'node:fs';
+import { fixtures, contentFor, contract, translator, mountReader, act, click } from './reader_locale_harness.js';
+import { setupRecoveryReader, prepareRecoveryCase, cleanupRecoveryCase } from './reader_recovery_locale_harness.js';
+export { setupRecoveryReader, prepareRecoveryCase, cleanupRecoveryCase, translator, mountReader, act, click };
+export const navigationFixtures = JSON.parse(readFileSync('tests/fixtures/reader_navigation_locales.json', 'utf8')).map(f => ({ ...fixtures.find(base => base.id === f.baseFixture), ...f }));
+export function preparedReading(fixture, { shown = true, stale = false } = {}) {
+  const item = contentFor(fixture), start = item.data.indexOf(fixture.quote, item.data.indexOf('\n\n') + 2);
+  if (start < 0) throw Error('Fixture word not found');
+  const help = contract.upsertAdaptedReadingSupport(item, null, { id: fixture.id + '-help', start, end: start + fixture.quote.length, quote: fixture.quote, text: fixture.explanation });
+  item.adaptedReadingSupports = contract.setAdaptedReadingSupportsShown(item, help, shown);
+  if (stale) item.data = item.data.slice(0, start) + 'Changed term' + item.data.slice(start + fixture.quote.length);
+  return item;
+}
+export function mountPrepared(fixture, extra = {}) {
+  return mountReader(fixture, { generatedContent: preparedReading(fixture), isTeacherMode: false, interactionMode: 'define', ...extra });
+}
+export async function openPreparedCard(fixture, extra = {}) {
+  const view = mountPrepared(fixture, extra), opener = view.host.querySelector('[data-prepared-word-help]');
+  if (!opener) throw Error('Expected a prepared-help occurrence');
+  act(() => opener.focus());
+  await click(opener);
+  const card = view.host.querySelector('[data-word-help-card]');
+  if (!card) throw Error('Expected the prepared-help card');
+  return { ...view, opener, card };
+}
