const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict'),{spawnSync}=require('node:child_process');
const work=__dirname,repo='C:/Users/cabba/OneDrive/Desktop/UDL-Tool-Updated',dir=path.join(work,'raw-baseline-comparison'),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const baseline=fs.readFileSync(path.join(work,'before.js')),candidate=fs.readFileSync(path.join(work,'candidate.js')),fixture='tests/firstresponse_hand_surface.test.js',vendor='vendor/three-r128/three.min.js';
const baselineSHA256=sha(baseline),candidateSHA256=sha(candidate);assert.equal(baselineSHA256,'69d2407c26ddf3e3c5d7ee112622d0dab8613926e34b7d61af9f2e17f1317242');assert.equal(candidateSHA256,'38660be59270be0b42e34649f7c7ef62f91a804671d3469631b48b5292a35be4');
const currentFile=path.join(work,'raw-wrist-tests/candidate-results.json'),currentBytes=fs.readFileSync(currentFile),rawSummary=JSON.parse(fs.readFileSync(path.join(work,'raw-wrist-tests/summary.json')));
assert.equal(rawSummary.numPassedTests,53);assert.equal(rawSummary.numFailedTests,3);assert.equal(rawSummary.sourceSHA256,candidateSHA256);
assert.ok(!fs.existsSync(dir),'Preserve previous baseline comparison');fs.mkdirSync(dir);
const fixtureBytes=fs.readFileSync(path.join(repo,fixture)),vendorBytes=fs.readFileSync(path.join(repo,vendor));assert.equal(sha(fixtureBytes),rawSummary.testHashes[fixture]);assert.equal(sha(vendorBytes),rawSummary.vendorSHA256);
for(const[file,bytes]of [['stem_lab/stem_tool_firstresponse.js',baseline],[fixture,fixtureBytes],[vendor,vendorBytes]]){const p=path.join(dir,file);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,bytes);}
const resultPath=path.join(dir,'baseline-results.json'),configPath=path.join(dir,'vitest.config.cjs'),pattern='mirrors patient fingers, thumbs and nails between the two hands';
const config={root:dir,resolve:{alias:{vitest:path.join(repo,'node_modules/vitest/dist/index.js')}},test:{include:[fixture],testNamePattern:pattern,environment:'jsdom',maxWorkers:1,minWorkers:1,pool:'threads',fileParallelism:false,testTimeout:60000,hookTimeout:60000,reporters:['default','json'],outputFile:resultPath}};
fs.writeFileSync(configPath,'module.exports='+JSON.stringify(config,null,2)+';\n');const temp=path.join(dir,'temp');fs.mkdirSync(temp);
const pins=Object.fromEntries([__filename,path.join(work,'before.js'),path.join(work,'candidate.js'),currentFile,path.join(work,'raw-wrist-tests/summary.json'),path.join(repo,fixture),path.join(repo,vendor),path.join(dir,'stem_lab/stem_tool_firstresponse.js'),path.join(dir,fixture),path.join(dir,vendor),configPath].map(p=>[p,sha(fs.readFileSync(p))]));
const run=spawnSync(process.execPath,['--max-old-space-size=512',path.join(repo,'node_modules/vitest/vitest.mjs'),'run','--config',configPath],{cwd:dir,env:{...process.env,NODE_PATH:path.join(repo,'node_modules'),TEMP:temp,TMP:temp},windowsHide:true,encoding:'utf8',timeout:90000,maxBuffer:2*1024*1024});fs.writeFileSync(path.join(dir,'baseline.log'),(run.stdout||'')+(run.stderr||''));assert.equal(run.status,1,'Expected the same baseline assertions to fail');
const baselineBytes=fs.readFileSync(resultPath),current=JSON.parse(currentBytes),original=JSON.parse(baselineBytes);
function failures(result){return result.testResults.flatMap(f=>f.assertionResults).filter(a=>a.status==='failed').map(a=>{assert.ok(a.fullName.includes(pattern));const match=a.failureMessages.join('\n').match(/AssertionError: primary palm crease mirrored skin path: expected ([0-9.e+-]+) to be less than ([0-9.e+-]+)/);assert.ok(match,'Expected exact palm-crease assertion');return{test:a.fullName,assertion:match[0],actual:Number(match[1]),expected:Number(match[2])};}).sort((a,b)=>a.test.localeCompare(b.test));}
function compare(base){assert.equal(base.numFailedTests,3);assert.equal(base.numPassedTests,0);assert.equal(base.numPendingTests,20);const a=failures(current),b=failures(base);assert.equal(a.length,3);assert.deepEqual(a,b,'Candidate failures must equal original baseline failures exactly');return a;}
const comparisons=compare(original);let selftest={ran:false};if(process.argv.includes('--selftest')){const p=path.join(dir,'comparison-selftest.json');fs.writeFileSync(p,baselineBytes);let rejected=false;try{const damaged=JSON.parse(baselineBytes);const failed=damaged.testResults.flatMap(f=>f.assertionResults).find(a=>a.status==='failed');failed.failureMessages=failed.failureMessages.map(m=>m.replace('primary palm crease mirrored skin path: expected ','primary palm crease mirrored skin path: expected 9'));fs.writeFileSync(p,JSON.stringify(damaged));try{compare(JSON.parse(fs.readFileSync(p)));}catch{rejected=true;}}finally{fs.writeFileSync(p,baselineBytes);assert.deepEqual(fs.readFileSync(p),baselineBytes);}assert.ok(rejected);selftest={ran:true,changedFailureRejected:true,restoredAndReread:true,restoredSHA256:sha(fs.readFileSync(p))};}
for(const[p,h]of Object.entries(pins))assert.equal(sha(fs.readFileSync(p)),h,'Input changed '+p);assert.equal(sha(fs.readFileSync(resultPath)),sha(baselineBytes));
const result={verified:true,baselineSHA256,candidateSHA256,fixture,fixtureSHA256:sha(fixtureBytes),vendorSHA256:sha(vendorBytes),runnerSHA256:sha(fs.readFileSync(__filename)),configSHA256:sha(fs.readFileSync(configPath)),candidateResultSHA256:sha(currentBytes),baselineResultSHA256:sha(baselineBytes),baselineExitCode:run.status,candidatePassedTests:53,candidateFailedTests:3,baselineFailedTests:3,baselineSkippedTests:20,comparisons,selftest,inputsUnchanged:true,sharedFilesWritten:0,pins,limitation:'The baseline rerun selects only the three failing mirroring tests; 20 unrelated baseline hand tests are deliberately skipped. The candidate full two-file run has 53 passes and these same three pre-existing failures.'};fs.writeFileSync(path.join(dir,'summary.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({verified:true,candidatePassedTests:53,preExistingFailures:comparisons,selftest}));
