 background: rgb(248, 250, 252); color: rgb(36, 81, 127); font-size: 0.65rem; font-weight: 850; cursor: pointer; min-height: 2.75rem !important; }\n.diss-evidence__actions button[data-danger=\"true\"] { border-color: rgb(253, 164, 175); color: rgb(159, 18, 57); }\n.diss-canvas:fullscreen { margin: auto; object-fit: contain; width: auto !important; height: min(96dvh, 1100px) !important; max-width: 96vw !important; border-radius: 0px !important; background: rgb(15, 23, 42) !important; }\n.diss-fullscreen-dock { display: none; }\n.diss-canvas-frame:fullscreen, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] { display: grid; width: 100dvw; height: 100dvh; grid-template-rows: auto minmax(0px, 1fr); gap: 0.5rem; padding: max(.65rem, env(safe-area-inset-top)) max(.65rem, env(safe-area-inset-right)) max(.65rem, env(safe-area-inset-bottom)) max(.65rem, env(safe-area-inset-left)); border: 0px; border-radius: 0px; background: rgb(7, 17, 31); }\n.diss-canvas-frame:fullscreen .diss-fullscreen-dock, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock { display: flex; min-width: 0px; flex-wrap: wrap; align-items: center; gap: 0.4rem; padding: 0.5rem; border: 1px solid rgb(113, 132, 156); border-radius: 0.7rem; background: rgb(16, 35, 63); color: rgb(255, 255, 255); }\n.diss-canvas-frame:fullscreen .diss-fullscreen-dock button, .diss-canvas-frame:fullscreen .diss-fullscreen-dock select, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock button, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock select { padding: 0.42rem 0.58rem; border: 1px solid rgb(159, 179, 202); border-radius: 0.5rem; background: rgb(255, 255, 255); color: rgb(23, 77, 134); font-size: 0.7rem; font-weight: 850; min-height: 2.5rem !important; }\n.diss-canvas-frame:fullscreen .diss-fullscreen-dock label, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock label { display: inline-flex; min-height: 