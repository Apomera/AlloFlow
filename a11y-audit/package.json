{
  "name": "alloflow-a11y-audit",
  "version": "1.0.0",
  "description": "WCAG 2.2 AA accessibility auditor for AlloFlow",
  "scripts": {
    "audit": "node static-audit.js",
    "audit:runtime": "node runtime-audit.js",
    "audit:all": "node static-audit.js && node runtime-audit.js"
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.9.0",
    "puppeteer": "25.16.0",
    "proxy-agent": "8.0.2",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "get-uri@8.0.1": {
      "basic-ftp": "6.2.3"
    }
  }
}
