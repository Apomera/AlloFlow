n.diss-pan-controls button:nth-child(1) { grid-area: up; }\n.diss-pan-controls button:nth-child(2) { grid-area: left; }\n.diss-pan-controls span { grid-area: center; align-self: center; color: rgb(51, 65, 85); font-size: 0.72rem; font-weight: 900; text-align: center; }\n.diss-pan-controls button:nth-child(4) { grid-area: right; }\n.diss-pan-controls button:nth-child(5) { grid-area: down; }\n@media (forced-colors: active) {\n  [data-dissection-root] :focus-visible { forced-color-adjust: auto; outline: highlight solid 3px !important; box-shadow: none !important; }\n  [data-dissection-root] button, [data-dissection-root] input, [data-dissection-root] textarea, [data-dissection-root] canvas { border: 1px solid canvastext !important; }\n}\n.diss-mission { display: grid; grid-template-columns: minmax(0px, 1fr); gap: 1rem; padding: 1.15rem; overflow: hidden; position: relative; border: 1px solid rgba(125, 211, 252, 0.35); border-radius: 1.25rem; background: radial-gradient(circle at 90% 0%, rgba(45, 212, 191, 0.26), transparent 38%), linear-gradient(135deg, rgb(16, 35, 63) 0%, rgb(18, 61, 108) 58%, rgb(11, 105, 103) 100%); box-shadow: rgba(15, 23, 42, 0.16) 0px 18px 45px; color: rgb(255, 255, 255); }\n.diss-mission::after { content: \"\"; position: absolute; width: 12rem; height: 12rem; right: -5rem; bottom: -7rem; border: 1.5rem solid rgba(255, 255, 255, 0.06); border-radius: 999px; pointer-events: none; }\n.diss-mission__main, .diss-mission__action, .diss-mission__stats { position: relative; z-index: 1; }\n.diss-mission__eyebrow { margin: 0px 0px 0.3rem; color: rgb(153, 246, 228); font-size: 0.68rem; font-weight: 900; letter-spacing: 0.16em; text-transform: uppercase; }\n.diss-mission h2 { margin: 0px; color: rgb(255, 255, 255); font-size: clamp(1.25rem, 2.6vw, 1.8rem); line-height: 1.08; font-weight: 900; }\n.diss-mission__copy { max-width: 46rem; margin: 0.45rem 0px 0px; color: rgb(219, 234, 254); font-size: 0.84rem; line-height: 1.5; }\n.diss-workflow { display: flex;