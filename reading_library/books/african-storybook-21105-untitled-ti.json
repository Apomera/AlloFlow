    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/18911.png",
      "text": "ኣዴታት ንደቀን “ተጠንቐቁ ፤ ንደገ ከይትወፁ” ኢለን ነገራ።",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=21105#page=4",
      "sourceDigest": "sha256:37e9c221c6cc0d00bf3aedd9d370f1626492b0bc8c794b707b81c0e094054540"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/18912.png",
      "text": "ኩሎም ኣናፁ ድማ ይጥንቀቑ ነበሩ። ኩሎም ድማ ካብ ጉድጓዶም ኣይወፁን።",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=21105#page=5",
