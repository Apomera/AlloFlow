+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const { COPY, KEYS, LOCALES, lookup, placeholders, validatePayload, mergePack, run, parseArgs } = require('../dev-tools/i18n/apply_source_generation_locales.cjs');
+const payload = JSON.parse(readFileSync('translations/source-generation-locales.json', 'utf8'));
+describe('bounded source-generation catalog contract', () => {
+  it('freezes both exact English source literals, with registered mirrors', () => {
+    const ast = require('@babel/parser').parse(readFileSync('content_engine_source.jsx', 'utf8'), { sourceType: 'script' });
+    const source = new Map();
+    function visit(node) {
+      if (!node || typeof node !== 'object') return;
+      if (node.type === 'CallExpression' && node.callee?.name === 'sourceMessage' && node.arguments[0]?.type === 'StringLiteral' && node.arguments[1]?.type === 'StringLiteral') source.set(node.arguments[0].value, node.arguments[1].value);
+      for (const value of Object.values(node)) if (Array.isArray(value)) value.forEach(visit); else if (value && typeof value === 'object') visit(value);
+    }
+    visit(ast);
+    expect(validatePayload(payload)).toEqual(KEYS);
+    for (const key of KEYS) {
+      expect(source.get(key)).toBe(COPY[key]);
+      for (const file of ['ui_strings.js','desktop/web-app/public/ui_strings.js']) expect(lookup(JSON.parse(readFileSync(file, 'utf8')), key)).toBe(COPY[key]);
+    }
+  });
+  for (const locale of LOCALES) it(locale + ': exact coverage, reordered placeholders and root/public parity', () => {
+    const root = JSON.parse(readFileSync('lang/' + locale + '.js', 'utf8')), mirror = JSON.parse(readFileSync('desktop/web-app/public/lang/' + locale + '.js', 'utf8'));
+    for (const key of KEYS) { expect(lookup(root,key)).toBe(payload.locales[locale][key]); expect(lookup(mirror,key)).toBe(payload.locales[locale][key]); expect(placeholders(lookup(root,key))).toEqual(placeholders(COPY[key])); }
+  });
+  it.each(['missing','renamed','duplicated'])('rejects a %s count placeholder', mode => {
+    const p = structuredClone(payload), key = 'input.source_partial_generation';
+    p.locales.thai[key] = p.locales.thai[key].replace('{failed}', mode === 'missing' ? '2' : mode === 'renamed' ? '{missing}' : '{failed} {failed}');
+    expect(() => validatePayload(p)).toThrow(/Placeholder mismatch/);
+  });
+  it.each(['blank','echoed','embedded key','English'])('rejects %s translations', mode => {
+    const p = structuredClone(payload), key = KEYS[0];
+    p.locales.arabic[key] = mode === 'blank' ? ' ' : mode === 'echoed' ? key : mode === 'embedded key' ? 'Error: ' + key : COPY[key];
+    expect(() => validatePayload(p)).toThrow(/Missing translation/);
+  });
+  it('rejects changed English, an extra key, or an extra locale before merging', () => {
+    const p = structuredClone(payload); p.english[KEYS[0]] += ' Changed.'; expect(() => validatePayload(p)).toThrow(/English copy changed/);
+    p.english[KEYS[0]] = COPY[KEYS[0]]; p.locales.thai['input.unowned'] = 'extra'; expect(() => validatePayload(p)).toThrow(/coverage/);
+    delete p.locales.thai['input.unowned']; p.locales.extra = p.locales.thai; expect(() => validatePayload(p)).toThrow(/five locales/);
+  });
+  it('refuses existing conflicting copy and leaves original/unrelated values untouched', () => {
+    const original = { input: { label: 'Keep', source_partial_generation: 'Different owner wording' }, simplified: { read: 'Keep this too' } }, before = JSON.stringify(original);
+    expect(() => mergePack(original, payload.locales.thai)).toThrow(/resolve ownership/); expect(JSON.stringify(original)).toBe(before);
+    delete original.input.source_partial_generation;
+    const merged = mergePack(original, payload.locales.thai);
+    expect(original.input.error_no_source_content).toBeUndefined(); expect(merged.input.label).toBe('Keep'); expect(merged.simplified).toBe(original.simplified);
+  });
+  it('has zero pending catalog writes and rejects ambiguous CLI modes', () => {
+    expect(run(false)).toEqual({ keys: 2, locales: 5, changedFiles: 0, mode: 'check' });
+    expect(parseArgs([])).toBe(false); expect(parseArgs(['--check'])).toBe(false); expect(parseArgs(['--apply'])).toBe(true);
+    expect(() => parseArgs(['--check','--apply'])).toThrow(); expect(() => parseArgs(['--apply-all'])).toThrow();
+  });
+});
