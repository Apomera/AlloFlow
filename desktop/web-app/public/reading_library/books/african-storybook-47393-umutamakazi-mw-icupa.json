  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/25233.png",
      "text": "Habaye umutamakazi yibana wenyene mukazu kameze nk' icupa. Yaguma yidodomba umwanya wose.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=1",
      "sourceDigest": "sha256:8ba5680423b730dc4ce1087688cebafaddf61060200087811112c185b6c7cfc9"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/25234.png",
      "text": "Umunsi umwe umumarayika yaramugendeye imuhira iwe. Amubona ababaye cane.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=2",
      "sourceDigest": "sha256:d265416ad70902b416b7c62e9a0f1cc18d4c8a38d74d18c3a1abe8ee9eb1a088"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/25235.png",
      "text": "Umumarayika arahagarara aca umubaza ati, \"Kubera iki ushavuye cane?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=3",
      "sourceDigest": "sha256:9302f833259e6dc9e140756a2d65e232e71c30c446a3922fff302978f8b06d80"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/25236.png",
      "text": "Umutamakazi aramwishura ati, \"Ndaruhishijwe no kuba mw' icupa.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=4",
      "sourceDigest": "sha256:ae9cdcbfe2c0a52688310f4d2741ac86afa1d1e64ef48d33692dafd9266d9d97"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/25237.png",
      "text": "Umumarayika amubwira ati, \"Haguruka, koma amashi kabiri hanyuma uzunguruke incuro zitatu.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=5",
      "sourceDigest": "sha256:dda7a419c9baa1f4821003854f9f5cfb02e63c8b9cd4968f07116a24d3d45fb0"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/25238.png",
      "text": "Umutamakazi abikora uko yabimubariye. Aca yisanga mu kazu gatoya.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=6",
      "sourceDigest": "sha256:045f68562117f73aaf2da19921af2cbf3ad973fe52fcd5271e52581e3421f24f"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/25239.png",
      "text": "Haheze iminsi mikeya, umumarayika aragaruka, asanga wa mutamakazi akibabaye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=7",
      "sourceDigest": "sha256:ee8ce0fbf4f2df2ff14e573027f367307b4d4035db4196249148100daecac0a5"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/25240.png",
      "text": "Umumarayika aramubaza ati, \"Ni igiki kitagenda neza? Kubera iki ushavuye?\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=8",
      "sourceDigest": "sha256:8c87ece2c595f5dfd3bce1ccf433c60e8bb5f8112ec8fb1c40be377d9e6bf6c0"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/25241.png",
      "text": "Umutamakazi aramwishura ati, \"Aka kazu ni gato cane, sindagakunda.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=9",
      "sourceDigest": "sha256:b420f687ca849a69795944a22aaf8831cb0489a9f305286a21dccfa70e056586"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/25242.png",
      "text": "Umumarayika amubwira ati, \"Haguruka, koma amashi kabiri hanyuma uzunguruke incuro zitatu.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=10",
      "sourceDigest": "sha256:dda7a419c9baa1f4821003854f9f5cfb02e63c8b9cd4968f07116a24d3d45fb0"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/25243.png",
      "text": "Umutamakazi abikora uko abimubariye. Aca yisanga ari munzu nini.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=11",
      "sourceDigest": "sha256:d3c9fbe528690aeecaf35797a4a8fbda5ce8fcd03697f9e62efa5189838089ce"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/25244.png",
      "text": "Umumarayika yaragarutse kandi kuraba umutamakazi. Yamusanze akibabaye kandi yidodomba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=12",
      "sourceDigest": "sha256:a54850c7cc4d851ea8f40d0d85969ee45185a5faa537e013c08eea0359835f34"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/25245.png",
      "text": "Umumarayika aramubaza ati, \"Ni igiki kitagenda neza?\" Umutamakazi aramwishura ati, \"Iyinzu irimwo umwijima kandi ntasuku.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=13",
      "sourceDigest": "sha256:b6dd5a6da07622e7afc33e947bd634b604112186aec5115165f1f058fbacc200"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/25246.png",
      "text": "Umumarayika amubwira ati, \"Haguruka, koma amashi kabiri hanyuma uzunguruke incuro zitatu.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=14",
      "sourceDigest": "sha256:dda7a419c9baa1f4821003854f9f5cfb02e63c8b9cd4968f07116a24d3d45fb0"
    },
    {
      "n": 15,
      "img": "https://www.africanstorybook.org/illustrations/pages/25247.png",
      "text": "Umutamakazi abikora uko abimubariye. Aca yisanga ari muri Kakazu kubwambere kameez nk'icupa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=15",
      "sourceDigest": "sha256:4131c0ed9bc0336324ebc3e614b637b4abbb9c43f9f76eb92f5b569d54cd6c12"
    },
    {
      "n": 16,
      "img": "https://www.africanstorybook.org/illustrations/pages/25248.png",
      "text": "Umutamakazi aba arabuze imigisha yararonse. Vyarangiye agumye muri ka kazu kameze nk' icupa, wenyene kandi ababaye.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47393#page=16",
      "sourceDigest": "sha256:79190477dce9562364670522541249d71dd8b6439b8e44da4774d20601a42133"
    }
  ],
