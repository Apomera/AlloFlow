+import { beforeAll, afterEach, afterAll, describe, it, expect } from 'vitest';
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { fixtures, copy, setupDraftReader, cleanupDraftReader, mountDraft, click, type } from './helpers/reader_passage_label_harness.js';
+const require = createRequire(import.meta.url), webRequire = createRequire(resolve('desktop/web-app/package.json'));
+const report = resolve('reports/passage-label-layout'), results = [];
+let browser, css;
+(process.env.ALLO_PASSAGE_LABEL_LAYOUT === '1' ? describe : describe.skip)('translated passage form and pin control reflow', () => {
+  beforeAll(async () => {
+    setupDraftReader();
+    const config = { ...require(resolve('desktop/web-app/tailwind.config.js')), content: [resolve(process.env.ALLO_PASSAGE_LABEL_SOURCE || 'view_simplified_source.jsx')] };
+    css = (await webRequire('postcss')([webRequire('tailwindcss')(config)]).process('@tailwind base;\n@tailwind components;\n@tailwind utilities;', { from: undefined })).css;
+    browser = await require('@playwright/test').chromium.launch({ headless: true }); mkdirSync(report, { recursive: true });
+  }, 60000);
+  afterEach(cleanupDraftReader);
+  afterAll(async () => { await browser?.close(); writeFileSync(resolve(report, 'results.json'), JSON.stringify(results, null, 2) + '\n'); });
+  for (const f of fixtures) for (const adapted of [false,true]) for (const scale of [1,2]) it(f.id + ' adapted=' + adapted + ' at 320px/' + scale + 'x', async () => {
+    const h = mountDraft(f, { adapted });
+    if (!adapted) await click(h.host.querySelector('li input[type=checkbox]'));
+    await h.requestAdd(); type(h.host.querySelector('[data-gloss-draft] input[type=text]'), 'no-match-12345');
+    const page = await browser.newPage({ viewport: { width: 320, height: 900 } }), errors = []; page.on('pageerror', e => errors.push(e.message)); await page.route('**/*', route => route.abort());
+    try {
+      await page.setContent('<!doctype html><html lang="' + f.tag + '" dir="' + f.direction + '"><head><meta charset="utf-8"><style>' + css + '\nhtml{font-size:' + 16 * scale + 'px}</style></head><body>' + h.host.outerHTML + '</body></html>');
+      const label = copy(f, 'gloss_word_from_' + (adapted ? 'adapted' : 'original'));
+      await page.getByText(label, { exact: true }).click();
+      const input = page.getByRole('textbox', { name: label, exact: true }); expect(await input.evaluate(n => document.activeElement === n)).toBe(true);
+      const geometry = await page.evaluate(() => {
+        const input = document.querySelector('[data-gloss-draft] input[type=text]'), label = input.closest('label'), notice = [...document.querySelectorAll('[data-gloss-draft] [role=status]')].find(n => n.textContent.trim()), pin = document.querySelector('li input[type=checkbox]');
+        const measure = n => n && ({ client: n.clientWidth, scroll: n.scrollWidth, left: n.getBoundingClientRect().left, right: n.getBoundingClientRect().right, direction: getComputedStyle(n).direction });
+        return { documentWidth: document.documentElement.scrollWidth, label: measure(label), notice: measure(notice), pin: measure(pin), pinLabel: measure(pin?.closest('label')) };
+      });
+      expect(geometry.documentWidth).toBe(320);
+      for (const g of [geometry.label,geometry.notice,geometry.pinLabel].filter(Boolean)) { expect(g.scroll).toBeLessThanOrEqual(g.client + 1); expect(g.left).toBeGreaterThanOrEqual(-1); expect(g.right).toBeLessThanOrEqual(321); expect(g.direction).toBe(f.direction); }
+      if (adapted) expect(geometry.pin).toBeNull();
+      else { expect(geometry.pin.client).toBeGreaterThanOrEqual(10); await page.locator('li input[type=checkbox]').focus(); expect(await page.locator('li input[type=checkbox]').evaluate(n => document.activeElement === n)).toBe(true); }
+      expect(errors).toEqual([]); await page.screenshot({ path: resolve(report, f.id + '-' + (adapted ? 'adapted' : 'original') + '-' + scale + 'x.png'), fullPage: true });
+      results.push({ fixture:f.id, adapted, viewportCssPx:320, rootTextScale:scale, nativeZoom:false, scope:'actual editor markup, not full app', geometry, errors });
+    } finally { await page.close(); }
+  }, 30000);
+});
