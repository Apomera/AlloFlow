"s":"Ice shell over a subsurface ocean. Top candidate for alien life!"}},{"k":"ganymede","v":{"s":"Ganymede"}},{"k":"largest_moon_in_the_solar_system_bigge","v":{"s":"Largest moon in the solar system. Bigger than Mercury! Has its own magnetic field."}},{"k":"callisto","v":{"s":"Callisto"}},{"k":"most_heavily_cratered_object_in_the_so","v":{"s":"Most heavily cratered object in the solar system. May have a subsurface ocean."}},{"k":"titan","v":{"s":"Titan"}},{"k":"only_moon_with_a_thick_atmosphere_has_","v":{"s":"Only moon with a thick atmosphere. Has lakes and rivers of liquid methane!"}},{"k":"enceladus","v":{"s":"Enceladus"}},{"k":"geysers_of_water_vapor_erupting_from_t","v":{"s":"Geysers of water vapor erupting from the south pole. Subsurface ocean confirmed!"}},{"k":"mimas","v":{"s":"Mimas"}},{"k":"giant_herschel_crater_makes_it_look_li","v":{"s":"Giant Herschel crater makes it look like the Death Star from Star Wars!"}},{"k":"iapetus","v":{"s":"Iapetus"}},{"k":"two_toned_one_half_bright_white_the_ot","v":{"s":"Two-toned: one half bright white, the other dark as coal. Has a giant equatorial ridge."}},{"k":"miranda","v":{"s":"Miranda"}},{"k":"most_geologically_diverse_moon_has_a_2","v":{"s":"Most geologically diverse moon. Has a 20 km cliff called Verona Rupes!"}},{"k":"titania","v":{"s":"Titania"}},{"k":"largest_moon_of_uranus_named_after_the","v":{"s":"Largest moon of Uranus. Named after the queen of fairies in Shakespeare."}},{"k":"ariel","v":{"s":"Ariel"}},{"k":"brightest_and_possibly_youngest_surfac","v":{"s":"Brightest and possibly youngest surface of Uranus' major moons."}},{"k":"triton","v":{"s":"Triton"}},{"k":"orbits_backwards_probably_a_captured_k","v":{"s":"Orbits backwards! Probably a captured Kuiper Belt object. Has nitrogen geysers."}},{"k":"charon","v":{"s":"Charon"}},{"k":"half_the_size_of_pluto_they_orbit_each","v":{"s":"Half the size of Pluto! They orbit each other (double dwarf planet). Has a red polar cap."}},{"k":"no_atmosphere_stars_visible_even_durin","v":{"s":"No atmosphere — stars visible even during daytime. Sun is blindingly large."}},{"k":"permanent_overcast_surface_bathed_in_d","v":{"s":"Permanent overcast. Surface bathed in dim orange glow. Lightning flashes above."}},{"k":"blue_sky_from_rayleigh_scattering_5_00","v":{"s":"Blue sky from Rayleigh scattering. ~5,000 stars visible to naked eye."}},{"k":"butterscotch_sky_from_iron_dust_blue_s","v":{"s":"Butterscotch sky from iron dust. Blue sunsets! Phobos rises 2x/day."}},{"k":"no_surface_from_cloud_tops_see_auroras","v":{"s":"No surface — from cloud tops, see auroras 100x brighter than Earth’s."}},{"k":"rings_visible_as_bright_arcs_overhead_","v":{"s":"Rings visible as bright arcs overhead. From Titan: orange haze sky, Saturn fills 11°."}},{"k":"sun_just_a_very_bright_point_42_year_s","v":{"s":"Sun just a very bright point. 42-year seasons. Extreme tilt means Sun can be at zenith at poles."}},{"k":"sun_900x_dimmer_than_on_earth_still_30","v":{"s":"Sun 900x dimmer than on Earth. Still 300x brighter than full Moon on Earth."}},{"k":"charon_appears_7x_larger_than_our_moon","v":{"s":"Charon appears 7x larger than our Moon. They’re tidally locked — Charon hangs motionless in the sky."}},{"k":"upper_haze","v":{"s":"Upper Haze"}},{"k":"thin_haze_of_sulfuric_acid_droplets","v":{"s":"Thin haze of sulfuric acid droplets"}},{"k":"cloud_deck","v":{"s":"Cloud Deck"}},{"k":"thick_sulfuric_acid_clouds_no_visibili","v":{"s":"Thick sulfuric acid clouds — no visibility"}},{"k":"lower_clouds","v":{"s":"Lower Clouds"}},{"k":"clouds_thinning_dim_orange_light_below","v":{"s":"Clouds thinning, dim orange light below"}},{"k":"clear_air","v":{"s":"Clear Air"}},{"k":"co_atmosphere_eerily_clear_visibility","v":{"s":"CO₂ atmosphere, eerily clear visibility"}},{"k":"surface","v":{"s":"Surface"}},{"k":"lead_melting_heat_crushing_pressure","v":{"s":"Lead-melting heat, crushing pressure"}},{"k":"thermosphere","v":{"s":"Thermosphere"}},{"k":"auroras_glow_here_iss_orbits_at_408_km","v":{"s":"Auroras glow here. ISS orbits at 408 km."}},{"k":"stratosphere","v":{"s":"Stratosphere"}},{"k":"ozone_layer_absorbs_uv_jet_stream","v":{"s":"Ozone layer absorbs UV. Jet stream."}},{"k":"troposphere","v":{"s":"Troposphere"}},{"k":"all_weather_happens_here_clouds_rain","v":{"s":"All weather happens here. Clouds, rain."}},{"k":"surface_2","v":{"s":"Surface"}},{"k":"breathable_air_oceans_and_land","v":{"s":"Breathable air. Oceans and land."}},{"k":"upper_atmosphere","v":{"s":"Upper Atmosphere"}},{"k":"thin_co_spacecraft_aerobraking_zone","v":{"s":"Thin CO₂. Spacecraft aerobraking zone."}},{"k":"dust_layer","v":{"s":"Dust Layer"}},{"k":"red_iron_oxide_dust_suspended_by_winds","v":{"s":"Red iron-oxide dust suspended by winds"}},{"k":"lower_atmosphere","v":{"s":"Lower Atmosphere"}},{"k":"thin_pink_sky_dust_devils_visible","v":{"s":"Thin pink sky. Dust devils visible."}},{"k":"surface_3","v":{"s":"Surface"}},{"k":"red_desert_0_6_of_earth_s_pressure","v":{"s":"Red desert. 0.6% of Earth’s pressure."}},{"k":"stratosphere_2","v":{"s":"Stratosphere"}},{"k":"haze_layers_above_the_clouds","v":{"s":"Haze layers above the clouds"}},{"k":"ammonia_clouds","v":{"s":"Ammonia Clouds"}},{"k":"white_and_orange_cloud_bands","v":{"s":"White and orange cloud bands"}},{"k":"water_clouds","v":{"s":"Water Clouds"}},{"k":"thunderstorms_with_10x_earth_lightning","v":{"s":"Thunderstorms with 10x Earth lightning"}},{"k":"deep_atmosphere","v":{"s":"Deep Atmosphere"}},{"k":"darkness_pressure_crushing","v":{"s":"Darkness. Pressure crushing."}},{"k":"liquid_h_ocean","v":{"s":"Liquid H₂ Ocean"}},{"k":"hydrogen_compressed_into_liquid","v":{"s":"Hydrogen compressed into liquid"}},{"k":"metallic_h","v":{"s":"Metallic H₂"}},{"k":"liquid_metal_hydrogen_magnetic_field_s","v":{"s":"Liquid metal hydrogen. Magnetic field source."}},{"k":"upper_haze_2","v":{"s":"Upper Haze"}},{"k":"golden_haze_rings_visible_overhead","v":{"s":"Golden haze. Rings visible overhead."}},{"k":"ammonia_clouds_2","v":{"s":"Ammonia Clouds"}},{"k":"golden_white_cloud_bands_calmer_than_j","v":{"s":"Golden-white cloud bands, calmer than Jupiter"}},{"k":"water_clouds_2","v":{"s":"Water Clouds"}},{"k":"deep_thunderstorms","v":{"s":"Deep thunderstorms"}},{"k":"deep_atmosphere_2","v":{"s":"Deep Atmosphere"}},{"k":"increasing_pressure_total_darkness","v":{"s":"Increasing pressure, total darkness"}},{"k":"metallic_h_2","v":{"s":"Metallic H₂"}},{"k":"hydrogen_becomes_metallic_liquid","v":{"s":"Hydrogen becomes metallic liquid"}},{"k":"upper_atmosphere_2","v":{"s":"Upper Atmosphere"}},{"k":"thin_methane_haze_absorbs_red_light","v":{"s":"Thin methane haze — absorbs red light"}},{"k":"methane_clouds","v":{"s":"Methane Clouds"}},{"k":"blue_green_ice_crystal_clouds","v":{"s":"Blue-green ice crystal clouds"}},{"k":"h_s_clouds","v":{"s":"H₂S Clouds"}},{"k":"hydrogen_sulfide_clouds_rotten_eggs","v":{"s":"Hydrogen sulfide clouds (rotten eggs!)"}},{"k":"superionic_ice","v":{"s":"Superionic Ice"}},{"k":"water_in_exotic_superionic_state","v":{"s":"Water in exotic superionic state"}},{"k":"diamond_rain","v":{"s":"Diamond Rain"}},{"k":"carbon_atoms_crushed_into_diamonds_fal","v":{"s":"Carbon atoms crushed into diamonds falling like rain"}},{"k":"upper_atmosphere_3","v":{"s":"Upper Atmosphere"}},{"k":"deep_blue_from_methane_absorption","v":{"s":"Deep blue from methane absorption"}},{"k":"methane_clouds_2","v":{"s":"Methane Clouds"}},{"k":"supersonic_winds_2_100_km_h","v":{"s":"Supersonic winds: 2,100 km/h"}},{"k":"deep_clouds","v":{"s":"Deep Clouds"}},{"k":"great_dark_spot_storms","v":{"s":"Great Dark Spot storms"}},{"k":"hot_ice_mantle","v":{"s":"Hot Ice Mantle"}},{"k":"superionic_water_at_extreme_pressure","v":{"s":"Superionic water at extreme pressure"}},{"k":"diamond_rain_2","v":{"s":"Diamond Rain"}},{"k":"literal_diamonds_raining_down_through_","v":{"s":"Literal diamonds raining down through the depths"}},{"k":"proxima_centauri_b","v":{"s":"Proxima Centauri b"}},{"k":"closest_known_exoplanet_in_habitable_z","v":{"s":"Closest known exoplanet! In habitable zone of nearest star."}},{"k":"one_of_7_rocky_planets_best_candidate_","v":{"s":"One of 7 rocky planets. Best candidate for liquid water."}},{"k":"earth_s_bigger_cousin_sun_like_star_38","v":{"s":"Earth’s “bigger cousin.” Sun-like star. 385-day year."}},{"k":"hd_189733_b","v":{"s":"HD 189733 b"}},{"k":"rains_molten_glass_sideways_blue_color","v":{"s":"Rains molten glass sideways! Blue color from silicate particles."}},{"k":"55_cancri_e","v":{"s":"55 Cancri e"}},{"k":"super_earth_covered_in_lava_oceans_may","v":{"s":"Super-Earth covered in lava oceans. May contain diamond interior."}},{"k":"so_hot_that_iron_vaporizes_on_the_day_","v":{"s":"So hot that iron vaporizes on the day side and rains as liquid metal at night!"}},{"k":"psr_b1257_12_b","v":{"s":"PSR B1257+12 b"}},{"k":"first_exoplanet_ever_discovered_1992_o","v":{"s":"First exoplanet ever discovered (1992)! Orbits a dead pulsar star."}},{"k":"toi_700_d","v":{"s":"TOI-700 d"}},{"k":"earth_sized_planet_in_habitable_zone_d","v":{"s":"Earth-sized planet in habitable zone. Discovered by TESS in 2020."}},{"k":"tiny_magnetic_field_from_partially_mol","v":{"s":"Tiny magnetic field from partially molten core. Not enough to protect surface."}},{"k":"no_global_magnetic_field_solar_wind_in","v":{"s":"No global magnetic field. Solar wind interacts directly with atmosphere."}},{"k":"strong_dipole_field_from_liquid_iron_o","v":{"s":"Strong dipole field from liquid iron outer core. Creates Van Allen belts. Essential for life!"}},{"k":"lost_its_global_field_4_billion_years_","v":{"s":"Lost its global field ~4 billion years ago. Remnant magnetism in ancient crust."}},{"k":"strongest_in_solar_system_deadly_radia","v":{"s":"Strongest in solar system! Deadly radiation belts. Metallic hydrogen generates the field."}},{"k":"unique_almost_perfectly_aligned_with_r","v":{"s":"Unique: almost perfectly aligned with rotation axis. Hydrogen metallic core."}},{"k":"tilted_59_from_rotation_axis_off_cente","v":{"s":"Tilted 59° from rotation axis! Off-center. Very unusual configuration."}},{"k":"also_highly_tilted_47_and_off_center_c","v":{"s":"Also highly tilted (47°) and off-center. Complex magnetic environment."}},{"k":"too_small_and_cold_for_a_dynamo_no_pro","v":{"s":"Too small and cold for a dynamo. No protection from solar wind."}},{"k":"venus_has_a_runaway_greenhouse_effect_","v":{"s":"Venus has a runaway greenhouse effect reaching 462°C!"}},{"k":"saturn_has_146_known_moons_as_of_2024","v":{"s":"Saturn has 146 known moons as of 2024!"}},{"k":"uranus_has_an_axial_tilt_of_97_77","v":{"s":"Uranus has an axial tilt of 97.77°!"}},{"k":"mercury_is_only_4_879_km_in_diameter","v":{"s":"Mercury is only 4,879 km in diameter."}},{"k":"pluto_takes_248_earth_years_to_orbit_t","v":{"s":"Pluto takes 248 Earth years to orbit the Sun!"}},{"k":"jupiter_rotates_in_just_10_hours","v":{"s":"Jupiter rotates in just 10 hours!"}},{"k":"iron_oxide_rust_gives_mars_its_red_col","v":{"s":"Iron oxide (rust) gives Mars its red color."}},{"k":"saturn_s_density_is_less_than_water_0_","v":{"s":"Saturn’s density is less than water (0.687 g/cm³)!"}},{"k":"olympus_mons_on_mars_is_21_9_km_high_n","v":{"s":"Olympus Mons on Mars is 21.9 km high — nearly 3x Everest!"}},{"k":"neptune_s_winds_reach_2_100_km_h","v":{"s":"Neptune’s winds reach 2,100 km/h!"}},{"k":"earth_s_magnetic_field_deflects_charge","v":{"s":"Earth’s magnetic field deflects charged solar particles. The ozone helps with UV, but the magnetosphere is the primary shield!"}},{"k":"the_iau_s_2006_definition_requires_pla","v":{"s":"The IAU’s 2006 definition requires planets to clear their orbital neighborhood of other debris."}},{"k":"also_called_the_goldilocks_zone_not_to","v":{"s":"Also called the \"Goldilocks zone\" — not too hot, not too cold for liquid water on the surface."}},{"k":"the_moon_rotates_exactly_once_per_orbi","v":{"s":"The Moon rotates exactly once per orbit — this synchronization is caused by tidal forces over billions of years."}},{"k":"opportunity_rover_found_hematite_blueb","v":{"s":"Opportunity rover found hematite \"blueberries\" — minerals that only form in water. Orbital photos show ancient river deltas!"}},{"k":"venus_is_hotter_462_c_vs_430_c_mercury","v":{"s":"Venus is hotter (462°C vs 430°C)! Mercury has no atmosphere to trap heat. The greenhouse effect matters more than distance."}},{"k":"gas_giants_have_no_solid_surface_they_","v":{"s":"Gas giants have no solid surface! They’re mostly hydrogen and helium gas that gradually gets denser toward the core. A probe would sink endlessly."}},{"k":"earth_s_distance_from_the_sun_doesn_t_","v":{"s":"Earth’s distance from the Sun doesn’t change during the day. Noon just means the Sun is highest in your sky. Earth is closest in January (perihelion)!"}},{"k":"jupiter_is_11x_wider_than_earth_and_1_","v":{"s":"Jupiter is 11x wider than Earth, and 1,300 Earths could fit inside it! The solar system has extreme size differences."}},{"k":"pluto_is_still_in_the_solar_system_it_","v":{"s":"Pluto is still in the solar system! It was reclassified from \"planet\" to \"dwarf planet\" in 2006, but it’s still orbiting the Sun."}},{"k":"the_asteroid_belt_is_mostly_empty_spac","v":{"s":"The asteroid belt is mostly empty space! The average distance between asteroids is millions of km. Spacecraft fly through without any risk."}},{"k":"not_always_saturn_is_95x_earth_s_mass_","v":{"s":"Not always! Saturn is 95x Earth’s mass but surface gravity is only 1.06g because it’s so large and low-density. Weight depends on both mass AND radius."}},{"k":"all_parts_of_the_moon_receive_sunlight","v":{"s":"All parts of the Moon receive sunlight! The \"far side\" is just the half we can’t see from Earth due to tidal locking. It gets just as much Sun."}},{"k":"the_habitable_zone","v":{"s":"The Habitable Zone"}},{"k":"the_habitable_zone_or_goldilocks_zone_","v":{"s":"The habitable zone (or \"Goldilocks zone\") is the range of distances from a star where liquid water could exist on a planet’s surface. In our solar system, Venus is at the inner edge, Earth is in the middle, and Mars is at the outer edge. But having liquid water also requires the right atmosphere and magnetic field!"}},{"k":"the_greenhouse_effect","v":{"s":"The Greenhouse Effect"}},{"k":"when_sunlight_heats_a_planet_s_surface","v":{"s":"When sunlight heats a planet’s surface, the surface radiates heat (infrared). Greenhouse gases (CO₂, CH₄, H₂O) absorb this heat and re-radiate it, warming the planet. Earth’s greenhouse is +33°C (life-sustaining). Venus’s is +510°C (runaway). Mars has almost none (-60°C average). The amount of greenhouse gas determines the outcome!"}},{"k":"magnetic_shields","v":{"s":"Magnetic Shields"}},{"k":"a_planet_s_magnetic_field_creates_a_ma","v":{"s":"A planet’s magnetic field creates a \"magnetosphere\" — an invisible shield that deflects the solar wind (charged particles from the Sun). Earth’s magnetosphere protects our atmosphere and makes life possible. Mars lost its magnetic field 4 billion years ago, and its atmosphere was gradually stripped away. Jupiter’s magnetosphere is 20,000x stronger than Earth’s!"}},{"k":"why_isn_t_pluto_a_planet","v":{"s":"Why Isn’t Pluto a Planet?"}},{"k":"in_2006_the_international_astronomical","v":{"s":"In 2006, the International Astronomical Union defined three criteria for a planet: (1) Orbits the Sun ✓, (2) Has enough mass for round shape ✓, (3) Has \"cleared its orbit\" of other debris ✗. Pluto shares its orbital zone with thousands of Kuiper Belt objects, so it’s classified as a \"dwarf planet.\" This doesn’t make it less interesting — New Horizons revealed it’s geologically active!"}},{"k":"tidal_locking","v":{"s":"Tidal Locking"}},{"k":"over_billions_of_years_gravitational_t","v":{"s":"Over billions of years, gravitational tidal forces can slow a moon’s rotation until it matches its orbital period. Result: one face always points at the planet. Our Moon is tidally locked to Earth. Mercury is partially locked to the Sun (3:2 ratio). Pluto and Charon are mutually locked — they always show the same face to each other!"}},{"k":"searching_for_life","v":{"s":"Searching for Life"}},{"k":"a_biosignature_is_any_evidence_of_past","v":{"s":"A biosignature is any evidence of past or present life. Scientists look for: (1) liquid water, (2) organic molecules, (3) atmospheric gases like oxygen or methane that shouldn’t exist without life producing them, (4) energy sources. The best candidates in our solar system: Mars (ancient water), Europa (subsurface ocean), Enceladus (water geysers), and Titan (methane lakes)."}},{"k":"tour_guide","v":{"s":"Tour Guide"}},{"k":"guided_tour_for_beginners_grades_3_5","v":{"s":"Guided tour for beginners (grades 3-5)"}},{"k":"explorer","v":{"s":"Explorer"}},{"k":"self_directed_exploration_grades_6_8","v":{"s":"Self-directed exploration (grades 6-8)"}},{"k":"researcher","v":{"s":"Researcher"}},{"k":"advanced_investigation_grade_8","v":{"s":"Advanced investigation (grade 8+)"}},{"k":"inner_planets_study","v":{"s":"Inner Planets Study"}},{"k":"gas_giant_expedition","v":{"s":"Gas Giant Expedition"}},{"k":"search_for_life","v":{"s":"Search for Life"}},{"k":"grand_tour_survey","v":{"s":"Grand Tour Survey"}},{"k":"smallest_planet_no_atmosphere_to_retai","v":{"s":"Smallest planet; no atmosphere to retain heat."}},{"k":"hottest_planet_due_to_runaway_greenhou","v":{"s":"Hottest planet due to runaway greenhouse effect. Rotates backwards!"}},{"k":"only_known_planet_with_liquid_water_an","v":{"s":"Only known planet with liquid water and life."}},{"k":"has_the_tallest_volcano_in_the_solar_s","v":{"s":"Has the tallest volcano in the solar system: Olympus Mons (21.9 km high)."}},{"k":"largest_planet_the_great_red_spot_is_a","v":{"s":"Largest planet. The Great Red Spot is a storm larger than Earth!"}},{"k":"its_rings_are_made_of_ice_and_rock_cou","v":{"s":"Its rings are made of ice and rock. Could float in a giant bathtub!"}},{"k":"rotates_on_its_side_an_ice_giant_with_","v":{"s":"Rotates on its side! An ice giant with methane atmosphere."}},{"k":"windiest_planet_winds_up_to_2_100_km_h","v":{"s":"Windiest planet: winds up to 2,100 km/h. Deep blue from methane."}},{"k":"dwarf_planet_since_2006_has_a_heart_sh","v":{"s":"Dwarf planet since 2006. Has a heart-shaped glacier named Tombaugh Regio."}},{"k":"halley_s_comet","v":{"s":"Halley's Comet"}},{"k":"back_to_tools","v":{"s":"Back to tools"}},{"k":"solar_system_explorer","v":{"s":"🌍 Solar System Explorer"}},{"k":"mercury","v":{"s":"Mercury"}},{"k":"smallest_planet_closest_to_the_sun_no_","v":{"s":"Smallest planet, closest to the Sun, no atmosphere to speak of."}},{"k":"venus","v":{"s":"Venus"}},{"k":"thick_co_atmosphere_runaway_greenhouse","v":{"s":"Thick CO₂ atmosphere, runaway greenhouse, rotates retrograde."}},{"k":"earth","v":{"s":"Earth"}},{"k":"our_home_liquid_water_magnetosphere_li","v":{"s":"Our home — liquid water, magnetosphere, life."}},{"k":"mars","v":{"s":"Mars"}},{"k":"thin_atmosphere_iron_oxide_surface_two","v":{"s":"Thin atmosphere, iron oxide surface, two small moons."}},{"k":"jupiter","v":{"s":"Jupiter"}},{"k":"gas_giant_great_red_spot_95_known_moon","v":{"s":"Gas giant, Great Red Spot, 95 known moons."}},{"k":"saturn","v":{"s":"Saturn"}},{"k":"magnificent_ring_system_density_less_t","v":{"s":"Magnificent ring system, density less than water."}},{"k":"uranus","v":{"s":"Uranus"}},{"k":"ice_giant_tilted_98_faint_rings_27_kno","v":{"s":"Ice giant tilted 98°, faint rings, 27 known moons."}},{"k":"neptune","v":{"s":"Neptune"}},{"k":"strongest_winds_in_the_solar_system_vi","v":{"s":"Strongest winds in the solar system, vivid blue colour."}},{"k":"pluto","v":{"s":"Pluto"}},{"k":"heart_shaped_n_glacier_5_moons_kuiper_","v":{"s":"Heart-shaped N₂ glacier, 5 moons, Kuiper Belt king."}},{"k":"ceres","v":{"s":"Ceres"}},{"k":"largest_asteroid_belt_object_bright_sa","v":{"s":"Largest asteroid-belt object, bright salt deposits."}},{"k":"haumea","v":{"s":"Haumea"}}