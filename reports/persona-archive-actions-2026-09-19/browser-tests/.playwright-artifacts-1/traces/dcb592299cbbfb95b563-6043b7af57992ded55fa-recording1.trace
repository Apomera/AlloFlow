yssopelagic","v":{"s":"Abyssal Zone (Abyssopelagic)"}},{"k":"hadal_zone_trenches","v":{"s":"Hadal Zone (Trenches)"}},{"k":"clownfish_2","v":{"s":"Clownfish"}},{"k":"lives_in_symbiosis_with_venomous_sea_a","v":{"s":"Lives in symbiosis with venomous sea anemones."}},{"k":"bottlenose_dolphin","v":{"s":"Bottlenose Dolphin"}},{"k":"dolphins_sleep_with_one_eye_open_one_b","v":{"s":"Dolphins sleep with one eye open — one brain hemisphere at a time."}},{"k":"moon_jellyfish","v":{"s":"Moon Jellyfish"}},{"k":"jellyfish_have_no_brain_heart_or_blood","v":{"s":"Jellyfish have no brain, heart, or blood — just a nerve net."}},{"k":"green_sea_turtle","v":{"s":"Green Sea Turtle"}},{"k":"sea_turtles_navigate_using_earth_s_mag","v":{"s":"Sea turtles navigate using Earth's magnetic field."}},{"k":"firefly_squid","v":{"s":"Firefly Squid"}},{"k":"firefly_squid_produce_bioluminescent_l","v":{"s":"Firefly squid produce bioluminescent light from photophores."}},{"k":"hatchetfish","v":{"s":"Hatchetfish"}},{"k":"uses_counter_illumination_to_hide_from","v":{"s":"Uses counter-illumination to hide from predators below."}},{"k":"swordfish","v":{"s":"Swordfish"}},{"k":"swordfish_heat_their_eyes_and_brain_to","v":{"s":"Swordfish heat their eyes and brain to hunt in cold deep waters."}},{"k":"anglerfish","v":{"s":"Anglerfish"}},{"k":"the_glowing_lure_is_a_bioluminescent_b","v":{"s":"The glowing lure is a bioluminescent bacteria colony."}},{"k":"gulper_eel","v":{"s":"Gulper Eel"}},{"k":"can_unhinge_its_jaw_to_swallow_prey_la","v":{"s":"Can unhinge its jaw to swallow prey larger than itself."}},{"k":"giant_squid","v":{"s":"Giant Squid"}},{"k":"has_the_largest_eyes_in_the_animal_kin","v":{"s":"Has the largest eyes in the animal kingdom — up to 10 inches across."}},{"k":"giant_tube_worms","v":{"s":"Giant Tube Worms"}},{"k":"they_have_no_mouth_or_stomach_bacteria","v":{"s":"They have no mouth or stomach — bacteria inside them convert chemicals to energy."}},{"k":"sea_cucumber","v":{"s":"Sea Cucumber"}},{