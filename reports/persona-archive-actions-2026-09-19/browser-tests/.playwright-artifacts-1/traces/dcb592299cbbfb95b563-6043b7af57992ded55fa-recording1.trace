ocuments_20260827","v":{"s":"Unavailable documents"}},{"k":"verified_total_20260827","v":{"s":"verified / total"}},{"k":"workspace_ledger_reconciliation_completed_and_was_verified_20260826","v":{"s":"Workspace ledger reconciliation completed and was verified."}},{"k":"workspace_ledger_repair_unconfirmed_20260827","v":{"s":"The workspace ledger repair was not confirmed."}},{"k":"workspace_ledgers_could_not_be_inspected_until_the_pending_commit_is_repaired_20260826","v":{"s":"Workspace ledgers could not be inspected until the pending commit is repaired"}},{"k":"workspace_revision_20260827","v":{"s":"Workspace revision"}}],"id":757}},{"k":"engineering","v":{"o":[{"k":"access_label","v":{"s":"access:"}},{"k":"accountability_help","v":{"s":"≥"}},{"k":"accountability_label","v":{"s":"Stakeholder accountability statement"}},{"k":"accountability_ph","v":{"s":"If Ms. Patel saw this, she would still ask: does it hold up to 5 days/week of preheating cycles? Our prototype was tested 3 times — wear under daily use is untested. Next step: 5-day endurance test with a daily reset schedule."}},{"k":"acknowledge_superseded","v":{"s":"I understand — keep as a record"}},{"k":"add_candidate","v":{"s":"Add candidate"}},{"k":"add_constraint","v":{"s":"Add constraint"}},{"k":"add_criterion","v":{"s":"Add criterion"}},{"k":"add_failure_help","v":{"s":"Pick the failed test run, name the failure mode, hypothesize a cause, change ONE variable, predict the effect. Then loop back to Build & Test to run the retest with this single change."}},{"k":"add_failure_title","v":{"s":"Add a failure-loop entry"}},{"k":"attach_retest","v":{"s":"Attach a retest:"}},{"k":"back_to_hub_lanes","v":{"s":"Choose a different lane"}},{"k":"blocked_generic","v":{"s":"AI couldn't help with that — try again later."}},{"k":"blocked_prefix","v":{"s":"AI helper paused:"}},{"k":"build_mats_label","v":{"s":"Materials actually used (may differ from candidate list)"}},{"k":"build_no_ai_note","v":{"s":"No AI on Build & Test by design. AI here would drift toward proposing materials or fixes. If a test fails, loop to Optimize — that is where structural failure analysis happens, with AI critique AFTER you author the hypothesis."}},{"k":"build_photo_label","v":{"s":"Photo description (optional — describe what would be in a photo)"}},{"k":"build_timeline_label","v":{"s":"Build trajectory"}},{"k":"build_what_label","v":{"s":"What did you actually build? (this version)"}},{"k":"candidate_assumption","v":{"s":"Riskiest assumption"}},{"k":"candidate_assumption_ph","v":{"s":"If this concept fails, the most likely reason is…"}},{"k":"candidate_dominated","v":{"s":"Possibly dominated on this matrix."}},{"k":"candidate_materials","v":{"s":"Materials list"}},{"k":"candidate_name","v":{"s":"Concept name"}},{"k":"candidate_name_ph","v":{"s":"e.g. foil-wrapped insulated tote"}},{"k":"candidate_punts","v":{"s":"Constraints this concept PUNTS"}},{"k":"candidate_satisfies","v":{"s":"Constraints this concept satisfies"}},{"k":"candidate_sketch","v":{"s":"Sketch (text describing it; or a voice note; or paste a sketch URL)"}},{"k":"candidate_sketch_ph","v":{"s":"Describe the concept in enough detail that someone else could draw it."}},{"k":"candidate_voice_label","v":{"s":"Concept voice note (optional)"}},{"k":"candidates_help","v":{"s":"At least "}},{"k":"candidates_title","v":{"s":"Candidate concepts"}},{"k":"cause_hypothesis","v":{"s":"Cause hypothesis:"}},{"k":"cause_hypothesis_label","v":{"s":"Cause hypothesis (mechanism — not a restatement of the test) ≥"}},{"k":"changed_variable","v":{"s":"Changed variable:"}},{"k":"checking","v":{"s":"Checking…"}},{"k":"claim_safety_relabel","v":{"s":"relabel required — physical-safety criterion unmet"}},{"k":"claim_stale","v":{"s":"label is stale — your design changed"}},{"k":"constraint_criterion","v":{"s":"Constraint description"}},{"k":"constraint_criterion_ph","v":{"s":"e.g. total cost, total mass, max temperature, time to set up"}},{"k":"constraint_excavator_button","v":{"s":"Surface constraints I may have missed"}},{"k":"constraint_source","v":{"s":"Source"}},{"k":"constraint_target","v":{"s":"Numeric target"}},{"k":"constraint_tier","v":{"s":"Tier"}},{"k":"constraint_unit","v":{"s":"Unit"}},{"k":"constraints_help","v":{"s":"Hard limits the design must respect — each with a numeric target and a real unit. 'Must be sturdy' is not a constraint; '≥2kg static load for 30s' is."}},{"k":"constraints_title","v":{"s":"Hard constraints"}},{"k":"coverage_title","v":{"s":"Constraint coverage"}},{"k":"criteria_help","v":{"s":"What does 'good' mean — each with a unit and a direction? At least 2 (one should be physical-safety, or justify why no safety constraint applies)."}},{"k":"criteria_title","v":{"s":"Measurable criteria"}},{"k":"criterion_direction","v":{"s":"Direction"}},{"k":"criterion_kind","v":{"s":"Kind"}},{"k":"criterion_name","v":{"s":"Criterion"}},{"k":"criterion_name_ph","v":{"s":"e.g. final serve temperature, total cost, set-up time"}},{"k":"criterion_target","v":{"s":"Target"}},{"k":"criterion_unit","v":{"s":"Unit"}},{"k":"criterion_weight","v":{"s":"Weight 1-5"}},{"k":"critiquing","v":{"s":"Critiquing…"}},{"k":"cross_cutting_exemplars_title","v":{"s":"How is strong engineering recognized? (cross-cutting examples)"}},{"k":"cv_from","v":{"s":"From value"}},{"k":"cv_name","v":{"s":"Changed variable"}},{"k":"cv_to","v":{"s":"To value"}},{"k":"cycle_center_label","v":{"s":"Loops are first-class. Click any stage."}},{"k":"cycle_nav_aria","v":{"s":"Design Studio cycle navigation"}},{"k":"delta_too_small","v":{"s":"too small; rerun with a real change"}},{"k":"design_claim_ph","v":{"s":"A specific claim about the final design and its fitness…"}},{"k":"design_claims_title","v":{"s":"Design claims (≥2; each labeled and triple-anchored)"}},{"k":"direct_feedback_required","v":{"s":"Direct-access stakeholder: log their verbatim response (≥40 chars)."}},{"k":"dominated_button","v":{"s":"Which of my candidates is dominated?"}},{"k":"dominated_id","v":{"s":"AI flags as possibly dominated:"}},{"k":"dominated_just_help","v":{"s":"You can still pick it, but justify why (≥40 chars, reference a criterion by name)."}},{"k":"dominated_just_ph","v":{"s":"e.g. lower scores on temp-hold but Ms. Patel prioritizes set-up time which the matrix under-weighted…"}},{"k":"dominated_warning","v":{"s":"This candidate is Pareto-dominated on the current matrix."}},{"k":"edit_stakeholder","v":{"s":"Edit"}},{"k":"educator_panel_p1","v":{"s":"Engineering is not science. It does not converge on what is true; it optimizes a solution under constraints for a named human. There is no single correct answer — only non-dominated points on a trade-off surface."}},{"k":"educator_panel_p2","v":{"s":"Grade the LOOPS, not the polish. A session with 3 failure-loops and a candidate swap is BETTER engineering than a clean 1→6 walk. AI here asks adversarial questions only — it never proposes a design, picks a winner, or rewrites rationale."}},{"k":"educator_panel_p3","v":{"s":"Two cross-cutting rubric exemplars at lane exit reward iteration density + naming a trade-off the student would NOT have seen at Define. Grade with those."}},{"k":"educator_panel_summary","v":{"s":"For teachers: how engineering grading should work in this lane"}},{"k":"epistemic_block_msg","v":{"s":"Your stakeholder was marked invented or curriculum-prompt. \"Meets criteria\" labels are not selectable here — epistemic honesty over ergonomics."}},{"k":"epistemic_label","v":{"s":"epistemic:"}},{"k":"exemplar_required_prefix","v":{"s":"Before AI can help here:"}},{"k":"exemplar_required_suffix","v":{"s":"check this example pair (1 min)."}},{"k":"exemplar_skip","v":{"s":"I've got it — skip without judging"}},{"k":"failure_critic_button","v":{"s":"What failure modes am I missing?"}},{"k":"failure_history","v":{"s":"Failure loops"}},{"k":"failure_mode","v":{"s":"Failure mode:"}},{"k":"failure_mode_label","v":{"s":"Failure mode (what went wrong) ≥"}},{"k":"fb_observer","v":{"s":"Observer notes / proxy account"}},{"k":"fb_proxy_just","v":{"s":"Why the proxy is reliable (≥20 chars)"}},{"k":"fb_verbatim","v":{"s":"Verbatim response"}},{"k":"from_test_run","v":{"s":"Failed test run"}},{"k":"imagined_research_required","v":{"s":"Imagined stakeholder: back this with a research source in your sources list before claiming feedback."}},{"k":"inverting","v":{"s":"Voicing the antagonist…"}},{"k":"kind","v":{"s":"kind:"}},{"k":"label","v":{"s":"label:"}},{"k":"log_build_title","v":{"s":"Log a build version"}},{"k":"log_feedback","v":{"s":"Log feedback"}},{"k":"log_run","v":{"s":"Log run"}},{"k":"loopback_commit","v":{"s":"Loop back to "}},{"k":"loopback_modal_help","v":{"s":"In engineering, loops are how the design gets better. Your downstream work is preserved as a record; you can return."}},{"k":"loopback_modal_title","v":{"s":"Why are you looping back?"}},{"k":"loopback_other_placeholder","v":{"s":"Briefly: what made you loop back? (≥10 chars)"}},{"k":"material_ph","v":{"s":"cardboard, tape, foil…"}},{"k":"matrix_candidate","v":{"s":"Candidate"}},{"k":"matrix_dominated","v":{"s":"(possibly dominated)"}},{"k":"matrix_help","v":{"s":"Score each candidate against each criterion (1–5) with a reason — small weight changes flip the winner; that's the lesson. Greyed rows are computed as Pareto-dominated."}},{"k":"matrix_need_both","v":{"s":"Add at least one candidate AND one criterion to build the decision matrix."}},{"k":"matrix_reason_ph","v":{"s":"Why this score?"}},{"k":"matrix_score","v":{"s":"Σ(score×w)/Σw"}},{"k":"matrix_title","v":{"s":"Decision matrix"}},{"k":"measurability_ack_help","v":{"s":"If the AI flagged a measurability concern and you kept the constraint as is, explain why it is still binding."}},{"k":"measurability_ack_label","v":{"s":"Acknowledge AI measurability probes (≥30 chars if you keep a constraint unchanged)"}},{"k":"no_builds_yet","v":{"s":"No builds yet — your build versions and test results will appear here."}},{"k":"no_candidate_selected","v":{"s":"Loop back to Plan and select a candidate before building."}},{"k":"no_failures_yet","v":{"s":"No failed test runs to optimize against yet. Loop back to Build & Test to run more tests — failures unlock real iteration."}},{"k":"no_tradeoffs_yet","v":{"s":"No trade-offs recorded yet. Use the slider below to record one."}},{"k":"per_claim","v":{"s":"Questions about your design claim labels"}},{"k":"plan_one_ai_note","v":{"s":"Only one AI helper on this stage by design — the antagonist inversion above. AI cannot design your test, pick your trade-off axes, or tell you whose interest matters. The discipline of named sacrifice IS engineering."}},{"k":"pred_vs_reality","v":{"s":"Prediction vs reality:"}},{"k":"predicted_effect","v":{"s":"Predicted effect:"}},{"k":"predicted_effect_label","v":{"s":"Predicted effect of this change ≥"}},{"k":"problem_text_help","v":{"s":"Name the problem AND name your stakeholder. ≥"}},{"k":"problem_text_label","v":{"s":"Problem statement"}},{"k":"problem_text_ph","v":{"s":"e.g. Ms. Patel needs a way to keep 60 lunches warm from 11:00am pickup to 12:30pm classroom serve, using ≤$5 of household materials, no electrical heating allowed."}},{"k":"protocol_for","v":{"s":"Add test for"}},{"k":"protocol_instrument_ph","v":{"s":"Instrument (e.g. digital thermometer)"}},{"k":"protocol_text_ph","v":{"s":"Procedure (≥"}},{"k":"punt_required","v":{"s":"Claims to satisfy every constraint — punt at least one. Engineering means giving something up."}},{"k":"punts","v":{"s":"Punts"}},{"k":"q_adjacent_modes","v":{"s":"Adjacent failure modes to consider:"}},{"k":"q_binding","v":{"s":"Questions about whether thresholds are actually binding:"}},{"k":"q_confounds","v":{"s":"Confound questions:"}},{"k":"q_convergence","v":{"s":"Convergence-risk questions (where are concepts secretly the same?):"}},{"k":"q_edge_cases","v":{"s":"Edge-case questions:"}},{"k":"q_equity","v":{"s":"Equity probes (who else has this problem; would the solution work for them?):"}},{"k":"q_measurability","v":{"s":"Questions about measurability:"}},{"k":"q_missing_dimension","v":{"s":"Constraint dimensions you may have missed:"}},{"k":"q_pareto","v":{"s":"Pareto-dominance probes:"}},{"k":"q_realism","v":{"s":"Stakeholder-realism questions:"}},{"k":"q_residue","v":{"s":"Structural-residue questions (what about the stakeholder's situation is NOT solvable by a design artifact?):"}},{"k":"q_retest_validity","v":{"s":"Retest-validity questions:"}},{"k":"q_stake_followup","v":{"s":"Stakeholder follow-up questions:"}},{"k":"q_stakeholder_voice","v":{"s":"Questions in your stakeholder voice:"}},{"k":"q_theory_of_change","v":{"s":"Theory-of-change probes (what does each candidate ASSUME about the stakeholder?):"}},{"k":"q_tradeoff_axis","v":{"s":"Trade-off axis probes:"}},{"k":"q_unaddressed","v":{"s":"Unaddressed-constraint questions:"}},{"k":"q_why_dominated","v":{"s":"Why might it be dominated?"}},{"k":"rationale_help","v":{"s":"≥"}},{"k":"rationale_label","v":{"s":"Design rationale"}},{"k":"rationale_ph","v":{"s":"Final design holds 56°C at 90min (above the 55°C floor) using preheated ceramic + cork + foil, at $3.40 in materials, 1.95kg loaded. Traded mass for temperature-hold per Ms. Patel's priority. Failure-log: thermal bridge through ceramic base, addressed via cork (partial confirmation)."}},{"k":"reconcile","v":{"s":"Reconcile prediction vs reality:"}},{"k":"retest_delta","v":{"s":"Retest delta:"}},{"k":"return_to_stakeholder","v":{"s":"Take this back to "}},{"k":"return_to_stakeholder_aria","v":{"s":"Take this back to my stakeholder"}},{"k":"return_to_where_i_was","v":{"s":"Return to where I was: "}},{"k":"review_exemplar_again","v":{"s":"Review the example pair again"}},{"k":"safety_exemption_label","v":{"s":"If no physical-safety criterion applies, justify why (≥60 chars)"}},{"k":"safety_exemption_ph","v":{"s":"e.g. This design has no moving parts, no heat above ambient, no sharp edges, no choking hazards."}},{"k":"safety_override","v":{"s":"Safety override active."}},{"k":"safety_override_help","v":{"s":"A physical-safety constraint is unmet. Any design claim must be labeled \"partial\" or \"not yet\" — stakeholder approval cannot override physical-harm criteria."}},{"k":"sane_ack","v":{"s":"Yes, this threshold is meaningful in my context — I acknowledge the warning."}},{"k":"sane_warning_prefix","v":{"s":"Is this threshold actually binding?"}},{"k":"satisfies","v":{"s":"Satisfies"}},{"k":"save_build","v":{"s":"Save build v"}},{"k":"save_failure_entry","v":{"s":"Save failure-loop entry"}},{"k":"save_stakeholder","v":{"s":"Save stakeholder"}},{"k":"save_tradeoff","v":{"s":"Record trade-off"}},{"k":"select_candidate_title","v":{"s":"Pick the candidate you will test"}},{"k":"sr_looped_back","v":{"s":"Looped back to "}},{"k":"sr_now_on","v":{"s":"Now on: "}},{"k":"sr_work_preserved","v":{"s":"Your earlier work is preserved; you can return to where you were."}},{"k":"stake_feedback_title","v":{"s":"Stakeholder feedback"}},{"k":"stake_translator_button","v":{"s":"Questions my stakeholder would ask"}},{"k":"stakeholder_access","v":{"s":"How can you reach them?"}},{"k":"stakeholder_card_help","v":{"s":"Engineering is for someone. Naming a generic group (students / people / kids) makes constraints unfindable. Name a real person you can actually consult — or honestly mark this as imagined."}},{"k":"stakeholder_card_title","v":{"s":"Name your stakeholder (specific real person)"}},{"k":"stakeholder_epistemic","v":{"s":"How do you know what they need?"}},{"k":"stakeholder_generic_warning","v":{"s":"Too generic — pick a specific person, not a category."}},{"k":"stakeholder_group","v":{"s":"Group / role (optional)"}},{"k":"stakeholder_group_ph","v":{"s":"e.g. cafeteria manager"}},{"k":"stakeholder_missing_readonly","v":{"s":"No stakeholder named yet — loop back to Define to name one."}},{"k":"stakeholder_name","v":{"s":"Name"}},{"k":"stakeholder_name_ph","v":{"s":"e.g. Ms. Patel, my neighbor Marcus"}},{"k":"stakeholder_stale","v":{"s":"(stale — review)"}},{"k":"stakeholder_why","v":{"s":"Why this stakeholder, why now?"}},{"k":"stakeholder_why_ph","v":{"s":"What is at stake for them? Why is this design for THEM and not a generic user?"}},{"k":"superseded_banner","v":{"s":"Your work here was written against earlier upstream content. The upstream changed; this is preserved as a record of your earlier thinking."}},{"k":"surfacing","v":{"s":"Surfacing…"}},{"k":"test_protocol_title","v":{"s":"Test protocol (one per criterion)"}},{"k":"test_runs_help","v":{"s":"Numbers, not vibes. Failures are the most useful data — log them honestly."}},{"k":"test_runs_title","v":{"s":"Log measured results (one per criterion)"}},{"k":"tier_locked_post_test","v":{"s":"Hard → softer is locked after Build — use a justified loop-back."}},{"k":"tradeoff_declaration_help","v":{"s":"Name BOTH axes you weighted (the gained AND the sacrificed) by their actual criterion or constraint names. ≥"}},{"k":"tradeoff_declaration_label","v":{"s":"Trade-off declaration"}},{"k":"tradeoff_declaration_ph","v":{"s":"e.g. I picked the ceramic-stone candidate, gaining temperature-hold but sacrificing total mass — Ms. Patel said warm lunches outweigh arm strain because she has a cart."}},{"k":"tradeoff_gained","v":{"s":"Axis I gained on"}},{"k":"tradeoff_inverter_button","v":{"s":"Voice the stakeholder with inverted priorities"}},{"k":"tradeoff_inverter_help","v":{"s":"The single most under-defended move in engineering is conviction about a trade-off without ever voicing the inverse stakeholder. This AI is an antagonist — it voices a stakeholder who valued your sacrificed criterion above your gained one. It will NOT suggest a different design. After it fires, you must author a synthesis (≥80c) reckoning with what you heard."}},{"k":"tradeoff_inverter_title","v":{"s":"Inversion check (antagonist AI)"}},{"k":"tradeoff_ledger_title","v":{"s":"Trade-off ledger (one row per sacrifice)"}},{"k":"tradeoff_rank","v":{"s":"How strongly I chose this"}},{"k":"tradeoff_sacrificed","v":{"s":"Axis I sacrificed"}},{"k":"tradeoff_synthesis_label","v":{"s":"Trade-off synthesis (≥80 chars; you author this, not AI)"}},{"k":"tradeoff_synthesis_ph","v":{"s":"What did you take from the antagonist's voice? Were they right? Did your trade-off hold? Your words only — do not echo the AI's phrasing back."}},{"k":"tradeoff_whose","v":{"s":"Whose interest does this serve?"}},{"k":"tradeoff_whose_ph","v":{"s":"e.g. the kids who eat at 12:30pm, not Ms. Patel"}},{"k":"translating","v":{"s":"Translating…"}},{"k":"unit_not_whitelisted","v":{"s":"Unit not recognized — try $, g, kg, s, m, cm, °C, %, etc. 'good' is not a unit."}},{"k":"untested_hard_count","v":{"s":"untested hard constraint(s)"}},{"k":"update_tradeoff","v":{"s":"Update trade-off"}}],"id":758}},{"k":"fade","v":{"o":[{"k":"caption","v":{"s":"Each support across "}},{"k":"kind","v":{"s":"Kind"}},{"k":"kind_access","v":{"s":"access"}},{"k":"kind_scaffold","v":{"s":"scaffold"}},{"k":"kind_unknown","v":{"s":"not identified"}},{"k":"no_access","v":{"s":"A support history is only opened deliberately, with a stated purpose."}},{"k":"none_recorded","v":{"s":"No supports were recorded in these sessions. "}},{"k":"support","v":{"s":"Support"}},{"k":"title","v":{"s":"Support over time"}},{"k":"unavailable","v":{"s":"No support history is available here."}},{"k":"what_changed","v":{"s":"What changed"}},{"k":"wrong_lens","v":{"s":"This is the submission copy, which does not carry support details."}}],"id":759}},{"k":"humanities","v":{"o":[{"k":"absent_voices_help","v":{"s":"Whose voice is structurally absent from your sources — not by accident, but by archival silencing, language barrier, paywall, or surveillance risk?"}},{"k":"absent_voices_need_more","v":{"s":"Add an absent voice — proportional-growth gate"}},{"k":"absent_voices_ph","v":{"s":"e.g. Yearbook subjects from 1962-1989 who never consented to being archived"}},{"k":"absent_voices_title","v":{"s":"Absent voices"}},{"k":"acc_note_help","v":{"s":"What does shipping this commit you to? (e.g. attending the next school board meeting)"}},{"k":"acc_note_label","v":{"s":"Public accountability note"}},{"k":"acc_target_help","v":{"s":"Who specifically will see this? (e.g. the school board; the principal Ms. Patel)"}},{"k":"acc_target_label","v":{"s":"Public accountability target"}},{"k":"acknowledge_superseded","v":{"s":"I understand — keep as a record"}},{"k":"add_absent_voice","v":{"s":"Add absent voice"}},{"k":"add_framing","v":{"s":"Add framing"}},{"k":"add_plausible","v":{"s":"Add plausible answer"}},{"k":"add_source","v":{"s":"Add source"}},{"k":"add_stakeholder","v":{"s":"Add stakeholder"}},{"k":"aiq_absent_explore","v":{"s":"Absent voices you named, then might explore further:"}},{"k":"aiq_absent_voice_kinds","v":{"s":"Absent-voice kinds not yet tracked:"}},{"k":"aiq_analog_domain","v":{"s":"Analog domain ({domain}):"}},{"k":"aiq_claim_shape","v":{"s":"Claim shape:"}},{"k":"aiq_compete","v":{"s":"Framings that might compete with yours:"}},{"k":"aiq_contestable","v":{"s":"What makes this contestable?"}},{"k":"aiq_coverage_gaps","v":{"s":"Independent coverage gaps:"}},{"k":"aiq_dissolve","v":{"s":"Framings that might dissolve the question:"}},{"k":"aiq_echoed_obscuring","v":{"s":"Echoed: what you said about obscuring:"}},{"k":"aiq_echoed_visibility","v":{"s":"Echoed: what you said about visibility:"}},{"k":"aiq_foreclosure","v":{"s":"Foreclosure-coda completeness:"}},{"k":"aiq_foregrounding","v":{"s":"Foregrounding:"}},{"k":"aiq_genre_accountability","v":{"s":"Genre accountability:"}},{"k":"aiq_if_you_tried","v":{"s":"If you tried [{chip}]:"}},{"k":"aiq_lateral_missing","v":{"s":"Lateral moves still missing:"}},{"k":"aiq_occlusion","v":{"s":"Occlusion:"}},{"k":"aiq_original_audience","v":{"s":"What the original audience would have heard:"}},{"k":"aiq_presentism","v":{"s":"Presentism risks in my reading:"}},{"k":"aiq_pressure_test_via","v":{"s":"Press