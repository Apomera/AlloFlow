llscreen-dock button, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock select { flex: 1 1 calc(50% - 0.3rem); min-width: 7.25rem; }\n  .diss-canvas-frame:fullscreen .diss-fullscreen-dock label, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock label { flex: 1 1 100%; justify-content: space-between; }\n  .diss-canvas-frame:fullscreen .diss-fullscreen-dock input[type=\"range\"], .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock input[type=\"range\"] { width: min(42vw, 12rem); }\n  .diss-canvas-frame:fullscreen .diss-fullscreen-dock__handoff, .diss-canvas-frame[data-allo-fullscreen-active=\"true\"] .diss-fullscreen-dock__handoff { flex: 1 1 100%; margin-left: 0px; }\n}\n@media (max-width: 460px) {\n  .diss-stage__telemetry-head { align-items: flex-start; flex-direction: column; gap: 0.18rem; }\n  .diss-stage__telemetry-phase { max-width: 100%; text-align: left; }\n  .diss-stage__telemetry-grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); }\n  .diss-stage__telemetry-deltas { grid-template-columns: repeat(2, minmax(0px, 1fr)); }\n  .diss-field-readiness__checks { grid-template-columns: repeat(2, minmax(0px, 1fr)); }\n  .diss-stage__telemetry-foot { align-items: flex-start; flex-direction: column; gap: 0.2rem; }\n  .diss-stage__telemetry-priority { flex-basis: auto; text-align: left; }\n}\n.diss-stage__live { margin: 0.55rem 0.1rem 0px; color: rgb(54, 80, 111); font-size: 0.72rem; line-height: 1.4; }\n.diss-stage__gesture { display: flex; align-items: flex-start; gap: 0.38rem; margin: 0.42rem 0.1rem 0px; padding: 0.4rem 0.55rem; border: 1px solid rgb(184, 205, 227); border-radius: 0.6rem; background: rgb(248, 251, 255); color: rgb(41, 75, 112); font-size: 0.72rem; line-height: 1.35; font-weight: 750; }\n.diss-stage__gesture::before { content: \"\"; width: 0.58rem; height: 0.58rem; flex: 0 0 auto; margin-top: 0.26rem; border-radius: 999px; background: rgb(15, 118, 110); box-shadow: rgba(15, 118, 110, 0.16) 0px 0px 0px 3px; }\n.diss-stage__gesture[data-tone=\"working\"]::before { background: rgb(37, 99, 235); box-shadow: rgba(37, 99, 235, 0.16) 0px 0px 0px 3px; }\n.diss-stage__gesture[data-tone=\"caution\"] { border-color: rgb(227, 180, 120); background: rgb(255, 250, 242); color: rgb(124, 71, 8); }\n.diss-stage__gesture[data-tone=\"caution\"]::before { background: rgb(180, 83, 9); box-shadow: rgba(180, 83, 9, 0.16) 0px 0px 0px 3px; }\n.diss-stage__gesture[data-tone=\"restricted\"] { border-color: rgb(224, 160, 160); background: rgb(255, 245, 245); color: rgb(143, 29, 29); }\n.diss-stage__gesture[data-tone=\"restricted\"]::before { background: rgb(185, 28, 28); box-shadow: rgba(185, 28, 28, 0.16) 0px 0px 0px 3px; }\n.diss-stage__live[data-tool-status=\"true\"] { display: flex; align-items: flex-start; gap: 0.38rem; padding: 0.42rem 0.55rem; border: 1px solid rgb(184, 205, 227); border-radius: 0.6rem; background: rgb(248, 251, 255); color: rgb(41, 75, 112); font-weight: 750; }\n.diss-stage__live[data-tool-status=\"true\"]::before { content: \"\"; width: 0.58rem; height: 0.58rem; flex: 0 0 auto; margin-top: 0.28rem; border-radius: 999px; background: rgb(100, 116, 139); box-shadow: rgba(100, 116, 139, 0.16) 0px 0px 0px 3px; }\n.diss-stage__live[data-tool-status=\"true\"][data-tone=\"ready\"]::before, .diss-stage__live[data-tool-status=\"true\"][data-tone=\"complete\"]::before { background: rgb(15, 118, 110); box-shadow: rgba(15, 118, 110, 0.16) 0px 0px 0px 3px; }\n.diss-stage__live[data-tool-status=\"true\"][data-tone=\"working\"]::before { background: rgb(37, 99, 235); box-shadow: rgba(37, 99, 235, 0.16) 0px 0px 0px 3px; }\n.diss-stage__live[data-tool-status=\"true\"][data-tone=\"caution\"]::before { background: rgb(217, 119, 6); box-shadow: rgba(217, 119, 6, 0.16) 0px 0px 0px 3px; }\n.diss-stage__live[data-tool-status=\"true\"][data-tone=\"restricted\"]::before { background: rgb(185, 28, 28); box-shadow: rgba(185, 28, 28, 0.16) 0px 0px 0px 3px; }\n.diss-shortcuts { margin-top: 0.45rem; border: 1px solid rgb(203, 220, 240); border-radius: 0.7rem; background: rgb(248, 251, 255); color: rgb(54, 80, 111); }\n.diss-shortcuts summary { min-height: 2.25rem; display: flex; align-items: center; cursor: pointer; padding: 0.45rem 0.65rem; color: rgb(36, 81, 127); font-size: 0.68rem; font-weight: 850; }\n.diss-shortcuts__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 0.35rem; padding: 0px 0.65rem 0.65rem; }\n.diss-shortcuts__grid span { padding: 0.34rem 0.45rem; border: 1px solid rgb(219, 230, 243); border-radius: 0.5rem; background: rgb(255, 255, 255); font-size: 0.62rem; line-height: 1.35; }\n.diss-shortcuts kbd { display: inline-block; min-width: 1.35rem; margin-right: 0.25rem; padding: 0.1rem 0.28rem; border-width: 1px 1px 2px; border-style: solid; border-color: rgb(159, 179, 202); border-image: initial; border-radius: 0.28rem; background: rgb(238, 246, 255); color: rgb(23, 77, 134); font: 800 0.58rem / 1.2 Inter, system-ui; text-align: center; }\n.diss-procedure { margin-top: 0.7rem; padding: 0.75rem; border: 1px solid rgb(153, 199, 190); border-radius: 0.9rem; background: linear-gradient(145deg, rgb(240, 253, 250), rgb(248, 251, 255)); }\n.diss-procedure__summary { display: flex; min-height: 2.5rem; align-items: center; justify-content: space-between; gap: 0.65rem; cursor: pointer; color: rgb(19, 78, 74); font-size: 0.78rem; font-weight: 900; }\n.diss-procedure__summary span { color: rgb(66, 101, 104); font-size: 0.72rem; font-weight: 800; text-align: right; }\n.diss-procedure:not([open]) { padding-block: 0.45rem; }\n.diss-procedure[open] > .diss-procedure__summary { margin-bottom: 0.65rem; padding-bottom: 0.55rem; border-bottom: 1px solid rgb(185, 216, 210); }\n.diss-procedure__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }\n.diss-procedure__header h4 { margin: 0px; color: rgb(19, 78, 74); font-size: 0.82rem; font-weight: 900; }\n.diss-procedure__header p { margin: 0.2rem 0px 0px; color: rgb(66, 101, 104); font-size: 0.7rem; line-height: 1.4; }\n.diss-protocol { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 0.38rem; margin: 0.58rem 0px 0px; }\n.diss-protocol div { min-width: 0px; padding: 0.48rem 0.55rem; border: 1px solid rgb(185, 216, 210); border-radius: 0.6rem; background: rgba(255, 255, 255, 0.82); }\n.diss-protocol dt { color: rgb(71, 112, 108); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.055em; text-transform: uppercase; }\n.diss-protocol dd { margin: 0.14rem 0px 0px; color: rgb(23, 63, 60); font-size: 0.64rem; font-weight: 750; line-height: 1.35; }\n.diss-protocol div[data-aligned=\"false\"] { border-color: rgb(217, 119, 6); background: rgb(255, 251, 235); }\n.diss-protocol__align { margin-top: 0.35rem; padding: 0.28rem 0.48rem; border: 1px solid rgb(15, 118, 110); border-radius: 0.45rem; background: rgb(15, 118, 110); color: rgb(255, 255, 255); font-size: 0.6rem; font-weight: 900; cursor: pointer; min-height: 2rem !important; }\n.diss-procedure__mode { display: flex; flex: 0 0 auto; gap: 0.25rem; padding: 0.2rem; border: 1px solid rgb(185, 216, 210); border-radius: 0.65rem; background: rgb(255, 255, 255); }\n.diss-procedure__mode button { padding: 0.35rem 0.55rem; border: 0px; border-radius: 0.45rem; background: transparent; color: rgb(70, 106, 104); font-size: 0.66rem; font-weight: 850; cursor: pointer; min-height: 2rem !important; }\n.diss-procedure__mode button[aria-pressed=\"true\"] { background: rgb(15, 118, 110); color: rgb(255, 255, 255); }\n.diss-instruments { display: grid; grid-template-columns: repeat(auto-fit, minmax(5.2rem, 1fr)); gap: 0.35rem; margin-top: 0.65rem; }\n.diss-instrument { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.12rem; padding: 0.35rem 0.25rem; border: 1px solid rgb(184, 204, 201); border-radius: 0.65rem; background: rgb(255, 255, 255); color: rgb(49, 9