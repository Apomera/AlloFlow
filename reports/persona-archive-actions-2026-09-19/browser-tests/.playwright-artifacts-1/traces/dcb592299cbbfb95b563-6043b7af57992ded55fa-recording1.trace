lock_angle_calculator","v":{"s":"🕒 Clock Angle Calculator"}},{"k":"hour","v":{"s":"Hour"}},{"k":"clock_hour","v":{"s":"Clock hour"}},{"k":"minute","v":{"s":"Minute"}},{"k":"clock_minute","v":{"s":"Clock minute"}},{"k":"show_on_protractor","v":{"s":"Show on protractor"}},{"k":"show_on_protractor_2","v":{"s":"→ Show on protractor"}},{"k":"angle_unit_converter","v":{"s":"🔄 Angle Unit Converter"}},{"k":"degrees_2","v":{"s":"Degrees"}},{"k":"radians_2","v":{"s":"Radians"}},{"k":"gradians_2","v":{"s":"Gradians"}},{"k":"turns_2","v":{"s":"Turns"}},{"k":"rad_180_200_grad_0_5_turns","v":{"s":"π rad = 180° = 200 grad = 0.5 turns"}},{"k":"recent_angles","v":{"s":"📜 Recent Angles"}},{"k":"clear","v":{"s":"Clear"}},{"k":"clear_2","v":{"s":"Clear"}},{"k":"no_angles_explored_yet","v":{"s":"No angles explored yet"}},{"k":"set_angle_value","v":{"s":"Set Angle Value"}},{"k":"zero","v":{"s":"Zero"}},{"k":"two_rays_overlap_exactly_no_rotation","v":{"s":"Two rays overlap exactly. No rotation."}},{"k":"acute","v":{"s":"Acute"}},{"k":"less_than_a_right_angle_pizza_slice_le","v":{"s":"Less than a right angle. Pizza slice, \"less than square\"."}},{"k":"right","v":{"s":"Right"}},{"k":"exactly_90_corner_of_a_square_perpendi","v":{"s":"Exactly 90°. Corner of a square. Perpendicular lines."}},{"k":"obtuse","v":{"s":"Obtuse"}},{"k":"between_right_and_straight_wider_than_","v":{"s":"Between right and straight. Wider than square corner."}},{"k":"straight","v":{"s":"Straight"}},{"k":"half_rotation_the_two_rays_form_a_stra","v":{"s":"Half rotation. The two rays form a straight line."}},{"k":"reflex","v":{"s":"Reflex"}},{"k":"greater_than_a_straight_angle_measure_","v":{"s":"Greater than a straight angle. Measure the \"outside\" of the angle."}},{"k":"full_rotation","v":{"s":"Full rotation"}},{"k":"complete_turn_the_two_rays_overlap_exa","v":{"s":"Complete turn. The two rays overlap exactly (like 0°, but went all the way around)."}},{"k":"complementary_4","v":{"s":"Complementary"}},{"k":"supplementary_3","v":{"s":"Supplementary"}},{"k":"vertical_vertically_opposite","v":{"s":"Vertical (vertically opposite)"}},{"k":"adjacent_2","v":{"s":"Adjacent"}},{"k":"linear_pair","v":{"s":"Linear pair"}},{"k":"corresponding_parallel_lines_transvers","v":{"s":"Corresponding (parallel lines + transversal)"}},{"k":"alternate_interior","v":{"s":"Alternate interior"}},{"k":"alternate_exterior","v":{"s":"Alternate exterior"}},{"k":"co_interior_consecutive_interior","v":{"s":"Co-interior (consecutive interior)"}},{"k":"triangle","v":{"s":"Triangle"}},{"k":"quadrilateral","v":{"s":"Quadrilateral"}},{"k":"pentagon","v":{"s":"Pentagon"}},{"k":"hexagon","v":{"s":"Hexagon"}},{"k":"heptagon","v":{"s":"Heptagon"}},{"k":"octagon","v":{"s":"Octagon"}},{"k":"nonagon","v":{"s":"Nonagon"}},{"k":"decagon","v":{"s":"Decagon"}},{"k":"dodecagon","v":{"s":"Dodecagon"}},{"k":"n_gon_general","v":{"s":"n-gon (general)"}},{"k":"angles_reference_library","v":{"s":"📐 Angles Reference Library"}},{"k":"interactive_geometry_references_pick_a","v":{"s":"Interactive geometry references — pick a topic."}},{"k":"close_section","v":{"s":"✕ Close section"}},{"k":"angles_trig","v":{"s":"Angles & Trig"}},{"k":"types","v":{"s":"Types"}},{"k":"relationships","v":{"s":"Relationships"}},{"k":"special_angles","v":{"s":"Special angles"}},{"k":"angle_units","v":{"s":"Angle units"}},{"k":"trig_functions","v":{"s":"Trig functions"}},{"k":"pythagorean","v":{"s":"Pythagorean"}},{"k":"classic_theorems","v":{"s":"Classic theorems"}},{"k":"shortcuts","v":{"s":"Shortcuts"}},{"k":"shapes_solids","v":{"s":"Shapes & Solids"}},{"k":"triangle_types","v":{"s":"Triangle types"}},{"k":"polygon_angles","v":{"s":"Polygon angles"}},{"k":"circle_geometry","v":{"s":"Circle geometry"}},{"k":"conic_sections","v":{"s":"Conic sections"}},{"k":"3d_solids","v":{"s":"3D solids"}},{"k":"platonic_solids","v":{"s":"Platonic solids"}},{"k":"famous_curves","v":{"s":"Famous curves"}},{"k":"shape_facts","v":{"s":"Shape facts"}},{"k":"coords_transforms","