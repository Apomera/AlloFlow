    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/10419.png",
      "text": "Kani waa Agnes. Waa macallimadayda.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=1",
      "sourceDigest": "sha256:2d8ccbc77b7c714c376b50fb001841808367123015fd8c9a0218c33bca303179"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/10418.png",
      "text": "Agnes waxay isticmaashaa ulaha lagu socdo si ay u socoto.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=2",
      "sourceDigest": "sha256:c1f81f087b24fe4227b62593256df77c86dfa2652b4b080c167b2943b26e8b21"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/10420.png",
      "text": "Kani waa Metobo. Waa DJ-ga raadiyaha ee aan ugu jecelahay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=3",
      "sourceDigest": "sha256:a4afa9453ca388b4de5a625aa0525891a211f1768845bf8d05d5cfe7edb9a703"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/10421.png",
      "text": "Metobo wuxuu qabaa dhibaato indhaha ah.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=4",
      "sourceDigest": "sha256:873eb86d82d5dff7119c5aa15efcc955474db29e5b94135fa82326113c511ea1"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/10422.png",
      "text": "Kani waa Moraa, deriskayga. Moraa waa beeraley.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=5",
      "sourceDigest": "sha256:1a4ac3cf8a3b02a891799fdd4a3fc4eb8d7d0d36ce5994faad3827de8bc2245d"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/10424.png",
      "text": "Moraa ma maqli karto. Waxay ku hadashaa luqadda calaamadaha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=6",
      "sourceDigest": "sha256:46a0877e6ae1ab237842b00774cc396d4733b0f06060ba7629cb6b521d43b086"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/10425.png",
      "text": "Kani waa Osero. Waa ciyaaryahanka kubadda cagta ee ugu fiican dugsigayga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=7",
      "sourceDigest": "sha256:30a3498c2be79d28a572bc82409401cbf51c51dc1f57d18914d2b1e9a627b6b9"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/10426.png",
      "text": "Osero ma laha gacmo. Laakiin goolal badan ayuu u dhaliyay kooxdeena.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52495#page=8",
      "sourceDigest": "sha256:427d3b301bd5ac51b933a5cb8f498aa7df23c5421550b2659c916f2e668f36b3"
    }
