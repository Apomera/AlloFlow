+import { afterEach, beforeAll, describe, expect, it } from 'vitest';
+import { fixtures, payload, copy, translator, setupDraftReader, cleanupDraftReader, mountDraft, click } from './helpers/reader_draft_locale_harness.js';
+beforeAll(setupDraftReader); afterEach(cleanupDraftReader);
+const notice = h => [...h.host.querySelectorAll('[role=status]')].find(n => n.querySelector('button'));
+const owned = value => { expect(value).not.toMatch(/simplified\.gloss_|\{chooseOccurrence\}/); expect(value.trim()).not.toBe(''); };
+describe.each(fixtures.filter(f => f.reselectable !== false))('$id', f => {
+  it.each([true, false])('retains and explicitly reanchors a localized draft (adapted=%s)', async adapted => {
+    const h = mountDraft(f, { adapted }), answer = f.word + ' $& {literal}'; await h.edit(answer); h.change();
+    const warning = notice(h), action = copy(f, 'gloss_draft_choose_occurrence');
+    expect(warning?.textContent).toBe(copy(f, 'gloss_draft_passage_changed').replace('{chooseOccurrence}', () => action)); owned(warning.textContent);
+    expect(h.input().value).toBe(answer); expect(h.saveButton().disabled).toBe(true); expect(h.session.hasChanges()).toBe(true);
+    await click(warning.querySelector('button')); expect(notice(h)).toBeUndefined(); expect(h.input().value).toBe(answer);
+    await click(h.saveButton());
+    expect(h.onUpdate).toHaveBeenCalledTimes(1); expect(h.saved().annotations[0]).toMatchObject({ quote: f.word, start: f.changed.indexOf(f.word), text: answer });
+    expect(h.host.textContent).toContain(copy(f, 'gloss_save_word_support_confirmed')); expect(h.session.hasChanges()).toBe(false);
+    expect(adapted ? h.current().data : h.current().sourceSnapshot.text).toBe(f.changed);
+  });
+  it('keeps the occurrence action disabled until refreshed supports are reviewed', async () => {
+    const h = mountDraft(f); await h.edit(f.word); h.change(true);
+    expect(notice(h).querySelector('button').disabled).toBe(true); await click(notice(h).querySelector('button'));
+    expect(h.saveButton().disabled).toBe(true); expect(h.input().value).toBe(f.word); expect(h.onUpdate).not.toHaveBeenCalled();
+  });
+  it('saves before continuing through a translated pending action', async () => {
+    const h = mountDraft(f); await h.edit(f.word); await h.requestAdd();
+    const pending = h.host.querySelector('[role=alertdialog]'); expect(pending).toBeTruthy();
+    const button = h.button(copy(f, 'gloss_save_and_continue')); expect(button).toBeTruthy(); owned(button.textContent); await click(button);
+    expect(h.onUpdate).toHaveBeenCalledTimes(1); expect(h.host.querySelector('[role=alertdialog]')).toBeNull();
+    expect(h.saved().annotations[0].text).toBe(f.word); expect(h.input().value).toBe('');
+  });
+  it.each([['missing','gloss_save_support_unconfirmed'],['partial','gloss_save_changes_unconfirmed']])('retains an unconfirmed %s save and blocks continuing', async (outcome, key) => {
+    const h = mountDraft(f, { outcome }); await h.edit(f.word); await h.requestAdd(); await click(h.button(copy(f, 'gloss_save_and_continue')));
+    expect(h.host.querySelector('[role=alertdialog]')).toBeTruthy(); expect(h.session.hasChanges()).toBe(true); expect(h.input().value).toBe(f.word);
+    const alert = h.host.querySelector('[role=alert]'); expect(alert?.textContent).toBe(copy(f, key)); owned(alert.textContent);
+  });
+});
+const arabic = fixtures.find(f => f.locale === 'arabic');
+describe('inline warning action and readable fallback', () => {
+  it.each(['{chooseOccurrence} ثم راجع النص.','راجع النص. {chooseOccurrence}'])('can place the real action at either sentence edge: %s', async template => {
+    const t = translator(arabic, { gloss_draft_passage_changed: template }), h = mountDraft(arabic, { translate: t }); await h.edit(arabic.word); h.change();
+    const warning = notice(h); expect(warning.textContent).toBe(template.replace('{chooseOccurrence}', () => copy(arabic, 'gloss_draft_choose_occurrence')));
+    expect(warning.querySelectorAll('button')).toHaveLength(1); expect(warning.firstChild.nodeType === 1).toBe(template.startsWith('{chooseOccurrence}'));
+    await click(warning.querySelector('button')); expect(h.saveButton().disabled).toBe(false);
+  });
+  it.each(['No action slot.','{chooseOccurrence}{chooseOccurrence}','{chooseOccurrence} {other}','{chooseOccurrence','{chooseOccurrence} }'])('falls back completely when the action slot is malformed: %s', async template => {
+    const h = mountDraft(arabic, { translate: translator(arabic, { gloss_draft_passage_changed: template }) }); await h.edit(arabic.word); h.change();
+    const warning = notice(h), english = payload.english;
+    expect(warning.textContent).toBe(english['simplified.gloss_draft_passage_changed'].replace('{chooseOccurrence}', () => english['simplified.gloss_draft_choose_occurrence']));
+    expect(warning.querySelectorAll('button')).toHaveLength(1); owned(warning.textContent); await click(warning.querySelector('button')); expect(h.saveButton().disabled).toBe(false);
+  });
+  it.each(['missing','echo','empty','throws','object'])('uses readable English when draft lookups are %s', async mode => {
+    const base = translator(arabic), t = (key, params) => key.startsWith('simplified.gloss_draft_') ? mode === 'missing' ? undefined : mode === 'echo' ? key : mode === 'empty' ? ' ' : mode === 'object' ? {} : (() => { throw Error('lookup failed'); })() : base(key, params);
+    const h = mountDraft(arabic, { translate: t }); await h.edit(arabic.word); h.change();
+    const english = payload.english; expect(notice(h).textContent).toBe(english['simplified.gloss_draft_passage_changed'].replace('{chooseOccurrence}', () => english['simplified.gloss_draft_choose_occurrence']));
+    expect(h.input().value).toBe(arabic.word); owned(notice(h).textContent);
+  });
+  it('renders markup-looking translation as text while keeping exactly one real button', async () => {
+    const template = '<img src=x onerror=alert(1)> {chooseOccurrence} <script>bad()</script>';
+    const h = mountDraft(arabic, { translate: translator(arabic, { gloss_draft_passage_changed: template }) }); await h.edit(arabic.word); h.change();
+    const warning = notice(h); expect(warning.querySelector('img,script')).toBeNull(); expect(warning.querySelectorAll('button')).toHaveLength(1);
+    expect(warning.textContent).toContain('<img src=x onerror=alert(1)>');
+  });
+});
+
+// Existing exact-whole-word behavior, not an acceptance claim for subword support.
+it('draft_zh_compound_subword_v1 retains work when a supplied subword cannot be reselected', async () => {
+  const f = fixtures.find(f => f.reselectable === false), h = mountDraft(f); await h.edit('Retained subword explanation.'); h.change();
+  await click(notice(h).querySelector('button')); await click(h.saveButton());
+  expect(h.onUpdate).not.toHaveBeenCalled(); expect(h.session.hasChanges()).toBe(true); expect(h.input().value).toBe('Retained subword explanation.');
+  expect(h.saveButton().disabled).toBe(true);
+  expect(h.host.textContent).toContain('No exact whole-word or phrase match. Copy the word or phrase as it appears in the adapted text.');
+});
