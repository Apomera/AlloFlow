    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/12086.png",
      "text": "Khotso o palame tonki. Tonki ea Khotso e putsoa. Khotso oja le tonki ea hae.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=1",
      "sourceDigest": "sha256:dac6bbf254993598709fcd5b3f11dd35d5d4dce7b542a8d1e71e2c919f5fee0c"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/12085.png",
      "text": "Nkhono MaThabo o ea pheha. O phehile ka pitsa ents'o. Oja le katse ea hae.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=2",
      "sourceDigest": "sha256:04148421e71668169457ff60051216d8c0e84056a4e881ae4c1301b5e0ae4157"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/12087.png",
      "text": "Khomo ea Neo e tala ba bojoang. Khomo ea Neo e mohata leoto la hae. Neo a qhala lebese la hae ka khameloaneng.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=3",
      "sourceDigest": "sha256:8bac7aac2f6bf6e7d10536ef948c76c859d887f6ae797e88c5b13e22e95f7966"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/12088.png",
      "text": "Ntate Phakane o na le pitsi ents'o. Pitsi ea hae e matla haholo. E hula mohoma e le 'ngoe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=4",
      "sourceDigest": "sha256:1462842f56ccfeb892ec92d61a19901788a2d47aa790314a0e9913a98c4e847c"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/12089.png",
      "text": "Thabang o ea khanna koloi ea hae. O palamisitse ntja ea hae. Ntja ea Thabang e kakela ka koloing!",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=5",
      "sourceDigest": "sha256:14402ba31389a55ec3bbc83944b25dda04a99ce0341bcd6417789660baf3cc16"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/12090.png",
      "text": "Khomo, pere, tonki, le katse lika koloing ea Ntate Thabang. Kaofela hoatsona libinela lijo tsa tsona tsa mantsibuoa. Ke mang o nahanang hore lentsoe la hae le monate?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=13305#page=6",
      "sourceDigest": "sha256:cd046b440e8d19b33ebe17a848afcfcbb80017bde9c32553c5c5d5ec0a8a77f7"
    }
  ],
