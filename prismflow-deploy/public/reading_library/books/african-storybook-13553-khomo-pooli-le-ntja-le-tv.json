      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/10566.png",
      "text": "Eaba Khomo eona e reka TV.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=13553#page=2",
      "sourceDigest": "sha256:13e5d7502d8bed11009efdce513dec100ff58fef79bc044ac3cbd5541c6c3cbf"
