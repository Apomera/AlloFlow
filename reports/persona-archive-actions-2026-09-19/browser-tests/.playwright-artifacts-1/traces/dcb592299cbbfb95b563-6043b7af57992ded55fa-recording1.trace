move right"}},{"k":"moves_left","v":{"s":"move left"}},{"k":"equal_hops","v":{"s":"Equal hops on a number line"}},{"k":"hop_scale_note","v":{"s":"The spacing represents value. Square: start; circles: landings. The start is zero hops."}},{"k":"hops_completed","v":{"s":"Hops completed: "}},{"k":"restart_hops","v":{"s":"Start at zero hops"}},{"k":"previous_hop","v":{"s":"Previous hop"}},{"k":"next_hop","v":{"s":"Next hop"}},{"k":"show_all_hops","v":{"s":"Show all hops"}},{"k":"predict_next_hop","v":{"s":"Predict the next landing before choosing Next hop."}},{"k":"explain_hops","v":{"s":"Explain how the start, number of hops, and hop size appear in the equation."}},{"k":"hop_sequence","v":{"s":"Start and landings"}},{"k":"hop_start","v":{"s":"Start · 0 hops"}},{"k":"hop_number","v":{"s":"Hop "}},{"k":"hide_hop_markers","v":{"s":"Hide markers on line"}},{"k":"show_hop_markers","v":{"s":"Show markers on line"}},{"k":"nav_fractions_decimals","v":{"s":"Fractions & decimals"}},{"k":"nav_compare_fractions","v":{"s":"Compare fractions"}},{"k":"about_model","v":{"s":"About this activity"}},{"k":"start_explore","v":{"s":"Set the minimum and maximum, then enter a marker value and choose Add."}},{"k":"start_challenges","v":{"s":"Choose a challenge, enter your answer or place a marker, then check your work."}},{"k":"start_skipcount","v":{"s":"Choose a starting number and a step size, then use the playback controls to follow the jumps."}},{"k":"start_fracdec","v":{"s":"Enter a fraction or decimal to see where it belongs on the line."}},{"k":"start_magCompare","v":{"s":"Change the two fractions and compare their positions. Record what you notice."}},{"k":"scroll_hint","v":{"s":"Scroll sideways to see the full number line."}}],"id":555}},{"k":"nutritionlab","v":{"o":[{"k":"a11y_energy_after_meal_from_1_to_10","v":{"s":"Energy after meal, from 1 to 10"}},{"k":"a11y_daily_water_target_in_milliliters","v":{"s":"Daily water target in milliliters"}},{"k":"a11y_water_amount_in_milliliters",