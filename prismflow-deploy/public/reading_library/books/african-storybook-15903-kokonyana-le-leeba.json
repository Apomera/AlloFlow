  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/784.png",
      "text": "Ho ne ho chesa. Ho ne ho omeletse. Kokonyana e ne e nyeriloe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=1",
      "sourceDigest": "sha256:5ef4ef02b1df25ad0190e7857496885350d91d901257c5cd24a052aed08e91b6"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/785.png",
      "text": "\"Ke batla metsi,\" ho rialo Kokonyana. Ho ne ho sena metsi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=2",
      "sourceDigest": "sha256:7ada4a065a7ec238bd7d6704fc8185c65dc6e44f2723774e1a7fe065233c9855"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/870.png",
      "text": "\"Ke tla batla noka moo e leng teng,\" ho rialo Kokonyana. \"E be ke tla noa,\" ho rialo Kokonyana. Eaba, \"Mutlanyana o re, o hlokomele hantle, noka e kotsi haholo!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=3",
      "sourceDigest": "sha256:ea1b6797ed380b79782510aacc412e27dbe6f6df9cc0ba735be1f76f6a81aff0"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/871.png",
      "text": "Kokonyana ea tsamaea holo batla noka. Ea tsamaea nako e telele. Ea fumana noka. Ea noa metsi a noka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=4",
      "sourceDigest": "sha256:6929b109e21b8fd6b85390366f1b2066e7127ea9974839ed4244c4bd58070ef0"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/876.png",
      "text": "Aaiee! Ea oela ka nokeng. \"Nthuseng, nthuseng, ke ea kopa, oee!\" a hoelehelitse ka lerata.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=5",
      "sourceDigest": "sha256:c88871bd6f70b89b9a2b376adbb4018462de31c3ddc7459ce2a136a1b2a5a1a3"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/877.png",
      "text": "Leeba le lesoeu la tla le nkile thupa. Leeba lena la re, \"Ts'oara thupa ena. Ke tla u thusa.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=6",
      "sourceDigest": "sha256:bef2f5ddf5859af26e04a0fcfd9207f93365ef86e5aca9980237e935b19d31cb"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/878.png",
      "text": "Kokonyana ea khona ho hloella thupeng. Leeba la fofa le nkile Kokonyana ena ka thupa. Eaba ke ho pholoha hoa Kokonyana.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=7",
      "sourceDigest": "sha256:f4d9f73d661561898dc6632f6a38bf956f7cecb44d028db1afdb8eded4c79fd9"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/879.png",
      "text": "\"Ke tlameha ho leboha leeba,\" ke Kokonyana eo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=8",
      "sourceDigest": "sha256:63b628137c1c0fa57c9271fdbc41e8b1d83df0c46acea96c548c3efd7a4c61ef"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/880.png",
      "text": "Bashanyana ba babeli ba ea nokeng. Ba nkile liqha. Ba ne ba batla hoja nama ea leeba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=9",
      "sourceDigest": "sha256:8729eae0c937b8c3e6c84ebf5df6afd078cb2ef3f8b4204a04489364d5e57150"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/887.png",
      "text": "\"Oh, aee, ke tlameha ho thiba bashanyana bana ba se ke ba bolaea Leeba,\" ho rialo Kokonyana. Kokonyana eaba le menahano e meng. Ea qhomela holim'a leoto la moshanyana e mong. Ea moloma.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=10",
      "sourceDigest": "sha256:8cad7612947b6dd86a01cbee99dc048f4cc9dfed67818c523b2b781a8eab0747"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/904.png",
      "text": "\"Heleee!\" a bua ka bohale. A etsa lerata. Leeba le lesoeu la fofa. La pholoha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=11",
      "sourceDigest": "sha256:9eb8dc83239218dac7f0dd7c769a8c19d4dd09ab5dfa598fbb36595de41ed8b2"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/889.png",
      "text": "\"Ke ea leboha Kokonyana, ke ea leboha!\" ho rialo Leeba. Ke ts'omo ka mathetho.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=2&dual=false&id=15903#page=12",
      "sourceDigest": "sha256:85d75d1dbf834af493661fcc4e73f437dd3677c19d094e8c9f5a2bd4a4114444"
    }
  ],
