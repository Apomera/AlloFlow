p p { margin: 0px; }\n.ei-app h1 { font-size: clamp(27px, 3.2vw, 43px); font-weight: 750; letter-spacing: -1.5px; line-height: 1.1; }\n.ei-app h2 { font-size: 19px; font-weight: 750; }\n.ei-app h3 { font-size: 15px; font-weight: 750; }\n.ei-app p { line-height: 1.55; }\n.ei-app button, .ei-app select, .ei-app input { font: inherit; }\n.ei-app button { cursor: pointer; min-height: 42px; border: 1px solid var(--ei-line); border-radius: 10px; padding: 9px 13px; background: var(--ei-paper); color: var(--ei-ink); font-weight: 650; line-height: 1.3; }\n.ei-app button:hover:not(:disabled) { background: rgb(233, 239, 223); border-color: rgb(115, 147, 131); }\n.ei-app button:disabled { cursor: default; opacity: 0.48; }\n.ei-app :is(button, select, input, summary, a):focus-visible { outline: rgb(174, 89, 29) solid 3px; outline-offset: 3px; }\n.ei-app .ei-primary { background: rgb(37, 92, 71); color: rgb(255, 254, 247); border-color: rgb(37, 92, 71); }\n.ei-app .ei-primary:hover:not(:disabled) { background: rgb(22, 77, 56); color: rgb(255, 254, 247); }\n.ei-app .ei-quiet { background: transparent; }\n.ei-app select, .ei-app input[type=\"text\"] { width: 100%; min-height: 42px; padding: 8px; border: 1px solid rgb(140, 158, 145); border-radius: 8px; background: white; color: rgb(32, 61, 54); }\n.ei-app input[type=\"range\"] { accent-color: rgb(37, 92, 71); width: 100%; min-height: 30px; }\n.ei-app label { font-size: 13px; font-weight: 650; }\n.ei-app summary { cursor: pointer; font-weight: 700; min-height: 36px; padding: 6px 0px; }\n.ei-app small, .ei-small { font-size: 12px; color: var(--ei-muted); line-height: 1.5; }\n.ei-kicker { font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: rgb(84, 114, 100); }\n.ei-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.ei-between { justify-content: space-between; }\n.ei-stack { display: grid; gap: 13px; }\n.ei-header { max-width: 1440px; margin: 0px auto 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n.ei-title { display: grid; gap: 6px; }\n.ei-header p { font-size: 14px; color: var(--ei-muted); }\n.ei-shell { max-width: 1440px; margin: auto; }\n.ei-mission { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 13px 17px; border: 1px solid var(--ei-line); border-radius: 12px; background: rgb(231, 237, 221); margin-bottom: 17px; font-size: 12px; }\n.ei-mission strong { font-size: 13px; }\n.ei-mission span { display: flex; align-items: center; gap: 6px; }\n.ei-mission b { display: inline-flex; border: 1px solid rgb(106, 132, 115); border-radius: 50%; width: 22px; height: 22px; align-items: center; justify-content: center; font-size: 11px; }\n.ei-mission .ei-done b { background: rgb(37, 92, 71); color: white; }\n.ei-board { display: grid; grid-template-columns: minmax(0px, 1fr) 292px; gap: 17px; align-items: start; }\n.ei-main { min-width: 0px; display: grid; gap: 14px; }\n.ei-card { border: 1px solid var(--ei-line); background: var(--ei-paper); border-radius: 15px; padding: 18px; min-width: 0px; }\n.ei-card-head { margin-bottom: 13px; }\n.ei-habitat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.ei-app .ei-habitat { font-size: 12px; text-align: left; min-height: 70px; padding: 10px; }\n.ei-habitat i { display: block; font-style: normal; font-size: 19px; margin-bottom: 4px; }\n.ei-app .ei-habitat[aria-pressed=\"true\"] { background: rgb(230, 238, 207); border: 2px solid rgb(83, 114, 72); padding: 9px; }\n.ei-switch { display: flex; gap: 9px; align-items: flex-start; font-size: 12px; line-height: 1.5; }\n.ei-switch input { margin-top: 3px; accent-color: rgb(37, 92, 71); width: 17px; height: 17px; flex-shrink: 0; }\n.ei-switch small { display: block; font-weight: 400; }\n.ei-stage { position: relative; border: 1px solid rgb(185, 205, 186); border-radius: 18px; overflow: hidden; background: rgb(213, 235, 221); }\n.ei-stage-wrap { position: relative; }\n.ei-scene { height: 480px; position: relative; overflow: hidden; }\n.ei-stage-top { position: absolute; z-index: 2; top: 17px; left: 18px; right: 18px; display: flex; justify-content: space-between; gap: 12px; pointer-events: none; }\n.ei-stage-label { background: rgba(255, 254, 244, 0.92); padding: 10px 13px; border-radius: 11px; border: 1px solid rgb(188, 207, 189); box-shadow: rgba(22, 60, 54, 0.07) 0px 3px 14px; }\n.ei-stage-label strong { font-size: 14px; }\n.ei-stage-label small { display: block; }\n.ei-live-dot { display: inline-block; width: 7px; height: 7px; background: rgb(41, 115, 84); border-radius: 50%; margin-right: 6px; }\n.ei-camera { position: absolute; bottom: 47px; left: 14px; display: flex; gap: 5px; }\n.ei-camera button { min-width: 40px; padding: 7px; background: rgba(255, 254, 248, 0.93); font-size: 18px; }\n.ei-scene-caption { padding: 10px 15px; font-size: 11px; background: rgb(237, 242, 230); border-top: 1px solid rgb(198, 216, 198); color: rgb(53, 86, 74); line-height: 1.5; }\n.ei-loading { position: absolute; top: 45%; left: 15%; right: 15%; text-align: center; font-size: 14px; }\n.ei-fallback { position: absolute; inset: 85px 20px 65px; z-index: 1; background: rgb(241, 243, 229); border-radius: 16px; padding: 15px; font-size: 12px; overflow: auto; }\n.ei-map { margin-top: 15px; display: flex; flex-wrap: wrap; gap: 8px; border-radius: 40%; padding: 30px; justify-content: center; }\n.ei-app .ei-map-creature { border-radius: 45%; min-height: 32px; min-width: 32px; padding: 4px; color: white; font-size: 10px; text-shadow: rgb(0, 0, 0) 0px 1px 3px; }\n.ei-transport { display: grid; gap: 12px; padding: 15px 18px; }\n.ei-generations { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; font-size: 12px; }\n.ei-generation { font-variant-numeric: tabular-nums; font-weight: 800; }\n.ei-app .ei-speed { width: auto; min-width: 84px; min-height: 40px; font-size: 12px; }\n.ei-story { border-left: 3px solid rgb(161, 179, 125); padding-left: 13px; font-size: 13px; color: rgb(56, 83, 69); }\n.ei-loop { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--ei-line); border-radius: 12px; overflow: hidden; background: rgb(255, 254, 248); }\n.ei-loop > div { padding: 13px 10px; border-right: 1px solid var(--ei-line); }\n.ei-loop > div:last-child { border-right: 0px; }\n.ei-loop strong { display: block; font-size: 20px; letter-spacing: -0.5px; }\n.ei-loop small { display: block; font-size: 10px; }\n.ei-organism { display: flex; align-items: center; gap: 12px; margin: 10px 0px; }\n.ei-portrait { width: 72px; height: 76px; flex-shrink: 0; }\n.ei-trait { display: grid; grid-template-columns: 1fr auto; gap: 4px; font-size: 12px; }\n.ei-meter { grid-column: 1 / -1; height: 6px; border-radius: 6px; background: rgb(231, 234, 221); overflow: hidden; }\n.ei-meter > span { display: block; height: 100%; border-radius: 6px; }\n.ei-parents { display: flex; gap: 6px; flex-wrap: wrap; }\n.ei-app .ei-parents button { font-size: 11px; padding: 5px 9px; min-height: 32px; }\n.ei-tag { padding: 4px 8px; border-radius: 20px; background: rgb(233, 236, 217); font-size: 10px; font-weight: 750; color: rgb(69, 94, 67); }\n.ei-evidence { display: grid; grid-template-columns: minmax(0px, 1.5fr) minmax(260px, 1fr); gap: 17px; margin-top: 17px; }\n.ei-chart { width: 100%; height: auto; display: block; }\n.ei-chart text { font-size: 11px; fill: rgb(73, 100, 85); }\n.ei-chart-legend { display: flex; gap: 13px; flex-wrap: wrap; font-size: 11px; }\n.ei-chart-legend span::before { content: \"\"; display: inline-block; width: 17px; height: 3px; background: var(--trait-color); vertical-align: middle; margin-right: 5px; }\n.ei-table-wrap { overflow: auto; }\n.ei-app table { border-collapse: collapse; width: 100%; font-size: 12px; margin-top: 10px; }\n.ei-app td, .ei-app th { padding: 8px 9px; border-bottom: 1px solid var(--ei-line); text-align: left; white-space: nowrap; }\n.ei-app th { font-weight: 750; }\n.ei-callout { padding: 12px; border-radius: 10px; background: rgb(237, 240, 223); font-size: 12px; line-height: 1.6; }\n.ei-app .ei-warning { background: rgb(246, 234, 216); color: rgb(110, 74, 34); }\n.ei-app a { color: rgb(37, 92, 71); text-decoration: underline; }\n.ei-reset { margin-top: 15px; border-top: 1px solid var(--ei-line); padding-top: 10px; }\n.ei-expedition { background: rgb(24, 62, 53); color: rgb(255, 249, 223); padding: 30px; border-radius: 20px; display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; align-items: center; overflow: hidden; position: relative; margin-bottom: 22px; }\n.ei-expedition h2 { font-size: clamp(30px, 4vw, 48px); letter-spacing: -1.8px; line-height: 1.06; font-weight: 750; margin: 9px 0px 14px; }\n.ei-expedition p { color: rgb(218, 231, 212); font-size: 14px; }\n.ei-expedition .ei-kicker { color: rgb(202, 226, 163); }\n.ei-expedition .ei-primary { background: rgb(230, 240, 189); border-color: rgb(230, 240, 189); color: rgb(36, 71, 52); margin-top: 20px; padding: 13px 20px; }\n.ei-expedition-art { height: 240px; position: relative; display: flex; align-items: center; justify-content: center; }\n.ei-mini-island { position: absolute; width: 95%; height: 60%; background: rgb(120, 149, 99); border: 12px solid rgb(165, 175, 122); box-shadow: rgb(143, 128, 96) 0px 17px 0px, rgb(87, 109, 83) 0px 22px 0px, rgba(7, 31, 35, 0.4) 0px 35px 45px; border-radius: 50%; transform: rotate(-10deg); }\n.ei-mini-creatures { position: relative; display: flex; gap: 0px; width: 90%; align-items: center; justify-content: center; transform: translateY(-30px); }\n.ei-mini-creatures svg { width: 38%; height: 130px; filter: drop-shadow(rgba(31, 63, 52, 0.133) 0px 10px 0px); }\n.ei-mini-creatures svg:nth-child(2) { transform: translateY(-20px) scale(0.8); }\n@media (min-width: 1500px) {\n  .ei-scene { height: 560px; }\n}\n@media (max-width: 1000px) {\n  .ei-app { padding: 16px; }\n  .ei-board { grid-template-columns: minmax(0px, 1fr) 260px; }\n  .ei-scene { height: 420px; }\n  .ei-card { padding: 14px; }\n}\n@media (max-width: 760px) {\n  .ei-board, .ei-evidence { grid-template-columns: 1fr; }\n  .ei-side { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }\n  .ei-side > .ei-card { margin: 0px; }\n  .ei-scene { height: 420px; }\n  .ei-header { margin-bottom: 15px; }\n  .ei-expedition { grid-template-columns: 1fr; padding: 24px; }\n  .ei-expedition-art { height: 150px; }\n  .ei-mini-creatures svg { height: 110px; }\n  .ei-mission { gap: 8px; }\n  .ei-kicker { letter-spacing: 1.3px; }\n}\n@media (max-width: 480px) {\n  .ei-app { padding: 10px; }\n  .ei-side { grid-template-columns: 1fr; }\n  .ei-scene { height: 365px; }\n  .ei-stage-top { left: 10px; right: 10px; top: 10px; }\n  .ei-stage-label { padding: 8px; }\n  .ei-stage-label strong { font-size: 12px; }\n  .ei-loop strong { font-size: 18px; }\n  .ei-loop > div { padding: 9px 7px; }\n  .ei-loop small { font-size: 10px; }\n  .ei-app h1 { font-size: 30px; }\n  .ei-app .ei-header button { font-size: 12px; }\n  .ei-generations { gap: 7px; }\n  .ei-transport { padding: 13px; }\n  .ei-expedition-art { height: 130px; }\n}\n.ei-stack { align-content: start; }\n.ei-stage-wrap { --ei-scene-h: 480px; }\n.ei-scene { height: var(--ei-scene-h); }\n.ei-camera { bottom: auto; top: calc(var(--ei-scene-h) - 55px); }\n.ei-app .ei-closeup { position: absolute; right: 14px; top: calc(var(--ei-scene-h) - 55px); font-size: 12px; background: rgba(255, 254, 248, 0.93); }\n.ei-log { display: grid; gap: 10px; font-size: 12px; }\n.ei-log-entry { display: grid; grid-template-columns: 40px 1fr; gap: 10px; border-top: 1px solid rgb(225, 230, 216); padding-top: 10px; }\n.ei-log-entry:first-child { border: 0px; padding-top: 0px; }\n.ei-log-entry b { color: rgb(65, 110, 80); font-size: 11px; }\n.ei-log-entry small { display: block; }\n.ei-app .ei-log-jump { min-height: 30px; padding: 3px 7px; font-size: 10px; }\n@media (min-width: 1500px) {\n  .ei-stage-wrap { --ei-scene-h: 560px; }\n}\n@media (max-width: 1000px) {\n  .ei-stage-wrap { --ei-scene-h: 420px; }\n}\n@media (max-width: 480px) {\n  .ei-stage-wrap { --ei-scene-h: 365px; }\n  .ei-app .ei-closeup { top: 80px; right: 10px; }\n}\n.ei-landscape-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 12px 15px; background: rgb(248, 250, 240); border-top: 1px solid rgb(198, 216, 198); }\n.ei-landscape-bar strong { display: block; font-size: 12px; }\n.ei-landscape-bar small { display: block; font-size: 10px; margin-top: 2px; }\n.ei-viewpoints { display: flex; gap: 5px; flex-wrap: wrap; }\n.ei-app .ei-viewpoints button { font-size: 11px; min-height: 34px; padding: 6px 10px; border-radius: 18px; }\n.ei-landscape-bar + .ei-scene-caption { border-top: 0px; padding-top: 0px; background: rgb(248, 250, 240); }\n.ei-investigations { display: grid; gap: 12px; padding: 18px; background: rgb(230, 237, 222); border: 1px solid rgb(200, 214, 194); border-radius: 16px; margin-bottom: 18px; }\n.ei-quest-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 10px; }\n.ei-app .ei-quest-choice { position: relative; display: grid; gap: 5px; text-align: left; padding: 14px 14px 14px 48px; background: rgb(255, 254, 248); border-radius: 12px; }\n.ei-quest-choice strong { font-size: 14px; }\n.ei-quest-choice > span:not(.ei-quest-icon) { font-size: 12px; font-weight: 400; }\n.ei-quest-choice small { font-size: 10px; font-weight: 500; }\n.ei-quest-icon { position: absolute; left: 15px; top: 15px; font-size: 24px; color: rgb(66, 105, 76); }\n.ei-quest-progress { display: grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 14px; }\n.ei-quest-progress strong { display: block; font-size: 22px; letter-spacing: -0.5px; }\n.ei-quest-progress small { display: block; font-size: 11px; }\n.ei-quest-track { height: 5px; border-radius: 6px; overflow: hidden; background: rgb(202, 216, 194); }\n.ei-quest-track span { display: block; height: 100%; background: rgb(67, 111, 80); }\n.ei-replay-phases { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 7px; padding: 10px 18px; background: rgb(239, 243, 231); border-top: 1px solid rgb(198, 216, 198); }\n.ei-app .ei-replay-phases button { padding: 7px 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n.ei-replay-phases small { color: inherit; font-size: 11px; }\n.ei-replay-phases strong { font-size: 21px; }\n.ei-app .ei-replay-phases button[aria-pressed=\"true\"] { background: rgb(37, 92, 71); color: rgb(255, 254, 247); border-color: rgb(37, 92, 71); }\n.ei-app .ei-trait-select { width: auto; max-width: 100%; font-size: 12px; min-height: 36px; }\n.ei-distributions { display: grid; gap: 7px; }\n.ei-distribution { display: grid; grid-template-columns: 75px minmax(0px, 1fr) 45px; align-items: center; gap: 10px; font-size: 12px; }\n.ei-distribution svg { width: 100%; height: 48px; }\n.ei-distribution svg text { font-size: 8px; fill: rgb(81, 103, 94); }\n.ei-distribution strong { text-align: right; }\n.ei-family-flow { display: grid; grid-template-columns: minmax(100px, 1fr) auto 76px auto minmax(150px, 1.5fr); align-items: center; gap: 10px; }\n.ei-family-members { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px; }\n.ei-app .ei-family-member { padding: 5px; min-width: 55px; display: grid; justify-items: center; border-radius: 10px; font-size: 11px; }\n.ei-family-member .ei-portrait { width: 37px; height: 40px; }\n.ei-family-member small { font-size: 9px; }\n.ei-family-focus { display: grid; justify-items: center; background: rgb(232, 238, 219); border-radius: 12px; padding: 8px; font-size: 12px; }\n.ei-family-focus .ei-portrait { width: 50px; height: 56px; }\n.ei-family-arrow { color: rgb(105, 128, 102); }\n.ei-allele-trace { display: grid; grid-template-columns: 100px 1fr 1fr; gap: 8px; font-size: 11px; align-items: center; }\n.ei-allele-trace span { padding: 8px; background: rgb(237, 241, 229); border-radius: 8px; font-variant-numeric: tabular-nums; }\n.ei-allele-trace small { display: block; font-size: 10px; }\n.ei-allele-trace .ei-allele-new { background: rgb(244, 231, 206); }\n.ei-investigations .ei-kicker { color: rgb(72, 101, 83); }\n@media (max-width: 760px) {\n  .ei-quest-grid { grid-template-columns: 1fr; }\n  .ei-app .ei-quest-choice { padding: 11px 12px 11px 46px; gap: 3px; }\n  .ei-quest-icon { top: 12px; }\n  .ei-investigations { padding: 14px; }\n  .ei-quest-progress { gap: 10px; }\n  .ei-quest-progress strong { font-size: 18px; }\n  .ei-quest-progress small { font-size: 10px; }\n}\n@media (max-width: 480px) {\n  .ei-family-flow { grid-template-columns: 1fr; justify-items: center; text-align: center; }\n  .ei-family-members { justify-content: center; }\n  .ei-family-arrow { transform: rotate(90deg); line-height: 1; }\n  .ei-allele-trace { grid-template-columns: 1fr 1fr; }\n  .ei-allele-trace > strong { grid-column: 1 / -1; }\n  .ei-replay-phases { padding: 10px; gap: 5px; }\n  .ei-app .ei-replay-phases button { padding: 7px 4px; flex-direction: column; gap: 0px; }\n  .ei-distribution { grid-template-columns: 62px minmax(0px, 1fr) 35px; gap: 5px; font-size: 11px; }\n}\n.ei-name-chip { position: absolute; top: calc(var(--ei-scene-h) - 94px); left: 15px; max-width: calc(100% - 30px); padding: 6px 11px; border-radius: 20px; border: 1px solid rgb(185, 205, 167); background: rgba(255, 253, 235, 0.937); color: rgb(41, 69, 54); font-size: 12px; font-weight: 750; overflow-wrap: anywhere; pointer-events: none; }\n.ei-resident-nav { display: grid; grid-template-columns: 42px 1fr 42px; gap: 6px; }\n.ei-app .ei-resident-nav button { padding: 7px; font-size: 12px; }\n.ei-pressure { display: grid; gap: 9px; padding: 12px; background: rgb(240, 243, 232); border: 1px solid rgb(212, 223, 213); border-radius: 11px; }\n.ei-pressure > strong { font-size: 12px; }\n.ei-pressure small { font-size: 10px; }\n.ei-pressure .ei-trait { font-size: 11px; }\n.ei-organism h3, .ei-family-member strong, .ei-family-focus strong { overflow-wrap: anywhere; }\n.ei-family-member strong { max-width: 82px; }\n.ei-family-focus strong { max-width: 60px; }\n.ei-trial-launch { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; border: 1px solid rgb(184, 199, 199); background: linear-gradient(105deg, rgb(220, 233, 227), rgb(228, 234, 240) 55%, rgb(238, 231, 218)); padding: 16px 18px; border-radius: 15px; margin-bottom: 17px; }\n.ei-trial-launch p { font-size: 12px; max-width: 760px; margin-top: 4px; }\n.ei-trial-launch .ei-kicker, .ei-trial-heading .ei-kicker { color: rgb(65, 94, 85); }\n.ei-trial-saved { margin-bottom: 17px; }\n.ei-trial-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; padding: 6px 0px; }\n.ei-trial-heading h2 { font-size: 30px; letter-spacing: -0.7px; line-height: 1.2; margin: 5px 0px; }\n.ei-trial-setup, .ei-twins, .ei-trial-settings { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.ei-trial-setup { align-items: start; }\n.ei-trial-toolbar { background: rgb(229, 236, 222); border: 1px solid rgb(197, 211, 192); border-radius: 12px; padding: 13px; font-size: 13px; font-weight: 700; }\n.ei-twin { min-width: 0px; border: 1px solid rgb(182, 201, 188); border-radius: 16px; overflow: hidden; background: rgb(255, 254, 249); }\n.ei-twin-head { display: flex; align-items: center; gap: 10px; padding: 14px; background: rgb(232, 239, 226); }\n.ei-twin-head > strong { margin-left: auto; font-size: 14px; }\n.ei-twin-letter { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: rgb(37, 92, 71); color: rgb(255, 254, 247); font-weight: 800; flex-shrink: 0; }\n.ei-twin:last-child .ei-twin-letter { background: rgb(140, 86, 32); }\n.ei-twin:last-child .ei-twin-head { background: rgb(241, 234, 221); }\n.ei-twin-head small { font-size: 11px; }\n.ei-twin .ei-scene-compact { --ei-scene-h: 315px; }\n.ei-twin-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 13px 18px; }\n.ei-twin-stats strong { display: block; font-size: 25px; line-height: 1.2; }\n.ei-twin-stats small { font-size: 11px; }\n.ei-twin .ei-fallback { inset: 20px 15px 65px; }\n.ei-trial-evidence .ei-chart { max-height: 230px; }\n.ei-trial-evidence caption { white-space: normal; }\n.ei-trial-evidence { gap: 10px; }\n.ei-comparison h2:focus { outline: rgb(174, 89, 29) solid 2px; outline-offset: 5px; }\n.ei-trial-launch button { flex-shrink: 0; }\n@media (max-width: 760px) {\n  .ei-twins, .ei-trial-setup, .ei-trial-settings { grid-template-columns: 1fr; }\n  .ei-twin .ei-scene-compact { --ei-scene-h: 280px; }\n  .ei-trial-heading h2 { font-size: 26px; }\n  .ei-trial-launch { padding: 14px; }\n  .ei-trial-launch button { width: 100%; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .ei-app * { scroll-behavior: auto !important; }\n}\n@media (forced-colors: active) {\n  .ei-app button { border: 1px solid buttontext; }\n  .ei-meter { border: 1px solid canvastext; }\n  .ei-stage-label, .ei-name-chip { background: canvas; color: canvastext; }\n  .ei-chart polyline { stroke: canvastext; }\n  .ei-replay-phases button[aria-pressed=\"true\"] { outline: highlight solid 2px; }\n  .ei-distribution circle { fill: canvastext; }\n  .ei-twin-letter { border: 1px solid canvastext; }\n}\n.ei-survival-lens { min-width: 0px; grid-template-columns: minmax(0px, 1fr); }\n.ei-survival-lens > details { min-width: 0px; }\n.ei-survival-lens .ei-lens-table:focus-visible { outline: rgb(174, 89, 29) solid 3px; outline-offset: 2px; }\n.ei-survival-context { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 5px 12px; padding: 9px 11px; background: rgb(227, 238, 232); border: 1px solid rgb(188, 208, 196); border-radius: 9px; }\n.ei-survival-context strong { font-size: 12px; }\n.ei-survival-context small { font-size: 11px; }\n.ei-survival-lens > small { line-height: 1.5; }\n.ei-survival-lens .ei-lens-specimen b { font-size: 18px; }\n.ei-survival-lens [data-survival-chance] { font-variant-numeric: tabular-nums; white-space: nowrap; }\n.ei-lenses { padding: 12px 18px; background: rgb(248, 250, 240); border-top: 1px solid rgb(198, 216, 198); gap: 7px; }\n.ei-lenses h2 { font-size: 15px; }\n.ei-lenses > div:first-child small { font-size: 11px; }\n.ei-lenses .ei-trait-select { max-width: 185px; min-height: 38px; }\n.ei-lens-scale { display: grid; grid-template-columns: auto 100px auto 1fr; gap: 8px; align-items: center; font-size: 11px; font-weight: 700; }\n.ei-lens-scale > div { height: 7px; border-radius: 6px; background: linear-gradient(90deg, rgb(40, 115, 155), rgb(187, 107, 25)); }\n.ei-lens-scale small { font-size: 11px; font-weight: 400; }\n.ei-lens-specimens { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }\n.ei-app .ei-lens-specimen { display: flex; align-items: center; gap: 9px; text-align: left; padding: 8px 11px; min-width: 0px; }\n.ei-lens-specimen .ei-portrait { width: 38px; height: 45px; }\n.ei-lens-specimen span { min-width: 0px; }\n.ei-lens-specimen strong { display: block; font-size: 12px; overflow-wrap: anywhere; }\n.ei-lens-specimen small { display: block; font-size: 10px; }\n.ei-lens-specimen b { margin-left: auto; font-size: 20px; flex-shrink: 0; }\n.ei-app .ei-lens-specimen[aria-pressed=\"true\"] { border: 2px solid rgb(92, 120, 86); background: rgb(234, 240, 220); padding: 7px 10px; }\n.ei-lens-table { max-height: 230px; }\n.ei-lens-table button { min-height: 34px; font-size: 11px; padding: 5px 8px; }\n.ei-name-chip { top: auto; bottom: calc(100% - var(--ei-scene-h) + 67px); }\n.ei-name-chip small { display: block; font-size: 10px; color: rgb(41, 69, 54); }\n.ei-map-creature small { display: block; color: white; font-size: 10px; }\n.ei-generation-story { padding: 11px 18px; background: rgb(255, 249, 235); border-top: 1px solid rgb(219, 212, 189); display: grid; gap: 10px; }\n.ei-generation-story > .ei-row > strong { font-size: 12px; }\n.ei-generation-story button { font-size: 12px; min-height: 36px; padding: 7px 10px; }\n.ei-story-chapter { display: grid; grid-template-columns: 34px 1fr; gap: 12px; }\n.ei-story-chapter h3 { font-size: 14px; margin-bottom: 5px; }\n.ei-story-chapter p { font-size: 12px; color: rgb(76, 93, 78); line-height: 1.5; }\n.ei-chapter-number { display: grid; place-items: center; align-self: start; background: rgb(106, 91, 49); color: rgb(255, 253, 245); width: 34px; height: 34px; border-radius: 50%; font-size: 17px; font-weight: 800; }\n.ei-story-chapter .ei-story-readings { font-weight: 700; color: rgb(62, 84, 63); margin-top: 7px; }\n.ei-generation-story > small { font-size: 10px; }\n@media (max-width: 480px) {\n  .ei-lenses, .ei-generation-story { padding: 11px; }\n  .ei-lens-scale { grid-template-columns: auto 1fr auto; }\n  .ei-lens-scale small { grid-column: 1 / -1; }\n  .ei-lens-specimens { grid-template-columns: 1fr; }\n  .ei-lenses .ei-trait-select { max-width: 230px; }\n  .ei-story-chapter { grid-template-columns: 28px 1fr; gap: 8px; }\n  .ei-chapter-number { width: 28px; height: 28px; font-size: 14px; }\n}\n@media (forced-colors: active) {\n  .ei-lens-scale > div { border: 1px solid canvastext; }\n  .ei-app .ei-lens-specimen[aria-pressed=\"true\"] { outline: highlight solid 2px; }\n}\n.ei-discovery-nav { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 12px; }\n.ei-app .ei-discovery-nav button { font-size: 12px; min-height: 36px; padding: 7px 12px; border-radius: 20px; background: transparent; }\n.ei-first-discovery { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 19px; background: rgb(231, 238, 220); border: 1px solid rgb(199, 214, 185); border-radius: 15px; margin-bottom: 16px; }\n.ei-intro-copy { display: flex; align-items: center; gap: 13px; min-width: 0px; }\n.ei-intro-copy > div { min-width: 0px; }\n.ei-intro-copy .ei-portrait { width: 53px; height: 65px; }\n.ei-first-discovery