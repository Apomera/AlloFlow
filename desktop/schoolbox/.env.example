WEB_PORT=32174
PB_PORT=8090
OLLAMA_PORT=11434
TTS_PORT=5001
PIPER_PORT=10200
SEARCH_PORT=8888
FLUX_PORT=7860
REACT_APP_DATA_BACKEND=auto
REACT_APP_POCKETBASE_URL=http://localhost:8090

# ─── Container Resource Limits ──────────────────────────────────────
# Defaults suit a single classroom box. Raise the Ollama and Flux ceilings
# if you serve larger models: a limit below a loaded model's working set
# gets the container OOM-killed by the kernel.
#
# PID ceilings are set as literals in the compose files, not here: pids_limit is
# an integer field in the compose spec. They count threads, so they are generous.
WEB_MEM_LIMIT=256m
PB_MEM_LIMIT=512m
OLLAMA_MEM_LIMIT=8g
FLUX_MEM_LIMIT=8g
TTS_MEM_LIMIT=512m
PIPER_MEM_LIMIT=1g
SEARCH_MEM_LIMIT=1g
