auto; overflow-x:clip; background:var(--pw-bg); color:var(--pw-ink); scrollbar-gutter:stable; scroll-padding-top:260px; }\n.pdf-workspace .pdf-workspace-header { position:sticky; top:0; z-index:30; background:var(--pw-bg); color:var(--pw-ink); padding:20px 24px 12px; border-bottom:1px solid var(--pw-line); text-align:start; }\n.pdf-workspace .pdf-workspace-topline { display:flex; align-items:center; justify-content:space-between; gap:12px; }\n.pdf-workspace .pdf-workspace-identity { min-width:0; }\n.pdf-workspace .pdf-workspace-eyebrow { color:var(--pw-muted); font-size:11px; font-weight:700; letter-spacing:.04em; margin:0 0 4px; }\n.pdf-workspace .pdf-workspace-identity h2 { font-size:20px; font-weight:750; line-height:1.3; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--pw-ink); }\n.pdf-workspace .pdf-workspace-window-actions { display:flex; align-items:center; flex-shrink:0; }\n.pdf-workspace .pdf-workspace-window-actions button { min-width:40px; min-height:40px; background:var(--pw-bg); color:var(--pw-ink); border-color:var(--pw-line); box-shadow:none; }\n.pdf-workspace .pdf-workspace-stages { display:flex; margin:18px 0 14px; padding:0; gap:8px; list-style:none; }\n.pdf-workspace .pdf-workspace-stages li { display:flex; align-items:center; gap:7px; flex:1; font-size:12px; font-weight:600; line-height:1.3; color:var(--pw-muted); }\n.pdf-workspace .pdf-workspace-step-number { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; border:1px solid var(--pw-line); width:26px; height:26px; border-radius:50%; font-size:11px; }\n.pdf-workspace .pdf-workspace-stages [aria-current=\"step\"] { color:var(--pw-accent); font-weight:800; }\n.pdf-workspace .pdf-workspace-stages [aria-current=\"step\"] .pdf-workspace-step-number { color:var(--pw-accent); border:2px solid var(--pw-accent); background:var(--pw-active); }\n.pdf-workspace .pdf-workspace-status { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px; background:var(--pw-soft); border:1px solid var(--pw-line); border-inline-start:4px solid var(--pw-muted); border-radius:10px; }\n.pdf-workspace .pdf-workspace-status[data-tone=\"working\"] { border-inline-start-color:var(--pw-accent); }\n.pdf-workspace .pdf-workspace-status[data-tone=\"attention\"] { border-inline-start-color:#b45309; }\n.pdf-workspace .pdf-workspace-status[data-tone=\"ready\"] { border-inline-start-color:#15803d; }\n.pdf-workspace .pdf-workspace-status-title { margin:0; font-size:14px; font-weight:750; color:var(--pw-ink); }\n.pdf-workspace .pdf-workspace-status-detail { margin:3px 0 0; max-width:75ch; font-size:12px; line-height:1.5; color:var(--pw-muted); }\n.pdf-workspace .pdf-workspace-primary { flex-shrink:0; background:var(--pw-accent); color:var(--pw-bg); padding:10px 14px; min-height:40px; border:1px solid var(--pw-accent); border-radius:8px; font-weight:700; font-size:12px; }\n.pdf-workspace .pdf-workspace-nav { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }\n.pdf-workspace .pdf-workspace-nav button { color:var(--pw-accent); font-size:12px; font-weight:650; padding:7px 10px; border-radius:6px; min-height:34px; }\n.pdf-workspace .pdf-workspace-nav button:hover { background:var(--pw-active); text-decoration:underline; }\n.pdf-workspace .pdf-workspace-sources { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:24px; text-align:start; }\n.pdf-workspace .pdf-workspace-sources button { padding:14px; border:1px solid var(--pw-line); border-radius:12px; background:var(--pw-bg); color:var(--pw-ink); text-align:start; }\n.pdf-workspace .pdf-workspace-sources button[aria-pressed=\"true\"] { border:2px solid var(--pw-accent); padding:13px; background:var(--pw-active); }\n.pdf-workspace .pdf-workspace-sources strong { display:block; font-size:14px; }\n.pdf-workspace .pdf-workspace-sources span { display:block; margin-top:4px; font-size:11px; color:var(--pw-muted); }\n.pdf-workspace .pdf-workspace-manual { border:1px solid var(--pw-line); border-radius:12px; margin:12px 0; padding:12px 16px; color:var(--pw-ink); background:var(--pw-bg); text-align:start; }\n.pdf-workspace .pdf-workspace-manual > summary { font-weight:700; font-size:13px; cursor:pointer; padding:4px 0; }\n.pdf-workspace .pdf-workspace-manual > div { flex-wrap:wrap; margin-top:14px; }\n.pdf-workspace .pdf-workspace-afterfix { display:grid; grid-template-columns:auto minmax(160px,1fr); align-items:center; gap:8px 14px; margin:14px 0; max-width:600px; text-align:start; font-size:12px; font-weight:700; }\n.pdf-workspace .pdf-workspace-afterfix select { padding:9px 12px; border:1px solid var(--pw-line); border-radius:8px; color:var(--pw-ink); background:var(--pw-bg); }\n.pdf-workspace .pdf-workspace-afterfix small { grid-column:1 / -1; font-size:11px; font-weight:400; color:var(--pw-muted); }\n.pdf-workspace .pdf-workspace-batch-row { flex-wrap:wrap; text-align:start; padding:10px 12px; gap:8px; }\n.pdf-workspace .pdf-workspace-batch-name { min-width:120px; overflow-wrap:anywhere; white-space:normal; }\n.pdf-workspace .pdf-workspace-batch-status { display:flex; flex-direction:column; font-size:11px; min-width:140px; }\n.pdf-workspace .pdf-workspace-batch-status span { font-weight:400; }\n.pdf-workspace .pdf-workspace-batch-queue { max-height:320px; }\n.pdf-workspace .pdf-workspace-header :focus-visible, .pdf-workspace .pdf-workspace-sources :focus-visible, .pdf-workspace .pdf-workspace-manual :focus-visible { outline:3px solid var(--pw-accent); outline-offset:3px; }\n.pdf-workspace button:disabled { cursor:not-allowed; }\n@media(max-width:600px) {\n .allo-docsuite.pdf-workspace { padding:0; }\n .pdf-workspace .pdf-workspace-shell { max-height:100vh; max-height:100dvh; border-radius:0; scroll-padding-top:280px; }\n .pdf-workspace .pdf-workspace-header { padding:12px; }\n .pdf-workspace .pdf-workspace-identity h2 { font-size:16px; }\n .pdf-workspace .pdf-workspace-eyebrow { font-size:10px; }\n .pdf-workspace .pdf-workspace-eyebrow span { display:none; }\n .pdf-workspace .pdf-workspace-stages { margin:10px 0; }\n .pdf-workspace .pdf-workspace-stages li { flex:0; }\n .pdf-workspace .pdf-workspace-stages li > span:last-child { display:none; }\n .pdf-workspace .pdf-workspace-stages [aria-current=\"step\"] { flex:1; }\n .pdf-workspace .pdf-workspace-stages [aria-current=\"step\"] > span:last-child { display:inline; }\n .pdf-workspace .pdf-workspace-step-number { width:22px; height:22px; }\n .pdf-workspace .pdf-workspace-status { flex-wrap:wrap; padding:10px; gap:8px; }\n .pdf-workspace .pdf-workspace-status-detail { font-size:11px; }\n .pdf-workspace .pdf-workspace-primary { padding:8px 12px; min-height:36px; }\n .pdf-workspace .pdf-workspace-nav { gap:0; }\n .pdf-workspace .pdf-workspace-nav button { padding:7px; font-size:11px; }\n .pdf-workspace .pdf-workspace-sources { gap:6px; margin-bottom:18px; }\n .pdf-workspace .pdf-workspace-sources button { padding:10px 8px; }\n .pdf-workspace .pdf-workspace-sources button[aria-pressed=\"true\"] { padding:9px 7px; }\n .pdf-workspace .pdf-workspace-sources strong { font-size:12px; }\n .pdf-workspace .pdf-workspace-sources span { font-size:10px; }\n .pdf-workspace .pdf-workspace-shell > .p-8, .pdf-workspace .pdf-workspace-shell > .p-12 { padding:16px; }\n .pdf-workspace .pdf-workspace-afterfix { grid-template-columns:1fr; }\n}\n@media(max-height:550px) {\n .pdf-workspace .pdf-workspace-header { position:relative; }\n .pdf-workspace .pdf-workspace-shell { scroll-padding-top:12px; }\n}\n@media(prefers-reduced-motion:reduce) { .pdf-workspace *, .pdf-workspace *::before, .pdf-workspace *::after { animation-duration:0s !important; transition-duration:0s !important; scroll-behavior:auto !important; } }\r\n.pdf-workspace .pdf-workspace-results { padding:20px 24px; }\n@media(max-width:600px) { .pdf-workspace .pdf-workspace-results { padding:14px; } }\r\n"],["DIV",{"class":"pdf-workspace-topline"},["DIV",{"cl