+++ b/tests/reader_preview_locales.test.js
@@ -0,0 +1,70 @@
+import { beforeAll, beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import { setupPreviewLocales, preparePreviewLocale, cleanupPreviewLocale, previewFixtures, mountReader, openLocalePreview, click } from './helpers/reader_preview_locale_harness.js';
+beforeAll(setupPreviewLocales, 60000);
+beforeEach(preparePreviewLocale);
+afterEach(cleanupPreviewLocale);
+const statusRow = host => host.querySelector('[data-review-state="audio"]');
+const noLeakedKeys = element => expect(element.textContent).not.toMatch(/simplified\.[a-z_]+|\{(?:ready|total)\}/);
+describe('audio readiness and layout preview in named locales', () => {
+  for (const fixture of previewFixtures) {
+    it(fixture.id + ': interpolates actual ready/total counts in locale word order', () => {
+      let total;
+      window.__alloGetReadAloudAudioSummary = vi.fn(texts => { total = texts.length; return { total, ready: 1, stale: total - 1, missing: 0, corrupt: 0 }; });
+      const { host, t } = mountReader(fixture), row = statusRow(host);
+      expect(total).toBeGreaterThan(1);
+      expect(row.textContent).toContain(t('simplified.review_audio_current_detail', { ready: 1, total }));
+      expect(row.textContent).toContain(t('simplified.review_audio_partial'));
+      noLeakedKeys(row);
+    });
+    it.each(['missing', 'throws'])(fixture.id + ': unavailable summary (%s) is named honestly', kind => {
+      if (kind === 'throws') window.__alloGetReadAloudAudioSummary = () => { throw Error('Unavailable bridge'); };
+      const { host, t } = mountReader(fixture), row = statusRow(host);
+      expect(row.textContent).toContain(t('simplified.review_audio_unavailable'));
+      expect(row.textContent).not.toContain(t('simplified.review_audio_ready'));
+      noLeakedKeys(row);
+    });
+    it(fixture.id + ': localized preview limits and prepared-help hint preserve passage language and state', async () => {
+      localStorage.setItem('preview-fixture-sentinel', fixture.snippet);
+      const before = JSON.stringify(localStorage), speak = vi.fn(), stop = vi.fn();
+      const view = await openLocalePreview(fixture, { handleSpeak: speak, stopPlayback: stop }), { host, preview, t } = view;
+      expect(host.querySelector('[data-student-preview-open]').textContent).toBe(t('simplified.layout_preview_open'));
+      expect(preview.getAttribute('role')).toBe('dialog');
+      expect(preview.querySelector('h2').textContent).toBe(t('simplified.layout_preview_title'));
+      expect(preview.textContent).toContain(t('simplified.layout_preview_note'));
+      expect(preview.textContent).toContain(t('simplified.layout_preview_limits'));
+      const paragraph = preview.querySelector('[data-reading-paragraph="1"]');
+      expect(paragraph.lang).toBe(fixture.tag); expect(paragraph.dir).toBe(fixture.dir);
+      for (const button of preview.querySelectorAll('[data-reading-mode]')) if (!['read', 'define'].includes(button.dataset.readingMode)) expect(button.disabled).toBe(true);
+      await click(preview.querySelector('[data-reading-mode="define"]'));
+      const hint = preview.querySelector('[data-reading-mode-status="define"]');
+      expect(hint.textContent).toContain(t('simplified.layout_preview_word_help')); noLeakedKeys(hint);
+      await click(preview.querySelector('[data-student-preview-close]'));
+      expect(host.querySelector('[data-student-preview]')).toBeNull();
+      expect(speak).not.toHaveBeenCalled(); expect(stop).not.toHaveBeenCalled();
+      expect(JSON.stringify(localStorage)).toBe(before);
+    });
+    it(fixture.id + ': explains the chart omission in the selected language', async () => {
+      const chart = { ...fixture, passage: fixture.passage + '\n\n[[CHART:{"type":"bar","title":"Fixture chart","labels":["A"],"datasets":[{"data":[1]}]}]]' };
+      const { preview, t } = await openLocalePreview(chart);
+      const note = preview.querySelector('[data-reading-chart]');
+      expect(note).not.toBeNull(); expect(note.textContent).toContain(t('simplified.layout_preview_chart')); noLeakedKeys(note);
+    });
+  }
+  it.each(['missing', 'echoed'])('keeps English fallback labels readable when the translator is %s', async kind => {
+    const t = kind === 'missing' ? () => undefined : key => key;
+    const { preview, host } = await openLocalePreview(previewFixtures.find(f => f.locale === 'arabic'), { t });
+    expect(preview.querySelector('h2').textContent).toBe('Reading layout preview');
+    expect(preview.textContent).toContain('This does not preview a delivered lesson.');
+    noLeakedKeys(preview.querySelector('h2'));
+    expect(statusRow(host).textContent).toContain('Audio status unavailable');
+    expect(preview.querySelector('[data-reading-paragraph="1"]').lang).toBe('ar');
+    expect(preview.querySelector('[data-reading-paragraph="1"]').dir).toBe('rtl');
+  });
+  it('keeps an Arabic passage RTL under an English preview interface', async () => {
+    const fixture = { ...previewFixtures.find(f => f.locale === 'arabic'), locale: 'English' };
+    const { preview } = await openLocalePreview(fixture);
+    expect(preview.querySelector('h2').textContent).toBe('Reading layout preview');
+    const paragraph = preview.querySelector('[data-reading-paragraph="1"]');
+    expect(paragraph.lang).toBe('ar'); expect(paragraph.dir).toBe('rtl');
+  });
+});
