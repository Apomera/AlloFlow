ong { overflow-wrap: anywhere; }\n.ei-family-member strong { max-width: 82px; }\n.ei-family-focus strong { max-width: 60px; }\n.ei-trial-launch { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; border: 1px solid rgb(184, 199, 199); background: linear-gradient(105deg, rgb(220, 233, 227), rgb(228, 234, 240) 55%, rgb(238, 231, 218)); padding: 16px 18px; border-radius: 15px; margin-bottom: 17px; }\n.ei-trial-launch p { font-size: 12px; max-width: 760px; margin-top: 4px; }\n.ei-trial-launch .ei-kicker, .ei-trial-heading .ei-kicker { color: rgb(65, 94, 85); }\n.ei-trial-saved { margin-bottom: 17px; }\n.ei-trial-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; padding: 6px 0px; }\n.ei-trial-heading h2 { font-size: 30px; letter-spacing: -0.7px; line-height: 1.2; margin: 5px 0px; }\n.ei-trial-setup, .ei-twins, .ei-trial-settings { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.ei-trial-setup { align-items: start; }\n.ei-trial-toolbar { background: rgb(229, 236, 222); border: 1px solid rgb(197, 211, 192); border-radius: 12px; padding: 13px; font-size: 13px; font-weight: 700; }\n.ei-twin { min-width: 0px; border: 1px solid rgb(182, 201, 188); border-radius: 16px; overflow: hidden; background: rgb(255, 254, 249); }\n.ei-twin-head { display: flex; align-items: center; gap: 10px; padding: 14px; background: rgb(232, 239, 226); }\n.ei-twin-head > strong { margin-left: auto; font-size: 14px; }\n.ei-twin-letter { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: rgb(37, 92, 71); color: rgb(255, 254, 247); font-weight: 800; flex-shrink: 0; }\n.ei-twin:last-child .ei-twin-letter { background: rgb(140, 86, 32); }\n.ei-twin:last-child .ei-twin-head { background: rgb(241, 234, 221); }\n.ei-twin-head small { font-size: 11px; }\n.ei-twin .ei-scene-compact { --ei-scene-h: 315px; }\n.ei-twin-stats { display: grid; grid-template-co