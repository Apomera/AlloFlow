+        const hit = document.elementFromPoint((Math.max(0, r.left) + Math.min(innerWidth - 1, r.right)) / 2, (Math.max(0, r.top) + Math.min(innerHeight - 1, r.bottom)) / 2);
+        return el === hit || el.contains(hit);
+      });
+    });
+  }
