  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/14735.png",
      "text": "Saaxiibkey Kiki iyo anigu waxaan ka lugeeynaa iskuulka gurigana kutagnaa.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=1",
      "sourceDigest": "sha256:9abd433e9435d2eff7228ffc447df6b26e8a656003e8f060fc0247d769c55fbe"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/14736.png",
      "text": "Maalin maalmaha ka mid ah, nin ayaa nadabagalay. Ilkihiisu waxay ahaayeen bun.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=2",
      "sourceDigest": "sha256:845347023da391c630a8b694b58517e4ff37fffdb0cbf96bd43ed105405be6ba"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/14737.png",
      "text": "Wuxuu kulahaa finan wajiga.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=3",
      "sourceDigest": "sha256:deba8e03864e70d51e82cc2fe91449f03dc1115f4206c51e04a911627f6415cd"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/14738.png",
      "text": "Markii aan eegnay, wuu naguqeeyliyay si xanaaq leh.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=4",
      "sourceDigest": "sha256:91ded4020edff811c376d1a48c718277f950160036ffd093d548724f3167f761"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/14739.png",
      "text": "Waxay igu tuureen gaadhi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=5",
      "sourceDigest": "sha256:b7ca16886726918c0045e8e0f36d953c8977e05ee228f2cf6a4e94301695fa9f"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/14740.png",
      "text": "Kiki ayaa awood u yeelatay inay kacararto.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=6",
      "sourceDigest": "sha256:7e09eb091610b7faa3beda8265a8bd98722f0eb0568e906e1300ad1f9018be11"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/14741.png",
      "text": "Waxay igu riddeen qol madow. Gacmahaygu waa la xidhay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=7",
      "sourceDigest": "sha256:e8b6bbb855c5f737d66b4d12e420c7cc6f28cabda6be06467d5ab81e11d687da"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/14742.png",
      "text": "Nin ayaa yiri, \"Cun cuntadan. Safarku waa dheer yahay.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=8",
      "sourceDigest": "sha256:5c436194a3ca6d02a573a8304aeff72ea6e89103126f3d5e24bfe82b3eeefe0c"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/14743.png",
      "text": "Inta aan cunayay, ninku wuxuu cabayay sigaarka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=9",
      "sourceDigest": "sha256:a1aea98c23128dba1b94e871de66cb32bd384c1e696d1936f159b457968d8ad2"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/14744.png",
      "text": "Si lama filaan ah, ragii kale ayaa soo galeen iyagoo jiidaya saaxiibteey Kiki.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=10",
      "sourceDigest": "sha256:d22c6f03b9d19b67f8b109c102905d0122deafd4f9868f7390909143d4ef085d"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/14745.png",
      "text": "Waxaan maqalnay ragii oo isla murmaya iyo iyagoo qaylinaya qolkkale.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=11",
      "sourceDigest": "sha256:f5993de6776c00feae072bf47357f0065cb03b70e7ca74de0368d3b16cda2aab"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/14746.png",
      "text": "Kiki ayaa tiri, \"Waa inaan ka baxsano. Waalidiinteen ma bixin karaan lmadaxfurashadooda.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=12",
      "sourceDigest": "sha256:32d6a62327c071c43d627abc2ff9d870f48218cba85ac43f71187e5b4a6b8bba"
    },
    {
      "n": 13,
      "img": "https://www.africanstorybook.org/illustrations/pages/14747.png",
      "text": "Waxaan soojiidnay alwaax xaga daaqadda ilaa aan iftiin kaargno.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=13",
      "sourceDigest": "sha256:7b5df2f2d8897126ac182e065b045c6bdc455ca7d29262c254cdccda3c70e7d8"
    },
    {
      "n": 14,
      "img": "https://www.africanstorybook.org/illustrations/pages/14748.png",
      "text": "Kiki ayaa ka kortay oo orod ku tagay si ay caawimaad uhesho.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=14",
      "sourceDigest": "sha256:4a487b04aaad2eff0f21b1a94701029763d3d0552cc17c564ff05795438434da"
    },
    {
      "n": 15,
      "img": "https://www.africanstorybook.org/illustrations/pages/14749.png",
      "text": "Raga ayaa si degdeg ah qolkii soogaleeyn. Hogaamiyihii wuu xanaaqay.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=15",
      "sourceDigest": "sha256:c9e2fef23ffda3aa66cd89577d5a05eda5d975241f6f48cbd770e87c6dd144cf"
    },
    {
      "n": 16,
      "img": "https://www.africanstorybook.org/illustrations/pages/14750.png",
      "text": "Waxay ku noqdeen qolkii kale oo siiwateen murankoodii.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=16",
      "sourceDigest": "sha256:57a5b98b1b1ced171a688e828d0438f2dd3a865fe4842918e913b1f47c8b252d"
    },
    {
      "n": 17,
      "img": "https://www.africanstorybook.org/illustrations/pages/14751.png",
      "text": "Waxaan maqlay cod sheegaya, \"Ha cabsan. Boolisku waakan.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=17",
      "sourceDigest": "sha256:278ce68e18f05ee9f31691da35880a3af9f2d8474a9a9fd0daa4de2c4f46c3ac"
    },
    {
      "n": 18,
      "img": "https://www.africanstorybook.org/illustrations/pages/14752.png",
      "text": "Weey qaylinayeen oo dhawaaq samaynayeen. Waxaan maqlay rasaas.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=18",
      "sourceDigest": "sha256:57fa0ecf761feb3856df0fce550341dd6339cfd394fa87aa300de5bfdb081c31"
    },
    {
      "n": 19,
      "img": "https://www.africanstorybook.org/illustrations/pages/14753.png",
      "text": "Haweeney boolis ah ayaa tiri, \"Wax walba waa dhamaadeen. Hadda ammaan ayaadtahay.\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=19",
      "sourceDigest": "sha256:3706114c16fde298a9ada3adf1ce993dec1531ec77aba75920537fbf875f4251"
    },
    {
      "n": 20,
      "img": "https://www.africanstorybook.org/illustrations/pages/14754.png",
      "text": "Maalintaas kadib, Kiki iyo anigu waxaan noqonnay kuwo ka taxaddar badan.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=52395#page=20",
      "sourceDigest": "sha256:068b59bc508815abb6eac85bcdf2817f22d922fa0a80fe1b7549c093cbfc737f"
    }
  ],
