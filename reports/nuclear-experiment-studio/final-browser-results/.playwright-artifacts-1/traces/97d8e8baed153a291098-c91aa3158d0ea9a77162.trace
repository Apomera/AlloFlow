: 100%; display: block;","width":"560","height":"218"}]],[[4,525]],[[4,534]],[[4,540]],[[4,563]],[[4,565]],[[4,570]],[[4,575]]],[[4,678]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-biohalf","data-nk-sec":"biohalf","aria-labelledby":"nkheading-biohalf","tabindex":"-1","style":"border-color: rgba(244, 114, 182, 0.333) rgba(244, 114, 182, 0.333) rgba(244, 114, 182, 0.333) rgb(244, 114, 182); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(244, 114, 182, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255, 255, 0.035) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 16px 34px -26px; scroll-margin-top: 96px;"},[[4,680]],[[4,682]],[[4,701]],[[4,707]],[[4,723]],[[4,725]],["DIV",{"class":"nk-chart-frame rounded-lg overflow-hidden border mt-2","style":"border-color: rgba(244, 114, 182, 0.35); height: 175px;"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":55,\"top\":5673.15625,\"right\":1048,\"bottom\":5846.15625}","role":"img","data-a11y-static":"true","aria-describedby":"nk-bio-description","aria-label":"How much Caesium-137 is left in the body over time. Radioactive decay alone would leave 97.8 percent after 347.8 days, but with excretion as well only 3.1 percent remains. The effective half-life is 69.6 days.","style":"width: 100%; height: 100%; display: block;","width":"560","height":"218"}]],[[4,729]],[[4,731]],[[4,733]],[[4,745]],[[4,747]]],[[4,885]],[[4,1019]],[[4,1161]],["DIV",{"class":"nk-section-card rounded-xl border p-3 mt-4","id":"nksec-detect","data-nk-sec":"detect","aria-labelledby":"nkheading-detect","tabindex":"-1","style":"border-color: rgba(45, 212, 191, 0.333) rgba(45, 212, 191, 0.333) rgba(45, 212, 191, 0.333) rgb(45, 212, 191); border-left-width: 4px; border-left-style: solid; background-color: rgba(15, 23, 42, 0.78); background-image: linear-gradient(135deg, rgba(45, 212, 191, 0.094) 0%, transparent 38%); box-shadow: rgba(255, 255