</circle>
<circle cx="80" cy="61" r="2" fill="var(--dino-on-accent)">
</circle>
<circle cx="103" cy="61" r="2" fill="var(--dino-on-accent)">
</circle>
<circle cx="126" cy="61" r="2" fill="var(--dino-on-accent)">
