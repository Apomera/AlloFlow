 of the content including main ideas and details."}},{"k":"visual_title","v":{"s":"Visual Aids"}},{"k":"visual_desc","v":{"s":"AI-generated images to support visual learning and comprehension."}},{"k":"faq_title","v":{"s":"FAQ Generator"}},{"k":"faq_desc","v":{"s":"Anticipate student questions with these generated FAQs."}},{"k":"scaffolds_title","v":{"s":"Instructional Scaffolds"}},{"k":"scaffolds_desc","v":{"s":"Get teaching strategies and scaffolds tailored to this content."}},{"k":"quiz_title","v":{"s":"Exit Ticket"}},{"k":"quiz_desc","v":{"s":"Generate a quick assessment to check for understanding."}},{"k":"fullpack_title","v":{"s":"Full Lesson Pack"}},{"k":"fullpack_desc","v":{"s":"Download all generated resources as a single comprehensive PDF."}},{"k":"brainstorm_title","v":{"s":"Engagement Ideas"}},{"k":"brainstorm_desc","v":{"s":"Get creative ideas for opening hooks and class activities."}},{"k":"timeline_title","v":{"s":"Timeline Builder"}},{"k":"timeline_desc","v":{"s":"Visualize the sequence of events or steps."}},{"k":"concept_title","v":{"s":"Concept Sort"}},{"k":"concept_desc","v":{"s":"Interactive activity to categorize key concepts."}},{"k":"math_title","v":{"s":"Math Application"}},{"k":"math_desc","v":{"s":"Generate relevant word problems and connections to math concepts."}},{"k":"persona_title","v":{"s":"AI Persona"}},{"k":"persona_desc","v":{"s":"Simulate a conversation with a character or figure from the text."}},{"k":"wordsounds_title","v":{"s":"Word Sounds Studio"}},{"k":"wordsounds_desc","v":{"s":"Design targeted phonics and phoneme awareness lessons using glossary terms or word families."}},{"k":"glossary_settings_title","v":{"s":"Glossary Settings"}},{"k":"glossary_settings_desc","v":{"s":"Customize how terms are selected and translated. You can filter by tiered vocabulary or force specific languages."}},{"k":"simplified_settings_title","v":{"s":"Adapted Text Settings"}},{"k":"simplified_settings_desc","v":{"s":"Adjust the target grade level, text complexity, and output language for your student's needs."}},{"k":"analysis_settings_title","v":{"s":"Analysis Options"}},{"k":"analysis_settings_desc","v":{"s":"Enable 'Check Accuracy' to have the AI verify facts against web search results."}},{"k":"visual_settings_title","v":{"s":"Image Settings"}},{"k":"visual_settings_desc","v":{"s":"Choose an art style or enable special modes like 'Worksheet' (black & white line art) or 'Text Reduced'."}},{"k":"faq_settings_title","v":{"s":"FAQ Generator"}},{"k":"faq_settings_desc","v":{"s":"Control how many questions to generate to check student understanding."}},{"k":"scaffolds_settings_title","v":{"s":"Scaffolding Options"}},{"k":"scaffolds_settings_desc","v":{"s":"Select the type of support: Sentence Starters, Paragraph Frames, or Discussion Prompts."}}],"id":118}},{"k":"help","v":{"o":[{"k":"udl_modal_title","v":{"s":"Universal Design for Learning Guide"}},{"k":"udl_modal_desc","v":{"s":"This comprehensive guide helps you understand UDL principles and apply them to your teaching. Use it to create more accessible and engaging learning experiences for all students."}},{"k":"header_actions_title","v":{"s":"Header Actions"}},{"k":"header_actions_desc","v":{"s":"Quick access controls for language settings, accessibility options, and user mode switching. Customize your AlloFlow experience here."}},{"k":"header_utils_title","v":{"s":"Utility Controls"}},{"k":"header_utils_desc","v":{"s":"Essential utilities including project management, help resources, and user mode toggle. Switch between Teacher and Student modes or access saved work."}},{"k":"header_tools_title","v":{"s":"Quick Tools"}},{"k":"header_tools_desc","v":{"s":"Power tools for content creation and AI assistance. Access the writing workshop, chat assistant, and other productivity features."}},{"k":"lesson_plan_title","v":{"s":"Lesson Planning"}},{"k":"lesson_plan_desc","v":{"s":"Configure your lesson parameters including duration, grade level, content areas, and learning objectives. These settings help tailor AI-generated content to your specific needs."}},{"k":"tool_udl_title","v":{"s":"UDL Guide Toggle"}},{"k":"tool_udl_desc","v":{"s":"Toggle the Universal Design for Learning sidebar to view guidelines and checkpoints as you work. Use this to ensure your materials are accessible and engaging."}},{"k":"tool_chat_title","v":{"s":"AI Chat Assistant"}},{"k":"tool_chat_desc","v":{"s":"Open the AI chat assistant for interactive help with your content. Ask questions, get suggestions, or request modifications to your materials."}},{"k":"tool_writing_title","v":{"s":"Writing Workshop"}},{"k":"tool_writing_desc","v":{"s":"Launch the collaborative writing environment where students can draft, revise, and receive AI-powered feedback on their writing."}},{"k":"sidebar_analysis_title","v":{"s":"Text Analysis"}},{"k":"sidebar_analysis_desc","v":{"s":"AI-powered analysis of your source text including reading level assessment, key vocabulary identification, and content structure breakdown."}},{"k":"sidebar_glossary_title","v":{"s":"Smart Glossary"}},{"k":"sidebar_glossary_desc","v":{"s":"Automatically extracted vocabulary terms with definitions, translations, and visual icons. Edit terms, add translations, and create flashcards."}},{"k":"sidebar_simplified_title","v":{"s":"Adapted Versions"}},{"k":"sidebar_simplified_desc","v":{"s":"Access differentiated versions of your text at various reading levels. Generate adapted content, side-by-side bilingual versions, and modified texts."}},{"k":"sidebar_outline_title","v":{"s":"Visual Organizers"}},{"k":"sidebar_outline_desc","v":{"s":"Create structured visual representations of content including concept maps, flow charts, Venn diagrams, and cause-and-effect organizers."}},{"k":"sidebar_visuals_title","v":{"s":"Lesson Images"}},{"k":"sidebar_visuals_desc","v":{"s":"AI-generated pictures and diagrams for the content. Create a custom image or an enhanced image set, and refine or remove text inside an image."}},{"k":"sidebar_faq_title","v":{"s":"FAQ Generator"}},{"k":"sidebar_faq_desc","v":{"s":"Generate frequently asked questions that students might have about the content. Great for anticipating confusion and preparing explanations."}},{"k":"sidebar_scaffolds_title","v":{"s":"Instructional Scaffolds"}},{"k":"sidebar_scaffolds_desc","v":{"s":"Get teaching strategies, discussion prompts, and scaffolded activities tailored to your content. Includes graphic organizers and guided practice."}},{"k":"sidebar_quiz_title","v":{"s":"Exit Tickets & Quizzes"}},{"k":"sidebar_quiz_desc","v":{"s":"Generate quick formative assessments to check for understanding. Create multiple choice, short answer, or interactive quiz formats."}},{"k":"sidebar_brainstorm_title","v":{"s":"Engagement Ideas"}},{"k":"sidebar_brainstorm_desc","v":{"s":"Get creative hooks, opening activities, and engagement strategies to introduce your content and maintain student interest."}},{"k":"sidebar_games_title","v":{"s":"Interactive Games"}},{"k":"sidebar_games_desc","v":{"s":"Create educational games including flashcard decks, crossword puzzles, bingo cards, and memory matching games using your content vocabulary."}},{"k":"sidebar_resources_title","v":{"s":"Resource Pack"}},{"k":"sidebar_resources_desc","v":{"s":"Download comprehensive resource bundles including all generated materials in printable PDF format for classroom use."}},{"k":"sidebar_adventure_title","v":{"s":"Learning Adventures"}},{"k":"sidebar_adventure_desc","v":{"s":"Create interactive choose-your-own-adventure stories based on your content. Students make decisions and explore concepts through narrative play."}},{"k":"sidebar_interview_title","v":{"s":"Historical Interviews"}},{"k":"sidebar_interview_desc","v":{"s":"Generate AI personas of historical figures or text characters for simulated interviews and debates. Bring primary sources to life."}},{"k":"default_title","v":{"s":"Help Topic"}},{"k":"default_desc","v":{"s":"Information about this feature will appear here. Click on any element with a help icon to learn more."}}],"id":119}},{"k":"quick_start","v":{"o":[{"k":"found_resources","v":{"s":"Found {count} resources."}},{"k":"search_failed","v":{"s":"Search failed."}},{"k":"error_no_urls","v":{"s":"Could not find specific URLs. Please try a different topic."}},{"k":"error_auto_search","v":{"s":"Search failed. Please try again."}},{"k":"copy_paste_instruction","v":{"s":"Please copy the URL from the new tab and paste it here."}},{"k":"article_imported","v":{"s":"Article imported and cleaned!"}},{"k":"error_extract","v":{"s":"Could not extract text. The URL might be invalid or blocking access."}},{"k":"error_read_file","v":{"s":"Failed to read text file."}}],"id":120}},{"k":"hide_answer","v":{"s":"Hide Answer"}},{"k":"reveal_answer","v":{"s":"Reveal Answer"}},{"k":"lobby_waiting","v":{"s":"Ready"}},{"k":"session_ended_success","v":{"s":"Session ended successfully."}},{"k":"edit_option","v":{"s":"Edit option"}},{"k":"edit_option_translation","v":{"s":"Edit option translation"}},{"k":"edit_question","v":{"s":"Edit question"}},{"k":"edit_question_english","v":{"s":"Edit question (English)"}},{"k":"edit_reflection","v":{"s":"Edit reflection"}},{"k":"edit_reflection_translation","v":{"s":"Edit reflection translation"}},{"k":"item_mix_help","v":{"s":"Control how many of each question type are generated. MCQ and Reflections are set above."}},{"k":"item_count_aria","v":{"s":"{type} count"}},{"k":"reset_mix","v":{"s":"↩ Reset to mode defaults"}},{"k":"mode_label","v":{"s":"Mode:"}},{"k":"mode_aria","v":{"s":"Quiz mode"}},{"k":"mode_tooltip","v":{"s":"Quiz mode: choose what this quiz is for. Pre-check probes prerequisites; Exit Ticket assesses today's content; Formative is a quick mid-lesson pulse; Spaced Review re-tests prior content."}},{"k":"mode_exit_ticket","v":{"s":"📝 Exit Ticket"}},{"k":"mode_pre_check","v":{"s":"🎯 Pre-Check (Readiness)"}},{"k":"mode_formative","v":{"s":"🌡️ Formative Check"}},{"k"