  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/12005.png",
      "text": "Selemeng ke ngoanana ea monyane. O rata likatse. Lile ngata lapeng habo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=1",
      "sourceDigest": "sha256:ed0779427c38c8c43f215308099bdada779d9fd29ce01dc343a509e1686990b6"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/12006.png",
      "text": "Selemeng o na le katse e le'ngoe entšo. E ja nama haholo.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=2",
      "sourceDigest": "sha256:a0a34f703364b73ea10343a6737ae46e9004c700acce10deb0b0283d5df9ffb2"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/12007.png",
      "text": "Selemeng o na le katse e nonneng haholo. E ja ntho e'ngoe le e'ngoe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=3",
      "sourceDigest": "sha256:d151192d493ac4e3f4ac1c90bf3a4bc1eb0ec782b1ab4e1d9a6a93ff3be8acb5"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/12008.png",
      "text": "Katse ea boraro, ea matha, hoea qhomela holima sefate. Ea fumana bothata ba hore na e theoha sefateng joang.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=4",
      "sourceDigest": "sha256:fa3392cfadd52d24d53be3656f7928fb21a2c1eef625772e79019fbd3c800f84"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/12028.png",
      "text": "Selemeng a hloa sefate le ena. Selemeng a fumana bothata le ena. 'M'e oa Selemeng le ena a tlameha hoea thusa katse le Selemeng ho theoha sefateng.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=5",
      "sourceDigest": "sha256:73120e7bd8ddb3225a1e2fca1d247c9d0df3153d1cd0de7871f92186cccca3c4"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/12009.png",
      "text": "Selemeng o na le likatse tse peli hape. Line li kakalla kantle letsatsing letšeare kaofela.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=6",
      "sourceDigest": "sha256:fe5b5a1a1edeec98f9a04ceac4a5aefb234c1b32912ee2ccd4f978fb0d8f7711"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/12019.png",
      "text": "Selemeng o na le likatse tse tharo hape tse phatahaneng. Litšoara litoeba kantlung ea lijo bosiu.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=7",
      "sourceDigest": "sha256:cd1a0a0a646ed021f5030c7064572ff9795dbc40fa57f5cccf20550c55c81399"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/12020.png",
      "text": "Selemeng o na le ntja e le'ngoe. Lebitso la eona ke Lirafi. Ene e sena motsoalle. E koatile.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=8",
      "sourceDigest": "sha256:5db8515cc9e60210ac35cd8ef8efe606ee81a84d2f7765419cfe9493a9c745fd"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/12021.png",
      "text": "Likatse tsa Selemeng hali rate Lirafi. Li lelekisa Lirafi hore etsoe ka tlung. Ea baleha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=9",
      "sourceDigest": "sha256:dd665b47021716a2bb316f161e216691b7fcf0e368503819d9018eda9f9813fe"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/12022.png",
      "text": "Selemeng a tlameha hoea e lata hore e khutlele lapeng. Eaba likatse lia koata. Hali batle hobona Lirafi hape.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=10",
      "sourceDigest": "sha256:87165d9357af10df34c6b0de0e515ba3e720e9c811bab5da99b7022a112fa1d9"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/12024.png",
      "text": "Selemeng o na le likatse tse kae habo? Eea, o na le likatse tse robeli.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=11",
      "sourceDigest": "sha256:d137b269ea145e673669422ed240c10729d9a4458cb5c6941875c0bbb82e81ca"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/12023.png",
      "text": "Selemeng o na le lintja tse kae habo? Eea, o na le ntja e le'ngoe. Selemeng o thabela likatse tsa hae tse robeli le ntja ea hae e le'ngoe.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=12",
      "sourceDigest": "sha256:2d1e693fe9308d41cdd97e53deee01289fea9ef61dabea73f3f2890c9eca0e2c"
    },
    {
      "n": 13,
      "img": null,
      "text": "Uena heno, hona le likatse tse kae? Le lintja tse kae?",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=1&dual=false&id=12027#page=13",
      "sourceDigest": "sha256:d39b016c40022d4355519c7a93735a6b8e3e6e98dc84c9d2260ae2799f990976"
    }
  ],
