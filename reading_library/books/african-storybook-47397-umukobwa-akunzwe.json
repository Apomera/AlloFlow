  "pages": [
    {
      "n": 1,
      "img": "https://www.africanstorybook.org/illustrations/pages/18757.png",
      "text": "Harabaye, umugabo n'umugore. Bari bafise abana babahungu batandatu n'umwigeme umwe. Umwigeme yitwa Kabibi. Abo bavyeyi bakunda kabibi gusumba abahungu bavukana.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=1",
      "sourceDigest": "sha256:a6ec6f16ebecab019834b724ea7758e1df98185ae260491b87de3474afef7439"
    },
    {
      "n": 2,
      "img": "https://www.africanstorybook.org/illustrations/pages/18758.png",
      "text": "Abavyeyi baramuhaye Kabibi akabindi nkagashimwe. Kabibi yarakunda cane ako kabindi. Yakunda gukina agafise.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=2",
      "sourceDigest": "sha256:dabdb657248c20d082ac9510bd05e5338b868ef69acfb893ce2544eb9c769d94"
    },
    {
      "n": 3,
      "img": "https://www.africanstorybook.org/illustrations/pages/18759.png",
      "text": "Umunsi umwe, abahungu bavukana bamena akabindi ka Kabibi batabishaka. Akabindi karamenetse kose. Abo bahungu ntibamenya ico bokora. Baca bafata ubuhimba bw'akabindi babuta mw'ishamba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=3",
      "sourceDigest": "sha256:4cff412c63f4e134663c954c9627748486adf68efc87455c82b2a877ddd254e4"
    },
    {
      "n": 4,
      "img": "https://www.africanstorybook.org/illustrations/pages/18760.png",
      "text": "Kabibi ararondera akabindi kiwe ariko ntiyakabona. Afatwa n'ishavu ararira. Yanka gufungura. Yinginga abavyeyi n'abasaza biwe kumuronderera akabindi kiwe, ariko ntibakaronse.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=4",
      "sourceDigest": "sha256:eba47a11af33b37f54311dc40977aad317d2ea5cc87101a2344bc8c5af9c7627"
    },
    {
      "n": 5,
      "img": "https://www.africanstorybook.org/illustrations/pages/18761.png",
      "text": "Kabibi biramubabaza cane. Aca ariruka aja mw'ishamba. Yurira igiti kirekire kiri mw'ishamba.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=5",
      "sourceDigest": "sha256:e678ef6e1e9e881f58edb1c60a1c293d6740010f96644738721d83cb88d5c5bd"
    },
    {
      "n": 6,
      "img": "https://www.africanstorybook.org/illustrations/pages/18762.png",
      "text": "Abavyeyi ba Kabibi baramurondera. Baramubona, bamusaba kwururuka. Ariko aranka. Bamubwira amanuke hasi, ariko abandanya yanka.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=6",
      "sourceDigest": "sha256:a0a906e7949bee3b8e54fa94aa6b81c948149101618814a0e6a8625c427b44b6"
    },
    {
      "n": 7,
      "img": "https://www.africanstorybook.org/illustrations/pages/18763.png",
      "text": "Basaza ba Kabibi baja hamwe bararirimba akaririmbo bamusaba kwururuka. Indirimbo: \"Muhererezi wacu, ururuka dutahe. Tuzoronka akandi kabindi gashasha!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=7",
      "sourceDigest": "sha256:612d0e0ea0b4af86896f2a9f9ba81da2d645597f749141cee4786d042ad55bbc"
    },
    {
      "n": 8,
      "img": "https://www.africanstorybook.org/illustrations/pages/18764.png",
      "text": "Kabibi arabatwenga. Araririmba abasubiza abigana, \"Ninini-ninio, ninini-ninio. Ninini-ninio, ninini-ninio!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=8",
      "sourceDigest": "sha256:fd5ac24e6593bc85e3278d94245d2bf3a4a559c3ccc88b9a08a7a1f0107b27fa"
    },
    {
      "n": 9,
      "img": "https://www.africanstorybook.org/illustrations/pages/18765.png",
      "text": "Umugenzi wa Kabibi araza agerageza kumwinginga yururuke. Arararimba, \"Mugenzi, ururuka twitahire muhira. Tuzoronka akandi kabindi gashasha!\"",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=9",
      "sourceDigest": "sha256:716affaaed794748e34707e20ef5047cb38204632b1b1422f5663b92d5c9463c"
    },
    {
      "n": 10,
      "img": "https://www.africanstorybook.org/illustrations/pages/18766.png",
      "text": "Buhorobuhoro, Kabibi arururuka igiti. Mugenzi wiwe abandanya aririmba gushika ashitse hasi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=10",
      "sourceDigest": "sha256:dcead979b1bdf73aa0b1d619d0511a93ec122f166dc98583beb40e1bc1368400"
    },
    {
      "n": 11,
      "img": "https://www.africanstorybook.org/illustrations/pages/18767.png",
      "text": "Kabibi aragumbira mugenzi wiwe. Batambuka buhorobuhoro baja iwabo wa Kabibi.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=11",
      "sourceDigest": "sha256:72051070abe537baff86438f34ef5d926cde86fb83e941f3f320cd9a1d4494b1"
    },
    {
      "n": 12,
      "img": "https://www.africanstorybook.org/illustrations/pages/18768.png",
      "text": "Basaza ba Kabibi hamwe n'abavyeyi babo bararyohewe kumubona Kabibi agarutse. Umuryango warufise urubanza, hamwe n'incuti n'abagenzi benshi. Kabibi yararyohewe nakabandi gashasha.",
      "sourceUrl": "https://www.africanstorybook.org/newviewer/index.php?bt=3&dual=false&id=47397#page=12",
      "sourceDigest": "sha256:b6d82dd8035cfd4a6190ff543c68c69883e375482f52f16e66e6aa48e740cfe8"
    }
  ],
